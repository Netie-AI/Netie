+def test_reset_aware_more_remaining_first() -> None:
+    targets = _targets()
+    targets[0].session_remaining = 0.1
+    targets[0].weekly_remaining = 0.1
+    targets[1].session_remaining = 0.9
+    targets[1].weekly_remaining = 0.9
+    targets[2].session_remaining = 0.4
+    targets[2].weekly_remaining = 0.4
+    ordered = apply_strategy("reset-aware", targets)
+    assert [t.execution_key for t in ordered] == ["b", "c", "a"]
+
+
+def test_reset_aware_limit_reached_last() -> None:
+    targets = _targets()
+    targets[0].session_remaining = 0.9
+    targets[0].weekly_remaining = 0.9
+    targets[0].limit_reached = True
+    targets[1].session_remaining = 0.2
+    targets[1].weekly_remaining = 0.2
+    ordered = apply_strategy("reset-aware", targets)
