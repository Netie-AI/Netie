@@ -1,4 +1,4 @@
-"""Combo routing strategies — 13 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
+"""Combo routing strategies — 14 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
 
 from __future__ import annotations
 
@@ -32,6 +32,8 @@ STRATEGY_ALIASES: dict[str, StrategyName] = {
     "headroom": "headroom",
     "reset-window": "reset-window",
     "reset_window": "reset-window",
+    "reset-aware": "reset-aware",
+    "reset_aware": "reset-aware",
 }
 
 
@@ -157,4 +159,42 @@ def apply_strategy(
         decorated.sort(key=lambda pair: (_remaining(pair[1]), pair[0]))
         return [t for _, t in decorated]
 
+    if strategy == "reset-aware":
+        # Algorithm port of OmniRoute remaining+pressure score. No quota fetch.
+        # Missing reset remaining => urgency 0 (remaining-only). OmniRoute uses 0.5.
+        session_ms = 5 * 60 * 60 * 1000
+        weekly_ms = 7 * 24 * 60 * 60 * 1000
+
+        def _clamp01(value: float) -> float:
+            if value <= 0:
+                return 0.0
+            if value >= 1:
+                return 1.0
+            return value
+
+        def _urgency(remaining_ms: float | None, window_ms: float) -> float:
+            if remaining_ms is None:
+                return 0.0
+            if remaining_ms <= 0:
+                return 1.0
+            return _clamp01(1.0 - remaining_ms / window_ms)
+
+        def _score(t: RouteTarget) -> float:
+            if t.limit_reached:
+                return float("-inf")
+            sess = 0.5 if t.session_remaining is None else _clamp01(t.session_remaining)
+            week = 0.5 if t.weekly_remaining is None else _clamp01(t.weekly_remaining)
+            s_press = _urgency(t.reset_remaining_ms, session_ms) * (1 - sess)
+            w_press = _urgency(t.reset_remaining_ms, weekly_ms) * (1 - week)
+            session_score = 0.45 * sess + 0.55 * s_press
+            weekly_score = 0.25 * week + 0.75 * w_press
+            score = 0.35 * session_score + 0.65 * weekly_score
+            if sess < 0.10:
+                score *= max(0.05, sess / 0.10)
+            return score
+
+        decorated = list(enumerate(targets))
+        decorated.sort(key=lambda pair: (-_score(pair[1]), pair[0]))
+        return [t for _, t in decorated]
+
     return list(targets)
