+def test_fit_stops_at_the_first_row_that_does_not_fit() -> None:
+    """A later short row must not jump the queue: the board shows a prefix, not a pick."""
+    rows = [{"number": 1, "title": "a"}, {"number": 2, "title": "b" * 200}, {"number": 3, "title": "c"}]
+    out = fit_issue_board({"items": rows, "unreachable": []}, max_chars=120)
+    assert [r["number"] for r in out["items"]] == [1]
+    assert (out["fetched"], out["shown"], out["omitted"], out["withheld"]) == (3, 1, 2, 0)
