+def test_leaked_key_or_remote_desktop_kind_still_refuses_the_whole_board(monkeypatch) -> None:
+    """Fitting does not soften a structural leak, even in a row the cut would have left out."""
+    rows = sources.issues_from_gh_search(_gh_items(100))["items"]
+    leaked = [dict(r) for r in rows]
+    leaked[99]["transcript"] = "secret"
+    with pytest.raises(ControlDenied, match="leaked"):
+        fit_issue_board({"items": leaked, "unreachable": []})
+    desk = [dict(r) for r in rows]
+    desk[99]["kind"] = "rdp"
+    with pytest.raises(ControlDenied, match="Guacamole"):
+        fit_issue_board({"items": desk, "unreachable": []})
+
+    def leaky_row(repo: str, it: dict[str, Any], *, kind: str) -> dict[str, Any]:
+        return {"repo": repo, "number": it.get("number"), "transcript": "secret"}
+
+    monkeypatch.setattr(sources, "_issue_row", leaky_row)
+    reading = _open_board(monkeypatch, _gh_items(2))
+    assert reading.ok is False
+    assert reading.source == "netie.control"
+    assert "leaked" in reading.detail
+    assert reading.data is None
+
