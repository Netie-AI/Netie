+++ b/tests/test_netie_board.py
@@ -0,0 +1,392 @@
+"""Netie Control board caller. python -m pytest tests/test_netie_board.py -q"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+from fastapi.testclient import TestClient
+
+from netie_control import render, sources
+from netie_control.app import create_app
+from netie_control.netie_board import (
+    MAX_BOARD_CHARS,
+    ControlDenied,
+    board_index,
+    fit_issue_board,
+    guard_issue_board,
+    project_board,
+    project_session,
+)
+
+
+def test_issue_board_keeps_titles() -> None:
+    out = guard_issue_board(
+        {
+            "items": [
+                {
+                    "repo": "Netie-AI/dms",
+                    "number": 1,
+                    "title": "acl wave",
+                    "is_epic": True,
+                    "blocked": False,
+                }
+            ],
+            "unreachable": [],
+        }
+    )
+    assert out["items"][0]["title"] == "acl wave"
+
+
+def test_issue_board_refuses_rdp_kind() -> None:
+    with pytest.raises(ControlDenied, match="Guacamole"):
+        guard_issue_board({"items": [{"id": "x", "kind": "rdp"}], "unreachable": []})
+
+
+def test_issue_board_refuses_transcript_key() -> None:
+    with pytest.raises(ControlDenied, match="leaked"):
+        guard_issue_board(
+            {
+                "items": [{"id": "x", "transcript": "secret"}],
+                "unreachable": [],
+            }
+        )
+
+
+def test_project_board_local_fallback() -> None:
+    board = project_board(
+        crew_index={"runs": [{"id": "p1", "status": "open", "ticket_id": "T1"}]},
+        ledger_peek=[],
+        refusals=[],
+    )
+    assert board["product"] == "crew-board"
+    assert board["cards"][0]["kind"] == "run"
+
+
+def test_project_board_skill_index_is_ids_only() -> None:
+    board = project_board(
+        crew_index={"skills": [{"id": "S-0004", "source": "netie-kb"}]},
+        ledger_peek=[],
+        refusals=[],
+    )
+    skill = next(c for c in board["cards"] if c["kind"] == "skill")
+    assert skill["id"] == "S-0004"
+    assert skill["source"] == "netie-kb"
+    with pytest.raises(ControlDenied, match="leaked"):
+        project_board(
+            crew_index={
+                "skills": [
+                    {"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}
+                ]
+            },
+            ledger_peek=[],
+            refusals=[],
+        )
+
+
+def test_guacamole_routes_are_405() -> None:
+    client = TestClient(create_app())
+    for path in ("/v1/rdp", "/v1/vnc", "/v1/guacamole", "/v1/ssh"):
+        resp = client.get(path)
+        assert resp.status_code == 405, path
+        body = resp.json()
+        assert body["code"] == "not_this_plane"
+        assert body["owner"] == "Crew"
+        assert "Guacamole" in body["message"] or "guacamole" in body["message"].lower()
+
+
+def test_board_index_stitches_skill_ids() -> None:
+    idx = board_index(
+        graph_index={"runs": [{"id": "p1", "status": "open", "ticket_id": "T1"}]},
+        factory_index={"tickets": [{"id": "T1", "status": "open", "epic_id": "E1"}]},
+        skills=[{"id": "S-0004", "source": "netie-kb"}],
+    )
+    assert {k for k, v in idx.items() if v} >= {"runs", "tickets", "skills"}
+    board = project_board(crew_index=idx, ledger_peek=[], refusals=[])
+    kinds = {c["kind"] for c in board["cards"]}
+    assert kinds == {"run", "ticket", "skill"}
+    with pytest.raises(ControlDenied, match="leaked"):
+        board_index(
+            skills=[{"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}]
+        )
+
+
+def test_project_session_lists_skill_ids() -> None:
+    session = project_session(
+        run={"id": "p1", "status": "open", "ticket_id": "T1"},
+        todos=[],
+        permissions=["warehouse.query"],
+        skills=[{"id": "S-0004", "source": "netie-kb"}],
+    )
+    assert session["skill_ids"] == ["S-0004"]
+    assert "skill_body" not in str(session)
+    with pytest.raises(ControlDenied, match="leaked"):
+        project_session(
+            run={"id": "p1", "status": "open", "ticket_id": "T1"},
+            todos=[],
+            permissions=[],
+            skills=[{"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}],
+        )
+
+
+def test_module_mentions_netie_control_import() -> None:
+    path = Path(__file__).resolve().parents[1] / "netie_control" / "netie_board.py"
+    spec = importlib.util.spec_from_file_location("netie_board", path)
+    assert spec is not None and spec.loader is not None
+    blob = path.read_text(encoding="utf-8")
+    assert "from netie.control import" in blob
+    assert "board_index" in blob
+    assert "Control is not Guacamole" in blob
+
+
+# --- The board past the budget: it degrades in the open, it does not go dark. ---
+
+# The gh mock below swaps these on the shared modules. node must still be the real one.
+_REAL_RUN = subprocess.run
+_REAL_WHICH = shutil.which
+
+ROW_KEYS = {
+    "repo", "number", "title", "url", "is_epic", "blocked", "assignees", "kind", "closed_at",
+}
+
+
+def _gh_items(n: int, *, title_len: int = 64) -> list[dict[str, Any]]:
+    """n open issues as gh search returns them, with a body the board must never carry."""
+    return [
+        {
+            "number": i,
+            "title": f"Board row {i:03d} ".ljust(title_len, "x"),
+            "url": f"https://github.com/Netie-AI/Cortex/issues/{i}",
+            "labels": [],
+            "assignees": [],
+            "repository": {"nameWithOwner": "Netie-AI/Cortex"},
+            "body": f"ISSUE-BODY-{i} must stay on GitHub",
+        }
+        for i in range(1, n + 1)
+    ]
+
+
+def _fake_gh(monkeypatch, items: list[dict[str, Any]] | None, *, stderr: str = "") -> None:
+    """gh answers the open-issue search with items, or fails with stderr when items is None."""
+
+    def fake_run(argv: object, **_k: object) -> subprocess.CompletedProcess[str]:
+        cmd = [str(x) for x in list(argv)]  # type: ignore[arg-type]
+        if items is None:
+            return subprocess.CompletedProcess(cmd, 1, "", stderr)
+        return subprocess.CompletedProcess(cmd, 0, json.dumps(items), "")
+
+    monkeypatch.setattr(sources.shutil, "which", lambda _name: "/usr/bin/gh")
+    monkeypatch.setattr(sources.subprocess, "run", fake_run)
+
+
+def _open_board(monkeypatch, items: list[dict[str, Any]] | None, **kw: Any) -> sources.Reading:
+    _fake_gh(monkeypatch, items, **kw)
+    return sources.board(slices=("open",))
+
+
+def _js_function(page: str, name: str) -> str:
+    start = page.index(f"function {name}(")
+    depth = 0
+    for i in range(page.index("{", start), len(page)):
+        depth += {"{": 1, "}": -1}.get(page[i], 0)
+        if depth == 0:
+            return page[start : i + 1]
+    raise AssertionError(f"unbalanced function {name}")
+
+
+def _page_script_board(reading: dict[str, Any]) -> str:
+    """The live page's own boardHtml, run on a reading. This is what the operator sees."""
+    node = _REAL_WHICH("node")
+    assert node, "node is required to run the page's own boardHtml; install it"
+    page = TestClient(create_app()).get("/").text
+    script = "\n".join(
+        [
+            _js_function(page, "esc"),
+            _js_function(page, "boardHtml"),
+            "function ticketCardHtml(r){return '<i>' + esc(r.title) + '</i>'}",
+            "function absentHtml(d, s){return 'ABSENT ' + d + ' ' + s}",
+            f"process.stdout.write(boardHtml({json.dumps(reading)}));",
+        ]
+    )
+    out = _REAL_RUN(
+        [node, "-e", script], capture_output=True, text=True, timeout=20, check=False
+    )
+    assert out.returncode == 0, out.stderr
+    return out.stdout
+
+
+def test_forty_rows_fit_and_carry_no_left_out_line(monkeypatch) -> None:
+    reading = _open_board(monkeypatch, _gh_items(40))
+    assert reading.ok is True
+    d = reading.data
+    assert (d["fetched"], d["shown"], d["omitted"], d["withheld"]) == (40, 40, 0, 0)
+    assert len(d["items"]) == 40
+    assert d["truncated"] is False
+    assert reading.detail == ""
+    for html in (render._board_body(d), _page_script_board(reading.to_dict())):
+        assert "Board row 001 " in html
+        assert "Board row 040 " in html
+        assert "Left out" not in html
+        assert "Withheld" not in html
+        assert "Truncated" not in html
+
+
+@pytest.mark.parametrize("n", [60, 100])
+def test_over_budget_board_shows_leading_rows_and_counts_the_rest(monkeypatch, n: int) -> None:
+    items = _gh_items(n)
+    reading = _open_board(monkeypatch, items)
+    assert reading.ok is True, reading.detail
+    d = reading.data
+    shown = d["shown"]
+    # Nothing is dropped without being counted.
+    assert d["fetched"] == n
+    assert d["withheld"] == 0
+    assert 0 < shown < n
+    assert shown + d["omitted"] + d["withheld"] == d["fetched"]
+    assert len(d["items"]) == shown
+    assert d["open"] == d["items"]
+    # The rows kept are the leading ones, in gh order, with no gap.
+    assert [r["number"] for r in d["items"]] == list(range(1, shown + 1))
+    # The cut is exact: what is shown fits, one more row would not.
+    def dump(rows: list[Any]) -> str:
+        return json.dumps({"items": rows, "unreachable": []}, separators=(",", ":"))
+
+    assert len(dump(d["items"])) <= MAX_BOARD_CHARS == d["budget_chars"]
+    next_row = sources.issues_from_gh_search(items)["items"][shown]
+    assert len(dump([*d["items"], next_row])) > MAX_BOARD_CHARS
+    # The existing truncation flag is raised, so every consumer that reads it sees it.
+    assert d["truncated"] is True
+    assert d["cap"] == sources.BOARD_SEARCH_LIMIT
+    assert f"left out {n - shown} of {n} open issues" in reading.detail
+    label = f"Left out: {n - shown} of {n} open issues did not fit the 12000 character"
+    first = f"The first {shown} in search order are shown."
+    body = render._board_body(d)
+    public = render.public_board_page(reading.to_dict())
+    script = _page_script_board(reading.to_dict())
+    for html in (body, public, script):
+        assert label in html
+        assert first in html
+        assert f"Truncated: showing {shown} at cap 100" in html
+        assert f"Board row {shown:03d} " in html
+        assert f"Board row {shown + 1:03d} " not in html
+    # Pickup reads the same payload: it lists what the board shows and says it is cut.
+    tray = sources.pickup_tray({"rows": []}, d)
+    assert tray["count"] == shown
+    assert tray["truncated"] is True
+
+
