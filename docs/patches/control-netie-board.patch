+def test_board_rows_stay_ids_only_at_every_size(monkeypatch) -> None:
+    """No issue body rides the board, cut or uncut."""
+    for n in (40, 60, 100):
+        sources.clear_shared_reads()
+        reading = _open_board(monkeypatch, _gh_items(n))
+        assert reading.ok is True
+        for row in reading.data["items"]:
+            assert set(row) == ROW_KEYS
+        blob = json.dumps(reading.to_dict())
+        assert "ISSUE-BODY" not in blob
+        assert "ISSUE-BODY" not in render._board_body(reading.data)
