+def test_unreachable_gh_still_reads_unreachable(monkeypatch) -> None:
+    reading = _open_board(monkeypatch, None, stderr="gh: not logged in")
+    assert reading.ok is False
+    assert reading.data is None
+    assert reading.source == "gh search issues"
+    assert "open" in reading.detail
+    public = render.public_board_page(reading.to_dict())
+    assert "Board unread" in public
+    assert "Left out" not in public
+    assert _page_script_board(reading.to_dict()).startswith("ABSENT ")
