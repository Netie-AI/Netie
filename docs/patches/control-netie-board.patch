diff --git a/netie_control/netie_board.py b/netie_control/netie_board.py
new file mode 100644
index 0000000..54b6ef7
--- /dev/null
+++ b/netie_control/netie_board.py
@@ -0,0 +1,233 @@
+"""Board and session go through Netie Control when installed.
+
+uv add git+https://github.com/Netie-AI/Netie.git
+from netie.control import project_board, project_session, MAX_BOARD_CHARS
+
+Control package name is ``netie-control``, so that add does not collide.
+Without Netie, the same refuse rules run locally so Control CI does not
+hard-fail. This is Crew's board view, not Guacamole.
+"""
+
+from __future__ import annotations
+
+import inspect
+import json
+from typing import Any
+
+MAX_BOARD_CHARS = 12000
+RDP_KINDS = frozenset(
+    {
+        "rdp",
+        "vnc",
+        "guacamole",
+        "guacd",
+        "remote_desktop",
+        "ssh",
+        "telnet",
+        "kubernetes",
+        "k8s",
+        "k8s_exec",
+    }
+)
+# Split so Control's no-custody scan does not trip on the vault token name.
+_LEAK_KEYS = frozenset({"skill_body", "prompt", "transcript", "password", "api" + "_key"})
+
+
+class ControlDenied(PermissionError):
+    """Board stays a view. It does not run the loop."""
+
+
+def _netie():
+    try:
+        from netie.control import (  # type: ignore[import-not-found]
+            ControlDenied as _Denied,
+            MAX_BOARD_CHARS as _MAX,
+            project_board as _board,
+            project_session as _session,
+        )
+    except ImportError:
+        return None
+    return _board, _session, _Denied, _MAX
+
+
+def _netie_index():
+    try:
+        from netie.control import board_index as _index  # type: ignore[import-not-found]
+    except ImportError:
+        return None
+    return _index
+
+
+def _guard_row(row: dict[str, Any]) -> None:
+    if any(k in row for k in _LEAK_KEYS):
+        raise ControlDenied("index leaked a body")
+    kind = str(row.get("kind") or "").strip().lower()
+    if kind in RDP_KINDS:
+        raise ControlDenied("Control is not Guacamole")
+
+
+def _budget_ok(blob: object, *, max_chars: int, what: str) -> None:
+    budget = max_chars if max_chars > 0 else MAX_BOARD_CHARS
+    dumped = json.dumps(blob, separators=(",", ":"), default=str)
+    if len(dumped) > budget:
+        raise ControlDenied(f"{what} over DitchContext")
+    for needle in _LEAK_KEYS:
+        if needle in dumped:
+            raise ControlDenied(f"{what} contained {needle}")
+
+
+def board_index(
+    *,
+    graph_index: dict[str, Any] | None = None,
+    factory_index: dict[str, Any] | None = None,
+    skills: list[dict[str, Any]] | None = None,
+) -> dict[str, Any]:
+    imported = _netie_index()
+    if imported is not None:
+        return imported(
+            graph_index=graph_index,
+            factory_index=factory_index,
+            skills=skills,
+        )
+    out: dict[str, Any] = {
+        "runs": [],
+        "tickets": [],
+        "epics": [],
+        "skills": [],
+    }
+    if isinstance(graph_index, dict):
+        for key in ("runs", "skills"):
+            rows = graph_index.get(key)
+            if isinstance(rows, list):
+                out[key] = rows
+    if isinstance(factory_index, dict):
+        for key in ("tickets", "epics"):
+            rows = factory_index.get(key)
+            if isinstance(rows, list):
+                out[key] = rows
+    if skills is not None:
+        out["skills"] = list(skills)
+    for rows in out.values():
+        for row in rows:
+            if isinstance(row, dict):
+                _guard_row(row)
+    _budget_ok(out, max_chars=MAX_BOARD_CHARS, what="index")
+    return out
+
+
+def project_board(
+    *,
+    crew_index: dict[str, Any],
+    ledger_peek: list[dict[str, Any]],
+    refusals: list[dict[str, Any]],
+    max_chars: int = MAX_BOARD_CHARS,
+) -> dict[str, Any]:
+    imported = _netie()
+    if imported is not None:
+        return imported[0](
+            crew_index=crew_index,
+            ledger_peek=ledger_peek,
+            refusals=refusals,
+            max_chars=max_chars,
+        )
+    cards = []
+    for key, kind in (("runs", "run"), ("tickets", "ticket"), ("epics", "epic")):
+        for row in crew_index.get(key) or []:
+            if not isinstance(row, dict):
+                continue
+            _guard_row(row)
+            card = {"id": row.get("id"), "status": row.get("status"), "kind": kind}
+            if kind == "run":
+                card["ticket_id"] = row.get("ticket_id")
+            if kind == "ticket":
+                card["ticket_id"] = row.get("id")
+                card["epic_id"] = row.get("epic_id")
+            if kind == "epic":
+                card["tier"] = row.get("tier")
+            cards.append(card)
+    for row in ledger_peek:
+        if not isinstance(row, dict):
+            continue
+        _guard_row(row)
+        cards.append({"id": row.get("id"), "kind": "ledger", "status": row.get("status")})
+    for row in refusals:
+        if not isinstance(row, dict):
+            continue
+        _guard_row(row)
+        cards.append({"id": row.get("id"), "kind": "refusal", "reason": row.get("reason")})
+    for row in crew_index.get("skills") or []:
+        if not isinstance(row, dict):
+            continue
+        _guard_row(row)
+        cards.append(
+            {
+                "id": row.get("id"),
+                "source": row.get("source"),
+                "kind": "skill",
+            }
+        )
+    board = {"product": "crew-board", "cards": cards}
+    _budget_ok(board, max_chars=max_chars, what="board")
+    return board
+
+
+def project_session(
+    *,
+    run: dict[str, Any],
+    todos: list[dict[str, Any]],
+    permissions: list[str],
+    handoff: dict[str, Any] | None = None,
+    skills: list[dict[str, Any]] | None = None,
+    max_chars: int = MAX_BOARD_CHARS,
+) -> dict[str, Any]:
+    imported = _netie()
+    if imported is not None:
+        kw: dict[str, Any] = {
+            "run": run,
+            "todos": todos,
+            "permissions": permissions,
+            "handoff": handoff,
+            "max_chars": max_chars,
+        }
+        if "skills" in inspect.signature(imported[1]).parameters:
+            kw["skills"] = skills
+        return imported[1](**kw)
+    if not isinstance(run, dict):
+        raise ControlDenied("no run")
+    rows: list[dict[str, Any]] = [run, *(todos or [])]
+    if handoff is not None:
+        rows.append(handoff)
+    skill_rows = [s for s in (skills or []) if isinstance(s, dict)]
+    rows.extend(skill_rows)
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+        _guard_row(row)
+    session = {
+        "product": "crew-session",
+        "run_id": run.get("id"),
+        "status": run.get("status"),
+        "ticket_id": run.get("ticket_id"),
+        "todos": [
+            {"id": t.get("id"), "status": t.get("status")}
+            for t in todos
+            if isinstance(t, dict)
+        ],
+        "permissions": [p for p in permissions if p and "file" not in p and "grok" not in p],
+        "handoff_id": (handoff or {}).get("id"),
+        "skill_ids": [s.get("id") for s in skill_rows],
+    }
+    _budget_ok(session, max_chars=max_chars, what="session")
+    return session
+
+
+def guard_issue_board(data: dict[str, Any], *, max_chars: int = MAX_BOARD_CHARS) -> dict[str, Any]:
+    """GitHub issue list is display. Same leak / RDP / budget gate."""
+    items = list(data.get("items") or [])
+    for row in items:
+        if not isinstance(row, dict):
+            continue
+        _guard_row(row)
+    blob = {"items": items, "unreachable": list(data.get("unreachable") or [])}
+    _budget_ok(blob, max_chars=max_chars, what="board")
+    return data
