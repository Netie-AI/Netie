+def test_strict_guard_still_refuses_an_unfitted_over_budget_board() -> None:
+    """The gate can still fail. fit_issue_board runs before it; it does not replace it."""
+    rows = sources.issues_from_gh_search(_gh_items(100))["items"]
+    with pytest.raises(ControlDenied, match="over DitchContext"):
+        guard_issue_board({"items": rows, "unreachable": []})
+    fitted = fit_issue_board({"items": rows, "unreachable": []})
+    assert guard_issue_board(fitted) is fitted
