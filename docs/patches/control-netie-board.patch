+def test_one_refusal_class_with_or_without_netie() -> None:
+    """With Netie installed the contract raises its own class. The board must catch it."""
+    import netie_control.netie_board as local
+
+    try:
+        from netie.control import ControlDenied as shared  # type: ignore[import-not-found]
+    except ImportError:
+        assert issubclass(local.ControlDenied, PermissionError)
+        return
+    assert local.ControlDenied is shared
