+def test_title_naming_a_guarded_key_is_withheld_and_counted(monkeypatch) -> None:
+    """One issue titled 'prompt cache' used to take the whole board dark."""
+    items = _gh_items(3)
+    items[1]["title"] = "fix prompt cache"
+    reading = _open_board(monkeypatch, items)
+    assert reading.ok is True, reading.detail
+    d = reading.data
+    assert (d["fetched"], d["shown"], d["omitted"], d["withheld"]) == (3, 2, 0, 1)
+    assert [r["number"] for r in d["items"]] == [1, 3]
+    assert d["truncated"] is True
+    assert "withheld 1 of 3 open issues" in reading.detail
+    for html in (render._board_body(d), _page_script_board(reading.to_dict())):
+        assert "Withheld: 1 of 3 open issues are not shown" in html
+        assert "Board row 003 " in html
+        assert "prompt cache" not in html
+    assert "prompt cache" not in json.dumps(reading.to_dict())
