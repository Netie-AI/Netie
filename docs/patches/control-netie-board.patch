diff --git a/tests/test_netie_board.py b/tests/test_netie_board.py
new file mode 100644
index 0000000..1db6c43
--- /dev/null
+++ b/tests/test_netie_board.py
@@ -0,0 +1,131 @@
+"""Netie Control board caller. python -m pytest tests/test_netie_board.py -q"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+from netie_control.app import create_app
+from netie_control.netie_board import ControlDenied, board_index, guard_issue_board, project_board, project_session
+
+
+def test_issue_board_keeps_titles() -> None:
+    out = guard_issue_board(
+        {
+            "items": [
+                {
+                    "repo": "Netie-AI/dms",
+                    "number": 1,
+                    "title": "acl wave",
+                    "is_epic": True,
+                    "blocked": False,
+                }
+            ],
+            "unreachable": [],
+        }
+    )
+    assert out["items"][0]["title"] == "acl wave"
+
+
+def test_issue_board_refuses_rdp_kind() -> None:
+    with pytest.raises(ControlDenied, match="Guacamole"):
+        guard_issue_board({"items": [{"id": "x", "kind": "rdp"}], "unreachable": []})
+
+
+def test_issue_board_refuses_transcript_key() -> None:
+    with pytest.raises(ControlDenied, match="leaked"):
+        guard_issue_board(
+            {
+                "items": [{"id": "x", "transcript": "secret"}],
+                "unreachable": [],
+            }
+        )
+
+
+def test_project_board_local_fallback() -> None:
+    board = project_board(
+        crew_index={"runs": [{"id": "p1", "status": "open", "ticket_id": "T1"}]},
+        ledger_peek=[],
+        refusals=[],
+    )
+    assert board["product"] == "crew-board"
+    assert board["cards"][0]["kind"] == "run"
+
+
+def test_project_board_skill_index_is_ids_only() -> None:
+    board = project_board(
+        crew_index={"skills": [{"id": "S-0004", "source": "netie-kb"}]},
+        ledger_peek=[],
+        refusals=[],
+    )
+    skill = [c for c in board["cards"] if c["kind"] == "skill"][0]
+    assert skill["id"] == "S-0004"
+    assert skill["source"] == "netie-kb"
+    with pytest.raises(ControlDenied, match="leaked"):
+        project_board(
+            crew_index={
+                "skills": [
+                    {"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}
+                ]
+            },
+            ledger_peek=[],
+            refusals=[],
+        )
+
+
+def test_guacamole_routes_are_405() -> None:
+    client = TestClient(create_app())
+    for path in ("/v1/rdp", "/v1/vnc", "/v1/guacamole", "/v1/ssh"):
+        resp = client.get(path)
+        assert resp.status_code == 405, path
+        body = resp.json()
+        assert body["code"] == "not_this_plane"
+        assert body["owner"] == "Crew"
+        assert "Guacamole" in body["message"] or "guacamole" in body["message"].lower()
+
+
+def test_board_index_stitches_skill_ids() -> None:
+    idx = board_index(
+        graph_index={"runs": [{"id": "p1", "status": "open", "ticket_id": "T1"}]},
+        factory_index={"tickets": [{"id": "T1", "status": "open", "epic_id": "E1"}]},
+        skills=[{"id": "S-0004", "source": "netie-kb"}],
+    )
+    assert {k for k, v in idx.items() if v} >= {"runs", "tickets", "skills"}
+    board = project_board(crew_index=idx, ledger_peek=[], refusals=[])
+    kinds = {c["kind"] for c in board["cards"]}
+    assert kinds == {"run", "ticket", "skill"}
+    with pytest.raises(ControlDenied, match="leaked"):
+        board_index(
+            skills=[{"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}]
+        )
+
+
+def test_project_session_lists_skill_ids() -> None:
+    session = project_session(
+        run={"id": "p1", "status": "open", "ticket_id": "T1"},
+        todos=[],
+        permissions=["warehouse.query"],
+        skills=[{"id": "S-0004", "source": "netie-kb"}],
+    )
+    assert session["skill_ids"] == ["S-0004"]
+    assert "skill_body" not in str(session)
+    with pytest.raises(ControlDenied, match="leaked"):
+        project_session(
+            run={"id": "p1", "status": "open", "ticket_id": "T1"},
+            todos=[],
+            permissions=[],
+            skills=[{"id": "S-0001", "source": "netie-kb", "skill_body": "SECRET"}],
+        )
+
+
+def test_module_mentions_netie_control_import() -> None:
+    path = Path(__file__).resolve().parents[1] / "netie_control" / "netie_board.py"
+    spec = importlib.util.spec_from_file_location("netie_board", path)
+    assert spec is not None and spec.loader is not None
+    blob = path.read_text(encoding="utf-8")
+    assert "from netie.control import" in blob
+    assert "board_index" in blob
+    assert "Control is not Guacamole" in blob
