+def test_v1_context_relay_skips_unavailable(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "relay-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="relay-skip-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("picked")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "context-relay",
+                    "models": ["gpt-4o", "gpt-4o-mini"],
+                    "available": {"gpt-4o": False, "gpt-4o-mini": True},
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["choices"][0]["message"]["content"] == "picked"
+    assert mock.post.call_count == 1
+    assert mock.post.call_args.kwargs["json"]["model"] == "gpt-4o-mini"
+
+
+def test_v1_context_relay_injects_handoff(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "relay-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="relay-handoff-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("ok")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hello"}],
+                "combo": {
+                    "strategy": "context-relay",
+                    "models": ["gpt-4o-mini"],
+                    "handoff": {
+                        "sessionId": "s1",
+                        "summary": "keep going",
+                        "fromAccount": "acct",
+                    },
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    user = mock.post.call_args.kwargs["json"]["messages"][-1]["content"]
+    assert "context_handoff" in user
+    assert "keep going" in user
+
+
+def test_v1_context_relay_all_unavailable_503(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "relay-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="relay-none-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("nope")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "context-relay",
+                    "models": ["gpt-4o-mini"],
+                    "available": {"gpt-4o-mini": False},
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 503, resp.text
+    assert "no available relay target" in resp.json()["error"]["message"]
+    assert mock.post.call_count == 0
+
+
