+function listedOrEmpty(value, listed) {
+  const want = String(value || "").trim();
+  if (!Array.isArray(listed) || listed.indexOf(want) < 0) return "";
+  return want;
+}
+
+function listedOptions(listed, value) {
+  const rows = Array.isArray(listed) ? listed.slice() : [];
+  const want = listedOrEmpty(value, rows);
+  return want ? rows : [""].concat(rows);
+}
