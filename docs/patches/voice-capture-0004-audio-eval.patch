@@ -0,0 +1,366 @@
+"""Measure speech-to-text accuracy and end-to-end sorting from audio.
+
+Three steps, each usable alone:
+
+    python evals/audio/run_audio.py transcribe --clips DIR --out transcripts.jsonl [--url URL]
+    python evals/audio/run_audio.py wer --transcripts transcripts.jsonl
+    python evals/audio/run_audio.py merge --transcripts transcripts.jsonl --preds preds.jsonl --out results.jsonl
+    python evals/audio/run_audio.py sort --transcripts transcripts.jsonl --out preds.jsonl [--retry-errors-of OLD.jsonl]
+
+`transcribe` POSTs each `DIR/<case id>.<ext>` to the running server's /transcribe as
+raw application/octet-stream (what the iPhone Shortcut sends) and records the text and
+the wall-clock seconds. `wer` is word error rate against the case transcripts, stdlib
+only. `sort` feeds each recovered transcript through the real CaptureService._classify
+with the case's own "today" (the machinery in evals/run_eval.py) and scores it with
+evals/score.py against the unchanged expected answers.
+
+A transcript the server returns as empty is what /capture rejects as no_speech_detected:
+nothing is sorted, so it scores as zero items (right for the "empty" cases, a miss for
+any other case). The record keeps `dropped: true` so that is visible.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import re
+import sys
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+import run_eval  # noqa: E402
+import score  # noqa: E402
+
+CASES = HERE.parent / "capture_cases.jsonl"
+CLIP_EXTS = (".mp3", ".wav", ".m4a", ".ogg", ".flac")
+
+# ---------------------------------------------------------------- word error rate
+
+_ONES = {w: i for i, w in enumerate(
+    "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen "
+    "fifteen sixteen seventeen eighteen nineteen".split())}
+_TENS = {w: 10 * i for i, w in enumerate(
+    "_ _ twenty thirty forty fifty sixty seventy eighty ninety".split()) if w != "_"}
+_SCALE = {"hundred": 100, "thousand": 1000}
+_TEENS_AND_TEN = {w for w, n in _ONES.items() if n >= 10}
+
+
+def _tokens(text: str) -> list[str]:
+    text = text.lower().replace("'", "")
+    text = re.sub(r"(?<=\d),(?=\d{3})", "", text)  # 1,500 -> 1500
+    return re.findall(r"[a-z0-9]+(?:\.[0-9]+)?", text)
+
+
+def normalise(text: str) -> list[str]:
+    """Lowercase words, punctuation stripped, number words folded into digits.
+
+    "one hundred and fifty" -> "150", "twenty one" -> "21", but "one two three" stays three
+    numbers ("1 2 3"): a unit only joins the number before it after a tens word, "hundred",
+    "thousand" or "and".
+    """
+    toks = _tokens(text)
+    out: list[str] = []
+    i = 0
+    while i < len(toks):
+        if toks[i] not in _ONES and toks[i] not in _TENS:
+            out.append(toks[i])
+            i += 1
+            continue
+        total, cur, last, j = 0, 0, None, i
+        while j < len(toks):
+            w = toks[j]
+            joins = last in ("tens", "scale", "and")
+            if w in _ONES and (last is None or (joins and (w not in _TEENS_AND_TEN or last != "tens"))):
+                if last is None or last != "tens" or _ONES[w] < 10:
+                    cur += _ONES[w]
+                    last = "tens-unit" if last == "tens" else "unit"
+                else:
+                    break
+            elif w in _TENS and (last is None or last in ("scale", "and")):
+                cur += _TENS[w]
+                last = "tens"
+            elif w in _SCALE and last is not None and last != "and" and (cur or total):
+                if w == "hundred":
+                    cur = (cur or 1) * 100
+                else:
+                    total += (cur or 1) * 1000
+                    cur = 0
+                last = "scale"
+            elif w == "and" and last in ("scale",) and j + 1 < len(toks) and (toks[j + 1] in _ONES or toks[j + 1] in _TENS):
+                last = "and"
+            else:
+                break
+            j += 1
+        if last == "and":
+            j -= 1
+        out.append(str(total + cur))
+        i = max(j, i + 1)
+    return out
+
+
+def edit_distance(ref: list[str], hyp: list[str]) -> int:
+    prev = list(range(len(hyp) + 1))
+    for i, r in enumerate(ref, 1):
+        cur = [i]
+        for j, h in enumerate(hyp, 1):
+            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (r != h)))
+        prev = cur
+    return prev[-1]
+
+
+def wer(ref: str, hyp: str, *, fold_numbers: bool) -> tuple[int, int]:
+    """(errors, reference words). The caller sums both to get a corpus rate."""
+    if fold_numbers:
+        r, h = normalise(ref), normalise(hyp)
+    else:
+        r, h = _tokens(ref), _tokens(hyp)
+    return edit_distance(r, h), len(r)
+
+
+def wer_report(cases: list[dict], recs: list[dict]) -> dict:
+    by_id = {r["id"]: r for r in recs}
+    out = {"raw": [0, 0], "normalised": [0, 0], "per_case": []}
+    for c in cases:
+        hyp = by_id.get(c["id"], {}).get("transcript", "")
+        row = {"id": c["id"]}
+        for key, fold in (("raw", False), ("normalised", True)):
+            e, n = wer(c["transcript"], hyp, fold_numbers=fold)
+            out[key][0] += e
+            out[key][1] += n
+            row[key] = [e, n]
+        out["per_case"].append(row)
+    out["raw_wer"] = out["raw"][0] / max(out["raw"][1], 1)
+    out["normalised_wer"] = out["normalised"][0] / max(out["normalised"][1], 1)
+    return out
+
+
+# ------------------------------------------------------------------ transcribe
+
+def _rss_mb(pid: int | None) -> float | None:
+    if not pid:
+        return None
+    try:
+        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
+            if line.startswith("VmRSS:"):
+                return round(int(line.split()[1]) / 1024, 1)
+    except OSError:
+        return None
+    return None
+
+
+def post_clip(url: str, path: Path, timeout: float = 300.0) -> dict:
+    """POST one clip as raw octet-stream. Returns the server JSON."""
+    req = urllib.request.Request(
+        url.rstrip("/") + "/transcribe?log=false&language=auto",
+        data=path.read_bytes(),
+        headers={"Content-Type": "application/octet-stream"},
+        method="POST",
+    )
+    with urllib.request.urlopen(req, timeout=timeout) as resp:
+        return json.loads(resp.read())
+
+
+def transcribe_all(cases: list[dict], clips: Path, url: str, *, server_pid: int | None = None,
+                   post=post_clip, log=print) -> list[dict]:
+    recs = []
+    for c in cases:
+        clip = next((clips / f"{c['id']}{e}" for e in CLIP_EXTS if (clips / f"{c['id']}{e}").exists()), None)
+        if clip is None:
+            recs.append({"id": c["id"], "transcript": "", "seconds": 0.0, "error": "clip missing"})
+            continue
+        t0 = time.perf_counter()
+        try:
+            text = (post(url, clip).get("text") or "").strip()
+            rec = {"id": c["id"], "transcript": text, "seconds": round(time.perf_counter() - t0, 3)}
+        except (urllib.error.URLError, OSError, ValueError) as e:
+            rec = {"id": c["id"], "transcript": "", "seconds": round(time.perf_counter() - t0, 3),
+                   "error": f"{type(e).__name__}: {e}"}
+        rss = _rss_mb(server_pid)
+        if rss is not None:
+            rec["server_rss_mb"] = rss
+        recs.append(rec)
+        log(f"  {c['id']}: {rec['seconds']}s {rec.get('error', '')}")
+    return recs
+
+
+# ------------------------------------------------------------------------ sort
+
+def is_rate_limit(e: BaseException) -> bool:
+    s = f"{type(e).__name__} {e}"
+    return "429" in s or "RESOURCE_EXHAUSTED" in s
+
+
+def is_overloaded(e: BaseException) -> bool:
+    """Gemini's 503 'high demand' and a classify timeout are transient and say nothing about the transcript."""
+    s = f"{type(e).__name__} {e}"
+    return "503" in s or "UNAVAILABLE" in s or isinstance(e, TimeoutError)
+
+
+def is_daily_quota(e: BaseException) -> bool:
+    s = str(e).lower()
+    return "perday" in s.replace(" ", "").replace("_", "") or "daily" in s
+
+
+async def sort_all(cases: list[dict], recs: list[dict], *, backend: str = "gemini", model: str | None = None,
+                   client=None, api_key: str | None = None, delay: float = 5.0, retry_wait: float = 60.0,
+                   max_retries: int = 8, previous: list[dict] | None = None, log=print) -> list[dict]:
+    """One sorter call at a time. A 429 or 503 waits and retries; a daily-quota error stops the run.
+
+    `previous` is an earlier predictions file: its answers are kept as they are and only the
+    cases that ended in an error (a failed call, not a wrong answer) are sorted again.
+    """
+    kept = {p["id"]: p for p in (previous or []) if "error" not in p}
+    capture = run_eval.load_capture_module()
+    service = capture.CaptureService(api_key=api_key, store=None, backend=backend, model=model,
+                                     topics=run_eval.TOPICS, default_currency=run_eval.DEFAULT_CURRENCY,
+                                     client=client)
+    by_id = {r["id"]: r for r in recs}
+    preds: list[dict] = []
+    stopped = False
+    for c in cases:
+        text = by_id.get(c["id"], {}).get("transcript", "")
+        if c["id"] in kept:
+            preds.append(kept[c["id"]])
+            continue
+        if stopped:
+            preds.append({"id": c["id"], "items": [], "error": "not sorted: daily quota reached"})
+            continue
+        if not text:
+            preds.append({"id": c["id"], "items": [], "dropped": True})
+            log(f"  {c['id']}: dropped (empty transcript, no sort call)")
+            continue
+        pred = None
+        for attempt in range(max_retries + 1):
+            if delay:
+                await asyncio.sleep(delay)
+            try:
+                items = await service._classify(text, run_eval.parse_today(c["today"]))
+                pred = {"id": c["id"], "items": [i.model_dump() for i in items]}
+                break
+            except Exception as e:  # noqa: BLE001 - recorded, and the scorer fails the case
+                if is_rate_limit(e) and is_daily_quota(e):
+                    stopped = True
+                    pred = {"id": c["id"], "items": [], "error": f"daily quota: {e}"[:300]}
+                    break
+                if (is_rate_limit(e) or is_overloaded(e)) and attempt < max_retries:
+                    log(f"  {c['id']}: 429/503, waiting {retry_wait:.0f}s (retry {attempt + 1}/{max_retries})")
+                    await asyncio.sleep(retry_wait)
+                    continue
+                pred = {"id": c["id"], "items": [], "error": f"{type(e).__name__}: {e}"[:300]}
+                break
+        preds.append(pred)
+        log(f"  {c['id']}: {pred.get('error') or str(len(pred['items'])) + ' item(s)'}")
+    return preds
+
+
+def merge(cases: list[dict], recs: list[dict], preds: list[dict], repeat: list[dict] | None = None) -> list[dict]:
+    """One row per case: what was heard, how long it took, what was sorted, whether it passed."""
+    r_by, p_by = {r["id"]: r for r in recs}, {p["id"]: p for p in preds}
+    res = {r["id"]: r for r in score.score(cases, preds)["results"]}
+    res2 = {r["id"]: r for r in score.score(cases, repeat)["results"]} if repeat else {}
+    rows = []
+    for c in cases:
+        r, p = r_by.get(c["id"], {}), p_by.get(c["id"], {})
+        row = {"id": c["id"], "source": c["transcript"], "heard": r.get("transcript", ""), "seconds": r.get("seconds"),
+               "server_rss_mb": r.get("server_rss_mb"), "items": p.get("items", []), "passed": res[c["id"]]["passed"],
+               "why": res[c["id"]]["why"]}
+        for k in ("error", "dropped"):
+            if k in p:
+                row[k] = p[k]
+        if repeat:  # same transcript sorted a second time: the sorter's own run-to-run noise
+            row["passed_repeat"] = res2[c["id"]]["passed"]
+        rows.append(row)
+    return rows
+
+
+def compare(cases: list[dict], clean_preds: list[dict], audio_preds: list[dict]) -> dict:
+    """Per case: pass on clean text vs pass from audio. Which flipped."""
+    def passed(preds):
+        rep = score.score(cases, preds)
+        return {r["id"]: r["passed"] for r in rep["results"]}
+    a, b = passed(clean_preds), passed(audio_preds)
+    return {
+        "clean_pass": sum(a.values()), "audio_pass": sum(b.values()),
+        "lost": sorted(i for i in a if a[i] and not b.get(i)),
+        "gained": sorted(i for i in a if not a[i] and b.get(i)),
+    }
+
+
+# ------------------------------------------------------------------------- cli
+
+def _write(path: str, rows: list[dict]) -> None:
+    with open(path, "w", encoding="utf-8") as f:
+        for r in rows:
+            f.write(json.dumps(r, ensure_ascii=False) + "\n")
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    t = sub.add_parser("transcribe")
+    t.add_argument("--clips", required=True)
+    t.add_argument("--out", required=True)
+    t.add_argument("--url", default="http://127.0.0.1:8000")
+    t.add_argument("--server-pid", type=int, default=None, help="record this process's RSS after each clip")
+    t.add_argument("--cases", default=str(CASES))
+    w = sub.add_parser("wer")
+    w.add_argument("--transcripts", required=True)
+    w.add_argument("--cases", default=str(CASES))
+    m = sub.add_parser("merge")
+    m.add_argument("--transcripts", required=True)
+    m.add_argument("--preds", required=True)
+    m.add_argument("--out", required=True)
+    m.add_argument("--repeat", default=None, metavar="PREDS", help="a second sort of the same transcripts")
+    m.add_argument("--cases", default=str(CASES))
+    s = sub.add_parser("sort")
+    s.add_argument("--transcripts", required=True)
+    s.add_argument("--out", required=True)
+    s.add_argument("--cases", default=str(CASES))
+    s.add_argument("--backend", choices=("claude", "gemini"), default="gemini")
+    s.add_argument("--model", default=None)
+    s.add_argument("--delay", type=float, default=5.0)
+    s.add_argument("--retry-errors-of", default=None, metavar="PREDS",
+                   help="keep the answers in this earlier file; sort again only the cases that ended in an error")
+    args = ap.parse_args(argv)
+
+    cases = score.load_jsonl(args.cases)
+    if args.cmd == "transcribe":
+        recs = transcribe_all(cases, Path(args.clips), args.url, server_pid=args.server_pid)
+        _write(args.out, recs)
+        secs = [r["seconds"] for r in recs if not r.get("error")]
+        print(f"wrote {args.out}: {len(secs)} ok, {len(recs) - len(secs)} failed, "
+              f"mean {sum(secs) / max(len(secs), 1):.2f}s per clip")
+        return 0
+    recs = score.load_jsonl(args.transcripts)
+    if args.cmd == "merge":
+        rows = merge(cases, recs, score.load_jsonl(args.preds),
+                     score.load_jsonl(args.repeat) if args.repeat else None)
+        _write(args.out, rows)
+        print(f"wrote {args.out}: {sum(r['passed'] for r in rows)}/{len(rows)} passed")
+        return 0
+    if args.cmd == "wer":
+        rep = wer_report(cases, recs)
+        print(f"WER raw {rep['raw_wer']:.1%} ({rep['raw'][0]}/{rep['raw'][1]}), "
+              f"numbers folded {rep['normalised_wer']:.1%} ({rep['normalised'][0]}/{rep['normalised'][1]})")
+        return 0
+    key_name = "ANTHROPIC_API_KEY" if args.backend == "claude" else "GEMINI_API_KEY"
+    api_key = os.environ.get(key_name)
+    if not api_key:
+        print(f"{key_name} is not set", file=sys.stderr)
+        return 2
+    previous = score.load_jsonl(args.retry_errors_of) if args.retry_errors_of else None
+    preds = asyncio.run(sort_all(cases, recs, backend=args.backend, model=args.model, api_key=api_key,
+                                 delay=args.delay, previous=previous))
+    _write(args.out, preds)
+    print(score.format_report(score.score(cases, preds), cases))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
