+"""Runner tests with the network stubbed. Run: python -m pytest evals/audio -c /dev/null"""
+
+import asyncio
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+sys.path.insert(0, str(HERE.parent))
+import run_audio as ra  # noqa: E402
+
+CASE = {"id": "a", "today": "2026-11-12 Thursday", "transcript": "paid sixty ringgit for the helmet",
+        "expected": [{"kind": "expense", "must_contain": ["helmet"], "amount": 60, "currency": "MYR",
+                      "due": None, "topic": None}]}
+
+
+def test_wer_exact_is_zero():
+    assert ra.wer("paid 60 ringgit", "Paid 60 ringgit.", fold_numbers=False) == (0, 3)
+
+
+def test_wer_counts_a_substitution():
+    assert ra.wer("paid 60 ringgit", "paid 60 ring it", fold_numbers=False) == (2, 3)
+
+
+def test_number_words_equal_digits_only_when_folded():
+    assert ra.wer("paid sixty ringgit", "paid 60 ringgit", fold_numbers=False)[0] == 1
+    assert ra.wer("paid sixty ringgit", "paid 60 ringgit", fold_numbers=True)[0] == 0
+
+
+def test_fold_compound_numbers():
+    assert ra.normalise("one hundred and fifty") == ["150"]
+    assert ra.normalise("two thousand five hundred") == ["2500"]
+    assert ra.normalise("fourteen pallets") == ["14", "pallets"]
+    assert ra.normalise("1,500 ringgit") == ["1500", "ringgit"]
+
+
+def test_wer_can_fail_on_a_real_mishearing():
+    errors, n = ra.wer("lorry arrives at three", "lorry arrives at tree", fold_numbers=True)
+    assert errors == 1 and n == 4
+
+
+def test_transcribe_all_records_text_and_seconds(tmp_path):
+    (tmp_path / "a.mp3").write_bytes(b"x")
+    recs = ra.transcribe_all([CASE], tmp_path, "http://x", post=lambda url, p: {"text": " hi there "}, log=lambda *_: None)
+    assert recs[0]["transcript"] == "hi there" and recs[0]["seconds"] >= 0 and "error" not in recs[0]
+
+
+def test_transcribe_all_missing_clip_and_server_error(tmp_path):
+    recs = ra.transcribe_all([CASE], tmp_path, "http://x", log=lambda *_: None)
+    assert recs[0]["error"] == "clip missing"
+    (tmp_path / "a.mp3").write_bytes(b"x")
+
+    def boom(url, p):
+        raise OSError("refused")
+
+    recs = ra.transcribe_all([CASE], tmp_path, "http://x", post=boom, log=lambda *_: None)
+    assert "OSError" in recs[0]["error"]
+
+
+class _Parsed:
+    def __init__(self, items):
+        self.items = items
+
+
+class StubClient:
+    """Stands in for google-genai: first N calls raise, then return one expense item."""
+
+    def __init__(self, fail_with=None, fail_times=0):
+        self.calls, self.fail_with, self.fail_times = 0, fail_with, fail_times
+        self.aio = self
+        self.models = self
+
+    async def generate_content(self, **kw):
+        self.calls += 1
+        if self.calls <= self.fail_times:
+            raise RuntimeError(self.fail_with)
+        capture = ra.run_eval.load_capture_module()
+        item = capture.CaptureItem(kind="expense", text="helmet", amount=60, currency="MYR", due=None, topic=None)
+
+        class R:
+            parsed = capture.CaptureItems(items=[item])
+
+        return R()
+
+
+def _sort(client, recs, **kw):
+    return asyncio.run(ra.sort_all([CASE], recs, client=client, api_key="k", delay=0, retry_wait=0, log=lambda *_: None, **kw))
+
+
+def test_sort_scores_against_unchanged_expected():
+    preds = _sort(StubClient(), [{"id": "a", "transcript": CASE["transcript"]}])
+    assert ra.score.score([CASE], preds)["passed"] == 1
+
+
+def test_sort_retries_a_429_then_succeeds():
+    client = StubClient(fail_with="429 RESOURCE_EXHAUSTED per minute", fail_times=2)
+    preds = _sort(client, [{"id": "a", "transcript": "x"}])
+    assert client.calls == 3 and "error" not in preds[0]
+
+
+def test_sort_gives_up_after_max_retries():
+    client = StubClient(fail_with="429 RESOURCE_EXHAUSTED", fail_times=99)
+    preds = _sort(client, [{"id": "a", "transcript": "x"}], max_retries=2)
+    assert client.calls == 3 and "error" in preds[0]
+    assert ra.score.score([CASE], preds)["passed"] == 0
+
+
+def test_sort_stops_on_daily_quota():
+    client = StubClient(fail_with="429 RESOURCE_EXHAUSTED PerDay quota", fail_times=99)
+    two = [CASE, {**CASE, "id": "b"}]
+    preds = asyncio.run(ra.sort_all(two, [{"id": "a", "transcript": "x"}, {"id": "b", "transcript": "y"}], client=client,
+                                    api_key="k", delay=0, retry_wait=0, log=lambda *_: None))
+    assert client.calls == 1 and "daily quota" in preds[1]["error"]
+
+
+def test_empty_transcript_is_dropped_without_a_call():
+    client = StubClient()
+    empty = {**CASE, "id": "e", "expected": []}
+    preds = asyncio.run(ra.sort_all([empty], [{"id": "e", "transcript": ""}], client=client, api_key="k", delay=0,
+                                    log=lambda *_: None))
+    assert client.calls == 0 and preds[0]["dropped"] and ra.score.score([empty], preds)["passed"] == 1
+
+
+def test_a_dropped_non_empty_case_still_fails():
+    preds = asyncio.run(ra.sort_all([CASE], [{"id": "a", "transcript": ""}], client=StubClient(), api_key="k", delay=0,
+                                    log=lambda *_: None))
+    assert ra.score.score([CASE], preds)["passed"] == 0
+
+
+def test_compare_names_the_case_that_flipped():
+    good = [{"id": "a", "items": [{"kind": "expense", "text": "helmet", "amount": 60, "currency": "MYR"}]}]
+    bad = [{"id": "a", "items": []}]
+    assert ra.compare([CASE], good, bad)["lost"] == ["a"]
+    assert ra.compare([CASE], bad, good)["gained"] == ["a"]
+
+
+def test_sort_retries_a_503_overload():
+    client = StubClient(fail_with="503 UNAVAILABLE. high demand", fail_times=1)
+    preds = _sort(client, [{"id": "a", "transcript": "x"}])
+    assert client.calls == 2 and "error" not in preds[0]
+
+
+def test_retry_errors_keeps_answers_and_redoes_only_errors():
+    two = [CASE, {**CASE, "id": "b"}]
+    recs = [{"id": "a", "transcript": "x"}, {"id": "b", "transcript": "y"}]
+    previous = [{"id": "a", "items": [{"kind": "note", "text": "kept as is"}]},
+                {"id": "b", "items": [], "error": "ServerError: 503"}]
+    client = StubClient()
+    preds = asyncio.run(ra.sort_all(two, recs, client=client, api_key="k", delay=0, previous=previous,
+                                    log=lambda *_: None))
+    assert client.calls == 1 and preds[0]["items"][0]["text"] == "kept as is" and "error" not in preds[1]
+
+
+def test_fold_does_not_add_spoken_digits():
+    assert ra.normalise("one two three") == ["1", "2", "3"]
+    assert ra.normalise("twenty one") == ["21"]
+    assert ra.normalise("six ringgit fifty sen") == ["6", "ringgit", "50", "sen"]
+    assert ra.wer("testing one two three", "testing 1 2 3", fold_numbers=True)[0] == 0
+
+
+def test_merge_keeps_heard_text_and_the_verdict():
+    recs = [{"id": "a", "transcript": "paid sixty ringgit for the helmet", "seconds": 1.5}]
+    preds = [{"id": "a", "items": [{"kind": "expense", "text": "helmet", "amount": 60, "currency": "MYR"}]}]
+    row = ra.merge([CASE], recs, preds)[0]
+    assert row["heard"].startswith("paid sixty") and row["seconds"] == 1.5 and row["passed"] is True
+
+
+def test_sort_retries_a_timeout():
+    class Once(StubClient):
+        async def generate_content(self, **kw):
+            if self.calls == 0:
+                self.calls += 1
+                raise TimeoutError()
+            return await super().generate_content(**kw)
+
+    client = Once()
+    preds = _sort(client, [{"id": "a", "transcript": "x"}])
+    assert client.calls == 2 and "error" not in preds[0]
+
+
+def test_merge_records_the_repeat_verdict():
+    recs = [{"id": "a", "transcript": "x"}]
+    good = [{"id": "a", "items": [{"kind": "expense", "text": "helmet", "amount": 60, "currency": "MYR"}]}]
+    row = ra.merge([CASE], recs, good, repeat=[{"id": "a", "items": []}])[0]
+    assert row["passed"] is True and row["passed_repeat"] is False
