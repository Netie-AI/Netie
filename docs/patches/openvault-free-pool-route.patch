diff --git a/OpenMW/tests/test_free_pool_route.py b/OpenMW/tests/test_free_pool_route.py
new file mode 100644
index 0000000..78d7b64
--- /dev/null
+++ b/OpenMW/tests/test_free_pool_route.py
@@ -0,0 +1,58 @@
+"""POST /api/route/free: register help, never invented keys."""
+
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+from openmw.openvault.app import create_app
+
+
+def _client() -> TestClient:
+    app = create_app(mock_health=True, enable_precheck_loop=False)
+    return TestClient(app, client=("127.0.0.1", 5555))
+
+
+def test_empty_pool_is_503_with_register(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/route/free",
+        json={
+            "catalog": [
+                {
+                    "id": "openrouter",
+                    "tier": "paid",
+                    "register_url": "https://openrouter.ai/keys",
+                }
+            ]
+        },
+    )
+    assert resp.status_code == 503
+    body = resp.json()
+    assert body["register"][0]["register_url"] == "https://openrouter.ai/keys"
+    assert "api_key" not in resp.text
+
+
+def test_free_tier_is_200(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/route/free",
+        json={
+            "catalog": [
+                {"id": "ollama", "tier": "local", "register_url": "http://127.0.0.1:11434"}
+            ]
+        },
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["pool"][0]["id"] == "ollama"
+    assert body["used_paid"] is False
+
+
+def test_catalog_key_field_is_400(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/route/free",
+        json={"catalog": [{"id": "x", "tier": "free", "api_key": "SECRET"}]},
+    )
+    assert resp.status_code == 400
+    assert "SECRET" not in resp.text
