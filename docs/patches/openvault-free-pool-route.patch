@@ -1229,6 +1229,38 @@ def create_app(
         """Uptime for this process and every mesh surface. ``up: null`` = unprobed."""
         return uptime_payload()
 
+    @app.post("/api/route/free")
+    async def api_route_free(request: Request) -> JSONResponse:
+        """FREE-token pool + register help. Never invent keys. Not a 16th sort."""
+        from openmw.openvault.route.free_pool import pick_free_pool
+
+        try:
+            payload = await request.json()
+        except Exception:
+            return JSONResponse(status_code=400, content={"error": "invalid json"})
+        if not isinstance(payload, dict):
+            return JSONResponse(status_code=400, content={"error": "object body"})
+        catalog = payload.get("catalog") or []
+        if not isinstance(catalog, list):
+            return JSONResponse(status_code=400, content={"error": "catalog must be a list"})
+        try:
+            out = pick_free_pool(
+                catalog,
+                allow_paid=bool(payload.get("allow_paid")),
+                register=payload.get("register", True) is not False,
+                parallel=payload.get("parallel", False),
+                fetch_quota=payload.get("fetch_quota", False),
+                auto_combo=payload.get("auto_combo", False),
+            )
+        except Exception as exc:
+            code = int(getattr(exc, "status_code", None) or getattr(exc, "code", 503) or 503)
+            help_rows = getattr(exc, "help", [])
+            body = {"error": str(exc), "type": "no_free_hop" if code == 503 else "free_pool"}
+            if help_rows:
+                body["register"] = help_rows
+            return JSONResponse(status_code=code, content=body)
+        return JSONResponse(content=out)
+
