diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index 72e10ce..b82fd88 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -513,3 +513,43 @@ test("ghostWalk matches IR fetch_from and data_point", () => {
   assert.equal(walked.log[0].data_point, null);
   assert.equal(walked.log[0].fetch_from, null);
 });
+
+test("tool_call unknown action_type does not compile", () => {
+  const ir = compileIR({
+    nodes: [{ id: "t", kind: "tool_call", action_type: "bash" }],
+    edges: [],
+  });
+  assert.equal(ir.error, "tool_call unknown action_type");
+  assert.deepEqual(ir.nodes, []);
+});
+
+test("unlisted action_type on a non-tool node is dropped", () => {
+  const ir = compileIR({
+    nodes: [{ id: "a", kind: "app", action_type: "emit" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.nodes[0].action_type, null);
+  assert.equal(ir.nodes[0].requires_confirm, false);
+});
+
+test("export_pptx on foundry requires confirm", () => {
+  const ir = compileIR({
+    nodes: [{ id: "f", kind: "foundry", action_type: "export_pptx" }],
+    edges: [],
+  });
+  assert.equal(ir.nodes[0].action_type, "export_pptx");
+  assert.equal(ir.nodes[0].requires_confirm, true);
+});
+
+test("ghostWalk refuses unknown tool_call action", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [{ id: "t", kind: "tool_call", action_type: "bash" }],
+      edges: [],
+    },
+    true
+  );
+  assert.equal(walked.error, "tool_call unknown action_type");
+  assert.deepEqual(walked.log, []);
+});
