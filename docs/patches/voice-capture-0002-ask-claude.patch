diff --git a/app/services/llm_claude.py b/app/services/llm_claude.py
new file mode 100644
index 0000000..22d76f6
--- /dev/null
+++ b/app/services/llm_claude.py
@@ -0,0 +1,87 @@
+"""Claude client for POST /ask. Same surface as `llm.LLMClient` (Gemini).
+
+The lifespan picks this one when `ANTHROPIC_API_KEY` is set; otherwise `/ask`
+stays on Gemini exactly as before. Reads `CLAUDE_MODEL` and
+`CLAUDE_SYSTEM_PROMPT` through `app.config`.
+"""
+
+import logging
+from collections.abc import AsyncIterator
+
+import anthropic
+
+from app.services.llm import LLMConfigError, LLMUpstreamError
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_CLAUDE_MODEL = "claude-opus-5-5"
+DEFAULT_SYSTEM_PROMPT = (
+    "You are a voice assistant. The user asks by voice or text and the answer may "
+    "be read aloud, so reply briefly in plain spoken language with no markdown. "
+    "Answer in the language the user used."
+)
+FALLBACK_BETA = "server-side-fallback-2026-07-01"
+
+
+class ClaudeLLMClient:
+    """Single-shot and streaming Claude wrapper."""
+
+    def __init__(
+        self,
+        api_key: str | None,
+        model: str | None,
+        system_prompt: str | None,
+        *,
+        client_factory=None,
+    ):
+        self.api_key = api_key or None
+        self.model = model or DEFAULT_CLAUDE_MODEL
+        self.system_prompt = system_prompt or DEFAULT_SYSTEM_PROMPT
+        self._client_factory = client_factory or anthropic.AsyncAnthropic
+        self._client = None
+
+    @property
+    def configured(self) -> bool:
+        return bool(self.api_key)
+
+    def _ensure_client(self):
+        if not self.api_key:
+            raise LLMConfigError("ANTHROPIC_API_KEY is not configured")
+        if self._client is None:
+            self._client = self._client_factory(api_key=self.api_key)
+        return self._client
+
+    def _request(self, user_text: str) -> dict:
+        return {
+            "model": self.model,
+            "max_tokens": 16000,
+            "system": self.system_prompt,
+            "messages": [{"role": "user", "content": user_text}],
+            "betas": [FALLBACK_BETA],
+            "fallbacks": "default",
+        }
+
+    async def ask(self, user_text: str) -> str:
+        """Single-shot completion. Returns the answer text."""
+        client = self._ensure_client()
+        try:
+            response = await client.beta.messages.create(**self._request(user_text))
+        except Exception as e:
+            raise LLMUpstreamError(f"Claude call failed: {e}") from e
+        if response.stop_reason == "refusal":
+            raise LLMUpstreamError("Claude declined to answer")
+        return "".join(b.text for b in response.content if b.type == "text")
+
+    async def ask_stream(self, user_text: str) -> AsyncIterator[str]:
+        """Yield text deltas as Claude streams them."""
+        client = self._ensure_client()
+        try:
+            async with client.beta.messages.stream(**self._request(user_text)) as stream:
+                async for text in stream.text_stream:
+                    if text:
+                        yield text
+                final = await stream.get_final_message()
+        except Exception as e:
+            raise LLMUpstreamError(f"Claude streaming failed: {e}") from e
+        if final.stop_reason == "refusal":
+            raise LLMUpstreamError("Claude declined to answer")
