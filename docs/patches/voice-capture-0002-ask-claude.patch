@@ -72,11 +72,19 @@ If Claude is unreachable, the key is wrong, or it declines, you still get HTTP 2
 `Saved UNSORTED to inbox (...)`. The transcript is in `inbox.md` and `transcripts.jsonl`.
 Nothing is dropped.
 
+## /ask on Claude
+
+Setting `ANTHROPIC_API_KEY` also moves the existing `POST /ask` endpoint (and the bundled
+ASR-Ask Shortcut) from Gemini to Claude. `/status` still reports it under the `gemini` key,
+because the PWA reads that name; the `model` value there shows which one is live.
+
 ## Settings
 
 | Variable | Default | Meaning |
 |---|---|---|
-| `ANTHROPIC_API_KEY` | none | Claude key. Unset means everything goes to the inbox. |
+| `ANTHROPIC_API_KEY` | none | Claude key. Unset means captures go to the inbox and `/ask` stays on Gemini. |
+| `CLAUDE_MODEL` | `claude-opus-5-5` | Model for `/ask`. |
+| `CLAUDE_SYSTEM_PROMPT` | short voice-assistant persona | System prompt for `/ask`. |
 | `CAPTURE_TOKEN` | none | Bearer token the Shortcut sends. Unset means 503. |
 | `CAPTURE_MODEL` | `claude-opus-5-5` | Any Claude model id. |
 | `CAPTURE_TOPICS` | empty | Comma-separated tags Claude may attach. |
diff --git a/tests/test_llm_claude.py b/tests/test_llm_claude.py
new file mode 100644
index 0000000..175b18a
--- /dev/null
+++ b/tests/test_llm_claude.py
@@ -0,0 +1,114 @@
+"""Unit tests for app/services/llm_claude.py (Claude backend for /ask)."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from app.services.llm import LLMConfigError, LLMUpstreamError
+from app.services.llm_claude import (
+    DEFAULT_CLAUDE_MODEL,
+    DEFAULT_SYSTEM_PROMPT,
+    ClaudeLLMClient,
+)
+
+
+def _text(s):
+    return SimpleNamespace(type="text", text=s)
+
+
+def _client(fake=None, **kw):
+    kw.setdefault("api_key", "k")
+    kw.setdefault("model", None)
+    kw.setdefault("system_prompt", None)
+    return ClaudeLLMClient(client_factory=MagicMock(return_value=fake), **kw)
+
+
+class _FakeStream:
+    def __init__(self, chunks, stop_reason="end_turn", error=None):
+        self._chunks, self._stop_reason, self._error = chunks, stop_reason, error
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        return False
+
+    @property
+    def text_stream(self):
+        async def gen():
+            for c in self._chunks:
+                yield c
+            if self._error:
+                raise self._error
+
+        return gen()
+
+    async def get_final_message(self):
+        return SimpleNamespace(stop_reason=self._stop_reason)
+
+
+def test_defaults_and_configured():
+    c = _client()
+    assert c.model == DEFAULT_CLAUDE_MODEL
+    assert c.system_prompt == DEFAULT_SYSTEM_PROMPT
+    assert c.configured is True
+    assert _client(api_key=None).configured is False
+    assert _client(api_key="").configured is False
+
+
+async def test_ask_raises_config_error_without_key():
+    with pytest.raises(LLMConfigError):
+        await _client(api_key=None).ask("hi")
+
+
+async def test_ask_forwards_request_and_joins_text_blocks():
+    fake = MagicMock()
+    fake.beta.messages.create = AsyncMock(
+        return_value=SimpleNamespace(
+            stop_reason="end_turn",
+            content=[SimpleNamespace(type="thinking", thinking=""), _text("hello "), _text("back")],
+        )
+    )
+    c = _client(fake, model="m", system_prompt="sp")
+    assert await c.ask("question") == "hello back"
+    kwargs = fake.beta.messages.create.await_args.kwargs
+    assert kwargs["model"] == "m"
+    assert kwargs["system"] == "sp"
+    assert kwargs["messages"] == [{"role": "user", "content": "question"}]
+
+
+async def test_ask_maps_upstream_error_and_refusal():
+    fake = MagicMock()
+    fake.beta.messages.create = AsyncMock(side_effect=Exception("rate limited"))
+    with pytest.raises(LLMUpstreamError, match="rate limited"):
+        await _client(fake).ask("hi")
+
+    fake.beta.messages.create = AsyncMock(
+        return_value=SimpleNamespace(stop_reason="refusal", content=[])
+    )
+    with pytest.raises(LLMUpstreamError, match="declined"):
+        await _client(fake).ask("hi")
+
+
+async def test_ask_stream_yields_deltas_and_skips_empty():
+    fake = MagicMock()
+    fake.beta.messages.stream = MagicMock(return_value=_FakeStream(["hel", "", "lo"]))
+    assert [t async for t in _client(fake).ask_stream("hi")] == ["hel", "lo"]
+
+
+async def test_ask_stream_maps_midstream_error_and_refusal():
+    fake = MagicMock()
+    fake.beta.messages.stream = MagicMock(
+        return_value=_FakeStream(["a"], error=Exception("dropped"))
+    )
+    got = []
+    with pytest.raises(LLMUpstreamError, match="dropped"):
+        async for t in _client(fake).ask_stream("hi"):
+            got.append(t)
+    assert got == ["a"]
+
+    fake.beta.messages.stream = MagicMock(return_value=_FakeStream([], stop_reason="refusal"))
+    with pytest.raises(LLMUpstreamError, match="declined"):
+        async for _ in _client(fake).ask_stream("hi"):
+            pass
