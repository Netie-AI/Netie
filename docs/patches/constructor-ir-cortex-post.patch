diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index a8b41b0..2fd613e 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -10,6 +10,8 @@ const {
   listedOrEmpty,
   listedOptions,
   objectForSetPoint,
+  cortexPayload,
+  nodesWithoutNotes,
 } = require("../engine.js");
 
 test("foundry path ranks orchestrator-subagent first", () => {
@@ -714,3 +716,39 @@ test("compileIR refuses notes over DitchContext", () => {
   assert.equal(ir.error, "notes over DitchContext");
   assert.deepEqual(ir.nodes, []);
 });
+
+test("cortexPayload strips notes and does not POST a leaked body", () => {
+  const packed = cortexPayload({
+    nodes: [{ id: "c", kind: "connector", note: "in" }],
+    edges: [],
+  });
+  assert.equal(packed.error, undefined);
+  assert.equal("note" in packed.body.nodes[0], false);
+  const leak = cortexPayload({
+    nodes: [{ id: "c", kind: "connector", note: "skill_body: SECRET" }],
+    edges: [],
+  });
+  assert.equal(leak.error, "note leaked a body");
+  assert.equal(leak.body, null);
+});
+
+test("cortexPayload refuses a disconnected graph before Cortex", () => {
+  const packed = cortexPayload({
+    nodes: [
+      { id: "a", kind: "connector" },
+      { id: "b", kind: "app" },
+    ],
+    edges: [],
+  });
+  assert.equal(packed.error, "disconnected graph");
+  assert.equal(packed.body, null);
+});
+
+test("nodesWithoutNotes drops only the note field", () => {
+  const rows = nodesWithoutNotes([
+    { id: "c", kind: "connector", note: "in", object_type: "inventory" },
+  ]);
+  assert.equal(rows[0].id, "c");
+  assert.equal(rows[0].object_type, "inventory");
+  assert.equal("note" in rows[0], false);
+});
