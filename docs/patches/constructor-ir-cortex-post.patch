+function nodesWithoutNotes(nodes) {
+  const out = [];
+  for (let i = 0; i < (nodes || []).length; i++) {
+    const n = nodes[i];
+    if (!n || typeof n !== "object") continue;
+    const row = {};
+    for (const k in n) {
+      if (!Object.prototype.hasOwnProperty.call(n, k)) continue;
+      if (k === "note") continue;
+      row[k] = n[k];
+    }
+    out.push(row);
+  }
+  return out;
+}
+
+function cortexPayload(state) {
+  // compileIR is the gate. Raw canvas never POSTs to Cortex.
+  const ir = compileIR(state || {});
+  if (ir.error) {
+    return { error: ir.error, body: null };
+  }
+  return {
+    error: undefined,
+    body: {
+      nodes: nodesWithoutNotes((state && state.nodes) || []),
+      edges: ((state && state.edges) || []).slice(),
+    },
+  };
+}
