+def _sse_ok(*chunks: bytes) -> MagicMock:
+    resp = MagicMock()
+    resp.status_code = 200
+    resp.headers = {"content-type": "text/event-stream"}
+    resp.text = ""
+    resp.iter_bytes = MagicMock(return_value=iter(chunks))
+    resp.read = MagicMock(return_value=b"")
+    resp.close = MagicMock()
+    return resp
+
+
+def test_v1_nameless_fusion_stream_still_400(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="fusion-stream-seat")
+    resp = client.post(
+        "/v1/chat/completions",
+        json={
+            "model": "fusion",
+            "stream": True,
+            "messages": [{"role": "user", "content": "hi"}],
+        },
+        headers=headers,
+    )
+    assert resp.status_code == 400
+    assert resp.json()["error"]["type"] == "openvault_execution_shape"
+
+
+def test_v1_pipeline_stream_last_hop_is_sse(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "pipe-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="pipe-stream-seat")
+    mock = _client_mock()
+    mock.build_request = MagicMock(return_value=object())
+    mock.post = MagicMock(side_effect=[_ok("OUT_A")])
+    mock.send = MagicMock(
+        return_value=_sse_ok(
+            b'data: {"choices":[{"delta":{"content":"Z"}}]}\n\n',
+            b"data: [DONE]\n\n",
+        )
+    )
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        with client.stream(
+            "POST",
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "stream": True,
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "pipeline",
+                    "models": ["gpt-4o-mini", "gpt-4o"],
+                },
+            },
+            headers=headers,
+        ) as resp:
+            assert resp.status_code == 200, resp.read()
+            assert "text/event-stream" in (resp.headers.get("content-type") or "")
+            body = b"".join(resp.iter_bytes())
+    assert b"Z" in body
+    assert b"[DONE]" in body
+    assert mock.post.call_count == 1
+    assert mock.send.call_count == 1
+    first_json = mock.post.call_args.kwargs["json"]
+    assert first_json["stream"] is False
+    assert first_json["messages"][-1]["content"] == "hi"
+    second_json = mock.send.call_args.args[0] if mock.send.call_args.args else None
+    sent_json = mock.send.call_args.kwargs.get("json")
+    if sent_json is None:
+        req = mock.build_request.call_args
+        sent_json = req.kwargs["json"]
+    assert sent_json["stream"] is True
+    assert sent_json["messages"][-1]["content"] == "OUT_A"
+
+
+def test_v1_stream_500_falls_through_to_sse(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "hop-a", priority=1)
+    _healthy(vault, "hop-b", priority=2)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="stream-fail-seat")
+    mock = _client_mock()
+    mock.build_request = MagicMock(return_value=object())
+    bad = _http_err(500, "boom")
+    bad.read = MagicMock(return_value=b"boom")
+    bad.close = MagicMock()
+    mock.send = MagicMock(
+        side_effect=[
+            bad,
+            _sse_ok(b"data: solo\n\n", b"data: [DONE]\n\n"),
+        ]
+    )
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        with client.stream(
+            "POST",
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "stream": True,
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {"strategy": "fusion", "models": ["gpt-4o-mini"]},
+            },
+            headers=headers,
+        ) as resp:
+            assert resp.status_code == 200, resp.read()
+            body = b"".join(resp.iter_bytes())
+    assert b"solo" in body
+    assert mock.send.call_count == 2
+
