+def test_v1_fusion_usage_is_last_hop_not_panel_sum(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    rec = vault.create(
+        label="usage-tokens",
+        provider="openai",
+        secret="sk-test-tokens-aaaaaaaa",
+        role="primary",
+        priority=1,
+        base_url="https://example.invalid/v1",
+    )
+    vault.set_precheck(rec.id, status="ok", latency_ms=1.0, error=None)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="usage-tokens-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(
+        side_effect=[
+            _ok("ans-a", usage={"prompt_tokens": 40, "completion_tokens": 40, "total_tokens": 80}),
+            _ok("ans-b", usage={"prompt_tokens": 50, "completion_tokens": 50, "total_tokens": 100}),
+            _ok(
+                "FINAL",
+                usage={"prompt_tokens": 12, "completion_tokens": 8, "total_tokens": 20},
+            ),
+        ]
+    )
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {
+                    "strategy": "fusion",
+                    "models": ["gpt-4o-mini", "gpt-4o"],
+                    "judgeModel": "gpt-4o-mini",
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["usage"]["total_tokens"] == 20
+    events = client.get("/api/usage").json()["events"]
+    assert len(events) == 1
+    row = events[0]
+    assert row["vault_key_id"] == rec.id
+    assert row["total_tokens"] == 20
+    assert row["estimated"] is False
+    assert row["total_tokens"] != 200
+
+
+
 
 
