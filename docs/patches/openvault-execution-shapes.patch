diff --git a/OpenMW/tests/test_execution_shapes.py b/OpenMW/tests/test_execution_shapes.py
new file mode 100644
index 0000000..e12c42b
--- /dev/null
+++ b/OpenMW/tests/test_execution_shapes.py
@@ -0,0 +1,127 @@
+"""Execution shapes are not apply_strategy permutations."""
+
+from __future__ import annotations
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from openmw.openvault.route.execution import (
+    HANDOFF_EXHAUSTION,
+    PipelineStep,
+    plan_fusion,
+    pick_relay_target,
+    resolve_auto,
+    run_fusion,
+    run_pipeline,
+    should_generate_handoff,
+    ExecutionRefused,
+)
+from openmw.openvault.route.registry import reset_route_state
+from openmw.openvault.route.strategies import StrategyNotASort, apply_strategy
+from openmw.openvault.route.types import EXECUTION_SHAPES, RouteTarget
+from openmw.openvault.routers.route import router as route_router
+
+
+def _targets() -> list[RouteTarget]:
+    return [
+        RouteTarget("a", "openai", "openai/gpt-4", weight=1.0, priority=10, cost=3.0),
+        RouteTarget("b", "anthropic", "anthropic/claude", weight=5.0, priority=20, cost=1.0),
+        RouteTarget("c", "google", "google/gemini", weight=2.0, priority=30, cost=2.0),
+    ]
+
+
+@pytest.mark.parametrize("name", list(EXECUTION_SHAPES))
+def test_apply_strategy_refuses_execution_shapes(name: str) -> None:
+    with pytest.raises(StrategyNotASort):
+        apply_strategy(name, _targets())
+
+
+def test_fusion_fans_out_then_judge() -> None:
+    seen: list[str] = []
+
+    def call(model: str, *, user_text: str, stream: bool, tools, tool_choice, **_k):
+        seen.append(model)
+        if model == "p/judge":
+            assert "[Source 1]" in user_text
+            return "FINAL"
+        return f"ans-{model}"
+
+    plan = plan_fusion(["p/a", "p/b"], judge_model="p/judge")
+    assert run_fusion(plan, call, user_text="Q") == "FINAL"
+    assert seen == ["p/a", "p/b", "p/judge"]
+
+
+def test_fusion_single_is_direct() -> None:
+    plan = plan_fusion(["p/only"])
+    assert plan.mode == "direct"
+
+
+def test_pipeline_threads_and_skips_hidden() -> None:
+    seen: list[str] = []
+
+    def call(model: str, *, user_text: str, **_k):
+        seen.append(model)
+        return f"out-{model}" if model != "p/a" else "OUT_A"
+
+    out = run_pipeline(
+        [
+            PipelineStep("p/a"),
+            PipelineStep("hidden", hidden=True),
+            PipelineStep("p/b", prompt="SUMMARIZE"),
+        ],
+        call,
+        user_text="hi",
+    )
+    assert seen == ["p/a", "p/b"]
+    assert out == "out-p/b"
+
+
+def test_pipeline_empty_intermediate_fails() -> None:
+    def call(model: str, **_k):
+        return "" if model == "p/a" else "ok"
+
+    with pytest.raises(ExecutionRefused) as exc:
+        run_pipeline(
+            [PipelineStep("p/a"), PipelineStep("p/b")],
+            call,
+            user_text="hi",
+        )
+    assert exc.value.code == 502
+
+
+def test_context_relay_skips_unavailable() -> None:
+    assert pick_relay_target(
+        ["codex/x", "openai/a"],
+        available={"codex/x": False, "openai/a": True},
+    ) == "openai/a"
+
+
+def test_context_relay_warning_band() -> None:
+    common = dict(
+        provider="codex",
+        handoff_providers=["codex"],
+        session_id="s",
+        connection_id="c",
+    )
+    assert should_generate_handoff(percent_used=0.84, **common) is False
+    assert should_generate_handoff(percent_used=0.85, **common) is True
+    assert should_generate_handoff(percent_used=HANDOFF_EXHAUSTION, **common) is False
+
+
+def test_auto_must_resolve_to_sort() -> None:
+    assert resolve_auto("cache-optimized") == "cache-optimized"
+    with pytest.raises(ExecutionRefused):
+        resolve_auto("fusion")
+    with pytest.raises(ExecutionRefused):
+        resolve_auto(None)
+
+
+def test_route_api_refuses_fusion_as_sort() -> None:
+    reset_route_state()
+    app = FastAPI()
+    app.include_router(route_router)
+    client = TestClient(app, client=("127.0.0.1", 5555))
+    resp = client.put("/api/route/strategy", json={"strategy": "fusion"})
+    assert resp.status_code == 400
+    assert "execution shape" in resp.json()["detail"]
