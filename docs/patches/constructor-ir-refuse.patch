 });
+
+test("unknown kind does not invent DOCUMENT_REF", () => {
+  const ir = compileIR({
+    nodes: [{ id: "x", kind: "n8n", note: "no" }],
+    edges: [],
+  });
+  assert.equal(ir.error, "unknown kind: n8n");
+  assert.deepEqual(ir.nodes, []);
+  assert.equal(ir.entry_node_id, null);
+});
+
+test("cycle does not emit a fake topo", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "a", kind: "connector" },
+      { id: "b", kind: "ontology" },
+    ],
+    edges: [
+      { from: "a", to: "b" },
+      { from: "b", to: "a" },
+    ],
+  });
+  assert.equal(ir.error, "cycle");
+  assert.deepEqual(ir.nodes, []);
+});
+
+test("dangling edge does not invent a node", () => {
+  const ir = compileIR({
+    nodes: [{ id: "a", kind: "connector" }],
+    edges: [{ from: "a", to: "missing" }],
+  });
+  assert.equal(ir.error, "dangling edge");
+  assert.deepEqual(ir.nodes, []);
+});
