+def test_v1_context_relay_handoff_does_not_cross_seats(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "relay-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat_a, headers_a = issue_key(client, label="relay-scope-a")
+    _seat_b, headers_b = issue_key(client, label="relay-scope-b")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("first"), _ok("second")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        first = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hello"}],
+                "combo": {
+                    "strategy": "context-relay",
+                    "models": ["gpt-4o-mini"],
+                    "handoff": {
+                        "sessionId": "s1",
+                        "summary": "keep going",
+                        "fromAccount": "acct",
+                    },
+                },
+            },
+            headers=headers_a,
+        )
+        second = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "again"}],
+                "combo": {
+                    "strategy": "context-relay",
+                    "models": ["gpt-4o-mini"],
+                    "sessionId": "s1",
+                },
+            },
+            headers=headers_b,
+        )
+    assert first.status_code == 200, first.text
+    assert second.status_code == 200, second.text
+    user = mock.post.call_args_list[1].kwargs["json"]["messages"][-1]["content"]
+    assert "context_handoff" not in user
+    assert user.endswith("again")
+
+
