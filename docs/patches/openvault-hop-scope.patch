+def test_relay_store_scope_isolates_caller_blobs() -> None:
+    store = RelayStore()
+    blob = RelayHandoff("s1", "", "keep going", "acct")
+    remember_relay_handoff(store, blob, scope="seat-a")
+    body = {"combo": {"strategy": "context-relay", "sessionId": "s1"}}
+    assert resolve_relay_handoff(store, body, scope="seat-b") is None
