diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index 05ce073..72e10ce 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -401,3 +401,115 @@ test("ghostWalk does not log an unlisted object_type", () => {
   assert.equal(walked.error, undefined);
   assert.equal(walked.log[0].object_type, null);
 });
+
+test("compileIR drops fetch_from that names an unlisted table", () => {
+  const bad = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "inventory",
+        fetch_from: "warehouse.hr_notes",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(bad.nodes[0].fetch_from, null);
+  const ok = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "inventory",
+        fetch_from: "warehouse.inventory",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(ok.nodes[0].fetch_from, "warehouse.inventory");
+  const mismatch = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "inventory",
+        fetch_from: "warehouse.suppliers",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(mismatch.nodes[0].fetch_from, null);
+});
+
+test("compileIR drops a data_point that is not on the listed object", () => {
+  const bad = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "inventory",
+        data_point: "salary",
+        data_type: "number",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(bad.nodes[0].object_type, "inventory");
+  assert.equal(bad.nodes[0].data_point, null);
+  assert.equal(bad.nodes[0].data_type, null);
+  const ok = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "inventory",
+        data_point: "sku",
+        data_type: "string",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(ok.nodes[0].data_point, "sku");
+  assert.equal(ok.nodes[0].data_type, "string");
+});
+
+test("compileIR drops data_point when object_type was unlisted", () => {
+  const ir = compileIR({
+    nodes: [
+      {
+        id: "c",
+        kind: "connector",
+        object_type: "hr_notes",
+        data_point: "sku",
+        data_type: "string",
+        fetch_from: "warehouse.inventory",
+      },
+    ],
+    edges: [],
+  });
+  assert.equal(ir.nodes[0].object_type, null);
+  assert.equal(ir.nodes[0].data_point, null);
+  assert.equal(ir.nodes[0].data_type, null);
+  assert.equal(ir.nodes[0].fetch_from, null);
+});
+
+test("ghostWalk matches IR fetch_from and data_point", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [
+        {
+          id: "c",
+          kind: "connector",
+          object_type: "inventory",
+          data_point: "salary",
+          fetch_from: "warehouse.hr_notes",
+        },
+      ],
+      edges: [],
+    },
+    true
+  );
+  assert.equal(walked.log[0].object_type, "inventory");
+  assert.equal(walked.log[0].data_point, null);
+  assert.equal(walked.log[0].fetch_from, null);
+});
