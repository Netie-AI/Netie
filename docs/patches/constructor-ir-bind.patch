 const DEFAULT_OBJECTS = ["inventory", "suppliers"];
+const DATA_TYPES = ["string", "number", "integer", "boolean", "date"];
+const DEFAULT_OBJECT_POINTS = {
+  inventory: [
+    "sku",
+    "sku_name",
+    "category",
+    "supplier_id",
+    "location_id",
+    "storage_bin",
+    "quantity_kg",
