+    "last_audit_date",
+    "risk_score",
+  ],
+};
+
+function pointsForObject(name, catalog) {
+  if (catalog && catalog[name] && Array.isArray(catalog[name])) return catalog[name];
+  return DEFAULT_OBJECT_POINTS[name] || [];
+}
+
+function fetchFromListed(fetch, listed, objectType) {
+  const raw = String(fetch || "").trim();
+  if (!raw) return "";
+  const parts = raw.split(".");
+  const table = parts.length >= 2 ? parts[1] : parts[0];
+  if (!objectType || !Array.isArray(listed) || listed.indexOf(table) < 0) return "";
+  if (table !== objectType) return "";
+  return raw;
+}
 
 function listedOptions(listed, value) {
   const rows = Array.isArray(listed) ? listed.slice() : [];
