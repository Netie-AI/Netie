diff --git a/tests/test_netie_index.py b/tests/test_netie_index.py
new file mode 100644
index 0000000..7a0eb5e
--- /dev/null
+++ b/tests/test_netie_index.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Skill bodies stay in the index. python3 tests/test_netie_index.py"""
+
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+import skill_server  # noqa: E402
+
+
+class NetieIndexTests(unittest.TestCase):
+    def test_skill_show_is_brief_json(self) -> None:
+        art = skill_server.do_show("S-0001")
+        self.assertIsNotNone(art)
+        text = skill_server.child_text(art)
+        self.assertNotIn("## Steps", text)
+        row = json.loads(text)
+        self.assertEqual(row["id"], "S-0001")
+        self.assertEqual(row["kind"], "skill")
+        self.assertNotIn("skill_body", row)
+
+    def test_rule_show_keeps_corpus(self) -> None:
+        art = skill_server.do_show("R-0016")
+        self.assertIsNotNone(art)
+        text = skill_server.child_text(art)
+        self.assertIn("R-0016", text)
+        self.assertTrue(len(text) > 80)
+
+
+if __name__ == "__main__":
+    unittest.main()
