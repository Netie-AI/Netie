diff --git a/app/api/capture_view.py b/app/api/capture_view.py
new file mode 100644
index 0000000..c7c7d64
--- /dev/null
+++ b/app/api/capture_view.py
@@ -0,0 +1,86 @@
+"""See and tick what `/capture` filed: JSON routes plus one phone page.
+
+Imports nothing from the rest of `app` except `app.services.capture`, so the
+auth gate and these routes can be tested without the Whisper stack.
+`app/api/capture.py` wires in the real config and service.
+
+  GET  /capture/items       Bearer. Tasks, notes, expenses with totals, inbox.
+  POST /capture/tasks/done  Bearer. {"id": "...", "done": true|false}
+  GET  /capture/ui          No token: the page holds no data and asks for the
+                            token itself, then sends it on every data call.
+"""
+
+import hmac
+from collections.abc import Callable
+from pathlib import Path
+
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from pydantic import BaseModel, Field
+
+from app.services.capture import TaskNotFoundError, TaskStaleError
+
+_PAGE = Path(__file__).with_name("capture_ui.html")
+
+# Inline script and style only, same-origin fetch only, nothing else.
+_PAGE_HEADERS = {
+    "Content-Security-Policy": (
+        "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
+        "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
+    ),
+    "X-Content-Type-Options": "nosniff",
+    "Referrer-Policy": "no-referrer",
+    "Cache-Control": "no-cache",
+}
+
+
+def bearer_token_dependency(get_token: Callable[[], str | None]):
+    """Build the `Authorization: Bearer <token>` check. Token unset fails closed."""
+
+    def require_token(request: Request) -> None:
+        expected = get_token()
+        if not expected:
+            raise HTTPException(status_code=503, detail="CAPTURE_TOKEN is not configured")
+        supplied = request.headers.get("authorization", "")
+        if not hmac.compare_digest(supplied.encode(), f"Bearer {expected}".encode()):
+            raise HTTPException(
+                status_code=401,
+                detail="Invalid or missing bearer token",
+                headers={"WWW-Authenticate": "Bearer"},
+            )
+
+    return require_token
+
+
+class TaskDone(BaseModel):
+    id: str = Field(pattern=r"^[0-9a-f]{16}$")
+    done: bool = True
+
+
+def build_capture_router(
+    get_service: Callable[[Request], object],
+    get_token: Callable[[], str | None],
+) -> APIRouter:
+    """`get_service(request)` returns the CaptureService (only `.store` is used)."""
+    router = APIRouter()
+    auth = [Depends(bearer_token_dependency(get_token))]
+
+    # Plain `def`: file I/O runs in the threadpool, not on the event loop.
+    @router.get("/capture/items", dependencies=auth)
+    def items(request: Request, response: Response) -> dict:
+        response.headers["Cache-Control"] = "no-store"
+        return get_service(request).store.list_items()
+
+    @router.post("/capture/tasks/done", dependencies=auth)
+    def task_done(body: TaskDone, request: Request) -> dict:
+        try:
+            return get_service(request).store.mark_task(body.id, body.done)
+        except TaskNotFoundError:
+            raise HTTPException(404, "No such task. It was edited or removed; reload the list.") from None
+        except TaskStaleError as e:
+            raise HTTPException(409, f"Not changed: {e}. Reload the list.") from None
+
