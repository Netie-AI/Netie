+def _parse_tasks(lines: list[bytes]) -> tuple[list[dict], int]:
+    """Task id = hash of the line's text plus its rank among identical texts.
+
+    The checkbox state is not part of the id, so ticking and unticking keep it.
+    Editing the text changes it, so a stale click finds nothing instead of
+    hitting whatever now sits on that line number.
