+"""Tests for the scorer and the runner. No network: the Anthropic client is a stub.
+
+    python -m pytest evals/ -c /dev/null
+"""
+
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import run_eval  # noqa: E402
+import score  # noqa: E402
+
+CASES = score.load_jsonl(str(HERE / "capture_cases.jsonl"))
+
+
+def exp(kind, kw, amount=None, currency=None, due=None, topic=None):
+    return {"kind": kind, "must_contain": kw, "amount": amount, "currency": currency, "due": due, "topic": topic}
+
+
+def got(kind, text, amount=None, currency=None, due=None, topic=None):
+    return {"kind": kind, "text": text, "amount": amount, "currency": currency, "due": due, "topic": topic}
+
+
+def case(expected, accept=None, id="c1"):
+    c = {"id": id, "today": "2026-11-12 Thursday", "transcript": "t", "expected": expected, "why": "w"}
+    if accept:
+        c.update(ambiguous=True, accept=accept)
+    return c
+
+
+def run(c, items):
+    return score.score_case(c, {"id": c["id"], "items": items})
+
+
+def oracle_items(expected):
+    """A perfect answer built from an expected list (first keyword alternative as text)."""
+    return [got(e["kind"], " ".join(k.split("|")[0] for k in e["must_contain"]).upper(),
+                e["amount"], e["currency"], e["due"], e["topic"]) for e in expected]
+
+
+DEPOSIT = case([exp("expense", ["deposit"], 500, "MYR", topic="motorcycle"),
+                exp("task", ["collect"], due="2026-11-14", topic="motorcycle")])
+DEPOSIT_OK = [got("expense", "Paid deposit for the bike", 500.0, "MYR", topic="motorcycle"),
+              got("task", "Collect the bike", due="2026-11-14", topic="motorcycle")]
+
+
+# --- the scorer passes what is right
+
+def test_correct_prediction_passes():
+    assert run(DEPOSIT, DEPOSIT_OK)["passed"]
+
+
+def test_item_order_does_not_matter():
+    assert run(DEPOSIT, DEPOSIT_OK[::-1])["passed"]
+
+
+def test_leniency_empty_string_currency_case_int_float():
+    c = case([exp("expense", ["lunch"], 12, "MYR")])
+    assert run(c, [got("expense", "LUNCH", 12.0, "myr", due="", topic="  ")])["passed"]
+
+
+def test_keyword_alternatives_and_case_insensitive():
+    c = case([exp("note", ["lori|lorry", "pj"])])
+    assert run(c, [got("note", "Lorry reaches PJ at three")])["passed"]
+    assert not run(c, [got("note", "Truck reaches PJ at three")])["passed"]
+
+
+def test_zero_items_expected_and_given():
+    assert run(case([]), [])["passed"]
+
+
+def test_ambiguous_passes_on_any_alternative():
+    c = case([exp("expense", ["tyre"], 1250, "MYR")], accept=[[exp("expense", ["tyre"], 12.5, "MYR")]])
+    assert run(c, [got("expense", "tyre", 1250, "MYR")])["passed"]
+    assert run(c, [got("expense", "tyre", 12.5, "MYR")])["passed"]
+    assert not run(c, [got("expense", "tyre", 125, "MYR")])["passed"]
+
+
+# --- the scorer can fail: each wrong prediction must be counted as a failure
+
+def wrong(i, **change):
+    items = [dict(x) for x in DEPOSIT_OK]
+    items[i].update(change)
+    return run(DEPOSIT, items)
+
+
+def test_wrong_kind_fails():
+    r = wrong(0, kind="note", amount=None, currency=None)
+    assert not r["passed"] and "kind" in r["why"]
+
+
+def test_wrong_amount_fails():
+    r = wrong(0, amount=50)
+    assert not r["passed"] and "money" in r["why"]
+
+
+def test_wrong_currency_fails():
+    assert not wrong(0, currency="USD")["passed"]
+
+
+def test_wrong_due_fails():
+    r = wrong(1, due="2026-11-15")
+    assert not r["passed"] and r["why"] == "due"
+
+
+def test_missing_due_fails():
+    assert not wrong(1, due=None)["passed"]
+
+
+def test_wrong_topic_fails():
+    r = wrong(1, topic="move")
+    assert not r["passed"] and r["why"] == "topic"
+
+
+def test_missing_keyword_fails():
+    r = wrong(1, text="Pick up the bike")
+    assert not r["passed"] and r["why"] == "text"
+
+
+def test_amount_on_a_note_fails():
+    c = case([exp("note", ["quoted"], topic="motorcycle")])
+    assert not run(c, [got("note", "dealer quoted 9800", 9800, "MYR", topic="motorcycle")])["passed"]
+
+
+def test_too_few_and_too_many_items_fail():
+    assert "count 1 != 2" in run(DEPOSIT, DEPOSIT_OK[:1])["why"]
+    assert not run(DEPOSIT, DEPOSIT_OK + [got("note", "extra")])["passed"]
+    assert not run(case([]), [got("note", "testing testing")])["passed"]
+
+
+def test_error_and_missing_prediction_fail_even_when_zero_items_expected():
+    c = case([])
+    assert not score.score_case(c, {"id": "c1", "items": [], "error": "boom"})["passed"]
+    assert not score.score_case(c, None)["passed"]
+
+
+def test_totals_count_one_deliberately_wrong_prediction_as_a_failure():
+    cases = [DEPOSIT, case([exp("task", ["dentist"])], id="c2")]
+    bad = [dict(DEPOSIT_OK[0], amount=5000), DEPOSIT_OK[1]]
+    preds = [{"id": "c1", "items": bad}, {"id": "c2", "items": [got("task", "call dentist")]}]
+    rep = score.score(cases, preds)
+    assert (rep["passed"], rep["total"]) == (1, 2)
+    assert rep["fields"]["money"] == [2, 3] and rep["fields"]["kind"] == [3, 3]
+    assert rep["count"] == [2, 2]
+    text = score.format_report(rep, cases)
+    assert "FAIL  c1" in text and "PASS  c2" in text and "cases passed      1/2 (50.0%)" in text
+    assert "FAILURES (1)" in text and '"amount": 5000' in text
+
+
+# --- the shipped cases file
+
+def test_cases_file_is_well_formed():
+    assert score.validate_cases(CASES) == []
+    assert 45 <= len(CASES) <= 60
+
+
+def test_validate_cases_catches_a_wrong_weekday():
+    bad = dict(CASES[0], today="2026-11-12 Friday")
+    assert any("is not a Friday" in p for p in score.validate_cases([bad]))
+
+
+def test_every_case_passes_with_its_own_expected_answer_and_each_accepted_alternative():
+    for c in CASES:
+        for alt in [c["expected"]] + c.get("accept", []):
+            assert run(c, oracle_items(alt))["passed"], c["id"]
+
+
+def test_every_non_empty_case_fails_on_an_empty_answer():
+    for c in CASES:
+        assert run(c, [])["passed"] == (c["expected"] == []), c["id"]
+
+
+# --- run_eval, with the Anthropic client stubbed (the real API is never called)
+
+class StubClient:
+    """Stands in for anthropic.AsyncAnthropic: records each call, answers from `answers`."""
+
+    def __init__(self, capture, answers):
+        self.capture, self.answers, self.calls = capture, answers, []
+        self.beta = SimpleNamespace(messages=SimpleNamespace(parse=self.parse))
+
+    async def parse(self, **kw):
+        self.calls.append(kw)
+        content = kw["messages"][0]["content"]
+        transcript = content.split("<transcript>\n")[1].split("\n</transcript>")[0]
+        items = self.answers[transcript]
+        if isinstance(items, Exception):
+            raise items
+        parsed = self.capture.CaptureItems(items=[self.capture.CaptureItem(**i) for i in items])
+        return SimpleNamespace(stop_reason="end_turn", parsed_output=parsed)
+
+
+def test_capture_module_loads_without_importing_the_app_package():
+    capture = run_eval.load_capture_module()
+    assert capture.SYSTEM_PROMPT and "app" not in sys.modules and "app.services" not in sys.modules
+
+
+def test_parse_today_derives_the_weekday():
+    assert f"{run_eval.parse_today('2026-11-12 Thursday'):%A %Y-%m-%d}" == "Thursday 2026-11-12"
+    assert f"{run_eval.parse_today('2026-11-12 Sunday'):%A}" == "Thursday"
+
+
+def test_run_eval_end_to_end_with_stub(tmp_path, capsys, monkeypatch):
+    monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+    capture = run_eval.load_capture_module()
+    answers = {c["transcript"]: oracle_items(c["expected"]) for c in CASES}
+    wrong_id, error_id = CASES[0]["id"], CASES[1]["id"]
+    answers[CASES[0]["transcript"]] = [got("note", "something else entirely")]  # deliberately wrong
+    answers[CASES[1]["transcript"]] = RuntimeError("stub outage")
+    stub = StubClient(capture, answers)
+    out = tmp_path / "preds.jsonl"
+
+    assert run_eval.main(["--out", str(out), "--model", "stub-model"], client=stub) == 0
+
+    assert len(stub.calls) == len(CASES)
+    by_transcript = {c["transcript"]: c for c in CASES}
+    for call in stub.calls:  # the real _classify built these requests
+        content = call["messages"][0]["content"]
+        c = by_transcript[content.split("<transcript>\n")[1].split("\n</transcript>")[0]]
+        iso, weekday = c["today"].split()
+        assert content.startswith(f"Today is {weekday} {iso}. Default currency: MYR.\nTopics:\n- move: ")
+        assert "\n- motorcycle: " in content and "\n- pj-shipping: " in content
+        assert call["system"] == capture.SYSTEM_PROMPT and call["model"] == "stub-model"
+        assert call["output_format"] is capture.CaptureItems
+    preds = [json.loads(line) for line in out.read_text().splitlines()]
+    assert [p["id"] for p in preds] == [c["id"] for c in CASES]
+    report = capsys.readouterr().out
+    assert f"cases passed      {len(CASES) - 2}/{len(CASES)}" in report
+    assert f"FAIL  {wrong_id}" in report and f"FAIL  {error_id}" in report
+    assert "RuntimeError: stub outage" in report
+
+
+def test_run_eval_limit_scores_only_the_cases_it_ran(tmp_path, capsys):
+    capture = run_eval.load_capture_module()
+    stub = StubClient(capture, {c["transcript"]: oracle_items(c["expected"]) for c in CASES})
+    assert run_eval.main(["--limit", "3", "--out", str(tmp_path / "p.jsonl")], client=stub) == 0
+    assert len(stub.calls) == 3 and "cases passed      3/3 (100.0%)" in capsys.readouterr().out
+
+
+def test_run_eval_exits_clearly_without_api_key(tmp_path, capsys, monkeypatch):
+    monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+    out = tmp_path / "p.jsonl"
+    assert run_eval.main(["--out", str(out)]) == 2
+    assert "ANTHROPIC_API_KEY is not set" in capsys.readouterr().err and not out.exists()
