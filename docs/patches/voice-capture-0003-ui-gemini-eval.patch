@@ -0,0 +1,426 @@
+"""Tests for the capture read side: auth gate, /capture/items, /capture/tasks/done, /capture/ui.
+
+Runs without the Whisper stack: the app here is a bare FastAPI built from
+`build_capture_router` with a real CaptureStore on tmp_path. The token check
+tested here is the same function `POST /capture` depends on.
+"""
+
+import os
+import re
+import stat
+from datetime import datetime
+from types import SimpleNamespace
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI
+from fastapi.testclient import TestClient
+
+from app.api.capture_view import bearer_token_dependency, build_capture_router
+from app.services.capture import CaptureItem, CaptureStore, TaskStaleError
+
+TOKEN = "s3cret"
+AUTH = {"Authorization": f"Bearer {TOKEN}"}
+DATA_ROUTES = [
+    ("GET", "/capture/items"),
+    ("POST", "/capture/tasks/done"),
+    ("POST", "/gated"),  # stands in for POST /capture: same dependency, no Whisper
+]
+BAD_HEADERS = [
+    {},
+    {"Authorization": "Bearer wrong"},
+    {"Authorization": TOKEN},
+    {"Authorization": f"bearer {TOKEN}"},
+    {"Authorization": f"Bearer {TOKEN} "},
+    {"Authorization": "Bearer "},
+    {"Authorization": f"Basic {TOKEN}"},
+]
+
+
+@pytest.fixture
+def store(tmp_path):
+    return CaptureStore(tmp_path / "capture")
+
+
+@pytest.fixture
+def token():
+    return {"value": TOKEN}
+
+
+@pytest.fixture
+def client(store, token):
+    app = FastAPI()
+    app.state.capture = SimpleNamespace(store=store)
+    get_token = lambda: token["value"]  # noqa: E731
+    # Wired the way app/api/capture.py does it: a gated route on a router, the
+    # view router nested into that router, and the outer one included in the app.
+    router = APIRouter()
+
+    @router.post("/gated", dependencies=[Depends(bearer_token_dependency(get_token))])
+    def gated():
+        return {"ok": True}
+
+    router.include_router(build_capture_router(lambda request: request.app.state.capture, get_token))
+    app.include_router(router)
+    return TestClient(app)
+
+
+def _write(store, name, text):
+    store.directory.mkdir(parents=True, exist_ok=True)
+    (store.directory / name).write_bytes(text.encode("utf-8"))
+
+
+def _tasks(store):
+    return (store.directory / "tasks.md").read_bytes()
+
+
+def _seed(store):
+    store.save_items(
+        [
+            CaptureItem(kind="task", text="Collect the bike", due="2026-11-14", topic="motorcycle"),
+            CaptureItem(kind="note", text="Lorry quote was 1,200", topic="move"),
+            CaptureItem(kind="expense", text="Deposit, for the bike", amount=500, currency="MYR", topic="motorcycle"),
+        ],
+        datetime(2026, 11, 12, 14, 3),
+    )
+    store.save_items(
+        [
+            CaptureItem(kind="task", text="Buy boxes"),
+            CaptureItem(kind="expense", text="Petrol", amount=20.5, currency="MYR"),
+            CaptureItem(kind="expense", text="Shipping label", amount=12, currency="USD", topic="pj-shipping"),
+        ],
+        datetime(2026, 11, 13, 9, 30),
+    )
+    store.save_unsorted("call the\nlandlord", datetime(2026, 11, 13, 10, 0), "Claude rate limit")
+
+
+# ---------- Auth gate ----------
+
+
+@pytest.mark.parametrize("method, path", DATA_ROUTES)
+def test_token_unset_refuses_everything(client, token, method, path):
+    for unset in (None, ""):
+        token["value"] = unset
+        for headers in (AUTH, {"Authorization": "Bearer "}, {"Authorization": "Bearer None"}, {}):
+            r = client.request(method, path, headers=headers, json={"id": "0" * 16})
+            assert r.status_code == 503, (unset, headers)
+
+
+@pytest.mark.parametrize("method, path", DATA_ROUTES)
+@pytest.mark.parametrize("headers", BAD_HEADERS)
+def test_bad_or_missing_token_is_401(client, store, method, path, headers):
+    _seed(store)
+    before = _tasks(store)
