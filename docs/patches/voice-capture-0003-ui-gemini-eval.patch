+def test_file_changed_during_the_write_is_409_and_the_other_write_wins(store, monkeypatch):
+    """Someone saves tasks.md after we read it: we must not replace their version."""
+    _seed(store)
+    task_id = store.list_items()["tasks"]["open"][0]["id"]
+    path = store.directory / "tasks.md"
+    theirs = _tasks(store) + b"- [ ] Added in an editor\n"
+    real_copymode = __import__("shutil").copymode
+
+    def racing_copymode(src, dst):
+        path.write_bytes(theirs)  # lands between our read and our replace
+        return real_copymode(src, dst)
+
+    monkeypatch.setattr("app.services.capture.shutil.copymode", racing_copymode)
+    with pytest.raises(TaskStaleError):
+        store.mark_task(task_id, True)
+    assert _tasks(store) == theirs
+    assert os.listdir(store.directory).count("tasks.md") == 1
+    assert not [n for n in os.listdir(store.directory) if n.startswith("tasks.md.")]
