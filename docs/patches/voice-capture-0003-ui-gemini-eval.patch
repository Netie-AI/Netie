+def test_already_in_that_state_is_409_and_file_unchanged(client, store):
+    _seed(store)
+    task_id = _ids(client)["Buy boxes"]
+    before = _tasks(store)
+    r = client.post("/capture/tasks/done", headers=AUTH, json={"id": task_id, "done": False})
+    assert r.status_code == 409
+    assert "already open" in r.json()["detail"]
+    assert _tasks(store) == before
+
+    assert client.post("/capture/tasks/done", headers=AUTH, json={"id": task_id}).status_code == 200
+    ticked = _tasks(store)
+    r = client.post("/capture/tasks/done", headers=AUTH, json={"id": task_id})  # double tap
+    assert r.status_code == 409
+    assert _tasks(store) == ticked
