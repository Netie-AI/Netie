+    return [label, due, meta([t.topic && "#" + t.topic])];
+  }
+  function money(x) {
+    return (x.currency ? x.currency + " " : "") + (x.amount == null ? "(no amount)" : x.amount.toFixed(2));
+  }
+
+  function render(d) {
