+def test_done_defaults_to_true(client, store):
+    _seed(store)
+    r = client.post("/capture/tasks/done", headers=AUTH, json={"id": _ids(client)["Buy boxes"]})
+    assert r.status_code == 200
+    assert _tasks(store).endswith(b"- [x] Buy boxes\n")
