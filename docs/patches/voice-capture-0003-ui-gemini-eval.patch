+    for n, raw in enumerate(lines):
+        line = _decode(raw)
+        m = _TASK.match(line)
+        if not m:
+            skipped += bool(line)
+            continue
+        body = m.group(2)
+        rank = seen[body]
+        seen[body] += 1
+        text, topic = _split_tail(body, _TOPIC)
+        text, due = _split_tail(text, _DUE)
+        tasks.append({
+            "id": hashlib.sha256(f"{rank}\0{body}".encode()).hexdigest()[:16],
+            "text": text,
+            "due": due,
+            "topic": topic,
+            "done": m.group(1) != " ",
+            "line": n,
+        })
+    return tasks, skipped
