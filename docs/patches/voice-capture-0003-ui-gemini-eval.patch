diff --git a/evals/run_eval.py b/evals/run_eval.py
new file mode 100644
index 0000000..450bc51
--- /dev/null
+++ b/evals/run_eval.py
@@ -0,0 +1,115 @@
+"""Run the capture eval against the real classifier, then score it.
+
+    ANTHROPIC_API_KEY=... python evals/run_eval.py [--model M] [--limit N] [--out FILE]
+
+Calls CaptureService._classify from app/services/capture.py once per case, with
+the case's `today` as `now`, the topics move, motorcycle, pj-shipping and
+default currency MYR. That module is loaded by file path, so the `app` package
+(and the Whisper stack behind it) is never imported. Needs `anthropic` and
+`pydantic` installed, because capture.py imports them.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import importlib.util
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import score  # noqa: E402
+
+CAPTURE_PY = HERE.parent / "app" / "services" / "capture.py"
+CASES = HERE / "capture_cases.jsonl"
+TOPICS = [
+    "move: moving house to the new place (movers, boxes, lorry, landlord, utilities)",
+    "motorcycle: shopping for and buying a motorcycle (dealers, test rides, deposit, insurance)",
+    "pj-shipping: the shipping job to and from Petaling Jaya (cargo, forwarder, customs, delivery)",
+]
+DEFAULT_CURRENCY = "MYR"
+
+
+def load_capture_module():
+    if "capture_under_eval" in sys.modules:
+        return sys.modules["capture_under_eval"]
+    spec = importlib.util.spec_from_file_location("capture_under_eval", CAPTURE_PY)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module  # pydantic resolves annotations through sys.modules
+    spec.loader.exec_module(module)
+    return module
+
+
+def parse_today(today: str) -> datetime:
+    """'2026-11-12 Thursday' -> noon that day. The weekday is derived, not trusted."""
+    return datetime.strptime(today.split()[0], "%Y-%m-%d").replace(hour=12)
+
+
+async def predict(cases: list[dict], *, model: str | None = None, client=None, api_key: str | None = None,
+                  concurrency: int = 4, log=print, backend: str = "claude", delay: float = 0.0) -> list[dict]:
+    capture = load_capture_module()
+    # store=None: _classify never touches the store, and the eval must not write capture files.
+    service = capture.CaptureService(api_key=api_key, store=None, backend=backend, model=model, topics=TOPICS,
+                                     default_currency=DEFAULT_CURRENCY, client=client)
+    gate = asyncio.Semaphore(concurrency)
+
+    async def one(case: dict) -> dict:
+        async with gate:
+            if delay:
+                await asyncio.sleep(delay)  # free tiers cap requests per minute
+            try:
+                items = await service._classify(case["transcript"], parse_today(case["today"]))
+                pred = {"id": case["id"], "items": [i.model_dump() for i in items]}
+            except Exception as e:  # keep going; the scorer fails this case and shows why
+                pred = {"id": case["id"], "items": [], "error": f"{type(e).__name__}: {e}"}
+            log(f"  {case['id']}: {pred.get('error') or str(len(pred['items'])) + ' item(s)'}")
+            return pred
+
+    return list(await asyncio.gather(*(one(c) for c in cases)))
+
+
+def main(argv: list[str] | None = None, client=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--model", default=None, help="model id (default: the service default)")
+    ap.add_argument("--limit", type=int, default=None, help="only the first N cases")
+    ap.add_argument("--out", default=str(HERE / "predictions.jsonl"), help="where to write predictions")
+    ap.add_argument("--cases", default=str(CASES))
+    ap.add_argument("--concurrency", type=int, default=4)
+    ap.add_argument("--delay", type=float, default=0.0,
+                    help="seconds to wait before each call; Gemini free tier allows 15 a minute, so use --concurrency 1 --delay 4.5")
+    ap.add_argument("--backend", choices=("claude", "gemini"), default="claude",
+                    help="claude needs ANTHROPIC_API_KEY, gemini needs GEMINI_API_KEY")
+    args = ap.parse_args(argv)
+
+    key_name = "ANTHROPIC_API_KEY" if args.backend == "claude" else "GEMINI_API_KEY"
+    api_key = os.environ.get(key_name)
+    if client is None and not api_key:
+        print(f"{key_name} is not set. This eval calls the real {args.backend} API; "
+              "export the key and run again.", file=sys.stderr)
+        return 2
+
+    cases = score.load_jsonl(args.cases)
+    problems = score.validate_cases(cases)
+    if problems:
+        print("cases file is malformed:\n  " + "\n  ".join(problems), file=sys.stderr)
+        return 2
+    if args.limit is not None:
+        cases = cases[: args.limit]
+
+    print(f"classifying {len(cases)} case(s)...")
+    preds = asyncio.run(predict(cases, model=args.model, client=client, api_key=api_key,
+                                concurrency=args.concurrency, backend=args.backend, delay=args.delay))
+    with open(args.out, "w", encoding="utf-8") as f:
+        for p in preds:
+            f.write(json.dumps(p, ensure_ascii=False) + "\n")
+    print(f"wrote {args.out}\n")
+    print(score.format_report(score.score(cases, preds), cases))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/evals/score.py b/evals/score.py
new file mode 100644
index 0000000..8faeb6a
--- /dev/null
+++ b/evals/score.py
@@ -0,0 +1,253 @@
+"""Score capture predictions against evals/capture_cases.jsonl. Stdlib only.
+
+    python evals/score.py evals/capture_cases.jsonl predictions.jsonl
+
+A prediction line is {"id": ..., "items": [{kind, text, amount, currency, due, topic}]}.
+A line with an "error" key (the call failed) always fails its case.
+
+Per case:
+  1. the number of items must equal the expected number;
+  2. each expected item is matched greedily, in order, to the unused predicted
+     item that agrees best on kind, then on must_contain keywords;
+  3. for each pair: kind, must_contain, amount + currency, due and topic must agree.
+An ambiguous case also carries "accept", a list of alternative expected lists;
+it passes if any alternative passes. Field accuracies are counted against the
+alternative the prediction came closest to.
+
+Lenient on purpose: "" equals null, currency case is ignored, 450 equals 450.0,
+and a must_contain entry may list alternatives as "lori|lorry".
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from datetime import date
+
+KINDS = ("task", "note", "expense")
+FIELDS = ("kind", "text", "money", "due", "topic")
+
+
+def load_jsonl(path: str) -> list[dict]:
+    with open(path, encoding="utf-8") as f:
+        return [json.loads(line) for line in f if line.strip()]
+
+
+def _blank(v):
+    """None for null and for empty or whitespace strings."""
+    if v is None or (isinstance(v, str) and not v.strip()):
+        return None
+    return v.strip() if isinstance(v, str) else v
+
+
+def _amount(v):
+    v = _blank(v)
+    if v is None:
+        return None
+    try:
+        return float(v)
+    except (TypeError, ValueError):
+        return v  # not a number: can never equal an expected amount
+
+
+def _keywords_ok(text, must_contain: list[str]) -> bool:
+    text = str(text or "").lower()
+    return all(any(alt.strip() in text for alt in kw.lower().split("|")) for kw in must_contain)
+
+
+def check_item(exp: dict, got: dict | None) -> dict[str, bool]:
+    """Field verdicts for one expected item against its matched prediction."""
+    if got is None:
+        return dict.fromkeys(FIELDS, False)
+    ea, ga = _amount(exp.get("amount")), _amount(got.get("amount"))
+    if isinstance(ea, float) and isinstance(ga, float):
+        amount_ok = abs(ea - ga) < 1e-9
+    else:
+        amount_ok = ea == ga
+    ec, gc = _blank(exp.get("currency")), _blank(got.get("currency"))
+    currency_ok = (str(ec).upper() if ec else None) == (str(gc).upper() if gc else None)
+    return {
+        "kind": exp["kind"] == got.get("kind"),
+        "text": _keywords_ok(got.get("text"), exp.get("must_contain", [])),
+        "money": amount_ok and currency_ok,
+        "due": _blank(exp.get("due")) == _blank(got.get("due")),
+        "topic": _blank(exp.get("topic")) == _blank(got.get("topic")),
+    }
+
+
+def match_items(expected: list[dict], got: list[dict]) -> list[tuple[dict, dict | None]]:
+    """Greedy: each expected item, in order, takes the best unused prediction."""
+    unused = list(range(len(got)))
+    pairs = []
+    for exp in expected:
+        if not unused:
+            pairs.append((exp, None))
+            continue
+
+        def rank(i):
+            v = check_item(exp, got[i])
+            # kind first, then keywords, then the other fields as a tie-break
+            return (v["kind"], v["text"], v["money"] + v["due"] + v["topic"], -i)
+
+        best = max(unused, key=rank)
+        unused.remove(best)
+        pairs.append((exp, got[best]))
+    return pairs
+
+
+def score_alternative(expected: list[dict], got: list[dict]) -> dict:
+    verdicts = [check_item(e, g) for e, g in match_items(expected, got)]
+    count_ok = len(expected) == len(got)
+    return {
+        "count_ok": count_ok,
+        "verdicts": verdicts,
+        "passed": count_ok and all(all(v.values()) for v in verdicts),
+        "right": sum(sum(v.values()) for v in verdicts) + count_ok,
+        "expected": expected,
+    }
+
+
+def score_case(case: dict, pred: dict | None) -> dict:
+    alternatives = [case["expected"]] + list(case.get("accept", []))
+    if pred is None or "error" in pred:
+        why = "no prediction" if pred is None else f"error: {pred['error']}"
+        expected = alternatives[0]
+        res = {"count_ok": False, "verdicts": [dict.fromkeys(FIELDS, False) for _ in expected],
+               "passed": False, "right": 0, "expected": expected}
+        got = []
+    else:
+        got = pred.get("items") or []
+        results = [score_alternative(alt, got) for alt in alternatives]
+        res = next((r for r in results if r["passed"]), None) or max(results, key=lambda r: r["right"])
+        why = ""
+        if not res["passed"]:
+            wrong = [] if res["count_ok"] else [f"count {len(got)} != {len(res['expected'])}"]
+            wrong += sorted({f for v in res["verdicts"] for f, ok in v.items() if not ok})
+            why = ", ".join(wrong)
+    return {"id": case["id"], "ambiguous": bool(case.get("ambiguous")), "why": why, "got": got, **res}
+
+
+def score(cases: list[dict], predictions: list[dict]) -> dict:
+    by_id = {p["id"]: p for p in predictions}
+    results = [score_case(c, by_id.get(c["id"])) for c in cases]
+    fields = {f: [0, 0] for f in FIELDS}  # right, total (per expected item)
+    for r in results:
+        for v in r["verdicts"]:
+            for f, ok in v.items():
+                fields[f][0] += ok
+                fields[f][1] += 1
+    return {
+        "results": results,
+        "passed": sum(r["passed"] for r in results),
+        "total": len(results),
+        "count": [sum(r["count_ok"] for r in results), len(results)],
+        "fields": fields,
+        "unknown_ids": sorted(set(by_id) - {c["id"] for c in cases}),
+    }
+
+
+def _pct(right: int, total: int) -> str:
+    return f"{right}/{total}" + (f" ({100 * right / total:.1f}%)" if total else "")
+
+
+def format_report(report: dict, cases: list[dict]) -> str:
+    by_id = {c["id"]: c for c in cases}
+    out = []
+    for r in report["results"]:
+        tag = " [ambiguous]" if r["ambiguous"] else ""
+        out.append(f"{'PASS' if r['passed'] else 'FAIL'}  {r['id']}{tag}" + (f"  <- {r['why']}" if r["why"] else ""))
+    f = report["fields"]
+    out += [
+        "",
+        f"cases passed      {_pct(report['passed'], report['total'])}",
+        f"item count        {_pct(*report['count'])}  (per case)",
+        f"kind              {_pct(*f['kind'])}  (per expected item, from here down)",
+        f"amount+currency   {_pct(*f['money'])}",
+        f"due               {_pct(*f['due'])}",
+        f"topic             {_pct(*f['topic'])}",
+        f"must_contain      {_pct(*f['text'])}",
+    ]
+    if report["unknown_ids"]:
+        out.append(f"predictions with no matching case: {', '.join(report['unknown_ids'])}")
+    failures = [r for r in report["results"] if not r["passed"]]
+    if failures:
+        out += ["", f"FAILURES ({len(failures)})"]
+    for r in failures:
+        c = by_id[r["id"]]
+        out += [
+            "",
+            f"- {r['id']}: {r['why']}",
+            f"  today:      {c['today']}",
+            f"  transcript: {c['transcript']}",
+            f"  expected:   {json.dumps(r['expected'], ensure_ascii=True)}",
+            f"  got:        {json.dumps(r['got'], ensure_ascii=True)}",
+        ]
+        if r["ambiguous"]:
+            out.append(f"  (closest of {1 + len(c['accept'])} accepted alternatives shown)")
+    return "\n".join(out)
+
+
+def validate_cases(cases: list[dict], topics: tuple[str, ...] = ("move", "motorcycle", "pj-shipping")) -> list[str]:
+    """Problems in the cases file itself. Empty list means it is well formed."""
+    problems, seen = [], set()
+    for c in cases:
+        cid = c.get("id", "?")
+        if cid in seen:
+            problems.append(f"{cid}: duplicate id")
+        seen.add(cid)
+        try:
+            iso, weekday = c["today"].split()
+            if f"{date.fromisoformat(iso):%A}" != weekday:
+                problems.append(f"{cid}: {iso} is not a {weekday}")
+        except (KeyError, ValueError):
+            problems.append(f"{cid}: bad 'today'")
+        if not c.get("why"):
+            problems.append(f"{cid}: missing why")
+        if bool(c.get("ambiguous")) != bool(c.get("accept")):
+            problems.append(f"{cid}: 'ambiguous' and 'accept' must come together")
+        for alt in [c.get("expected", [])] + list(c.get("accept", [])):
+            for item in alt:
+                if set(item) != {"kind", "must_contain", "amount", "currency", "due", "topic"}:
+                    problems.append(f"{cid}: item keys {sorted(item)}")
+                    continue
+                if item["kind"] not in KINDS:
+                    problems.append(f"{cid}: kind {item['kind']}")
+                kws = item["must_contain"]
+                if not 1 <= len(kws) <= 3 or any(k != k.lower() for k in kws):
+                    problems.append(f"{cid}: must_contain needs 1-3 lowercase keywords")
+                if any(not any(a.strip() in c["transcript"].lower() for a in k.split("|")) for k in kws):
+                    problems.append(f"{cid}: keyword {kws} has no alternative present in the transcript")
+                if item["topic"] not in (None, *topics):
+                    problems.append(f"{cid}: topic {item['topic']}")
+                if item["due"] is not None:
+                    try:
+                        date.fromisoformat(item["due"])
+                    except ValueError:
+                        problems.append(f"{cid}: due {item['due']}")
+                if (item["kind"] == "expense") != (item["amount"] is not None and item["currency"] is not None):
+                    problems.append(f"{cid}: only expenses carry amount and currency")
+    return problems
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("cases")
+    ap.add_argument("predictions")
+    ap.add_argument("--only-predicted", action="store_true",
+                    help="skip cases with no prediction line instead of failing them")
+    args = ap.parse_args(argv)
+    cases, preds = load_jsonl(args.cases), load_jsonl(args.predictions)
+    problems = validate_cases(cases)
+    if problems:
+        print("cases file is malformed:\n  " + "\n  ".join(problems), file=sys.stderr)
+        return 2
+    if args.only_predicted:
+        have = {p["id"] for p in preds}
+        cases = [c for c in cases if c["id"] in have]
+    print(format_report(score(cases, preds), cases))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
