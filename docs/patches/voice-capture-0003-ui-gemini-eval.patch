+def test_ui_is_self_contained_and_never_renders_data_as_html(client):
+    r = client.get("/capture/ui")
+    html = r.text
+    csp = r.headers["content-security-policy"]
+    assert "default-src 'none'" in csp and "connect-src 'self'" in csp
+    assert r.headers["x-content-type-options"] == "nosniff"
+    # no CDN, no external file: nothing is fetched by URL except the two data routes
+    assert not re.search(r"https?://|//cdn|\bsrc\s*=|<link\b|@import|url\(", html)
+    assert set(re.findall(r'"(/[a-z/]+)"', html)) == {"/capture/items", "/capture/tasks/done"}
+    # data reaches the DOM through textContent only (the one mention is the comment saying so)
+    code = re.sub(r"//.*", "", html)
+    for sink in ("innerHTML", "outerHTML", "insertAdjacentHTML", "document.write", "eval(", "DOMParser"):
+        assert sink not in code, sink
+    assert "textContent" in code
+    assert "Authorization" in code and "localStorage" in code
+
