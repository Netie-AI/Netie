+def test_ui_is_served_without_token_and_holds_no_data(client, store):
+    _seed(store)
+    r = client.get("/capture/ui")
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/html; charset=utf-8"
+    html = r.text
+    for secret in (TOKEN, "Collect the bike", "Lorry quote", "Deposit", "landlord"):
