+      opts.headers["Content-Type"] = "application/json";
+      opts.body = JSON.stringify(body);
+    }
+    return fetch(path, opts).then(function (r) {
+      return r.json().catch(function () { return {}; }).then(function (data) {
+        if (r.ok) return data;
+        var err = new Error(typeof data.detail === "string" ? data.detail : "Server answered " + r.status);
+        err.status = r.status;
+        throw err;
+      });
+    });
+  }
+  function failed(e) {
+    if (e.status === 401) { setToken(null); showLogin("That token was refused. Enter it again."); }
+    else if (e.status === 503) showLogin("The server has no CAPTURE_TOKEN set, so it refuses everyone.");
+    else say(e.status ? e.message : "Could not reach the server.", true);
+  }
+
+  function meta(parts) {
+    var text = parts.filter(Boolean).join(" | ");
+    return text ? el("div", text, "meta") : null;
+  }
+  function list(items, emptyText, row) {
+    if (!items.length) return el("p", emptyText, "empty");
+    var ul = el("ul");
+    items.forEach(function (item) {
