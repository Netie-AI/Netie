+    assert "prefers-color-scheme: dark" in html
+    assert '<label for="token">' in html and 'id="token"' in html
+    assert 'role="status"' in html and 'aria-live="polite"' in html
+    assert '"checkbox"' in html and 'el("label"' in html  # a real checkbox inside a real label
+    assert "<div onclick" not in html and "onclick=" not in html
+    assert html.isascii()
