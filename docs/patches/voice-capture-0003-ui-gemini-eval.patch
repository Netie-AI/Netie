+def test_mark_keeps_every_other_byte_and_the_file_mode(client, store):
+    raw = b"# Tasks\r\n\r\n  - [ ] Indented, CRLF\r\n- [ ] bad \xff byte\nprose [ ] with a box\n- [X] Old one\n- [ ] No newline at end"
+    store.directory.mkdir(parents=True)
+    (store.directory / "tasks.md").write_bytes(raw)
+    os.chmod(store.directory / "tasks.md", 0o640)
+    ids = _ids(client)
+
+    for text, old, new in [
+        ("Indented, CRLF", b"  - [ ] Indented", b"  - [x] Indented"),
+        ("No newline at end", b"- [ ] No newline", b"- [x] No newline"),
+    ]:
+        assert client.post("/capture/tasks/done", headers=AUTH, json={"id": ids[text]}).status_code == 200
+        raw = raw.replace(old, new)
+        assert _tasks(store) == raw
+    assert client.post("/capture/tasks/done", headers=AUTH, json={"id": ids["Old one"], "done": False}).status_code == 200
+    assert _tasks(store) == raw.replace(b"- [X] Old one", b"- [ ] Old one")
+    assert stat.S_IMODE(os.stat(store.directory / "tasks.md").st_mode) == 0o640
+
+
+def test_identical_tasks_get_distinct_ids(client, store):
