+def test_mark_done_then_undo_changes_only_that_checkbox(client, store):
+    _seed(store)
+    original = _tasks(store)
+    assert original == b"- [ ] Collect the bike (due 2026-11-14) #motorcycle\n- [ ] Buy boxes\n"
+    task_id = _ids(client)["Collect the bike"]
+
+    r = client.post("/capture/tasks/done", headers=AUTH, json={"id": task_id, "done": True})
+    assert r.status_code == 200
+    assert r.json() == {"id": task_id, "text": "Collect the bike", "due": "2026-11-14", "topic": "motorcycle", "done": True}
+    assert _tasks(store) == b"- [x] Collect the bike (due 2026-11-14) #motorcycle\n- [ ] Buy boxes\n"
+    tasks = client.get("/capture/items", headers=AUTH).json()["tasks"]
+    assert [t["text"] for t in tasks["open"]] == ["Buy boxes"]
+    assert [(t["text"], t["id"]) for t in tasks["done"]] == [("Collect the bike", task_id)]  # id survives the tick
+
+    r = client.post("/capture/tasks/done", headers=AUTH, json={"id": task_id, "done": False})
+    assert r.status_code == 200 and r.json()["done"] is False
+    assert _tasks(store) == original
+    assert sorted(os.listdir(store.directory)) == ["expenses.csv", "inbox.md", "notes.md", "tasks.md"]  # no temp left
+
