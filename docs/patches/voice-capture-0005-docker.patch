--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -4,12 +4,16 @@ services:
       context: .
       args:
         MODEL_NAME: ${MODEL_NAME:-breeze-asr-25}
+        # CPU-only torch (smaller image). Set TORCH_INDEX= (empty) to keep the lockfile's CUDA wheels.
+        TORCH_INDEX: ${TORCH_INDEX-https://download.pytorch.org/whl/cpu}
     image: whisper-wrap:latest
     container_name: whisper-wrap
     ports:
-      - "${API_PORT:-8000}:${API_PORT:-8000}"
+      # The server always listens on 8000 inside the container; API_PORT is the host port.
+      - "${API_PORT:-8000}:8000"
+    # Values come from the host environment or an optional .env next to this file.
+    # Empty is fine for every key: an empty CAPTURE_TOKEN makes /capture refuse (503).
     environment:
-      - API_PORT=${API_PORT:-8000}
       - API_HOST=${API_HOST:-0.0.0.0}
       - MODEL_NAME=${MODEL_NAME:-breeze-asr-25}
       # Override the default ./models/<name> resolution when mounting a pre-built model.
@@ -17,18 +21,41 @@ services:
       - COMPUTE_TYPE=${COMPUTE_TYPE:-default}
       - DEVICE=${DEVICE:-auto}
       - GEMINI_API_KEY=${GEMINI_API_KEY:-}
+      # Differs from the code default (app/services/llm.py uses gemini-3.1-flash-lite when
+      # unset). It only affects /ask; /capture sorts with CAPTURE_MODEL or its own default.
       - GEMINI_MODEL=${GEMINI_MODEL:-gemini-2.5-flash}
       # - GEMINI_SYSTEM_PROMPT=
       - MAX_FILE_SIZE_MB=${MAX_FILE_SIZE_MB:-200}
       - TEMP_DIR=/tmp/whisper-wrap
       - LOG_LEVEL=${LOG_LEVEL:-INFO}
       - UPLOAD_TIMEOUT_SECONDS=${UPLOAD_TIMEOUT_SECONDS:-60}
+      # Voice capture (docs/CAPTURE-DOCKER.md)
+      - CAPTURE_TOKEN=${CAPTURE_TOKEN:-}
+      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
+      - CAPTURE_BACKEND=${CAPTURE_BACKEND:-auto}
+      - CAPTURE_MODEL=${CAPTURE_MODEL:-}
+      - CAPTURE_TOPICS=${CAPTURE_TOPICS:-}
+      - CAPTURE_DEFAULT_CURRENCY=${CAPTURE_DEFAULT_CURRENCY:-MYR}
+      - CAPTURE_TZ=${CAPTURE_TZ:-}
+      - ASK_BACKEND=${ASK_BACKEND:-gemini}
+      - CLAUDE_MODEL=${CLAUDE_MODEL:-}
+      # Captures (capture/tasks.md, notes.md, expenses.csv) and history.db live here.
+      - DATA_DIR=/data
     volumes:
       - whisper-models:/app/models
-    # The container hosts a single FastAPI process — let the supervisor recover
+      - whisper-data:/data
+    healthcheck:
+      test: ["CMD", "curl", "-fsS", "http://localhost:8000/status"]
+      interval: 30s
+      timeout: 10s
+      start_period: 120s
+      retries: 3
+    # The container hosts a single FastAPI process; let the supervisor recover
     # from process crashes instead of relying on in-app auto-restart.
     restart: unless-stopped
 
 volumes:
   whisper-models:
     driver: local
+  whisper-data:
+    driver: local
diff --git a/docs/CAPTURE-DOCKER.md b/docs/CAPTURE-DOCKER.md
