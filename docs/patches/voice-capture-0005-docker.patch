index 147c677..7680d0b 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,9 +1,14 @@
 FROM python:3.12-slim
 
 ARG MODEL_NAME=breeze-asr-25
+# CPU-only torch. The lockfile resolves torch to the CUDA build, which drags in about
+# 4 GB of nvidia-* wheels the container cannot use (no GPU passthrough is set up).
+# torch is only needed by silero-vad. Set TORCH_INDEX= (empty) to keep the lockfile's wheels.
+ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
 
 # Runtime-only dependencies. v2 drops cmake/g++/make/pkg-config/git because we no
-# longer build whisper.cpp from source — the CT2 model is downloaded via `hf`.
+# longer build whisper.cpp from source; the CT2 model is downloaded via `hf`.
+# ffmpeg decodes the phone's m4a/webm, libmagic sniffs the upload type.
 RUN apt-get update && apt-get install -y --no-install-recommends \
     ffmpeg \
     libmagic1 \
@@ -15,16 +20,36 @@ COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
 
 WORKDIR /app
 
+# model-manager.sh needs `hf` from the venv on PATH.
+ENV PATH="/app/.venv/bin:$PATH"
+
 COPY pyproject.toml uv.lock README.md ./
 
-# Install Python deps (faster-whisper, google-genai, etc.). --no-dev keeps the
-# image small; tests are not shipped.
-RUN uv sync --frozen --no-dev
+# Install the locked dependencies without the project itself (it runs from /app).
+# uv export pins every transitive package, so --no-deps installs exactly the lock.
+# --no-dev keeps tests out. When TORCH_INDEX is set, torch/torchaudio and the nvidia-*
+# and triton wheels that only exist for them are swapped for the CPU build.
+RUN uv venv /app/.venv && \
+    uv export --frozen --no-dev --no-hashes --no-emit-project -o /tmp/req.txt && \
+    if [ -n "$TORCH_INDEX" ]; then \
+        grep -Ev '^(nvidia-|triton|torch==|torchaudio==)' /tmp/req.txt > /tmp/req-main.txt && \
+        grep -E '^(torch|torchaudio)==' /tmp/req.txt | sed 's/ *;.*//' > /tmp/req-torch.txt && \
+        uv pip install --python /app/.venv/bin/python --no-deps -r /tmp/req-main.txt && \
+        uv pip install --python /app/.venv/bin/python --no-deps --index-url "$TORCH_INDEX" -r /tmp/req-torch.txt; \
+    else \
+        uv pip install --python /app/.venv/bin/python --no-deps -r /tmp/req.txt; \
+    fi && rm -f /tmp/req*.txt
 
-# Registry + model manager — needed to download the model at build time.
+# Registry and model manager, plus the three app files model-manager.sh imports to read
+# the registry. The model comes next, before the rest of app/, so editing app code does
+# not re-run the 1.5 GB download layer.
 COPY registry/ /app/registry/
 COPY scripts/ /app/scripts/
-COPY app/ /app/app/
+# A Windows checkout with autocrlf turns these shell scripts into CRLF, which sh cannot run.
+RUN sed -i 's/\r$//' /app/scripts/*.sh
+COPY app/__init__.py /app/app/__init__.py
+COPY app/services/__init__.py /app/app/services/__init__.py
+COPY app/services/registry.py /app/app/services/registry.py
 
 # Pre-download the configured model variant via the v2 manager (uses `hf download`
 # under the hood, honouring the registry's `subfolder` and `revision` fields).
@@ -32,16 +57,27 @@ RUN mkdir -p /app/models && \
     WHISPER_WRAP_PYTHONPATH=/app PYTHON_BIN=/app/.venv/bin/python \
     bash /app/scripts/model-manager.sh download "$MODEL_NAME"
 
+# alembic.ini and alembic/ are needed: the lifespan runs `alembic upgrade head` from
+# the working directory before the model loads.
+COPY alembic.ini /app/alembic.ini
+COPY alembic/ /app/alembic/
+COPY app/ /app/app/
+COPY deploy/docker-entrypoint.sh /app/deploy/docker-entrypoint.sh
+RUN sed -i 's/\r$//' /app/deploy/docker-entrypoint.sh
+
 # Persist the chosen model name into the runtime env file consulted by Config.
 RUN printf "MODEL_NAME=%s\n" "$MODEL_NAME" > /app/.env
 
-RUN mkdir -p /tmp/whisper-wrap
+RUN mkdir -p /tmp/whisper-wrap /data
+
+ENV DATA_DIR=/data
 
 EXPOSE 8000
 
-# Single in-process FastAPI server — lifespan eagerly loads the WhisperModel.
-# No whisper-server subprocess, no startup sleep.
+# Single in-process FastAPI server; lifespan eagerly loads the WhisperModel.
 HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
     CMD curl -f http://localhost:8000/status || exit 1
 
-CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
+# The entrypoint calls the venv directly. `uv run` would re-sync (and pull the dev
+# group) at every start.
+ENTRYPOINT ["sh", "/app/deploy/docker-entrypoint.sh"]
diff --git a/deploy/docker-entrypoint.sh b/deploy/docker-entrypoint.sh
new file mode 100755
index 0000000..0239340
--- /dev/null
+++ b/deploy/docker-entrypoint.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Seed the speech model on first start, then run the server.
+#
+# The image already holds MODEL_NAME as built. Two cases need the download here:
+# MODEL_NAME at run time differs from the build, or the models volume was created
+# by an older image and lacks the model. model-manager.sh is a no-op when the model
+# is installed ("already installed, skipping"), so this costs nothing on later starts.
+set -eu
+cd /app
+MODEL_NAME="${MODEL_NAME:-breeze-asr-25}"
+WHISPER_WRAP_PYTHONPATH=/app PYTHON_BIN=/app/.venv/bin/python \
+    bash /app/scripts/model-manager.sh download "$MODEL_NAME"
+exec /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
