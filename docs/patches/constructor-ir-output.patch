+test("compileIR output is the Kahn sink app, not array last app", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "sink", kind: "app", note: "out" },
+      { id: "src", kind: "connector", note: "in" },
+      { id: "mid", kind: "app", note: "mid" },
+    ],
+    edges: [
+      { from: "src", to: "mid" },
+      { from: "mid", to: "sink" },
+    ],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.entry_node_id, "src");
+  assert.equal(ir.output_node_id, "sink");
+  assert.equal(ir.nodes.find((n) => n.id === "sink").kind, "EMIT");
+  assert.equal(ir.nodes.find((n) => n.id === "mid").kind, "DETERMINISTIC_RULE");
+});
+
+test("compileIR output is the Kahn sink, not array last, when no app", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "sink", kind: "ontology", note: "types" },
+      { id: "src", kind: "connector", note: "in" },
+    ],
+    edges: [{ from: "src", to: "sink" }],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.entry_node_id, "src");
+  assert.equal(ir.output_node_id, "sink");
+  assert.equal(ir.nodes.find((n) => n.id === "sink").kind, "DOCUMENT_REF");
+});
+
