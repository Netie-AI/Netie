+def _run_execution_shape(
+    vault: KeyVault,
+    fallback: FallbackManager,
+    body: dict[str, Any],
+    *,
+    timeout_s: float,
+    trace: HopTrace,
+    tenant: str,
+) -> tuple[int, dict[str, Any]]:
+    """Sequential hop-walk for fusion/pipeline/context-relay. Not parallel.
+
+    No quorum-grace, no breaker park on this path. Streaming is refused.
+    """
+    if body.get("stream"):
+        trace.error_type = "openvault_execution_shape"
+        return 400, {
+            "error": {
+                "message": "streaming execution shapes are not wired",
+                "type": "openvault_execution_shape",
+            }
+        }
+    shape = shape_from_chat_body(body) or ""
+    if shape == "auto":
+        trace.error_type = "openvault_execution_shape"
+        return 400, {
+            "error": {
+                "message": "auto must resolve to a sort first",
+                "type": "openvault_execution_shape",
+            }
+        }
+    if vault.seal.is_sealed:
+        trace.error_type = "openvault_vault_sealed"
+        return _sealed_refusal()
+    candidates = fallback.ordered_candidates(affinity_key=affinity_key_for(body, tenant=tenant))
+    if not candidates:
+        return 503, _no_candidates_refusal(vault)
+
+    hops = [Hop(c.id, "", c.provider, True) for c in candidates]
+    by_id = {c.id: c for c in candidates}
+
+    def serves(hop: Hop, model: str) -> bool:
+        rec = by_id.get(hop.execution_key)
+        if rec is None:
+            return False
+        return resolve_model(rec.provider, model) is not None
+
+    def post(
+        hop: Hop,
+        *,
+        model: str,
+        user_text: str,
+        stream: bool,
+        tools: Any,
+        tool_choice: Any,
+        system: str | None = None,
+        **_k: Any,
+    ) -> str:
+        rec = by_id.get(hop.execution_key)
+        if rec is None:
+            return ""
+        resolved = resolve_model(rec.provider, model)
+        if resolved is None:
+            return ""
+        secret = vault.get_secret(rec.id)
+        if secret is None:
+            return ""
+        base = _default_base_url(rec.provider, rec.base_url)
+        if not base or rec.provider == "anthropic":
+            return ""
+        messages: list[dict[str, Any]] = []
+        if system:
+            messages.append({"role": "system", "content": system})
+        messages.append({"role": "user", "content": user_text})
+        hop_body: dict[str, Any] = {
+            "model": resolved,
+            "messages": messages,
+            "stream": False,
+        }
+        if tools:
+            hop_body["tools"] = tools
+            if tool_choice is not None:
+                hop_body["tool_choice"] = tool_choice
+        try:
+            with httpx.Client(timeout=timeout_s) as client:
+                resp = client.post(
+                    f"{base}/chat/completions",
+                    headers={
+                        "Authorization": f"Bearer {secret}",
+                        "Content-Type": "application/json",
+                    },
+                    json=hop_body,
+                )
+            if resp.status_code >= 400:
+                return ""
+            return extract_assistant_text(resp.json())
+        except Exception:
