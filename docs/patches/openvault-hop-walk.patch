+            }
+        }
+    trace.note_served(provider="dispatch", model=shape, vault_key_id="")
+    return 200, {
+        "id": "ov-dispatch",
+        "object": "chat.completion",
+        "choices": [
+            {
+                "message": {"role": "assistant", "content": text},
+                "finish_reason": "stop",
+            }
+        ],
+    }
+
