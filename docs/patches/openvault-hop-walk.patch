+
+    combo = body.get("combo") if isinstance(body.get("combo"), dict) else {}
+    models = combo_models_from_body(body)
+    try:
+        text = dispatch_combo(
+            shape,
+            models,
+            hop_call_model(hops, post, serves=serves),
+            user_text=user_text_from_body(body),
