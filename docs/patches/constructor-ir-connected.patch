+function componentCount(nodes, edges) {
+  // Weakly connected parts. Two workflows are not one Cortex IR.
+  if (!nodes.length) return 0;
+  const adj = Object.create(null);
+  for (let i = 0; i < nodes.length; i++) adj[nodes[i].id] = [];
+  for (let i = 0; i < edges.length; i++) {
+    const from = edges[i].from;
+    const to = edges[i].to;
+    if (!adj[from] || !adj[to]) continue;
+    adj[from].push(to);
+    adj[to].push(from);
+  }
+  const seen = Object.create(null);
+  let parts = 0;
+  for (let i = 0; i < nodes.length; i++) {
+    const start = nodes[i].id;
+    if (seen[start]) continue;
+    parts += 1;
+    const q = [start];
+    seen[start] = true;
+    while (q.length) {
+      const id = q.shift();
+      const nbrs = adj[id] || [];
+      for (let j = 0; j < nbrs.length; j++) {
+        if (seen[nbrs[j]]) continue;
+        seen[nbrs[j]] = true;
+        q.push(nbrs[j]);
+      }
+    }
+  }
+  return parts;
+}
