+test("compileIR refuses a disconnected graph", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "a", kind: "connector" },
+      { id: "b", kind: "connector" },
+    ],
+    edges: [],
+  });
+  assert.equal(ir.error, "disconnected graph");
+  assert.deepEqual(ir.nodes, []);
