@@ -0,0 +1,34 @@
+"""Routing strategy tests added by Netie patches.
+
+OpenVault's own tests/test_route_strategies.py is left as the sibling wrote it.
+"""
+
+from __future__ import annotations
+
+from openmw.openvault.route.rr_state import reset_decks
+from openmw.openvault.route.strategies import apply_strategy
+from openmw.openvault.route.types import RouteTarget
+
+
+def _targets() -> list[RouteTarget]:
+    return [
+        RouteTarget("a", "openai", "openai/gpt-4", weight=1.0, priority=10, cost=3.0),
+        RouteTarget("b", "anthropic", "anthropic/claude", weight=5.0, priority=20, cost=1.0),
+        RouteTarget("c", "google", "google/gemini", weight=2.0, priority=30, cost=2.0),
+    ]
+
+
+def test_strict_random_cycle_uses_each_key_once() -> None:
+    reset_decks()
+    targets = _targets()
+    firsts = [
+        apply_strategy("strict-random", targets, combo_name="sr1")[0].execution_key
+        for _ in range(3)
+    ]
+    assert sorted(firsts) == ["a", "b", "c"]
+
+
+def test_strict_random_remainder_is_permutation() -> None:
+    reset_decks()
+    ordered = apply_strategy("strict-random", _targets(), combo_name="sr2")
+    assert sorted(t.execution_key for t in ordered) == ["a", "b", "c"]
