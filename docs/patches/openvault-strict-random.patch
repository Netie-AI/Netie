index 8666b48..7eccf61 100644
--- a/OpenMW/openmw/openvault/route/strategies.py
+++ b/OpenMW/openmw/openvault/route/strategies.py
@@ -1,4 +1,4 @@
-"""Combo routing strategies — 8 of 18 for pass 1."""
+"""Combo routing strategies — 9 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
 
 from __future__ import annotations
 
@@ -24,6 +24,8 @@ STRATEGY_ALIASES: dict[str, StrategyName] = {
     "least_used": "least-used",
     "cost-optimized": "cost-optimized",
     "cost_optimized": "cost-optimized",
+    "strict-random": "strict-random",
+    "strict_random": "strict-random",
 }
 
 
@@ -79,4 +81,17 @@ def apply_strategy(
     if strategy == "cost-optimized":
         return sort_by_cost(targets)
 
+    if strategy == "strict-random":
+        # Algorithm port of OmniRoute strict-random + #3959 remainder shuffle.
+        # Do not vendor OmniRoute. First pick from a deck; shuffle the rest.
+        chosen_key = get_next_from_deck(
+            f"strict:{combo_name}",
+            [t.execution_key for t in targets],
+        )
+        chosen = next((t for t in targets if t.execution_key == chosen_key), targets[0])
+        rest = [t for t in targets if t.execution_key != chosen.execution_key]
+        rest_keys = fisher_yates_shuffle([t.execution_key for t in rest])
+        by_key = {t.execution_key: t for t in rest}
+        return [chosen, *[by_key[k] for k in rest_keys if k in by_key]]
+
     return list(targets)
