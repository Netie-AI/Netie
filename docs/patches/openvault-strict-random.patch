+
+
+def test_strict_random_cycle_uses_each_key_once() -> None:
+    reset_decks()
+    targets = _targets()
+    firsts = [
+        apply_strategy("strict-random", targets, combo_name="sr1")[0].execution_key
+        for _ in range(3)
+    ]
+    assert sorted(firsts) == ["a", "b", "c"]
+
+
+def test_strict_random_remainder_is_permutation() -> None:
+    reset_decks()
+    ordered = apply_strategy("strict-random", _targets(), combo_name="sr2")
+    assert sorted(t.execution_key for t in ordered) == ["a", "b", "c"]
