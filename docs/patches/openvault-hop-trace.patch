+def test_v1_fusion_usage_names_the_hop_that_served(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    rec = vault.create(
+        label="usage-hop",
+        provider="openai",
+        secret="sk-test-usage-aaaaaaaa",
+        role="primary",
+        priority=1,
+        base_url="https://example.invalid/v1",
+    )
+    vault.set_precheck(rec.id, status="ok", latency_ms=1.0, error=None)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="usage-fusion")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("ans-a"), _ok("ans-b"), _ok("FINAL")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {
+                    "strategy": "fusion",
+                    "models": ["gpt-4o-mini", "gpt-4o"],
+                    "judgeModel": "gpt-4o-mini",
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    events = client.get("/api/usage").json()["events"]
+    assert len(events) == 1
+    row = events[0]
+    assert row["vault_key_id"] == rec.id
+    assert row["provider"] == "openai"
+    assert row["provider"] != "dispatch"
+    assert row["model_requested"] == "auto"
+    assert row["model_served"] == "gpt-4o-mini"
+
+
+def test_v1_failover_usage_names_the_winning_key(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    first = vault.create(
+        label="hop-a",
+        provider="openai",
+        secret="sk-test-hop-a-aaaaaaaa",
+        role="primary",
+        priority=1,
+        base_url="https://example.invalid/v1",
+    )
+    second = vault.create(
+        label="hop-b",
+        provider="openai",
+        secret="sk-test-hop-b-aaaaaaaa",
+        role="primary",
+        priority=2,
+        base_url="https://example.invalid/v1",
+    )
+    vault.set_precheck(first.id, status="ok", latency_ms=1.0, error=None)
+    vault.set_precheck(second.id, status="ok", latency_ms=1.0, error=None)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="usage-fail")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_http_err(500, "boom"), _ok("solo")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {"strategy": "fusion", "models": ["gpt-4o-mini"]},
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    events = client.get("/api/usage").json()["events"]
+    assert len(events) == 1
+    assert events[0]["vault_key_id"] == second.id
+    assert events[0]["vault_key_id"] != first.id
+    assert events[0]["provider"] != "dispatch"
+
+
+
 
