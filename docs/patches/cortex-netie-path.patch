diff --git a/tests/dms/test_constitution_path.py b/tests/dms/test_constitution_path.py
new file mode 100644
index 0000000..e80e55f
--- /dev/null
+++ b/tests/dms/test_constitution_path.py
@@ -0,0 +1,56 @@
+"""Product caller for Netie cortex_path. No uv-add of the netie package."""
+
+from __future__ import annotations
+
+import pytest
+
+from CortexOS.constitution.cortex_path import CODING_TOOLS, RouteDenied, run_question
+
+
+def test_unverified_answer_is_refused() -> None:
+    with pytest.raises(RouteDenied) as ctx:
+        run_question("minimal")
+    assert "verified" in str(ctx.value)
+
+
+def test_coding_tools_refused_even_via_tool_runner() -> None:
+    for name in ("bash", "ls", "read_file"):
+        assert name in CODING_TOOLS
+        with pytest.raises(RouteDenied) as ctx:
+            run_question(
+                "minimal",
+                tool=name,
+                via_tool_runner=True,
+                verified=True,
+                pack="dms",
+            )
+        assert "Claude Code" in str(ctx.value)
+
+
+def test_tool_runner_refuses_bash(tmp_path, monkeypatch) -> None:
+    db = tmp_path / "ledger.db"
+    monkeypatch.delenv("DMS_LEDGER_DSN", raising=False)
+    monkeypatch.setenv("DMS_OPS_DB", str(db))
+    from netie.execution.tool_runner import ToolCallError, run_tool_call
+
+    with pytest.raises(ToolCallError) as ctx:
+        run_tool_call("bash", {}, actor="steward", run_id="b1", db_path=db)
+    assert "Claude Code" in str(ctx.value)
+
+
+def test_a2a_is_dms_pack_only() -> None:
+    with pytest.raises(RouteDenied) as ctx:
+        run_question("minimal", verified=True, a2a=True)
+    assert "dms-pack" in str(ctx.value)
+    out = run_question("minimal", verified=True, pack="dms", a2a=True)
+    assert out["pack"] == "dms"
+
+
+def test_export_pptx_needs_an_actor() -> None:
+    with pytest.raises(RouteDenied) as ctx:
+        run_question("minimal", write="export_pptx", verified=True)
+    assert "actor" in str(ctx.value)
+    out = run_question(
+        "minimal", write="export_pptx", actor="steward", verified=True, pack="dms"
+    )
+    assert out["write"] == "export_pptx"
