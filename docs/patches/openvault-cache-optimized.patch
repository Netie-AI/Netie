+    if strategy == "cache-optimized":
+        # Algorithm port of OmniRoute rendezvous affinity. No prefix analyzer.
+        key = (cache_key or "").strip()
+        if not key:
+            return list(targets)
+        max_high = (1 << 64) - 1
+
+        def _identity(t: RouteTarget) -> str:
+            conn = (t.connection_id or "").strip()
+            if conn:
+                return f"connection:{conn}"
+            return f"execution:{t.execution_key}"
+
+        def _score(t: RouteTarget) -> float:
+            digest = hashlib.sha256()
+            digest.update(key.encode("utf-8"))
+            digest.update(b"\0")
+            digest.update(_identity(t).encode("utf-8"))
+            high = int.from_bytes(digest.digest()[:16], "big") >> 64
+            return high / max_high
+
+        decorated = list(enumerate(targets))
+        decorated.sort(key=lambda pair: (-_score(pair[1]), pair[0]))
+        return [t for _, t in decorated]
+
     return list(targets)
