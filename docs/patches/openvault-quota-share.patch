+++ b/OpenMW/openmw/openvault/route/execution.py
@@ -41,6 +41,43 @@ class ExecutionRefused(ValueError):
         self.message = message
 
 
+def _flag_on(value: Any) -> bool:
+    return value not in (None, False, 0, "", "0", "false", "False")
+
+
+def refuse_unported_analogue(*, strategy: Any = None, quota_share: Any = False) -> None:
+    """Name OmniRoute-internal quota-share. Do not treat it as unknown 400."""
+    name = str(strategy or "").strip().lower().replace("_", "-")
+    if name == "quota-share" or _flag_on(quota_share):
+        raise ExecutionRefused(501, "quota-share is OmniRoute-internal, not ported")
+
+
+def refuse_unported_from_body(body: dict[str, Any] | None) -> None:
+    if not isinstance(body, dict):
+        return
+    combo = body.get("combo") if isinstance(body.get("combo"), dict) else {}
+    bag = {**body, **combo}
+    refuse_unported_analogue(
+        strategy=bag.get("strategy"),
+        quota_share=bag.get("quota_share") or bag.get("quotaShare"),
+    )
+
+
+def unported_http(
+    body: dict[str, Any] | None,
+) -> tuple[int, dict[str, Any]] | None:
+    try:
+        refuse_unported_from_body(body)
+    except ExecutionRefused as exc:
+        return exc.code, {
+            "error": {
+                "message": exc.message,
+                "type": "openvault_unported",
+            }
+        }
+    return None
+
+
