+"""default_broker must not skip F8. File read only; no litellm."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+
+def test_broker_source_has_no_web_or_discovery_skip() -> None:
+    path = Path(__file__).resolve().parents[2] / "CortexOS" / "execution" / "agent_task.py"
+    src = path.read_text(encoding="utf-8")
+    start = src.index("def default_broker")
+    end = src.index("\ndef ", start + 1)
+    body = src[start:end]
+    assert "WEB_TOOLS" not in body
+    assert "DISCOVERY_TOOLS" not in body
+    assert "run_tool_call" in body
