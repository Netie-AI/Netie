diff --git a/tests/dms/test_broker_no_skip.py b/tests/dms/test_broker_no_skip.py
new file mode 100644
index 0000000..4136646
--- /dev/null
+++ b/tests/dms/test_broker_no_skip.py
@@ -0,0 +1,94 @@
+"""default_broker must not skip F8, and web_fetch keeps its guard inside F8."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+
+def test_broker_source_has_no_web_or_discovery_skip() -> None:
+    path = Path(__file__).resolve().parents[2] / "CortexOS" / "execution" / "agent_task.py"
+    src = path.read_text(encoding="utf-8")
+    start = src.index("def default_broker")
+    end = src.index("\ndef ", start + 1)
+    body = src[start:end]
+    assert "WEB_TOOLS" not in body
+    assert "DISCOVERY_TOOLS" not in body
+    assert "run_tool_call" in body
+
+
+@pytest.fixture
+def ops_db(tmp_path, monkeypatch) -> Path:
+    db = tmp_path / "ops.db"
+    monkeypatch.setenv("DMS_OPS_DB", str(db))
+    monkeypatch.delenv("DMS_LEDGER_DSN", raising=False)
+    return db
+
+
+def _events(db: Path) -> list[tuple[str, dict[str, Any]]]:
+    from packs.dms.audit import ledger
+
+    return [(e.event_type, e.payload) for e in ledger.list_entries(db_path=db)]
+
+
+def test_web_fetch_reaches_the_net_only_through_the_runner(ops_db, monkeypatch) -> None:
+    from CortexOS.execution import agent_task, tool_runner, web_tools
+
+    seen: list[tuple[str, dict[str, Any]]] = []
+    real = tool_runner.run_tool_call
+
+    def spy(tool: str, params: Any = None, **kw: Any) -> dict[str, Any]:
+        seen.append((tool, dict(kw)))
+        return real(tool, params, **kw)
+
+    fetched: list[str] = []
+    monkeypatch.setattr(tool_runner, "run_tool_call", spy)
+    monkeypatch.setattr(web_tools, "non_public_reason", lambda url: "")
+    monkeypatch.setattr(web_tools, "_get", lambda *a, **k: pytest.fail("unguarded fetch used"))
+    monkeypatch.setattr(
+        web_tools, "_get_public", lambda target, **k: fetched.append(target) or b"<title>ok</title>hi"
+    )
+    out = agent_task.default_broker("web_fetch", {"url": "https://example.com/", "public_only": False})
+    assert out["ok"] is True and out["title"] == "ok"
+    assert fetched == ["https://example.com/"]
+    assert [tool for tool, _ in seen] == ["web_fetch"]
+    events = _events(ops_db)
+    assert [kind for kind, _ in events] == ["action.tool_call"]
+    assert events[0][1]["tool"] == "web_fetch" and events[0][1]["verdict"] == "pass"
+
+
+def test_web_fetch_internal_address_is_refused_and_ledgered(ops_db, monkeypatch) -> None:
+    from CortexOS.execution import agent_task, web_tools
+
+    monkeypatch.setattr(web_tools, "_get", lambda *a, **k: pytest.fail("fetched"))
+    monkeypatch.setattr(web_tools, "_get_public", lambda *a, **k: pytest.fail("fetched"))
+    out = agent_task.default_broker(
+        "web_fetch", {"url": "http://169.254.169.254/latest/meta-data/", "public_only": False}
+    )
+    assert out["ok"] is False and out["error"].startswith("refused:")
+    assert out["verdict"] == "public_only"
+    events = _events(ops_db)
+    assert [kind for kind, _ in events] == ["action.tool_call_denied"]
+    assert events[0][1]["tool"] == "web_fetch"
+
+
+@pytest.mark.parametrize("name", ["web_search", "find_skills", "find_mcp", "find_subagents"])
+def test_search_and_discovery_have_no_handler_and_deny(ops_db, monkeypatch, name) -> None:
+    from CortexOS.execution import agent_task, web_tools
+
+    monkeypatch.setattr(web_tools, "_get", lambda *a, **k: pytest.fail("left the machine"))
+    out = agent_task.default_broker(name, {"query": "x"})
+    assert out["ok"] is False and out["verdict"] == "allowlist"
+
+
+def test_web_fetch_is_not_an_action_route_or_dag_tool(ops_db, monkeypatch) -> None:
+    """Only the workflow broker opts in. The allowlist itself does not grow."""
+    from CortexOS.execution import tool_runner, web_tools
+
+    monkeypatch.setattr(web_tools, "_get_public", lambda *a, **k: pytest.fail("fetched"))
+    assert "web_fetch" not in tool_runner.allowed_action_tools()
+    with pytest.raises(tool_runner.ToolCallError) as exc:
+        tool_runner.run_tool_call("web_fetch", {"url": "https://example.com/"}, actor="steward")
+    assert exc.value.verdict == "allowlist"
