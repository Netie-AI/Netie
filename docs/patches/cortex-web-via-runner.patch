+#: the registry-derived allowlist does not grow.
+AGENT_BUILTINS = frozenset({"web_fetch"})
+
+
+def _run_web_fetch(params: dict[str, Any]) -> dict[str, Any]:
+    from CortexOS.execution import web_tools
+
+    kwargs: dict[str, Any] = {"url": str(params.get("url") or "")}
+    if "max_chars" in params:
+        kwargs["max_chars"] = int(params["max_chars"])
+    # The model never chooses its own SSRF guard (PRD R4.6): whatever
+    # ``public_only`` it passed is dropped here.
+    return web_tools.fetch(**kwargs, public_only=True)
+
