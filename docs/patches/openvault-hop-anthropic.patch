+def test_v1_anthropic_only_shape_names_the_skip(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    rec = vault.create(
+        label="anth-hop",
+        provider="anthropic",
+        secret="sk-ant-test-anth-hop-aaaaaaaa",
+        role="primary",
+        priority=1,
+        base_url="https://api.anthropic.com",
+    )
+    vault.set_precheck(rec.id, status="ok", latency_ms=1.0, error=None)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="anth-shape-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("nope")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "fusion",
+                    "models": ["claude-opus-4"],
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 503, resp.text
+    assert "anthropic chat not via /v1 proxy yet" in resp.json()["error"]["message"]
+    assert mock.post.call_count == 0
+
+
 
 
 
