     assert [h.execution_key for h in hops_for_model(hops, "gpt-mini")] == ["k1", "k2"]
 
 
+def test_hop_call_model_anthropic_only_names_the_skip() -> None:
+    hops = [Hop("k1", "claude", "anthropic", True)]
+    seen: list[str] = []
+
+    def post(hop: Hop, *, model: str, **_k: object) -> str:
+        seen.append(hop.execution_key)
+        return "should-not-post"
+
+    call = hop_call_model(hops, post)
+    with pytest.raises(ExecutionRefused) as ctx:
+        call("claude", user_text="Q")
+    assert ctx.value.code == 503
+    assert "anthropic chat not via /v1 proxy yet" in str(ctx.value)
+    assert seen == []
+
+
