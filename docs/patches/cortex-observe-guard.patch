diff --git a/tests/dms/test_constitution_path.py b/tests/dms/test_constitution_path.py
index e80e55f..7024cd6 100644
--- a/tests/dms/test_constitution_path.py
+++ b/tests/dms/test_constitution_path.py
@@ -4,7 +4,12 @@ from __future__ import annotations
 
 import pytest
 
-from CortexOS.constitution.cortex_path import CODING_TOOLS, RouteDenied, run_question
+from CortexOS.constitution.cortex_path import (
+    CODING_TOOLS,
+    OBSERVE_TOOLS,
+    RouteDenied,
+    run_question,
+)
 
 
 def test_unverified_answer_is_refused() -> None:
@@ -46,6 +51,38 @@ def test_a2a_is_dms_pack_only() -> None:
     assert out["pack"] == "dms"
 
 
+def test_observe_png_and_clipboard_refuse() -> None:
+    assert "computer.observe" in OBSERVE_TOOLS
+    out = run_question(
+        "minimal",
+        tool="computer.observe",
+        via_tool_runner=True,
+        verified=True,
+        pack="dms",
+    )
+    assert out["observe"] == "guard_observe"
+    with pytest.raises(RouteDenied) as ctx:
+        run_question(
+            "minimal",
+            tool="computer.observe",
+            via_tool_runner=True,
+            verified=True,
+            pack="dms",
+            observe={"screenshot": "data:image/png;base64,AAA"},
+        )
+    assert "screenshot_uncropped" in str(ctx.value)
+    with pytest.raises(RouteDenied) as clip:
+        run_question(
+            "minimal",
+            tool="screenshot",
+            via_tool_runner=True,
+            verified=True,
+            pack="dms",
+            observe={"clipboard": "secret"},
+        )
+    assert "clipboard" in str(clip.value)
+
+
 def test_export_pptx_needs_an_actor() -> None:
     with pytest.raises(RouteDenied) as ctx:
         run_question("minimal", write="export_pptx", verified=True)
