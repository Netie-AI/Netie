+def test_route_skill_ids_lift_the_refusal_not_the_resolver(tmp_path, monkeypatch) -> None:
+    """ids-only `skill_ids` pass the body check. OpenVault's registry still decides."""
+    from fastapi.testclient import TestClient
+
+    from openmw.openvault.app import create_app
+
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    client = TestClient(
+        create_app(mock_health=True, enable_precheck_loop=False),
+        client=("127.0.0.1", 5555),
+    )
+    ask = {"kind": "skill", "id": "netie-kb.skills", "intent": "invoke"}
+    bare = client.post("/api/crew/gate", json=ask).json()
+    assert bare["allowed"] is False
+
+    resolved = client.post("/api/access/resolve", json=ask).json()
+    listed = client.post(
+        "/api/crew/gate", json={**ask, "skill_ids": ["netie-kb.skills"]}
+    ).json()
+    assert listed["allowed"] == resolved["allowed"]
+    assert listed["reasons"] == resolved["reasons"]
+    assert listed["owner"] == "netie-kb"
+
+    other = client.post(
+        "/api/crew/gate", json={**ask, "skill_ids": ["S-9999"]}
+    ).json()
+    assert other["allowed"] is False
+
+    unknown = client.post(
+        "/api/crew/gate",
+        json={"kind": "skill", "id": "S-0004", "intent": "invoke", "skill_ids": ["S-0004"]},
+    ).json()
+    assert unknown["found"] is False
+    assert unknown["allowed"] is False
