+"""tmp_path versions of three stack-detection tests.
+
+OpenVault's own tests/test_detect_stacks.py probes D:\\Cortex and D:\\OpenVault\\vendor\\openship
+and skips off Windows. That file is left as the sibling wrote it. These tests build the same
+shapes under tmp_path so they run anywhere.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from openmw.openvault.ship.detect import detect_project
+
+
+def test_cortex_is_python_not_docker_compose(tmp_path: Path) -> None:
+    """Was a live D:\\Cortex probe. Same defect as a uv Python app sitting next to compose."""
+    (tmp_path / "pyproject.toml").write_text(
+        "[project]\nname = 'cortex'\nrequires-python = '>=3.11'\n"
+        "dependencies = ['fastapi']\n",
+        encoding="utf-8",
+    )
+    (tmp_path / "docker-compose.yml").write_text(
+        "services:\n  qdrant:\n    image: qdrant/qdrant\n", encoding="utf-8"
+    )
+    (tmp_path / "main.py").write_text(
+        "from fastapi import FastAPI\napp = FastAPI()\n", encoding="utf-8"
+    )
+    stack = detect_project(tmp_path)
+    assert stack.primary == "python"
+    assert stack.framework in ("python", "fastapi")
+    assert stack.install_command == "uv sync"
+    assert stack.start_command, "a Python project must get a start command"
+
+
+def test_openship_monorepo(tmp_path: Path) -> None:
+    """Was a live D:\\OpenVault\\vendor\\openship probe. Bun workspace, dashboard Next app."""
+    (tmp_path / "package.json").write_text(
+        json.dumps(
+            {
+                "packageManager": "bun@1.3.10",
+                "workspaces": ["apps/*"],
+            }
+        ),
+        encoding="utf-8",
+    )
+    (tmp_path / "bun.lock").write_text("# lock\n", encoding="utf-8")
+    dashboard = tmp_path / "apps" / "dashboard"
+    dashboard.mkdir(parents=True)
+    dashboard.joinpath("package.json").write_text(
+        json.dumps(
+            {
+                "dependencies": {"next": "^16"},
+                "scripts": {"build": "next build", "start": "next start"},
+            }
+        ),
+        encoding="utf-8",
+    )
+    stack = detect_project(tmp_path)
+    assert stack.root_directory == "apps/dashboard"
+    assert stack.framework == "nextjs"
+    assert stack.package_manager == "bun"
+    assert stack.install_command == "cd ../.. && bun install"
+    assert stack.build_command == "bun run build"
+    assert stack.start_command == "bun run start"
+    assert stack.output_directory == "apps/dashboard/.next"
+
+
+def test_openship_api_is_hono(tmp_path: Path) -> None:
+    api = tmp_path / "apps" / "api"
+    api.mkdir(parents=True)
+    api.joinpath("package.json").write_text(
+        json.dumps({"dependencies": {"hono": "^4"}}),
+        encoding="utf-8",
+    )
+    stack = detect_project(api)
+    assert stack.framework == "hono"
+    assert stack.category == "backend"
+    assert stack.primary == "node"
