diff --git a/OpenMW/tests/test_crew_gate.py b/OpenMW/tests/test_crew_gate.py
new file mode 100644
index 0000000..a599d80
--- /dev/null
+++ b/OpenMW/tests/test_crew_gate.py
@@ -0,0 +1,63 @@
+"""POST /api/crew/gate: location + allowed, never a skill body."""
+
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+from openmw.openvault.app import create_app
+
+
+def _client() -> TestClient:
+    app = create_app(mock_health=True, enable_precheck_loop=False)
+    return TestClient(app, client=("127.0.0.1", 5555))
+
+
+def test_skill_kind_is_refused_until_registered(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={
+            "kind": "skill",
+            "id": "netie-kb.skills",
+            "intent": "invoke",
+            "parent_run_id": "p1",
+            "child_id": "c1",
+            "deficit": "need space.acl",
+        },
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["allowed"] is not True
+    assert "skill_body" not in body
+
+
+def test_skill_body_in_request_is_refused(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={
+            "kind": "service",
+            "id": "service.freeroute",
+            "intent": "invoke",
+            "skill_body": "SECRET prompt",
+        },
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["allowed"] is not True
+    dumped = resp.text
+    assert "SECRET" not in dumped
+    assert "skill_body" not in body
+
+
+def test_known_service_resolve_never_returns_a_body(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={"kind": "service", "id": "service.freeroute", "intent": "invoke"},
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert "allowed" in body
+    assert "skill_body" not in body
+    assert "transcript" not in body
