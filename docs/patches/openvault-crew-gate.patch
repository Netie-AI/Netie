index 0000000..8957f77
--- /dev/null
+++ b/OpenMW/tests/test_crew_gate.py
@@ -0,0 +1,121 @@
+"""POST /api/crew/gate: location + allowed, never a skill body."""
+
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+from openmw.openvault.app import create_app
+
+
+def _client() -> TestClient:
+    app = create_app(mock_health=True, enable_precheck_loop=False)
+    return TestClient(app, client=("127.0.0.1", 5555))
+
+
+def test_skill_kind_is_refused_until_registered(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={
+            "kind": "skill",
+            "id": "netie-kb.skills",
+            "intent": "invoke",
+            "parent_run_id": "p1",
+            "child_id": "c1",
+            "deficit": "need space.acl",
+        },
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["allowed"] is not True
+    assert "skill_body" not in body
+
+
+def test_skill_body_in_request_is_refused(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={
+            "kind": "service",
+            "id": "service.freeroute",
+            "intent": "invoke",
+            "skill_body": "SECRET prompt",
+        },
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["allowed"] is not True
+    dumped = resp.text
+    assert "SECRET" not in dumped
+    assert "skill_body" not in body
+
+
+def test_known_service_resolve_never_returns_a_body(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    resp = _client().post(
+        "/api/crew/gate",
+        json={"kind": "service", "id": "service.freeroute", "intent": "invoke"},
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert "allowed" in body
+    assert "skill_body" not in body
+    assert "transcript" not in body
+
+
+def test_gate_is_one_route_not_a_shadow(tmp_path, monkeypatch) -> None:
+    """The patch tightens OpenVault's own route. A second registration shadows it."""
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    app = create_app(mock_health=True, enable_precheck_loop=False)
+    hits = [
+        route
+        for route in app.routes
+        if getattr(route, "path", "") == "/api/crew/gate"
+        and "POST" in (getattr(route, "methods", None) or ())
+    ]
+    assert len(hits) == 1
+
+
+def test_refused_skill_keeps_the_signpost_and_the_audit_echo(tmp_path, monkeypatch) -> None:
+    """Refusal lowers `allowed`. It does not hide where the registry lives."""
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    body = _client().post(
+        "/api/crew/gate",
+        json={
+            "kind": "skill",
+            "id": "netie-kb.skills",
+            "intent": "invoke",
+            "parent_run_id": "p1",
+            "child_id": "c1",
+            "deficit": "need space.acl",
+        },
+    ).json()
+    assert body["allowed"] is False
+    assert body["found"] is True
+    assert body["owner"] == "netie-kb"
+    assert body["reasons"][0] == "no skill registered as 'netie-kb.skills'"
+    assert body["parent_run_id"] == "p1"
+    assert body["child_id"] == "c1"
+    assert body["deficit"] == "need space.acl"
+
+
+def test_mcp_kind_is_refused(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    body = _client().post(
+        "/api/crew/gate",
+        json={"kind": "mcp", "id": "netie-kb.mcp", "intent": "invoke"},
+    ).json()
+    assert body["allowed"] is False
+    assert body["reasons"][0] == "no mcp registered as 'netie-kb.mcp'"
+
+
+def test_known_service_verdict_is_the_resolver_verdict(tmp_path, monkeypatch) -> None:
+    """A kind this gate knows is not tightened: same answer as /api/access/resolve."""
+    monkeypatch.setenv("OPENVAULT_HOME", str(tmp_path))
+    client = _client()
+    ask = {"kind": "service", "id": "service.freeroute", "intent": "invoke"}
+    gate = client.post("/api/crew/gate", json=ask).json()
+    resolved = client.post("/api/access/resolve", json=ask).json()
+    assert gate["allowed"] == resolved["allowed"]
+    assert gate["reasons"] == resolved["reasons"]
+    assert gate["location"] == resolved["location"]
