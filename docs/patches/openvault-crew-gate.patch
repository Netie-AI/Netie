+    _CREW_BODY_KEYS = frozenset({"skill_body", "prompt", "instructions", "transcript"})
+
+    @app.post("/api/crew/gate")
+    def crew_gate(body: CrewGateBody) -> dict[str, Any]:
+        """Crew: may this child invoke? Location + allowed, never a skill body."""
+        if any(
+            getattr(body, key) is not None
+            for key in ("skill_body", "prompt", "instructions", "transcript")
+        ):
+            log.info(
+                "crew_gate",
+                kind=body.kind,
+                resource=body.id,
+                allowed=False,
+                reasons=["skill_body must never go to the gate"],
+            )
+            return {
+                "allowed": False,
+                "found": False,
+                "kind": body.kind,
+                "id": body.id,
+                "intent": body.intent,
+                "parent_run_id": body.parent_run_id,
+                "child_id": body.child_id,
+                "reasons": ["skill_body must never go to the gate"],
+            }
+        if body.kind not in ACCESS_KINDS:
+            payload = {
+                "allowed": False,
+                "found": False,
+                "kind": body.kind,
+                "id": body.id,
+                "intent": body.intent,
+                "parent_run_id": body.parent_run_id,
+                "child_id": body.child_id,
+                "reasons": [f"no {body.kind} registered as '{body.id}'"],
+            }
+            log.info("crew_gate", **{k: payload[k] for k in ("kind", "id", "allowed")})
+            return payload
+        if body.intent not in ("read", "write", "invoke", "deploy", "leave", "connect"):
+            return {
+                "allowed": False,
+                "found": False,
+                "kind": body.kind,
+                "id": body.id,
+                "intent": body.intent,
+                "parent_run_id": body.parent_run_id,
+                "child_id": body.child_id,
+                "reasons": [f"unknown intent '{body.intent}'"],
+            }
+        result = resolve_access(
+            vault=state_vault,
+            kind=body.kind,  # type: ignore[arg-type]
+            resource_id=body.id,
+            intent=body.intent,  # type: ignore[arg-type]
+            fallback=fallback,
+            openvault_url=self_url,
+            required_providers=list(body.required_providers) or None,
+        )
+        payload = result.to_dict()
+        payload["parent_run_id"] = body.parent_run_id
+        payload["child_id"] = body.child_id
+        payload["deficit"] = body.deficit
+        for key in list(payload):
+            if key in _CREW_BODY_KEYS:
+                payload.pop(key, None)
+        log.info(
+            "crew_gate",
+            kind=result.kind,
+            resource=result.id,
+            parent_run_id=body.parent_run_id or None,
+            child_id=body.child_id or None,
+            allowed=result.allowed,
+            reasons=result.reasons,
+        )
+        return payload
