+class CrewGateBody(BaseModel):
+    """Crew asks: may this child invoke? Location + verdict, no skill body.
+
+    Unknown kinds (including ``skill`` until a registry entry exists) refuse.
+    ``parent_run_id`` is audit-only. Skill bodies belong in Netie-KB, not here.
+    """
+
+    kind: str
+    id: str
+    intent: str = "invoke"
+    parent_run_id: str = ""
+    child_id: str = ""
+    deficit: str = ""
+    required_providers: list[str] = Field(default_factory=list)
+    skill_body: object | None = None
