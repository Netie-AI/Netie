+
+test("compileIR does not copy canvas notes into Cortex IR", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal("note" in ir.nodes[0], false);
+});
+
+test("compileIR refuses a note that leaked a body", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "skill_body: SECRET" }],
+    edges: [],
+  });
+  assert.equal(ir.error, "note leaked a body");
+  assert.deepEqual(ir.nodes, []);
+  const prompt = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "system prompt dump" }],
+    edges: [],
+  });
+  assert.equal(prompt.error, "note leaked a body");
+});
+
+test("ghostWalk refuses a transcript note", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [{ id: "c", kind: "connector", note: "transcript of the room" }],
+      edges: [],
+    },
+    true
+  );
+  assert.equal(walked.error, "note leaked a body");
+  assert.deepEqual(walked.log, []);
+});
