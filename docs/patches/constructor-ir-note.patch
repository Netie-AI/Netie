+function notesDenied(nodes) {
+  // Canvas notes are labels. They are not a Cortex prompt bus.
+  let total = 0;
+  for (let i = 0; i < nodes.length; i++) {
+    const raw = nodes[i] && nodes[i].note;
+    const blob = raw === undefined || raw === null ? "" : String(raw);
+    total += blob.length;
+    const lower = blob.toLowerCase();
+    for (let j = 0; j < NOTE_LEAK.length; j++) {
+      if (lower.indexOf(NOTE_LEAK[j]) >= 0) return "note leaked a body";
+    }
+  }
+  if (total > MAX_NOTE_CHARS) return "notes over DitchContext";
+  return "";
+}
+
 function compileIR(state) {
   const nodes = (state && state.nodes) || [];
   const edges = (state && state.edges) || [];
