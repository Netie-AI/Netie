 const WRITE_ACTIONS = ["export_pptx", "item.intake", "amend.apply", "call_action"];
 const DATA_TYPES = ["string", "number", "integer", "boolean", "date"];
+const NOTE_LEAK = ["skill_body", "prompt", "transcript", "api_key", "password"];
