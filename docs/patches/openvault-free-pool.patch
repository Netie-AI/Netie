diff --git a/OpenMW/openmw/openvault/route/free_pool.py b/OpenMW/openmw/openvault/route/free_pool.py
new file mode 100644
index 0000000..eca827c
--- /dev/null
+++ b/OpenMW/openmw/openvault/route/free_pool.py
@@ -0,0 +1,104 @@
+"""FREE-token pool + register help. Not a 16th sort. Not OmniRoute vendored.
+
+uv add git+https://github.com/Netie-AI/Netie.git
+from netie.route import assist_free_pool
+
+Without Netie, the same rule runs locally. Empty free pool is 503 with
+register_url rows. Catalog must not carry api_key. Quota fetch / autoCombo /
+parallel stay 501.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+FREE_TIERS = frozenset({"free", "freemium", "local"})
+DROP_HELP = frozenset({"api_key", "key", "secret", "token", "authorization"})
+
+
+class FreePoolRefused(PermissionError):
+    def __init__(self, message: str, help_rows: list[dict[str, str]] | None = None) -> None:
+        super().__init__(message)
+        self.status_code = 503
+        self.code = 503
+        self.help = help_rows or []
+
+
+def _local_assist(
+    catalog: list[dict[str, Any]] | None,
+    *,
+    allow_paid: bool = False,
+    register: bool = False,
+    parallel: Any = False,
+    fetch_quota: Any = False,
+    auto_combo: Any = False,
+) -> dict[str, Any]:
+    if parallel or fetch_quota or auto_combo:
+        err = PermissionError("openvault_unported")
+        setattr(err, "status_code", 501)
+        setattr(err, "code", 501)
+        raise err
+    rows = [r for r in (catalog or []) if isinstance(r, dict) and r.get("id")]
+    for row in rows:
+        for bad in DROP_HELP:
+            if bad in row:
+                err = PermissionError("catalog leaked a secret field")
+                setattr(err, "status_code", 400)
+                setattr(err, "code", 400)
+                raise err
+
+    def help_row(row: dict[str, Any]) -> dict[str, str]:
+        return {
+            "id": str(row.get("id") or ""),
+            "register_url": str(row.get("register_url") or ""),
+            "free_notes": str(row.get("free_notes") or ""),
+        }
+
+    pool = [
+        {"id": str(r["id"]), "tier": str(r.get("tier") or "").lower()}
+        for r in rows
+        if str(r.get("tier") or "").lower() in FREE_TIERS
+    ]
+    if pool:
+        out: dict[str, Any] = {"pool": pool, "used_paid": False}
+        if register:
+            out["register"] = [help_row(r) for r in rows]
+        return out
+    if allow_paid:
+        paid = [
+            {"id": str(r["id"]), "tier": str(r.get("tier") or "paid").lower()}
+            for r in rows
+        ]
+        if paid:
+            return {"pool": paid, "used_paid": True}
+    raise FreePoolRefused("no free hop", [help_row(r) for r in rows])
+
+
+def pick_free_pool(
+    catalog: list[dict[str, Any]] | None,
+    *,
+    allow_paid: bool = False,
+    register: bool = False,
+    parallel: Any = False,
+    fetch_quota: Any = False,
+    auto_combo: Any = False,
+) -> dict[str, Any]:
+    try:
+        from netie.route import assist_free_pool
+    except ImportError:
+        return _local_assist(
+            catalog,
+            allow_paid=allow_paid,
+            register=register,
+            parallel=parallel,
+            fetch_quota=fetch_quota,
+            auto_combo=auto_combo,
+        )
+    return assist_free_pool(
+        catalog,
+        allow_paid=allow_paid,
+        register=register,
+        parallel=parallel,
+        fetch_quota=fetch_quota,
+        auto_combo=auto_combo,
+    )
diff --git a/OpenMW/tests/test_free_pool.py b/OpenMW/tests/test_free_pool.py
new file mode 100644
index 0000000..35d25a1
--- /dev/null
+++ b/OpenMW/tests/test_free_pool.py
@@ -0,0 +1,49 @@
+"""Free pool is register help, never invented keys."""
+
+from __future__ import annotations
+
+import inspect
+
+import pytest
+
+from openmw.openvault.route.free_pool import pick_free_pool
+
+
+def test_empty_pool_is_503_with_register_url() -> None:
+    with pytest.raises(Exception) as ctx:
+        pick_free_pool(
+            [{"id": "openrouter", "tier": "paid", "register_url": "https://openrouter.ai/keys"}]
+        )
+    err = ctx.value
+    assert getattr(err, "status_code", 503) == 503
+    help_rows = getattr(err, "help", [])
+    assert help_rows[0]["register_url"] == "https://openrouter.ai/keys"
+    assert "api_key" not in str(err)
+
+
+def test_free_tier_is_used() -> None:
+    out = pick_free_pool(
+        [{"id": "ollama", "tier": "local", "register_url": "http://127.0.0.1:11434"}]
+    )
+    assert out["pool"][0]["id"] == "ollama"
+    assert out["used_paid"] is False
+
+
+def test_catalog_key_field_is_400() -> None:
+    with pytest.raises(Exception) as ctx:
+        pick_free_pool([{"id": "x", "tier": "free", "api_key": "SECRET"}])
+    assert getattr(ctx.value, "status_code", 400) == 400
+    assert "SECRET" not in str(ctx.value)
+
+
+def test_quota_fetch_is_501() -> None:
+    with pytest.raises(Exception) as ctx:
+        pick_free_pool([{"id": "x", "tier": "free"}], fetch_quota=True)
+    assert getattr(ctx.value, "status_code", 501) == 501
+
+
+def test_source_prefers_netie_when_installed() -> None:
+    from openmw.openvault.route import free_pool
+
+    src = inspect.getsource(free_pool.pick_free_pool)
+    assert "from netie.route import assist_free_pool" in src
