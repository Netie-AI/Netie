diff --git a/tests/test_netie_acl.py b/tests/test_netie_acl.py
new file mode 100644
index 0000000..21dba3f
--- /dev/null
+++ b/tests/test_netie_acl.py
@@ -0,0 +1,111 @@
+"""live_ask / browse go through Netie Space ACL when installed."""
+
+from __future__ import annotations
+
+from dms_executor.netie_acl import (
+    answer_or_abstain,
+    browse_or_abstain,
+    guard_browse,
+    guard_live_answer,
+)
+
+
+ACL = {
+    "space-ops": frozenset({"inventory", "shipments"}),
+    "space-finance": frozenset({"invoices"}),
+}
+BINDS = {"space-ops": "default", "space-finance": "default"}
+
+
+def test_ops_cannot_read_invoices_on_live_path() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "invoices",
+        [{"id": 1}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT id FROM invoices",
+    )
+    assert out["status"] == "ABSTAIN"
+    assert out["rows"] == []
+
+
+def test_chat_mode_abstains() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "inventory",
+        [{"sku": "A"}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT sku FROM inventory",
+        chat_mode=True,
+    )
+    assert out["status"] == "ABSTAIN"
+    assert "AnythingLLM" in out["reason"]
+
+
+def test_sql_naming_ungranted_table_abstains() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "inventory",
+        [{"sku": "A"}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT inventory.sku FROM inventory JOIN invoices ON true",
+    )
+    assert out["status"] == "ABSTAIN"
+
+
+def test_guard_live_answer_skips_without_space() -> None:
+    assert (
+        guard_live_answer(
+            space_id=None,
+            granted=frozenset({"inventory"}),
+            warehouse_id="default",
+            sql="SELECT sku FROM inventory",
+            rows=[{"sku": "A"}],
+            route="sql",
+        )
+        is None
+    )
+
+
+def test_guard_live_answer_copies_rows() -> None:
+    rows = [{"sku": "A"}]
+    out = guard_live_answer(
+        space_id="space-ops",
+        granted=frozenset({"inventory", "shipments"}),
+        warehouse_id="default",
+        sql="SELECT sku FROM inventory",
+        rows=rows,
+        route="sql",
+    )
+    assert out is not None
+    assert out["status"] == "OK"
+    out["rows"][0]["sku"] = "LEAK"
+    assert rows[0]["sku"] == "A"
+
+
+def test_ops_cannot_browse_transactions() -> None:
+    out = browse_or_abstain(
+        {"space-ops": frozenset({"inventory", "shipments"})},
+        "space-ops",
+        "transactions",
+        tier="warehouse",
+    )
+    assert out["status"] == "ABSTAIN"
+
+
+def test_guard_browse_skips_without_space() -> None:
+    assert (
+        guard_browse(
+            space_id=None,
+            table="transactions",
+            tier="warehouse",
+            granted=frozenset({"inventory"}),
+        )
+        is None
+    )
