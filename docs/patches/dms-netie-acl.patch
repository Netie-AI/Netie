+
+    def lane(*_a: Any, **kw: Any) -> dict[str, Any]:
+        seen.append("ran")
+        return _env("SELECT txn_id FROM transactions", [{"txn_id": 1}])
+
+    monkeypatch.setattr(pkg, "maybe_verified_ask", lane)
+    out = exe.live_ask("zzq neutral question", space_id=OPS, session_id="ses_vq")
