diff --git a/tests/test_netie_acl.py b/tests/test_netie_acl.py
new file mode 100644
index 0000000..f4ebfc6
--- /dev/null
+++ b/tests/test_netie_acl.py
@@ -0,0 +1,141 @@
+"""live_ask / browse go through Netie Space ACL when installed."""
+
+from __future__ import annotations
+
+from dms_executor.netie_acl import (
+    answer_or_abstain,
+    browse_or_abstain,
+    guard_browse,
+    guard_live_answer,
+)
+
+ACL = {
+    "space-ops": frozenset({"inventory", "shipments"}),
+    "space-finance": frozenset({"invoices"}),
+}
+BINDS = {"space-ops": "default", "space-finance": "default"}
+
+
+def test_ops_cannot_read_invoices_on_live_path() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "invoices",
+        [{"id": 1}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT id FROM invoices",
+    )
+    assert out["status"] == "ABSTAIN"
+    assert out["rows"] == []
+
+
+def test_chat_mode_abstains() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "inventory",
+        [{"sku": "A"}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT sku FROM inventory",
+        chat_mode=True,
+    )
+    assert out["status"] == "ABSTAIN"
+    assert "AnythingLLM" in out["reason"]
+
+
+def test_sql_naming_ungranted_table_abstains() -> None:
+    out = answer_or_abstain(
+        ACL,
+        "space-ops",
+        "inventory",
+        [{"sku": "A"}],
+        warehouse_id="default",
+        binds=BINDS,
+        sql="SELECT inventory.sku FROM inventory JOIN invoices ON true",
+    )
+    assert out["status"] == "ABSTAIN"
+
+
+def test_guard_live_answer_skips_without_space() -> None:
+    assert (
+        guard_live_answer(
+            space_id=None,
+            granted=frozenset({"inventory"}),
+            warehouse_id="default",
+            sql="SELECT sku FROM inventory",
+            rows=[{"sku": "A"}],
+            route="sql",
+        )
+        is None
+    )
+
+
+def test_guard_live_answer_copies_rows() -> None:
+    rows = [{"sku": "A"}]
+    out = guard_live_answer(
+        space_id="space-ops",
+        granted=frozenset({"inventory", "shipments"}),
+        warehouse_id="default",
+        sql="SELECT sku FROM inventory",
+        rows=rows,
+        route="sql",
+    )
+    assert out is not None
+    assert out["status"] == "OK"
+    out["rows"][0]["sku"] = "LEAK"
+    assert rows[0]["sku"] == "A"
+
+
+def test_guard_live_answer_reads_granted_lake_alias() -> None:
+    out = guard_live_answer(
+        space_id="space-ops",
+        granted=frozenset({"inventory", "shipments"}),
+        warehouse_id="default",
+        sql="SELECT i.sku FROM warehouse_inventory AS i",
+        rows=[{"sku": "A"}],
+        route="sql",
+    )
+    assert out is not None
+    assert out["status"] == "OK"
+
+
+def test_guard_live_answer_ungranted_lake_alias_abstains() -> None:
+    for sql in (
+        "SELECT id FROM warehouse_invoices",
+        "SELECT i.sku FROM warehouse_inventory AS i JOIN warehouse_invoices AS v ON 1 = 1",
+        "SELECT sku FROM hr.warehouse_inventory",
+    ):
+        out = guard_live_answer(
+            space_id="space-ops",
+            granted=frozenset({"inventory", "shipments"}),
+            warehouse_id="default",
+            sql=sql,
+            rows=[{"sku": "A"}],
+            route="sql",
+        )
+        assert out is not None
+        assert out["status"] == "ABSTAIN", sql
+
+
+def test_ops_cannot_browse_transactions() -> None:
+    out = browse_or_abstain(
+        {"space-ops": frozenset({"inventory", "shipments"})},
+        "space-ops",
+        "transactions",
+        tier="warehouse",
+    )
+    assert out["status"] == "ABSTAIN"
+
+
+def test_guard_browse_skips_without_space() -> None:
+    assert (
+        guard_browse(
+            space_id=None,
+            table="transactions",
+            tier="warehouse",
+            granted=frozenset({"inventory"}),
+        )
+        is None
+    )
diff --git a/tests/test_netie_acl_paths.py b/tests/test_netie_acl_paths.py
new file mode 100644
index 0000000..6d5e5b4
--- /dev/null
+++ b/tests/test_netie_acl_paths.py
@@ -0,0 +1,436 @@
+"""Every executor path that returns source rows goes through the Netie Space gate.
+
+``tests/test_netie_acl.py`` proves the gate functions. This file proves each
+caller: ``live_ask`` (every lane), ``answer_user_sql``, a confirmed held SQL
+(``_run_held_sql``) and ``demo_ask``. For each path: a granted table stands, an
+ungranted one abstains, ``warehouse_<table>`` is read as ``<table>``, and
+hostile or malformed SQL abstains. A refusal is an envelope with
+``abstained: true`` and ``abstain_reason: space_acl``, never rows silently
+dropped.
+
+dms's own ``serve_gap`` already refuses most of these first. Where the test is
+about the Netie gate, it makes ``serve_gap`` permissive so the Netie gate is
+the only thing standing.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+from unittest.mock import MagicMock
+
+import dms_executor as pkg
+import pytest
+from cortex_contract.execution import Manifest
+from dms_executor import Executor
+from dms_executor.demo_warehouse import ensure_demo_warehouse
+from dms_executor.envelope import assert_envelope_valid, build_answer_envelope
+from dms_executor.manifest import ManifestMinter, SessionAcl
+from dms_executor.netie_acl import guard_envelope
+
+from tests.test_live_ask import FakeCortex
+
+# Warehouse Ops (DR-0002 seed): locations, inventory, shipments. Not transactions.
+OPS = "dddddddd-dddd-dddd-dddd-dddddddddddd"
+GRANTED = ("inventory", "locations", "shipments")
+UNGRANTED_SQL = "SELECT txn_id FROM transactions"
+GRANTED_SQL = "SELECT sku FROM inventory"
+ROWS = [{"sku": "SKU-1"}]
+
+
+def _env(sql: str | None, rows: list[dict[str, Any]], *, route: str = "sql") -> dict[str, Any]:
+    env = build_answer_envelope(
+        answer_id="ans_t",
+        text="Query result.",
+        badge="L2_VALIDATED",
+        abstained=False,
+        rows=rows,
+        sql_used=sql,
+        space_id=OPS,
+        session_id="ses_t",
+        ask_mode="live",
+        route=route,
+        question="q",
+    )
+    assert_envelope_valid(env)
+    return env
+
+
+def _exe(tmp_path: Any) -> Executor:
+    return Executor(warehouse_path=ensure_demo_warehouse(tmp_path / "w.duckdb"))
+
+
+def _refused(env: dict[str, Any]) -> bool:
+    return (
+        env["abstained"] is True
+        and env["badge"] == "ABSTAIN"
+        and env["rows"] == []
+        and not env.get("sql_used")
+        and env.get("abstain_reason") == "space_acl"
+    )
+
+
+# ---------------------------------------------------------------- the entry
+
+
+def test_granted_table_stands() -> None:
+    out = guard_envelope(_env(GRANTED_SQL, ROWS), granted=GRANTED, space_id=OPS)
+    assert out["abstained"] is False
+    assert out["rows"] == ROWS
+    assert out["sql_used"] == GRANTED_SQL
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        'SELECT sku FROM "inventory"',
+        "SELECT i.sku FROM main.inventory AS i",
+        "SELECT i.sku FROM warehouse_inventory AS i",
+        "SELECT i.sku FROM WAREHOUSE_INVENTORY AS i JOIN shipments AS s ON s.sku = i.sku",
+        "WITH t AS (SELECT sku FROM inventory) SELECT sku FROM t",
+    ],
+)
+def test_granted_spellings_stand(sql: str) -> None:
+    """Quoted, schema-defaulted, the warehouse_ lake alias and a CTE over a grant."""
+    out = guard_envelope(_env(sql, ROWS), granted=GRANTED, space_id=OPS)
+    assert out["abstained"] is False, sql
+    assert out["rows"] == ROWS
+
+
+def test_bronze_read_of_a_bare_upload_grant_stands_and_nothing_wider() -> None:
+    """dms grants an upload by its bare name and serves the read through ``bronze.``.
+
+    ``tests/test_name_echo_01.py`` pins that. Only the bronze schema and only a bare
+    grant: another schema, another upload, or a qualified grant opens nothing.
+    """
+    grants = ("q3_po_Sales",)
+    ok = _env("SELECT SUM(amount) AS total FROM bronze.q3_po_Sales", [{"total": 1}])
+    assert guard_envelope(ok, granted=grants, space_id=OPS)["abstained"] is False
+    for sql in (
+        "SELECT SUM(amount) FROM hr.q3_po_Sales",
+        "SELECT SUM(amount) FROM bronze.q4_po_Sales",
+        "SELECT SUM(amount) FROM bronze.q3_po_Sales JOIN bronze.payroll ON 1 = 1",
+    ):
+        assert _refused(guard_envelope(_env(sql, ROWS), granted=grants, space_id=OPS)), sql
+    qualified = ("other.q3_po_Sales",)
+    env = _env("SELECT 1 FROM bronze.q3_po_Sales", ROWS)
+    assert _refused(guard_envelope(env, granted=qualified, space_id=OPS))
+
+
+def test_ungranted_table_abstains_and_names_nothing() -> None:
+    out = guard_envelope(_env(UNGRANTED_SQL, [{"txn_id": 7}]), granted=GRANTED, space_id=OPS)
+    assert _refused(out)
+    blob = json.dumps(out)
+    assert "transactions" not in blob and "txn_id" not in blob
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        "SELECT txn_id FROM warehouse_transactions",
+        "SELECT i.sku FROM warehouse_inventory AS i JOIN warehouse_transactions AS t ON 1 = 1",
+        "SELECT sku FROM hr.warehouse_inventory",
+        "SELECT sku FROM other_schema.inventory",
+        "SELECT sku FROM inventory JOIN transactions ON 1 = 1",
+        "SELECT sku FROM inventory UNION SELECT txn_id FROM transactions",
+        "SELECT sku FROM inventory WHERE sku IN (SELECT sku FROM transactions)",
+        "WITH t AS (SELECT * FROM transactions) SELECT * FROM t",
+        "SELECT sku FROM inventory; SELECT txn_id FROM transactions",
+    ],
+)
+def test_ungranted_alias_join_and_hiding_places_abstain(sql: str) -> None:
+    out = guard_envelope(_env(sql, ROWS), granted=GRANTED, space_id=OPS)
+    assert _refused(out), sql
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        "SELEC FROM (((",
+        "this is not sql at all",
+        "SELECT 1",
+        "SELECT * FROM read_csv('/etc/passwd')",
+        "SELECT * FROM inventory\u043e",  # Cyrillic o: not the granted name
+        "SELECT * FROM 'inventory.csv'",
+        "-- inventory",
+        "   ",
+    ],
+)
+def test_hostile_or_malformed_sql_abstains(sql: str) -> None:
+    """Rows came back with a statement that names no granted relation: refuse."""
+    out = guard_envelope(_env(sql.strip() or None, ROWS), granted=GRANTED, space_id=OPS)
+    assert _refused(out), sql
+
+
+def test_rows_with_no_sql_abstain_but_a_bare_answer_is_left_alone() -> None:
+    assert _refused(guard_envelope(_env(None, ROWS), granted=GRANTED, space_id=OPS))
+    nothing = _env(None, [])
+    assert guard_envelope(nothing, granted=GRANTED, space_id=OPS) is nothing
+
+
+def test_empty_grant_set_abstains() -> None:
+    assert _refused(guard_envelope(_env(GRANTED_SQL, ROWS), granted=(), space_id=OPS))
+    assert _refused(guard_envelope(_env(GRANTED_SQL, ROWS), granted=None, space_id=OPS))
+
+
+def test_no_space_doc_route_and_prior_abstain_are_left_alone() -> None:
+    env = _env(UNGRANTED_SQL, ROWS)
+    assert guard_envelope(env, granted=GRANTED, space_id=None) is env
+    doc = _env(None, [{"chunk": "text"}], route="document")
+    assert guard_envelope(doc, granted=GRANTED, space_id=OPS) is doc
+    refused = guard_envelope(_env(UNGRANTED_SQL, ROWS), granted=GRANTED, space_id=OPS)
+    assert guard_envelope(refused, granted=GRANTED, space_id=OPS) is refused
+
+
+def test_row_naming_another_table_abstains() -> None:
+    out = guard_envelope(
+        _env(GRANTED_SQL, [{"sku": "A", "_table": "transactions"}]),
+        granted=GRANTED,
+        space_id=OPS,
+    )
+    assert _refused(out)
+
+
+# ------------------------------------------------------ answer_user_sql
+
+
+def _lax_dms_gate(monkeypatch: pytest.MonkeyPatch) -> None:
+    """dms's structural gate says yes. The Netie gate is then the only one left."""
+    monkeypatch.setattr(pkg, "serve_gap", lambda *a, **k: None)
+
+
+def test_answer_user_sql_granted_stands(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    env = exe.answer_user_sql("SELECT COUNT(*) AS n FROM inventory", space_id=OPS)
+    assert env["abstained"] is False
+    assert env["rows"] and env["rows"][0]["n"] > 0
+
+
+def test_answer_user_sql_ungranted_abstains_on_dms_gate_alone(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    env = exe.answer_user_sql(UNGRANTED_SQL, space_id=OPS)
+    assert env["abstained"] is True
+    assert env["rows"] == []
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        "SELECT COUNT(*) AS n FROM transactions",
+        "SELECT COUNT(*) AS n FROM inventory, transactions",
+        "SELECT COUNT(*) AS n FROM main.transactions",
+    ],
+)
+def test_answer_user_sql_netie_gate_stops_what_dms_gate_missed(
+    tmp_path: Any, monkeypatch: pytest.MonkeyPatch, sql: str
+) -> None:
+    exe = _exe(tmp_path)
+    _lax_dms_gate(monkeypatch)
+    env = exe.answer_user_sql(sql, space_id=OPS)
+    assert _refused(env), (sql, env.get("abstain_reason"))
+    assert_envelope_valid(env)
+
+
+def test_answer_user_sql_without_a_space_is_unchanged(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    env = exe.answer_user_sql("SELECT COUNT(*) AS n FROM transactions")
+    assert env["abstained"] is False
+    assert env["rows"][0]["n"] > 0
+
+
+# ------------------------------------- reconfirm: _run_held_sql (Yes)
+
+
+def _held(sql: str, grantable: list[str]) -> dict[str, Any]:
+    return {
+        "sql": sql,
+        "grantable": grantable,
+        "reason_code": "definition",
+        "question": "how many",
+        "space_id": OPS,
+        "session_id": "ses_held",
+    }
+
+
+def test_held_sql_granted_stands(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    out = exe._run_held_sql(_held("SELECT COUNT(*) AS n FROM inventory", list(GRANTED)))
+    assert out["abstained"] is False
+    assert out["rows"]
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        "SELECT COUNT(*) AS n FROM transactions",
+        "SELECT COUNT(*) AS n FROM inventory JOIN transactions ON 1 = 1",
+    ],
+)
+def test_held_sql_ungranted_abstains_even_if_the_held_grant_list_is_stale(
+    tmp_path: Any, sql: str
+) -> None:
+    """The pending entry names a wider grant set than the Space holds now.
+
+    The held list is what the offer saw. The gate re-reads the Space's grants
+    at Yes time, so a revoked or forged list does not widen the Space.
+    """
+    exe = _exe(tmp_path)
+    out = exe._run_held_sql(_held(sql, [*GRANTED, "transactions"]))
+    assert _refused(out), sql
+    assert out.get("reconfirm_accepted") is None
+
+
+# --------------------------------------------------------------- demo_ask
+
+
+def test_demo_ask_in_a_space_without_the_table_abstains(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    env = exe.demo_ask("What was total revenue?", space_id=OPS)
+    assert env["abstained"] is True
+    assert env["rows"] == []
+    assert not env.get("values")
+
+
+def test_demo_ask_without_a_space_is_unchanged(tmp_path: Any) -> None:
+    exe = _exe(tmp_path)
+    env = exe.demo_ask("What was total revenue?")
+    assert env["abstained"] is False
+
+
+# ------------------------------------------------- live_ask, every lane
+
+
+@pytest.fixture()
+def minter(monkeypatch: pytest.MonkeyPatch) -> ManifestMinter:
+    m = ManifestMinter()
+    key = MagicMock()
+    key.kid = "test-kid"
+
+    def _mint(acl: SessionAcl) -> Manifest:
+        return Manifest(
+            session_id=acl.session_id,
+            org_id=acl.org_id,
+            space_id=acl.space_id,
+            pool_id=acl.pool_id,
+            issuer_key_id="test-kid",
+            allowed_paths=list(acl.allowed_paths),
+            row_predicates=dict(acl.row_predicates),
+            issued_at="2026-07-30T00:00:00+00:00",
+            expires_at="2026-07-30T01:00:00+00:00",
+            signature="dGVzdHNpZw",
+        )
+
+    monkeypatch.setattr(m, "mint_manifest", _mint)
+    monkeypatch.setattr(m, "fetch_intermediate", lambda: None)
+    monkeypatch.setattr(m, "close", lambda: None)
+    monkeypatch.setattr(m, "invalidate", lambda *_a, **_k: None)
+    return m
+
+
+LANES = ("followup", "verified", "pack", "bronze", "generative")
+
+
+def _stub_lane(monkeypatch: pytest.MonkeyPatch, lane: str, env: dict[str, Any]) -> None:
+    """Make one lane answer with ``env``. The lanes before it miss (return None)."""
+    names = {
+        "followup": "maybe_followup",
+        "verified": "maybe_verified_ask",
+        "pack": "maybe_pack_ask",
+        "generative": "maybe_generative_ask",
+    }
+    if lane == "bronze":
+        monkeypatch.setattr(pkg, "bronze_lane_table", lambda q: "bronze.sheet")
+        monkeypatch.setattr(pkg, "ingested_bronze_tables", lambda *a, **k: ("bronze.sheet",))
+        monkeypatch.setattr(pkg, "relation_gap", lambda *a, **k: None)
+        monkeypatch.setattr(pkg, "bronze_sheet_lane_enabled", lambda: True)
+        monkeypatch.setattr(pkg, "maybe_bronze_sheet_ask", lambda *a, **k: env)
+        return
+    monkeypatch.setattr(pkg, names[lane], lambda *a, **k: env)
+
+
+@pytest.mark.parametrize("lane", LANES)
+def test_every_live_ask_lane_is_gated_at_the_exit(
+    minter: ManifestMinter, monkeypatch: pytest.MonkeyPatch, lane: str
+) -> None:
+    """The lane built an answer over a table the Space does not hold."""
+    exe = Executor(cortex=FakeCortex(submits=[], asks=[]), minter=minter)  # type: ignore[arg-type]
+    _stub_lane(monkeypatch, lane, _env(UNGRANTED_SQL, [{"txn_id": 7}]))
+    out = exe.live_ask("zzq neutral question", space_id=OPS, session_id=f"ses_{lane}")
+    assert out["abstained"] is True, lane
+    assert out["rows"] == [], lane
+    assert out.get("abstain_reason") in {"space_acl", "ungranted"}, lane
+
+
+@pytest.mark.parametrize("lane", LANES)
+def test_every_live_ask_lane_granted_answer_stands(
+    minter: ManifestMinter, monkeypatch: pytest.MonkeyPatch, lane: str
+) -> None:
+    exe = Executor(cortex=FakeCortex(submits=[], asks=[]), minter=minter)  # type: ignore[arg-type]
