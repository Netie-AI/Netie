+def _apply_netie_acl(
+    resp: AskResponse,
+    *,
+    acl: SessionAcl,
+    space_id: str | None,
+) -> AskResponse:
+    """PRD-001 caller: Space-scoped live_ask goes through answer_or_abstain."""
+    from dms_executor.netie_acl import guard_live_answer
+
+    if resp.abstained:
+        return resp
+    granted = frozenset(acl.row_predicates)
+    warehouse_id = (acl.pool_id or "default").strip() or "default"
+    gate = guard_live_answer(
+        space_id=space_id,
+        granted=granted,
+        warehouse_id=warehouse_id,
+        sql=resp.sql_used,
+        rows=list(resp.rows or []),
+        route=resp.route,
+    )
+    if gate is None:
+        return resp
+    if gate.get("status") == "ABSTAIN":
+        return resp.model_copy(
+            update={
+                "abstained": True,
+                "badge": "abstain",
+                "rows": [],
+                "answer": gate.get("reason") or "Abstained.",
+                "sql_used": None,
+            }
+        )
+    return resp.model_copy(update={"rows": list(gate.get("rows") or [])})
+
