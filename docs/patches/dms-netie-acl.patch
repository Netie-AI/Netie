diff --git a/packages/executor/dms_executor/netie_acl.py b/packages/executor/dms_executor/netie_acl.py
new file mode 100644
index 0000000..b9cd0c1
--- /dev/null
+++ b/packages/executor/dms_executor/netie_acl.py
@@ -0,0 +1,506 @@
+"""live_ask and browse go through Netie Space ACL when installed.
+
+uv add git+https://github.com/Netie-AI/Netie.git
+from netie.dms import answer_or_abstain, browse_or_abstain
+
+dms package name is ``dms``, so that add does not collide. Cortex cannot do
+the same (it already owns ``netie`` as the CortexOS alias).
+
+Without Netie, the same rule runs locally so dms CI does not hard-fail.
+Minting still uses ``demo_acl`` / Space grants; this module is the answer and
+browse caller that PRD-001 asked for.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+Acl = Mapping[str, frozenset[str]]
+Binds = Mapping[str, str]
+
+MAX_ANSWER_CHARS = 12000
+DEMO_ALL_TABLES = frozenset({"inventory", "shipments", "invoices", "hr_notes"})
+_DOC_ROUTES = frozenset({"doc_rag", "document", "rag", "document_retrieval"})
+
+
+class SpaceDenied(PermissionError):
+    """Abstain. The Space cannot see that table (or does not exist)."""
+
+
+def _netie():
+    try:
+        from netie.dms import (  # type: ignore[import-not-found]
+            MAX_ANSWER_CHARS as _MAX,
+        )
+        from netie.dms import (
+            SpaceDenied as _Denied,
+        )
+        from netie.dms import (
+            answer_or_abstain as _answer,
+        )
+        from netie.dms import (
+            browse_or_abstain as _browse,
+        )
+        from netie.dms import (
+            mint_manifest as _mint,
+        )
+    except ImportError:
+        return None
+    return _answer, _browse, _mint, _Denied, _MAX
+
+
+def tables_for_space(acl: Acl, space_id: str) -> frozenset[str]:
+    if space_id not in acl:
+        raise SpaceDenied(f"unknown space {space_id}")
+    tables = acl[space_id]
+    if not tables:
+        raise SpaceDenied(f"empty space {space_id}")
+    return tables
+
+
+def warehouse_for_space(binds: Binds, space_id: str) -> str:
+    wid = (binds.get(space_id) or "").strip()
+    if not wid:
+        raise SpaceDenied(f"unbound space {space_id}")
+    return wid
+
+
+def may_read(acl: Acl, space_id: str, table: str) -> bool:
+    try:
+        return table in tables_for_space(acl, space_id)
+    except SpaceDenied:
+        return False
+
+
+def known_tables(acl: Acl) -> frozenset[str]:
+    names: set[str] = set(DEMO_ALL_TABLES)
+    for tables in acl.values():
+        names |= set(tables)
+    return frozenset(names)
+
+
+def sql_outside_grant(
+    sql: str, *, table: str, granted: frozenset[str], universe: frozenset[str]
+) -> str | None:
+    blob = (sql or "").lower()
+    asked = (table or "").strip().lower()
+    if not asked:
+        return "sql has no table"
+    if not re.search(rf"\b{re.escape(asked)}\b", blob):
+        return f"sql does not name {table}"
+    for name in universe:
+        if name.lower() == asked:
+            continue
+        if not re.search(rf"\b{re.escape(name.lower())}\b", blob):
+            continue
+        if name not in granted:
+            return f"sql names {name}"
+    return None
+
+
+def mint_manifest(acl: Acl, space_id: str) -> tuple[str, ...]:
+    imported = _netie()
+    if imported is not None:
+        return imported[2](acl, space_id)
+    granted = tables_for_space(acl, space_id)
+    if granted == DEMO_ALL_TABLES and space_id != "demo":
+        raise SpaceDenied("demo_acl leak")
+    return tuple(sorted(granted))
+
+
+def answer_or_abstain(
+    acl: Acl,
+    space_id: str,
+    table: str,
+    rows: list[dict],
+    *,
+    warehouse_id: str,
+    binds: Binds,
+    sql: str,
+    chat_mode: bool = False,
+    max_chars: int = MAX_ANSWER_CHARS,
+) -> dict:
+    imported = _netie()
+    if imported is not None:
+        return imported[0](
+            acl,
+            space_id,
+            table,
+            rows,
+            warehouse_id=warehouse_id,
+            binds=binds,
+            sql=sql,
+            chat_mode=chat_mode,
+            max_chars=max_chars,
+        )
+    if chat_mode:
+        return {
+            "status": "ABSTAIN",
+            "reason": "AnythingLLM overlay; warehouse answers need SQL",
+            "rows": [],
+        }
+    try:
+        bound = warehouse_for_space(binds, space_id)
+    except SpaceDenied as exc:
+        return {"status": "ABSTAIN", "reason": str(exc), "rows": []}
+    asked = (warehouse_id or "").strip()
+    if asked != bound:
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} bound to {bound}, asked {asked or 'none'}",
+            "rows": [],
+        }
+    if not (sql or "").strip():
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} answer has no SQL",
+            "rows": [],
+        }
+    if not may_read(acl, space_id, table):
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} cannot read {table}",
+            "rows": [],
+        }
+    granted = tables_for_space(acl, space_id)
+    leak = sql_outside_grant(
+        sql, table=table, granted=granted, universe=known_tables(acl)
+    )
+    if leak:
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} {leak}",
+            "rows": [],
+        }
+    cleaned: list[dict] = []
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+        declared = row.get("table") or row.get("_table")
+        if declared and declared != table:
+            return {
+                "status": "ABSTAIN",
+                "reason": f"space {space_id} cannot read {declared}",
+                "rows": [],
+            }
+        cleaned.append(dict(row))
+    budget = max_chars if max_chars > 0 else MAX_ANSWER_CHARS
+    blob = json.dumps(cleaned, separators=(",", ":"), default=str)
+    if len(blob) > budget:
+        return {
+            "status": "ABSTAIN",
+            "reason": "answer over DitchContext",
+            "rows": [],
+        }
+    return {
+        "status": "OK",
+        "table": table,
+        "warehouse_id": bound,
+        "sql": sql.strip(),
+        "rows": cleaned,
+    }
+
+
+def browse_or_abstain(
+    acl: Acl,
+    space_id: str,
+    table: str,
+    *,
+    tier: str,
+) -> dict:
+    imported = _netie()
+    if imported is not None:
+        return imported[1](acl, space_id, table, tier=tier)
+    name = (tier or "").strip().lower()
+    if name not in {"warehouse", "bronze"}:
+        return {
+            "status": "ABSTAIN",
+            "reason": f"bad browse tier {tier or 'none'}",
+            "rows": [],
+        }
+    if not may_read(acl, space_id, table):
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} cannot browse {table}",
+            "rows": [],
+        }
+    return {"status": "OK", "table": table, "tier": name}
+
+
+def infer_table(sql: str, granted: frozenset[str]) -> str:
+    blob = (sql or "").lower()
+    hits = [
+        name
+        for name in sorted(granted, key=len, reverse=True)
+        if re.search(rf"\b{re.escape(name.lower())}\b", blob)
+    ]
+    return hits[0] if hits else ""
+
+
+_LAKE_ALIAS = "warehouse_"
+
+
+def lake_alias_sql(sql: str, granted: frozenset[str]) -> str:
+    """Read Cortex's unqualified ``warehouse_<t>`` lake alias as ``<t>``.
+
+    dms NAME-ECHO-01 lets a served SQL cite a lake table by that alias. The
+    Space gate matches bare names, so the alias is rewritten for the gate
+    only: a granted table stands and an ungranted one is seen and abstains.
+    A grant that is itself spelled ``warehouse_<t>`` and a qualified name
+    stay as written.
+    """
+    own = {name.lower() for name in granted}
+
+    def bare(match: re.Match[str]) -> str:
+        return match.group(0) if match.group(0).lower() in own else match.group(1)
+
+    return re.sub(
+        rf"(?<![\w.]){_LAKE_ALIAS}(\w+)\b", bare, sql or "", flags=re.IGNORECASE
+    )
+
+
+#: Stands for a read the parse cannot call a plain table (a table function,
+#: a macro). No grant spells it, so the gate sees a relation it must refuse.
+NOT_A_TABLE = "<not a plain table>"
+
+
+def _relations_read(sql: str) -> tuple[str, ...]:
+    """Relations the statement reads, from dms's two parsers, unioned.
+
+    DuckDB's own parse (the engine that runs the text) sees ``TABLE t`` and
+    refuses table functions; the audit parser (sqlglot) covers SQL DuckDB
+    will not parse and a second statement. Each is the other's blind spot, so
+    the gate takes the union: more names, never fewer. Imported late so
+    ``netie_acl`` stays importable on its own. Nothing read returns ``()``,
+    which abstains.
+    """
+    found: dict[str, str] = {}
+    try:
+        from dms_executor.grant_struct import _duckdb_statements, duckdb_read_relations
+
+        parsed = _duckdb_statements(sql)
+        if not isinstance(parsed, str):
+            reads = duckdb_read_relations(parsed)
+            if reads is None:
+                found[NOT_A_TABLE.casefold()] = NOT_A_TABLE
+            else:
+                for parts in reads:
+                    label = ".".join(parts)
+                    found.setdefault(label.casefold(), label)
+    except Exception:  # noqa: BLE001 - the other parser still reads it
+        pass
+    try:
+        from dms_executor.sql_currency import tables_read_checked
+
+        labels, _approximate = tables_read_checked(sql)
+        for label in labels:
+            if label:
+                found.setdefault(label.casefold(), label)
+    except Exception:  # noqa: BLE001 - fail closed: what is left is all it reads
+        pass
+    return tuple(found.values())
+
+
+def _grant_for(label: str, granted: frozenset[str]) -> str | None:
+    """The grant entry that opens ``label``.
+
+    Three spellings open a grant, each one dms already honours:
+
+    * ``relation_gap``, the structural key ``serve_gap`` uses
+      (``other_schema.inventory`` does not open a grant on ``inventory``);
+    * Cortex's unqualified ``warehouse_<t>`` lake alias, for a demo-lake table
+      the Space grants (``name_echo`` owns that rule);
+    * ``bronze.<t>`` for a bare grant ``<t>``: an upload is granted by its bare
+      name and read through the bronze schema, which ``name_echo`` serves
+      (pinned by ``tests/test_name_echo_01.py``). Only the ``bronze`` schema and
+      only a bare grant; ``hr.<t>`` or a qualified grant opens nothing here.
+    """
+    from dms_executor.grant_struct import relation_gap
+    from dms_executor.name_echo import _dialect, _lake_alias_granted, _ungranted
+
+    parts = tuple(part for part in label.split(".") if part)
+    if not parts:
+        return None
+    ordered = sorted(granted, key=lambda g: (g.casefold() != label.casefold(), g))
+    for name in ordered:
+        if relation_gap(label, grantable={name}, dialect=_dialect()) is None:
+            return name
+    if len(parts) == 1 and _lake_alias_granted(parts, set(granted)):
+        lake = parts[0][len(_LAKE_ALIAS) :].casefold()
+        for name in ordered:
+            if name.casefold() in {lake, parts[0].casefold()}:
+                return name
+    if len(parts) == 2 and parts[0].casefold() == "bronze":
+        for name in ordered:
+            if "." not in name and not _ungranted([parts], {name}):
+                return name
+    return None
+
+
+def restate_relations(sql: str, granted: frozenset[str]) -> tuple[str, frozenset[str]]:
+    """``(gate_sql, outside)``: the statement restated as the relations it reads.
+
+    The Space gate matches table names by word boundary, so quoting
+    (``bronze."01_sales"``), a default schema or the ``warehouse_<t>`` lake
+    alias made a granted read look like no table at all. Each relation read is
+    restated under the grant entry that opens it. A relation no grant opens
+    keeps its own name and is returned in ``outside`` so the gate sees it.
+    Nothing read at all returns ``("", frozenset())`` and the gate abstains.
+    """
+    labels = _relations_read(sql or "")
+    if not labels:
+        return "", frozenset()
+    named: list[str] = []
+    outside: set[str] = set()
+    for label in labels:
+        grant = _grant_for(label, granted)
+        if grant is None:
+            outside.add(label)
+            named.append(label)
+        else:
+            named.append(grant)
+    return "SELECT 1 FROM " + ", ".join(dict.fromkeys(named)), frozenset(outside)
+
+
+def guard_live_answer(
+    *,
+    space_id: str | None,
+    granted: frozenset[str],
+    warehouse_id: str,
+    sql: str | None,
+    rows: list[dict[str, Any]] | None,
+    route: str | None,
+    chat_mode: bool = False,
+    max_chars: int | None = None,
+) -> dict[str, Any] | None:
+    """None means leave the response alone (no Space, or doc route).
+
+    Every executor path that returns source rows calls this one function.
+    """
+    if not space_id or not space_id.strip():
+        return None
+    route_l = (route or "").lower()
+    if route_l in _DOC_ROUTES:
+        return None
+    gate_sql, outside = restate_relations(sql or "", granted)
+    acl: dict[str, frozenset[str]] = {space_id: granted}
+    if outside:
+        # Not a Space: names the gate must see as "known, not granted".
+        acl["<outside>"] = outside
+    binds = {space_id: warehouse_id}
+    table = infer_table(gate_sql, granted)
+    extra: dict[str, Any] = {} if max_chars is None else {"max_chars": max_chars}
+    out = answer_or_abstain(
+        acl,
+        space_id,
+        table,
+        list(rows or []),
+        warehouse_id=warehouse_id,
+        binds=binds,
+        sql=gate_sql,
+        chat_mode=chat_mode,
+        **extra,
+    )
+    if out.get("status") == "OK" and outside:
+        # A name the word-boundary scan cannot see (odd characters) still
+        # abstains: the parser found a relation no grant opens.
+        return {
+            "status": "ABSTAIN",
+            "reason": f"space {space_id} reads a relation it is not granted",
+            "rows": [],
+        }
+    return out
+
+
+def guard_browse(
+    *,
+    space_id: str | None,
+    table: str,
+    tier: str,
+    granted: frozenset[str],
+) -> dict[str, Any] | None:
+    if not space_id or not space_id.strip():
+        return None
+    bare = (table or "").strip()
+    if "." in bare:
+        bare = bare.rsplit(".", 1)[-1]
+    if bare.lower().startswith("bronze:"):
+        bare = bare.split(":", 1)[-1]
+    return browse_or_abstain({space_id: granted}, space_id, bare, tier=tier)
+
+
+_REFUSED_TEXT = (
+    "I can't answer this: the Space's access rule stopped the query behind "
+    "this answer. No figure was returned."
+)
+
+
+def guard_envelope(
+    env: dict[str, Any],
+    *,
+    granted: Iterable[str] | None,
+    space_id: str | None,
+    question: str = "",
+    warehouse_id: str = "default",
+) -> dict[str, Any]:
+    """Run an answer envelope through ``guard_live_answer``.
+
+    One entry for every executor path that returns source rows (live_ask, user
+    SQL, a confirmed held SQL, the demo ask). Returns ``env`` when the answer
+    stands (rows copied by the gate), or a built abstain envelope: the caller
+    sees ``abstained: true``, never a silent drop of rows. The abstain text
+    names no table; the gate's reason rides on the ticket only.
+
+    Left alone: no Space, an envelope that already abstains, and an envelope
+    with neither SQL nor rows (nothing source-derived to gate).
+    """
+    if not (space_id or "").strip() or not isinstance(env, dict):
+        return env
+    if env.get("abstained") is True or str(env.get("badge") or "").upper() == "ABSTAIN":
+        return env
+    sql = env.get("sql_used")
+    rows = env.get("rows")
+    has_sql = isinstance(sql, str) and bool(sql.strip())
+    if not has_sql and not rows:
+        return env
+    gate = guard_live_answer(
+        space_id=space_id,
+        granted=frozenset(granted or ()),
+        warehouse_id=warehouse_id,
+        sql=sql if has_sql else None,
+        rows=list(rows) if isinstance(rows, list) else [],
+        route=str(env.get("route") or ""),
+    )
+    if gate is None:
+        return env
+    if gate.get("status") != "ABSTAIN":
+        if isinstance(rows, list):
+            env["rows"] = list(gate.get("rows") or [])
+        return env
+    from dms_executor.abstain import build_abstain
+    from dms_executor.envelope import assert_envelope_valid
+
+    out = build_abstain(
+        reason="space_acl: " + str(gate.get("reason") or "refused"),
+        question=question,
+        sql=sql if has_sql else None,
+        stage="served_sql",
+        answer_id=str(env.get("answer_id") or "ans_space_acl"),
+        text=_REFUSED_TEXT,
+        values=[],
+        rows=[],
+        sql_used=None,
+        assumptions=["Space access rule refused the query behind this answer"],
+        abstain_reason="space_acl",
+        audit_id=env.get("audit_id"),
+        as_of=env.get("as_of"),
+        space_id=env.get("space_id") or space_id,
+        session_id=env.get("session_id"),
+        ask_mode=str(env.get("ask_mode") or "live"),
+        route=env.get("route"),
+    )
+    assert_envelope_valid(out)
+    return out
