+
+test("verify path ranks generator-verifier first", () => {
+  const ranked = rankForKinds(["hypothesize", "audit"]);
+  assert.equal(ranked[0].id, "generator_verifier");
+});
+
+test("ghost is false when unset", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in" }],
+    edges: [],
+  });
+  assert.equal(ir.ghost, false);
+  assert.equal(ir.error, undefined);
+});
+
+test("empty graph does not invent Cortex nodes", () => {
+  const ir = compileIR({ nodes: [], edges: [] });
+  assert.equal(ir.engine, "cortex");
+  assert.equal(ir.error, "empty graph");
+  assert.deepEqual(ir.nodes, []);
+  assert.equal(ir.entry_node_id, null);
+});
