+def test_v1_skill_body_is_400_not_key_walk(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="skill-body-seat")
+    resp = client.post(
+        "/v1/chat/completions",
+        json={
+            "model": "gpt-4",
+            "messages": [{"role": "user", "content": "hi"}],
+            "skill_body": "SECRET prompt",
+        },
+        headers=headers,
+    )
+    assert resp.status_code == 400
+    assert resp.json()["error"]["type"] == "openvault_crew_body"
+    assert "skill_body" in resp.json()["error"]["message"]
+
+
+def test_v1_combo_transcript_is_400(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="transcript-seat")
+    resp = client.post(
