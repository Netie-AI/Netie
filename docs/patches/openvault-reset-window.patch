diff --git a/OpenMW/tests/test_route_strategies.py b/OpenMW/tests/test_route_strategies.py
index 12d5285..44cf70c 100644
--- a/OpenMW/tests/test_route_strategies.py
+++ b/OpenMW/tests/test_route_strategies.py
@@ -150,3 +150,20 @@ def test_headroom_missing_util_is_full() -> None:
     ordered = apply_strategy("headroom", targets)
     assert ordered[0].execution_key in {"b", "c"}
     assert ordered[-1].execution_key == "a"
+
+
+def test_reset_window_soonest_first() -> None:
+    targets = _targets()
+    targets[0].reset_remaining_ms = 60_000
+    targets[1].reset_remaining_ms = 5_000
+    targets[2].reset_remaining_ms = 30_000
+    ordered = apply_strategy("reset-window", targets)
+    assert [t.execution_key for t in ordered] == ["b", "c", "a"]
+
+
+def test_reset_window_unknown_sorts_last() -> None:
+    targets = _targets()
+    targets[1].reset_remaining_ms = 1_000
+    ordered = apply_strategy("reset-window", targets)
+    assert ordered[0].execution_key == "b"
+    assert [t.execution_key for t in ordered[1:]] == ["a", "c"]
