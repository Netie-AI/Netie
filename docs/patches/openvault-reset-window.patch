 }
 
 
@@ -142,4 +144,17 @@ def apply_strategy(
         decorated.sort(key=lambda pair: (-_headroom(pair[1]), pair[0]))
         return [t for _, t in decorated]
 
+    if strategy == "reset-window":
+        # Algorithm port of OmniRoute soonest-reset-first. No quota fetch.
+        # Unknown remaining_ms sorts last. Tie-band rotation is not ported.
+        def _remaining(t: RouteTarget) -> float:
+            value = t.reset_remaining_ms
+            if value is None:
+                return float("inf")
+            return max(0.0, value)
+
+        decorated = list(enumerate(targets))
+        decorated.sort(key=lambda pair: (_remaining(pair[1]), pair[0]))
+        return [t for _, t in decorated]
+
     return list(targets)
