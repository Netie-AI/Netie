-"""Combo routing strategies — 12 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
+"""Combo routing strategies — 13 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
 
 from __future__ import annotations
 
@@ -30,6 +30,8 @@ STRATEGY_ALIASES: dict[str, StrategyName] = {
     "context-optimized": "context-optimized",
     "context_optimized": "context-optimized",
     "headroom": "headroom",
