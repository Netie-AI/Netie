diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index cfd5350..db16b19 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -99,3 +99,26 @@ test("dangling edge does not invent a node", () => {
   assert.equal(ir.error, "dangling edge");
   assert.deepEqual(ir.nodes, []);
 });
+
+test("missing id does not invent a Cortex node", () => {
+  const ir = compileIR({
+    nodes: [{ kind: "connector", note: "no id" }],
+    edges: [],
+  });
+  assert.equal(ir.error, "missing id");
+  assert.deepEqual(ir.nodes, []);
+  assert.equal(ir.entry_node_id, null);
+});
+
+test("duplicate id does not emit a fake Kahn walk", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "a", kind: "connector" },
+      { id: "a", kind: "ontology" },
+    ],
+    edges: [],
+  });
+  assert.equal(ir.error, "duplicate id: a");
+  assert.deepEqual(ir.nodes, []);
+  assert.equal(ir.entry_node_id, null);
+});
