diff --git a/test/netie-observe.test.js b/test/netie-observe.test.js
new file mode 100644
index 0000000..4ad212b
--- /dev/null
+++ b/test/netie-observe.test.js
@@ -0,0 +1,115 @@
+"use strict";
+const assert = require("assert");
+const { PointerDenied, guardObserve } = require("../electron/netie/netie_hands");
+const { computerObserve } = require("../electron/netie/uacc");
+
+let pass = 0;
+const fails = [];
+function test(name, fn) {
+  try {
+    fn();
+    pass += 1;
+    console.log("PASS " + name);
+  } catch (err) {
+    fails.push(name);
+    console.log("FAIL " + name + " -- " + err.message);
+  }
+}
+
+test("default observe still publishes PNG and clipboard (DR-0005)", () => {
+  const obs = computerObserve({
+    captureVisible: true,
+    screenshot: "data:image/png;base64,AAA",
+    clipboard: "paste me",
+  });
+  assert.strictEqual(obs.screenshot.present, true);
+  assert.strictEqual(obs.screenshot.dataUrl, "data:image/png;base64,AAA");
+  assert.strictEqual(obs.clipboard.present, true);
+  assert.strictEqual(obs.clipboard.text, "paste me");
+  assert.ok(!obs.governed);
+});
+
+test("default observe still lists windows", () => {
+  const obs = computerObserve({
+    captureVisible: true,
+    uacc: { installed: false },
+    foreground: { hwnd: "42", title: "Untitled - Notepad", proc: "notepad", x: 100, y: 200, width: 640, height: 480 },
+    windows: [
+      { hwnd: "42", title: "Untitled - Notepad", proc: "notepad", x: 100, y: 200, width: 640, height: 480 },
+    ],
+  });
+  assert.strictEqual(obs.foreground.title, "Untitled - Notepad");
+  assert.strictEqual(obs.windows.length, 1);
+});
+
+test("governed observe needs Cortex allow and intent", () => {
+  assert.throws(
+    () => computerObserve({ governed: true }),
+    (err) => err instanceof PointerDenied && /no Cortex allow/.test(err.message)
+  );
+  assert.throws(
+    () => computerObserve({ governed: true, cortexAllowed: true }),
+    (err) => /no Cortex intent/.test(err.message)
+  );
+  const ok = computerObserve({
+    governed: true,
+    cortexAllowed: true,
+    cortexIntent: "hud check",
+  });
+  assert.strictEqual(ok.ok, true);
+  assert.strictEqual(ok.governed, true);
+  assert.strictEqual(ok.screenshot, null);
+  assert.strictEqual(ok.clipboard, null);
+});
+
+test("governed observe refuses uncropped PNG clipboard windows", () => {
+  assert.throws(
+    () =>
+      computerObserve({
+        governed: true,
+        cortexAllowed: true,
+        cortexIntent: "see",
+        screenshot: "data:image/png;base64,AAA",
+      }),
+    (err) => /screenshot_uncropped/.test(err.message)
+  );
+  assert.throws(
+    () =>
+      computerObserve({
+        governed: true,
+        cortexAllowed: true,
+        cortexIntent: "paste",
+        clipboard: "secret",
+      }),
+    (err) => /clipboard/.test(err.message)
+  );
+  assert.throws(
+    () =>
+      computerObserve({
+        governed: true,
+        cortexAllowed: true,
+        cortexIntent: "titles",
+        windows: [{ title: "1Password" }],
+      }),
+    (err) => /window_dump/.test(err.message)
+  );
+});
+
+test("governed crop confirms without returning pixels", () => {
+  const out = guardObserve({
+    cortexAllowed: true,
+    cortexIntent: "crop Save",
+    screenshot: "data:image/png;base64,AAA",
+    crop: { role: "button", name: "Save" },
+  });
+  assert.strictEqual(out.crop, true);
+  assert.strictEqual(out.clicked, "Save");
+  assert.strictEqual(out.screenshot.cropped, true);
+  assert.ok(!out.screenshot.dataUrl);
+});
+
+if (fails.length) {
+  console.error("FAILED " + fails.length + ": " + fails.join(", "));
+  process.exit(1);
+}
+console.log("ok " + pass + " passed");
