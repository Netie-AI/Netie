+"use strict";
+/**
+ * UACC names behind Cortex. Pointer is hands, not a second brain.
+ *
+ * Mirrors Netie `scripts/pointer_hands.py` / `from netie.pointer import invoke_hand`.
+ * Does not import the `uacc` package. Planner / clipboard / window dump /
+ * uncropped screenshot / hosted computers refuse. Native computer.observe
+ * (DR-0005 loopback) stays Pointer's own API.
+ */
+
+const BRAIN = new Set([
+  "uacc_planner",
+  "uacc_query",
+  "uacc_expect",
+  "create_workflow",
+  "list_workflows",
+  "get_workflow",
+  "delete_workflow",
+  "run_workflow",
+  "start_task",
+  "get_task_status",
+  "cancel_task",
+  "list_tasks",
+  "remember_action",
+  "get_action_history",
+  "query_knowledge",
+  "recall_related_apps",
+  "memory_summary",
+  "app_action_history",
+  "vlm_analyze",
+  "execute_actions",
+]);
+
+const SECRET = new Set(["clipboard_read", "clipboard_write", "uacc_clipboard_read"]);
+const WINDOW = new Set(["list_windows", "get_active_window", "uacc_list_windows", "uacc_active_window"]);
+const PROCESS = new Set(["list_processes", "get_system_info"]);
+const OVERRIDE = new Set(["acknowledge_user_override", "set_kill_distance"]);
+const HOSTED = new Set([
+  "e2b",
+  "open-computer-use",
+  "open_computer_use",
+  "perplexity-computer",
+  "perplexity_computer",
+  "hosted-desktop",
+  "hosted_desktop",
+]);
+
+class PointerDenied extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "PointerDenied";
+  }
+}
+
+function toolName(skill) {
+  if (!skill) return "";
+  if (typeof skill === "string") return skill.trim();
+  return String(skill.uacc || skill.id || "").trim();
+}
+
+function isAlwaysRefused(name) {
+  const tool = toolName(name);
+  if (!tool) return true;
+  if (BRAIN.has(tool) || BRAIN.has(tool.replace(/^uacc_/, ""))) return true;
+  if (SECRET.has(tool)) return true;
+  if (WINDOW.has(tool)) return true;
+  if (PROCESS.has(tool)) return true;
+  if (OVERRIDE.has(tool)) return true;
+  return false;
+}
+
+function refuseReason(name) {
+  const tool = toolName(name);
+  if (BRAIN.has(tool) || BRAIN.has(tool.replace(/^uacc_/, "")) || tool === "uacc_planner") {
+    return "uacc brain stays out; Pointer is hands";
+  }
+  if (SECRET.has(tool)) return "no clipboard";
+  if (WINDOW.has(tool)) return "window_dump_refused";
+  if (tool === "get_system_info") return "env_dump_refused";
+  if (PROCESS.has(tool)) return "process_list_refused";
+  if (OVERRIDE.has(tool)) return "uacc override stays out; Cortex is the gate";
+  return "no Cortex allow";
+}
+
+function filterExecutableSkills(skills) {
+  return (Array.isArray(skills) ? skills : []).filter((s) => !isAlwaysRefused(s));
+}
+
+function invokeHand(name, opts = {}) {
+  const tool = toolName(name);
+  if (!tool) throw new PointerDenied("unknown hand none");
+  if (isAlwaysRefused(tool)) throw new PointerDenied(refuseReason(tool));
+  if (opts.cortexAllowed !== true) throw new PointerDenied("no Cortex allow");
+  if (!String(opts.cortexIntent || "").trim()) throw new PointerDenied("no Cortex intent");
+  return { hand: tool, intent: String(opts.cortexIntent).trim(), status: "allowed" };
+}
+
+function bindComputer(vendor) {
+  const name = String(vendor || "")
+    .trim()
+    .toLowerCase()
+    .replace(/ /g, "-")
+    .replace(/_/g, "-");
+  if (!name) throw new PointerDenied("unknown computer none");
+  if (name.includes("e2b") || name.includes("perplexity") || HOSTED.has(name) || HOSTED.has(String(vendor || ""))) {
+    throw new PointerDenied("Pointer is a local tray, not a hosted computer");
+  }
+  if (name === "uacc" || name === "pointer") return { vendor: name, where: "local" };
+  throw new PointerDenied(`unknown computer ${vendor}`);
+}
+
+module.exports = {
+  PointerDenied,
+  BRAIN,
+  SECRET,
+  WINDOW,
+  isAlwaysRefused,
+  refuseReason,
+  filterExecutableSkills,
+  invokeHand,
+  bindComputer,
+  toolName,
+};
