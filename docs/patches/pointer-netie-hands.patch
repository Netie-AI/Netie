diff --git a/test/netie-hands.test.js b/test/netie-hands.test.js
new file mode 100644
index 0000000..f47fb2e
--- /dev/null
+++ b/test/netie-hands.test.js
@@ -0,0 +1,92 @@
+"use strict";
+const assert = require("assert");
+const {
+  PointerDenied,
+  isAlwaysRefused,
+  filterExecutableSkills,
+  invokeHand,
+  bindComputer,
+} = require("../electron/netie/netie_hands");
+const { UACC_SKILLS, searchUaccSkills, computerStatus } = require("../electron/netie/uacc");
+
+let pass = 0;
+const fails = [];
+function test(name, fn) {
+  try {
+    fn();
+    pass += 1;
+    console.log("PASS " + name);
+  } catch (err) {
+    fails.push(name);
+    console.log("FAIL " + name + " -- " + err.message);
+  }
+}
+
+test("planner clipboard windows are not executable search hits", () => {
+  const hits = searchUaccSkills("uacc planner clipboard list windows");
+  const ids = hits.map((h) => h.id);
+  assert.ok(!ids.includes("uacc_planner"));
+  assert.ok(!ids.includes("uacc_clipboard_read"));
+  assert.ok(!ids.includes("uacc_list_windows"));
+  assert.ok(!ids.includes("uacc_active_window"));
+  assert.ok(!ids.includes("uacc_query"));
+});
+
+test("screen-info and find-element stay searchable hands", () => {
+  const hits = searchUaccSkills("get screen info with uacc");
+  assert.ok(hits.some((h) => h.id === "uacc_screen_info"));
+  assert.ok(hits.every((h) => h.source === "uacc-skill"));
+  assert.ok(!hits.some((h) => h.id === "uacc_planner"));
+});
+
+test("catalog still names planner; status.skills drop it", () => {
+  assert.ok(UACC_SKILLS.some((s) => s.id === "uacc_planner"));
+  const shown = computerStatus({ captureVisible: true, uacc: { installed: false } });
+  assert.ok(!shown.uacc.skills.includes("uacc_planner"));
+  assert.ok(shown.uacc.refused.includes("uacc_planner"));
+  assert.ok(shown.uacc.skills.includes("uacc_screen_info"));
+  assert.ok(shown.uacc.skills.includes("uacc_find_element"));
+});
+
+test("invokeHand refuses brain without executing", () => {
+  assert.throws(
+    () => invokeHand("uacc_planner", { cortexAllowed: true, cortexIntent: "plan" }),
+    (err) => err instanceof PointerDenied && /brain/.test(err.message)
+  );
+  assert.throws(
+    () => invokeHand("clipboard_read", { cortexAllowed: true, cortexIntent: "copy" }),
+    (err) => /clipboard/.test(err.message)
+  );
+  assert.throws(
+    () => invokeHand("list_windows", { cortexAllowed: true, cortexIntent: "see" }),
+    (err) => /window_dump/.test(err.message)
+  );
+});
+
+test("invokeHand needs Cortex allow and intent", () => {
+  assert.throws(() => invokeHand("find_element"), (err) => /no Cortex allow/.test(err.message));
+  assert.throws(
+    () => invokeHand("find_element", { cortexAllowed: true }),
+    (err) => /no Cortex intent/.test(err.message)
+  );
+  const ok = invokeHand("find_element", { cortexAllowed: true, cortexIntent: "locate Save" });
+  assert.strictEqual(ok.status, "allowed");
+  assert.strictEqual(ok.hand, "find_element");
+});
+
+test("bindComputer is a local tray", () => {
+  assert.deepStrictEqual(bindComputer("uacc"), { vendor: "uacc", where: "local" });
+  assert.deepStrictEqual(bindComputer("pointer"), { vendor: "pointer", where: "local" });
+  assert.throws(() => bindComputer("e2b"), (err) => /hosted computer/.test(err.message));
+  assert.throws(() => bindComputer("perplexity-computer"), (err) => /hosted computer/.test(err.message));
+  assert.ok(isAlwaysRefused("uacc_planner"));
+  const kept = filterExecutableSkills(UACC_SKILLS).map((s) => s.id);
+  assert.ok(kept.includes("uacc_smart_click"));
+  assert.ok(!kept.includes("uacc_clipboard_read"));
+});
+
+if (fails.length) {
+  console.error("FAILED " + fails.length + ": " + fails.join(", "));
+  process.exit(1);
+}
+console.log("ok " + pass + " passed");
