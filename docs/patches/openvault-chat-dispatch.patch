+
+def test_dispatch_combo_fusion() -> None:
+    seen: list[str] = []
+
+    def call(model: str, **_k):
+        seen.append(model)
+        return f"ans-{model}"
+
+    out = dispatch_combo(
+        "fusion", ["p/a", "p/b"], call, user_text="Q", judge_model="p/judge"
+    )
+    assert seen == ["p/a", "p/b", "p/judge"]
+    assert out == "ans-p/judge"
