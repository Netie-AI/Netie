diff --git a/engine.js b/engine.js
index d458e22..163a6cd 100644
--- a/engine.js
+++ b/engine.js
@@ -92,6 +92,28 @@ function objectForSetPoint(objectType, objects) {
   return listedOrEmpty(objectType, listed);
 }
 
+function applyObjectType(node, value, objects) {
+  if (!node || typeof node !== "object") return node;
+  const listed = objects && typeof objects === "object" ? Object.keys(objects) : [];
+  const ot = listedOrEmpty(value, listed);
+  node.object_type = ot;
+  if (!ot) {
+    node.data_point = "";
+    node.data_type = "";
+    return node;
+  }
+  const catalog = objects[ot] && objects[ot].points ? objects[ot].points : {};
+  const point = listedOrEmpty(node.data_point, Object.keys(catalog));
+  if (!point) {
+    node.data_point = "";
+    node.data_type = "";
+    return node;
+  }
+  node.data_point = point;
+  node.data_type = catalog[point] || "";
+  return node;
+}
