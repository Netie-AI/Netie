+
+test("applyObjectType does not invent the first data_point", () => {
+  const objects = {
+    inventory: { points: { sku: "string", sku_name: "string" } },
+    suppliers: { points: { supplier_id: "string" } },
+  };
+  const node = { object_type: "", data_point: "", data_type: "" };
+  applyObjectType(node, "inventory", objects);
+  assert.equal(node.object_type, "inventory");
+  assert.equal(node.data_point, "");
+  assert.equal(node.data_type, "");
+});
+
+test("applyObjectType keeps a data_point still listed on the new object", () => {
+  const objects = {
+    inventory: { points: { sku: "string", supplier_id: "string" } },
+    suppliers: { points: { supplier_id: "string" } },
+  };
+  const node = {
+    object_type: "inventory",
+    data_point: "supplier_id",
+    data_type: "string",
+  };
+  applyObjectType(node, "suppliers", objects);
+  assert.equal(node.object_type, "suppliers");
+  assert.equal(node.data_point, "supplier_id");
+  assert.equal(node.data_type, "string");
+});
+
+test("applyObjectType clears a data_point not on the new object", () => {
+  const objects = {
+    inventory: { points: { sku: "string" } },
+    suppliers: { points: { supplier_id: "string" } },
+  };
+  const unlabeled = {
+    object_type: "inventory",
+    data_point: "sku",
+    data_type: "string",
+  };
+  applyObjectType(unlabeled, "suppliers", objects);
+  assert.equal(unlabeled.object_type, "suppliers");
+  assert.equal(unlabeled.data_point, "");
+  assert.equal(unlabeled.data_type, "");
+  applyObjectType(unlabeled, "hr_notes", objects);
+  assert.equal(unlabeled.object_type, "");
+  assert.equal(unlabeled.data_point, "");
+});
