diff --git a/OpenMW/tests/test_route_strategies.py b/OpenMW/tests/test_route_strategies.py
index 3623399..12d5285 100644
--- a/OpenMW/tests/test_route_strategies.py
+++ b/OpenMW/tests/test_route_strategies.py
@@ -119,3 +119,34 @@ def test_lkgp_failure_of_sticky_clears_pin() -> None:
     ordered = apply_strategy("lkgp", _targets(), metrics=metrics)
     assert [t.execution_key for t in ordered] == ["a", "b", "c"]
     assert metrics.last_success_key is None
+
+
+def test_context_optimized_largest_window_first() -> None:
+    targets = _targets()
+    targets[0].context_window = 8_000
+    targets[1].context_window = 128_000
+    targets[2].context_window = 32_000
+    ordered = apply_strategy("context-optimized", targets)
+    assert [t.execution_key for t in ordered] == ["b", "c", "a"]
+
+
+def test_context_optimized_unknown_leaves_order() -> None:
+    ordered = apply_strategy("context-optimized", _targets())
+    assert [t.execution_key for t in ordered] == ["a", "b", "c"]
+
+
+def test_headroom_most_free_first() -> None:
+    targets = _targets()
+    targets[0].util_5h, targets[0].util_7d = 0.9, 0.1
+    targets[1].util_5h, targets[1].util_7d = 0.1, 0.1
+    targets[2].util_5h, targets[2].util_7d = 0.5, 0.8
+    ordered = apply_strategy("headroom", targets)
+    assert [t.execution_key for t in ordered] == ["b", "c", "a"]
+
+
+def test_headroom_missing_util_is_full() -> None:
+    targets = _targets()
+    targets[0].util_5h, targets[0].util_7d = 0.5, 0.5
+    ordered = apply_strategy("headroom", targets)
+    assert ordered[0].execution_key in {"b", "c"}
+    assert ordered[-1].execution_key == "a"
