diff --git a/OpenMW/openmw/openvault/route/strategies.py b/OpenMW/openmw/openvault/route/strategies.py
index c6bf90e..d039d54 100644
--- a/OpenMW/openmw/openvault/route/strategies.py
+++ b/OpenMW/openmw/openvault/route/strategies.py
@@ -1,4 +1,4 @@
-"""Combo routing strategies — 10 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
+"""Combo routing strategies — 12 of 19 user-facing for pass 1 (+ OmniRoute quota-share internal, not ported)."""
 
 from __future__ import annotations
 
@@ -27,6 +27,9 @@ STRATEGY_ALIASES: dict[str, StrategyName] = {
     "strict-random": "strict-random",
     "strict_random": "strict-random",
     "lkgp": "lkgp",
+    "context-optimized": "context-optimized",
+    "context_optimized": "context-optimized",
+    "headroom": "headroom",
 }
 
 
@@ -106,4 +109,37 @@ def apply_strategy(
                 return [chosen, *rest]
         return list(targets)
 
+    if strategy == "context-optimized":
+        # Algorithm port of OmniRoute largest-window first. No model catalog.
+        if not any(t.context_window is not None for t in targets):
+            return list(targets)
+        decorated = list(enumerate(targets))
+        decorated.sort(
+            key=lambda pair: (
+                pair[1].context_window is None,
+                -(pair[1].context_window or 0),
+                pair[0],
+            )
+        )
+        return [t for _, t in decorated]
+
+    if strategy == "headroom":
+        # Algorithm port of OmniRoute rankByHeadroom. No 5h/7d provider fetch.
+        # headroom = 1 - max(util_5h, util_7d); missing util = 0 (full headroom).
+        def _clamp(value: float | None) -> float:
+            if value is None:
+                return 0.0
+            if value <= 0:
+                return 0.0
+            if value >= 1:
+                return 1.0
+            return value
+
+        def _headroom(t: RouteTarget) -> float:
+            return 1.0 - max(_clamp(t.util_5h), _clamp(t.util_7d))
+
+        decorated = list(enumerate(targets))
+        decorated.sort(key=lambda pair: (-_headroom(pair[1]), pair[0]))
+        return [t for _, t in decorated]
+
     return list(targets)
