+def test_v1_fusion_unknown_model_is_503_not_first_choice(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    rec = vault.create(
+        label="openai-unknown",
+        provider="openai",
+        secret="sk-test-unknown-aaaaaaaa",
+        role="primary",
+        priority=1,
+        base_url="https://example.invalid/v1",
+    )
+    vault.set_precheck(rec.id, status="ok", latency_ms=1.0, error=None)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="unknown-model-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("nope")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "fusion",
+                    "models": ["not-a-real-model"],
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 503, resp.text
+    assert "no hop can serve model" in resp.json()["error"]["message"]
+    assert mock.post.call_count == 0
+
+
