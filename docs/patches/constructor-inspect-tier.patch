diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index caaf44b..2b46e99 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -250,3 +250,31 @@ test("inspect does not invent inventory for a missing object", () => {
   assert.deepEqual(listedOptions(objects, ""), ["", "inventory", "shipments"]);
   assert.deepEqual(listedOptions(objects, "inventory"), objects);
 });
+
+test("compileIR does not invent T0 for a missing tier", () => {
+  const unlabeled = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in" }],
+    edges: [],
+  });
+  assert.equal(unlabeled.error, undefined);
+  assert.equal(unlabeled.nodes[0].tier, null);
+  const kept = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in", tier: "T1" }],
+    edges: [],
+  });
+  assert.equal(kept.nodes[0].tier, "T1");
+  const garbage = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in", tier: "T9" }],
+    edges: [],
+  });
+  assert.equal(garbage.nodes[0].tier, null);
+});
+
+test("inspect does not invent T0 for a missing tier", () => {
+  const tiers = ["T0", "T1"];
+  assert.equal(listedOrEmpty("", tiers), "");
+  assert.equal(listedOrEmpty("nope", tiers), "");
+  assert.equal(listedOrEmpty("T0", tiers), "T0");
+  assert.deepEqual(listedOptions(tiers, ""), ["", "T0", "T1"]);
+  assert.deepEqual(listedOptions(tiers, "T0"), tiers);
+});
