@@ -250,3 +250,21 @@ test("inspect does not invent inventory for a missing object", () => {
   assert.deepEqual(listedOptions(objects, ""), ["", "inventory", "shipments"]);
   assert.deepEqual(listedOptions(objects, "inventory"), objects);
 });
+
+test("inspect does not invent T0 for a missing tier", () => {
+  const tiers = ["T0", "T1"];
+  assert.equal(listedOrEmpty("", tiers), "");
+  assert.equal(listedOrEmpty("nope", tiers), "");
+  assert.equal(listedOrEmpty("T0", tiers), "T0");
+  assert.deepEqual(listedOptions(tiers, ""), ["", "T0", "T1"]);
+  assert.deepEqual(listedOptions(tiers, "T0"), tiers);
+});
+
+test("compileIR does not invent T0 for a missing tier", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.nodes[0].tier, null);
+});
