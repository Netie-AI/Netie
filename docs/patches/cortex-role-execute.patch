@@ -87,6 +87,14 @@ def test_invalid_key_rejected(dms_client, api_keys_env):
     assert res.status_code == 401
 
 
+def test_execute_modules_require_a_key(dms_client):
+    """TAS-CORTEX: app_routes / dag_run / dms_query / chat_routes were missing RBAC."""
+    assert dms_client.post("/dms/query", json={"question": "x"}).status_code == 401
+    assert dms_client.post("/run", json={"dag": {"nodes": []}}).status_code == 401
+    assert dms_client.post("/api/apps/import", json={"zip_base64": "QUFB"}).status_code == 401
+    assert dms_client.post("/dms/threads", json={}).status_code == 401
+
+
 def test_rate_limit_429(dms_client, api_keys_env, monkeypatch):
     reset_limiter(per_minute=2)
     headers = {"X-API-Key": api_keys_env["viewer"]}
