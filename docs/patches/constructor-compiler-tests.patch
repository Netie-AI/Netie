diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
new file mode 100644
index 0000000..de9fd5c
--- /dev/null
+++ b/tests/compiler.test.cjs
@@ -0,0 +1,45 @@
+"use strict";
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  compileIR,
+  rankForKinds,
+  topo,
+} = require("../engine.js");
+
+test("foundry path ranks orchestrator-subagent first", () => {
+  const ranked = rankForKinds(["connector", "ontology", "insight", "foundry", "app"]);
+  assert.equal(ranked[0].id, "orchestrator_subagent");
+});
+
+test("compileIR emits Cortex kinds and marks the app node EMIT", () => {
+  const ir = compileIR({
+    ghost: true,
+    nodes: [
+      { id: "c", kind: "connector", note: "in" },
+      { id: "o", kind: "ontology", note: "types" },
+      { id: "a", kind: "app", note: "out" },
+    ],
+    edges: [
+      { from: "c", to: "o" },
+      { from: "o", to: "a" },
+    ],
+  });
+  assert.equal(ir.engine, "cortex");
+  assert.equal(ir.ghost, true);
+  assert.equal(ir.output_node_id, "a");
+  assert.equal(ir.nodes.find((n) => n.id === "a").kind, "EMIT");
+  assert.equal(ir.nodes.find((n) => n.id === "c").kind, "DOCUMENT_REF");
+});
+
+test("topo lists sources before sinks", () => {
+  const order = topo({
+    nodes: [{ id: "a" }, { id: "b" }, { id: "c" }],
+    edges: [
+      { from: "a", to: "b" },
+      { from: "b", to: "c" },
+    ],
+  });
+  assert.deepEqual(order, ["a", "b", "c"]);
+});
