+"use strict";
+
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+// One compiler: core/constructor.js. Strict mode is how Netie callers (engine.js, the
+// Cortex POST bodies) invoke it. Loading core first also sets globalThis.NetieConstructorCore,
+// which engine.js needs for bindWhenReady.
+const Core = require("../core/constructor.js");
+const {
+  rankForKinds,
+  listedOrEmpty,
+  listedOptions,
+  objectForSetPoint,
+  applyObjectType,
+  nodesWithoutNotes,
+} = Core;
+const compileIR = (state) => Core.compileIR(state, { strict: true });
+const topo = (state) => Core.topo(state, { strict: true });
+const ghostWalk = (state, ghost) => Core.walkIR(state, ghost);
+const cortexPayload = (state) => Core.cortexPayload(state);
+const { bindWhenReady } = require("../engine.js");
+const fs = require("node:fs");
+const path = require("node:path");
+
+test("foundry path ranks orchestrator-subagent first", () => {
+  const ranked = rankForKinds(["connector", "ontology", "insight", "foundry", "app"]);
+  assert.equal(ranked[0].id, "orchestrator_subagent");
+});
+
+test("compileIR emits Cortex kinds and marks the app node EMIT", () => {
+  const ir = compileIR({
+    ghost: true,
+    nodes: [
+      { id: "c", kind: "connector", note: "in" },
+      { id: "o", kind: "ontology", note: "types" },
+      { id: "a", kind: "app", note: "out" },
+    ],
+    edges: [
+      { from: "c", to: "o" },
+      { from: "o", to: "a" },
+    ],
+  });
+  assert.equal(ir.engine, "cortex");
+  assert.equal(ir.ghost, true);
+  assert.equal(ir.output_node_id, "a");
+  assert.equal(ir.nodes.find((n) => n.id === "a").kind, "EMIT");
+  assert.equal(ir.nodes.find((n) => n.id === "c").kind, "DOCUMENT_REF");
+});
+
+test("topo lists sources before sinks", () => {
+  const order = topo({
+    nodes: [{ id: "a" }, { id: "b" }, { id: "c" }],
+    edges: [
+      { from: "a", to: "b" },
+      { from: "b", to: "c" },
+    ],
+  });
+  assert.deepEqual(order, ["a", "b", "c"]);
+});
+
+test("topo does not append leftover cyclic nodes", () => {
+  const mixed = topo({
+    nodes: [{ id: "a" }, { id: "b" }, { id: "free" }],
+    edges: [
+      { from: "a", to: "b" },
+      { from: "b", to: "a" },
+    ],
+  });
+  assert.deepEqual(mixed, ["free"]);
+  const cycle = topo({
+    nodes: [{ id: "a" }, { id: "b" }],
+    edges: [
+      { from: "a", to: "b" },
+      { from: "b", to: "a" },
+    ],
+  });
+  assert.deepEqual(cycle, []);
+});
+
+test("compileIR entry is the Kahn source, not array[0]", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "sink", kind: "app", note: "out" },
+      { id: "src", kind: "connector", note: "in" },
+    ],
+    edges: [{ from: "src", to: "sink" }],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.entry_node_id, "src");
+  assert.equal(ir.output_node_id, "sink");
+  assert.equal(ir.nodes[0].id, "src");
+  assert.equal(ir.nodes[ir.nodes.length - 1].id, "sink");
+  const packed = cortexPayload({
+    nodes: [
+      { id: "sink", kind: "app", note: "out" },
+      { id: "src", kind: "connector", note: "in" },
+    ],
+    edges: [{ from: "src", to: "sink" }],
+  });
+  assert.equal(packed.error, undefined);
+  assert.equal(packed.body.nodes[0].id, "src");
+  assert.equal(packed.body.entry_node_id, "src");
+});
+
+test("compileIR output is the Kahn sink app, not array last app", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "sink", kind: "app", note: "out" },
+      { id: "src", kind: "connector", note: "in" },
+      { id: "mid", kind: "app", note: "mid" },
+    ],
+    edges: [
+      { from: "src", to: "mid" },
+      { from: "mid", to: "sink" },
+    ],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.entry_node_id, "src");
+  assert.equal(ir.output_node_id, "sink");
+  assert.equal(ir.nodes.find((n) => n.id === "sink").kind, "EMIT");
+  assert.equal(ir.nodes.find((n) => n.id === "mid").kind, "DETERMINISTIC_RULE");
+});
+
+test("compileIR output is the Kahn sink, not array last, when no app", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "sink", kind: "ontology", note: "types" },
+      { id: "src", kind: "connector", note: "in" },
+    ],
+    edges: [{ from: "src", to: "sink" }],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.entry_node_id, "src");
+  assert.equal(ir.output_node_id, "sink");
+  assert.equal(ir.nodes.find((n) => n.id === "sink").kind, "DOCUMENT_REF");
+});
+
