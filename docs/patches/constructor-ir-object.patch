diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index babf766..05ce073 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -354,3 +354,50 @@ test("set point does not invent inventory for a missing object", () => {
   assert.equal(objectForSetPoint("nope", objects), "");
   assert.equal(objectForSetPoint("inventory", objects), "inventory");
 });
+
+test("compileIR does not keep an unlisted object_type", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", object_type: "hr_notes" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.nodes[0].object_type, null);
+  const insight = compileIR({
+    nodes: [{ id: "i", kind: "insight", object_type: "Insight" }],
+    edges: [],
+  });
+  assert.equal(insight.nodes[0].object_type, null);
+});
+
+test("compileIR keeps a listed object_type", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", object_type: "inventory" }],
+    edges: [],
+  });
+  assert.equal(ir.nodes[0].object_type, "inventory");
+});
+
+test("compileIR uses the caller object catalog", () => {
+  const ir = compileIR({
+    objects: ["shipments"],
+    nodes: [
+      { id: "ok", kind: "connector", object_type: "shipments" },
+      { id: "no", kind: "connector", object_type: "inventory" },
+    ],
+    edges: [],
+  });
+  assert.equal(ir.nodes.find((n) => n.id === "ok").object_type, "shipments");
+  assert.equal(ir.nodes.find((n) => n.id === "no").object_type, null);
+});
+
+test("ghostWalk does not log an unlisted object_type", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [{ id: "c", kind: "connector", object_type: "hr_notes" }],
+      edges: [],
+    },
+    true
+  );
+  assert.equal(walked.error, undefined);
+  assert.equal(walked.log[0].object_type, null);
+});
