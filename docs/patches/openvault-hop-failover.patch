diff --git a/OpenMW/tests/test_execution_chat.py b/OpenMW/tests/test_execution_chat.py
index e22ec4b..8c68e0d 100644
--- a/OpenMW/tests/test_execution_chat.py
+++ b/OpenMW/tests/test_execution_chat.py
@@ -124,3 +124,77 @@ def test_v1_fusion_with_models_posts_panel_then_judge(
     assert mock.post.call_count == 3
     bodies = [call.kwargs["json"]["model"] for call in mock.post.call_args_list]
     assert bodies == ["gpt-4o-mini", "gpt-4o", "gpt-4o-mini"]
+
+
+def _healthy(vault: KeyVault, label: str, *, priority: int) -> None:
+    rec = vault.create(
+        label=label,
+        provider="openai",
+        secret=f"sk-test-{label}-aaaaaaaa",
+        role="primary",
+        priority=priority,
+        base_url="https://example.invalid/v1",
+    )
+    vault.set_precheck(rec.id, status="ok", latency_ms=1.0, error=None)
+
+
+def _client_mock() -> MagicMock:
+    mock = MagicMock()
+    mock.__enter__ = MagicMock(return_value=mock)
+    mock.__exit__ = MagicMock(return_value=False)
+    return mock
+
+
+def test_v1_pipeline_with_models_threads_steps(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "pipe-hop", priority=1)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="pipe-hop-seat")
+    mock = _client_mock()
+    mock.post = MagicMock(side_effect=[_ok("OUT_A"), _ok("FINAL_B")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "hi"}],
+                "combo": {
+                    "strategy": "pipeline",
+                    "models": ["gpt-4o-mini", "gpt-4o"],
+                },
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["choices"][0]["message"]["content"] == "FINAL_B"
+    assert mock.post.call_count == 2
+    second_user = mock.post.call_args_list[1].kwargs["json"]["messages"][-1]["content"]
+    assert second_user == "OUT_A"
+
+
+def test_v1_empty_first_hop_falls_through(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "hop-a", priority=1)
+    _healthy(vault, "hop-b", priority=2)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="failover-seat")
+    mock = _client_mock()
+    err = MagicMock()
+    err.status_code = 500
+    err.json = MagicMock(return_value={})
+    mock.post = MagicMock(side_effect=[err, _ok("solo")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {"strategy": "fusion", "models": ["gpt-4o-mini"]},
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["choices"][0]["message"]["content"] == "solo"
+    assert mock.post.call_count == 2
