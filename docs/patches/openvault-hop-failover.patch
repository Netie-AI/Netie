     assert call("p/b", user_text="Q") == "ok"
     assert seen == ["k2:p/b"]
+
+
+def test_hop_call_model_falls_through_empty() -> None:
+    hops = [
+        Hop("k1", "gpt-mini", "openai", True),
+        Hop("k2", "gpt-mini", "openai", True),
+    ]
+    seen: list[str] = []
+
+    def post(hop: Hop, *, model: str, **_k: object) -> str:
+        seen.append(hop.execution_key)
+        return "" if hop.execution_key == "k1" else "ok"
+
+    call = hop_call_model(hops, post)
+    assert call("gpt-mini", user_text="Q") == "ok"
+    assert seen == ["k1", "k2"]
+    assert [h.execution_key for h in hops_for_model(hops, "gpt-mini")] == ["k1", "k2"]
