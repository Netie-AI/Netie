 });
+
+test("connector-only graph does not invent EMIT", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "in" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.output_node_id, "c");
+  assert.equal(ir.nodes[0].kind, "DOCUMENT_REF");
+});
+
+test("audit output is still EMIT", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "h", kind: "hypothesize" },
+      { id: "a", kind: "audit" },
+    ],
+    edges: [{ from: "h", to: "a" }],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.nodes.find((n) => n.id === "a").kind, "EMIT");
+  assert.equal(ir.nodes.find((n) => n.id === "h").kind, "DOCUMENT_REF");
+});
