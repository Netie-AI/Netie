diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index 4d83e65..7f42605 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -171,3 +171,26 @@ test("ghostWalk logs a valid DAG in topo order", () => {
   assert.equal(walked.log.length, 2);
