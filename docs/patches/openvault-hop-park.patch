+def test_v1_429_parks_key_without_tripping_breaker(
+    vault: KeyVault, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _healthy(vault, "hop-a", priority=1)
+    _healthy(vault, "hop-b", priority=2)
+    client = _client(vault, tmp_path, monkeypatch)
+    _seat, headers = issue_key(client, label="park-seat")
+    mock = _client_mock()
+    limited = _http_err(429, "too many requests")
+    limited.headers = {"Retry-After": "5"}
+    mock.post = MagicMock(side_effect=[limited, _ok("solo")])
+    with patch("openmw.openvault.vault.proxy.httpx.Client", return_value=mock):
+        resp = client.post(
+            "/v1/chat/completions",
+            json={
+                "model": "auto",
+                "messages": [{"role": "user", "content": "Q"}],
+                "combo": {"strategy": "fusion", "models": ["gpt-4o-mini"]},
+            },
+            headers=headers,
+        )
+    assert resp.status_code == 200, resp.text
+    assert resp.json()["choices"][0]["message"]["content"] == "solo"
+    assert mock.post.call_count == 2
+    hops = client.get("/api/fallback/status").json()["hops"]
+    parked = [h for h in hops if h.get("park_until")]
+    assert len(parked) == 1
+    assert parked[0]["failures"] == 0
+    breaker = get_circuit_breaker("openai").get_status()
+    assert breaker.state == "CLOSED"
+    assert breaker.failure_count == 0
+
+
