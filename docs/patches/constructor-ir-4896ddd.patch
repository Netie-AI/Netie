+    nodes: [{ id: "c", kind: "connector", object_type: "inventory", fetch_from: "warehouse.hr_notes" }],
+    edges: [],
+  });
+  assert.equal(badFetch.error, "fetch_from mismatch");
+  const ok = compileIR({
+    nodes: [{ id: "c", kind: "connector", object_type: "inventory", data_point: "sku", fetch_from: "warehouse.inventory" }],
+    edges: [],
+  });
+  assert.equal(ok.error, undefined);
+  assert.equal(ok.nodes[0].data_point, "sku");
+});
