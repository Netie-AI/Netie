+  assert.deepEqual(body.nodes.map((n) => n.id), ["first", "later"]);
+  assert.equal(body.nodes[0].x, undefined);
+  assert.equal(WRITE_ACTIONS.indexOf("export_pptx") >= 0, true);
+  const refused = cortexPayload({
