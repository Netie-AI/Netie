+
+test("compileIR drops unlisted object_type and does not invent T0", () => {
+  const ir = compileIR({
+    nodes: [{ id: "c", kind: "connector", object_type: "hr_notes" }],
+    edges: [],
+  });
+  assert.equal(ir.error, undefined);
+  assert.equal(ir.nodes[0].object_type, null);
+  assert.equal(ir.nodes[0].tier, null);
+  const kept = compileIR({
+    nodes: [{ id: "c", kind: "connector", object_type: "inventory" }],
+    edges: [],
+  });
+  assert.equal(kept.nodes[0].object_type, "inventory");
+});
+
+test("compileIR unknown action and note leak refuse", () => {
+  const bash = compileIR({
+    nodes: [{ id: "t", kind: "tool_call", action_type: "bash" }],
+    edges: [],
+  });
+  assert.equal(bash.error, "tool_call unknown action_type");
+  const leak = compileIR({
+    nodes: [{ id: "c", kind: "connector", note: "skill_body: SECRET" }],
+    edges: [],
+  });
+  assert.equal(leak.error, "NOTE_LEAK");
+});
+
+test("compileIR emits Kahn order and refuses a disconnected graph", () => {
+  const ir = compileIR({
+    nodes: [
+      { id: "later", kind: "app" },
+      { id: "first", kind: "connector", object_type: "inventory" },
+    ],
+    edges: [{ from: "first", to: "later" }],
+  });
+  assert.deepEqual(ir.nodes.map((n) => n.id), ["first", "later"]);
+  const split = compileIR({
+    nodes: [
+      { id: "a", kind: "connector", object_type: "inventory" },
+      { id: "b", kind: "app" },
+    ],
+    edges: [],
+  });
+  assert.equal(split.error, "disconnected");
+});
+
