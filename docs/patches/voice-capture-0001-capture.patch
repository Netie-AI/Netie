index 0000000..d87edec
--- /dev/null
+++ b/app/api/capture.py
@@ -0,0 +1,83 @@
+"""POST /capture: voice note (or text) in, sorted tasks / notes / expenses out.
+
+Same body dispatch as `/ask`: multipart `file`, raw `audio/*`, the
+`application/octet-stream` an iOS Shortcut sends, or JSON `{"text": "..."}`.
+
+Unlike the rest of this server, `/capture` requires `Authorization: Bearer
+<CAPTURE_TOKEN>`: it spends Claude credit and writes to personal records. With
+`CAPTURE_TOKEN` unset the endpoint refuses every request (fails closed).
+
+Always 200 once a transcript exists. `sorted: false` plus `error` means the
+transcript was kept in the inbox but Claude did not sort it; `summary` says so.
+"""
+
+import hmac
+import logging
+
+from fastapi import APIRouter, HTTPException, Query, Request
+from fastapi.responses import JSONResponse
+
+from app.api.ask import (
+    CT_JSON,
+    _extract_audio_body,
+    _is_supported_ask_content_type,
+    _read_text_body,
+    _run_audio_pipeline,
+)
+from app.api.transcribe import _normalize_content_type
+from app.config import config
+from app.services.postprocess import Drop, filter_empty_transcription
+
+logger = logging.getLogger(__name__)
+
+router = APIRouter()
+
+
+def _check_token(request: Request) -> None:
+    expected = config.CAPTURE_TOKEN
+    if not expected:
+        raise HTTPException(status_code=503, detail="CAPTURE_TOKEN is not configured")
+    supplied = request.headers.get("authorization", "")
+    if not hmac.compare_digest(supplied.encode(), f"Bearer {expected}".encode()):
+        raise HTTPException(status_code=401, detail="Invalid or missing bearer token")
+
+
+@router.post("/capture")
+async def capture(
+    request: Request,
+    language: str = Query("auto", description="Spoken language hint for audio inputs"),
+    prompt: str | None = Query(
+        None, description="Initial prompt seed for audio transcription"
+    ),
+):
+    _check_token(request)
+
+    content_type = _normalize_content_type(request.headers.get("content-type"))
+    if not _is_supported_ask_content_type(content_type):
+        raise HTTPException(
+            status_code=415,
+            detail=f"Unsupported Content-Type: {content_type or '<missing>'}",
+        )
+
+    if content_type == CT_JSON:
+        transcript = await _read_text_body(request)
+    else:
+        body, suffix, _mime = await _extract_audio_body(request, content_type)
+        raw, _duration = await _run_audio_pipeline(
+            request, body, suffix, language, prompt
+        )
+        decision = filter_empty_transcription(
+            text=raw,
+            duration_ms=None,
+            enabled=config.FILTER_EMPTY_ENABLED,
+            min_duration_ms=config.FILTER_MIN_DURATION_MS,
+        )
+        if isinstance(decision, Drop):
+            return JSONResponse(
+                {"error": "no_speech_detected", "summary": "No speech detected"},
+                status_code=400,
+            )
+        transcript = decision.text
+
+    result = await request.app.state.capture.capture(transcript)
+    return result.to_dict()
