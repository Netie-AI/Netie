+++ b/tests/test_capture.py
@@ -0,0 +1,192 @@
+"""Tests for voice capture: the Claude sorter, the files it writes, and POST /capture.
+
+Service tests stub the Anthropic client. Endpoint tests stub the service, so
+they cover auth and the response the iPhone Shortcut actually receives.
+"""
+
+import csv
+import json
+from datetime import datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from app.services.capture import (
+    CaptureItem,
+    CaptureItems,
+    CaptureResult,
+    CaptureService,
+    CaptureStore,
+)
+
+NOW = datetime(2026, 11, 12, 14, 3)
+
+
+def _service(tmp_path, *, items=None, stop_reason="end_turn", error=None, api_key="k"):
+    parse = AsyncMock()
+    if error:
+        parse.side_effect = error
+    else:
+        parse.return_value = SimpleNamespace(
+            stop_reason=stop_reason,
+            parsed_output=None if items is None else CaptureItems(items=items),
+        )
+    client = MagicMock()
+    client.beta.messages.parse = parse
+    svc = CaptureService(
+        api_key=api_key,
+        store=CaptureStore(tmp_path / "capture"),
+        topics=["move", "motorcycle"],
+        client=client,
+    )
+    return svc, parse
+
+
+def _read(tmp_path, name):
+    return (tmp_path / "capture" / name).read_text(encoding="utf-8")
+
+
+# ---------- Service: the files the user ends up with ----------
+
+
+async def test_items_are_filed_by_kind(tmp_path):
+    svc, parse = _service(
+        tmp_path,
+        items=[
+            CaptureItem(kind="task", text="Collect the bike", due="2026-11-14", topic="motorcycle"),
+            CaptureItem(kind="expense", text="Deposit, for the bike", amount=500, currency="MYR", topic="motorcycle"),
+            CaptureItem(kind="note", text="Lorry quote was 1,200"),
+        ],
+    )
+    result = await svc.capture("paid 500 deposit collect the bike saturday lorry quoted 1200", now=NOW)
+
+    assert result.sorted is True
+    assert result.summary == "Filed 1 task, 1 note, 1 expense"
+    assert _read(tmp_path, "tasks.md") == "- [ ] Collect the bike (due 2026-11-14) #motorcycle\n"
