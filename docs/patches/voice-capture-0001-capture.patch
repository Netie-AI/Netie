index 0000000..bd8ad73
--- /dev/null
+++ b/app/services/capture.py
@@ -0,0 +1,234 @@
+"""Voice capture: sort a transcript into tasks, notes and expenses with Claude.
+
+Standalone on purpose: imports nothing from `app`, so it can be tested without
+the Whisper stack. The router in `app/api/capture.py` owns HTTP and STT.
+
+Data-loss rule: the raw transcript is appended to `transcripts.jsonl` BEFORE the
+Claude call. If sorting fails for any reason, the transcript also lands in
+`inbox.md` and the result says `sorted=False` with the cause. Nothing is
+dropped silently.
+
+Files written under `<data_dir>/capture/`:
+  transcripts.jsonl  every capture, raw
+  tasks.md           `- [ ] text (due 2026-11-20) #topic`
+  notes.md           `- 2026-11-12 14:03 text #topic`
+  expenses.csv       timestamp,amount,currency,description,topic
+  inbox.md           transcripts Claude could not sort
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import logging
+import threading
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Literal
+
+import anthropic
+from pydantic import BaseModel
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_CAPTURE_MODEL = "claude-opus-5-5"
+FALLBACK_BETA = "server-side-fallback-2026-07-01"
+
+SYSTEM_PROMPT = """\
+You sort one person's dictated voice notes into their personal records. Each \
+transcript comes from speech-to-text, so expect misheard words and missing \
+punctuation, and read for intent.
+
+Split the transcript into separate items and give each one a kind:
+- task: something they intend to do or must not forget to do.
+- expense: money they spent or committed to pay. Fill `amount` as a plain \
+number and `currency` as an ISO 4217 code. If they name no currency, use the \
+default currency given in the message.
+- note: anything else worth keeping (a fact, a quote, a price they were told \
+but have not paid, an idea).
+
+One transcript often holds several items, and one sentence can hold two (paying \
+a deposit and needing to collect the bike is an expense and a task). Write each \
+item's `text` as a short, self-contained line in their own words, cleaned of \
+filler. Do not invent details they did not say.
+
+Set `due` (YYYY-MM-DD) only when they state or clearly imply a date, resolving \
+relative dates against today's date in the message. Set `topic` to one of the \
+topics listed in the message when the item clearly belongs to it, otherwise \
+leave it empty. Leave `amount` and `currency` empty for tasks and notes.\
+"""
+
+
+class CaptureItem(BaseModel):
+    kind: Literal["task", "note", "expense"]
+    text: str
+    amount: float | None = None
+    currency: str | None = None
+    due: str | None = None
+    topic: str | None = None
+
+
+class CaptureItems(BaseModel):
+    items: list[CaptureItem]
+
+
+@dataclass
+class CaptureResult:
+    transcript: str
+    sorted: bool
+    items: list[CaptureItem] = field(default_factory=list)
+    error: str | None = None
+
+    @property
+    def summary(self) -> str:
+        """One line for the iPhone Shortcut to show as a notification."""
+        if not self.sorted:
+            return f"Saved UNSORTED to inbox ({self.error})"
+        if not self.items:
+            return "Nothing to file"
+        counts = {k: sum(i.kind == k for i in self.items) for k in ("task", "note", "expense")}
+        parts = [f"{n} {k}{'s' if n != 1 else ''}" for k, n in counts.items() if n]
+        return "Filed " + ", ".join(parts)
+
+    def to_dict(self) -> dict:
+        return {
+            "transcript": self.transcript,
+            "sorted": self.sorted,
+            "items": [i.model_dump() for i in self.items],
+            "error": self.error,
+            "summary": self.summary,
+        }
+
+
+class CaptureStore:
+    """Append-only files. One lock: captures are rare and tiny."""
+
+    def __init__(self, directory: Path):
+        self.directory = Path(directory)
+        self._lock = threading.Lock()
+
+    def _append(self, name: str, line: str) -> None:
+        self.directory.mkdir(parents=True, exist_ok=True)
+        with open(self.directory / name, "a", encoding="utf-8") as f:
+            f.write(line + "\n")
+
+    def save_transcript(self, transcript: str, now: datetime) -> None:
+        with self._lock:
+            self._append(
+                "transcripts.jsonl",
+                json.dumps({"at": now.isoformat(timespec="seconds"), "text": transcript}, ensure_ascii=False),
+            )
+
+    def save_unsorted(self, transcript: str, now: datetime, error: str) -> None:
+        with self._lock:
+            self._append("inbox.md", f"- {now:%Y-%m-%d %H:%M} {_one_line(transcript)} <!-- unsorted: {_one_line(error)} -->")
+
+    def save_items(self, items: list[CaptureItem], now: datetime) -> None:
+        with self._lock:
+            for item in items:
+                tag = f" #{item.topic}" if item.topic else ""
+                text = _one_line(item.text)
+                if item.kind == "task":
+                    due = f" (due {item.due})" if item.due else ""
+                    self._append("tasks.md", f"- [ ] {text}{due}{tag}")
+                elif item.kind == "expense":
+                    self.directory.mkdir(parents=True, exist_ok=True)
+                    path = self.directory / "expenses.csv"
+                    new = not path.exists()
+                    with open(path, "a", encoding="utf-8", newline="") as f:
+                        w = csv.writer(f)
+                        if new:
+                            w.writerow(["timestamp", "amount", "currency", "description", "topic"])
+                        w.writerow([
+                            now.isoformat(timespec="seconds"),
+                            "" if item.amount is None else item.amount,
+                            item.currency or "",
+                            text,
+                            item.topic or "",
+                        ])
+                else:
+                    self._append("notes.md", f"- {now:%Y-%m-%d %H:%M} {text}{tag}")
+
+
+def _one_line(s: str) -> str:
+    return " ".join(s.split())
+
+
+class CaptureService:
+    def __init__(
+        self,
+        *,
+        api_key: str | None,
+        store: CaptureStore,
+        model: str | None = None,
+        topics: list[str] | None = None,
+        default_currency: str = "MYR",
+        client: anthropic.AsyncAnthropic | None = None,
+    ):
+        self.api_key = api_key or None
+        self.model = model or DEFAULT_CAPTURE_MODEL
+        self.topics = topics or []
+        self.default_currency = default_currency
+        self.store = store
+        self._client = client
+
+    @property
+    def configured(self) -> bool:
+        return bool(self.api_key or self._client)
+
+    def _ensure_client(self) -> anthropic.AsyncAnthropic:
+        if self._client is None:
+            # 60 s: the Shortcut is holding the connection open.
+            self._client = anthropic.AsyncAnthropic(api_key=self.api_key, timeout=60.0)
+        return self._client
+
+    async def _classify(self, transcript: str, now: datetime) -> list[CaptureItem]:
+        client = self._ensure_client()
+        context = (
+            f"Today is {now:%A %Y-%m-%d}. Default currency: {self.default_currency}. "
+            f"Topics: {', '.join(self.topics) or '(none)'}.\n\n"
+            f"<transcript>\n{transcript}\n</transcript>"
+        )
+        response = await client.beta.messages.parse(
+            model=self.model,
+            max_tokens=4096,
+            system=SYSTEM_PROMPT,
+            messages=[{"role": "user", "content": context}],
+            output_format=CaptureItems,
+            output_config={"effort": "low"},
+            betas=[FALLBACK_BETA],
+            fallbacks="default",
+        )
+        if response.stop_reason == "refusal":
+            raise RuntimeError("Claude declined this transcript")
+        if response.stop_reason == "max_tokens" or response.parsed_output is None:
+            raise RuntimeError(f"Claude returned no usable result (stop_reason={response.stop_reason})")
+        return response.parsed_output.items
+
+    async def capture(self, transcript: str, now: datetime | None = None) -> CaptureResult:
+        now = now or datetime.now().astimezone()
+        self.store.save_transcript(transcript, now)  # before anything can fail
+        try:
+            if not self.configured:
+                raise RuntimeError("ANTHROPIC_API_KEY is not configured")
+            items = await self._classify(transcript, now)
+        except Exception as e:  # any sorting failure degrades to the inbox, visibly
+            error = _describe(e)
+            logger.warning("capture unsorted: %s", error)
+            self.store.save_unsorted(transcript, now, error)
+            return CaptureResult(transcript=transcript, sorted=False, error=error)
+        self.store.save_items(items, now)
+        return CaptureResult(transcript=transcript, sorted=True, items=items)
+
+
+def _describe(e: Exception) -> str:
+    if isinstance(e, anthropic.AuthenticationError):
+        return "Claude rejected the API key"
+    if isinstance(e, anthropic.RateLimitError):
+        return "Claude rate limit"
+    if isinstance(e, anthropic.APIStatusError):
+        return f"Claude API error {e.status_code}"
+    if isinstance(e, anthropic.APIConnectionError):
+        return "could not reach Claude"
+    return str(e) or type(e).__name__
