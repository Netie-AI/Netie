diff --git a/OpenMW/tests/test_route_strategies.py b/OpenMW/tests/test_route_strategies.py
index bb4ca6b..3623399 100644
--- a/OpenMW/tests/test_route_strategies.py
+++ b/OpenMW/tests/test_route_strategies.py
@@ -98,3 +98,24 @@ def test_strict_random_remainder_is_permutation() -> None:
     reset_decks()
     ordered = apply_strategy("strict-random", _targets(), combo_name="sr2")
     assert sorted(t.execution_key for t in ordered) == ["a", "b", "c"]
+
+
+def test_lkgp_last_success_moves_first() -> None:
+    metrics = ComboMetrics()
+    metrics.record("c", success=True, latency_ms=10)
+    ordered = apply_strategy("lkgp", _targets(), metrics=metrics)
+    assert [t.execution_key for t in ordered] == ["c", "a", "b"]
+
+
+def test_lkgp_missing_pin_leaves_order() -> None:
+    ordered = apply_strategy("lkgp", _targets(), metrics=ComboMetrics())
+    assert [t.execution_key for t in ordered] == ["a", "b", "c"]
+
+
+def test_lkgp_failure_of_sticky_clears_pin() -> None:
+    metrics = ComboMetrics()
+    metrics.record("b", success=True, latency_ms=10)
+    metrics.record("b", success=False, latency_ms=10)
+    ordered = apply_strategy("lkgp", _targets(), metrics=metrics)
+    assert [t.execution_key for t in ordered] == ["a", "b", "c"]
+    assert metrics.last_success_key is None
