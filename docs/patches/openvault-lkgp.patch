+    if strategy == "lkgp":
+        # Algorithm port of OmniRoute LKGP reorder. Not SQLite provider+connection.
+        # Sticky last successful execution_key; missing pin leaves order unchanged.
+        sticky = (metrics.last_success_key if metrics else None) or ""
+        if sticky:
+            chosen = next((t for t in targets if t.execution_key == sticky), None)
+            if chosen is not None:
+                rest = [t for t in targets if t.execution_key != sticky]
+                return [chosen, *rest]
+        return list(targets)
