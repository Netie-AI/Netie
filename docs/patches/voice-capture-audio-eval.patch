+def test_report_scores_against_expected_and_finds_flips():
+    wrong = {**TASK, "kind": "note"}
+    rows = [{"id": "t1", "source": "call the dentist", "heard": "call the dentists", "seconds": 2.0, "items": [wrong]},
+            {"id": "e1", "source": "um never mind", "heard": "um never mind", "seconds": 4.0, "items": []}]
+    baseline = [{"id": "t1", "items": [TASK]}, {"id": "e1", "items": []}]
+    rep = a.report(rows, CASES, baseline)
+    assert (rep["answered"], rep["correct"], rep["baseline_passed_among_answered"]) == (2, 1, 2)
+    assert [(f["id"], f["text_run"], f["audio_run"], f["words_differ"]) for f in rep["flips"]] == [("t1", "pass", "fail", 1)]
+    text = a.format_report(rep, rows)
+    assert "answered 2 of 2, correct 1" in text and "t1: text pass -> audio fail" in text
+
