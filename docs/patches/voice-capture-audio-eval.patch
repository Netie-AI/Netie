+def test_main_end_to_end_with_stubs(tmp_path, capsys):
+    cases = tmp_path / "cases.jsonl"
+    cases.write_text("\n".join(json.dumps(c) for c in CASES) + "\n")
+    clips = tmp_path / "clips"
+    clips.mkdir()
+    for c in CASES:
+        (clips / f"{c['id']}.mp3").write_bytes(b"x")
+    heard = iter(["Call the dentist.", ""])
+    out = tmp_path / "r.jsonl"
+    common = ["--cases", str(cases)]
+    assert a.main([*common, "stt", "--clips", str(clips), "--out", str(out)],
+                  post=lambda _u, _b: {"text": next(heard)}) == 0
+    assert a.main([*common, "sort", "--results", str(out), "--delay", "0"],
+                  predict=lambda c: {"items": [TASK]}, sleep=lambda _s: None) == 0
+    assert a.main([*common, "report", "--results", str(out), "--baseline", ""]) == 0
+    assert "answered 2 of 2, correct 2" in capsys.readouterr().out
