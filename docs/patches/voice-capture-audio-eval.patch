+def test_daily_quota_stops_the_run_and_a_second_run_resumes():
+    rows = [{"id": "t1", "source": "call the dentist", "heard": "call the dentist"},
+            {"id": "e1", "source": "um never mind", "heard": "never mind"}]
+    daily = {"error": "ClientError: 429 RESOURCE_EXHAUSTED GenerateRequestsPerDayPerProjectPerModel-FreeTier"}
+    calls = []
+    assert a.run_sort(rows, CASES, predict=lambda c: calls.append(c["id"]) or daily,
+                      sleep=lambda _s: None, log=lambda _l: None) is False
+    assert calls == ["t1"] and all("items" not in r for r in rows)
+
+    rows[0]["items"] = [TASK]
+    calls.clear()
+    assert a.run_sort(rows, CASES, predict=lambda c: calls.append(c["id"]) or {"items": []},
+                      sleep=lambda _s: None, log=lambda _l: None)
+    assert calls == ["e1"]  # the answered row was not asked again
+
