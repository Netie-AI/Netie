+def test_an_api_error_is_an_unanswered_case_not_a_wrong_answer():
+    calls = []
+
+    def predict(case):
+        calls.append(1)
+        return {"error": "TimeoutError: "}
+
+    rows = [{"id": "t1", "source": "call the dentist", "heard": "call the dentist"}]
+    assert a.run_sort(rows, CASES, predict=predict, sleep=lambda _s: None, log=lambda _l: None)
+    assert len(calls) == a.MAX_TRIES and "items" not in rows[0] and rows[0]["error"]
+    rep = a.report(rows, CASES)
+    assert (rep["answered"], rep["correct"], rep["sort_errors"]) == (0, 0, ["t1"])
+
