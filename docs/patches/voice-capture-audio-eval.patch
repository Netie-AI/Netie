diff --git a/evals/audio/test_audio_eval.py b/evals/audio/test_audio_eval.py
new file mode 100644
index 0000000..0bfe7de
--- /dev/null
+++ b/evals/audio/test_audio_eval.py
@@ -0,0 +1,175 @@
+"""Tests for the audio eval runner. No network: the server and the model are stubbed.
+
+    python -m pytest evals/audio -c /dev/null
+"""
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import run_audio_eval as a  # noqa: E402
+
+CASES = [
+    {"id": "t1", "today": "2026-11-12 Thursday", "transcript": "call the dentist", "why": "x",
+     "expected": [{"kind": "task", "must_contain": ["dentist"], "amount": None, "currency": None,
+                   "due": None, "topic": None}]},
+    {"id": "e1", "today": "2026-11-12 Thursday", "transcript": "um never mind", "why": "x", "expected": []},
+]
+TASK = {"kind": "task", "text": "Call the dentist", "amount": None, "currency": None, "due": None, "topic": None}
+
+
+def test_words_strip_case_and_punctuation():
+    assert a.words("Paid RM85, for Dr Lim's petrol.") == ["paid", "rm85", "for", "dr", "lims", "petrol"]
+    assert a.words("quoted 9,800 or 3.5k.") == ["quoted", "9800", "or", "3.5k"]
+
+
+@pytest.mark.parametrize("said, heard", [
+    ("five hundred", "500"),
+    ("one thousand two hundred", "1,200"),
+    ("1.2k", "1200"),
+    ("twenty three", "23"),
+    ("RM85", "RM 85"),
+    ("by the 20th", "by the 20"),
+    ("six ringgit fifty sen", "6 ringgit 50 sen"),
+    ("testing one two three", "testing 1 2 3"),
+])
+def test_number_spellings_compare_equal(said, heard):
+    assert a.number_words(a.words(said)) == a.number_words(a.words(heard))
+
+
+def test_number_normalising_does_not_hide_a_wrong_number():
+    assert a.number_words(a.words("fifty")) != a.number_words(a.words("fifteen"))
+    assert a.number_words(a.words("twelve fifty")) == ["12", "50"]  # not 62, not 1250
+    assert a.number_words(a.words("a hundred boxes")) == ["a", "hundred", "boxes"]
+
+
+def test_edit_distance_counts_sub_del_ins():
+    assert a.edits("collect it this saturday".split(), "collected this saturday".split()) == 2
+    assert a.edits([], ["thank", "you"]) == 2
+    assert a.edits(["a", "b"], ["a", "b"]) == 0
+
+
+def test_wer_raw_and_number_normalised():
+    rows = [{"id": "x", "source": "paid five hundred for the bike", "heard": "Paid 500 for the bike."},
+            {"id": "y", "source": "collect it this saturday", "heard": "collected this Saturday"}]
+    w = a.wer(rows)
+    assert (w["ref_words"], w["raw_edits"], w["num_edits"]) == (10, 4, 2)
+    assert (w["exact_raw"], w["exact_num"]) == (0, 1)
+
+
+def test_stt_posts_like_the_shortcut_and_records_failures(tmp_path):
+    (tmp_path / "t1.mp3").write_bytes(b"mp3-bytes")
+    seen = []
+
+    def post(url, body):
+        seen.append((url, body))
+        return {"text": " Call the dentist. ", "language": "en"}
+
+    ticks = iter([10.0, 12.5])
+    rows = a.run_stt(CASES, tmp_path, "http://h:8000/", model="m", post=post, clock=lambda: next(ticks),
+                     log=lambda _l: None)
+    assert seen == [("http://h:8000/transcribe?log=false", b"mp3-bytes")]
+    assert rows[0]["heard"] == "Call the dentist." and rows[0]["seconds"] == 2.5
+    assert "no clip" in rows[1]["stt_error"] and "heard" not in rows[1]  # missing clip is loud, not skipped
+
+
+def test_http_post_sends_raw_octet_stream(monkeypatch):
+    got = {}
+
+    class Reply:
+        def __enter__(self): return self
+        def __exit__(self, *_): return False
+        def read(self): return b'{"text": "ok"}'
+
+    def fake_urlopen(req, timeout):
+        got.update(method=req.get_method(), ct=req.get_header("Content-type"), data=req.data)
+        return Reply()
+
+    monkeypatch.setattr(a.urllib.request, "urlopen", fake_urlopen)
+    assert a.http_post("http://h/transcribe", b"abc") == {"text": "ok"}
+    assert got == {"method": "POST", "ct": "application/octet-stream", "data": b"abc"}
+
+
+def test_sort_uses_what_was_heard_and_the_case_date():
+    asked = []
+
+    def predict(case):
+        asked.append(case)
+        return {"id": case["id"], "items": [TASK]}
+
+    rows = [{"id": "t1", "source": "call the dentist", "heard": "Call the dentist."},
+            {"id": "e1", "source": "um never mind", "heard": ""}]
+    assert a.run_sort(rows, CASES, predict=predict, sleep=lambda _s: None, log=lambda _l: None)
+    assert [(c["transcript"], c["today"]) for c in asked] == [("Call the dentist.", "2026-11-12 Thursday")]
+    assert rows[0]["items"] == [TASK]
+    assert rows[1]["items"] == [] and rows[1]["no_speech"] is True  # empty transcript is never sent
+
