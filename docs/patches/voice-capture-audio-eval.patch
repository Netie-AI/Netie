index 0000000..4e8eb34
--- /dev/null
+++ b/evals/audio/run_audio_eval.py
@@ -0,0 +1,405 @@
+"""Capture accuracy from audio: speech to text, then the real sorter, then a report.
+
+    python evals/audio/run_audio_eval.py stt    --clips DIR --out RESULTS [--server URL] [--model NAME]
+    python evals/audio/run_audio_eval.py sort   --results RESULTS [--delay 5]
+    python evals/audio/run_audio_eval.py report --results RESULTS [--baseline PREDICTIONS]
+
+stt     posts DIR/<case id>.mp3 to POST /transcribe on a running server, the way the
+        iPhone Shortcut posts (raw body, Content-Type application/octet-stream), and
+        records what Whisper heard and the seconds each clip took.
+sort    feeds what Whisper heard (not the clean text) through CaptureService._classify,
+        using evals/run_eval.py, one call at a time. Needs GEMINI_API_KEY. Resumable:
+        rows that already have an answer are skipped.
+report  word error rate against the source text, the end-to-end score from
+        evals/score.py against the unchanged expected answers, and a case-by-case
+        comparison with a stored run on clean text.
+
+Standard library only, apart from what evals/run_eval.py needs for `sort`.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import re
+import sys
+import time
+import urllib.request
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+EVALS = HERE.parent
+sys.path.insert(0, str(EVALS))
+import score  # noqa: E402
+
+CASES = EVALS / "capture_cases.jsonl"
+BASELINE = EVALS / "results-gemini-3.1-flash-lite-2026-11-12.jsonl"
+RATE_LIMIT_WAIT_S = 60.0
+OTHER_ERROR_WAIT_S = 10.0
+MAX_TRIES = 8
+
+
+class DailyQuota(Exception):
+    """The provider's per-day quota is spent. Retrying today cannot help."""
+
+
+# --------------------------------------------------------------------------- text
+
+_UNITS = {w: i for i, w in enumerate(
+    "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen "
+    "fifteen sixteen seventeen eighteen nineteen".split())}
+_TENS = {w: 10 * i for i, w in enumerate(
+    "twenty thirty forty fifty sixty seventy eighty ninety".split(), start=2)}
+_SCALES = {"hundred": 100, "thousand": 1000}
+
+
+def words(text: str) -> list[str]:
+    """Lowercase, punctuation stripped. '9,800' stays one word, 'doesn't' equals 'doesnt'."""
+    t = text.lower().replace(chr(0x2019), "'")
+    t = re.sub(r"(?<=\d),(?=\d{3})", "", t)
+    t = t.replace("'", "")
+    t = re.sub(r"(?<!\d)\.|\.(?!\d)", " ", t)  # keep the point only inside a number
+    return re.sub(r"[^a-z0-9.]+", " ", t).split()
+
+
+def _fmt(n: float) -> str:
+    return str(int(n)) if float(n).is_integer() else repr(round(n, 4))
+
+
+def number_words(tokens: list[str]) -> list[str]:
+    """Rewrite numbers to one spelling so 'five hundred', '500' and '0.5k' compare equal.
+
+    'rm85' -> 'rm 85'; '1.2k' -> '1200'; '20th' -> '20'; 'one thousand two hundred' ->
+    '1200'; 'twenty three' -> '23'. 'twelve fifty' stays two numbers ('12 50') because
+    nobody can tell 12.50 from 1250 by ear.
+    """
+    flat: list[str] = []
+    for tok in tokens:
+        m = re.fullmatch(r"(rm|usd|sgd|myr)(\d[\d.]*k?)", tok)
+        flat.extend([m.group(1), m.group(2)] if m else [tok])
+
+    out: list[str] = []
+    total = current = 0
+    last = None  # kind of the last number word folded in: units, teen, tens, scale
+
+    def flush():
+        nonlocal total, current, last
+        if last is not None:
+            out.append(_fmt(total + current))
+        total = current = 0
+        last = None
+
+    for tok in flat:
+        if tok in _UNITS:
+            kind = "units" if _UNITS[tok] < 10 else "teen"
+            if last in ("units", "teen") or (last == "tens" and kind == "teen"):
+                flush()
+            current += _UNITS[tok]
+            last = kind
+        elif tok in _TENS:
+            if last in ("units", "teen", "tens"):
+                flush()
+            current += _TENS[tok]
+            last = "tens"
+        elif tok in _SCALES and last is not None:
+            if tok == "hundred":
+                current *= 100
+            else:
+                total += current * 1000
+                current = 0
+            last = "scale"
+        else:
+            flush()
+            m = re.fullmatch(r"(\d+(?:\.\d+)?)(k|st|nd|rd|th)?", tok)
+            if m:
+                n = float(m.group(1)) * (1000 if m.group(2) == "k" else 1)
+                out.append(_fmt(n))
+            else:
+                out.append(tok)
+    flush()
+    return out
+
+
+def edits(ref: list[str], hyp: list[str]) -> int:
+    """Word-level Levenshtein distance: substitutions + deletions + insertions."""
+    prev = list(range(len(hyp) + 1))
+    for i, r in enumerate(ref, 1):
+        cur = [i]
+        for j, h in enumerate(hyp, 1):
+            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (r != h)))
+        prev = cur
+    return prev[-1]
+
+
+def wer(rows: list[dict]) -> dict:
+    """Corpus word error rate (all edits over all source words), raw and number-normalised."""
+    out = {"clips": len(rows), "ref_words": 0, "raw_edits": 0, "num_edits": 0,
+           "exact_raw": 0, "exact_num": 0, "per_clip": []}
+    for r in rows:
+        ref, hyp = words(r["source"]), words(r.get("heard") or "")
+        e_raw = edits(ref, hyp)
+        e_num = edits(number_words(ref), number_words(hyp))
+        out["ref_words"] += len(ref)
+        out["raw_edits"] += e_raw
+        out["num_edits"] += e_num
+        out["exact_raw"] += e_raw == 0
+        out["exact_num"] += e_num == 0
+        out["per_clip"].append({"id": r["id"], "ref_words": len(ref), "raw_edits": e_raw, "num_edits": e_num})
+    n = out["ref_words"] or 1
+    out["wer_raw"] = out["raw_edits"] / n
+    out["wer_num"] = out["num_edits"] / n
+    return out
+
+
+# ---------------------------------------------------------------------------- stt
+
+def http_post(url: str, body: bytes, timeout: float = 300.0) -> dict:
+    req = urllib.request.Request(url, data=body, method="POST",
+                                 headers={"Content-Type": "application/octet-stream"})
+    with urllib.request.urlopen(req, timeout=timeout) as resp:
+        return json.loads(resp.read().decode("utf-8"))
+
+
+def write_rows(path: str | Path, rows: list[dict]) -> None:
+    tmp = f"{path}.tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        for r in rows:
+            f.write(json.dumps(r, ensure_ascii=True) + "\n")
+    os.replace(tmp, path)
+
+
+def run_stt(cases: list[dict], clips: Path, server: str, *, model: str = "", voice: str = "",
+            post=http_post, clock=time.perf_counter, log=print) -> list[dict]:
+    """One row per case. A missing clip or a failed request is recorded, never skipped."""
+    # log=false: do not store the eval clips in the server's session history.
+    url = server.rstrip("/") + "/transcribe?log=false"
+    rows = []
+    for case in cases:
+        row = {"id": case["id"], "model": model, "voice": voice, "source": case["transcript"]}
+        clip = clips / f"{case['id']}.mp3"
+        if not clip.is_file():
+            row["stt_error"] = f"no clip at {clip.name}"
+        else:
+            start = clock()
+            try:
+                reply = post(url, clip.read_bytes())
+                row["heard"] = str(reply.get("text", "")).strip()
+                row["language"] = reply.get("language")
+            except Exception as e:
+                row["stt_error"] = f"{type(e).__name__}: {e}"
+            row["seconds"] = round(clock() - start, 2)
+        log(f"  {case['id']}: {row.get('stt_error') or repr(row['heard'])}")
+        rows.append(row)
+    return rows
+
+
+# --------------------------------------------------------------------------- sort
+
+def _is_rate_limit(error: str) -> bool:
+    return "429" in error or "RESOURCE_EXHAUSTED" in error
+
+
+def _is_daily(error: str) -> bool:
+    return _is_rate_limit(error) and bool(re.search(r"per ?day", error, re.I))
+
+
+def classify_heard(case: dict, heard: str, *, predict, sleep=time.sleep, log=print) -> dict:
+    """Sort one heard transcript with the case's own date. Returns {"items"} or {"error"}.
+
+    `predict(case_with_heard_text) -> {"items": [...]} or {"error": "..."}`. A rate limit
+    waits 60 s, any other error 10 s, at most MAX_TRIES calls. A daily quota raises.
+    """
+    asked = {**case, "transcript": heard}
+    pred: dict = {}
+    for attempt in range(1, MAX_TRIES + 1):
+        pred = predict(asked)
+        error = pred.get("error")
+        if not error:
+            return {"items": pred["items"], "tries": attempt}
+        if _is_daily(error):
+            raise DailyQuota(error[:300])
+        if attempt < MAX_TRIES:
+            wait = RATE_LIMIT_WAIT_S if _is_rate_limit(error) else OTHER_ERROR_WAIT_S
+            log(f"  {case['id']}: try {attempt} failed ({error[:80]}), waiting {wait:.0f} s")
+            sleep(wait)
+    return {"error": pred["error"][:300], "tries": MAX_TRIES}
+
+
+def run_sort(rows: list[dict], cases: list[dict], *, predict, delay: float = 5.0, save=lambda rows: None,
+             sleep=time.sleep, log=print) -> bool:
+    """Fill `items` (or `error`) on every row that has a transcript and no answer yet.
+
+    An empty transcript is not sent: POST /capture answers "No speech detected" and files
+    nothing, so the row gets items [] and no_speech true. Returns False if the daily quota
+    stopped the run.
+    """
+    by_id = {c["id"]: c for c in cases}
+    first = True
+    for row in rows:
+        if "items" in row or "heard" not in row:
+            continue
+        if not row["heard"]:
+            row.update(items=[], no_speech=True)
+            row.pop("error", None)
+            save(rows)
+            continue
+        if not first and delay:
+            sleep(delay)
+        first = False
+        try:
+            answer = classify_heard(by_id[row["id"]], row["heard"], predict=predict, sleep=sleep, log=log)
+        except DailyQuota as e:
+            log(f"daily quota reached at {row['id']}: {e}")
+            return False
+        row.pop("error", None)
+        row.update(answer)
+        save(rows)
+        log(f"  {row['id']}: {row.get('error') or str(len(row['items'])) + ' item(s)'}")
+    return True
+
+
+def real_predict(model: str | None):
+    """predict() backed by evals/run_eval.py: the real CaptureService._classify on Gemini."""
+    import run_eval
+
+    key = os.environ.get("GEMINI_API_KEY")
+    if not key:
+        raise SystemExit("GEMINI_API_KEY is not set; `sort` calls the real Gemini API.")
+
+    def predict(case: dict) -> dict:
+        return asyncio.run(run_eval.predict([case], model=model, api_key=key, concurrency=1,
+                                            backend="gemini", log=lambda _line: None))[0]
+
+    return predict
+
+
+# ------------------------------------------------------------------------- report
+
+def report(rows: list[dict], cases: list[dict], baseline: list[dict] | None = None) -> dict:
+    heard_rows = [r for r in rows if "heard" in r]
+    answered = [r for r in rows if "items" in r]
+    answered_ids = {r["id"] for r in answered}
+    scored = score.score([c for c in cases if c["id"] in answered_ids],
+                         [{"id": r["id"], "items": r["items"]} for r in answered])
+    passed = {r["id"]: r["passed"] for r in scored["results"]}
+    why = {r["id"]: r["why"] for r in scored["results"]}
+    out = {
+        "cases": len(cases),
+        "transcribed": len(heard_rows),
+        "stt_errors": [r["id"] for r in rows if "stt_error" in r],
+        "wer": wer(heard_rows),
+        "seconds": sorted(r["seconds"] for r in heard_rows if "seconds" in r),
+        "answered": len(answered),
+        "correct": scored["passed"],
+        "sort_errors": [r["id"] for r in rows if "heard" in r and "items" not in r],
+        "no_speech": [r["id"] for r in rows if r.get("no_speech")],
+        "failed": {i: why[i] for i, ok in passed.items() if not ok},
+        "flips": [],
+    }
+    if baseline is not None:
+        base = {r["id"]: r["passed"] for r in score.score(cases, baseline)["results"]}
+        per_clip = {p["id"]: p for p in out["wer"]["per_clip"]}
+        by_id = {r["id"]: r for r in rows}
+        for cid, ok in passed.items():
+            if ok != base[cid]:
+                out["flips"].append({
+                    "id": cid, "text_run": "pass" if base[cid] else "fail", "audio_run": "pass" if ok else "fail",
+                    "why": why[cid], "words_differ": per_clip[cid]["num_edits"],
+                    "source": by_id[cid]["source"], "heard": by_id[cid]["heard"],
+                })
+        out["baseline_passed_among_answered"] = sum(base[i] for i in passed)
+    return out
+
+
+def format_report(rep: dict, rows: list[dict]) -> str:
+    w, secs = rep["wer"], rep["seconds"]
+    out = [
+        f"clips transcribed   {rep['transcribed']}/{rep['cases']}"
+        + (f"  (failed: {', '.join(rep['stt_errors'])})" if rep["stt_errors"] else ""),
+        f"word error rate     raw {100 * w['wer_raw']:.1f}% ({w['raw_edits']}/{w['ref_words']} words), "
+        f"numbers normalised {100 * w['wer_num']:.1f}% ({w['num_edits']}/{w['ref_words']})",
+        f"clips word-perfect  raw {w['exact_raw']}/{w['clips']}, numbers normalised {w['exact_num']}/{w['clips']}",
+    ]
+    if secs:
+        out.append(f"seconds per clip    median {secs[len(secs) // 2]:.2f}, mean {sum(secs) / len(secs):.2f}, "
+                   f"max {secs[-1]:.2f}")
+    if not rep["answered"]:
+        out.append("end to end          not run (no row has been sorted)")
+    else:
+        out.append(f"end to end          answered {rep['answered']} of {rep['cases']}, correct {rep['correct']}"
+                   + (f"  (no answer: {', '.join(rep['sort_errors'])})" if rep["sort_errors"] else ""))
+    if rep["answered"] and "baseline_passed_among_answered" in rep:
+        out.append(f"same cases, clean text (stored run): correct {rep['baseline_passed_among_answered']}")
+    if rep["no_speech"]:
+        out.append(f"heard nothing       {', '.join(rep['no_speech'])}")
+    if rep["flips"]:
+        out += ["", f"FLIPS against the clean-text run ({len(rep['flips'])})"]
+        for f in rep["flips"]:
+            out += [f"- {f['id']}: text {f['text_run']} -> audio {f['audio_run']}"
+                    + (f"  <- {f['why']}" if f["why"] else "")
+                    + f"  [{f['words_differ']} word edit(s) after number normalisation]",
+                    f"    said:  {f['source']}", f"    heard: {f['heard']}"]
+    by_id = {r["id"]: r for r in rows}
+    worst = sorted((p for p in w["per_clip"] if p["num_edits"]), key=lambda p: -p["num_edits"])
+    if worst:
+        out += ["", f"MIS-HEARD CLIPS ({len(worst)}), most word edits first"]
+        for p in worst:
+            mark = "" if p["id"] not in rep["failed"] else "  [end to end: FAIL]"
+            out += [f"- {p['id']}: {p['num_edits']}/{p['ref_words']}{mark}",
+                    f"    said:  {by_id[p['id']]['source']}", f"    heard: {by_id[p['id']]['heard']}"]
+    return "\n".join(out)
+
+
+# --------------------------------------------------------------------------- main
+
+def main(argv: list[str] | None = None, *, post=http_post, predict=None, sleep=time.sleep) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--cases", default=str(CASES))
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("stt")
+    p.add_argument("--clips", required=True, help="directory of <case id>.mp3")
+    p.add_argument("--out", required=True)
+    p.add_argument("--server", default="http://127.0.0.1:8000")
+    p.add_argument("--model", default="", help="label only: the MODEL_NAME the server was started with")
+    p.add_argument("--voice", default="", help="label only: what spoke the clips")
+    p = sub.add_parser("sort")
+    p.add_argument("--results", required=True)
+    p.add_argument("--delay", type=float, default=5.0, help="seconds between calls (free tier: 15 a minute)")
+    p.add_argument("--sorter-model", default=None, help="Gemini model id (default: the service default)")
+    p = sub.add_parser("report")
+    p.add_argument("--results", required=True)
+    p.add_argument("--baseline", default=str(BASELINE), help="predictions from a run on the clean text")
+    args = ap.parse_args(argv)
+
+    cases = score.load_jsonl(args.cases)
+    problems = score.validate_cases(cases)
+    if problems:
+        print("cases file is malformed:\n  " + "\n  ".join(problems), file=sys.stderr)
+        return 2
+
+    if args.cmd == "stt":
+        rows = run_stt(cases, Path(args.clips), args.server, model=args.model, voice=args.voice, post=post)
+        write_rows(args.out, rows)
+        failed = [r["id"] for r in rows if "stt_error" in r]
+        print(f"wrote {args.out}: {len(rows) - len(failed)} transcribed, {len(failed)} failed")
+        return 1 if failed else 0
+
+    rows = score.load_jsonl(args.results)
+    if args.cmd == "sort":
+        done = run_sort(rows, cases, predict=predict or real_predict(args.sorter_model), delay=args.delay,
+                        save=lambda rs: write_rows(args.results, rs), sleep=sleep)
+        write_rows(args.results, rows)
+        if not done:
+            print("stopped on the daily quota; run `sort` again tomorrow, it resumes.", file=sys.stderr)
+            return 3
+        return 0
+
+    baseline = score.load_jsonl(args.baseline) if args.baseline and Path(args.baseline).is_file() else None
+    print(format_report(report(rows, cases, baseline), rows))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
