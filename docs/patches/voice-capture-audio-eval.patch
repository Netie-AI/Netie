+def test_rate_limit_waits_60s_and_retries():
+    replies = iter([{"error": "ClientError: 429 RESOURCE_EXHAUSTED per minute"}, {"items": [TASK]}])
+    slept = []
+    got = a.classify_heard(CASES[0], "x", predict=lambda _c: next(replies), sleep=slept.append, log=lambda _l: None)
+    assert got == {"items": [TASK], "tries": 2} and slept == [60.0]
