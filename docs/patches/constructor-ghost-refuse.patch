diff --git a/engine.js b/engine.js
index a3c5c05..7c27e78 100644
--- a/engine.js
+++ b/engine.js
@@ -148,6 +148,34 @@ function topo(state) {
   return Core.topo(state);
 }
 
+function ghostWalk(state, ghostFlag) {
+  const ir = compileIR(state);
+  if (ir.error) {
+    return { error: ir.error, log: [], order: [] };
+  }
+  const order = topo(state);
+  const log = [];
+  for (const id of order) {
+    const node = state.nodes.find((n) => n.id === id);
+    if (!node) continue;
+    const write = !ghostFlag && (node.kind === "tool_call" || node.kind === "app");
+    log.push({
+      id: node.id,
+      kind: node.kind,
+      cortex: CORTEX_KIND[node.kind],
+      hop: Core.hopForKind(node.kind),
+      ghost: ghostFlag || !write,
+      write: !!write,
+      would: node.note,
+      action_type: node.action_type || (node.kind === "tool_call" ? "export_pptx" : "agent.checked"),
+      object_type: node.object_type || null,
+      data_point: node.data_point || null,
+      fetch_from: node.fetch_from || null,
+    });
+  }
+  return { error: undefined, log: log, order: order };
+}
+
 function canvasIR(state) {
