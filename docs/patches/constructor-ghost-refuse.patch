diff --git a/tests/compiler.test.cjs b/tests/compiler.test.cjs
index db16b19..4d83e65 100644
--- a/tests/compiler.test.cjs
+++ b/tests/compiler.test.cjs
@@ -6,6 +6,7 @@ const {
   compileIR,
   rankForKinds,
   topo,
+  ghostWalk,
 } = require("../engine.js");
 
 test("foundry path ranks orchestrator-subagent first", () => {
@@ -122,3 +123,51 @@ test("duplicate id does not emit a fake Kahn walk", () => {
   assert.deepEqual(ir.nodes, []);
   assert.equal(ir.entry_node_id, null);
 });
+
+test("ghostWalk refuses a cycle instead of walking leftovers", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [
+        { id: "a", kind: "connector" },
+        { id: "b", kind: "ontology" },
+      ],
+      edges: [
+        { from: "a", to: "b" },
+        { from: "b", to: "a" },
+      ],
+    },
+    true
+  );
+  assert.equal(walked.error, "cycle");
+  assert.deepEqual(walked.log, []);
+  assert.deepEqual(walked.order, []);
+});
+
+test("ghostWalk refuses a dangling edge instead of inventing a step", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [{ id: "a", kind: "connector" }],
+      edges: [{ from: "a", to: "missing" }],
+    },
+    true
+  );
+  assert.equal(walked.error, "dangling edge");
+  assert.deepEqual(walked.log, []);
+});
+
+test("ghostWalk logs a valid DAG in topo order", () => {
+  const walked = ghostWalk(
+    {
+      nodes: [
+        { id: "c", kind: "connector", note: "in" },
+        { id: "a", kind: "app", note: "out" },
+      ],
+      edges: [{ from: "c", to: "a" }],
+    },
+    true
+  );
+  assert.equal(walked.error, undefined);
+  assert.deepEqual(walked.order, ["c", "a"]);
+  assert.equal(walked.log.length, 2);
+  assert.equal(walked.log[0].write, false);
+});
