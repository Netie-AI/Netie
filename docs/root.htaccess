# Keep the April Next.js homepage at /. Do not send / to /hire/.
# Hire, AIM, ASA, projects, and Next.js assets stay on their own URLs.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
# /suite/ is a small hub. Do not rewrite the homepage.
</IfModule>
