@@ -13,6 +13,47 @@ from collections.abc import MutableMapping
 from contextvars import ContextVar, Token
 from pathlib import Path
 
+#: User-visible product name of this fork (Netie DR-0002). Package and module names stay upstream.
+PRODUCT_NAME: str = "Crew Agent"
+
+#: Crew Agent (Netie DR-0002): OpenVault is the one model endpoint and the one gate. These live in
+#: this stdlib-only leaf so hermes_cli (including the installer tail) never imports the agent runtime.
+OPENVAULT_URL_ENV: str = "NETIE_OPENVAULT_URL"
+#: TAS-OPENVAULT: FreeRoute is OpenVault ``:5000/v1`` on the operator's machine.
+OPENVAULT_DEFAULT_URL: str = "http://127.0.0.1:5000"
+OPENVAULT_PROVIDER_ID: str = "openvault"
+#: ``model: auto`` is OpenVault's catalog pick (TAS-OPENVAULT section 4).
+OPENVAULT_DEFAULT_MODEL: str = "auto"
+
+
+def normalize_openvault_url(raw) -> str:
+    """The one NETIE_OPENVAULT_URL normaliser: blank or unset means the default origin,
+    surrounding whitespace and trailing slashes are dropped. Used by the gate and by the
+    ``${NETIE_OPENVAULT_URL}`` config expansion, so both always name the same origin."""
+    value = str(raw or "").strip()
+    return (value or OPENVAULT_DEFAULT_URL).rstrip("/")
+
+
+def raw_openvault_url():
+    """NETIE_OPENVAULT_URL as set: the active profile secret scope when one is installed,
+    else ``os.environ``. Same source as ``hermes_cli.config._env_ref_lookup_raw``."""
+    try:
+        from agent.secret_scope import current_secret_scope, get_secret
+    except Exception:
+        return os.environ.get(OPENVAULT_URL_ENV)
+    if current_secret_scope() is None:
+        return os.environ.get(OPENVAULT_URL_ENV)
+    return get_secret(OPENVAULT_URL_ENV)
+
+
+def openvault_url() -> str:
+    """OpenVault origin, no trailing slash. ``NETIE_OPENVAULT_URL`` wins over the default."""
+    return normalize_openvault_url(raw_openvault_url())
+
+
+def openvault_v1() -> str:
+    return openvault_url() + "/v1"
+
 _profile_fallback_warned: bool = False
 _UNSET = object()
 _HERMES_HOME_OVERRIDE: ContextVar[str | object] = ContextVar("_HERMES_HOME_OVERRIDE", default=_UNSET)
