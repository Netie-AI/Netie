index 00000000..f38d9728
--- /dev/null
+++ b/tests/netie/test_crew_agent_gate_r5_plugin.py
@@ -0,0 +1,167 @@
+"""Crew Agent stage 2 gate, round 5: plugin dispatch and the remaining direct tool callers.
+
+1. ``PluginContext.dispatch_tool`` (in-process plugins, and isolated plugins re-entering the parent
+   through the plugin host) asks the OpenVault crew gate before any registry tool runs.
+2. Telegram sticker analysis and the Anthropic image fallback label a refused vision call instead of
+   showing it as a description (and do not point the model at vision_analyze).
+3. TUI path completion in a non-local terminal backend asks the gate for ``terminal``.
+"""
+
+import asyncio
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tests.netie.test_crew_agent_gate import DEAD_OPENVAULT
+
+pytestmark = pytest.mark.netie_real_gate
+
+REFUSED_TERMINAL = "Crew Agent refused tool 'terminal'"
+REFUSED_VISION = "Crew Agent refused tool 'vision_analyze'"
+
+
+def _plugin_ctx():
+    from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+    return PluginContext(PluginManifest(name="netie-probe-plugin", source="user"), PluginManager())
+
+
+# 1. Plugin dispatch --------------------------------------------------------------------------
+
+def test_plugin_dispatch_tool_terminal_is_refused_and_the_command_never_runs(monkeypatch, tmp_path):
+    import tools.terminal_tool  # noqa: F401  (registers terminal)
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    marker = tmp_path / "ran"
+    out = json.loads(_plugin_ctx().dispatch_tool("terminal", {"command": f"touch {marker}"}))
+    assert not marker.exists()
+    assert REFUSED_TERMINAL in out["error"]
+    assert "OpenVault crew gate unreachable" in out["error"]
+    assert out["error_type"] == "netie_gate_refused"
+
+
+def test_plugin_dispatch_tool_terminal_runs_on_allow_and_asks_once(monkeypatch, tmp_path):
+    import tools.terminal_tool  # noqa: F401
+    from agent import netie_gate
+
+    asks = []
+    monkeypatch.setattr(netie_gate, "_post", lambda url, payload: asks.append(payload) or {"allowed": True})
+    marker = tmp_path / "ran"
+    out = json.loads(_plugin_ctx().dispatch_tool("terminal", {"command": f"touch {marker}"}))
+    assert marker.exists(), out
+    assert [a["id"] for a in asks] == ["tool.terminal"]
+    assert asks[0]["child_id"] == "plugin.netie-probe-plugin.terminal"
+    assert "touch" not in json.dumps(asks)
+
+
+ISOLATED_PLUGIN = '''
+def register(ctx):
+    ctx.register_tool(name="netie_iso_shell", toolset="netieiso", schema={"name": "netie_iso_shell",
+        "description": "d", "parameters": {"type": "object", "properties": {}}},
+        handler=lambda args, **kw: ctx.dispatch_tool("terminal", {"command": "touch " + args["path"]}))
+'''
+
+
+@pytest.mark.platforms("posix")
+def test_isolated_plugin_reentering_through_the_host_cannot_run_terminal(monkeypatch, tmp_path):
+    import tools.terminal_tool  # noqa: F401
+    from hermes_cli.plugins import PluginManager
+    from tests.hermes_cli.test_plugin_host import _home_with_plugins
+    from tools.registry import registry
+
+    _home_with_plugins(tmp_path, monkeypatch, {"netieiso": ISOLATED_PLUGIN})
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    manager = PluginManager()
+    manager.discover_and_load()
+    marker = tmp_path / "iso-ran"
+    try:
+        assert manager._plugins["netieiso"].error is None
+        # Outer plugin tool via the bare registry (as if already allowed); its nested call must ask.
+        out = registry.dispatch("netie_iso_shell", {"path": str(marker)}, scope=manager.scope_key)
+        assert REFUSED_TERMINAL in out
+        assert not marker.exists()
+    finally:
+        manager.unload()
+        manager._plugin_host().shutdown()
+
+
+# 2. Refused vision is labelled -------------------------------------------------------------
+
+def _no_vision_backend(monkeypatch):
+    import tools.vision_tools as vision_tools
+
+    calls = []
+
+    async def _prepare(*args, **kwargs):
+        calls.append(args)
+        raise AssertionError("the vision backend must not run")
+
+    monkeypatch.setattr(vision_tools, "_prepare_image", _prepare)
+    return calls
+
+
+def test_anthropic_image_fallback_labels_a_refusal_and_does_not_suggest_vision_analyze(monkeypatch):
+    from agent.vision_message_prep import VisionMessagePrepMixin
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    calls = _no_vision_backend(monkeypatch)
+    agent = SimpleNamespace(_anthropic_image_fallback_cache={})
+    note = VisionMessagePrepMixin._describe_image_for_anthropic_fallback(agent, "/tmp/netie-x.png", "user")
+    assert calls == []
+    assert note.startswith(f"[image not analysed: {REFUSED_VISION}")
+    assert "Here's what it contains" not in note
+    assert "vision_analyze with image_url" not in note
+    assert agent._anthropic_image_fallback_cache == {}  # a later allow is not masked
+
+
+def test_telegram_sticker_refusal_is_labelled(monkeypatch):
+    from tests.gateway.conftest import _ensure_telegram_mock
+
+    _ensure_telegram_mock()
+    from plugins.platforms.telegram import adapter as tg
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    calls = _no_vision_backend(monkeypatch)
+    monkeypatch.setattr(tg, "cache_image_from_bytes_async", lambda data, ext: asyncio.sleep(0, "/tmp/netie-s.webp"))
+    import gateway.sticker_cache as sticker_cache
+    monkeypatch.setattr(sticker_cache, "get_cached_description", lambda uid: None)
+    stored = []
+    monkeypatch.setattr(sticker_cache, "cache_sticker_description_async",
+                        lambda *a, **k: stored.append(a) or asyncio.sleep(0))
+
+    async def _download():
+        return bytearray(b"webp")
+
+    async def _get_file():
+        return SimpleNamespace(download_as_bytearray=_download)
+
+    sticker = SimpleNamespace(emoji="X", set_name="pack", is_animated=False, is_video=False,
+                              file_unique_id="uid-1", get_file=_get_file)
+    adapter = tg.TelegramAdapter.__new__(tg.TelegramAdapter)
+    adapter._accept_update = lambda: None
+    event = SimpleNamespace(text="")
+    asyncio.run(adapter._handle_sticker(SimpleNamespace(sticker=sticker), event))
+    assert calls == []
+    assert stored == []
+    assert event.text.startswith(f"[image not analysed: {REFUSED_VISION}")
+
+
+# 3. TUI path completion in a non-local backend ---------------------------------------------
+
+def test_tui_backend_path_completion_asks_the_gate_for_terminal(monkeypatch):
+    import tools.terminal_tool as terminal_tool
+    from tui_gateway import methods_complete
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    ran = []
+    monkeypatch.setattr(terminal_tool, "terminal_tool", lambda *a, **k: ran.append(a) or json.dumps(
+        {"output": "LEAKED\n", "exit_code": 0}))
+    assert methods_complete._backend_dir_entries("/srv", "sess-1") == []
+    assert ran == []
+
+    from agent import netie_gate
+    asks = []
+    monkeypatch.setattr(netie_gate, "_post", lambda url, payload: asks.append(payload["id"]) or {"allowed": True})
+    assert methods_complete._backend_dir_entries("/srv", "sess-1") == [("LEAKED", False)]
+    assert asks == ["tool.terminal"] and len(ran) == 1
diff --git a/tests/netie/test_crew_agent_gate_r5_small.py b/tests/netie/test_crew_agent_gate_r5_small.py
