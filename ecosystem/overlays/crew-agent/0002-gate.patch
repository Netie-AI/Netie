+def _responder(work: Path):
+    """Scripted by keyword in the last user message; the scenario tag rides into every reply."""
+    def respond(rec):
+        msgs = rec["body"].get("messages", [])
+        user = _last_user_text(msgs)
+        found = _MARK_RE.search(user.encode())
+        scen = found.group(2).decode() if found else "x"
+        if msgs and msgs[-1].get("role") == "tool":
+            return fake.Text(f"{_m('REPLY', scen)} after tool")
+        if "FAILTURN" in user:
+            return fake.Error(400, f"{_m('REPLY', scen)} bad request")
+        if "TOOLTURN" in user:
+            return fake.ToolCall("write_file", {"path": str(work / f"{scen}.txt"), "content": _m("ARG", scen)})
+        if "SKILLTURN" in user:
+            return fake.ToolCall("skill_view", {"name": "probe-skill"})
+        if "NETTURN" in user:
+            arg = _m("ARG", scen)
+            return fake.ToolCall("web_search", {"query": arg}, parallel=[
+                ("web_extract", {"urls": ["https://example.org/r6sweep"]}),
+                ("image_generate", {"prompt": arg}),
+                ("text_to_speech", {"text": arg}),
+                ("vision_analyze", {"image_url": "https://example.org/r6sweep.png", "question": arg}),
+                ("browser_navigate", {"url": "https://example.org/r6sweep"}),
+            ])
+        if "PADTURN" in user:
+            # A long reply the compressor can summarize away (user turns are kept verbatim).
+            return fake.Text(f"{_m('REPLY', scen)} " + "long reply padding for the compressor " * 60)
+        if "DELEGTURN" in user:
+            return fake.ToolCall("delegate_task", {"goal": f"{_m('ARG', scen)} summarize",
+                                                   "context": f"{_m('ARG', scen)} context"})
+        return fake.Text(f"{_m('REPLY', scen)} plain reply")
+    return respond
