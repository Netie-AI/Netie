+@pytest.mark.asyncio
+async def test_startup_refusal_is_queued_and_connects_on_a_later_allow(monkeypatch, tmp_path, caplog):
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.run import GatewayRunner
+    from gateway.status import flush_runtime_status
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    monkeypatch.setattr(GatewayRunner, "_start_free_tier_bootstrap", staticmethod(lambda: None))
+    runner = GatewayRunner(GatewayConfig(
+        platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="123:abc")},
+        sessions_dir=tmp_path / "sessions"))
+    created = []
+    runner._instantiate_adapter = lambda platform, config: created.append(platform) or _StubAdapter(platform)
+
+    def _state():
+        flush_runtime_status()
+        return json.loads((tmp_path / "gateway_state.json").read_text())["platforms"]["telegram"]
+
+    try:
+        with caplog.at_level("INFO"):
+            assert await runner.start() is True
+        logs = [r.getMessage() for r in caplog.records]
+        assert created == []
+        assert Platform.TELEGRAM in runner._failed_platforms  # queued for the reconnect watcher
+        state = _state()
+        assert state["state"] == "retrying" and state["error_code"] == "netie_leave_machine_refused"
+        assert LEAVE_LABEL in state["error_message"]
+        assert not any("No messaging platforms enabled" in m for m in logs)
+        assert any("queued for retry" in m and LEAVE_LABEL in m for m in logs)
+
+        # Watcher pass while OpenVault still refuses: stays queued and labelled, no adapter.
+        await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic() + 3600)
+        assert created == [] and Platform.TELEGRAM in runner._failed_platforms
+        assert _state()["error_code"] == "netie_leave_machine_refused"
+
+        # OpenVault allows: the next watcher pass connects it, no restart.
+        _allow(monkeypatch)
+
+        async def _connect_ok(adapter, platform, *, is_reconnect=False):
+            return True
+
+        runner._connect_adapter_with_timeout = _connect_ok
+        runner._failed_platforms[Platform.TELEGRAM]["next_retry"] = 0.0
+        await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic())
+        assert created == [Platform.TELEGRAM]
+        assert Platform.TELEGRAM in runner.adapters and Platform.TELEGRAM not in runner._failed_platforms
+        state = _state()
+        assert state["state"] == "connected" and state.get("error_code") is None
+    finally:
+        await runner.stop()
+
