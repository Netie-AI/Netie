+def test_enabled_gateway_does_not_start_without_leave_machine_allow(monkeypatch):
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.run import GatewayRunner
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner.config = GatewayConfig(platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="123:abc")})
+    statuses, created = [], []
+
+    async def _not_aborted():
+        return False
+
+    runner._abort_startup_if_shutdown_requested = _not_aborted
+    runner._multiplex_on = lambda: False
+    runner._update_platform_runtime_status = lambda platform, **kw: statuses.append((platform, kw))
+    runner._instantiate_adapter = lambda platform, config: created.append(platform)
+    runner._failed_platforms = {}
+
+    aborted, started, _skipped, pending = asyncio.run(runner._start_prefilter_platforms())
+    assert (aborted, started, pending) == (False, 1, [])
+    assert created == []
+    assert len(statuses) == 1
+    platform, status = statuses[0]
+    assert platform == "telegram"
+    assert status["error_code"] == "netie_leave_machine_refused"
+    assert status["platform_state"] == "retrying"  # queued: the watcher re-asks the gate
+    assert Platform.TELEGRAM in runner._failed_platforms
+    assert "messaging gateway 'telegram' is off" in status["error_message"]
+    # Direct _create_adapter callers hit its sync backstop. The async paths (startup, reconnect
+    # watcher, multiplexed profile start and secondary reconnect) ask off-loop through
+    # _netie_leave_refusal and then skip that backstop via _create_adapter_preallowed; they are
+    # covered in test_crew_agent_gate_gateways.py.
+    assert runner._create_adapter(Platform.TELEGRAM, runner.config.platforms[Platform.TELEGRAM]) is None
+    assert created == []
