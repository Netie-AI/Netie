index 00000000..b7d5e9b3
--- /dev/null
+++ b/tests/netie/test_crew_agent_gate_r6_sidestores.py
@@ -0,0 +1,327 @@
+"""Crew Agent stage 2 gate, round 6 (Netie, area: sidestores).
+
+SESSION side stores: outside the messages table a session leaves ids, counters and digests only.
+Each case drives the real writer and reads the real file or table it leaves behind.
+
+1. The classic CLI composer keeps typed prompts in memory: no HERMES_HOME/.hermes_history is
+   written unless ``display.persist_input_history`` opts in; an older build's file is left
+   untouched and named in one WARNING.
+2. The gateway delivery ledger blanks a reply's text once it is delivered (sha256 kept), keeps an
+   undelivered reply redeliverable, and blanks rows an older build left with text.
+3. TUI spawn-tree snapshots keep ids and counters only; /replay (spawn_tree.load) shows a labelled
+   notice in place of the text.
+4. spawn-ledger.json keeps an interactive run's program, subcommand and flag names, no prompt.
+5. /v1/runs with an Idempotency-Key stores no run output in runs_idempotency.db; the live GET still
+   returns it, and a GET after a restart says where the reply is.
+"""
+
+import asyncio
+import json
+import logging
+import os
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, write_hermes_home
+from tests.netie.test_crew_agent_gate_session import _QUIET, _home, _rows
+
+pytestmark = pytest.mark.netie_real_gate
+
+PROMPT_MARKER = "SIDEPROMPTMARK wire the escrow funds"
+REPLY_MARKER = "SIDEREPLYMARK the vault code is 7741"
+
+
+def _tree_text(root: Path) -> str:
+    return "\n".join(p.read_text(errors="replace") for p in sorted(root.rglob("*")) if p.is_file())
+
+
+# 1. Classic CLI input history ---------------------------------------------------------------
+
+def _cli_composer(monkeypatch, history_file, display=None):
+    from cli import HermesCLI
+
+    monkeypatch.setenv("HERMES_DEFER_AGENT_STARTUP", "1")
+    cli = HermesCLI(model="fixture", provider="openai-compat", api_key="fixture",
+                    base_url="http://127.0.0.1:1/v1")
+    cli._history_file = history_file
+    if display is not None:
+        cli.config = {**(cli.config or {}), "display": {**((cli.config or {}).get("display") or {}), **display}}
+    cli._tui_init_run_state()
+    return cli._tui_build_input_area()
+
+
+def _submit(editor, text):
+    editor.buffer.text = text
+    editor.buffer.append_to_history()
+
+
+def test_cli_composer_keeps_typed_prompts_in_memory_and_leaves_an_old_history_file(
+        monkeypatch, tmp_path, caplog):
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["display"]["persist_input_history"] is False
+    history = tmp_path / ".hermes_history"
+    editor = _cli_composer(monkeypatch, history)
+    _submit(editor, PROMPT_MARKER)
+    assert PROMPT_MARKER in list(editor.buffer.history.get_strings())  # recall works in this run
+    assert not history.exists()
+
+    old = b"\n# 2026-01-01 00:00:00\n+an older build's prompt\n"
+    history.write_bytes(old)
+    caplog.set_level(logging.WARNING)
+    editor = _cli_composer(monkeypatch, history)
+    _submit(editor, PROMPT_MARKER)
+    assert history.read_bytes() == old  # never appended to, never deleted
+    warnings = [r.getMessage() for r in caplog.records if r.levelno == logging.WARNING
+                and str(history) in r.getMessage()]
+    assert len(warnings) == 1 and f"rm {history}" in warnings[0], warnings
+
+    opted = tmp_path / "opted" / ".hermes_history"
+    opted.parent.mkdir()
+    editor = _cli_composer(monkeypatch, opted, display={"persist_input_history": True})
+    _submit(editor, PROMPT_MARKER)
+    assert PROMPT_MARKER in opted.read_text()
+
+
+def test_profile_clone_all_does_not_carry_the_input_history(tmp_path):
+    from hermes_cli import profiles
+
+    src, dst = tmp_path / "src", tmp_path / "dst"
+    src.mkdir()
+    (src / "config.yaml").write_text("model: {}\n")
+    (src / ".hermes_history").write_text(f"+{PROMPT_MARKER}\n")
+    profiles._clone_all_into(src, dst, "dst")
+    assert (dst / "config.yaml").exists()
+    assert not (dst / ".hermes_history").exists()
+    assert (src / ".hermes_history").exists()
+
+
+# 2. Gateway delivery ledger -----------------------------------------------------------------
+
+def _ledger_adapter(send_result):
+    from gateway.config import Platform, PlatformConfig
+    from gateway.platforms.base import BasePlatformAdapter
+
+    class _Adapter(BasePlatformAdapter):
+        def __init__(self):
+            super().__init__(PlatformConfig(enabled=True), Platform.SLACK)
+            self.sent = []
+
+        async def connect(self, *, is_reconnect: bool = False):
+            return True
+
+        async def disconnect(self):
+            return None
+
+        async def get_chat_info(self, chat_id):
+            return None
+
+        async def send(self, chat_id, content, reply_to=None, metadata=None):
+            self.sent.append(content)
+            return send_result
+
+    return _Adapter()
+
+
+async def _gateway_turn(adapter, message_id, reply):
+    from unittest.mock import AsyncMock
+
+    from gateway.config import Platform
+    from gateway.platforms.event import MessageEvent, MessageType
+    from gateway.session import SessionSource
+
+    event = MessageEvent(text="hello agent", message_type=MessageType.TEXT, message_id=message_id,
+                         source=SessionSource(platform=Platform.SLACK, chat_id="C1", chat_type="channel"))
+    adapter._message_handler = AsyncMock(return_value=reply)
+    session_key = "agent:main:slack:channel:C1"
+    adapter._active_sessions[session_key] = asyncio.Event()
+    await adapter._process_message_background(event, session_key)
+
+
+@pytest.mark.asyncio
+async def test_delivery_ledger_blanks_delivered_text_and_keeps_undelivered_redeliverable(monkeypatch):
+    import hashlib
+
+    from gateway import delivery_ledger as dl
+    from gateway.platforms.base import SendResult
+
+    db_path = dl._db_path()
+    assert str(db_path).startswith(str(_home()))
+    ok = _ledger_adapter(SendResult(success=True, message_id="m1"))
+    await _gateway_turn(ok, "msg-1", REPLY_MARKER)
+    assert ok.sent == [REPLY_MARKER]
+    rows = _rows(db_path, "SELECT state, content, content_sha256, session_key FROM delivery_obligations")
+    assert [(r["state"], r["content"]) for r in rows] == [("delivered", "")]
+    assert rows[0]["content_sha256"] == hashlib.sha256(REPLY_MARKER.encode()).hexdigest()
+    assert REPLY_MARKER.encode() not in db_path.read_bytes()
+
+    # A crash-left copy of the same delivered reply is still recognised: no second row, no resend.
+    dl.record_crash_left_reply(obligation_id="crash-1", session_key=rows[0]["session_key"], platform="slack",
+                               chat_id="C1", thread_id=None, content=REPLY_MARKER, since=0)
+    assert len(_rows(db_path, "SELECT 1 FROM delivery_obligations")) == 1
+
+    # An undelivered reply keeps its text and is redelivered after a crash.
+    owed = "SIDEOWEDMARK the reply still owed"
+    failing = _ledger_adapter(SendResult(success=False, error="network timeout"))
+    await _gateway_turn(failing, "msg-2", owed)
+    owed_row = _rows(db_path, "SELECT obligation_id, state, content FROM delivery_obligations WHERE content != ''")
+    assert [(r["state"], r["content"]) for r in owed_row] == [("failed", owed)]
+    with sqlite3.connect(db_path) as conn:  # the owning gateway died
+        conn.execute("UPDATE delivery_obligations SET owner_pid = NULL WHERE obligation_id = ?",
+                     (owed_row[0]["obligation_id"],))
+    claimed = dl.sweep_recoverable()
+    assert [c["content"] for c in claimed] == [owed]
+    dl.mark_delivered(claimed[0]["obligation_id"])
+    assert _rows(db_path, "SELECT content FROM delivery_obligations WHERE content != ''") == []
+
+    # A delivered row an older build left with text is blanked at the next ledger write.
+    with sqlite3.connect(db_path) as conn:
+        conn.execute(
+            "INSERT INTO delivery_obligations (obligation_id, session_key, platform, chat_id, content, state,"
+            " attempts, created_at, updated_at) VALUES ('legacy', 'k', 'slack', 'C1', ?, 'delivered', 1, 1, ?)",
+            ("SIDELEGACYMARK old reply", __import__("time").time()))
+    await _gateway_turn(ok, "msg-3", "third reply")
+    legacy = _rows(db_path, "SELECT content, content_sha256 FROM delivery_obligations WHERE obligation_id='legacy'")
+    assert legacy == [{"content": "", "content_sha256": hashlib.sha256(b"SIDELEGACYMARK old reply").hexdigest()}]
+
+
+# 3. TUI spawn-tree snapshots ----------------------------------------------------------------
+
+def _subagent(i, marker):
+    return {"id": f"sa-{i}", "parentId": None, "depth": 0, "index": i, "status": "completed",
+            "taskCount": 2, "toolCount": 3, "inputTokens": 120, "outputTokens": 40, "durationSeconds": 1.5,
+            "goal": f"{marker} goal", "summary": f"{marker} summary", "thinking": [f"{marker} thinking"],
+            "notes": [f"{marker} note"], "tools": [f"terminal {marker}"], "model": "fake-model",
+            "filesRead": [f"/tmp/{marker}.txt"],
+            "outputTail": [{"tool": "terminal", "preview": f"{marker} output", "isError": False}]}
+
+
+def test_spawn_tree_snapshot_keeps_ids_and_counters_and_replay_is_labelled(monkeypatch, caplog):
+    import tui_gateway.server as srv
+
+    marker = "SIDETREEMARK"
+    root = srv._spawn_trees_root()
+    legacy_dir = root / "old-session"
+    legacy_dir.mkdir()
+    (legacy_dir / "_index.jsonl").write_text(json.dumps({"label": "older goal text", "count": 1}) + "\n")
+    caplog.set_level(logging.WARNING)
+
+    saved = srv._methods["spawn_tree.save"](1, {
+        "session_id": "sess-tree", "label": f"{marker} label", "started_at": 1.0,
+        "subagents": [_subagent(0, marker), _subagent(1, marker)]})
+    assert "error" not in saved, saved
+    text = _tree_text(root / "sess-tree")
+    assert text and marker not in text and "fake-model" not in text
+    snapshot = json.loads(Path(saved["result"]["path"]).read_text())
+    assert snapshot["subagents"][0] == {"id": "sa-0", "parentId": None, "depth": 0, "index": 0,
+                                        "status": "completed", "taskCount": 2, "toolCount": 3,
+                                        "inputTokens": 120, "outputTokens": 40, "durationSeconds": 1.5}
+
+    listed = srv._methods["spawn_tree.list"](2, {"session_id": "sess-tree"})["result"]["entries"]
+    assert [(e["label"], e["count"]) for e in listed] == [("", 2)]
+    loaded = srv._methods["spawn_tree.load"](3, {"path": saved["result"]["path"]})["result"]
+    first = loaded["subagents"][0]
+    assert first["goal"].startswith("[not stored:") and "ids and counters only" in first["goal"]
+    assert first["notes"] == first["thinking"] == first["tools"] == []
+
+    assert (legacy_dir / "_index.jsonl").read_text().startswith('{"label": "older goal text"')
+    warnings = [r.getMessage() for r in caplog.records if "old-session" in r.getMessage()]
+    assert len(warnings) == 1 and f"rm -r {root}" in warnings[0], warnings
+
+
+# 4. spawn-ledger.json -----------------------------------------------------------------------
+
+def test_spawn_ledger_keeps_no_prompt_of_an_interactive_run(monkeypatch, tmp_path):
+    from hermes_cli import process_identity as pi
+
+    ledger = tmp_path / "spawn-ledger.json"
+    monkeypatch.setattr(pi, "_ledger_path", lambda: ledger)
+    monkeypatch.setattr(sys, "argv", ["hermes", "chat", "-q", PROMPT_MARKER, "--model=SIDEMODELMARK",
+                                      "--resume", "20260101_000000_abc", "-bad prompt text"])
+    assert pi.register_self("cli") is True
+    raw = ledger.read_text()
+    assert "SIDEPROMPTMARK" not in raw and "SIDEMODELMARK" not in raw and "bad prompt" not in raw
+    assert "20260101_000000_abc" not in raw
+    cli_entry = [e for e in json.loads(raw) if e.get("purpose") == "cli"]
+    assert [e["argv"] for e in cli_entry] == ["hermes chat -q --model --resume"]
+
+    monkeypatch.setattr(sys, "argv", ["hermes", "serve", "--host", "127.0.0.1", "--port", "9119"])
+    assert pi.register_self("serve") is True
+    serve = [e for e in json.loads(ledger.read_text()) if e.get("purpose") == "serve"]
+    assert serve and serve[0]["argv"] == "hermes serve --host 127.0.0.1 --port 9119"
+
+
+# 5. /v1/runs idempotency store --------------------------------------------------------------
+
+async def _wait_run(cli, run_id):
+    for _ in range(300):
+        status = await (await cli.get(f"/v1/runs/{run_id}")).json()
+        if status.get("status") in ("completed", "failed", "cancelled"):
+            return status
+        await asyncio.sleep(0.05)
+    return status
+
+
+@pytest.mark.asyncio
+async def test_idempotent_run_stores_no_output_and_a_restarted_get_is_labelled(monkeypatch, caplog):
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+    from tests.netie.test_crew_agent_gate_session import _api_app
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+
+    def _app(adapter):
+        app = _api_app(adapter)
+        app.router.add_post("/v1/runs", adapter._handle_runs)
+        app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+        return app
+
+    with FakeLLMServer([Text(REPLY_MARKER)]) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+        try:
+            async with TestClient(TestServer(_app(adapter))) as cli:
+                run = await cli.post("/v1/runs", json={"input": PROMPT_MARKER}, headers={"Idempotency-Key": "k1"})
+                body = await run.json()
+                assert run.status == 202, body
+                live = await _wait_run(cli, body["run_id"])
+        finally:
+            await adapter.disconnect()
+    assert live.get("status") == "completed" and live.get("output") == REPLY_MARKER, live
+    db_path = home / "runs_idempotency.db"
+    stored = [json.loads(r["status_json"]) for r in _rows(db_path, "SELECT status_json FROM run_idempotency")]
+    assert len(stored) == 1 and stored[0]["status"] == "completed", stored
+    for key in ("output", "error", "pending_steer", "approval"):
+        assert key not in stored[0], stored[0]
+    for suffix in ("", "-wal"):
+        if (db_path.parent / (db_path.name + suffix)).exists():
+            assert b"SIDEREPLYMARK" not in (db_path.parent / (db_path.name + suffix)).read_bytes()
+
+    # After a restart, GET reads the durable record: ids and status, plus where the reply is.
+    restarted = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    try:
+        async with TestClient(TestServer(_app(restarted))) as cli:
+            again = await (await cli.get(f"/v1/runs/{body['run_id']}")).json()
+    finally:
+        await restarted.disconnect()
+    assert again.get("status") == "completed" and "output" not in again, again
+    session_id = stored[0].get("session_id")
+    assert session_id and f"session {session_id}" in again.get("netie_note", ""), again
+
+    # A record an older build stored with run output is named, never deleted.
+    with sqlite3.connect(db_path) as conn:
+        conn.execute("UPDATE run_idempotency SET status_json = ?",
+                     (json.dumps({"status": "completed", "output": "SIDELEGACYMARK"}),))
+    caplog.set_level(logging.WARNING)
+    from gateway.platforms.api_server_run_idempotency import RunIdempotencyStore
+    store = RunIdempotencyStore(str(db_path))
+    store.close()
+    assert "SIDELEGACYMARK" in _rows(db_path, "SELECT status_json FROM run_idempotency")[0]["status_json"]
+    assert any(str(db_path) in r.getMessage() and "older build" in r.getMessage() for r in caplog.records)
+    assert os.path.exists(db_path)
