+"""Crew Agent stage 2 gate, round 5 (Netie, area: chain).
+
+Asserts what the API caller, the gateway operator and the log reader actually receive:
+
+1. ``previous_response_id`` chains are rebuilt from the exact messages-table rows of the chain,
+   so two responses branching from one parent never mix histories; a deleted row is a labelled
+   409, never a silently shorter history.
+2. A human gateway turn under the real logging setup leaves no user or reply-to text in
+   agent.log or gateway.log (the inbound-message INFO line carries lengths and digests).
+3. The /v1/runs chain read and the streaming snapshots do no sync DB read on the event loop.
+4. Gateway prompt pins of a shared group session re-render from the pinning speaker after a
+   restart, so the internal turn gets the same bytes and no re-pin.
+5. A legacy gateway_routing row with prompt bodies is scrubbed on routing-table load.
+"""
+
+import json
+import logging
+import sqlite3
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, write_hermes_home
+from tests.netie.test_crew_agent_gate_session import _QUIET, _api_app, _home, _sqlite_dump
+
+pytestmark = pytest.mark.netie_real_gate
+
+
+def _user_texts(request):
+    return [m.get("content") for m in request["messages"]
+            if m.get("role") in ("user", "assistant") and isinstance(m.get("content"), str)]
+
+
+async def _post(cli, payload):
+    resp = await cli.post("/v1/responses", json=payload)
+    body = await resp.json()
+    assert resp.status == 200, body
+    return body
+
+
+# 1. Branching chains -------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_two_branches_from_one_parent_each_chain_only_their_own_history(monkeypatch):
+    """A answers UA; B and C both chain on A; D chains on C. D's model request carries only
+    A and C's turns, B's turn never leaks in, and GET on B still returns B's reply. Deleting one
+    row of C's chain makes a chain on D a labelled 409 with no model call."""
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    script = [Text("A1 reply"), Text("B1 reply"), Text("C1 reply"), Text("D1 reply")]
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                a = await _post(cli, {"input": "UA first"})
+                b = await _post(cli, {"input": "UB branch one", "previous_response_id": a["id"]})
+                c = await _post(cli, {"input": "UC branch two", "previous_response_id": a["id"]})
+                d = await _post(cli, {"input": "UD after two", "previous_response_id": c["id"],
+                                      "stream": False})
+                got_b = await (await cli.get(f"/v1/responses/{b['id']}")).json()
+                # One row of C's chain (C's reply) is deleted: chaining on D is refused.
+                conn = sqlite3.connect(home / "state.db")
+                conn.execute("DELETE FROM messages WHERE role = 'assistant' AND content LIKE 'C1%'")
+                conn.commit()
+                conn.close()
+                refused = await cli.post("/v1/responses", json={
+                    "input": "UE after deletion", "previous_response_id": d["id"]})
+                refused_body = await refused.json()
+        finally:
+            await adapter.disconnect()
+    requests = srv.main_requests()
+    assert _user_texts(requests[2]) == ["UA first", "A1 reply", "UC branch two"]
+    assert _user_texts(requests[3]) == ["UA first", "A1 reply", "UC branch two", "C1 reply",
+                                        "UD after two"]
+    assert "B1 reply" in json.dumps(got_b["output"])
+    assert refused.status == 409, refused_body
+    assert refused_body["error"]["code"] == "response_chain_not_rebuildable"
+    assert "deleted or inactive" in refused_body["error"]["message"]
+    assert d["id"] in refused_body["error"]["message"]
+    assert len(requests) == 4
+    store_dump = _sqlite_dump(home / "response_store.db")
+    for marker in ("UA first", "A1 reply", "UC branch", "C1 reply", "D1 reply"):
+        assert marker not in store_dump, marker
+
+
+@pytest.mark.asyncio
+async def test_streamed_branch_chains_only_its_own_history(monkeypatch):
+    """The same branching through the streaming path: B and a streamed S both chain on A (B
+    first); a chain on S carries A and the streamed turn only, never the sibling B."""
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    script = [Text("A1 reply"), Text("B1 sibling"), Text("S1 streamed"), Text("S2 reply")]
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                a = await _post(cli, {"input": "UA first"})
+                await _post(cli, {"input": "UB sibling", "previous_response_id": a["id"]})
+                streamed = await cli.post("/v1/responses", json={
+                    "input": "US streamed", "previous_response_id": a["id"], "stream": True})
+                raw = (await streamed.read()).decode()
+                sid = next(json.loads(line[6:])["response"]["id"] for line in raw.splitlines()
+                           if line.startswith("data: ") and '"response.completed"' in line)
+                await _post(cli, {"input": "US2 next", "previous_response_id": sid})
+        finally:
+            await adapter.disconnect()
+    assert _user_texts(srv.main_requests()[3]) == ["UA first", "A1 reply", "US streamed",
+                                                   "S1 streamed", "US2 next"]
+
