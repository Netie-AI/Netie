+
+    SessionDB(db_path=db_path).close()  # the next Crew Agent start opens the shared state.db
+
+    bodies = _rows(db_path, "SELECT hash, prompt FROM system_prompts")
+    sessions = {r["id"]: r for r in _rows(db_path, "SELECT * FROM sessions")}
+    pin_hash = sessions["sess-old"]["tool_names"]
+    assert [b["prompt"] for b in bodies if b["hash"] == pin_hash] == [PIN]
+    assert all(b["prompt"] == "" for b in bodies if b["hash"] != pin_hash), bodies
+    assert all(r["system_prompt"] is None for r in sessions.values())
+    assert sessions["sess-old"]["system_prompt_hash"] and sessions["sess-inline"]["system_prompt_hash"]
+    dump = repr(bodies) + repr(sessions)
+    assert "SOUL-BODY-MARKER" not in dump and "SKILL-BODY-MARKER" not in dump
