+class _StubAdapter:
+    """A connectable adapter that never reaches a real platform."""
+
+    def __init__(self, platform):
+        self.platform = platform
+        self.send_path_degraded = False
+        self.DEGRADED_STATUS_MESSAGE = "degraded"
+        self.has_fatal_error = False
+        self.fatal_error_retryable = True
+        self.fatal_error_code = None
+        self.fatal_error_message = None
+        self.disconnected = False
+
+    def __getattr__(self, name):  # set_* wiring hooks
+        if name.startswith("set_") or name.startswith("_"):
+            return lambda *a, **k: None
+        raise AttributeError(name)
+
+    async def disconnect(self):
+        self.disconnected = True
+
+    async def cancel_background_tasks(self):
+        return None
