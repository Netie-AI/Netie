@@ -1590,12 +1590,75 @@ def _api_error_debug_info(error: Exception) -> Dict[str, Any]:
     return info
 
 
+#: Request body keys that carry prompt, transcript or tool-schema text.
+_DUMP_CONTENT_KEYS = frozenset({"messages", "input", "system", "instructions", "tools", "prompt"})
+
+
+def _ids_only_request_body(body: Dict[str, Any]) -> Dict[str, Any]:
+    """Netie SESSION: the dump keeps ids, counts and digests, never prompt or transcript text.
+    Scalars (model, temperature, max_tokens, ...) stay; messages/input become one
+    ``{role, len, sha256}`` per item; every other content key or structured value becomes a digest."""
+    from agent.netie_ids import IDS_ONLY_MARKER, digest
+
+    reduced: Dict[str, Any] = {IDS_ONLY_MARKER: True}
+    for key, value in body.items():
+        if key in ("messages", "input") and isinstance(value, list):
+            reduced[key] = [
+                {"role": (item.get("role") or item.get("type")) if isinstance(item, dict) else type(item).__name__,
+                 **digest(item)}
+                for item in value]
+        elif key in _DUMP_CONTENT_KEYS or isinstance(value, (dict, list, tuple)):
+            reduced[key] = {**({"count": len(value)} if isinstance(value, (list, tuple)) else {}), **digest(value)}
+        else:
+            reduced[key] = value
+    return reduced
+
+
+#: Error fields a provider may fill with an echo of the request (prompt or transcript text).
+_ERROR_ECHO_KEYS = ("body", "response_text")
+
+
+def _ids_only_error_info(info: Dict[str, Any]) -> Dict[str, Any]:
+    """Netie SESSION: keep status code, error type and a short message; digest the provider's error
+    body and response text, and cut their echo out of the message (the SDK message embeds the body)."""
+    from agent.netie_ids import IDS_ONLY_MARKER, digest
+
+    reduced: Dict[str, Any] = {IDS_ONLY_MARKER: True}
+    original = message = str(info.get("message") or "")
+    cut = False
+    for key, value in info.items():
+        if key in _ERROR_ECHO_KEYS:
+            reduced[f"{key}_digest"] = digest(value)
+            if str(value) and str(value) in message:
+                message, cut = message.replace(str(value), f"<{key} digested>"), True
+        elif key != "message":
+            reduced[key] = value
+    if cut:
+        reduced["message"] = message if len(message) <= 200 else message[:200] + "...[truncated]"
+        return reduced
+    # No echo found to cut out (other SDKs, body None, transport errors): any of the message may
+    # be an echo, so keep only a fixed "Error code: NNN" prefix and digest the rest.
+    prefix = re.match(r"\s*(Error code: \d{3})", original)
+    status = info.get("status_code")
+    reduced["message"] = prefix.group(1) if prefix else (
+        f"Error code: {status}" if isinstance(status, int) else str(info.get("type") or "error"))
+    if original:
+        reduced["message_digest"] = digest(original)
+    return reduced
+
