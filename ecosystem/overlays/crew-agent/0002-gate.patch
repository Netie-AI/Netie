+# Network guard ------------------------------------------------------------------------------
+
+def _is_loopback(host) -> bool:
+    h = host.decode() if isinstance(host, bytes) else host
+    if h in (None, "", "localhost", "0.0.0.0"):
+        return True
+    h = str(h).split("%", 1)[0]
+    return h.startswith("127.") or h in ("::1", "::") or h.startswith("::ffff:127.")
+
+
+@pytest.fixture
+def netguard(monkeypatch):
+    """Record and refuse every non-loopback DNS lookup and socket connect in this process."""
+    attempts = []
+
+    def record(kind, host, port):
+        stack = [f"{f.filename}:{f.lineno} {f.name}" for f in traceback.extract_stack(limit=60)[:-2]]
+        attempts.append({"kind": kind, "host": str(host), "port": port,
+                         "stack": [s for s in stack if "/site-packages/" not in s][-12:]})
+
+    real_getaddrinfo = socket.getaddrinfo
+    real_connect = socket.socket.connect
+    real_connect_ex = socket.socket.connect_ex
+    real_sendto = socket.socket.sendto
+
+    def getaddrinfo(host, port, *a, **k):
+        if not _is_loopback(host):
+            record("dns", host, port)
+            raise socket.gaierror(socket.EAI_NONAME, f"netguard refused DNS for {host}")
+        return real_getaddrinfo(host, port, *a, **k)
+
+    def gethostbyname(host, *a, **k):
+        if not _is_loopback(host):
+            record("dns", host, None)
+            raise socket.gaierror(socket.EAI_NONAME, f"netguard refused DNS for {host}")
+        return "127.0.0.1"
+
+    def connect(self, addr):
+        if isinstance(addr, tuple) and not _is_loopback(addr[0]):
+            record("connect", addr[0], addr[1])
+            raise ConnectionRefusedError(f"netguard refused connect to {addr[0]}:{addr[1]}")
+        return real_connect(self, addr)
+
+    def connect_ex(self, addr):
+        if isinstance(addr, tuple) and not _is_loopback(addr[0]):
+            record("connect", addr[0], addr[1])
+            return 111
+        return real_connect_ex(self, addr)
+
+    def sendto(self, data, *args):
+        # sendto(data, address) or sendto(data, flags, address): UDP leaves without connect().
+        addr = args[-1] if args else None
+        if isinstance(addr, tuple) and not _is_loopback(addr[0]):
+            record("sendto", addr[0], addr[1])
+            raise ConnectionRefusedError(f"netguard refused sendto {addr[0]}:{addr[1]}")
+        return real_sendto(self, data, *args)
+
+    monkeypatch.setattr(socket, "getaddrinfo", getaddrinfo)
+    monkeypatch.setattr(socket, "gethostbyname", gethostbyname)
+    monkeypatch.setattr(socket.socket, "connect", connect)
+    monkeypatch.setattr(socket.socket, "connect_ex", connect_ex)
+    monkeypatch.setattr(socket.socket, "sendto", sendto)
+    for k in ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy", "ALL_PROXY", "all_proxy"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setenv("NO_PROXY", "127.0.0.1,localhost")
+    return attempts
