+"""Crew Agent stage 2 gate, round 6 leftovers (Netie).
+
+What the API caller, the operator and the user receive:
+
+1. A /v1/responses turn whose input array has more than one item (chained or not), and a turn
+   sent with inline ``conversation_history`` on a new session, persist those extra items as
+   messages-table rows with the turn, so a later ``previous_response_id`` chain from it is
+   served and replays exactly that history (no 409). The persisted prompt-pin source keeps
+   only what the re-render reads (no chat topic, no auto-thread name).
+2. A session export whose prompt row is missing imports with a NULL prompt id and no new
+   system_prompts row; an ids-only export ('' body) keeps its id.
+3. ``hermes --tui --provider auto`` (HERMES_TUI_PROVIDER=auto) starts on the OpenVault default
+   instead of failing with "provider 'auto' has no endpoint configured". A model.base_url that
+   is the OpenVault URL wins over a vendor HERMES_INFERENCE_PROVIDER (pinned order).
+4. Unserving a profile whose secondary is queued on a gate refusal restamps gateway_state
+   running; a hot-add reusing a token that a reconnect holds mid-connect is parked
+   duplicate_credential, not a second poller.
+"""
+
+import json
+import sqlite3
+import time
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, write_hermes_home
+from tests.netie.test_crew_agent_gate_session import _QUIET, _api_app, _home, _sqlite_dump
+
+pytestmark = pytest.mark.netie_real_gate
+
+
+def _texts(request):
+    return [(m.get("role"), m.get("content")) for m in request["messages"]
+            if m.get("role") != "system" and isinstance(m.get("content"), str)]
+
+
+async def _post(cli, payload):
+    resp = await cli.post("/v1/responses", json=payload)
+    body = await resp.json()
+    assert resp.status == 200, body
+    return body
+
+
+# 1. Multi-item input and inline history can be chained again ---------------------------------
+
+@pytest.mark.asyncio
+async def test_multi_item_input_and_inline_history_turns_can_be_chained_again(monkeypatch):
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    script = [Text("A1 reply"), Text("B1 reply"), Text("C1 reply"), Text("H1 reply"), Text("H2 reply"),
+              Text("M1 reply"), Text("M2 reply")]
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                a = await _post(cli, {"input": "UA first"})
+                b = await _post(cli, {"previous_response_id": a["id"], "input": [
+                    {"role": "user", "content": "UB extra one"},
+                    {"role": "assistant", "content": "AB injected"},
+                    {"role": "user", "content": "UB last"}]})
+                c = await _post(cli, {"previous_response_id": b["id"], "input": "UC after multi"})
+                h = await _post(cli, {"input": "UH last", "conversation_history": [
+                    {"role": "user", "content": "UH0 inline"},
+                    {"role": "assistant", "content": "AH0 inline"}]})
+                h2 = await _post(cli, {"previous_response_id": h["id"], "input": "UH2 after inline"})
+                m = await _post(cli, {"input": ["UM0 first item", "UM1 last item"]})
+                m2 = await _post(cli, {"previous_response_id": m["id"], "input": "UM2 after"})
+                got_c = await (await cli.get(f"/v1/responses/{c['id']}")).json()
+        finally:
+            await adapter.disconnect()
+    requests = srv.main_requests()
+    assert _texts(requests[2]) == [
+        ("user", "UA first"), ("assistant", "A1 reply"), ("user", "UB extra one"),
+        ("assistant", "AB injected"), ("user", "UB last"), ("assistant", "B1 reply"),
+        ("user", "UC after multi")]
+    assert _texts(requests[4]) == [
+        ("user", "UH0 inline"), ("assistant", "AH0 inline"), ("user", "UH last"),
+        ("assistant", "H1 reply"), ("user", "UH2 after inline")]
+    # Two consecutive user items reach the model joined (as upstream's alternation repair joins
+    # them), on the first turn and on the replay alike.
+    assert _texts(requests[6]) == [("user", "UM0 first item\n\nUM1 last item"), ("assistant", "M1 reply"),
+                                   ("user", "UM2 after")]
+    assert c["output"] and h2["output"] and m2["output"]
+    assert "C1 reply" in json.dumps(got_c["output"])
+    store_dump = _sqlite_dump(home / "response_store.db")
+    for marker in ("UB extra one", "AB injected", "UH0 inline", "UM0 first"):
+        assert marker not in store_dump, marker
+    # The injected items are transcript rows of their sessions (the declared store), once each.
+    conn = sqlite3.connect(home / "state.db")
+    rows = [r[0] for r in conn.execute("SELECT content FROM messages ORDER BY id")]
+    conn.close()
+    for marker in ("UB extra one", "AB injected", "UH0 inline", "AH0 inline",
+                   "UM0 first item\n\nUM1 last item"):
+        assert rows.count(marker) == 1, (marker, rows)
+    assert "UM1 last item" not in rows, rows  # the joined turn is held once
+
