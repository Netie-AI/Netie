+"""Crew Agent stage 2 gate, round 7 input persistence (Netie).
+
+What the API caller, the operator and the user receive:
+
+1. A stateless frontend (Open WebUI style) that declares X-Hermes-Session-Key and resends its
+   whole conversation in ``input`` every turn gets one transcript row per turn message, never a
+   copy of the earlier turns per request. A chain from such a response is the labelled 409 that
+   names why. A chained multi-item turn with store=true can be chained again with the right
+   history; a store=false turn (chained or not) writes no rows for its extra input items.
+2. ``hermes --tui --provider auto`` then /model: the switch metric names the route the session
+   left (openvault), not ``auto``.
+3. Unserving a profile while its cancelled reconnect is still waiting on the gate: a refusal that
+   arrives after the unserve does not bring back a degraded gateway_state.
+"""
+
+import asyncio
+import sqlite3
+from types import SimpleNamespace
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, write_hermes_home
+from tests.netie.test_crew_agent_gate_r6_leftovers import _texts, tui_home  # noqa: F401  (fixture)
+from tests.netie.test_crew_agent_gate_session import _QUIET, _api_app, _home
+
+pytestmark = pytest.mark.netie_real_gate
+
+KEY = "k-r7"
+SESSION_KEY = "agent:main:webui:dm:u42"
+
+
+def _rows(home):
+    conn = sqlite3.connect(home / "state.db")
+    try:
+        return [(r[0], r[1]) for r in conn.execute(
+            "SELECT role, content FROM messages WHERE role IN ('user', 'assistant') ORDER BY id")]
+    finally:
+        conn.close()
+
+
+async def _post(cli, payload, headers=None, status=200):
+    resp = await cli.post("/v1/responses", json=payload, headers=headers or {})
+    body = await resp.json()
+    if status is None:
+        return resp.status, body
+    assert resp.status == status, body
+    return body
+
+
+def _adapter(key=None):
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+
+    return APIServerAdapter(PlatformConfig(enabled=True, extra={"key": key} if key else {}))
+
+
+# 1. Declared-key frontends resending their history ---------------------------------------------
+
+@pytest.mark.asyncio
+async def test_declared_key_frontend_resending_history_keeps_one_row_per_message(monkeypatch):
+    from aiohttp.test_utils import TestClient, TestServer
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    headers = {"Authorization": f"Bearer {KEY}", "X-Hermes-Session-Key": SESSION_KEY}
+    with FakeLLMServer([Text("A1"), Text("A2"), Text("A3")]) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = _adapter(KEY)
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                await _post(cli, {"input": [{"role": "user", "content": "U1"}]}, headers)
+                await _post(cli, {"input": [
+                    {"role": "user", "content": "U1"}, {"role": "assistant", "content": "A1"},
+                    {"role": "user", "content": "U2"}]}, headers)
+                third = await _post(cli, {"input": [
+                    {"role": "user", "content": "U1"}, {"role": "assistant", "content": "A1"},
+                    {"role": "user", "content": "U2"}, {"role": "assistant", "content": "A2"},
+                    {"role": "user", "content": "U3"}]}, headers)
+                chain_status, chained = await _post(cli, {"previous_response_id": third["id"], "input": "U4"},
+                                                    {"Authorization": f"Bearer {KEY}"}, status=None)
+        finally:
+            await adapter.disconnect()
+    rows = _rows(home)
+    assert rows == [("user", "U1"), ("assistant", "A1"), ("user", "U2"), ("assistant", "A2"),
+                    ("user", "U3"), ("assistant", "A3")], rows
+    assert [r for r, _ in rows].count("user") == 3 and [r for r, _ in rows].count("assistant") == 3
+    # The model still got the resent conversation each turn.
+    assert _texts(srv.main_requests()[2]) == [
+        ("user", "U1"), ("assistant", "A1"), ("user", "U2"), ("assistant", "A2"), ("user", "U3")]
+    # A chain from it is the labelled refusal, and it says why.
+    assert chain_status == 409, chained
+    assert chained["error"]["code"] == "response_chain_not_rebuildable", chained
+    assert "X-Hermes-Session-Key" in chained["error"]["message"], chained
+
+
+@pytest.mark.asyncio
+async def test_declared_key_first_turn_with_history_saves_only_the_turn(monkeypatch):
+    """A declared-key frontend reconnecting with its history (no live session yet: new key, or
+    after a reset) gets the session's rows for the turn only, and resending again adds no copy."""
+    from aiohttp.test_utils import TestClient, TestServer
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    headers = {"Authorization": f"Bearer {KEY}", "X-Hermes-Session-Key": SESSION_KEY + ":fresh"}
+    history = [{"role": "user", "content": "OLD U1"}, {"role": "assistant", "content": "OLD A1"}]
+    with FakeLLMServer([Text("R2"), Text("R3")]) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = _adapter(KEY)
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                await _post(cli, {"input": history + [{"role": "user", "content": "U2"}]}, headers)
+                await _post(cli, {"input": history + [
+                    {"role": "user", "content": "U2"}, {"role": "assistant", "content": "R2"},
+                    {"role": "user", "content": "U3"}]}, headers)
+        finally:
+            await adapter.disconnect()
+    assert _rows(home) == [("user", "U2"), ("assistant", "R2"), ("user", "U3"), ("assistant", "R3")]
+
+
+@pytest.mark.asyncio
+async def test_chained_multi_item_turn_chains_again_and_store_false_writes_no_extra_rows(monkeypatch):
+    from aiohttp.test_utils import TestClient, TestServer
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    script = [Text("A1 reply"), Text("B1 reply"), Text("C1 reply"), Text("D1 reply"), Text("E1 reply")]
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = _adapter()
+        try:
+            async with TestClient(TestServer(_api_app(adapter))) as cli:
+                a = await _post(cli, {"input": "UA first"})
+                b = await _post(cli, {"previous_response_id": a["id"], "store": True, "input": [
+                    {"role": "user", "content": "UB extra"}, {"role": "assistant", "content": "AB injected"},
+                    {"role": "user", "content": "UB last"}]})
+                c = await _post(cli, {"previous_response_id": b["id"], "input": "UC after multi"})
+                # store=false, chained: no chain can follow, so its extra items are not saved.
+                await _post(cli, {"previous_response_id": c["id"], "store": False, "input": [
+                    {"role": "user", "content": "UD nostore extra"},
+                    {"role": "assistant", "content": "AD nostore injected"},
+                    {"role": "user", "content": "UD last"}]})
+                # store=false on a new session: the same.
+                await _post(cli, {"store": False, "input": [
+                    {"role": "user", "content": "UE nostore extra"},
+                    {"role": "assistant", "content": "AE nostore injected"},
+                    {"role": "user", "content": "UE last"}]})
+        finally:
+            await adapter.disconnect()
+    requests = srv.main_requests()
+    assert _texts(requests[2]) == [
+        ("user", "UA first"), ("assistant", "A1 reply"), ("user", "UB extra"),
+        ("assistant", "AB injected"), ("user", "UB last"), ("assistant", "B1 reply"),
+        ("user", "UC after multi")]
+    assert c["output"]
+    contents = [text for _, text in _rows(home)]
+    for marker in ("UB extra", "AB injected"):
+        assert contents.count(marker) == 1, (marker, contents)
+    for marker in ("UD nostore extra", "AD nostore injected", "UE nostore extra", "AE nostore injected"):
+        assert marker not in contents, (marker, contents)
+    assert "UD last" in contents and "UE last" in contents  # the turn itself is still the session's
+
+
+# 2. hermes --tui --provider auto then /model -------------------------------------------------
+
+from tests.netie.test_crew_agent_gate_model import (  # noqa: E402,F401  (vendor_env is a fixture)
+    UNRELATED_CONFIG,
+    _write_config,
+    vendor_env,
+)
+
+
+@pytest.mark.parametrize("value", ["auto", " Auto "])
+def test_switch_after_provider_auto_names_openvault(value, vendor_env, tui_home, monkeypatch):
+    from tui_gateway import server
+
+    _write_config(UNRELATED_CONFIG)
+    monkeypatch.setenv("HERMES_INFERENCE_PROVIDER", value)
+    monkeypatch.setenv("HERMES_TUI_PROVIDER", value)
+    seen = []
+    monkeypatch.setattr("hermes_cli.observability.shared_metrics_events.record_model_switch",
+                        lambda **kw: seen.append(kw))
+    result = SimpleNamespace(
+        success=True, new_model="gpt-5", target_provider="openai", base_url="https://api.openai.com/v1",
+        api_key="k", api_mode="chat_completions", warning_message="", error_message="")
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", lambda **kw: result)
+    server._apply_model_switch("", {"agent": None}, "gpt-5 --provider openai", confirm_expensive_model=True)
+    assert [kw["from_provider"] for kw in seen] == ["openvault"], seen
+    assert server._resolve_startup_runtime()[1] == "openvault"
+
+
+# 3. A late gate refusal after unserve --------------------------------------------------------
+
+from tests.netie.test_crew_agent_gate_gateways import DEAD_OPENVAULT  # noqa: E402
+from tests.netie.test_crew_agent_gate_r5_claims import _multiplex_start_runner, _persisted  # noqa: E402
+from tests.netie.test_crew_agent_gate_r6_leftovers import _wait_secondary_bridges  # noqa: E402
+
+
+@pytest.mark.asyncio
+async def test_late_refusal_after_unserve_keeps_gateway_running(monkeypatch, tmp_path):
+    from gateway.config import Platform
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, _created, _connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    async def _stubborn_gate(platform):
+        """A gate call that outlives the reconnect's cancellation, then refuses."""
+        entered.set()
+        while not release.is_set():
+            try:
+                await release.wait()
+            except asyncio.CancelledError:
+                continue
+        return "REFUSED late: leave machine unreachable"
+
+    try:
+        assert await runner.start() is True
+        await _wait_secondary_bridges(runner)
+        assert _persisted(tmp_path)["gateway_state"] == "degraded"
+        task = runner._profile_failed_platforms["p"][Platform.TELEGRAM]
+        runner._netie_leave_refusal = _stubborn_gate
+        await asyncio.wait_for(entered.wait(), timeout=5)
+        runner._adapter_disconnect_timeout_secs = lambda: 0.05
+        await runner._unserve_profile("p", tmp_path / "profiles" / "p")
+        assert not task.done()  # the cancelled reconnect outlived the unserve wait
+        release.set()
+        await asyncio.wait({task}, timeout=2)
+        await asyncio.sleep(0.2)
+        state = _persisted(tmp_path)
+        assert state["gateway_state"] == "running", state
+        assert "p:telegram" not in state["platforms"], state["platforms"]
+        assert not {k for k in runner._netie_refused_secondary_keys() if k[0] == "p"}
+        assert task.done(), "the unserved profile's reconnect kept retrying"
+    finally:
+        release.set()
+        await runner.stop()
