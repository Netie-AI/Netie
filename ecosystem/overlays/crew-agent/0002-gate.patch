diff --git a/agent/netie_gate.py b/agent/netie_gate.py
new file mode 100644
index 00000000..0e7d4455
--- /dev/null
+++ b/agent/netie_gate.py
@@ -0,0 +1,164 @@
+"""Crew Agent (Netie) gate: OpenVault is the one model endpoint and the one allow for tools.
+
+Ported contract shape, not an import: Netie ``scripts/crew_ov_gate.py`` and
+``scripts/space_leave.py`` (Netie-AI/Netie, DR-0002). The fork holds no provider key
+and asks OpenVault before a tool runs or a messaging gateway leaves the machine:
+
+    POST {NETIE_OPENVAULT_URL}/api/crew/gate
+      {kind, id, intent, parent_run_id, child_id, deficit}
+    -> {"allowed": true, ...}
+
+Fail closed: a missing URL, a transport error, a non-object body or a body without
+``allowed: true`` is a refusal, and the refusal is shown to the user, never swallowed.
+Only ids ride the ask. Tool arguments, prompts, transcripts and skill bodies never do.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import logging
+from dataclasses import asdict, dataclass
+from typing import Any, Callable, Dict, Iterator, Optional
+
+from hermes_constants import (  # noqa: F401  (re-exported: callers import these from here)
+    OPENVAULT_DEFAULT_MODEL,
+    OPENVAULT_DEFAULT_URL,
+    OPENVAULT_PROVIDER_ID,
+    OPENVAULT_URL_ENV,
+    PRODUCT_NAME,
+    normalize_openvault_url,
+    openvault_url,
+    openvault_v1,
+    raw_openvault_url,
+)
+
+logger = logging.getLogger(__name__)
+
+GATE_PATH = "/api/crew/gate"
+GATE_TIMEOUT_S = 3.0
+
+#: Same set as Netie crew_ov_gate.DROP_KEYS.
+DROP_KEYS = frozenset({"skill_body", "prompt", "instructions", "transcript"})
+#: Same set as OpenVault ACCESS_KINDS minus ``skill`` (no registry row yet).
+REGISTERED_KINDS = frozenset({"memory", "api", "component", "runtime", "model", "service"})
+
+
+class CrewGateDenied(PermissionError):
+    """OpenVault did not allow this. The caller shows the reason and does not run."""
+
+
+@dataclass(frozen=True)
+class GateAsk:
+    kind: str
+    id: str
+    intent: str
+    parent_run_id: str
+    child_id: str
+    deficit: str = ""
+
+
+
+
+
+
+
+
+
+
+def has_bodies(obj: Any) -> bool:
+    if isinstance(obj, dict):
+        return bool(DROP_KEYS.intersection(obj.keys())) or any(has_bodies(v) for v in obj.values())
+    if isinstance(obj, list):
+        return any(has_bodies(x) for x in obj)
+    return False
+
+
+def _http_post(url: str, payload: Dict[str, Any]) -> Any:
+    import httpx
+
+    response = httpx.post(url, json=payload, timeout=GATE_TIMEOUT_S)
+    response.raise_for_status()
+    return response.json()
+
+
+#: Transport seam. Tests replace it; production posts to OpenVault.
+_post: Callable[[str, Dict[str, Any]], Any] = _http_post
+
+
+def ask(ask_: GateAsk) -> Dict[str, Any]:
+    """POST the ask to OpenVault. Raises CrewGateDenied unless the body says allowed=true."""
+    if ask_.kind not in REGISTERED_KINDS:
+        raise CrewGateDenied(f"no {ask_.kind or 'kind'} registered as '{ask_.id}'")
+    payload = asdict(ask_)
+    if has_bodies(payload):
+        raise CrewGateDenied("a body must never go to the gate")
+    base = openvault_url()
+    if not base:
+        raise CrewGateDenied("no OpenVault URL")
+    try:
+        raw = _post(base + GATE_PATH, payload)
+    except Exception as exc:  # transport failure is a refusal
+        raise CrewGateDenied(f"OpenVault crew gate unreachable at {base}: {exc}") from exc
+    if not isinstance(raw, dict):
+        raise CrewGateDenied("OpenVault crew gate returned a non-object")
+    if raw.get("allowed") is not True:
+        raise CrewGateDenied(str(raw.get("reason") or "OpenVault refused"))
+    return {k: v for k, v in raw.items() if k not in DROP_KEYS}
+
+
+def tool_refusal(tool_name: str, *, session_id: Optional[str], tool_call_id: Optional[str]) -> Optional[str]:
+    """None when OpenVault allows the tool call, else the message the user sees."""
+    try:
+        ask(GateAsk(kind="service", id=f"tool.{tool_name}", intent="invoke",
+                    parent_run_id=session_id or "", child_id=tool_call_id or tool_name))
+    except CrewGateDenied as exc:
+        return (f"{PRODUCT_NAME} refused tool '{tool_name}': {exc}. Tools run only with an "
+                f"OpenVault crew-gate allow (Netie DR-0002).")
+    return None
+
+
+def gateway_refusal(platform: str) -> Optional[str]:
+    """None when OpenVault's leave-machine gate allows this messaging gateway, else the label."""
+    try:
+        ask(GateAsk(kind="service", id=f"gateway.{platform}", intent="leave",
+                    parent_run_id="gateway", child_id=platform))
+    except CrewGateDenied as exc:
+        return (f"{PRODUCT_NAME}: messaging gateway '{platform}' is off. It leaves the machine only "
+                f"through the OpenVault leave-machine gate, which did not allow it: {exc}")
+    return None
+
+
+#: Name of the registry tool the dispatcher (model_tools.handle_function_call) has already gated
+#: and is executing in this context. Only ``dispatcher_gated`` sets it.
+_DISPATCHER_GATED_TOOL: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar(
+    "netie_dispatcher_gated_tool", default=None)
+
+
+@contextlib.contextmanager
+def dispatcher_gated(tool_name: str) -> Iterator[None]:
+    """Mark *tool_name* as already gated while the dispatcher runs its handler, reset after."""
+    token = _DISPATCHER_GATED_TOOL.set(tool_name)
+    try:
+        yield
+    finally:
+        _DISPATCHER_GATED_TOOL.reset(token)
+
+
+def guard_direct_tool(tool_name: str, *, session_id: Optional[str] = None,
+                      tool_call_id: Optional[str] = None) -> Optional[str]:
+    """Gate for a tool's public Python entry function, which internal code (@url references, image
+    enrichment, auto voice replies, cron skill loading) calls without the dispatcher.
+
+    Returns None without asking only when the dispatcher already gated this exact tool in this
+    context. Otherwise it asks ``tool_refusal`` and returns its labelled refusal (logged at
+    WARNING). ContextVars cross ``asyncio`` tasks, ``asyncio.to_thread`` and
+    ``propagate_context_to_thread``, but not a bare thread: there the mark is unset and the helper
+    asks again. That is one extra ids-only ask, never a bypass.
+    """
+    if _DISPATCHER_GATED_TOOL.get() == tool_name:
+        return None
+    refusal = tool_refusal(tool_name, session_id=session_id, tool_call_id=tool_call_id or f"direct-{tool_name}")
+    if refusal is not None:
+        logger.warning("%s", refusal)
+    return refusal
