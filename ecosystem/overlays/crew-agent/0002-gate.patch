+# 3. No sync DB read on the event loop --------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_runs_chain_and_streamed_snapshots_read_no_messages_on_the_event_loop(monkeypatch):
+    """A /v1/runs call chained on a stored response, and a streamed /v1/responses call, read the
+    session's messages only off the event loop; the run still gets the chain's history."""
+    import asyncio
+    import threading
+
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+    from hermes_state import SessionDB
+
+    home = _home()
+    monkeypatch.delenv("API_SERVER_KEY", raising=False)
+    loop_thread = threading.get_ident()
+    on_loop: list = []
+    original = SessionDB.get_messages_as_conversation
+
+    def _recorded(self, *args, **kwargs):
+        if threading.get_ident() == loop_thread:
+            on_loop.append(args[:1])
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(SessionDB, "get_messages_as_conversation", _recorded)
+    script = [Text("A1 reply"), Text("R1 run reply"), Text("S1 streamed")]
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=_QUIET)
+        adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+        app = _api_app(adapter)
+        app.router.add_post("/v1/runs", adapter._handle_runs)
+        app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+        try:
+            async with TestClient(TestServer(app)) as cli:
+                a = await _post(cli, {"input": "UA first"})
+                run = await cli.post("/v1/runs", json={"input": "UR run", "previous_response_id": a["id"]})
+                run_body = await run.json()
+                assert run.status == 202, run_body
+                for _ in range(300):
+                    status = await (await cli.get(f"/v1/runs/{run_body['run_id']}")).json()
+                    if status.get("status") in ("completed", "failed", "cancelled"):
+                        break
+                    await asyncio.sleep(0.05)
+                streamed = await cli.post("/v1/responses", json={"input": "US streamed", "stream": True})
+                await streamed.read()
+        finally:
+            await adapter.disconnect()
+    assert status.get("status") == "completed", status
+    assert _user_texts(srv.main_requests()[1]) == ["UA first", "A1 reply", "UR run"]
+    assert on_loop == [], on_loop
