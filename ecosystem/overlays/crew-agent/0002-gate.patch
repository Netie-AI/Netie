+# 2. Gateway inbound-message log line ---------------------------------------------------------
+
+@pytest.fixture
+def _gateway_log_files():
+    """Real ``hermes_logging.setup_logging(mode="gateway")`` file handlers for this HERMES_HOME
+    (agent.log and gateway.log), torn down after (the reset tests/test_hermes_logging.py uses)."""
+    import hermes_logging
+
+    root = logging.getLogger()
+    pre_handlers, pre_level = list(root.handlers), root.level
+    hermes_logging._logging_initialized = False
+    hermes_logging._reset_queued_handlers()
+    log_dir = hermes_logging.setup_logging(hermes_home=_home(), mode="gateway", force=True)
+    try:
+        yield log_dir
+    finally:
+        hermes_logging._reset_queued_handlers()
+        for handler in list(root.handlers):
+            if handler not in pre_handlers:
+                root.removeHandler(handler)
+                handler.close()
+        root.setLevel(pre_level)
+        hermes_logging._logging_initialized = False
+        hermes_logging.clear_session_context()
