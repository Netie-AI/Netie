+def _derive_child(how, db, home, parent_id, history):
+    """Derive a child row from an ids-only parent the way each surface does. Returns (db, child id)."""
+    import asyncio
+
+    from hermes_state import SessionDB
+
+    if how == "compression_rotation":
+        from agent import conversation_compression as cc
+        from gateway.run import _seed_hygiene_system_prompt
+        from run_agent import AIAgent
+
+        hygiene = AIAgent(provider="custom", base_url="http://127.0.0.1:9/v1", api_key="sk-fake-e2e",
+                          model="fake-model", session_db=db, session_id=parent_id, quiet_mode=True,
+                          enabled_toolsets=["memory"])
+        _seed_hygiene_system_prompt(hygiene, db.get_session(parent_id))
+        new_prompt = cc._rebuild_system_prompt_at_boundary(hygiene, "")
+        db.publish_compression_child(parent_session_id=parent_id, child_session_id="sess-child", source="cli",
+                                     messages=history, model="fake-model", system_prompt=new_prompt,
+                                     require_compression_lease=False)
+        return db, "sess-child"
+    if how == "compression_in_place":
+        from agent import conversation_compression as cc
+        from gateway.run import _seed_hygiene_system_prompt
+        from run_agent import AIAgent
+
+        hygiene = AIAgent(provider="custom", base_url="http://127.0.0.1:9/v1", api_key="sk-fake-e2e",
+                          model="fake-model", session_db=db, session_id=parent_id, quiet_mode=True,
+                          enabled_toolsets=["memory"])
+        _seed_hygiene_system_prompt(hygiene, db.get_session(parent_id))
+        db.update_system_prompt(parent_id, cc._rebuild_system_prompt_at_boundary(hygiene, ""))
+        return db, parent_id
+    if how == "profile_move":
