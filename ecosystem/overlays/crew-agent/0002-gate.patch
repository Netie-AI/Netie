+"""Crew Agent stage 2 gate, ledgers (Netie SESSION contract).
+
+Prompt, skill, transcript and result text live in the messages table only. These tests read
+what actually lands on disk outside it:
+
+1. The request dump written on a terminal API error (HERMES_HOME/sessions/request_dump_*.json)
+   holds digests, not the system prompt or the user's text, unless the user opted in with
+   HERMES_DUMP_REQUESTS.
+2. The async_delegations ledger in state.db holds ids, not the goal, the context or the
+   child's summary, while the running parent still receives the summary in memory. After a
+   restart a bodiless row is delivered in a labelled state, never replayed silently empty.
+"""
+
+import json
+import os
+import sqlite3
+import subprocess
+import sys
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.netie_real_gate
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SOUL = "NETIESOULMARKER skill body text"
+USER = "NETIEUSERMARKER hello"
+GOAL = "NETIEGOALMARKER refactor the parser"
+CONTEXT = "NETIECONTEXTMARKER private notes"
+SUMMARY = "NETIESUMMARYMARKER all done"
+ERROR = "NETIEERRORMARKER the child crashed"
+COMPLETED_LABEL = "do not re-run its side effects"
+LABEL = "persists delegation ids only"
+
+
+# 1. Request dumps -------------------------------------------------------------------------
+
+class _Rejects400(BaseHTTPRequestHandler):
+    def do_POST(self):  # noqa: N802 - http.server API
+        self.rfile.read(int(self.headers.get("Content-Length") or 0))
+        body = json.dumps({"error": {"message": "model auto rejected", "type": "invalid_request_error"}}).encode()
+        self.send_response(400)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *args):
+        pass
+
+
+@pytest.fixture
+def openvault_400():
+    server = ThreadingHTTPServer(("127.0.0.1", 0), _Rejects400)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    yield f"http://127.0.0.1:{server.server_port}/v1"
+    server.shutdown()
+
+
+def _sessions_text(home: Path) -> str:
+    return "".join(p.read_text(errors="replace") for p in sorted((home / "sessions").glob("request_dump_*.json")))
+
+
+def _run_failed_turn(base_url):
+    from run_agent import AIAgent
+
+    agent = AIAgent(base_url=base_url, api_key="ov-local", model="auto", quiet_mode=True,
+                    skip_context_files=True, skip_memory=True, enabled_toolsets=[],
+                    ephemeral_system_prompt=SOUL, max_iterations=2)
+    result = agent.run_conversation(USER)
+    assert result.get("failed") is True
+    return agent
+
+
+def test_terminal_api_error_dump_has_no_prompt_or_user_text_unless_opted_in(monkeypatch, openvault_400):
+    from hermes_constants import get_hermes_home
+
+    home = Path(get_hermes_home())
+    monkeypatch.delenv("HERMES_DUMP_REQUESTS", raising=False)
+    agent = _run_failed_turn(openvault_400)
+    # The responses-mode shape too, through the retries-exhausted reason.
+    agent._dump_api_request_debug(
+        {"model": "auto", "instructions": SOUL, "input": [{"role": "user", "content": USER}],
+         "tools": [{"type": "function", "name": "t", "description": SOUL}]},
+        reason="max_retries_exhausted")
+    dumps = sorted((home / "sessions").glob("request_dump_*.json"))
+    assert len(dumps) == 2, "the error breadcrumb must still be written"
+    text = _sessions_text(home)
+    assert "NETIESOULMARKER" not in text and "NETIEUSERMARKER" not in text
+    first = json.loads(dumps[0].read_text())
+    assert first["reason"] == "non_retryable_client_error"
+    assert first["request"]["body"]["model"] == "auto"
+    assert [m["role"] for m in first["request"]["body"]["messages"]][:2] == ["system", "user"]
+    assert all(len(m["sha256"]) == 64 for m in first["request"]["body"]["messages"])
+
+    for dump in dumps:
+        dump.unlink()
+    monkeypatch.setenv("HERMES_DUMP_REQUESTS", "1")
+    _run_failed_turn(openvault_400)
+    text = _sessions_text(home)
+    assert "NETIESOULMARKER" in text and "NETIEUSERMARKER" in text, "the opt-in keeps the full body"
+
+
+# 2. async_delegations ledger --------------------------------------------------------------
+
+_PRODUCER = r'''
+import json, os, sys, threading, time
+from tools import async_delegation as ad
+from tools.process_registry import process_registry
+mode = sys.argv[1]
+release = threading.Event()
+def runner():
+    if mode in ("crash", "crashpaths"):
+        release.wait(600)
+    return {"status": "completed", "summary": os.environ["NETIE_SUMMARY"], "api_calls": 2,
+            "duration_seconds": 0.1, "model": "m", "exit_reason": "completed"}
+def batch_runner():  # two children record their results, then the owner dies mid-unit
+    extra = {"notes_digest": os.environ["NETIE_ERROR"]} if mode == "batchtext" else {}
+    ad.record_unit_child("deleg-batch", {"task_index": 0, "status": "failed", "error": os.environ["NETIE_ERROR"],
+                                         "summary": None, "api_calls": 1, **extra})
+    ad.record_unit_child("deleg-batch", {"task_index": 1, "status": "completed", "summary": os.environ["NETIE_SUMMARY"],
+                                         "api_calls": 1})
+    release.set()
+    time.sleep(600)
+if mode in ("batchcrash", "batchtext"):
+    handle = ad.dispatch_async_delegation_batch(
+        goals=[os.environ["NETIE_GOAL"], os.environ["NETIE_GOAL"] + " two", os.environ["NETIE_GOAL"] + " three"],
+        context=os.environ["NETIE_CONTEXT"], toolsets=["terminal"], role="leaf", model="m", session_key="",
+        parent_session_id="parent-sess", runner=batch_runner, delegation_id="deleg-batch")
+elif mode == "crashpaths":  # owner dies mid-unit; the ledger kept the child transcript path
+    handle = ad.dispatch_async_delegation_batch(
+        goals=[os.environ["NETIE_GOAL"]], context=os.environ["NETIE_CONTEXT"], toolsets=["terminal"], role="leaf",
+        model="m", session_key="", parent_session_id="parent-sess", runner=runner, delegation_id="deleg-paths",
+        task_transcripts={"0": "/netie/child-transcript-0.jsonl"})
+else:
+    handle = ad.dispatch_async_delegation(
+        goal=os.environ["NETIE_GOAL"], context=os.environ["NETIE_CONTEXT"], toolsets=["terminal"], role="leaf",
+        model="m", session_key="", parent_session_id="parent-sess", runner=runner)
+assert handle["status"] == "dispatched", handle
+if mode in ("batchcrash", "batchtext"):
+    release.wait(20)
+    time.sleep(0.3)
+elif mode in ("crash", "crashpaths"):
+    time.sleep(0.5)
+else:
+    evt = process_registry.completion_queue.get(timeout=20)
+    print(json.dumps({"live_summary": evt.get("summary"), "live_goal": evt.get("goal")}))
+sys.stdout.flush()
+os._exit(0)
+'''
+
+
+def _produce(home: Path, mode: str) -> dict:
+    env = {**os.environ, "HERMES_HOME": str(home), "PYTHONPATH": str(REPO_ROOT),
+           "NETIE_GOAL": GOAL, "NETIE_CONTEXT": CONTEXT, "NETIE_SUMMARY": SUMMARY, "NETIE_ERROR": ERROR}
+    out = subprocess.run([sys.executable, "-c", _PRODUCER, mode], cwd=REPO_ROOT, env=env, text=True,
+                         capture_output=True, timeout=60)
+    assert out.returncode == 0, out.stderr[-2000:]
+    lines = [ln for ln in out.stdout.splitlines() if ln.startswith("{")]
+    return json.loads(lines[-1]) if lines else {}
+
+
+def _ledger_text(home: Path) -> str:
+    with sqlite3.connect(home / "state.db") as conn:
+        rows = conn.execute("SELECT * FROM async_delegations").fetchall()
+    assert rows, "the dispatch must still be recorded"
+    return json.dumps(rows, default=str)
+
+
+def _restore():
+    import queue
+
+    from tools import async_delegation as ad
+
+    ad._reset_for_tests()
+    q = queue.Queue()
+    ad.restore_undelivered_completions(q)
+    return q.get_nowait()
+
+
+@pytest.fixture
+def fresh_home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    yield home
+    from tools import async_delegation as ad
+
+    ad._reset_for_tests()
+
+
+def test_completed_delegation_ledger_holds_ids_and_restart_replay_is_labelled(fresh_home):
+    from tools.process_registry_notifications import format_process_notification
+
+    live = _produce(fresh_home, "complete")
+    # Live in-process delivery is unchanged: the running parent got the summary in memory.
+    assert live == {"live_summary": SUMMARY, "live_goal": GOAL}
+    text = _ledger_text(fresh_home)
+    for marker in ("NETIEGOALMARKER", "NETIECONTEXTMARKER", "NETIESUMMARYMARKER"):
+        assert marker not in text
+    assert "sha256" in text
+
+    evt = _restore()  # a new process replays the pending completion
+    assert evt["status"] == "completed" and evt["last_known_status"] == "completed"
+    assert LABEL in evt["error"]
+    shown = format_process_notification(evt)
+    assert LABEL in shown and "NETIESUMMARYMARKER" not in shown
+
+
+def test_crashed_delegation_recovers_to_a_labelled_state(fresh_home):
+    from tools import async_delegation as ad
+    from tools.process_registry_notifications import format_process_notification
+
+    _produce(fresh_home, "crash")  # owner exits with the child still running
+    text = _ledger_text(fresh_home)
+    assert "NETIEGOALMARKER" not in text and "NETIECONTEXTMARKER" not in text
+
+    evt = _restore()
+    assert evt["status"] == "unknown" and LABEL in evt["error"]
+    assert LABEL in format_process_notification(evt)
+    text = _ledger_text(fresh_home)  # the recovery write is ids-only too
+    assert "NETIEGOALMARKER" not in text and "NETIECONTEXTMARKER" not in text
+
+    failed = ad.failed_delegations_for_session(parent_session_id="parent-sess")
+    assert failed and LABEL in failed[0]["error"]
+
+
+def test_completed_delegation_replay_stays_completed_and_says_do_not_rerun(fresh_home):
+    from tools.process_registry_notifications import async_delegation_display_text, format_process_notification
+
+    _produce(fresh_home, "complete")
+    evt = _restore()
+    assert evt["status"] == "completed" and evt["summary"] is None
+    assert COMPLETED_LABEL in evt["error"] and LABEL in evt["error"] and "re-dispatch" not in evt["error"]
+    shown = format_process_notification(evt)
+    assert COMPLETED_LABEL in shown
+    assert "re-dispatch the task" not in shown and "did not complete successfully" not in shown
+    assert "before owner exit" not in shown
+    assert "NETIESUMMARYMARKER" not in shown
+    assert async_delegation_display_text(evt).startswith("Subagent Task Completed")
+
+
+def test_recovered_batch_children_are_not_double_digested_and_keep_their_status(fresh_home):
+    from agent.netie_ids import digest
+    from tools.process_registry_notifications import format_process_notification
+
+    _produce(fresh_home, "batchcrash")  # two children recorded, owner exits mid-unit
+    evt = _restore()  # recovery re-writes the row, then the replay labels it
+    text = _ledger_text(fresh_home)
+    for marker in ("NETIEGOALMARKER", "NETIECONTEXTMARKER", "NETIESUMMARYMARKER", "NETIEERRORMARKER"):
+        assert marker not in text
+    assert "_digest_digest" not in text
+    with sqlite3.connect(fresh_home / "state.db") as conn:
+        (event_json,) = conn.execute("SELECT event_json FROM async_delegations").fetchone()
+    stored = {r["task_index"]: r for r in json.loads(event_json)["results"]}
+    assert stored[0]["error_digest"] == digest(ERROR)  # still the digest of the original error
+    assert stored[1]["summary_digest"] == digest(SUMMARY)
+
+    by_index = {r["task_index"]: r for r in evt["results"]}
+    assert by_index[0]["status"] == "failed" and LABEL in by_index[0]["error"]
+    assert COMPLETED_LABEL not in by_index[0]["error"]
+    assert by_index[1]["status"] == "completed" and COMPLETED_LABEL in by_index[1]["error"]
+    assert by_index[2]["status"] == "unknown"
+    shown = format_process_notification(evt)
+    assert COMPLETED_LABEL in shown and "NETIESUMMARYMARKER" not in shown
+
+
+def test_replay_label_names_only_what_was_persisted(fresh_home):
+    """No transcript path and no child session id: the label must not point at a list that is not there."""
+    from tools.process_registry_notifications import format_process_notification
+
+    _produce(fresh_home, "complete")
+    evt = _restore()
+    shown = format_process_notification(evt)
+    assert COMPLETED_LABEL in shown
+    assert "listed here" not in shown and "Inspect the child transcript" not in shown
+    assert "nothing here can be inspected" in shown
+    assert "before this replay" in shown and "before the restart" not in shown
+
+
+def test_replay_label_names_the_persisted_transcript_path(fresh_home):
+    from tools.process_registry_notifications import format_process_notification
+
+    _produce(fresh_home, "crashpaths")  # owner exits; the ledger kept the child transcript path
+    evt = _restore()
+    assert LABEL in evt["error"]
+    assert "Inspect the child transcript path: /netie/child-transcript-0.jsonl." in evt["error"]
+    shown = format_process_notification(evt)
+    assert "/netie/child-transcript-0.jsonl" in shown and "nothing here can be inspected" not in shown
+    assert "after a restart" not in shown
