+def drive_speech_to_text(stub, home, monkeypatch, tmp_path):
+    """Voice-mode transcription with Groq selected and its key set; returns the caller's result."""
+    from tools.transcription_tools import _get_provider, _load_stt_config
+    from tools.voice_mode import transcribe_recording
+
+    (home / "config.yaml").write_text("stt:\n  enabled: true\n  provider: groq\n")
+    provider = _get_provider(_load_stt_config())
