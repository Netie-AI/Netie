+"""Crew Agent (Netie) ids-only Responses store: what response_store.db keeps on disk.
+
+Netie SESSION contract: transcript text lives in the state.db messages table (the declared
+transcript store) and nowhere else. A ``previous_response_id`` / ``conversation`` row therefore
+keeps ids only: the response id, its session id, created time, the response object's ids,
+status and usage (no output text), the ordered messages-table row ids of the chain's history plus
+this turn (``message_row_ids``), and a sha256 of the instructions. A chain rebuilds its history by
+reading exactly those rows (so two responses branching from one parent never mix histories, and a
+shared session's other callers never leak in); a missing or inactive row is a labelled refusal.
+Instructions are re-sent only when the caller sends them. ``GET /v1/responses/{id}`` refills the
+output text from the same rows.
+
+``IDS_ONLY`` is the one seam (True in the product).
+"""
+
+from __future__ import annotations
+
+import copy
+import logging
+from typing import Any, Dict, List, Optional, Tuple
+
+from agent.netie_ids import IDS_ONLY_MARKER, digest
+from hermes_constants import PRODUCT_NAME
+
+logger = logging.getLogger(__name__)
+
+#: Seam: True keeps conversation, output and instructions text out of response_store.db.
+IDS_ONLY = True
+
+CHAIN_NOT_REBUILDABLE = (
+    f"{PRODUCT_NAME} stores response ids only; the conversation for previous response {{rid}} "
+    "cannot be rebuilt from the session's messages ({why}). Send the history as "
+    "'conversation_history', or start a new conversation."
+)
+OUTPUT_NOT_REBUILDABLE = (
+    f"{PRODUCT_NAME} stores response ids only; the output text of this response could not be "
+    "rebuilt from the session's messages ({why})."
+)
+
+#: Output-item keys that carry text; everything else (ids, type, status, role, call_id, name) stays.
+_TEXT_KEYS = ("content", "arguments", "output", "summary", "text")
+
+
+def ids_only() -> bool:
+    return bool(IDS_ONLY)
+
+
+def _reduce_envelope(env: Dict[str, Any]) -> Dict[str, Any]:
+    # ``error`` is the server's redacted failure text, not conversation text: it stays.
+    reduced = {k: v for k, v in env.items() if k not in ("output", "instructions")}
+    reduced["output"] = [{k: v for k, v in item.items() if k not in _TEXT_KEYS}
+                         for item in env.get("output") or [] if isinstance(item, dict)]
+    return reduced
+
+
+def turn_row_ids(history: List[Dict[str, Any]], parent_row_ids: Optional[List[int]]) -> Optional[List[int]]:
+    """The ordered row ids of the chain's history plus this turn, ``None`` when not every message
+    of *history* is a messages-table row. *history* is the stored transcript of the turn: the chain's
+    history (passed to the agent without ``_row_id``) followed by the messages the agent wrote this
+    turn, which carry the ``_row_id`` the insert stamped. *parent_row_ids* are the row ids of the
+    chain's history (``None`` when it did not come from the messages table)."""
+    rows = [m for m in history or [] if isinstance(m, dict)]
+    ids = [m.get("_row_id") for m in rows]
+    if rows and all(isinstance(i, int) for i in ids):
+        return ids  # every message is a row (a compression-rotated child holds its whole history)
+    head = next((n for n, i in enumerate(ids) if isinstance(i, int)), len(ids))
+    tail = ids[head:]
+    parent = list(parent_row_ids or [])
+    if not tail or not all(isinstance(i, int) for i in tail) or head != len(parent):
+        return None
+    return parent + tail
+
+
+def store_record(response_env: Dict[str, Any], history: List[Dict[str, Any]], instructions: Any,
+                 session_id: Optional[str], *, parent_row_ids: Optional[List[int]] = None,
+                 in_progress: bool = False, unrecorded_why: Optional[str] = None) -> Dict[str, Any]:
+    """The ResponseStore row for one response (upstream shape when the seam is off). No database
+    read: the row ids come from the turn's messages (``turn_row_ids``); an ``in_progress`` snapshot
+    has none yet. *unrecorded_why* is a fixed reason (no conversation text) the request-supplied
+    history was not saved, kept so a refused chain names it."""
+    if not ids_only():
+        return {"response": response_env, "conversation_history": history,
+                "instructions": instructions, "session_id": session_id}
+    row_ids = None if in_progress else turn_row_ids(history, parent_row_ids)
+    record = {
+        IDS_ONLY_MARKER: True,
+        "response": _reduce_envelope(response_env),
+        "session_id": session_id,
+        "message_row_ids": row_ids,
+        "instructions_sha256": digest(instructions)["sha256"] if isinstance(instructions, str) else None,
+    }
+    if row_ids is None and not in_progress and isinstance(unrecorded_why, str) and unrecorded_why:
+        record["message_row_ids_why"] = unrecorded_why
+    return record
+
+
+def reduce_legacy_record(data: Dict[str, Any]) -> Dict[str, Any]:
+    """A row an older build wrote (full history and instructions) reduced to ids: its chain can no
+    longer be rebuilt (no message row ids were recorded) and fails with a labelled error."""
+    return store_record(data.get("response") or {}, [], data.get("instructions"), data.get("session_id"))
+
+
+def is_ids_only(stored: Any) -> bool:
+    return isinstance(stored, dict) and bool(stored.get(IDS_ONLY_MARKER))
+
+
+def _chain_rows(stored: Dict[str, Any], db: Any) -> Tuple[List[Dict[str, Any]], Optional[str]]:
+    """``(rows, why)``: the stored row ids read back in order, ``_row_id`` stripped (the agent gets
+    the same dicts an unaddressed read returns). ``why`` names the first reason it cannot be done."""
+    row_ids, session_id = stored.get("message_row_ids"), stored.get("session_id")
+    if not isinstance(row_ids, list) or not row_ids or not all(isinstance(i, int) for i in row_ids):
+        why = stored.get("message_row_ids_why")
+        return [], ("no message row ids were recorded for it"
+                    + (f": {why}" if isinstance(why, str) and why else ""))
+    if db is None:
+        return [], "the session database is unavailable"
+    try:
+        active = db.get_messages_as_conversation(session_id, include_row_ids=True)
+    except Exception as exc:  # noqa: BLE001
+        return [], f"reading session messages failed: {type(exc).__name__}"
+    by_id = {m.get("_row_id"): m for m in active if isinstance(m, dict)}
+    missing = [i for i in row_ids if i not in by_id]
+    if missing:
+        return [], f"{len(missing)} of its {len(row_ids)} messages are deleted or inactive"
+    rows = []
+    for i in row_ids:
+        msg = dict(by_id[i])
+        msg.pop("_row_id", None)
+        rows.append(msg)
+    return rows, None
+
+
+def chain_history(stored: Dict[str, Any], db: Any, response_id: str) -> Tuple[List[Dict[str, Any]], Optional[str]]:
+    """``(history, error)`` for a ``previous_response_id`` chain (see ``chain_history_with_ids``)."""
+    history, _row_ids, error = chain_history_with_ids(stored, db, response_id)
+    return history, error
+
+
+def chain_history_with_ids(stored: Dict[str, Any], db: Any, response_id: str
+                           ) -> Tuple[List[Dict[str, Any]], Optional[List[int]], Optional[str]]:
+    """``(history, row_ids, error)`` for a ``previous_response_id`` chain. An upstream-shaped row
+    returns its stored history (``row_ids`` None); an ids-only row is rebuilt from exactly its
+    recorded messages-table rows, and ``row_ids`` are those ids (the next turn's parent ids)."""
+    if not is_ids_only(stored):
+        return list(stored.get("conversation_history", [])), None, None
+    rows, why = _chain_rows(stored, db)
+    if why:
+        logger.warning("Response chain refused for %s: %s", response_id, why)
+        return [], None, CHAIN_NOT_REBUILDABLE.format(rid=response_id, why=why)
+    return rows, list(stored["message_row_ids"]), None
+
+
+def response_object(stored: Dict[str, Any], db: Any) -> Dict[str, Any]:
+    """The response object ``GET /v1/responses/{id}`` returns: an ids-only row gets its output text
+    refilled from this turn's messages (the recorded rows after the last user row)."""
+    if not is_ids_only(stored):
+        return stored["response"]
+    env = copy.deepcopy(stored.get("response") or {})
+    rows, why = _chain_rows(stored, db)
+    start = next((i + 1 for i in range(len(rows) - 1, -1, -1)
+                  if isinstance(rows[i], dict) and rows[i].get("role") == "user"), 0)
+    turn = [] if why else rows[start:]
+    calls = {tc.get("id"): (tc.get("function") or {}).get("arguments", "")
+             for m in turn if m.get("role") == "assistant" for tc in (m.get("tool_calls") or [])
+             if isinstance(tc, dict)}
+    outputs = {m.get("tool_call_id"): m.get("content", "") for m in turn if m.get("role") == "tool"}
+    reasoning = [m["reasoning"] for m in turn if m.get("role") == "assistant"
+                 and isinstance(m.get("reasoning"), str) and m["reasoning"].strip()]
+    texts = [m["content"] for m in turn if m.get("role") == "assistant"
+             and isinstance(m.get("content"), str) and m["content"].strip()]
+    items = env.get("output") or []
+    missing = False
+    for item in items:
+        kind = item.get("type")
+        if kind == "function_call":
+            item["arguments"] = calls.get(item.get("call_id"), "")
+            missing |= item.get("call_id") not in calls
+        elif kind == "function_call_output":
+            item["output"] = outputs.get(item.get("call_id"), "")
+            missing |= item.get("call_id") not in outputs
+        elif kind == "reasoning":
+            text = reasoning.pop(0) if reasoning else ""
+            missing |= not text
+            item["summary"] = [{"type": "summary_text", "text": text}] if text else []
+    message_items = [item for item in items if item.get("type") == "message"]
+    for item in reversed(message_items):
+        text = texts.pop() if texts else ""
+        missing |= not text
+        item["content"] = [{"type": "output_text", "text": text}]
+    if why or missing:
+        note = OUTPUT_NOT_REBUILDABLE.format(why=why or "some output items have no matching message row")
+        env["metadata"] = {**(env.get("metadata") or {}), "netie_note": note}
+        logger.warning("GET response %s: %s", env.get("id"), note)
+    return env
