+# 5. Non-retryable rejection names OpenVault --------------------------------------------------
+
+def test_nonretryable_rejection_names_openvault_not_openrouter():
+    from agent.error_classifier import classify_api_error
+    from agent.netie_gate import openvault_v1
+    from agent.turn_recovery import nonretryable_client_error_result
+
+    class _Rejected(Exception):
+        status_code = 400
+
+        def __init__(self):
+            super().__init__("HTTP 400: unsupported parameter")
+
+    shown = []
+
+    class _Agent:
+        log_prefix = ""
+        verbose = False
+
+        def _summarize_api_error(self, error):
+            return str(error)
+
+        def _emit_diagnostic_status(self, message):
+            shown.append(message)
+
+        def __getattr__(self, name):
+            return lambda *args, **kwargs: None
+
+    error = _Rejected()
+    classified = classify_api_error(error, provider="", model="auto")
+    result = nonretryable_client_error_result(
+        _Agent(), error, classified, status_code=400, api_kwargs=None, api_messages=[], messages=[],
+        conversation_history=None, api_call_count=1, approx_tokens=10, provider=None,
+        base_url=openvault_v1(), model="auto")
+    seen = " ".join(shown) + " " + str(result.get("final_response"))
+    assert "OpenVault" in seen, seen
+    assert "OpenRouter" not in seen, seen
+
+
+# 6. Max-retries-exhausted copy names OpenVault (round 3) -------------------------------------
+
+def test_exhausted_retries_copy_names_openvault_not_openrouter():
+    from agent.error_classifier import classify_api_error
+    from agent.netie_gate import openvault_v1
+    from agent.turn_recovery import max_retries_exhausted_result
+
+    class _Unavailable(Exception):
+        status_code = 503
+
+        def __init__(self):
+            super().__init__("HTTP 503: upstream unavailable")
+
+    class _Agent:
+        log_prefix = ""
+        verbose = False
+
+        def _summarize_api_error(self, error):
+            return str(error)
+
+        def __getattr__(self, name):
+            return lambda *args, **kwargs: None
+
+    error = _Unavailable()
+    classified = classify_api_error(error, provider="", model="auto")
+    result = max_retries_exhausted_result(
+        _Agent(), error, classified, max_retries=3, is_rate_limited=False, error_msg=str(error),
+        api_kwargs=None, api_messages=[], messages=[], conversation_history=None, api_call_count=3,
+        approx_tokens=10, provider="", base_url=openvault_v1(), model="auto")
+    final = str(result.get("final_response"))
+    assert "OpenVault" in final, final
+    assert "OpenRouter" not in final, final
