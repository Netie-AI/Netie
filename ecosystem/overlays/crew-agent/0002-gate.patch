+"""Crew Agent stage 2 gate, model area (review v1 survivors 1, 7, 8; round 2 cli sweep).
+
+Asserts what the operator and the user actually receive:
+
+1. ``hermes config set model <id>`` and a hand-written ``model: <id>`` keep OpenVault as the
+   provider the real runtime resolver returns, even with vendor keys in the environment. An
+   explicit user provider still wins.
+2. A load + save round trip on a fresh home does not pin the expanded OpenVault URL into
+   config.yaml, so a later NETIE_OPENVAULT_URL change reaches the runtime resolver. A URL the
+   user really changed is still persisted.
+3. No default MoA slot (DEFAULT_CONFIG, the loaded config, or a slot normalize_moa_config
+   re-seeds) names a provider other than OpenVault, and each one resolves to OpenVault /v1.
+"""
+
+import os
+from pathlib import Path
+
+import pytest
+
+import hermes_yaml
+
+pytestmark = pytest.mark.netie_real_gate
+
+OPENVAULT_V1 = "http://127.0.0.1:5000/v1"
+VENDOR_ENV = {
+    "OPENROUTER_API_KEY": "sk-or-v1-netiegatetestkey000000000000000000",
+    "OPENAI_API_KEY": "sk-netiegatetestkey000000000000000000000000",
+    "ANTHROPIC_API_KEY": "sk-ant-test-netiegatekey000000000000000000",
+    "GEMINI_API_KEY": "AIzaNetieGateTestKey00000000000000000000",
+}
+
+
+@pytest.fixture
+def vendor_env(monkeypatch):
+    monkeypatch.delenv("NETIE_OPENVAULT_URL", raising=False)
+    for name, value in VENDOR_ENV.items():
+        monkeypatch.setenv(name, value)
+
+
+def _config_path() -> Path:
+    from hermes_cli.config import get_config_path
+
+    return Path(get_config_path())
+
+
+def _on_disk() -> dict:
+    return hermes_yaml.safe_load(_config_path().read_text(encoding="utf-8")) or {}
+
+
+def _write_config(text: str) -> None:
+    path = _config_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8")
+
+
+def _runtime():
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    return resolve_runtime_provider()
+
+
+def _assert_openvault_runtime():
+    runtime = _runtime()
+    assert runtime["base_url"] == OPENVAULT_V1
+    assert runtime.get("api_key") not in set(VENDOR_ENV.values())
+    assert "openvault" in str(runtime.get("source", "")).lower() or runtime.get(
+        "requested_provider") == "openvault"
+
+
+# 1. Scalar model keeps OpenVault --------------------------------------------------------------
+
+def test_config_set_model_keeps_openvault(vendor_env, capsys):
+    from hermes_cli.config import load_config, set_config_value
+
+    set_config_value("model", "some-model")
+    assert _on_disk()["model"] == {"default": "some-model"}
+    model = load_config()["model"]
+    assert model["provider"] == "openvault"
+    assert model["default"] == "some-model"
+    _assert_openvault_runtime()
+
+
+def test_hand_written_scalar_model_keeps_openvault(vendor_env):
+    from hermes_cli.config import load_config
+
+    _write_config("model: some-model\n")
+    model = load_config()["model"]
+    assert model == {"provider": "openvault", "default": "some-model"}
+    _assert_openvault_runtime()
+
+    # A YAML int scalar is a model id too; it must not replace the OpenVault section.
+    _write_config("model: 42\n")
+    model = load_config()["model"]
+    assert model == {"provider": "openvault", "default": "42"}
+    _assert_openvault_runtime()
+
+    # An explicit user provider (legacy root layout) still wins over the default.
+    _write_config("provider: openrouter\nmodel: other-model\n")
+    model = load_config()["model"]
+    assert model["provider"] == "openrouter"
+    assert model["default"] == "other-model"
+
+
+def test_hand_written_model_section_with_root_provider_keeps_user_choice(vendor_env):
+    from hermes_cli.config import load_config
+
+    _write_config("provider: openrouter\nmodel:\n  default: other-model\n")
+    model = load_config()["model"]
+    assert model["provider"] == "openrouter"
+    assert model["default"] == "other-model"
+
+
+# 2. Load + save keeps the env template --------------------------------------------------------
+
+def test_load_save_round_trip_keeps_openvault_url_template(monkeypatch):
+    from hermes_cli.config import load_config, save_config
+
+    monkeypatch.delenv("NETIE_OPENVAULT_URL", raising=False)
+    cfg = load_config()
+    cfg["display"] = dict(cfg.get("display") or {}, compact=True)
+    save_config(cfg)
+    disk = _on_disk()
+    base_url = ((disk.get("providers") or {}).get("openvault") or {}).get("base_url")
+    assert base_url in (None, "${NETIE_OPENVAULT_URL}/v1")
+    assert "127.0.0.1:5000" not in _config_path().read_text(encoding="utf-8")
+
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", "http://10.0.0.5:5000")
+    assert load_config()["providers"]["openvault"]["base_url"] == "http://10.0.0.5:5000/v1"
+    assert _runtime()["base_url"] == "http://10.0.0.5:5000/v1"
+
+    # A URL the user really changed is persisted and wins over the env.
+    cfg = load_config()
+    cfg["providers"]["openvault"]["base_url"] = "http://vault.lan:5000/v1"
+    save_config(cfg)
+    assert _on_disk()["providers"]["openvault"]["base_url"] == "http://vault.lan:5000/v1"
+    assert _runtime()["base_url"] == "http://vault.lan:5000/v1"
+
+
+# 3. MoA defaults ride OpenVault ---------------------------------------------------------------
+
+def _slots(preset):
+    return list(preset.get("reference_models") or []) + [preset.get("aggregator") or {}]
+
+
+def test_no_default_moa_slot_names_a_vendor(vendor_env):
+    from agent import moa_loop
+    from hermes_cli.config import load_config
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    from hermes_cli.moa_config import normalize_moa_config
+
+    sources = {
+        "DEFAULT_CONFIG": DEFAULT_CONFIG["moa"]["presets"]["default"],
+        "load_config": normalize_moa_config(load_config()["moa"])["presets"]["default"],
+        "reseed_empty": normalize_moa_config({})["presets"]["default"],
+        "reseed_blank_slots": normalize_moa_config(
+            {"presets": {"default": {"reference_models": [], "aggregator": {}}}})["presets"]["default"],
+    }
+    seen = []
+    for label, preset in sources.items():
+        for slot in _slots(preset):
+            seen.append((label, slot.get("provider")))
+            assert slot.get("provider") == "openvault", (label, slot)
+    assert len(seen) >= 8
+
+    moa_loop._runtime_cache.clear()
+    for slot in _slots(sources["load_config"]):
+        runtime = moa_loop._slot_runtime(slot)
+        assert runtime["base_url"] == OPENVAULT_V1, runtime
+        assert runtime.get("api_key") not in set(VENDOR_ENV.values())
+    assert os.environ.get("OPENROUTER_API_KEY")  # vendor keys were present the whole time
+
+
+# 4. Every entry point resolves OpenVault (round 2) --------------------------------------------
+#
+# Home: a config.yaml with only unrelated settings, vendor keys in the env. Each driver calls the
+# entry point's own provider-resolution function and returns what the agent would be built with.
+# MCP serve (mcp_serve.py) is not listed: it bridges gateway conversations and builds no model
+# client, so it has no provider resolution to drive.
+
+UNRELATED_CONFIG = "display:\n  compact: true\n"
+
+
+def _drive_cli(monkeypatch):
+    import cli
+    from hermes_constants import get_hermes_home
+
+    monkeypatch.setattr(cli, "_hermes_home", get_hermes_home())
+    monkeypatch.setattr(cli, "CLI_CONFIG", cli.load_cli_config())
+    monkeypatch.setattr(cli, "get_tool_definitions", lambda *a, **k: [])
+    agent = cli.HermesCLI()
+    assert agent.requested_provider == "openvault"
+    assert agent._ensure_runtime_credentials() is True
+    return {"base_url": agent.base_url, "api_key": agent.api_key, "model": agent.model}
+
+
+def _drive_oneshot(monkeypatch):
+    from hermes_cli import oneshot
+    from hermes_cli.config import load_config
+    from hermes_cli.runtime_provider import resolve_runtime_with_fallback
+
+    cfg = load_config()
+    choice = oneshot._resolve_model_and_provider(cfg, None, None)
+    runtime, _ = resolve_runtime_with_fallback(
+        cfg, requested=choice.provider, target_model=choice.model or None,
+        explicit_base_url=choice.base_url, explicit_api_key=choice.api_key)
+    return dict(runtime, model=choice.model)
+
+
+def _drive_tui_gateway(monkeypatch):
+    from tui_gateway import server
+
+    model, runtime = server._resolve_agent_model_runtime(None, None)
+    return dict(runtime, model=model)
+
+
+def _drive_messaging_gateway(monkeypatch):
+    from gateway import run
+
+    return run._resolve_runtime_agent_kwargs()
+
+
+def _drive_api_server(monkeypatch):
+    from gateway.platforms import api_server
+    from hermes_cli.runtime_provider import _get_model_config
+
+    cfg = _get_model_config()
+    return api_server._resolve_request_runtime_agent_kwargs(cfg.get("provider"), cfg.get("default"))
+
+
+def _drive_cron(monkeypatch):
+    from cron import scheduler
+
+    job_config = scheduler._load_cron_job_config({}, "netie-job", "netie-job")
+    runtime, model = scheduler._resolve_job_runtime({}, "netie-job", job_config)
+    return dict(runtime, model=model)
+
+
+def _drive_acp(monkeypatch):
+    import run_agent
+    from acp_adapter import session as acp_session
+
+    built = {}
+
+    class _Captured:
+        def __init__(self, **kwargs):
+            built.update(kwargs)
+
+    monkeypatch.setattr(run_agent, "AIAgent", _Captured)
+    manager = acp_session.SessionManager.__new__(acp_session.SessionManager)
+    manager._agent_factory = None
+    manager._get_db = lambda: None
+    manager._make_agent(session_id="netie-acp", cwd=str(Path.cwd()))
+    return built
+
+
+def _drive_batch_runner(monkeypatch, tmp_path):
+    import batch_runner
+
+    built = {}
+
+    class _Runner:
+        def __init__(self, **kwargs):
+            built.update(kwargs)
+
+        def run(self, resume=False):
+            return None
+
+    monkeypatch.setattr(batch_runner, "BatchRunner", _Runner)
+    batch_runner.main(dataset_file=str(tmp_path / "d.jsonl"), batch_size=1, run_name="netie")
+    return built
+
+
+def _drive_delegation(monkeypatch):
+    from types import SimpleNamespace
+
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    from tools.delegate_tool_config import (
+        _load_config, _resolve_child_runtime, _resolve_delegation_credentials)
+
+    parent_rt = resolve_runtime_provider()
+    parent = SimpleNamespace(
+        model="auto", provider=parent_rt.get("provider"), base_url=parent_rt.get("base_url"),
+        api_key=parent_rt.get("api_key"), api_mode=parent_rt.get("api_mode"), request_overrides=None,
+        requested_provider=parent_rt.get("requested_provider"), _credential_pool=None, acp_command=None,
+        acp_args=[], _fallback_chain=None, reasoning_config=None, client=None, _client_kwargs=None)
+    cfg = _load_config()
+    creds = _resolve_delegation_credentials(cfg, parent)
+    return _resolve_child_runtime(
+        parent, cfg, parent.api_key, model=creds["model"], override_provider=creds["provider"],
+        override_base_url=creds["base_url"], override_api_key=creds["api_key"],
+        override_api_mode=creds["api_mode"], override_acp_command=None, override_acp_args=None)
+
+
+def _drive_model_picker(monkeypatch):
+    from hermes_cli import main as hermes_main
+    from hermes_cli.config import load_config
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    config = load_config()
+    model_cfg = config.get("model")
+    effective = model_cfg.get("provider") or "auto"
+    active = hermes_main._resolve_active_provider(
+        config, model_cfg, effective, hermes_main._named_custom_provider_map(config))
+    # The picker keys a providers: entry as custom:<name>; its default row is OpenVault.
+    assert active in {"openvault", "custom:openvault"}, active
+    return resolve_runtime_provider(requested=active)
+
+
+ENTRY_POINTS = {
+    "interactive_cli": _drive_cli,
+    "oneshot": _drive_oneshot,
+    "tui_gateway": _drive_tui_gateway,
+    "messaging_gateway": _drive_messaging_gateway,
+    "api_server": _drive_api_server,
+    "cron": _drive_cron,
+    "acp_adapter": _drive_acp,
+    "batch_runner": _drive_batch_runner,
+    "delegation_child": _drive_delegation,
+    "model_picker": _drive_model_picker,
+}
+
+
+@pytest.mark.parametrize("entry_point", sorted(ENTRY_POINTS))
+def test_every_entry_point_resolves_openvault(entry_point, vendor_env, monkeypatch, tmp_path):
+    from agent.netie_gate import openvault_v1
+
+    _write_config(UNRELATED_CONFIG)
+    driver = ENTRY_POINTS[entry_point]
+    runtime = driver(monkeypatch, tmp_path) if entry_point == "batch_runner" else driver(monkeypatch)
+    assert runtime["base_url"] == openvault_v1(), (entry_point, runtime.get("base_url"))
+    assert runtime.get("api_key") not in set(VENDOR_ENV.values()), entry_point
+
+
+@pytest.mark.parametrize("config_text", ["model: some-model\n", "model: 42\n", "model:\n  default: x\n"])
+def test_interactive_cli_with_hand_written_model_keeps_openvault(config_text, vendor_env, monkeypatch):
