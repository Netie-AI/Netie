+def _sqlite_hits(db: Path, rel: str, hits: set) -> None:
+    tmp = Path(tempfile.mkdtemp(prefix="r6sweep-db-"))
+    try:
+        for suffix in ("", "-wal", "-shm"):
+            src = Path(str(db) + suffix)
+            if src.exists():
+                shutil.copy(src, tmp / ("copy.db" + suffix))
+        conn = sqlite3.connect(tmp / "copy.db")
+        try:
+            tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")]
+            for table in tables:
+                try:
+                    cols = [r[1] for r in conn.execute(f'PRAGMA table_info("{table}")')]
+                    rows = conn.execute(f'SELECT * FROM "{table}"').fetchall()
+                except sqlite3.DatabaseError:
+                    continue
+                for row in rows:
+                    for col, value in zip(cols, row):
+                        if value is None:
+                            continue
+                        data = value if isinstance(value, bytes) else str(value).encode()
+                        for kind, scen in set(_MARK_RE.findall(data)):
+                            hits.add((f"db:{rel}:{table}.{col}", kind.decode(), scen.decode()))
+        finally:
+            conn.close()
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+def scan(home: Path) -> list:
+    """Every marker under HERMES_HOME as (location, kind, scenario). The marker sources (SOUL.md,
+    the probe SKILL.md) are inputs and skipped; sqlite files are dumped row by row from a copy that
+    includes the WAL, so their raw -wal/-shm bytes are not grepped twice."""
+    hits: set = set()
+    sources = {home / "SOUL.md", home / "skills" / "probe-skill" / "SKILL.md"}
+    for root, _dirs, files in os.walk(home):
+        for name in files:
+            path = Path(root) / name
+            if path in sources:
+                continue
+            try:
+                data = path.read_bytes()
+            except OSError:
+                continue
+            rel = str(path.relative_to(home))
+            if data[:16] == b"SQLite format 3\x00":
+                _sqlite_hits(path, rel, hits)
+                continue
+            if name.endswith(("-wal", "-shm", "-journal")) and Path(root, name.rsplit("-", 1)[0]).exists():
+                continue
+            for kind, scen in set(_MARK_RE.findall(data)):
+                hits.add((f"file:{rel}", kind.decode(), scen.decode()))
+    return sorted(hits)
+
+
+def _sandbox() -> Path | None:
+    """The conftest's import-time HERMES_HOME, where import-time captures write in this process."""
+    path = Path(HERMES_HOME_AT_CONFTEST_IMPORT) if HERMES_HOME_AT_CONFTEST_IMPORT else None
+    if path is None or not path.is_dir() or path.resolve() == Path(os.environ["HERMES_HOME"]).resolve():
+        return None
+    return path
+
+
+def scan_all(home: Path, sandbox_before: set) -> list:
+    """This test's HERMES_HOME, plus what the drive newly wrote into the import-time sandbox."""
+    hits = scan(home)
+    sandbox = _sandbox()
+    if sandbox is not None:
+        hits += [(f"sandbox:{loc}", kind, scen) for loc, kind, scen in scan(sandbox)
+                 if (loc, kind, scen) not in sandbox_before]
+    return hits
+
+
+def _sandbox_baseline() -> set:
+    sandbox = _sandbox()
+    return set(scan(sandbox)) if sandbox is not None else set()
+
+
+def _allowed(hit) -> bool:
+    location, kind, scen = hit
+    location = location.removeprefix("sandbox:")
+    for pattern, kinds, scens, _reason in ARTIFACT_ALLOWLIST:
+        if re.fullmatch(pattern, location) and (kinds is None or kind in kinds) and (scens is None or scen in scens):
+            return True
+    return False
+
+
+def _in_messages(hits, kind, scen) -> bool:
+    return any(h == ("db:state.db:messages.content", kind, scen) for h in hits)
