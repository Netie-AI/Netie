+def _seed_old_build_db(db_path: Path) -> None:
+    """Rows as upstream Hermes or the stage 1 fork left them: a full body in system_prompts,
+    a legacy inline body in sessions.system_prompt, and a tool-name pin."""
+    import hashlib
+
+    from hermes_state import SessionDB
+
+    db = SessionDB(db_path=db_path)
+    try:
+        db.create_session("sess-old", "cli", model="auto", system_prompt=SOUL_MARKER)
+        db.update_session_tool_names("sess-old", ["read_file", "terminal"])
+        db.create_session("sess-inline", "cli", model="auto")
+    finally:
+        db.close()
+    conn = sqlite3.connect(db_path)
+    try:
+        conn.execute("UPDATE system_prompts SET prompt = ? WHERE hash = ?",
+                     (SOUL_MARKER, hashlib.sha256(SOUL_MARKER.encode()).hexdigest()))
+        conn.execute("UPDATE sessions SET system_prompt = ?, system_prompt_hash = NULL WHERE id = 'sess-inline'",
+                     ("INLINE " + SOUL_MARKER,))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def test_old_prompt_bodies_are_blanked_on_open_and_the_tool_pin_survives(tmp_path):
