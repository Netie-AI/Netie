+def _is_digest(value: Any) -> bool:
+    """True for a ``netie_ids.digest`` result: exactly ``{len: int, sha256: 64 hex chars}``."""
+    return (isinstance(value, dict) and set(value) == {"len", "sha256"} and isinstance(value["len"], int)
+            and isinstance(value["sha256"], str) and len(value["sha256"]) == 64
+            and all(c in "0123456789abcdef" for c in value["sha256"]))
+
+
+def _ledger_view(payload: Dict[str, Any]) -> Dict[str, Any]:
+    """What the ledger may hold of ``payload``: ids kept, text replaced by digests (see above)."""
+    from agent.netie_ids import IDS_ONLY_MARKER, digest, ids_only
+    if not ids_only():
+        return payload
+    out: Dict[str, Any] = {IDS_ONLY_MARKER: True}
+    for key, value in payload.items():
+        if key in _LEDGER_ID_KEYS or key == IDS_ONLY_MARKER:
+            out[key] = value
+        elif key.endswith("_digest"):  # already reduced on a recovery re-write; anything else is digested
+            out[key] = value if _is_digest(value) or (
+                isinstance(value, list) and all(_is_digest(v) for v in value)) else digest(value)
+        elif key == "results" and isinstance(value, list):
+            out[key] = [_ledger_view(r) if isinstance(r, dict) else digest(r) for r in value]
+        elif key == "goals" and isinstance(value, list):
