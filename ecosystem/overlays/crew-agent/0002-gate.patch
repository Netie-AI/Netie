+async def _gateway(monkeypatch, tmp_path, allow):
+    from gateway.config import GatewayConfig, HomeChannel, Platform, PlatformConfig
+    from gateway.platform_registry import PlatformEntry, platform_registry
+    from gateway.run import GatewayRunner
+    from tests.e2e.core.delivery import _fake_platform as fp
+
+    spool = tmp_path / "spool"
+    spool.mkdir()
+    world = fp.ChildWorld(spool)
+    adapter_cls = fp._adapter_class()
+    platform_registry.register(PlatformEntry(
+        name="noedit", label="noedit", check_fn=lambda: True, source="plugin",
+        adapter_factory=lambda pc: adapter_cls(pc, name="noedit", profile="noedit", world=world),
+        allow_all_env="NOEDIT_ALLOW_ALL_USERS"))
+    monkeypatch.setenv("NOEDIT_ALLOW_ALL_USERS", "true")
+    plat = Platform("noedit")
+    platforms = {plat: PlatformConfig(enabled=True, token="fake-token",
+                                      home_channel=HomeChannel(platform=plat, chat_id="home", name="home"))}
+    if not allow:
+        # Real bot platforms with their tokens from the environment: each must stop at the gate.
+        platforms[Platform.TELEGRAM] = PlatformConfig(enabled=True, token=os.environ["TELEGRAM_BOT_TOKEN"])
+        platforms[Platform.DISCORD] = PlatformConfig(enabled=True, token=os.environ["DISCORD_BOT_TOKEN"])
+        platforms[Platform.SLACK] = PlatformConfig(enabled=True, token=os.environ["SLACK_BOT_TOKEN"])
+    runner = GatewayRunner(GatewayConfig(platforms=platforms, loop_watchdog=False, write_sessions_json=False,
+                                         multiplex_profiles=False))
+    try:
+        await runner.start()
+        adapter = runner.adapters.get(plat)
+        if allow:
+            assert adapter is not None, "the fake platform adapter did not start"
+        if adapter is not None:
+            for i, text in enumerate((f"{_m('USER', 'gw')} TOOLTURN", f"{_m('USER', 'gwp')} plain")):
+                await adapter.inject(text, f"m{i}")
+                await asyncio.sleep(0.3)
+                streak = 0
+                for _ in range(1200):
+                    busy = (set(adapter._active_sessions) | set(adapter._pending_messages)
+                            | set(adapter._session_tasks) | set(runner._running_agents))
+                    streak = 0 if busy else streak + 1
+                    if streak >= 3:
+                        break
+                    await asyncio.sleep(0.05)
+    finally:
+        await runner.stop()
+        platform_registry.unregister("noedit")
+    return [m.text for m in world.server.visible()]
+
+
+def drive_gateway(stub, home, monkeypatch, tmp_path, allow=True):
+    seen = asyncio.run(_gateway(monkeypatch, tmp_path, allow))
+    if not allow:
+        return []
+    assert any(_m("REPLY", "gw") in text for text in seen), seen
+    assert any(_m("REPLY", "gwp") in text for text in seen), seen
+    return ["gw", "gwp"]
