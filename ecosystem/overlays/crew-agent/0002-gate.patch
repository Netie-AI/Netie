+def _quiesce_discord_capability_detection(monkeypatch):
+    """Make the direct drives' strict gate-ask set independent of test order.
+
+    The discord tool's schema build starts a fire-and-forget ``discord-caps-detect`` thread (once
+    per process and token) that asks ``gateway.discord`` against whatever OpenVault URL is set
+    when it runs. Join any such thread before this drive's stub exists, then pin this process's
+    capability cache for the sweep token so no later schema build in the drive starts another."""
+    from tools import discord_tool
+
+    for thread in threading.enumerate():
+        if thread.name == "discord-caps-detect":
+            thread.join(30)
+            assert not thread.is_alive(), "discord capability detection did not finish in 30 s"
+    token = VENDOR_ENV["DISCORD_BOT_TOKEN"]
+    if token not in discord_tool._capability_cache:
+        monkeypatch.setitem(discord_tool._capability_cache, token, dict(discord_tool._PERMISSIVE_CAPS))
+
+
+@pytest.mark.parametrize("surface", sorted(TURN_DRIVES) + sorted(DIRECT_DRIVES))
+def test_egress_sweep_nothing_leaves_loopback_with_a_refusing_gate(
+        surface, request, home, work, netguard, monkeypatch, tmp_path, _gateway_log_files):
+    for name, value in VENDOR_ENV.items():
+        monkeypatch.setenv(name, value)
+    if surface in DIRECT_DRIVES:
+        _quiesce_discord_capability_detection(monkeypatch)
+    stub = _openvault(request, monkeypatch, work, allow=False)
+    if surface in ("cli", "gateway"):
+        TURN_DRIVES[surface](stub, home, monkeypatch, tmp_path, allow=False)
+        reply = None
+    else:
+        reply = (TURN_DRIVES.get(surface) or DIRECT_DRIVES[surface])(stub, home, monkeypatch, tmp_path)
+    unexpected = sorted({f"{a['kind']} {a['host']}:{a['port']} from " + " > ".join(
+        s.rsplit("/", 1)[-1] for s in a["stack"][-5:]) for a in netguard if a["host"] not in EGRESS_ALLOWLIST})
+    assert unexpected == [], (
+        f"the {surface} drive tried to leave the machine with a refusing OpenVault gate: {unexpected}")
+    if surface == "gateway":
+        # Every messaging platform, the fake one and the real bot platforms, stopped at the gate.
+        assert {"gateway.noedit", "gateway.telegram", "gateway.discord", "gateway.slack"} <= set(stub.ask_ids()), \
+            stub.ask_ids()
+    elif surface in TURN_DRIVES:
+        # The model stayed on OpenVault and the tool the model called asked the gate first.
+        assert stub.llm.requests, "the drive never reached the OpenVault model"
+        assert any(str(i).startswith("tool.") for i in stub.ask_ids()), stub.ask_ids()
+    if surface == "cli":
+        # The @url: reference and the network tools the model asked for all stopped at the gate.
+        assert {"tool.web_extract", "tool.web_search"} <= set(stub.ask_ids()), stub.ask_ids()
+    # The drive ran: it caused exactly the gate asks expected of it.
+    asked = Counter(str(i) for i in stub.ask_ids())
+    for ask_id, count in EGRESS_GATE_ASKS[surface].items():
+        assert asked[ask_id] == count, (surface, ask_id, count, dict(asked))
+    if surface in DIRECT_DRIVES:
+        # Only its own tool was asked, and the caller got the labelled refusal back.
+        assert set(asked) == set(EGRESS_GATE_ASKS[surface]), (surface, dict(asked))
+        text = json.dumps(reply)
+        assert "stub refuses everything" in text and "Crew Agent" in text, (surface, reply)
