+
+# 3. Request dump error fields ----------------------------------------------------------------
+
+class _EchoesRequest400(BaseHTTPRequestHandler):
+    """A provider that echoes the request it rejected inside its error body."""
+
+    def do_POST(self):  # noqa: N802 - http.server API
+        sent = self.rfile.read(int(self.headers.get("Content-Length") or 0)).decode()
+        body = json.dumps({"error": {"message": f"bad request: {sent}", "type": "invalid_request_error"}}).encode()
+        self.send_response(400)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *args):
+        pass
+
+
+@pytest.fixture
+def openvault_echo_400():
+    server = ThreadingHTTPServer(("127.0.0.1", 0), _EchoesRequest400)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    yield f"http://127.0.0.1:{server.server_port}/v1"
+    server.shutdown()
+
+
+def test_request_dump_digests_a_provider_error_that_echoes_the_request(monkeypatch, openvault_echo_400):
+    from hermes_constants import get_hermes_home
+
+    home = Path(get_hermes_home())
+    monkeypatch.delenv("HERMES_DUMP_REQUESTS", raising=False)
+    _run_failed_turn(openvault_echo_400)
+    dumps = sorted((home / "sessions").glob("request_dump_*.json"))
+    assert dumps, "the error breadcrumb must still be written"
+    text = _sessions_text(home)
+    assert "NETIESOULMARKER" not in text and "NETIEUSERMARKER" not in text
+    error = json.loads(dumps[0].read_text())["error"]
+    assert error["status_code"] == 400
+    assert error["type"] == "invalid_request_error"
+    assert len(error["body_digest"]["sha256"]) == 64
+    assert "body" not in error and "response_text" not in error
+    assert "Error code: 400" in error["message"] and len(error["message"]) <= 230
+
+    for dump in dumps:
+        dump.unlink()
+    monkeypatch.setenv("HERMES_DUMP_REQUESTS", "1")
+    _run_failed_turn(openvault_echo_400)
+    opted = [json.loads(p.read_text()) for p in sorted((home / "sessions").glob("request_dump_*.json"))]
+    errors = [d["error"] for d in opted if "error" in d]
+    assert errors and "NETIEUSERMARKER" in json.dumps(errors[0]), "the opt-in keeps the full error"
+
+
+class _ProviderError(Exception):
+    """A non-OpenAI SDK error: no body to match, the message itself carries the request echo."""
+
+    status_code = 400
+    code = "bad_request"
+
+    def __str__(self):
+        return f"Error code: 400 - rejected request: system={SOUL!r} user={USER!r}"
+
+
+def test_request_dump_keeps_only_the_error_code_when_no_echo_matched(monkeypatch, openvault_400):
+    from hermes_constants import get_hermes_home
+
+    home = Path(get_hermes_home())
+    monkeypatch.delenv("HERMES_DUMP_REQUESTS", raising=False)
+    agent = _run_failed_turn(openvault_400)
+    for dump in (home / "sessions").glob("request_dump_*.json"):
+        dump.unlink()
+    path = agent._dump_api_request_debug({"model": "auto", "messages": [{"role": "user", "content": USER}]},
+                                         reason="non_retryable_client_error", error=_ProviderError())
+    assert path is not None, "the error breadcrumb must still be written"
+    text = _sessions_text(home)
+    assert "NETIESOULMARKER" not in text and "NETIEUSERMARKER" not in text
+    error = json.loads(Path(path).read_text())["error"]
+    assert error["message"] == "Error code: 400"
+    assert error["type"] == "_ProviderError" and error["code"] == "bad_request" and error["status_code"] == 400
+    assert len(error["message_digest"]["sha256"]) == 64
