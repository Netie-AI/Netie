@@ -0,0 +1,176 @@
+"""Crew Agent stage 2 gate, round 7 (Netie, area: ledgerbytes).
+
+A blanked or deleted row must not leave its text in the database FILE either. Each case drives
+the real writer, runs ``PRAGMA wal_checkpoint(TRUNCATE)`` and reads the raw bytes of the main
+file and its -wal sidecar, which is what a backup, a disk image or a copied profile carries.
+
+1. Gateway delivery ledger: a delivered reply of several KB is gone from state.db / state.db-wal.
+2. SessionDB: a system prompt body an older build stored is scrubbed on open and gone from the file.
+3. runs_idempotency.db: a record an older build stored with run output, once retention deletes
+   it, is gone from the file.
+4. A distribution archive that ships spawn-trees/ or runs_idempotency.db does not install them.
+5. The legacy spawn-tree WARNING also names pre-index session folders (only <ts>.json files).
+"""
+
+import hashlib
+import json
+import logging
+import sqlite3
+import time
+from pathlib import Path
+
+import pytest
+
+from tests.netie.test_crew_agent_gate_r6_sidestores import _gateway_turn, _ledger_adapter
+from tests.netie.test_crew_agent_gate_session import _home, _rows
+
+pytestmark = pytest.mark.netie_real_gate
+
+
+def _long(marker: str) -> str:
+    return " ".join(f"{marker} line {i} of the reply text." for i in range(160))  # > 4 KB
+
+
+def _file_bytes_after_checkpoint(db_path: Path) -> dict:
+    conn = sqlite3.connect(db_path)
+    try:
+        busy, _, _ = conn.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
+    finally:
+        conn.close()
+    assert busy == 0, "checkpoint was blocked by a reader"
+    out = {}
+    for suffix in ("", "-wal"):
+        path = db_path.parent / (db_path.name + suffix)
+        out[path.name] = path.read_bytes() if path.exists() else b""
+    return out
+
+
+def _holding(files: dict, marker: str) -> list:
+    return [name for name, data in files.items() if marker.encode() in data]
+
+
+# 1. Delivery ledger ------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_a_delivered_long_reply_leaves_no_bytes_in_state_db_or_its_wal():
+    from gateway import delivery_ledger as dl
+    from gateway.platforms.base import SendResult
+
+    marker = "LEDGERBYTESMARK"
+    reply = _long(marker)
+    assert len(reply.encode()) >= 4096
+    db_path = dl._db_path()
+    assert str(db_path).startswith(str(_home()))
+    ok = _ledger_adapter(SendResult(success=True, message_id="m1"))
+    before_delivery = {}
+    real_send = ok.send
+
+    async def _send(chat_id, content, reply_to=None, metadata=None):
+        if not before_delivery:  # the obligation is recorded, the reply not yet marked delivered
+            for suffix in ("", "-wal"):
+                path = db_path.parent / (db_path.name + suffix)
+                before_delivery[path.name] = path.read_bytes() if path.exists() else b""
+        return await real_send(chat_id, content, reply_to=reply_to, metadata=metadata)
+
+    ok.send = _send
+    await _gateway_turn(ok, "msg-1", reply)
+    assert "".join(ok.sent).count(marker) == 160  # the user got the whole reply
+    # Precondition: the owed reply's text was written to the ledger file before delivery, so the
+    # empty result below comes from the scrub and not from text that was never stored.
+    assert _holding(before_delivery, marker) != [], "the reply text never reached state.db or its WAL"
+    await _gateway_turn(ok, "msg-2", "a second short reply")  # later ledger write (prune pass)
+
+    rows = _rows(db_path, "SELECT state, content, content_sha256 FROM delivery_obligations ORDER BY created_at")
+    assert [(r["state"], r["content"]) for r in rows] == [("delivered", ""), ("delivered", "")]
+    assert rows[0]["content_sha256"] == hashlib.sha256(reply.encode()).hexdigest()
+    assert _holding(_file_bytes_after_checkpoint(db_path), marker) == []
+
+
+# 2. SessionDB system prompt body scrub -----------------------------------------------------
+
+def test_a_scrubbed_legacy_system_prompt_body_leaves_no_bytes_in_state_db():
+    from hermes_state import SessionDB
+
+    marker = "PROMPTBYTESMARK"
+    db_path = _home() / "state.db"
+    db = SessionDB(db_path=db_path)
+    db.create_session("sess-bytes", "cli", system_prompt="short prompt")
+    db.close()
+    prompt_hash = hashlib.sha256(b"short prompt").hexdigest()
+    with sqlite3.connect(db_path) as conn:  # what an older build left: the body in the row
+        conn.execute("UPDATE system_prompts SET prompt = ? WHERE hash = ?", (_long(marker), prompt_hash))
+        conn.execute("DELETE FROM state_meta WHERE key = 'netie_prompt_scrub_mark'")
+    conn.close()
+    assert _holding(_file_bytes_after_checkpoint(db_path), marker) == ["state.db"]  # precondition
+
+    SessionDB(db_path=db_path).close()  # writable open runs the scrub
+
+    assert _rows(db_path, "SELECT prompt FROM system_prompts WHERE hash = ?", (prompt_hash,)) == [{"prompt": ""}]
+    assert _holding(_file_bytes_after_checkpoint(db_path), marker) == []
+
+
+# 3. runs_idempotency.db retention ----------------------------------------------------------
+
+def test_a_retention_deleted_legacy_run_record_leaves_no_bytes_in_runs_idempotency_db():
+    from gateway.platforms.api_server_run_idempotency import RunIdempotencyStore
+
+    marker = "RUNBYTESMARK"
+    db_path = _home() / "runs_idempotency.db"
+    RunIdempotencyStore(str(db_path)).close()  # creates the table
+    old = time.time() - 3 * 24 * 60 * 60
+    with sqlite3.connect(db_path) as conn:  # an older build's record, with the model output
+        conn.execute(
+            "INSERT INTO run_idempotency (scope, idempotency_key, fingerprint, run_id, status_json, "
+            "created_at, updated_at) VALUES ('s', 'old-key', 'fp', 'run-old', ?, ?, ?)",
+            (json.dumps({"status": "completed", "output": _long(marker)}), old, old))
+    conn.close()
+    assert _holding(_file_bytes_after_checkpoint(db_path), marker) == ["runs_idempotency.db"]
+
+    store = RunIdempotencyStore(str(db_path))
+    try:
+        outcome, _record = store.reserve("s", "new-key", "fp2", "run-new", {"status": "queued"})
+    finally:
+        store.close()
+    assert outcome == "created"
+    assert [r["run_id"] for r in _rows(db_path, "SELECT run_id FROM run_idempotency")] == ["run-new"]
+    assert _holding(_file_bytes_after_checkpoint(db_path), marker) == []
+
+
+# 4. Distribution install --------------------------------------------------------------------
+
+def test_a_distribution_does_not_install_spawn_trees_or_the_run_idempotency_store(tmp_path):
+    from hermes_cli import profile_distribution as pd
+
+    staged = tmp_path / "staged"
+    (staged / "spawn-trees" / "s1").mkdir(parents=True)
+    (staged / "spawn-trees" / "s1" / "a.json").write_text('{"label": "older goal text"}')
+    for name in ("runs_idempotency.db", "runs_idempotency.db-wal", "runs_idempotency.db-shm", "SOUL.md"):
+        (staged / name).write_text("x")
+    manifest = pd.DistributionManifest(name="dist")
+    assert sorted(rel for _src, rel in pd._owned_entries(staged, manifest)) == [("SOUL.md",)]
+    manifest.distribution_owned = ["spawn-trees", "runs_idempotency.db", "SOUL.md"]
+    assert sorted(rel for _src, rel in pd._owned_entries(staged, manifest)) == [("SOUL.md",)]
+
+
+# 5. Pre-index spawn-tree folders ------------------------------------------------------------
+
+def test_the_legacy_spawn_tree_warning_names_a_pre_index_folder(monkeypatch, caplog):
+    import tui_gateway.server as srv
+
+    root = srv._spawn_trees_root()
+    old = root / "pre-index-session"
+    old.mkdir(parents=True)
+    snapshot = old / "20250101T000000.json"
+    snapshot.write_text(json.dumps({"label": "older goal text", "subagents": [{"goal": "old goal"}]}))
+    clean = root / "ids-only-session"
+    clean.mkdir()
+    (clean / "20250102T000000.json").write_text(json.dumps({"netie_ids_only": True, "subagents": []}))
+    caplog.set_level(logging.WARNING)
+
+    saved = srv._methods["spawn_tree.save"](1, {"session_id": "sess-new", "subagents": [{"id": "sa-0"}]})
+    assert "error" not in saved, saved
+
+    warnings = [r.getMessage() for r in caplog.records if "pre-index-session" in r.getMessage()]
+    assert len(warnings) == 1 and f"rm -r {root}" in warnings[0], warnings
+    assert "ids-only-session" not in warnings[0]
+    assert snapshot.exists()  # named, never deleted
