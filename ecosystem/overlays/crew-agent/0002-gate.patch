+
+GW_USER_MARKER = "GWUSERMARKER wire the escrow funds"
+GW_QUOTE_MARKER = "GWQUOTEMARKER the earlier secret answer"
+
+
+@pytest.mark.asyncio
+async def test_gateway_human_turn_leaves_no_user_or_quoted_text_in_logs(_gateway_log_files, monkeypatch):
+    """A human Discord turn that quotes an earlier message: agent.log and gateway.log carry the
+    inbound-message line with lengths and sha256 prefixes, never the user or quoted text."""
+    import hashlib
+
+    import hermes_logging
+    from gateway.config import GatewayConfig, Platform
+    from gateway.platforms.base import MessageEvent
+    from gateway.session import SessionSource, SessionStore
+    from tests.netie.test_crew_agent_gate_session import _gateway_runner
+
+    monkeypatch.delenv("HERMES_LOG_USER_TEXT", raising=False)
+    home = _home()
+    human = SessionSource(platform=Platform.DISCORD, chat_id="1513247605675790346", chat_type="group",
+                          user_id="117431298246705156", user_name="Ace", message_id="155267")
+    store = SessionStore(home / "sessions", GatewayConfig())
+    entry = store.get_or_create_session(human)
+    runner, calls = _gateway_runner(monkeypatch, store, entry, {})
+    await runner._handle_message_with_agent(
+        MessageEvent(text=GW_USER_MARKER, source=human, message_id="155267",
+                     reply_to_message_id="155200", reply_to_text=GW_QUOTE_MARKER),
+        human, entry.session_key, 1)
+    hermes_logging.flush_log_queue()
+    assert calls, "the turn did not reach the agent"
+    agent_log = (_gateway_log_files / "agent.log").read_text()
+    gateway_log = (_gateway_log_files / "gateway.log").read_text()
+    for log in (agent_log, gateway_log):
+        lines = [line for line in log.splitlines() if "inbound message:" in line]
+        assert len(lines) == 1, log[-2000:]
+        sha = hashlib.sha256(GW_USER_MARKER.encode()).hexdigest()[:12]
+        assert f"msg_len={len(GW_USER_MARKER)} msg_sha256={sha}" in lines[0], lines[0]
+        assert f"reply_to_text_len={len(GW_QUOTE_MARKER)}" in lines[0], lines[0]
+        for marker in ("GWUSERMARKER", "escrow", "GWQUOTEMARKER", "secret answer"):
+            assert marker not in log, marker
+
