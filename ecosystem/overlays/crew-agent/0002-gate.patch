+def test_settled_reopen_does_not_run_the_full_probe(tmp_path, monkeypatch):
+    from hermes_state import SessionDB
+
+    db_path = tmp_path / "state.db"
+    _seed_old_build_db(db_path)
+    SessionDB(db_path=db_path).close()  # first open: no mark yet, full probe, scrub, stamp
+    calls = _count_full_probes(monkeypatch)
+    for _ in range(3):
+        SessionDB(db_path=db_path).close()
+    assert calls == []
+    # Deleting the mark row forces one full pass, as the docstring promises.
+    conn = sqlite3.connect(db_path)
