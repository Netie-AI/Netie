+# 4. SessionDB freed legacy prompt bytes ---------------------------------------------------------
+
+def _long(marker: str) -> str:
+    return " ".join(f"{marker} line {i} of the legacy prompt." for i in range(160))  # > 4 KB
+
+
+def _file_bytes_after_checkpoint(db_path: Path) -> dict:
+    conn = sqlite3.connect(db_path)
+    try:
+        busy, _, _ = conn.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
+    finally:
+        conn.close()
+    assert busy == 0, "checkpoint was blocked by a reader"
+    out = {}
+    for suffix in ("", "-wal"):
+        path = db_path.parent / (db_path.name + suffix)
+        out[path.name] = path.read_bytes() if path.exists() else b""
+    return out
+
+
+def _holding(files: dict, marker: str) -> list:
+    return [name for name, data in files.items() if marker.encode() in data]
+
+
+def _open_db():
+    from hermes_state import SessionDB
+    from tests.netie.test_crew_agent_gate_session import _home
+
+    db_path = _home() / "state.db"
+    return db_path, SessionDB(db_path=db_path)
+
+
+def test_update_system_prompt_frees_a_legacy_inline_body_without_leaving_bytes():
+    marker = "INLINEPROMPTBYTESMARK"
+    db_path, db = _open_db()
+    try:
+        db.create_session("sess-inline", "cli", system_prompt="short prompt")
+        with sqlite3.connect(db_path) as conn:  # what an older build left: the body inline in the row
+            conn.execute("UPDATE sessions SET system_prompt = ? WHERE id = ?", (_long(marker), "sess-inline"))
+        conn.close()
+        assert _holding(_file_bytes_after_checkpoint(db_path), marker) == ["state.db"]  # precondition
+
+        db.update_system_prompt("sess-inline", "a newer prompt")
+
+        with sqlite3.connect(db_path) as conn:
+            assert conn.execute("SELECT system_prompt FROM sessions WHERE id = 'sess-inline'").fetchone() == (None,)
+        conn.close()
+        assert _holding(_file_bytes_after_checkpoint(db_path), marker) == []
+    finally:
+        db.close()
+
+
+def test_unreferenced_legacy_prompt_row_is_deleted_without_leaving_bytes():
+    marker = "UNREFPROMPTBYTESMARK"
+    db_path, db = _open_db()
+    try:
+        db.create_session("sess-unref", "cli", system_prompt="short prompt")
+        legacy_hash = hashlib.sha256(b"legacy").hexdigest()
+        with sqlite3.connect(db_path) as conn:  # an older build's body, referenced by no session
+            conn.execute("INSERT INTO system_prompts (hash, prompt) VALUES (?, ?)", (legacy_hash, _long(marker)))
+        conn.close()
+        assert _holding(_file_bytes_after_checkpoint(db_path), marker) == ["state.db"]  # precondition
+
+        db.update_session_tool_names("sess-unref", ["read_file"])  # runs the unreferenced-row delete
+
+        with sqlite3.connect(db_path) as conn:
+            assert conn.execute("SELECT 1 FROM system_prompts WHERE hash = ?", (legacy_hash,)).fetchone() is None
+        conn.close()
+        assert _holding(_file_bytes_after_checkpoint(db_path), marker) == []
+    finally:
+        db.close()
