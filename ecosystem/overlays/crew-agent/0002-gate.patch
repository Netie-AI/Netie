+@pytest.mark.asyncio
+async def test_unserving_a_refused_secondary_restamps_running(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, _created, _connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    try:
+        assert await runner.start() is True
+        await _wait_secondary_bridges(runner)
+        assert _persisted(tmp_path)["gateway_state"] == "degraded"
+        await runner._unserve_profile("p", tmp_path / "profiles" / "p")
+        state = _persisted(tmp_path)
+        assert state["gateway_state"] == "running", state
+        assert "p:telegram" not in state["platforms"]
+    finally:
+        await runner.stop()
+
+
+@pytest.mark.asyncio
+async def test_hot_add_reusing_a_token_held_mid_connect_is_parked(monkeypatch, tmp_path, caplog):
+    """Profile p's secondary reconnect is mid-connect on the shared token (after a gate allow);
+    hot-adding profile q with the same token parks q duplicate_credential: one poller."""
+    import asyncio
+
+    from gateway.config import Platform
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, created, connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    q_home = tmp_path / "profiles" / "q"
+    q_home.mkdir(parents=True)
+    homes = [("default", tmp_path), ("p", tmp_path / "profiles" / "p"), ("q", q_home)]
+
+    async def _no_side_effects(profile_homes):
+        return None
+
+    runner._after_profiles_added = _no_side_effects
+    release = None
+    try:
+        assert await runner.start() is True
+        await _wait_secondary_bridges(runner)
+        # Profile q appears after boot (hot-add) with the same token.
+        monkeypatch.setattr("gateway.run._multiplex_profile_homes", lambda config: list(homes))
+        monkeypatch.setattr("hermes_cli.profiles.profiles_to_serve", lambda *a, **k: list(homes))
+        monkeypatch.setattr("hermes_cli.profiles.get_profile_dir", lambda name: dict(homes)[name])
+        queued = runner._profile_failed_platforms["p"][Platform.TELEGRAM]
+        release = asyncio.Event()
+
+        async def _connect_slow(adapter, platform, *, is_reconnect=False):
+            connects.append(adapter)
+            await release.wait()
+            return True
+
+        runner._connect_adapter_with_timeout = _connect_slow
+        runner._connect_initial_adapter_with_timeout = _connect_slow
+        _allow(monkeypatch)
+        deadline = time.monotonic() + 5
+        while not connects and time.monotonic() < deadline:
+            await asyncio.sleep(0.01)
+        assert len(connects) == 1  # p is mid-connect and holds the token's claim
+        with caplog.at_level("ERROR"):
+            apply = asyncio.ensure_future(runner._apply_profile_changes(
+                {"p": tmp_path / "profiles" / "p", "q": q_home}, ["q"], [], [], reason="test"))
+            done, _ = await asyncio.wait({apply}, timeout=5)
+            assert len(connects) == 1, "hot-added q connected a second poller on p's token"
+            assert apply in done
+            result = apply.result()
+        assert result["added"] == ["q"]
+        assert len(connects) == 1  # q never connected a second poller
+        release.set()
+        await asyncio.wait_for(queued, timeout=5)
+        platforms = _persisted(tmp_path)["platforms"]
+        assert platforms["q:telegram"]["error_code"] == "duplicate_credential", platforms
+        assert platforms["q:telegram"]["state"] == "fatal"
+        assert Platform.TELEGRAM in runner._profile_adapters.get("p", {})
+        assert Platform.TELEGRAM not in runner._profile_adapters.get("q", {})
+        assert any("same credential" in r.getMessage() for r in caplog.records)
+        assert len(created) == 2
+    finally:
+        if release is not None:
+            release.set()
+        await runner.stop()
diff --git a/tests/netie/test_crew_agent_gate_r6_sidestores.py b/tests/netie/test_crew_agent_gate_r6_sidestores.py
