+# 7. Cron honours a YAML int/float model id (round 3) ------------------------------------------
+
+@pytest.mark.parametrize("config_text,expected", [("model: 42\n", "42"), ("model: 3.5\n", "3.5")])
+def test_cron_runs_a_numeric_yaml_model_id_not_auto(config_text, expected, vendor_env):
+    from agent.netie_gate import openvault_v1
