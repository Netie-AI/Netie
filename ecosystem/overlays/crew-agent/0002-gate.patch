+"""Crew Agent stage 2 gate (Netie DR-0002, ecosystem/overlays/crew-agent/0002-gate.patch).
+
+Asserts what the operator and the user actually receive, not internals:
+
+1. Model calls: the default config, read by the real loader, has one provider, OpenVault at
+   ${NETIE_OPENVAULT_URL}/v1, and the real runtime resolver sends the default session there
+   even when vendor keys sit in the environment. The two example files an operator copies
+   carry no model-provider key field.
+2. Tools: a tool call through the real dispatcher asks OpenVault with ids only and is refused,
+   visibly, when OpenVault does not answer allowed=true. The handler does not run.
+3. Session record: a real persisted state.db row carries ids, not the system prompt body (which
+   holds SOUL text and skill bodies) nor the user's message text.
+4. Messaging gateways: an enabled platform with a token does not start without an OpenVault
+   leave-machine allow, and the refusal is labelled in the runtime status.
+5. The CLI says Crew Agent.
+
+Every test here uses the real gate transport (``netie_real_gate``), so with no OpenVault
+listening the gate fails closed; tests that need an allow replace the transport themselves.
+"""
+
+import asyncio
+import json
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+import hermes_yaml
+
+pytestmark = pytest.mark.netie_real_gate
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+DEAD_OPENVAULT = "http://127.0.0.1:9"  # discard port: connection refused, fast
+VENDOR_ENV = {
+    "OPENROUTER_API_KEY": "sk-or-v1-netiegatetestkey000000000000000000",
+    "OPENAI_API_KEY": "sk-netiegatetestkey000000000000000000000000",
+    "ANTHROPIC_API_KEY": "sk-ant-test-netiegatekey000000000000000000",
+}
+PROVIDER_KEY_FIELDS = (
+    "OPENROUTER_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_TOKEN", "FIREWORKS_API_KEY",
+    "NOVITA_API_KEY", "GOOGLE_API_KEY", "GEMINI_API_KEY", "OLLAMA_API_KEY", "GLM_API_KEY", "KIMI_API_KEY",
+    "KIMI_CN_API_KEY", "ARCEEAI_API_KEY", "MINIMAX_API_KEY", "MINIMAX_CN_API_KEY", "OPENCODE_ZEN_API_KEY",
+    "OPENCODE_GO_API_KEY", "HF_TOKEN", "DEEPINFRA_API_KEY", "XIAOMI_API_KEY", "UPSTAGE_API_KEY",
+    "RAMP_ROUTER_API_KEY", "NEBIUS_API_KEY", "TOKENHUB_API_KEY", "TOKENPLAN_API_KEY", "NOUS_API_KEY",
