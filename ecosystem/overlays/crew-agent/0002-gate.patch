new file mode 100644
index 00000000..ffaa5bf2
--- /dev/null
+++ b/agent/netie_ids.py
@@ -0,0 +1,113 @@
+"""Crew Agent (Netie) ids-only persistence: what lands on disk outside the messages table.
+
+Netie SESSION contract: prompt, skill, transcript and result text live in the
+messages table (the declared transcript store) and nowhere else. Every other
+ledger or debug file keeps ids, counts and digests only. ``digest`` is the one
+reduction; ``IDS_ONLY`` is the one seam (True in the product, never configurable).
+Stdlib only.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+from typing import Any, Dict, Iterator
+
+from hermes_constants import PRODUCT_NAME
+
+#: Seam: True keeps prompt/transcript/result text out of ledgers and debug dumps.
+IDS_ONLY = True
+
+#: Marker key on a reduced record so read-back paths know the text was withheld.
+IDS_ONLY_MARKER = "netie_ids_only"
+
+#: Statuses that mean the delegation (or one child of it) finished successfully.
+DONE_STATUSES = ("completed", "success")
+
+
+def replay_label(status: Any, *, paths: Any = (), child_session_id: Any = None) -> str:
+    """What a replayed ids-only delegation (or one child of it) tells the parent.
+
+    Names the child transcript paths the ledger kept; without any, the child session id (its
+    transcript is in the sessions store); without that either, says nothing is left to inspect.
+    A finished delegation is never offered for re-dispatch: that could run its side effects twice.
+    """
+    shown = [str(p) for p in (paths or ()) if p]
+    if shown:
+        where = f"Inspect the child transcript {'path' if len(shown) == 1 else 'paths'}: {', '.join(shown)}."
+    elif child_session_id:
+        where = f"Inspect child session {child_session_id} in the sessions store."
+    else:
+        where = "No child transcript path or child session id was persisted, so nothing here can be inspected."
+    if status in DONE_STATUSES:
+        return ("This delegation completed before this replay; its result text is not persisted "
+                f"({PRODUCT_NAME} persists delegation ids only). {where} It finished, so do not re-run its "
+                "side effects.")
+    return (f"{PRODUCT_NAME} persists delegation ids only; the goal, context and result text of this "
+            f"delegation cannot be replayed. {where} Re-dispatch the task if it is still needed.")
+
+
+#: The labels when nothing about the child was persisted (kept for callers that name them).
+NOT_REPLAYABLE = replay_label("unknown")
+COMPLETED_NOT_REPLAYABLE = replay_label("completed")
+
+
+def ids_only() -> bool:
+    """Whether ledgers and debug files must hold ids and digests instead of text."""
+    return bool(IDS_ONLY)
+
+
+def secure_delete_on(conn: Any) -> Any:
+    """Under ids-only storage, make SQLite zero the bytes it frees on this connection.
+
+    Blanking a column (``content = ''``) or deleting a row leaves the old text in the freed cell
+    space and freelist pages of the database file unless ``secure_delete`` is on. For connections
+    a store opens per write (or owns for its life). A failing PRAGMA raises: the caller does not
+    write text-bearing rows on a connection that would leave their bytes behind.
+    """
+    if ids_only():
+        conn.execute("PRAGMA secure_delete = ON")
+    return conn
+
+
+@contextlib.contextmanager
+def secure_delete(conn: Any) -> Iterator[Any]:
+    """``secure_delete`` on for the statements in the block, then back to the previous value.
+
+    For a blank/scrub write on a long-lived shared connection (SessionDB) whose other writes keep
+    SQLite's default. A no-op unless ids-only storage is on.
+    """
+    if not ids_only():
+        yield conn
+        return
+    previous = int(conn.execute("PRAGMA secure_delete").fetchone()[0])
+    conn.execute("PRAGMA secure_delete = ON")
+    try:
+        yield conn
+    finally:
+        conn.execute(f"PRAGMA secure_delete = {previous}")
+
+
+def digest(value: Any) -> Dict[str, Any]:
+    """``{"len", "sha256"}`` of a str, or of a JSON value in canonical form (sort_keys)."""
+    if isinstance(value, str):
+        text = value
+    else:
+        text = json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"), default=str)
+    return {"len": len(text), "sha256": hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()}
+
+
+def parent_prompt_copy(parent_row: Any) -> Dict[str, Any]:
+    """``create_session`` kwargs that copy a parent's system prompt into a branch or fork child.
+
+    Under ids-only storage the parent row's body is '' and only its sha256 is real, so the
+    child carries the parent's ``system_prompt_hash`` instead: it lands in the ids-only state
+    and its first continuing turn rebuilds the prompt quietly (no "investigate the write path"
+    WARNING, no second on_session_start). A parent that still has a body copies it as upstream.
+    """
+    row = parent_row if isinstance(parent_row, dict) else {}
+    body = row.get("system_prompt") or None
+    if body is None and ids_only() and row.get("system_prompt_hash"):
+        return {"system_prompt": None, "system_prompt_hash": row["system_prompt_hash"]}
+    return {"system_prompt": body}
