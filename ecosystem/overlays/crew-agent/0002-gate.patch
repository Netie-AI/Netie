+def _sqlite_dump(path: Path) -> str:
+    """Every row of every table, read with sqlite3 (WAL included through the connection)."""
+    conn = sqlite3.connect(path)
+    try:
+        tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")]
+        return repr({t: conn.execute(f"SELECT * FROM {t}").fetchall() for t in tables})
+    finally:
+        conn.close()
