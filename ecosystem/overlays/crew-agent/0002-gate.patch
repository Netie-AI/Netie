+def _drain_tui_session(server, sid):
+    """Join the session's background agent build and close the session (stops its pollers).
+
+    The daemon build thread otherwise keeps importing and building into the next tests (a later
+    test's socket guard can see its lookups) and, still mid-import at interpreter exit, deadlocks
+    finalization on the import lock (the file then hangs)."""
+    build = (server._sessions.get(sid) or {}).get("_agent_build_thread")
+    if build is not None:
+        build.join(120)
+        assert not build.is_alive(), "the TUI agent build thread did not finish in 120 s"
+    server.dispatch({"jsonrpc": "2.0", "id": 2, "method": "session.close", "params": {"session_id": sid}})
