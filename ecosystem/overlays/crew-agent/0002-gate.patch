--- /dev/null
+++ b/tests/netie/test_crew_agent_gate_r5_envprov.py
@@ -0,0 +1,174 @@
+"""Crew Agent stage 2 gate, round 5 (envprov): which env and config values keep the OpenVault default.
+
+Asserts what the user receives in the TUI session and the interactive CLI:
+
+1. HERMES_INFERENCE_PROVIDER of "", "auto" (upstream's no-choice value), "openvault" or
+   "custom:openvault" (what ``hermes --tui --provider openvault`` exports) keeps the OpenVault
+   default model ``auto``. Only another provider id is an operator opt-in that withholds it.
+2. A user ``model.base_url`` that is the OpenVault /v1 URL (after normalisation) with no
+   provider keeps ``model.default`` ``auto`` and logs no non-OpenVault WARNING.
+3. The default first-run ``hermes setup`` choice (Keep OpenVault) saves ``model.provider:
+   openvault``, runs the terminal and messaging steps, and the second ``hermes setup`` run
+   treats the home as configured (no first-run menu).
+"""
+
+import logging
+
+import pytest
+
+from tests.netie.test_crew_agent_gate_model import (  # noqa: F401  (vendor_env is a fixture)
+    OPENVAULT_V1,
+    UNRELATED_CONFIG,
+    VENDOR_ENV,
+    _assert_openvault_runtime,
+    _drive_cli,
+    _join_new_threads,
+    _on_disk,
+    _write_config,
+    vendor_env,
+)
+
+pytestmark = pytest.mark.netie_real_gate
+
+
+def _tui_session_model() -> str:
+    """session.create's reported model. Joins the agent build thread it starts, so no build is
+    still importing when the interpreter finalizes (a daemon thread holding the import lock
+    then deadlocks the exit)."""
+    import threading
+
+    from tui_gateway import server
+
+    before = set(threading.enumerate())
+    reply = server.dispatch({"jsonrpc": "2.0", "id": 1, "method": "session.create", "params": {}})
+    _join_new_threads(before)
+    return reply["result"]["info"]["model"]
+
+
+def _assert_openvault_default_everywhere(monkeypatch):
+    from hermes_cli.config import load_config
+    from tui_gateway import server
+
+    model = load_config()["model"]
+    assert model.get("provider") == "openvault" and model.get("default") == "auto", model
+    assert _tui_session_model() == "auto"
+    tui_model, runtime = server._resolve_agent_model_runtime(None, None)
+    assert tui_model == "auto"
+    assert runtime["base_url"] == OPENVAULT_V1
+    assert runtime.get("api_key") not in set(VENDOR_ENV.values())
+    cli = _drive_cli(monkeypatch)
+    assert cli["model"] == "auto", cli
+    assert cli["base_url"] == OPENVAULT_V1
+    assert cli["api_key"] not in set(VENDOR_ENV.values())
+
+
+# 1. HERMES_INFERENCE_PROVIDER values that name no vendor -----------------------------------
+
+@pytest.mark.parametrize("env_value, tui_flag", [
+    ("openvault", True),          # hermes --tui --provider openvault (main_tui_launch)
+    ("custom:openvault", False),
+    ("auto", False),
+    ("AUTO", False),
+    ("OpenVault", False),
+])
+def test_openvault_or_auto_env_provider_keeps_the_default_model(env_value, tui_flag, vendor_env, monkeypatch):
+    _write_config(UNRELATED_CONFIG)
+    monkeypatch.setenv("HERMES_INFERENCE_PROVIDER", env_value)
+    if tui_flag:
+        monkeypatch.setenv("HERMES_TUI_PROVIDER", env_value)
+    _assert_openvault_default_everywhere(monkeypatch)
+    from tui_gateway import server
+
+    model, provider = server._resolve_startup_runtime()
+    assert model == "auto" and provider in ("openvault", env_value), (model, provider)
+
+    # Control: a vendor id is still the operator opt-in that withholds the default.
+    from hermes_cli.config import load_config
+
+    monkeypatch.delenv("HERMES_TUI_PROVIDER", raising=False)
+    monkeypatch.setenv("HERMES_INFERENCE_PROVIDER", "openrouter")
+    assert "provider" not in load_config()["model"]
+    assert _tui_session_model() != "auto"
+
+
+# 2. A user base_url that is the OpenVault endpoint --------------------------------------------
+
+@pytest.mark.parametrize("openvault_env, base_url, expected_v1", [
+    (None, "http://127.0.0.1:5000/v1", OPENVAULT_V1),
+    (None, "http://127.0.0.1:5000/v1/", OPENVAULT_V1),
+    ("http://127.0.0.1:5999/ ", "http://127.0.0.1:5999/v1//", "http://127.0.0.1:5999/v1"),
+])
+def test_openvault_base_url_without_provider_keeps_the_default(
+        openvault_env, base_url, expected_v1, vendor_env, monkeypatch, caplog):
+    from hermes_cli.config import load_config
+    from tui_gateway import server
+
+    if openvault_env is not None:
+        monkeypatch.setenv("NETIE_OPENVAULT_URL", openvault_env)
+    _write_config(f"model:\n  base_url: {base_url}\n")
+    with caplog.at_level(logging.WARNING):
+        model = load_config()["model"]
+        session_model = _tui_session_model()
+    assert model.get("default") == "auto" and model.get("provider") == "openvault", model
+    assert session_model == "auto"
+    tui_model, runtime = server._resolve_agent_model_runtime(None, None)
+    assert tui_model == "auto" and runtime["base_url"] == expected_v1
+    assert runtime.get("api_key") not in set(VENDOR_ENV.values())
+    assert not [r for r in caplog.records if "non-OpenVault model endpoint" in r.getMessage()]
+    import cli
+    from hermes_constants import get_hermes_home
+
+    monkeypatch.setattr(cli, "_hermes_home", get_hermes_home())
+    assert cli.load_cli_config()["model"]["default"] == "auto"
+
+
+# 3. Keep OpenVault is saved, and the second hermes setup sees a configured home ---------------
+
+def _drive_setup(monkeypatch):
+    """Run ``hermes setup`` pressing Enter at every menu. Returns what ran."""
+    from types import SimpleNamespace
+
+    from hermes_cli import setup, setup_quick
+
+    seen = {"menus": [], "nous": 0, "full": 0, "terminal": 0, "gateway": 0}
+
+    def _default_choice(question, choices, default=0, *a, **k):
+        seen["menus"].append((question, list(choices), default))
+        return default
+
+    def _count(key):
+        return lambda *a, **k: seen.__setitem__(key, seen[key] + 1)
+
+    monkeypatch.setattr(setup, "is_interactive_stdin", lambda: True)
+    monkeypatch.setattr(setup, "prompt_choice", _default_choice)
+    monkeypatch.setattr(setup, "_offer_openclaw_migration", lambda home: False)
+    monkeypatch.setattr(setup, "_run_full_setup", _count("full"))
+    monkeypatch.setattr(setup, "_print_setup_summary", lambda *a, **k: None)
+    monkeypatch.setattr(setup, "_record_setup_completed", lambda config: None)
+    monkeypatch.setattr(setup_quick, "_run_nous_flow", _count("nous"))
