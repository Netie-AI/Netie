+    assert started.count("sess-resume") == 1, started
+    assert started.count("sess-other") == 1, started
+    prompt_warnings = [r.getMessage() for r in caplog.records
+                       if r.levelno >= logging.WARNING and "system prompt" in r.getMessage().lower()]
+    assert prompt_warnings == []
