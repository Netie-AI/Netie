+# 4. Shared group session: the pin re-renders from the pinning speaker ------------------------
+
+@pytest.mark.asyncio
+async def test_shared_group_pin_rerenders_from_the_last_speaker_after_restart(monkeypatch, caplog):
+    """Ace opens a shared group session, Bob speaks last. After a restart the first internal turn
+    gets Bob's pinned context bytes (byte-identical, no re-pin WARNING), although the session's
+    origin is still Ace's. gateway_routing keeps routing fields and digests, no prompt text."""
+    from gateway.config import GatewayConfig, Platform
+    from gateway.platforms.base import MessageEvent
+    from gateway.session import SessionSource, SessionStore
+    from tests.netie.test_crew_agent_gate_session import _gateway_runner, _rows
+
+    home = _home()
+    group = dict(platform=Platform.DISCORD, chat_id="1513247605675790346", chat_type="group",
+                 scope_id="1480524732964278294", chat_name="Guild / #ops")
+    ace = SessionSource(**group, user_id="117431298246705156", user_name="Ace", message_id="1001")
+    bob = SessionSource(**group, user_id="227431298246705157", user_name="Bob", message_id="1002")
+    store = SessionStore(home / "sessions", GatewayConfig())
+    entry = store.get_or_create_session(ace)
+    runner, before = _gateway_runner(monkeypatch, store, entry, {})
+    for speaker, text in ((ace, "first"), (bob, "second")):
+        await runner._handle_message_with_agent(
+            MessageEvent(text=text, source=speaker, message_id=speaker.message_id),
+            speaker, entry.session_key, 1)
+    assert "Bob" in before[-1]["context_prompt"]
+    dump = _sqlite_dump(home / "state.db")
+    assert "Current Session Context" not in dump
+
+    reloaded = SessionStore(home / "sessions", GatewayConfig())
+    reloaded_entry = reloaded.get_or_create_session(ace)
+    assert reloaded_entry.origin.user_name == "Ace"  # the origin stays the creator
+    runner, after = _gateway_runner(monkeypatch, reloaded, reloaded_entry, {})
+    wake = SessionSource(platform=Platform.DISCORD, chat_id=group["chat_id"], chat_type="group",
+                         scope_id=group["scope_id"])
+    caplog.clear()
+    with caplog.at_level(logging.WARNING):
+        await runner._handle_message_with_agent(
+            MessageEvent(text="[kanban] wake", source=wake, internal=True), wake, entry.session_key, 1)
+    assert after[0]["context_prompt"] == before[-1]["context_prompt"]
+    assert [r for r in caplog.records if "prompt pin" in r.getMessage()] == []
+    pin = json.loads(_rows(home / "state.db", "SELECT entry_json FROM gateway_routing")[0]["entry_json"])["prompt_pin"]
+    assert pin["source"]["user_name"] == "Bob" and len(pin["context_sha256"]) == 64
+
+
+# 5. Legacy routing rows with prompt bodies are scrubbed on load ------------------------------
+
+LEGACY_CONTEXT_MARKER = "LEGACYCTXMARKER ## Current Session Context: the board room"
+LEGACY_CHANNEL_MARKER = "LEGACYCHANMARKER answer only in rhymes"
+
+
+def test_legacy_routing_row_with_prompt_bodies_is_scrubbed_on_load(caplog):
+    """A gateway_routing row an older build wrote with prompt-pin bodies is rewritten to digests
+    the first time the routing table loads (with a WARNING), not on the entry's next save."""
+    from gateway.config import GatewayConfig, Platform
+    from gateway.session import SessionSource, SessionStore
+    from gateway.session_prompt_pin import prompt_digest
+
+    home = _home()
+    source = SessionSource(platform=Platform.DISCORD, chat_id="1513247605675790346", chat_type="group",
+                           user_id="117431298246705156", user_name="Ace")
+    store = SessionStore(home / "sessions", GatewayConfig())
+    entry = store.get_or_create_session(source)
+    legacy = entry.to_dict()
+    legacy["prompt_pin"] = {"version": 1, "context_key": "k1", "context_prompt": LEGACY_CONTEXT_MARKER,
+                            "redact_pii": False, "channel_prompt": LEGACY_CHANNEL_MARKER,
+                            "parent_chat_id": None}
+    conn = sqlite3.connect(home / "state.db")
+    conn.execute("UPDATE gateway_routing SET entry_json = ? WHERE session_key = ?",
+                 (json.dumps(legacy), entry.session_key))
+    conn.commit()
+    conn.close()
+    assert "LEGACYCTXMARKER" in _sqlite_dump(home / "state.db")
+
+    caplog.clear()
+    with caplog.at_level(logging.WARNING):
+        reloaded = SessionStore(home / "sessions", GatewayConfig())
+        pin = reloaded.get_prompt_pin(entry.session_key)
+    dump = _sqlite_dump(home / "state.db")
+    for marker in ("LEGACYCTXMARKER", "board room", "LEGACYCHANMARKER", "rhymes"):
+        assert marker not in dump, marker
+    conn = sqlite3.connect(home / "state.db")
+    stored = json.loads(conn.execute("SELECT entry_json FROM gateway_routing WHERE session_key = ?",
+                                     (entry.session_key,)).fetchone()[0])["prompt_pin"]
+    conn.close()
+    assert stored["context_sha256"] == prompt_digest(LEGACY_CONTEXT_MARKER)
+    assert stored["channel_sha256"] == prompt_digest(LEGACY_CHANNEL_MARKER)
+    assert pin and pin["context_sha256"] == stored["context_sha256"]
+    assert any("routing entr" in r.getMessage() and "older build" in r.getMessage() for r in caplog.records)
diff --git a/tests/netie/test_crew_agent_gate_r5_claims.py b/tests/netie/test_crew_agent_gate_r5_claims.py
