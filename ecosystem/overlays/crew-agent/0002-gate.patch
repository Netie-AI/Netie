+    statuses, created = [], []
+    runner = _runner(statuses)
+    runner._instantiate_adapter = lambda platform, config: created.append(platform)
+    info = {"config": runner.config.platforms[Platform.TELEGRAM], "attempts": 0,
+            "next_retry": 0.0, "queued_at": time.monotonic()}
+    runner._failed_platforms = {Platform.TELEGRAM: info}
+
+    asyncio.run(runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic()))
+
+    assert created == []
+    assert Platform.TELEGRAM in runner._failed_platforms  # heals when OpenVault allows
+    assert info["attempts"] == 1 and info["next_retry"] > time.monotonic()
+    platform, last = statuses[-1]
+    assert platform == "telegram"
+    assert last["error_code"] == "netie_leave_machine_refused"
+    assert LEAVE_LABEL in last["error_message"]
+    assert last["needs_attention"] is True
+    assert all(kw.get("error_code") != "adapter_unavailable" for _p, kw in statuses)
