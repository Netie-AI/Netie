+def test_a_digest_named_key_holding_text_is_digested_not_passed_through(fresh_home):
+    from agent.netie_ids import digest
+    from tools.process_registry_notifications import format_process_notification
+
+    _produce(fresh_home, "batchtext")  # a child entry carries text under a *_digest key
+    evt = _restore()
+    assert "NETIEERRORMARKER" not in _ledger_text(fresh_home)
+    with sqlite3.connect(fresh_home / "state.db") as conn:
+        (event_json,) = conn.execute("SELECT event_json FROM async_delegations").fetchone()
+    stored = {r["task_index"]: r for r in json.loads(event_json)["results"]}
+    assert stored[0]["notes_digest"] == digest(ERROR)
+    assert stored[0]["error_digest"] == digest(ERROR)  # a real digest still passes through unchanged
+    assert "NETIEERRORMARKER" not in format_process_notification(evt)
