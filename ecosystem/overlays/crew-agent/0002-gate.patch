index 00000000..1cbb6533
--- /dev/null
+++ b/tests/netie/test_crew_agent_gate_r5_claims.py
@@ -0,0 +1,236 @@
+"""Crew Agent stage 2 gate, round 5: claims of gate-refused gateway platforms (Netie DR-0002).
+
+A leave-machine refusal at boot queues a platform before any adapter exists, so it claims no
+credential or listener. On a later allow, every copy of a shared credential must not build and
+connect: one connects, the other is parked ``duplicate_credential`` exactly as at startup. The
+boot accounting and the persisted ``gateway_state`` must say queued/degraded while refused.
+
+Asserts what the operator receives: the boot log and ``gateway_state.json``.
+"""
+
+import asyncio
+import json
+import time
+
+import pytest
+
+from tests.netie.test_crew_agent_gate_gateways import (  # noqa: F401  (multiplex_scope is a fixture)
+    DEAD_OPENVAULT,
+    LEAVE_LABEL,
+    _allow,
+    _multiplex_runner,
+    _StubAdapter,
+    multiplex_scope,
+)
+
+pytestmark = pytest.mark.netie_real_gate
+
+SHARED_TOKEN = "123:shared"
+
+
+class _TokenAdapter(_StubAdapter):
+    """A stub adapter that carries its bot token, so the credential claim is computed."""
+
+    def __init__(self, platform, token):
+        super().__init__(platform)
+        self.token = token
+
+
+def _persisted(home):
+    from gateway.status import flush_runtime_status
+
+    flush_runtime_status()
+    return json.loads((home / "gateway_state.json").read_text())
+
+
+def _multiplex_start_runner(monkeypatch, home, *, primary_token, profile_token=SHARED_TOKEN):
+    """A real GatewayRunner under multiplex serving default plus one secondary profile 'p'."""
+    from contextlib import contextmanager
+
+    import gateway.run as gateway_run
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.run import GatewayRunner
+
+    profile_home = home / "profiles" / "p"
+    profile_home.mkdir(parents=True)
+    homes = [("default", home), ("p", profile_home)]
+
+    @contextmanager
+    def _scope(profile_home, *args, **kwargs):
+        yield
+
+    monkeypatch.setattr(gateway_run, "_profile_runtime_scope", _scope)
+    monkeypatch.setattr(gateway_run, "_reconnect_backoff", lambda attempts: 0.02)
+    monkeypatch.setattr(gateway_run, "_multiplex_profile_homes", lambda config: list(homes))
+    monkeypatch.setattr("hermes_cli.profiles.profiles_to_serve", lambda *a, **k: list(homes))
+    monkeypatch.setattr("hermes_cli.profiles.profile_is_parked", lambda home: False)
+    monkeypatch.setattr("hermes_cli.profiles.get_profile_dir", lambda name: dict(homes)[name])
+    monkeypatch.setattr("hermes_cli.env_loader.hydrate_profile_secret_sources", lambda home: None)
+    monkeypatch.setattr(GatewayRunner, "_start_free_tier_bootstrap", staticmethod(lambda: None))
+    primary = PlatformConfig(enabled=True, token=primary_token) if primary_token else PlatformConfig(enabled=True)
+    runner = GatewayRunner(GatewayConfig(multiplex_profiles=True, platforms={Platform.TELEGRAM: primary},
+                                         sessions_dir=home / "sessions"))
+    runner._multiplex_on = lambda: True
+    profile_cfg = GatewayConfig(multiplex_profiles=True,
+                                platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token=profile_token)})
+
+    async def _load(profile_name, profile_home):
+        return profile_cfg
+
+    runner._load_secondary_profile_config = _load
+    # The secondary reconnect reloads the profile's config under its scope.
+    monkeypatch.setattr("gateway.config.load_gateway_config", lambda: profile_cfg)
+    created, connects = [], []
+    runner._instantiate_adapter = (
+        lambda platform, config: created.append(platform) or _TokenAdapter(platform, config.token))
+    return runner, profile_cfg, created, connects
+
+
+@pytest.mark.asyncio
+async def test_shared_token_refused_at_boot_connects_once_on_allow(monkeypatch, tmp_path, caplog):
+    """Primary and secondary share one bot token; both refused at boot, then allowed:
+    exactly one connects and the other is parked duplicate_credential (never two pollers)."""
+    from gateway.config import Platform
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, profile_cfg, created, connects = _multiplex_start_runner(
+        monkeypatch, tmp_path, primary_token=SHARED_TOKEN)
+    try:
+        assert await runner.start() is True
+        assert created == []  # both refused before any adapter exists
+        assert Platform.TELEGRAM in runner._failed_platforms
+        state = _persisted(tmp_path)
+        assert state["platforms"]["telegram"]["error_code"] == "netie_leave_machine_refused"
+        assert state["platforms"]["p:telegram"]["error_code"] == "netie_leave_machine_refused"
+        for bridge in list(runner._background_tasks):
+            if bridge.get_name().startswith("secondary-startup-reconnect"):
+                await asyncio.wait_for(bridge, timeout=2)
+        queued = runner._profile_failed_platforms.get("p", {}).get(Platform.TELEGRAM)
+        assert isinstance(queued, asyncio.Task)
+
+        # OpenVault allows: both reconnect paths now build an adapter for the same token.
+        _allow(monkeypatch)
+
+        async def _connect_ok(adapter, platform, *, is_reconnect=False):
+            # What a real adapter's _mark_connected writes, under the key the runner gave it.
+            from gateway.status import publish_runtime_status
+
+            connects.append(adapter)
+            publish_runtime_status(platform=adapter.__dict__.get("_runtime_status_platform_key", "telegram"),
+                                   platform_state="connected", error_code=None, error_message=None)
+            return True
+
+        runner._connect_adapter_with_timeout = _connect_ok
+        with caplog.at_level("ERROR"):
+            await asyncio.wait_for(queued, timeout=5)
+            runner._failed_platforms[Platform.TELEGRAM]["next_retry"] = 0.0
+            await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic())
+
+        assert len(connects) == 1  # one poller on the token, never two
+        platforms = _persisted(tmp_path)["platforms"]
+        codes = {key: platforms[key].get("error_code") for key in ("telegram", "p:telegram")}
+        states = {key: platforms[key]["state"] for key in ("telegram", "p:telegram")}
+        assert sorted(codes.values(), key=str) == sorted([None, "duplicate_credential"], key=str), codes
+        assert sorted(states.values()) == ["connected", "fatal"], states
+        assert any("same credential" in r.getMessage() for r in caplog.records)
+        assert Platform.TELEGRAM not in runner._failed_platforms  # parked or installed, not retried
+    finally:
+        await runner.stop()
+
+
+@pytest.mark.asyncio
+async def test_concurrent_reconnects_of_one_token_connect_once(monkeypatch, multiplex_scope):
+    """Primary watcher and secondary reconnect connecting at the same time: the reservation
+    held during connect makes the second one duplicate_credential."""
+    from gateway.config import Platform
+
+    statuses, created = [], []
+    runner, profile_cfg = _multiplex_runner(statuses, created)
+    runner._instantiate_adapter = (
+        lambda platform, config: created.append(platform) or _TokenAdapter(platform, config.token))
+    monkeypatch.setattr("gateway.config.load_gateway_config", lambda: profile_cfg)
+    runner.adapters = {}
+    runner._failed_platforms = {Platform.TELEGRAM: {
+        "config": profile_cfg.platforms[Platform.TELEGRAM], "attempts": 0, "next_retry": 0.0,
+        "queued_at": time.monotonic(), "netie_refused": True}}
+    _allow(monkeypatch)
+    release = asyncio.Event()
+    connects = []
+
+    async def _connect_slow(adapter, platform, *, is_reconnect=False):
+        connects.append(adapter)
+        await release.wait()
+        return True
+
+    runner._connect_adapter_with_timeout = _connect_slow
+    secondary = asyncio.create_task(runner._secondary_reconnect_attempt("p", Platform.TELEGRAM))
+    deadline = time.monotonic() + 5
+    while not connects and time.monotonic() < deadline:
+        await asyncio.sleep(0.01)
+    assert len(connects) == 1  # the secondary is mid-connect
+    await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic())
+    release.set()
+    adapter, success = await asyncio.wait_for(secondary, timeout=5)
+    assert success is True and len(connects) == 1
+    assert created == [Platform.TELEGRAM, Platform.TELEGRAM]
+    key, last = [(k, kw) for k, kw in statuses if kw.get("error_code") == "duplicate_credential"][-1]
+    assert key == "telegram" and last["platform_state"] == "fatal"
+    assert Platform.TELEGRAM not in runner._failed_platforms
+
+
+@pytest.mark.asyncio
+async def test_secondary_only_credentials_refused_at_boot_report_queued_and_degraded(
+        monkeypatch, tmp_path, caplog):
+    """Every bot credential lives in a secondary profile: a gate refusal at boot is reported as
+    queued for retry and the persisted gateway_state is degraded, not 'No messaging platforms'."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, created, _connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    try:
+        with caplog.at_level("INFO"):
+            assert await runner.start() is True
+        logs = [r.getMessage() for r in caplog.records]
+        assert created == []
+        assert not any("No messaging platforms enabled" in m for m in logs)
+        assert any("queued for retry" in m and "p:telegram" in m and LEAVE_LABEL in m for m in logs), logs
+        state = _persisted(tmp_path)
+        assert state["gateway_state"] == "degraded"
+        assert state["platforms"]["p:telegram"]["error_code"] == "netie_leave_machine_refused"
+    finally:
+        await runner.stop()
+
+
+@pytest.mark.asyncio
+async def test_refused_boot_persists_degraded_until_the_allow(monkeypatch, tmp_path):
+    """gateway_state stays degraded after start() while a platform is queued on a refusal, and
+    returns to running once the gate allows it."""
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.run import GatewayRunner
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    monkeypatch.setattr(GatewayRunner, "_start_free_tier_bootstrap", staticmethod(lambda: None))
+    runner = GatewayRunner(GatewayConfig(
+        platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="123:abc")},
+        sessions_dir=tmp_path / "sessions"))
+    runner._instantiate_adapter = lambda platform, config: _TokenAdapter(platform, config.token)
+    try:
+        assert await runner.start() is True
+        assert _persisted(tmp_path)["gateway_state"] == "degraded"
+        await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic() + 3600)
+        assert _persisted(tmp_path)["gateway_state"] == "degraded"  # still refused
+
+        _allow(monkeypatch)
+
+        async def _connect_ok(adapter, platform, *, is_reconnect=False):
+            return True
+
+        runner._connect_adapter_with_timeout = _connect_ok
+        runner._failed_platforms[Platform.TELEGRAM]["next_retry"] = 0.0
+        await runner._reconnect_failed_platform(Platform.TELEGRAM, time.monotonic())
+        state = _persisted(tmp_path)
+        assert state["platforms"]["telegram"]["state"] == "connected"
+        assert state["gateway_state"] == "running"
+    finally:
+        await runner.stop()
diff --git a/tests/netie/test_crew_agent_gate_r5_envprov.py b/tests/netie/test_crew_agent_gate_r5_envprov.py
