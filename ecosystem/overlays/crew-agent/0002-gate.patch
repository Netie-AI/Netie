+@pytest.mark.asyncio
+async def test_gateway_streaming_tts_gate_ask_does_not_block_the_event_loop(monkeypatch, streamer):
+    from types import SimpleNamespace
+
+    from gateway.run import GatewayRunner
+    from gateway.streaming_tts_consumer import StreamingTTSConsumer
+
+    asks = _allow(monkeypatch, delay=0.6)  # a slow OpenVault
+    monkeypatch.setattr(StreamingTTSConsumer, "start", lambda self: None)
+    adapter = SimpleNamespace(_should_auto_tts_for_chat=lambda chat_id: True)
+    host = SimpleNamespace(_delivery_adapter_for=lambda source: adapter, _gateway_loop=asyncio.get_running_loop())
+    source = SimpleNamespace(chat_id="c1")
+    holder = [None]
+    ticks = []
+
+    async def _ticker():
+        while True:
+            ticks.append(time.monotonic())
+            await asyncio.sleep(0.02)
+
+    ticker = asyncio.create_task(_ticker())
+    await asyncio.sleep(0.05)
+    started = time.monotonic()
+    try:
+        result = GatewayRunner._run_agent_start_streaming_tts(host, source, "voice", None, holder)
+        if asyncio.iscoroutine(result):
+            await result
+        ended = time.monotonic()
+    finally:
+        ticker.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await ticker
+    assert [(a["id"], a["child_id"]) for a in asks] == [("tool.text_to_speech", "tts.streaming")]
+    assert asks[0]["_thread"] is not threading.main_thread(), "the gate ask ran on the event loop thread"
+    during = [t for t in ticks if started < t < ended]
+    assert len(during) >= 10, ("the event loop stalled during the gate ask", ended - started, len(during))
+    assert isinstance(holder[0], StreamingTTSConsumer) and holder[0].active  # behaviour unchanged
