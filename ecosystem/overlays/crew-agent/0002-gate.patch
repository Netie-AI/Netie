+        try:
+            first = _agent(srv, db, "sess-resume").run_conversation(
+                "first question", conversation_history=[], task_id="sess-resume")
+            history = first["messages"]
+            assert history, first
+            caplog.clear()
+            with caplog.at_level(logging.WARNING):
+                # A new AIAgent per request, as the API server and a restarted gateway build it.
+                second = _agent(srv, db, "sess-resume").run_conversation(
+                    "second question", conversation_history=history, task_id="sess-resume")
+            # A brand new session in the same store still starts exactly once.
+            _agent(srv, db, "sess-other").run_conversation(
+                "other question", conversation_history=[], task_id="sess-other")
