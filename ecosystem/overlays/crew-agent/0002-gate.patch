+++ b/tests/netie/test_crew_agent_gate_r5_small.py
@@ -0,0 +1,259 @@
+"""Crew Agent stage 2 gate, round 5 small fixes (Netie, area: small).
+
+What the operator and the user receive:
+
+1. ``update_system_prompt(id, None)`` is still upstream's clear under ids-only storage: the row's
+   prompt id goes NULL, so ``hermes sessions repair-prompts --apply`` really clears what it says.
+2. A profile move whose source prompt row is missing lands NULL (upstream), not a carried id that
+   hides the corruption; an ids-only source ('' body) still keeps its id.
+3. Identity: the WhatsApp self-chat reply prefix (Python and bridge), the WhatsApp setup tip,
+   /help (header and the update/version descriptions, relay manifest too), the gateway status
+   header, the online and restart notices say Crew Agent; the doctor header fits its box.
+4. A failed child of an ids-only batch names its own transcript path, not every child's.
+5. A refused a2a_call asks the leave-machine gate once and records nothing as sent.
+"""
+
+import argparse
+import io
+import json
+import os
+import re
+import sqlite3
+import time
+import unicodedata
+from contextlib import redirect_stdout
+from pathlib import Path
+
+import pytest
+
+from tests.netie.test_crew_agent_gate_gateways import A2A_LABEL, a2a_wire  # noqa: F401 (fixture)
+from tests.netie.test_crew_agent_gate_session import _rows
+
+pytestmark = pytest.mark.netie_real_gate
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def _hash_of(db_path, session_id):
+    return _rows(db_path, "SELECT system_prompt_hash FROM sessions WHERE id = ?", (session_id,))[0][
+        "system_prompt_hash"]
+
+
+# 1. update_system_prompt(None) clears -------------------------------------------------------
+
+def test_update_system_prompt_none_clears_the_prompt_id_and_keeps_empty_carry(tmp_path):
+    from hermes_state import SessionDB
+
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    try:
+        db.create_session("a", "cli", system_prompt="PROMPT-A")
+        db.create_session("b", "cli", system_prompt="PROMPT-B")
+        hash_b = _hash_of(db_path, "b")
+        assert _hash_of(db_path, "a") and hash_b
+
+        db.update_system_prompt("a", None)
+        db.update_system_prompt("b", "")  # retain-seeded in-place compaction: keeps the id
+        assert _hash_of(db_path, "a") is None
+        assert _hash_of(db_path, "b") == hash_b
+    finally:
+        db.close()
+
+
+def test_repair_prompts_apply_really_clears_the_targeted_row(tmp_path, monkeypatch, capsys):
+    from hermes_cli import sessions_cmd
+    from hermes_state import SessionDB
+
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    try:
+        db.create_session("degraded", "cli", system_prompt="REDUCED TOOLSET PROMPT")
+        assert _hash_of(db_path, "degraded")
+        # Under ids-only the resolved body is ''; the command only acts on a row with a body, so
+        # show it one (as an older store would) to drive the --apply clear end to end.
+        real_get = db.get_session
+        monkeypatch.setattr(db, "get_session", lambda sid: {**(real_get(sid) or {}),
+                                                            "system_prompt": "REDUCED TOOLSET PROMPT"})
+        rc = sessions_cmd._cmd_repair_prompts(db, argparse.Namespace(session_id="degraded", apply=True, json=True))
+        out = json.loads(capsys.readouterr().out)
+        assert rc == 0 and out["cleared"] == ["degraded"]
+        assert _hash_of(db_path, "degraded") is None
+    finally:
+        db.close()
+
+
+# 2. profile move keeps a dangling source hash visible ---------------------------------------
+
+def _move(tmp_path, *, drop_source_prompt):
+    from hermes_state import SessionDB
+
+    tmp_path.mkdir()
+    src_path, dst_path = tmp_path / "src.db", tmp_path / "dst.db"
+    src, dst = SessionDB(db_path=src_path), SessionDB(db_path=dst_path)
+    try:
+        src.create_session("moved", "cli", system_prompt="MOVED PROMPT")
+        source_hash = _hash_of(src_path, "moved")
+        if drop_source_prompt:
+            conn = sqlite3.connect(src_path)
+            conn.execute("DELETE FROM system_prompts WHERE hash = ?", (source_hash,))
+            conn.commit()
+            conn.close()
+        payload = src.export_session_for_move("moved")
+        assert dst.import_moved_session(payload, profile_name="other") == "imported"
+    finally:
+        src.close()
+        dst.close()
+    return source_hash, _hash_of(dst_path, "moved"), _rows(dst_path, "SELECT hash, prompt FROM system_prompts")
+
+
+def test_profile_move_lands_null_for_a_missing_source_prompt_and_carries_an_ids_only_one(tmp_path):
+    _source_hash, moved_hash, prompts = _move(tmp_path / "dangling", drop_source_prompt=True)
+    assert moved_hash is None
+    assert prompts == []
+
+    source_hash, moved_hash, prompts = _move(tmp_path / "ids-only", drop_source_prompt=False)
+    assert moved_hash == source_hash
+    assert prompts == [{"hash": source_hash, "prompt": ""}]
+
+
+# 3. identity strings the user sees ----------------------------------------------------------
+
+def _no_hermes_agent(text):
+    assert "Crew Agent" in text and "Hermes" not in text, text
+
+
+def test_whatsapp_self_chat_reply_prefix_says_crew_agent_in_python_and_bridge(monkeypatch):
+    from gateway.platforms.whatsapp_common import WhatsAppBehaviorMixin
+    from hermes_constants import PRODUCT_NAME
+
+    monkeypatch.delenv("WHATSAPP_REPLY_PREFIX", raising=False)
+    monkeypatch.setenv("WHATSAPP_MODE", "self-chat")
+    mixin = object.__new__(WhatsAppBehaviorMixin)
+    mixin._reply_prefix = None
+    prefix = mixin._effective_reply_prefix()
+    _no_hermes_agent(prefix)
+    assert prefix.startswith(f"\u2624 *{PRODUCT_NAME}*\n")
+
+    # bridge.js prepends its own default to every self-chat reply: it must be the same bytes.
+    src = (REPO / "scripts" / "whatsapp-bridge" / "bridge.js").read_text(encoding="utf-8")
+    [literal] = re.findall(r"^const DEFAULT_REPLY_PREFIX = '([^']*)';$", src, flags=re.M)
+    assert json.loads(f'"{literal}"') == prefix
+
+
+def test_whatsapp_setup_tip_names_crew_agent(tmp_path, monkeypatch):
+    from hermes_cli import main_platform_setup as mps
+
+    home = Path(os.environ["HERMES_HOME"])
+    for key in list(os.environ):
+        if key.startswith("WHATSAPP_"):
+            monkeypatch.delenv(key, raising=False)
+    monkeypatch.setattr("hermes_cli.main._require_tty", lambda *_a, **_kw: None)
+    monkeypatch.setattr(mps, "_whatsapp_choose_mode", lambda *_a: "self-chat")
+    monkeypatch.setattr(mps, "_whatsapp_allowed_users", lambda *_a: None)
+    monkeypatch.setattr(mps, "_whatsapp_install_bridge", lambda _d: True)
+    monkeypatch.setattr("hermes_constants.find_node_executable", lambda _n: "/usr/bin/node")
+
+    def _pair(*_a, **_kw):  # the bridge's --pair-only run writes creds.json on success
+        (home / "whatsapp" / "session" / "creds.json").write_text("{}")
+
+    monkeypatch.setattr(mps.subprocess, "run", _pair)
+    buf = io.StringIO()
+    with redirect_stdout(buf):
+        mps.cmd_whatsapp(argparse.Namespace())
+    [tip] = [line for line in buf.getvalue().splitlines() if "Tip:" in line]
+    _no_hermes_agent(tip)
+    assert tip.strip() == "Tip: Agent responses are prefixed with '\u2624 Crew Agent'"
+
+
+def test_gateway_help_status_and_restart_notices_say_crew_agent():
+    from agent.i18n import t
+    from gateway.relay.command_manifest import build_relay_command_manifest
+    from hermes_cli.slash_exec import CommandContext, _exec_help
+
+    help_text = _exec_help(CommandContext(surface="gateway")).text
+    _no_hermes_agent(help_text.splitlines()[0])
+    for line in help_text.splitlines():
+        assert "Hermes Agent" not in line, line
+    assert "Update Crew Agent to the latest version" in help_text
+    assert "Show Crew Agent version" in help_text
+    manifest = {c["name"]: c["description"] for c in build_relay_command_manifest()}
+    assert manifest["update"] == "Update Crew Agent to the latest version"
+
+    for key in ("gateway.help.header", "gateway.status.header", "gateway.startup.online",
+                "gateway.shutdown.notice_restart", "gateway.shutdown.notice_shutdown"):
+        _no_hermes_agent(t(key, "en"))
+    assert t("gateway.startup.online", "en") == "\u267b\ufe0f Gateway online \u2014 Crew Agent is back and ready."
+
+
+def _cols(text):
+    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
+               for c in text)
+
+
+def test_doctor_header_fits_its_box(monkeypatch):
+    from hermes_cli import doctor, doctor_live
+
+    monkeypatch.setattr(doctor, "DOCTOR_CHECKS", [])
+    monkeypatch.setattr(doctor_live, "maybe_run_live_checks", lambda *_a, **_kw: None)
+    buf = io.StringIO()
+    with redirect_stdout(buf):
+        doctor.run_doctor(argparse.Namespace(fix=False, ack=None))
+    lines = [re.sub(r"\x1b\[[0-9;]*m", "", ln) for ln in buf.getvalue().splitlines()]
+    top = next(i for i, ln in enumerate(lines) if ln.startswith("\u250c"))
+    border, title, bottom = lines[top:top + 3]
+    _no_hermes_agent(title)
+    assert _cols(title) == _cols(border) == _cols(bottom), (border, title, bottom)
+
+
+# 4. failed batch child names its own transcript ---------------------------------------------
+
+def test_failed_batch_children_each_name_their_own_transcript(tmp_path):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from tools import async_delegation as ad
+
+    ad._reset_for_tests()
+    token = set_hermes_home_override(str(tmp_path))
+    try:
+        ad._persist_dispatch({
+            "delegation_id": "d-batch", "session_key": "", "origin_ui_session_id": "ui-1",
+            "parent_session_id": "agent-1", "dispatched_at": time.time() - 60, "is_batch": True,
+            "goals": ["GOAL zero", "GOAL one"], "task_indexes": [0, 1],
+            "task_transcripts": {"0": "/t/child-0.jsonl", "1": "/t/child-1.jsonl"}})
+        ad._persist_completion({"delegation_id": "d-batch", "status": "error", "completed_at": time.time()},
+                               {"results": [{"task_index": 0, "status": "error", "error": "E0"},
+                                            {"task_index": 1, "status": "timeout", "error": "E1"}]})
+        ad._reset_for_tests()  # a reload: the live record (and its goal text) is gone
+        rows = {r["task_index"]: r["error"] for r in ad.failed_delegations_for_session("ui-1")}
+    finally:
+        reset_hermes_home_override(token)
+        ad._reset_for_tests()
+    assert sorted(rows) == [0, 1]
+    assert "Inspect the child transcript path: /t/child-0.jsonl." in rows[0] and "child-1" not in rows[0]
+    assert "Inspect the child transcript path: /t/child-1.jsonl." in rows[1] and "child-0" not in rows[1]
+
+
+# 5. a2a refusal: one ask, nothing recorded as sent ------------------------------------------
+
+def test_refused_a2a_call_asks_the_gate_once_and_records_nothing(monkeypatch, a2a_wire):  # noqa: F811
+    from agent import netie_gate
+    from plugins.platforms.a2a import protocol
+
+    a2a_tools, calls = a2a_wire
+    asks = []
+
+    def _refuse(_url, payload):
+        asks.append(payload)
+        return {"allowed": False, "reason": "not on the leave list"}
+
+    monkeypatch.setattr(netie_gate, "_post", _refuse)
+    before = protocol.metrics.outbound_total
+    home = Path(os.environ["HERMES_HOME"])
+    out = a2a_tools.a2a_call({"agent": "peer", "message": "SECRET-TASK", "context_id": "ctx-r5"})
+
+    assert out.startswith("Error:") and A2A_LABEL in out and "not on the leave list" in out, out
+    assert calls == []
+    assert [p["id"] for p in asks] == ["gateway.a2a"]
+    assert protocol.metrics.outbound_total == before
+    assert not (home / "a2a_conversations" / "ctx-r5.jsonl").exists()
+    audit = home / "a2a_audit.jsonl"
+    assert not audit.exists() or "SECRET-TASK" not in audit.read_text()
diff --git a/tests/netie/test_crew_agent_gate_r6_directcallers.py b/tests/netie/test_crew_agent_gate_r6_directcallers.py
new file mode 100644
index 00000000..e68223af
--- /dev/null
+++ b/tests/netie/test_crew_agent_gate_r6_directcallers.py
@@ -0,0 +1,286 @@
+"""Crew Agent stage 2 gate, round 6: direct callers of tool backends ask the OpenVault crew gate.
+
+1. Image generation: the TUI/desktop ``image.generate`` RPC (calls the image_generate handler) and
+   ``pet.generate`` / ``pet.hatch`` (call the image_gen provider) never reach a provider on refusal.
+2. Speech-to-text: ``transcribe_audio`` (gateway voice notes, CLI/desktop voice) asks first, and with
+   no local backend it does not silently fall back to a cloud vendor the user did not choose.
+3. ``PluginContext.call_mcp`` asks for ``mcp__<server>__<tool>`` before the MCP handler runs.
+
+Each refusal case uses a dead OpenVault; each allow case asserts the backend ran exactly once.
+"""
+
+import asyncio
+import json
+import wave
+
+import pytest
+
+from tests.netie.test_crew_agent_gate import DEAD_OPENVAULT
+
+pytestmark = pytest.mark.netie_real_gate
+
+REFUSED_IMAGE = "Crew Agent refused tool 'image_generate'"
+REFUSED_STT = "Crew Agent refused tool 'transcription'"
+UNREACHABLE = "OpenVault crew gate unreachable"
+
+
+def _allow(monkeypatch):
+    from agent import netie_gate
+
+    asks = []
+    monkeypatch.setattr(netie_gate, "_post", lambda url, payload: asks.append(payload) or {"allowed": True})
+    return asks
