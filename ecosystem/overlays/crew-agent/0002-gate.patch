+"""Crew Agent stage 2 gate, round 7: speech egress that skipped the 'transcription' and
+'text_to_speech' asks.
+
+1. GET /api/audio/voice-config (client-direct voice) handed the desktop a cloud STT/TTS vendor key.
+   Now a direct verdict asks the gate first; on refusal the desktop gets the relay verdict with the
+   label and no key.
+2. The QQ bot adapter's own STT upload (``_call_stt``) asks as tool 'transcription'; on refusal
+   nothing is uploaded and the voice line carries the label.
+3. Streaming TTS (``resolve_streaming_provider``: gateway voice replies, desktop speak-stream, CLI
+   speaker) asks as tool 'text_to_speech' before a streamer sends reply text to its vendor.
+4. The Teams pipeline treats a netie refusal as final, not as a retryable vendor outage.
+5. Allow-once coverage asked for by the round 6 review: pet.hatch, gateway voice, CLI barge-in label
+   and the hermes_cli/voice.py WARNING.
+"""
+
+import asyncio
+import json
+import logging
+import wave
+
+import pytest
+
+from tests.netie.test_crew_agent_gate import DEAD_OPENVAULT
+
+pytestmark = pytest.mark.netie_real_gate
+
+REFUSED_STT = "Crew Agent refused tool 'transcription'"
+REFUSED_TTS = "Crew Agent refused tool 'text_to_speech'"
+REFUSED_IMAGE = "Crew Agent refused tool 'image_generate'"
+UNREACHABLE = "OpenVault crew gate unreachable"
+GROQ_KEY = "gsk-netiesttsecretkey"
+ELEVEN_KEY = "el-netiettssecretkey"
+
+
+def _allow(monkeypatch):
+    from agent import netie_gate
+
+    asks = []
+    monkeypatch.setattr(netie_gate, "_post", lambda url, payload: asks.append(payload) or {"allowed": True})
+    return asks
+
+
+def _wav(path):
+    with wave.open(str(path), "wb") as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(16000)
+        w.writeframes(b"\x01\x00" * 16000)
+    return str(path)
+
+
+# 1. Client-direct voice config ----------------------------------------------------------------
+
+@pytest.fixture
+def voice_config(monkeypatch):
+    """An explicit cloud STT (groq) and TTS (elevenlabs) provider, each with a key."""
+    import tools.transcription_tools as tt
+    import tools.tts_tool as tts
+
+    monkeypatch.setattr(tt, "_load_stt_config", lambda: {"provider": "groq", "enabled": True})
+    monkeypatch.setattr(tts, "_load_tts_config", lambda: {"provider": "elevenlabs"})
+    monkeypatch.setenv("GROQ_API_KEY", GROQ_KEY)
+    monkeypatch.setenv("ELEVENLABS_API_KEY", ELEVEN_KEY)
+
+
+@pytest.fixture
+def web_client():
+    from starlette.testclient import TestClient
+
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    c = TestClient(app, raise_server_exceptions=False)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    return c
+
+
+def test_voice_config_refused_hands_the_desktop_no_vendor_key_and_shows_the_label(
+        monkeypatch, voice_config, web_client):
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    resp = web_client.get("/api/audio/voice-config")
+    assert resp.status_code == 200, resp.text
+    body = resp.json()
+    assert GROQ_KEY not in resp.text and ELEVEN_KEY not in resp.text
+    assert body["stt"]["mode"] == "relay" and "api_key" not in body["stt"]
+    assert REFUSED_STT in body["stt"]["reason"] and UNREACHABLE in body["stt"]["reason"]
+    assert body["tts"]["mode"] == "relay" and "api_key" not in body["tts"]
+    assert REFUSED_TTS in body["tts"]["reason"]
+
+
+def test_voice_config_allowed_returns_direct_after_one_ask_per_direction(monkeypatch, voice_config, web_client):
+    asks = _allow(monkeypatch)
+    body = web_client.get("/api/audio/voice-config").json()
+    assert body["stt"]["mode"] == "direct" and body["stt"]["api_key"] == GROQ_KEY
+    assert body["tts"]["mode"] == "direct" and body["tts"]["api_key"] == ELEVEN_KEY
+    assert sorted(a["id"] for a in asks) == ["tool.text_to_speech", "tool.transcription"]
+    assert sorted(a["child_id"] for a in asks) == ["voice-config.stt", "voice-config.tts"]
+    assert GROQ_KEY not in json.dumps(asks) and ELEVEN_KEY not in json.dumps(asks)
+
+
+# 2. QQ bot adapter STT upload -----------------------------------------------------------------
+
+class _QQClient:
+    def __init__(self, wav_bytes):
+        self.wav_bytes = wav_bytes
+        self.posts = []
+
+    async def get(self, url, **kwargs):
+        import httpx
+        return httpx.Response(200, content=self.wav_bytes, request=httpx.Request("GET", url))
+
+    async def post(self, url, **kwargs):
+        import httpx
+        self.posts.append(url)
+        return httpx.Response(200, json={"text": "SECRETQQVOICE hello"}, request=httpx.Request("POST", url))
+
+
+@pytest.fixture
+def qq(monkeypatch, tmp_path):
+    from gateway.config import PlatformConfig
+    from gateway.platforms.qqbot import QQAdapter
+
+    monkeypatch.setattr("tools.url_safety.is_safe_url", lambda url: True)
+    adapter = QQAdapter(PlatformConfig(enabled=True, extra={
+        "app_id": "a", "client_secret": "b", "stt": {"apiKey": "qq-stt-key", "provider": "zai"}}))
+    with open(_wav(tmp_path / "v.wav"), "rb") as f:
+        adapter._http_client = _QQClient(f.read())
+    attachment = {"content_type": "voice", "url": "https://cdn.qq.com/v.silk", "filename": "v.silk",
+                  "voice_wav_url": "https://cdn.qq.com/v.wav"}
+    return adapter, attachment
+
+
+def test_qqbot_voice_refused_uploads_nothing_and_the_voice_line_carries_the_label(monkeypatch, qq):
+    adapter, attachment = qq
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    result = asyncio.run(adapter._process_attachments([attachment]))
+    assert adapter._http_client.posts == []
+    [line] = result["voice_transcripts"]
+    assert line.startswith(f"[Voice] [voice message not transcribed: {REFUSED_STT}")
+    assert UNREACHABLE in line
+
+
+def test_qqbot_voice_allowed_uploads_once(monkeypatch, qq):
+    adapter, attachment = qq
+    asks = _allow(monkeypatch)
+    result = asyncio.run(adapter._process_attachments([attachment]))
+    assert result["voice_transcripts"] == ["[Voice] SECRETQQVOICE hello"]
+    assert len(adapter._http_client.posts) == 1
+    assert [(a["id"], a["child_id"]) for a in asks] == [("tool.transcription", "qqbot.stt")]
+
+
+# 3. Streaming TTS -----------------------------------------------------------------------------
+
+@pytest.fixture
+def streamer(monkeypatch):
+    from tools import tts_streaming
+
+    calls = []
+    monkeypatch.setattr(tts_streaming.ElevenLabsStreamer, "stream", lambda self, text: calls.append(text) or iter(()))
+    monkeypatch.setenv("ELEVENLABS_API_KEY", ELEVEN_KEY)
+    return calls
+
+
+def _consumer():
+    from gateway.streaming_tts_consumer import StreamingTTSConsumer
+
+    loop = asyncio.new_event_loop()
+    try:
+        return StreamingTTSConsumer(adapter=object(), chat_id="c1", tts_config={"provider": "elevenlabs"}, loop=loop)
+    finally:
+        loop.close()
+
+
+def test_gateway_streaming_tts_refused_is_inactive_and_logs_the_label(monkeypatch, caplog, streamer):
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    with caplog.at_level(logging.WARNING):
+        consumer = _consumer()
+    # Inactive: the gateway uses the whole-file text_to_speech_tool path, which asks again and
+    # labels the chat; no streamer ever sends reply text.
+    assert consumer.active is False
+    assert streamer == []
+    assert any(REFUSED_TTS in r.getMessage() for r in caplog.records)
+
+
+def test_gateway_streaming_tts_allowed_is_active_after_one_ask(monkeypatch, streamer):
+    asks = _allow(monkeypatch)
+    consumer = _consumer()
+    assert consumer.active is True
+    assert [(a["id"], a["child_id"]) for a in asks] == [("tool.text_to_speech", "tts.streaming")]
+
+
+# 4. Teams pipeline ----------------------------------------------------------------------------
+
+def test_teams_pipeline_netie_refusal_is_final_not_retryable(monkeypatch, tmp_path):
+    from plugins.teams_pipeline import pipeline as tp
+
+    async def download(graph, ref, rec, path):
+        path.write_bytes(b"x")
+    monkeypatch.setattr(tp, "download_recording_artifact", download)
+
+    p = tp.TeamsMeetingPipeline.__new__(tp.TeamsMeetingPipeline)
+    p.config = type("C", (), {"tmp_dir": tmp_path, "stt_model": None, "ffmpeg_extract_audio": False})()
+    p.graph_client = None
+    p._persist_job = lambda job, **kw: job
+    label = f"{REFUSED_STT}: {UNREACHABLE}"
+    p.transcribe_fn = lambda path, model: {"success": False, "error": label, "error_type": "netie_gate_refused"}
+    rec = type("R", (), {"artifact_id": "a1", "display_name": "rec.wav"})()
+    with pytest.raises(tp.TeamsPipelineError) as exc:
+        asyncio.run(p._transcribe_recording(object(), object(), rec))
+    assert not isinstance(exc.value, tp.TeamsPipelineRetryableError)
+    assert str(exc.value) == label
+
+
+def test_teams_job_refused_by_the_real_transcriber_is_persisted_failed_with_the_label(monkeypatch, tmp_path):
+    """End to end: the real transcribe_audio under a dead OpenVault, through run_job's outer except,
+    into the job store (no fake transcribe_fn, no stubbed _persist_job)."""
+    import tools.transcription_tools as tt
+    from plugins.teams_pipeline import pipeline as tp
+    from plugins.teams_pipeline.models import MeetingArtifact, TeamsMeetingRef
+    from plugins.teams_pipeline.store import TeamsPipelineStore
+
+    async def _resolve(client, *, meeting_id=None, join_web_url=None, tenant_id=None, organizer_user_id=None):
+        return TeamsMeetingRef(meeting_id=str(meeting_id), organizer_user_id=organizer_user_id,
+                               tenant_id=tenant_id, metadata={})
+
+    async def _no_transcript(client, meeting_ref):
+        return None, None
+
+    async def _recordings(client, meeting_ref):
+        return [MeetingArtifact(artifact_type="recording", artifact_id="rec-1", display_name="rec.wav",
+                                download_url="https://files.example/rec.wav")]
+
+    async def _download(client, meeting_ref, recording, destination):
