+def _fal_backend(monkeypatch):
+    """The FAL backend the image.generate RPC needs, independent of the test venv: the real
+    fal_client SDK when installed, else a stand-in that resolves the real FAL queue host first, as
+    the SDK does, so an ungated call is recorded by netguard instead of returning early."""
+    from tools import image_generation_tool as igt
+
+    try:
+        igt._load_fal_client()
+        return
+    except ImportError:
+        pass
+
+    class _FalStandIn:
+        def __getattr__(self, name):
+            def call(*_a, **_k):
+                socket.getaddrinfo("queue.fal.run", 443)
+                raise RuntimeError(f"fal_client stand-in: {name}")
+            return call
+
+    monkeypatch.setattr(igt, "fal_client", _FalStandIn())
+
+
