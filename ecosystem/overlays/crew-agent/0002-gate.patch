+# 5. Round 3: scrub mark identity, prompt-id carry, branch surfaces, ids-only rebuild metric ----
+
+def _count_full_probes(monkeypatch):
+    from hermes_state_schema import SessionSchemaMixin
+
+    calls = []
+    original = SessionSchemaMixin._prompt_scrub_full_probe
+
+    def _counted(self, cursor):
+        calls.append(1)
+        return original(self, cursor)
+
+    monkeypatch.setattr(SessionSchemaMixin, "_prompt_scrub_full_probe", _counted)
+    return calls
+
+
+def test_body_written_into_a_freed_top_rowid_is_blanked_on_the_next_open(tmp_path):
+    """Prune or delete frees the newest rows; an older build's INSERT OR IGNORE then reuses the
+    freed rowid at or below the mark. The next open sees the marked row changed and probes all."""
+    import hashlib
+
+    from hermes_state import SessionDB
+
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    try:
+        for n in range(5):
+            db.create_session(f"sess-{n}", "cli", model="auto", system_prompt=f"prompt {n}")
+    finally:
+        db.close()
+    SessionDB(db_path=db_path).close()  # stamps the mark on the settled DB
+    conn = sqlite3.connect(db_path)
+    try:
+        for n in (3, 4):
+            conn.execute("DELETE FROM sessions WHERE id = ?", (f"sess-{n}",))
+            conn.execute("DELETE FROM system_prompts WHERE hash = ?",
+                         (hashlib.sha256(f"prompt {n}".encode()).hexdigest(),))
+        # The older build stores a new prompt with its body (lands in a freed rowid) and an inline one.
+        conn.execute("INSERT OR IGNORE INTO system_prompts (hash, prompt) VALUES (?, ?)",
+                     (hashlib.sha256(SOUL_MARKER.encode()).hexdigest(), SOUL_MARKER))
+        conn.execute("INSERT INTO sessions (id, source, started_at, system_prompt) VALUES ('sess-old', 'cli', 1, ?)",
+                     ("INLINE " + SOUL_MARKER,))
+        conn.commit()
+        reused = conn.execute("SELECT rowid FROM system_prompts WHERE prompt <> ''").fetchone()[0]
+    finally:
+        conn.close()
+    assert reused <= 5  # the body sits at or below the old mark
+    SessionDB(db_path=db_path).close()
+    dump = repr(_rows(db_path, "SELECT * FROM system_prompts")) + repr(_rows(db_path, "SELECT * FROM sessions"))
+    assert "SOUL-BODY-MARKER" not in dump
+
