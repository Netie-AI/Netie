+Asserts what the operator and the user actually receive:
+
+1. A fresh agent continuing an existing session (the API server builds one per request; CLI
+   --resume and gateway restarts do too) does not restart the session: plugins see
+   on_session_start once per session, and agent.log carries no "investigate the write path"
+   WARNING, although the stored prompt body is blank by design.
+2. A state.db written by an older build (full prompt bodies) is scrubbed on open, and a body
+   another process writes later is blanked when the same prompt is stored again. Tool-name
+   pins are ids and survive.
+3. A real turn through the upstream agent loop leaves no user text in sessions.title (the
+   instant title, the model title and the subagent title are off by default) and no prompt
+   body in system_prompts. An explicit opt-in still titles the session.
+
+Rows are read with sqlite3, not through SessionDB.
+"""
+
+import logging
+import os
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, write_hermes_home
+import json
+
+pytestmark = pytest.mark.netie_real_gate
+
+USER_MARKER = "USERTEXTMARKER my confidential merger plan"
+GOAL_MARKER = "GOALTEXTMARKER audit the payroll export"
+SOUL_MARKER = "SOUL-BODY-MARKER you are Crew. SKILL-BODY-MARKER step 1: run the deploy."
+PIN = '["read_file", "terminal"]'
+
+_HOOK_PLUGIN = '''
+import os
+from pathlib import Path
+
+def _seen(session_id=None, **_kwargs):
+    with open(Path(os.environ["HERMES_HOME"]) / "session_start.log", "a") as fh:
+        fh.write(f"{session_id}\\n")
+
+def register(ctx):
+    ctx.register_hook("on_session_start", _seen)
+'''
+
+# No update check, no models.dev fetch, no background review agent racing the scripted turns.
+_QUIET = ("updates:\n  check: false\nmodels_dev:\n  url: http://127.0.0.1:9/api.json\n"
+          "skills:\n  creation_nudge_interval: 0\nmemory:\n  nudge_interval: 0\n")
+
+
+def _home() -> Path:
+    return Path(os.environ["HERMES_HOME"])
+
+
+def _install_hook_plugin(home: Path) -> str:
+    plugin_dir = home / "plugins" / "netie-session-probe"
+    plugin_dir.mkdir(parents=True, exist_ok=True)
+    (plugin_dir / "plugin.yaml").write_text("name: netie-session-probe\nversion: 0.0.1\n")
+    (plugin_dir / "__init__.py").write_text(_HOOK_PLUGIN)
+    return "plugins:\n  enabled: [netie-session-probe]\n"
+
+
+def _agent(srv, db, session_id, platform="cli"):
+    from run_agent import AIAgent
+
+    return AIAgent(provider="custom", base_url=srv.base_url, api_key="sk-fake-e2e", model="fake-model",
+                   session_db=db, session_id=session_id, quiet_mode=True, platform=platform,
+                   enabled_toolsets=[])
+
+
+def _rows(db_path: Path, sql: str, args=()):
+    conn = sqlite3.connect(db_path)
+    conn.row_factory = sqlite3.Row
+    try:
+        return [dict(r) for r in conn.execute(sql, args)]
+    finally:
+        conn.close()
+
+
+def _join_title_threads():
+    import threading
+
+    for thread in threading.enumerate():
+        if thread.name == "auto-title":
+            thread.join(timeout=30)
+
