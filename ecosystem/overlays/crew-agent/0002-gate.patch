+def drive_cli_input(stub, home, monkeypatch, tmp_path):
+    """Type a prompt into the interactive CLI input box and press Enter, then run that turn."""
+    from prompt_toolkit.application import Application
+    from prompt_toolkit.input import create_pipe_input
