+"""Crew Agent stage 2 gate, round 8 (Netie, area: final).
+
+1. Multiplex unserve race keyed on "this profile was unserved", not on "not yet in the served
+   set": a hot-added profile whose first reconnect is refused keeps retrying and connects once
+   OpenVault allows; an unserved profile's late reconnect reinstalls no adapter (gate allow) and
+   no reconnect is scheduled for it.
+2. Streaming TTS: the gateway builds its consumer (whose provider resolution makes a synchronous
+   crew gate ask) off the event loop, and the CLI streaming reply asks once, not twice.
+3. GPT-Live: POST /api/audio/voice-live/session asks the crew gate (tool 'voice_live') before any
+   credential is read or the vendor called; a refusal is an HTTP error carrying the label.
+4. SessionDB: a legacy inline prompt body freed by update_system_prompt, and a legacy
+   system_prompts body deleted as unreferenced, leave no bytes in state.db after a checkpoint.
+"""
+
+import asyncio
+import contextlib
+import contextvars
+import hashlib
+import sqlite3
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from tests.netie.test_crew_agent_gate_gateways import DEAD_OPENVAULT
+
+pytestmark = pytest.mark.netie_real_gate
+
+REFUSED_TTS = "Crew Agent refused tool 'text_to_speech'"
+REFUSED_LIVE = "Crew Agent refused tool 'voice_live'"
+ELEVEN_KEY = "el-netier8secretkey"
+OPENAI_KEY = "sk-netier8secretkey"
+
+
+def _allow(monkeypatch, delay=0.0):
+    from agent import netie_gate
+
+    asks = []
+
+    def _post(url, payload):
+        asks.append({**payload, "_thread": threading.current_thread()})
+        if delay:
+            time.sleep(delay)
+        return {"allowed": True}
+
+    monkeypatch.setattr(netie_gate, "_post", _post)
+    return asks
+
+
+# 1. Multiplex unserve race ---------------------------------------------------------------------
+
+from tests.netie.test_crew_agent_gate_r5_claims import _multiplex_start_runner, _persisted  # noqa: E402
+from tests.netie.test_crew_agent_gate_r6_leftovers import _wait_secondary_bridges  # noqa: E402
+
+
+def _per_profile_configs(monkeypatch, homes):
+    """Give each profile its own bot token: the scope binds the profile home, and the gateway
+    config load answers for the bound home (the r5 helper shares one token between profiles)."""
+    import gateway.run as gateway_run
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+
+    bound = contextvars.ContextVar("r8_profile_home", default=None)
+
+    @contextlib.contextmanager
+    def _scope(profile_home, *args, **kwargs):
+        token = bound.set(Path(profile_home))
+        try:
+            yield
+        finally:
+            bound.reset(token)
+
+    configs = {
+        Path(home): GatewayConfig(multiplex_profiles=True, platforms={
+            Platform.TELEGRAM: PlatformConfig(enabled=True, token=f"{index}:tok-{name}")})
+        for index, (name, home) in enumerate(homes, start=100)}
+    monkeypatch.setattr(gateway_run, "_profile_runtime_scope", _scope)
+    monkeypatch.setattr("gateway.config.load_gateway_config", lambda: configs[bound.get()])
+    return configs
+
+
+@pytest.mark.asyncio
+async def test_hot_added_profile_refused_then_allowed_connects(monkeypatch, tmp_path):
+    import gateway.run as gateway_run
+    from gateway.config import Platform
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, _created, connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    try:
+        assert await runner.start() is True
+        await _wait_secondary_bridges(runner)
+        for name in ("q", "r"):
+            (tmp_path / "profiles" / name).mkdir(parents=True)
+        homes = [("default", tmp_path), ("p", tmp_path / "profiles" / "p"),
+                 ("q", tmp_path / "profiles" / "q"), ("r", tmp_path / "profiles" / "r")]
+        configs = _per_profile_configs(monkeypatch, homes)
+        monkeypatch.setattr(gateway_run, "_multiplex_profile_homes", lambda config: list(homes))
+        monkeypatch.setattr("hermes_cli.profiles.get_profile_dir", lambda name: dict(homes)[name])
+
+        async def _load(profile_name, profile_home):
+            if profile_name == "r":
+                await asyncio.sleep(0.5)  # a slow second profile: q's refusal lands before the record
+            return configs[Path(profile_home)]
+
+        runner._load_secondary_profile_config = _load
+        await runner._apply_profile_changes(dict(homes), ["q", "r"], [], [], reason="test")
+        assert {"q", "r"} <= set(runner._served_profile_homes)
+        await asyncio.sleep(0.3)
+        task = (runner._profile_failed_platforms.get("q") or {}).get(Platform.TELEGRAM)
+        assert isinstance(task, asyncio.Task) and not task.done(), (
+            "hot-added q's refused telegram reconnect stopped retrying", runner._profile_failed_platforms)
+
+        # OpenVault now allows: q's queued reconnect connects and installs its adapter.
+        _allow(monkeypatch)
+
+        async def _connect_ok(adapter, platform, *, is_reconnect=False):
+            connects.append(adapter)
+            return True
+
+        runner._connect_adapter_with_timeout = _connect_ok
+        await asyncio.wait_for(task, timeout=10)
+        assert Platform.TELEGRAM in runner._profile_adapters.get("q", {}), runner._profile_adapters
+        assert runner._profile_adapters["q"][Platform.TELEGRAM].token == "102:tok-q"
+    finally:
+        await runner.stop()
+
+
+@pytest.mark.asyncio
+async def test_unserved_profile_late_allow_reinstalls_no_adapter(monkeypatch, tmp_path):
+    from gateway.config import Platform
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("NETIE_OPENVAULT_URL", DEAD_OPENVAULT)
+    runner, _cfg, _created, connects = _multiplex_start_runner(monkeypatch, tmp_path, primary_token=None)
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    async def _stubborn_gate(platform):
+        """A gate call that outlives the reconnect's cancellation, then ALLOWS."""
+        entered.set()
+        while not release.is_set():
+            try:
+                await release.wait()
+            except asyncio.CancelledError:
+                continue
+        return None
+
+    async def _connect_ok(adapter, platform, *, is_reconnect=False):
+        connects.append(adapter)
+        return True
+
+    try:
+        assert await runner.start() is True
+        await _wait_secondary_bridges(runner)
+        task = runner._profile_failed_platforms["p"][Platform.TELEGRAM]
+        runner._netie_leave_refusal = _stubborn_gate
+        runner._connect_adapter_with_timeout = _connect_ok
+        await asyncio.wait_for(entered.wait(), timeout=5)
+        runner._adapter_disconnect_timeout_secs = lambda: 0.05
+        await runner._unserve_profile("p", tmp_path / "profiles" / "p")
+        assert not task.done()  # the cancelled reconnect outlived the unserve wait
+        release.set()
+        await asyncio.wait({task}, timeout=2)
+        assert task.done()
+        assert "p" not in runner._profile_adapters, runner._profile_adapters  # no poller came back
+        assert connects == []  # no adapter was even connected for the removed profile
+        assert "p:telegram" not in _persisted(tmp_path)["platforms"]
+
+        # A reconnect scheduled after the unserve (a late fatal error) is not queued either.
+        runner._schedule_secondary_profile_reconnect("p", Platform.TELEGRAM, None)
+        assert "p" not in (runner._profile_failed_platforms or {}), runner._profile_failed_platforms
+    finally:
+        release.set()
+        await runner.stop()
+
+
+# 2. Streaming TTS off the loop, one ask per CLI reply ------------------------------------------
+
+@pytest.fixture
+def streamer(monkeypatch):
+    from tools import tts_streaming
+
+    calls = []
+    monkeypatch.setattr(tts_streaming.ElevenLabsStreamer, "stream", lambda self, text: calls.append(text) or iter(()))
+    monkeypatch.setenv("ELEVENLABS_API_KEY", ELEVEN_KEY)
+    import tools.tts_tool as tts
+
+    monkeypatch.setattr(tts, "_load_tts_config", lambda: {"provider": "elevenlabs"})
+    return calls
