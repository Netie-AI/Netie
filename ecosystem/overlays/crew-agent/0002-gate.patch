+def _join_new_threads(before, timeout=15.0):
+    import threading
+    import time
+
+    deadline = time.monotonic() + timeout
+    for thread in [t for t in threading.enumerate() if t not in before]:
+        thread.join(max(0.0, deadline - time.monotonic()))
