+def _multiplex_runner(statuses, created):
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.run import GatewayRunner
+
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner.config = GatewayConfig(multiplex_profiles=True)
+    runner._running = True
+    runner._profile_adapters = {}
+    runner._profile_failed_platforms = {}
+    runner._background_tasks = set()
+    runner._multiplex_on = lambda: True
+    profile_cfg = GatewayConfig(multiplex_profiles=True,
+                                platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="123:abc")})
+
+    async def _load(profile_name, profile_home):
+        return profile_cfg
+
+    runner._load_secondary_profile_config = _load
+    runner._update_platform_runtime_status = lambda platform, **kw: statuses.append((platform, kw))
+    runner._instantiate_adapter = lambda platform, config: created.append(platform) or _StubAdapter(platform)
+    runner._configure_profile_adapter = lambda adapter, profile_name, platform: None
+    runner._sync_voice_mode_state_to_adapter = lambda adapter: None
+
+    async def _redeliver(*a, **k):
+        return 0
+
+    runner._redeliver_failed_obligations_for_platform = _redeliver
+    runner._schedule_planned_restart_replay = lambda: None
+    runner._schedule_resume_pending_sessions = lambda platform=None: None
+    return runner, profile_cfg
+
