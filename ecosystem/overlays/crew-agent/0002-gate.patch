+# 2. Session import of a dangling prompt hash --------------------------------------------------
+
+def _export_import(tmp_path, *, drop_source_prompt):
+    from hermes_state import SessionDB
+    from tests.netie.test_crew_agent_gate_session import _rows
+
+    tmp_path.mkdir()
+    src_path, dst_path = tmp_path / "src.db", tmp_path / "dst.db"
+    src, dst = SessionDB(db_path=src_path), SessionDB(db_path=dst_path)
+    try:
+        src.create_session("x", "cli", system_prompt="EXPORTED PROMPT")
+        source_hash = _rows(src_path, "SELECT system_prompt_hash FROM sessions WHERE id = 'x'")[0][
+            "system_prompt_hash"]
+        if drop_source_prompt:
+            conn = sqlite3.connect(src_path)
+            conn.execute("DELETE FROM system_prompts WHERE hash = ?", (source_hash,))
+            conn.commit()
+            conn.close()
+        exported = src.export_session("x")
+        assert exported["system_prompt_hash"] == source_hash
+        assert (exported["system_prompt"] is None) is drop_source_prompt
+        result = dst.import_sessions([exported])
+        assert result.get("imported") in (1, ["x"]) or "x" in json.dumps(result), result
+    finally:
+        src.close()
+        dst.close()
+    return (source_hash,
+            _rows(dst_path, "SELECT system_prompt_hash FROM sessions WHERE id = 'x'")[0]["system_prompt_hash"],
+            _rows(dst_path, "SELECT hash, prompt FROM system_prompts"))
+
+
+def test_import_of_a_session_whose_prompt_row_is_missing_lands_null(tmp_path):
+    _source_hash, imported_hash, prompts = _export_import(tmp_path / "dangling", drop_source_prompt=True)
+    assert imported_hash is None
+    assert prompts == []
+
+    source_hash, imported_hash, prompts = _export_import(tmp_path / "ids-only", drop_source_prompt=False)
+    assert imported_hash == source_hash
+    assert prompts == [{"hash": source_hash, "prompt": ""}]
