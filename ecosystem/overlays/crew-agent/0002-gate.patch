+async def _api_server():
+    from aiohttp import web
+    from aiohttp.test_utils import TestClient, TestServer
+
+    from gateway.config import PlatformConfig
+    from gateway.platforms.api_server import APIServerAdapter
+
+    auth = {"Authorization": f"Bearer {os.environ['API_SERVER_KEY']}"}
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+    app = web.Application()
+    for method, path, handler in adapter._http_route_table():
+        app.router.add_route(method, path, handler)
+    app["api_server_adapter"] = adapter
+    try:
+        async with TestClient(TestServer(app)) as client:
+            chat = await client.post("/v1/chat/completions", headers=auth, json={
+                "model": "hermes-agent", "messages": [{"role": "user", "content": f"{_m('USER', 'apic')} TOOLTURN"}]})
+            assert chat.status == 200, await chat.text()
+            first = await client.post("/v1/responses", headers=auth, json={"input": f"{_m('USER', 'apir')} plain"})
+            assert first.status == 200, await first.text()
+            chained = await client.post("/v1/responses", headers=auth, json={
+                "input": f"{_m('USER', 'apin')} plain", "previous_response_id": (await first.json())["id"]})
+            assert chained.status == 200, await chained.text()
+            run = await client.post("/v1/runs", headers={**auth, "Idempotency-Key": "r6sweep-run-1"},
+                                    json={"input": f"{_m('USER', 'apiu')} plain"})
+            assert run.status in (200, 202), await run.text()
+            run_id = (await run.json())["run_id"]
+            status = {}
+            for _ in range(600):
+                status = await (await client.get(f"/v1/runs/{run_id}", headers=auth)).json()
+                if status.get("status") in ("completed", "failed", "cancelled"):
+                    break
+                await asyncio.sleep(0.05)
+            assert status.get("status") == "completed", status
+    finally:
