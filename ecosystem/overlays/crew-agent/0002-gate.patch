+class _Tui:
+    """The TUI gateway's JSON-RPC handlers in process; events are captured from write_json."""
+
+    def __init__(self, monkeypatch):
+        from tui_gateway import server
+
+        self.server = server
+        self.events = []
+        self._lock = threading.Lock()
+        self._rid = 1000
+
+        def write_json(obj):
+            with self._lock:
+                self.events.append(obj)
+            return True
+
+        monkeypatch.setattr(server, "write_json", write_json)
+
+    def call(self, method, params):
+        self._rid += 1
+        return self.server.handle_request({"jsonrpc": "2.0", "id": self._rid, "method": method,
+                                           "params": params}) or {}
+
+    def wait_event(self, etype, start, timeout=60.0):
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            with self._lock:
+                for event in self.events[start:]:
+                    if (event.get("params") or {}).get("type") == etype:
+                        return event
+            time.sleep(0.05)
+        raise AssertionError(f"TUI gateway sent no {etype} event")
+
+    def turn(self, sid, text):
+        start = len(self.events)
+        reply = self.call("prompt.submit", {"session_id": sid, "text": text})
+        assert "error" not in reply, reply
+        done = self.wait_event("message.complete", start)
+        self.wait_idle(sid)
+        return done
+
+    def wait_idle(self, sid, timeout=30.0):
+        """message.complete can land before the session is marked idle; a prompt or compress sent
+        in that window is queued or refused, so the next step waits for the turn to settle."""
+        deadline = time.monotonic() + timeout
+        while (self.server._sessions.get(sid) or {}).get("running"):
+            if time.monotonic() > deadline:
+                raise AssertionError(f"TUI session {sid} still running after its turn")
+            time.sleep(0.05)
+
+    def subagent_records(self):
+        """What ui-tui persists on turn end: one record per subagent built from its events."""
+        records = {}
+        with self._lock:
+            events = list(self.events)
+        for event in events:
+            params = event.get("params") or {}
+            if str(params.get("type", "")).startswith("subagent."):
+                payload = params.get("payload") or {}
+                key = str(payload.get("subagent_id") or payload.get("task_index") or "0")
+                records.setdefault(key, {"id": key}).update(
+                    {k: v for k, v in payload.items() if isinstance(v, (str, int, float))})
+        return list(records.values())
+
+
+TUI_PAD_TURNS = 8
+
+
+def drive_tui(stub, home, monkeypatch, tmp_path):
+    before = set(threading.enumerate())
+    tui = _Tui(monkeypatch)
+    sid = tui.call("session.create", {})["result"]["session_id"]
+    try:
+        tui.turn(sid, f"{_m('USER', 'tui')} TOOLTURN")
+        tui.turn(sid, f"{_m('USER', 'tuid')} DELEGTURN")
+        subagents = tui.subagent_records()
+        if subagents:
+            saved = tui.call("spawn_tree.save", {"session_id": sid, "subagents": subagents,
+                                                 "label": str(subagents[0].get("goal") or "")[:120],
+                                                 "finished_at": time.time()})
+            assert "result" in saved, saved
+        # Pad the session (each turn with its own USER marker) until the compressor really replaces
+        # messages: with only the two turns above it refuses because the summary would grow.
+        padded = [f"tuip{i}" for i in range(TUI_PAD_TURNS)]
+        for scen in padded:
+            tui.turn(sid, f"{_m('USER', scen)} PADTURN")
+        compressed = tui.call("session.compress", {"session_id": sid})
+        result = compressed.get("result") or {}
+        summary = result.get("summary") or {}
+        assert summary.get("refused_would_grow") is False, compressed
+        assert summary.get("aborted") is False, compressed
+        assert int((result.get("usage") or {}).get("compressions") or 0) >= 1, compressed
+        assert result.get("after_messages", 0) < result.get("before_messages", 0), compressed
+        tui.turn(sid, f"{_m('USER', 'tuic')} after compress")
+    finally:
+        tui.call("session.close", {"session_id": sid})
+        _join_new_threads(before, timeout=5.0)
+    return ["tui", "tuid", *padded, "tuic"]
+
