diff --git a/open-sse/config/netieSubscriptionGate.ts b/open-sse/config/netieSubscriptionGate.ts
new file mode 100644
index 00000000..fc529179
--- /dev/null
+++ b/open-sse/config/netieSubscriptionGate.ts
@@ -0,0 +1,87 @@
+/**
+ * Netie FreeRoute gate (Netie DR-0002 rule 6).
+ *
+ * Two classes of provider do not register unless an operator sets an explicit
+ * environment flag to "1":
+ *
+ *   1. Providers that reuse an end user's Claude Code, OpenAI Codex, GitHub
+ *      Copilot, Cursor or Antigravity subscription login (NETIE_GATED_PROVIDER_IDS).
+ *   2. Every adapter that drives another vendor's web UI with a pasted browser
+ *      session to get past its meter (the whole web-cookie catalog section).
+ *
+ * The flag name is deliberately read through a constant so the env-doc sync
+ * check does not demand it in .env.example: it is not an advertised setting.
+ * With the flag absent the gated ids are also fed into the runtime retirement
+ * set (src/shared/constants/providerRetirement.ts), so a connection row that
+ * predates the gate is refused at credential selection with 410 instead of
+ * being served.
+ */
+
+export const NETIE_SUBSCRIPTION_LOGIN_FLAG = "NETIE_ALLOW_SUBSCRIPTION_LOGIN";
+
+/** id -> alias. Aliases are listed so retirement also catches alias-addressed requests. */
+export const NETIE_GATED_PROVIDERS: Readonly<Record<string, string | null>> = Object.freeze({
+  // Claude Code OAuth (src/shared/constants/providers/oauth.ts, src/lib/oauth/providers/claude.ts)
+  claude: "cc",
+  // OpenAI Codex OAuth (oauth.ts, src/lib/oauth/providers/codex.ts)
+  codex: "cx",
+  // Drives the local Codex CLI app-server and its ChatGPT sign-in (providers/noauth.ts)
+  "codex-app-server": "cxa",
+  // GitHub Copilot OAuth (oauth.ts, src/lib/oauth/providers/github.ts)
+  github: "gh",
+  // GitHub Enterprise Copilot OAuth (oauth.ts, src/lib/oauth/providers/ghe-copilot.ts)
+  "ghe-copilot": null,
+  // Cursor IDE OAuth (oauth.ts, src/lib/oauth/providers/cursor.ts)
+  cursor: "cu",
+  // Cursor user API key exchanged for an IDE session token, billed to the Cursor plan
+  // (providers/apikey/specialty-media.ts)
+  "cursor-api": "cua",
+  // Antigravity OAuth (oauth.ts, src/lib/oauth/providers/antigravity.ts)
+  antigravity: null,
+  // Antigravity CLI login import (oauth.ts, src/lib/oauth/providers/agy.ts)
+  agy: null,
+});
+
+export const NETIE_GATED_PROVIDER_IDS: readonly string[] = Object.freeze(
+  Object.keys(NETIE_GATED_PROVIDERS)
+);
+
+function readEnv(env?: Record<string, string | undefined>): Record<string, string | undefined> {
+  if (env) return env;
+  return typeof process !== "undefined" && process.env ? process.env : {};
+}
+
+export function isSubscriptionLoginAllowed(env?: Record<string, string | undefined>): boolean {
+  return readEnv(env)[NETIE_SUBSCRIPTION_LOGIN_FLAG] === "1";
+}
+
+/** Ids plus aliases that the runtime must refuse while the flag is absent. */
+export function netieGatedRuntimeIds(env?: Record<string, string | undefined>): string[] {
+  if (isSubscriptionLoginAllowed(env)) return [];
+  const out: string[] = [];
+  for (const [id, alias] of Object.entries(NETIE_GATED_PROVIDERS)) {
+    out.push(id);
+    if (alias) out.push(alias);
+  }
+  return out;
+}
+
+/**
+ * Return `section` without the gated keys (and without every key in `alsoDrop`)
+ * unless the flag is set. The type is preserved on purpose: callers keep their
+ * literal key types, and a gated lookup yields undefined at runtime, which is
+ * the behaviour every consumer already handles for an unknown provider id.
+ */
+export function netieGateProviders<T extends Record<string, unknown>>(
+  section: T,
+  alsoDrop: Iterable<string> = [],
+  env?: Record<string, string | undefined>
+): T {
+  if (isSubscriptionLoginAllowed(env)) return section;
+  const drop = new Set<string>([...NETIE_GATED_PROVIDER_IDS, ...alsoDrop]);
+  const out: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(section)) {
+    if (!drop.has(key)) out[key] = value;
+  }
+  return out as T;
+}
