diff --git a/tests/unit/netie-subscription-login-gate.test.ts b/tests/unit/netie-subscription-login-gate.test.ts
new file mode 100644
index 00000000..f1593a28
--- /dev/null
+++ b/tests/unit/netie-subscription-login-gate.test.ts
@@ -0,0 +1,178 @@
+// Netie FreeRoute gate (Netie DR-0002 rule 6).
+//
+// Providers that reuse an end user's Claude Code, Codex, GitHub Copilot, Cursor or
+// Antigravity subscription login, and every adapter that drives another vendor's web
+// UI with a pasted session, must be absent from every provider and model listing by
+// default, and present only when the explicit flag is set to "1".
+//
+// The listing is read from a child process so each half sees a fresh module graph
+// (the gate is evaluated at module load). The parent process then proves the two
+// artifacts an operator actually receives: the /v1/models response and credential
+// selection for a stored connection.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const FLAG = "NETIE_ALLOW_SUBSCRIPTION_LOGIN";
+const PROBE = "NETIE_GATE_PROBE";
+
+const GATED_IDS = [
+  "claude",
+  "codex",
+  "codex-app-server",
+  "github",
+  "ghe-copilot",
+  "cursor",
+  "cursor-api",
+  "antigravity",
+  "agy",
+];
+const GATED_ALIASES = ["cc", "cx", "cxa", "gh", "cu", "cua"];
+// A sample of the web-session class: one per named vendor plus the two token-based ones.
+const GATED_WEB_IDS = [
+  "claude-web",
+  "chatgpt-web-codex",
+  "chatgpt-web",
+  "copilot-web",
+  "copilot-m365-web",
+  "grok-web",
+  "gemini-web",
+  "maxai",
+  "uc",
+];
+const ALL_GATED = [...GATED_IDS, ...GATED_ALIASES, ...GATED_WEB_IDS];
+const GATED_MODEL_PREFIX = new RegExp(`^(${ALL_GATED.join("|")})/`);
+
+type Listing = {
+  providers: string[];
+  models: string[];
+  registry: string[];
+  oauthFlows: string[];
+  retired: string[];
+};
+
+if (process.env[PROBE] === "1") {
+  const providers = await import("../../src/shared/constants/providers.ts");
+  const models = await import("../../src/shared/constants/models.ts");
+  const registry = await import("@omniroute/open-sse/config/providerRegistry.ts");
+  const oauth = await import("../../src/lib/oauth/providers/index.ts");
+  const retirement = await import("../../src/shared/constants/providerRetirement.ts");
+  const listing: Listing = {
+    providers: Object.keys(providers.AI_PROVIDERS),
+    models: Object.keys(models.PROVIDER_MODELS),
+    registry: Object.keys(registry.REGISTRY),
+    oauthFlows: Object.keys(oauth.PROVIDERS),
+    retired: [...retirement.RUNTIME_RETIRED_PROVIDER_IDS],
+  };
+  process.stdout.write(`\n__NETIE_LISTING__${JSON.stringify(listing)}\n`);
+  process.exit(0);
+}
+
+function readListing(flagValue: string | undefined): Listing {
+  const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "netie-gate-probe-"));
+  const env: NodeJS.ProcessEnv = { ...process.env, [PROBE]: "1", DATA_DIR: dataDir };
+  delete env[FLAG];
+  if (flagValue !== undefined) env[FLAG] = flagValue;
+  const result = spawnSync(
+    process.execPath,
+    ["--import", "tsx/esm", fileURLToPath(import.meta.url)],
+    { env, encoding: "utf8", timeout: 180_000 }
+  );
+  fs.rmSync(dataDir, { recursive: true, force: true });
+  const line = result.stdout.split("\n").find((l) => l.startsWith("__NETIE_LISTING__"));
+  assert.ok(line, `probe produced no listing (status ${result.status})\n${result.stderr}`);
+  return JSON.parse(line.slice("__NETIE_LISTING__".length));
+}
+
+function present(keys: string[], wanted: string[]): string[] {
+  const set = new Set(keys);
+  return wanted.filter((k) => set.has(k));
+}
+
+test("by default no provider, model, executor or OAuth listing names a gated provider", () => {
+  const l = readListing(undefined);
+  assert.deepEqual(present(l.providers, ALL_GATED), [], "AI_PROVIDERS");
+  assert.deepEqual(present(l.models, ALL_GATED), [], "PROVIDER_MODELS");
+  assert.deepEqual(present(l.registry, ALL_GATED), [], "REGISTRY");
+  assert.deepEqual(present(l.oauthFlows, ALL_GATED), [], "OAuth flows");
+  // The runtime refuses the ids and aliases even for a connection row that predates the gate.
+  assert.deepEqual(present(l.retired, [...GATED_IDS, ...GATED_ALIASES]), [...GATED_IDS, ...GATED_ALIASES]);
+  // The gate must not take anything else with it.
+  assert.ok(l.providers.includes("openai"), "openai stays");
+  assert.ok(l.registry.includes("anthropic"), "anthropic API-key provider stays");
+  assert.ok(l.oauthFlows.includes("qoder"), "unrelated OAuth flows stay");
+});
+
+test("the flag is an opt-in: only the literal value 1 registers the gated providers", () => {
+  const off = readListing("true");
+  assert.deepEqual(present(off.providers, ALL_GATED), [], "a non-1 value keeps the gate closed");
+
+  const on = readListing("1");
+  assert.deepEqual(present(on.providers, GATED_IDS), GATED_IDS, "AI_PROVIDERS with flag");
+  assert.deepEqual(present(on.providers, GATED_WEB_IDS), GATED_WEB_IDS, "web adapters with flag");
+  assert.deepEqual(present(on.registry, GATED_IDS), GATED_IDS, "REGISTRY with flag");
+  assert.deepEqual(present(on.registry, GATED_WEB_IDS), GATED_WEB_IDS, "web executors with flag");
+  assert.ok(
+    present(on.models, GATED_ALIASES).length > 0,
+    "PROVIDER_MODELS is alias-keyed and must carry the gated aliases with the flag"
+  );
+  assert.deepEqual(
+    present(on.oauthFlows, ["claude", "codex", "github", "ghe-copilot", "cursor", "antigravity", "agy"]),
+    ["claude", "codex", "github", "ghe-copilot", "cursor", "antigravity", "agy"]
+  );
+  assert.deepEqual(present(on.retired, GATED_IDS), [], "retirement set releases them with the flag");
+});
+
+// Parent process: default environment (the test runner never sets the flag). The
+// heavy imports stay inside the test bodies so every test registers before any await:
+// under --test-force-exit a test registered after a top-level await is never run.
+process.env.API_KEY_SECRET ||= "netie-gate-test-secret";
+process.env.CATALOG_BUILD_TIMEOUT_MS ||= "120000";
+
+test("GET /v1/models never advertises a gated provider, even with a stored connection", async () => {
+  assert.notEqual(process.env[FLAG], "1");
+  const providersDb = await import("../../src/lib/db/providers.ts");
+  const v1ModelsCatalog = await import("../../src/app/api/v1/models/catalog.ts");
+  await providersDb.createProviderConnection({
+    provider: "openai",
+    authType: "apikey",
+    name: "openai-netie-gate",
+    apiKey: "sk-test",
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  });
+  // A row that predates the gate (or was inserted by hand).
+  await providersDb.createProviderConnection({
+    provider: "github",
+    authType: "oauth",
+    name: "github-netie-gate",
+    apiKey: null,
+    accessToken: "gh-token",
+    isActive: true,
+    testStatus: "active",
+    providerSpecificData: {},
+  });
+
+  const response = await v1ModelsCatalog.getUnifiedModelsResponse(
+    new Request("http://localhost/api/v1/models")
+  );
+  const body = (await response.json()) as { data: Array<{ id: string }> };
