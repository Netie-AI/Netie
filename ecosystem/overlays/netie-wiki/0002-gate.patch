diff --git a/src/netie/connector-gate.ts b/src/netie/connector-gate.ts
new file mode 100644
index 0000000..5c541e0
--- /dev/null
+++ b/src/netie/connector-gate.ts
@@ -0,0 +1,101 @@
+/**
+ * Leave-machine gate for source connectors (Netie `TAS/TAS-SPACE.md`,
+ * `scripts/space_leave.py`): a connector that would read a personal or remote
+ * source runs only after OpenVault answers `allowed: true`. With no OpenVault,
+ * or any refusal, the connector is off and says so in its result.
+ */
+import { openWikiConnectorsDisplayPath } from "../config/openwiki-home.js";
+import { createRunId } from "../connectors/io.js";
+import {
+  askLeaveMachine,
+  connectorLeaveAsk,
+  LEAVE_MACHINE_LABEL,
+  type LeaveMachineDecision,
+} from "./openvault.js";
+import type {
+  ConnectorIngestOptions,
+  ConnectorIngestResult,
+  ConnectorRuntime,
+} from "../connectors/types.js";
+
+/**
+ * Whether a connector stays on the machine. Only the local git reader does;
+ * every other backend fetches from a remote API or an MCP server.
+ *
+ * @param connector - Connector definition.
+ * @returns True when the connector needs no leave-machine grant.
+ */
+export function connectorStaysLocal(
+  connector: Pick<ConnectorRuntime, "backend">,
+): boolean {
+  return connector.backend === "local-git";
+}
+
+/**
+ * Formats the visible refusal for one connector.
+ *
+ * @param displayName - Connector display name.
+ * @param decision - OpenVault decision.
+ * @returns One line naming the label, the URL asked and the reason.
+ */
+export function formatLeaveMachineRefusal(
+  displayName: string,
+  decision: LeaveMachineDecision,
+): string {
+  return `${displayName} is ${LEAVE_MACHINE_LABEL}. Asked ${decision.url}: ${decision.reason}.`;
+}
+
+/**
+ * Throws unless OpenVault allows this connector to leave the machine.
+ *
+ * @param connectorId - Connector id.
+ * @param displayName - Connector display name for the message.
+ */
+export async function assertLeaveMachine(
+  connectorId: string,
+  displayName: string,
+): Promise<void> {
+  const decision = await askLeaveMachine(connectorLeaveAsk(connectorId));
+  if (!decision.allowed) {
+    throw new Error(formatLeaveMachineRefusal(displayName, decision));
+  }
+}
+
+/**
+ * Wraps one connector so its pull asks OpenVault first. Local connectors are
+ * returned unchanged. A refused pull returns `skipped` with the label in its
+ * message and warnings; it never falls back to a direct call.
+ *
+ * @param connector - Upstream connector runtime.
+ * @returns Gated runtime with a labeled description.
+ */
+export function gateConnector(connector: ConnectorRuntime): ConnectorRuntime {
+  if (connectorStaysLocal(connector)) {
+    return connector;
+  }
+  return {
+    ...connector,
+    description: `${connector.description} Netie: ${LEAVE_MACHINE_LABEL}.`,
+    ingest: async (
+      options?: ConnectorIngestOptions,
+    ): Promise<ConnectorIngestResult> => {
+      const decision = await askLeaveMachine(connectorLeaveAsk(connector.id));
+      if (!decision.allowed) {
+        const message = formatLeaveMachineRefusal(
+          connector.displayName,
+          decision,
+        );
+        return {
+          connectorId: connector.id,
+          message,
+          rawFiles: [],
+          runId: createRunId(),
+          statePath: `${openWikiConnectorsDisplayPath}/${connector.id}/state.json`,
+          status: "skipped",
+          warnings: [message],
+        };
+      }
+      return connector.ingest(options);
+    },
+  };
+}
diff --git a/src/netie/kb.ts b/src/netie/kb.ts
new file mode 100644
index 0000000..944f829
--- /dev/null
+++ b/src/netie/kb.ts
@@ -0,0 +1,239 @@
+/**
+ * Netie-KB index for grounded Claims. Ids and titles only, never a skill body.
+ *
+ * Port of the Netie repo's `scripts/kb_lookup.py` (R-0016): a KB row is shown
+ * as a brief `{id, kind, title, status, source}`. A row of kind `skill` never
+ * carries a body across this boundary, and a row whose id, title or source
+ * names a body key is refused outright. The index file is JSON: either an
+ * array of rows or an object with a `rows` array. Its path comes from
+ * `NETIE_KB_INDEX`; when unset there is no index and no Claim can be grounded.
+ */
+import { readFile } from "node:fs/promises";
+
+/**
+ * Environment variable naming the Netie-KB index file (JSON rows).
+ */
+export const NETIE_KB_INDEX_ENV_KEY = "NETIE_KB_INDEX";
+
+/**
+ * Source label stamped on every brief, matching `kb_lookup.show_brief`.
+ */
+export const NETIE_KB_SOURCE = "netie-kb";
+
+/**
+ * Keys that may never leave the index. Same set as `kb_lookup.DROP_KEYS`.
+ */
+export const NETIE_KB_DROP_KEYS: readonly string[] = [
+  "skill_body",
+  "prompt",
+  "instructions",
+  "transcript",
+];
+
+/**
+ * Index row shape in the shape `scripts/kb_lookup.py` returns.
+ */
+export interface NetieKbBrief {
+  /**
+   * Stable Netie-KB id, for example `R-0016` or `S-0004`.
+   */
+  id: string;
+
+  /**
+   * Row kind: `rule`, `workflow`, `finding`, `attack`, `skill` or `unknown`.
+   */
+  kind: string;
+
+  /**
+   * Row title. Never a body.
+   */
+  title: string;
+
+  /**
+   * Row status, or `unknown`.
+   */
+  status: string;
+
+  /**
+   * Always {@link NETIE_KB_SOURCE}.
+   */
+  source: string;
+
+  /**
+   * Optional tags copied from the row.
+   */
+  tags?: string[];
+}
+
+/**
+ * The index refused: id missing, not found, or a body tried to leave.
+ */
+export class NetieKbDenied extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "NetieKbDenied";
+  }
+}
+
+/**
+ * Read-only Netie-KB index.
+ */
+export interface NetieKbIndex {
+  /**
+   * Returns the brief for one id or throws {@link NetieKbDenied}.
+   */
+  lookup(id: string): Promise<NetieKbBrief>;
+}
+
+/**
+ * Reads one scalar index field as text, like Python `str()` on a scalar.
+ */
+function text(value: unknown): string {
+  if (typeof value === "string") return value;
+  if (typeof value === "number" || typeof value === "boolean") {
+    return String(value);
+  }
+  return "";
+}
+
+/**
+ * Builds the index brief for one row. Mirrors `kb_lookup.show_brief`.
+ *
+ * @param meta - Raw index row.
+ * @param options - Optional body (refused for skills) and source label.
+ * @returns Brief without any body.
+ */
+export function showBrief(
+  meta: Record<string, unknown>,
+  options: { body?: string | null; source?: string } = {},
+): NetieKbBrief {
+  const source = options.source ?? NETIE_KB_SOURCE;
+  const kind = text(meta.kind).trim().toLowerCase();
+  const id = text(meta.id).trim();
+  const title = text(meta.title).trim();
+  if (!id) {
+    throw new NetieKbDenied("skill id missing");
+  }
+  const blob = `${id} ${title} ${source}`.toLowerCase();
+  if (NETIE_KB_DROP_KEYS.some((key) => blob.includes(key))) {
+    throw new NetieKbDenied("skill_body must never go to the registry");
+  }
+  if (kind === "skill" && options.body !== undefined && options.body !== null) {
+    throw new NetieKbDenied("skill_body must never leave the index");
+  }
+  const brief: NetieKbBrief = {
+    id,
+    kind: kind || "unknown",
+    title,
+    status: text(meta.status).trim() || "unknown",
+    source,
+  };
+  if (Array.isArray(meta.tags)) {
+    brief.tags = meta.tags
+      .map((tag) => String(tag))
+      .filter((tag) => tag.trim() !== "");
+  }
+  return brief;
+}
+
+/**
+ * Finds one row by id. Mirrors `kb_lookup.lookup`: a skill row that still
+ * carries a body is refused rather than stripped.
+ *
+ * @param rows - Raw index rows.
+ * @param id - Wanted Netie-KB id.
+ * @returns Brief for the row.
+ */
+export function lookupBrief(
+  rows: readonly Record<string, unknown>[],
+  id: string,
+): NetieKbBrief {
+  const want = (id ?? "").trim();
+  if (!want) {
+    throw new NetieKbDenied("skill id missing");
+  }
+  for (const row of rows) {
+    if (text(row.id).trim() === want) {
+      const body = row.body;
+      return showBrief(row, {
+        body: typeof body === "string" ? body : undefined,
+      });
+    }
+  }
+  throw new NetieKbDenied(`not found: ${want}`);
+}
+
+/**
+ * Wraps raw rows as an index.
+ *
+ * @param rows - Raw index rows.
+ * @returns Read-only index.
+ */
+export function createNetieKbIndex(
+  rows: readonly Record<string, unknown>[],
+): NetieKbIndex {
+  const safeRows = rows.filter(
+    (row): row is Record<string, unknown> =>
+      row !== null && typeof row === "object" && !Array.isArray(row),
+  );
+  return {
+    lookup: (id) => Promise.resolve(lookupBrief(safeRows, id)),
+  };
+}
+
+/**
+ * Parses index file text into rows.
+ *
+ * @param text - JSON text: an array of rows or `{ "rows": [...] }`.
+ * @returns Raw rows.
+ */
+export function parseNetieKbIndex(text: string): Record<string, unknown>[] {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch (error) {
+    throw new NetieKbDenied(
+      `Netie-KB index is not valid JSON: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+  const rows = Array.isArray(parsed)
+    ? parsed
+    : parsed !== null &&
+        typeof parsed === "object" &&
+        Array.isArray((parsed as { rows?: unknown }).rows)
+      ? (parsed as { rows: unknown[] }).rows
+      : null;
+  if (rows === null) {
+    throw new NetieKbDenied(
+      "Netie-KB index must be a JSON array of rows or an object with a rows array",
+    );
+  }
+  return rows.filter(
+    (row): row is Record<string, unknown> =>
+      row !== null && typeof row === "object" && !Array.isArray(row),
+  );
+}
+
+/**
+ * Loads the index named by `NETIE_KB_INDEX`.
+ *
+ * @param env - Environment to read.
+ * @returns The index, or `undefined` when no index is configured.
+ */
+export async function loadNetieKbIndex(
+  env: NodeJS.ProcessEnv = process.env,
+): Promise<NetieKbIndex | undefined> {
+  const indexPath = env[NETIE_KB_INDEX_ENV_KEY]?.trim();
+  if (!indexPath) {
+    return undefined;
+  }
+  let text: string;
+  try {
+    text = await readFile(indexPath, "utf8");
+  } catch (error) {
+    throw new NetieKbDenied(
+      `Unable to read Netie-KB index ${indexPath}: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+  return createNetieKbIndex(parseNetieKbIndex(text));
+}
diff --git a/src/netie/openvault.ts b/src/netie/openvault.ts
new file mode 100644
index 0000000..414d9e4
--- /dev/null
+++ b/src/netie/openvault.ts
@@ -0,0 +1,249 @@
+/**
+ * OpenVault: the one key vault and leave-machine gate (NETIE.md section 3).
+ *
+ * Two contracts live here, both read from the Netie repo, not invented:
+ *
+ * - Model calls go to one OpenAI-compatible endpoint, `${NETIE_OPENVAULT_URL}/v1`
+ *   (`TAS/TAS-OPENVAULT.md`, default `http://127.0.0.1:5000`). Netie Wiki holds
+ *   no provider key; OpenVault does.
+ * - Anything that leaves the machine asks OpenVault first:
+ *   `POST ${NETIE_OPENVAULT_URL}/api/crew/gate` with
+ *   `{kind, id, intent, parent_run_id, child_id, deficit}` and proceeds only on
+ *   `allowed: true` (`scripts/crew_ov_gate.py`, `scripts/space_leave.py`). A
+ *   missing URL, a transport failure, a timeout or any body without
+ *   `allowed: true` is a refusal. Body keys that could carry a skill body are
+ *   dropped from the reply before it is read.
+ *
+ * Not measured here: whether OpenVault wants a seat token on `/v1` and whether
+ * `/api/crew/gate` is on OpenVault main yet. This module follows the contract
+ * text and says so in its labels.
+ */
+import { randomUUID } from "node:crypto";
+
+/**
+ * Environment variable naming the OpenVault base URL (no path).
+ */
+export const NETIE_OPENVAULT_URL_ENV_KEY = "NETIE_OPENVAULT_URL";
+
+/**
+ * Default OpenVault base URL per `TAS/TAS-OPENVAULT.md`.
+ */
+export const DEFAULT_OPENVAULT_URL = "http://127.0.0.1:5000";
+
+/**
+ * Environment variable naming the parent run id reported to the gate.
+ */
+export const NETIE_PARENT_RUN_ID_ENV_KEY = "NETIE_PARENT_RUN_ID";
+
+/**
+ * Placeholder API key sent to OpenVault `/v1`. The OpenAI client refuses to
+ * construct without one; OpenVault holds the real provider key. Whether
+ * OpenVault wants a seat token here is not measured.
+ */
+export const OPENVAULT_PLACEHOLDER_API_KEY = "openvault";
+
+/**
+ * Keys that never cross the gate in either direction.
+ */
+const DROP_KEYS: readonly string[] = [
+  "skill_body",
+  "prompt",
+  "instructions",
+  "transcript",
+];
+
+/**
+ * Gate kinds OpenVault registers (`crew_ov_gate.REGISTERED_KINDS`).
+ */
+const REGISTERED_KINDS: ReadonlySet<string> = new Set([
+  "memory",
+  "api",
+  "component",
+  "runtime",
+  "model",
+  "service",
+]);
+
+/**
+ * Milliseconds to wait for OpenVault before treating the ask as refused.
+ */
+const GATE_TIMEOUT_MS = 5_000;
+
+/**
+ * Label shown wherever a connector is off because the gate did not allow it.
+ */
+export const LEAVE_MACHINE_LABEL =
+  "off by default: source connectors leave the machine only through OpenVault leave-machine (NETIE_OPENVAULT_URL, POST /api/crew/gate allowed=true)";
+
+/**
+ * Resolves the OpenVault base URL without a trailing slash.
+ *
+ * @param env - Environment to read.
+ * @returns Base URL such as `http://127.0.0.1:5000`.
+ */
+export function resolveOpenVaultUrl(
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  const configured = env[NETIE_OPENVAULT_URL_ENV_KEY]?.trim();
+  return (configured || DEFAULT_OPENVAULT_URL).replace(/\/+$/u, "");
+}
+
+/**
+ * Resolves the OpenAI-compatible model endpoint, `${NETIE_OPENVAULT_URL}/v1`.
+ *
+ * @param env - Environment to read.
+ * @returns Endpoint base URL.
+ */
+export function resolveOpenVaultV1BaseUrl(
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  return `${resolveOpenVaultUrl(env)}/v1`;
+}
+
+/**
+ * One ask to the OpenVault crew gate. Field names match the Python contract.
+ */
+export interface LeaveMachineAsk {
+  kind: string;
+  id: string;
+  intent: "leave" | "invoke";
+  parent_run_id: string;
+  child_id: string;
+  deficit: string;
+}
+
+/**
+ * Gate decision as the caller sees it. `allowed` is true only on an explicit
+ * `allowed: true` reply; `reason` says why not otherwise.
+ */
+export interface LeaveMachineDecision {
+  allowed: boolean;
+  reason: string;
+  url: string;
+}
+
+/**
+ * Transport used to reach OpenVault. Defaults to the global `fetch`.
+ */
+export type LeaveMachineFetch = (
+  url: string,
+  init: {
+    method: "POST";
+    headers: Record<string, string>;
+    body: string;
+    signal: AbortSignal;
+  },
+) => Promise<{ ok: boolean; status: number; json(): Promise<unknown> }>;
+
+/**
+ * Asks OpenVault whether one leave-machine action may proceed. Never throws:
+ * every failure is a refusal with a reason, so callers show it instead of
+ * falling back silently.
+ *
+ * @param ask - Gate ask.
+ * @param options - Environment and transport overrides.
+ * @returns Decision with the URL that was asked.
+ */
+export async function askLeaveMachine(
+  ask: LeaveMachineAsk,
+  options: { env?: NodeJS.ProcessEnv; fetch?: LeaveMachineFetch } = {},
+): Promise<LeaveMachineDecision> {
+  const env = options.env ?? process.env;
+  const base = resolveOpenVaultUrl(env);
+  const url = `${base}/api/crew/gate`;
+  if (!REGISTERED_KINDS.has(ask.kind)) {
+    return {
+      allowed: false,
+      reason: `no ${ask.kind} registered as '${ask.id}'`,
+      url,
+    };
+  }
+  if (!ask.parent_run_id.trim() || !ask.child_id.trim()) {
+    return {
+      allowed: false,
+      reason: "leave-machine needs parent and child run ids",
+      url,
+    };
+  }
+  const payload = stripBodies({ ...ask });
+  const transport: LeaveMachineFetch = options.fetch ?? globalThis.fetch;
+  let raw: unknown;
+  try {
+    const response = await transport(url, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(payload),
+      signal: AbortSignal.timeout(GATE_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      return { allowed: false, reason: `crew_gate ${response.status}`, url };
+    }
+    raw = await response.json();
+  } catch (error) {
+    return {
+      allowed: false,
+      reason: `crew_gate unreachable: ${error instanceof Error ? error.message : String(error)}`,
+      url,
+    };
+  }
+  const body = stripBodies(raw);
+  if (body === null || typeof body !== "object" || Array.isArray(body)) {
+    return { allowed: false, reason: "crew_gate returned non-object", url };
+  }
+  const record = body as Record<string, unknown>;
+  if (record.allowed !== true) {
+    const reason =
+      typeof record.reason === "string" && record.reason.trim()
+        ? record.reason
+        : "openvault refused";
+    return { allowed: false, reason, url };
+  }
+  return { allowed: true, reason: "allowed", url };
+}
+
+/**
+ * Builds the ask for one source connector pull.
+ *
+ * @param connectorId - Connector id, for example `google`.
+ * @param env - Environment to read the parent run id from.
+ * @returns Gate ask for `wiki.connector.<id>`.
+ */
+export function connectorLeaveAsk(
+  connectorId: string,
+  env: NodeJS.ProcessEnv = process.env,
+): LeaveMachineAsk {
+  return {
+    kind: "service",
+    id: `wiki.connector.${connectorId}`,
+    intent: "leave",
+    parent_run_id: env[NETIE_PARENT_RUN_ID_ENV_KEY]?.trim() || PROCESS_RUN_ID,
+    child_id: randomUUID(),
+    deficit: "connector_ingest",
+  };
+}
+
+/**
+ * One id per process, used as the parent run when none is given.
+ */
+const PROCESS_RUN_ID = `wiki-${randomUUID()}`;
+
+/**
+ * Drops body-carrying keys recursively. Matches `crew_ov_gate.strip_bodies`.
+ */
+function stripBodies(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(stripBodies);
+  }
+  if (value !== null && typeof value === "object") {
+    const out: Record<string, unknown> = {};
+    for (const [key, inner] of Object.entries(
+      value as Record<string, unknown>,
+    )) {
+      if (!DROP_KEYS.includes(key)) {
+        out[key] = stripBodies(inner);
+      }
+    }
+    return out;
+  }
+  return value;
+}
