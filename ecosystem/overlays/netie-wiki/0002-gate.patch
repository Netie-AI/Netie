+/**
+ * Netie Wiki stage 2 gate. Each case asserts something an operator or a
+ * customer actually receives: the Claims sidecar the CLI writes, the HTTP
+ * request a model call sends, the example workflow an operator copies, the
+ * connector result the ingest command prints, and the CLI's own words.
+ *
+ * Every module is imported inside its test body, so on a tree without the gate
+ * each case fails on its own instead of the whole file failing at load.
+ */
+import { createServer, type IncomingMessage, type Server } from "node:http";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { parse } from "yaml";
+
+const ENV_KEYS = [
+  "NETIE_OPENVAULT_URL",
+  "NETIE_KB_INDEX",
+  "OPENWIKI_PROVIDER",
+  "OPENWIKI_CONFIG_DIR",
+  "OPENAI_API_KEY",
+] as const;
+
+/** Port nothing listens on: an OpenVault that is not running. */
+const DEAD_OPENVAULT = "http://127.0.0.1:9";
+
+const KB_ROWS = [
+  { id: "R-0016", kind: "rule", title: "skills live in KB", status: "active" },
+  {
+    id: "S-0001",
+    kind: "skill",
+    title: "fleet",
+    body: "## Steps\n1. Presence first",
+  },
+];
+
+interface Recorded {
+  method: string;
+  url: string;
+  headers: IncomingMessage["headers"];
+  body: string;
+}
+
+/**
+ * Starts a local HTTP stub and records every request it receives.
+ */
+async function startStub(
+  reply: (request: Recorded) => { status: number; body: unknown },
+): Promise<{ url: string; requests: Recorded[]; server: Server }> {
+  const requests: Recorded[] = [];
+  const server = createServer((req, res) => {
+    let body = "";
+    req.on("data", (chunk: Buffer) => {
+      body += chunk.toString("utf8");
+    });
+    req.on("end", () => {
+      const recorded = {
+        method: req.method ?? "",
+        url: req.url ?? "",
+        headers: req.headers,
+        body,
+      };
+      requests.push(recorded);
+      const answer = reply(recorded);
+      res.writeHead(answer.status, { "content-type": "application/json" });
+      res.end(JSON.stringify(answer.body));
+    });
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const { port } = server.address() as AddressInfo;
+  return { url: `http://127.0.0.1:${port}`, requests, server };
+}
+
+describe("Netie Wiki stage 2 gate", () => {
+  let rootDir: string;
+  let saved: Record<string, string | undefined>;
+  const servers: Server[] = [];
+
+  beforeEach(async () => {
+    rootDir = await mkdtemp(path.join(tmpdir(), "netie-wiki-gate-"));
+    saved = Object.fromEntries(ENV_KEYS.map((key) => [key, process.env[key]]));
+    for (const key of ENV_KEYS) delete process.env[key];
+    process.env.OPENWIKI_CONFIG_DIR = path.join(rootDir, "home");
+    vi.resetModules();
+  });
+
+  afterEach(async () => {
+    for (const key of ENV_KEYS) {
+      if (saved[key] === undefined) delete process.env[key];
+      else process.env[key] = saved[key];
+    }
+    await Promise.all(
+      servers
+        .splice(0)
+        .map(
+          (server) =>
+            new Promise<void>((resolve) => server.close(() => resolve())),
+        ),
+    );
+    await rm(rootDir, { force: true, recursive: true });
+  });
+
+  /**
+   * Writes a one-page repository, a KB index, and runs the real Claims
+   * runtime through the agent's submit path. Returns the written sidecar.
+   */
+  async function writeClaimsThroughCli(
+    claims: Array<{ statement: string; kbId?: string }>,
+  ): Promise<Record<string, unknown>> {
+    const page = "/openwiki/page.md";
+    await mkdir(path.join(rootDir, "openwiki"), { recursive: true });
+    await writeFile(
+      path.join(rootDir, "openwiki", "page.md"),
+      "---\ntype: Reference\n---\n\n# Page\n",
+    );
+    await writeFile(path.join(rootDir, "source.ts"), "export const v = 1;\n");
+    const kbPath = path.join(rootDir, "kb.json");
+    await writeFile(kbPath, JSON.stringify({ rows: KB_ROWS }));
+    process.env.NETIE_KB_INDEX = kbPath;
+
+    const { OpenWikiIgnore } =
+      await import("../../src/agent/openwiki-ignore.ts");
+    const { prepareClaimsRuntime } =
+      await import("../../src/claims/brains/code/runtime.ts");
+    const { reconcilePageClaims } =
+      await import("../../src/generation/page-jobs.ts");
+    const runtime = await prepareClaimsRuntime(
+      "init",
+      "repository",
+      rootDir,
+      new OpenWikiIgnore([]),
+    );
+    if (!runtime) throw new Error("Claims runtime was not prepared");
+    await reconcilePageClaims(runtime.session, page, {
+      claims: claims.map((claim) => ({
+        statement: claim.statement,
+        evidence: [{ resource: "repo://source.ts" }],
+        ...(claim.kbId ? { kbId: claim.kbId } : {}),
+      })),
+    });
+    await runtime.finalize("2026-10-28T12:00:00.000Z");
+    const sidecar = await readFile(
+      path.join(rootDir, "openwiki", ".claims", "page.json"),
+      "utf8",
+    );
+    return JSON.parse(sidecar) as Record<string, unknown>;
+  }
+
+  test("a grounded claim is written with its Netie-KB id and brief", async () => {
+    const sidecar = await writeClaimsThroughCli([
+      { statement: "Skills live in Netie-KB.", kbId: "R-0016" },
+    ]);
+    const [claim] = sidecar.claims as Array<Record<string, unknown>>;
+    expect(claim.grounding).toBe("netie-kb");
+    expect(claim.kb).toEqual({
+      id: "R-0016",
+      kind: "rule",
+      title: "skills live in KB",
+      status: "active",
+      source: "netie-kb",
+    });
+  });
+
+  test("a claim without a KB id is written labeled ungrounded, never silently", async () => {
+    const sidecar = await writeClaimsThroughCli([
+      { statement: "The source exports a value." },
+    ]);
+    const [claim] = sidecar.claims as Array<Record<string, unknown>>;
+    expect(claim.grounding).toBe("ungrounded");
+    expect(claim).not.toHaveProperty("kb");
+  });
+
+  test("a KB id the index does not hold is refused, not dropped", async () => {
+    await expect(
+      writeClaimsThroughCli([{ statement: "Invented.", kbId: "R-9999" }]),
+    ).rejects.toThrow(/R-9999/u);
+  });
+
+  test("a KB skill row carrying a body is refused at the boundary", async () => {
+    await expect(
+      writeClaimsThroughCli([{ statement: "Fleet.", kbId: "S-0001" }]),
+    ).rejects.toThrow(/skill_body/u);
+  });
+
+  test("default config resolves to OpenVault /v1 with no provider key", async () => {
+    const constants = await import("../../src/config/constants.ts");
+    expect(constants.resolveConfiguredProvider({})).toBe("openvault");
+    // An ambient direct-provider key does not route around OpenVault.
+    expect(constants.resolveConfiguredProvider({ OPENAI_API_KEY: "x" })).toBe(
+      "openvault",
+    );
+    expect(constants.resolveProviderBaseUrl("openvault", {})).toBe(
+      "http://127.0.0.1:5000/v1",
+    );
+    expect(
+      constants.resolveProviderBaseUrl("openvault", {
+        NETIE_OPENVAULT_URL: "http://vault.local:7000/",
+      }),
+    ).toBe("http://vault.local:7000/v1");
+    expect(constants.getProviderApiKeyEnvKey("openvault")).toBeUndefined();
+    expect(constants.getDefaultModelId(constants.DEFAULT_PROVIDER)).toBe(
+      "auto",
+    );
+  });
+
+  test("a model call leaves only for OpenVault /v1 and carries no provider key", async () => {
+    const stub = await startStub(() => ({
+      status: 200,
+      body: {
+        id: "chatcmpl-1",
+        object: "chat.completion",
+        created: 0,
+        model: "auto",
+        choices: [
+          {
+            index: 0,
+            message: { role: "assistant", content: "ok" },
+            finish_reason: "stop",
+          },
+        ],
+        usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },
+      },
+    }));
+    servers.push(stub.server);
+    process.env.NETIE_OPENVAULT_URL = stub.url;
+    process.env.OPENAI_API_KEY = "sk-must-not-leave";
+
+    const { createModel } = await import("../../src/agent/index.ts");
+    const { resolveConfiguredProvider } =
+      await import("../../src/config/constants.ts");
+    const model = createModel(resolveConfiguredProvider(), "auto", 0);
+    await model.invoke("hello");
+
+    expect(stub.requests).toHaveLength(1);
+    const [request] = stub.requests;
+    expect(request.method).toBe("POST");
+    expect(request.url).toBe("/v1/chat/completions");
+    expect(request.headers.authorization).toBe("Bearer openvault");
+    expect(JSON.stringify(request)).not.toContain("sk-must-not-leave");
+  });
+
+  test("every example workflow an operator copies uses OpenVault and holds no key", async () => {
+    const examples = path.resolve("examples");
+    for (const name of [
+      "openwiki-update.yml",
+      "openwiki-update-auto-merge.yml",
+      "openwiki-update.gitlab-ci.yml",
+    ]) {
+      const text = await readFile(path.join(examples, name), "utf8");
+      parse(text);
+      expect(text, name).toMatch(/OPENWIKI_PROVIDER: openvault/u);
+      expect(text, name).not.toMatch(/[A-Z_]*(API_KEY|_SECRET)[A-Z_]*:/u);
+      expect(text, name).not.toMatch(/OPENWIKI_PROVIDER: (?!openvault)/u);
+    }
+  });
+
+  test("every connector that leaves the machine is off without OpenVault, with a visible label", async () => {
+    process.env.NETIE_OPENVAULT_URL = DEAD_OPENVAULT;
+    const { createConnectorRegistry } =
+      await import("../../src/connectors/registry.ts");
+    const registry = createConnectorRegistry();
+    const local: string[] = [];
+    for (const connector of Object.values(registry)) {
+      if (connector.backend === "local-git") {
+        local.push(connector.id);
+        continue;
+      }
+      expect(connector.description, connector.id).toContain(
+        "OpenVault leave-machine",
+      );
+      const result = await connector.ingest();
+      expect(result.status, connector.id).toBe("skipped");
+      expect(result.message, connector.id).toContain("OpenVault leave-machine");
+      expect(result.message, connector.id).toContain(
+        `${DEAD_OPENVAULT}/api/crew/gate`,
+      );
+      expect(result.rawFiles, connector.id).toEqual([]);
+    }
+    expect(local).toEqual(["git-repo"]);
+  });
+
+  test("a gate reply without allowed=true keeps the connector off", async () => {
+    const stub = await startStub(() => ({
+      status: 200,
+      body: { allowed: "true", reason: "not a boolean" },
+    }));
+    servers.push(stub.server);
+    process.env.NETIE_OPENVAULT_URL = stub.url;
+    const { createConnectorRegistry } =
+      await import("../../src/connectors/registry.ts");
+    const result = await createConnectorRegistry().google.ingest();
+    expect(result.status).toBe("skipped");
+    expect(result.message).toContain("OpenVault leave-machine");
+    expect(stub.requests).toHaveLength(1);
+  });
+
+  test("an OpenVault allow runs the connector and the ask names the connector", async () => {
+    const stub = await startStub(() => ({
+      status: 200,
+      body: { allowed: true, skill_body: "must be stripped" },
+    }));
+    servers.push(stub.server);
+    process.env.NETIE_OPENVAULT_URL = stub.url;
+    const { createConnectorRegistry } =
+      await import("../../src/connectors/registry.ts");
+    const result = await createConnectorRegistry()["custom-mcp"].ingest();
+    expect(result.message).not.toContain("OpenVault leave-machine");
+    expect(stub.requests).toHaveLength(1);
+    const [ask] = stub.requests;
+    expect(ask.url).toBe("/api/crew/gate");
+    expect(JSON.parse(ask.body)).toMatchObject({
+      kind: "service",
+      id: "wiki.connector.custom-mcp",
+      intent: "leave",
+      deficit: "connector_ingest",
+    });
+  });
+
+  test("an MCP tool call is refused without OpenVault", async () => {
+    process.env.NETIE_OPENVAULT_URL = DEAD_OPENVAULT;
+    const { callMcpConnectorTool } =
+      await import("../../src/connectors/mcp-runtime.ts");
