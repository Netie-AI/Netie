diff --git a/internal/config/netie_gate_test.go b/internal/config/netie_gate_test.go
new file mode 100644
index 0000000..06284b3
--- /dev/null
+++ b/internal/config/netie_gate_test.go
@@ -0,0 +1,260 @@
+package config
+
+// Netie stage 2 gate for freeroute-core (DR-0002 rule 6, NETIE.md section 3):
+// "Credentials are issued by OpenVault. The router holds no key of its own."
+//
+// Every case asserts the artifact an operator receives: the shipped example
+// config, and what the real loader (Load) does with a config file. Names are
+// string literals on purpose so this file compiles, and fails case by case,
+// on the upstream tree before the gate exists.
+
+import (
+	"bytes"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	netieGateInertKey   = "inert-placeholder-not-a-key"
+	netieGateRefusal    = "holds no key of its own"
+	netieGateURLEnv     = "NETIE_OPENVAULT_URL"
+	netieGateSeatEnv    = "NETIE_OPENVAULT_SEAT"
+	netieGateDevEnv     = "NETIE_DEV_ALLOW_INLINE_KEYS"
+	netieGateIssuePath  = "/api/freeroute/credentials"
+	netieGateMasterLine = "  master_key: \"sk-test-master-key\"\n"
+)
+
+func netieWriteConfig(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	require.NoError(t, os.WriteFile(path, []byte(body), 0o600))
+	return path
+}
+
+// netieClearCustodyEnv removes the dev override set by TestMain and any vault
+// pointer, so each case sees the production posture.
+func netieClearCustodyEnv(t *testing.T) {
+	t.Helper()
+	t.Setenv(netieGateDevEnv, "")
+	t.Setenv(netieGateURLEnv, "")
+	t.Setenv(netieGateSeatEnv, "")
+}
+
+func netieVault(t *testing.T, issued []map[string]string, seen *http.Request) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if seen != nil {
+			*seen = *r.Clone(r.Context())
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{"credentials": issued})
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+// Case 1: the shipped example config carries no provider key, in any form, and
+// names the OpenVault credential source.
+func TestNetieGate_ExampleConfigCarriesNoProviderKey(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("..", "..", "config.yaml.example"))
+	require.NoError(t, err)
+
+	var doc struct {
+		CredentialSource map[string]string        `yaml:"credential_source"`
+		Credentials      []map[string]interface{} `yaml:"credentials"`
+	}
+	require.NoError(t, yaml.Unmarshal(data, &doc))
+	require.NotEmpty(t, doc.Credentials, "example config lists credentials")
+
+	for _, cred := range doc.Credentials {
+		for _, field := range []string{"api_key", "credentials_file", "credentials_json"} {
+			_, present := cred[field]
+			assert.False(t, present, "credential %v carries %s in config.yaml.example", cred["name"], field)
+		}
+	}
+	assert.Contains(t, doc.CredentialSource["openvault_url"], netieGateURLEnv,
+		"example config points credential_source at ${NETIE_OPENVAULT_URL}")
+}
+
+// Case 2: the loader refuses a config file that carries a key, whether literal,
+// resolved from the environment, or a service-account file or JSON blob.
+func TestNetieGate_LoaderRefusesInlineProviderKey(t *testing.T) {
+	netieClearCustodyEnv(t)
+	t.Setenv("NETIE_GATE_TEST_PROVIDER_KEY", netieGateInertKey)
+	saFile := filepath.Join(t.TempDir(), "sa.json")
+	require.NoError(t, os.WriteFile(saFile, []byte(`{"type":"service_account"}`), 0o600))
+
+	cases := []struct {
+		name  string
+		cred  string
+		field string
+	}{
+		{"literal api_key", "  - name: \"openai_main\"\n    type: \"openai\"\n    api_key: \"" + netieGateInertKey + "\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n", "api_key"},
+		{"api_key from environment", "  - name: \"anthropic_main\"\n    type: \"anthropic\"\n    api_key: \"os.environ/NETIE_GATE_TEST_PROVIDER_KEY\"\n    base_url: \"https://api.anthropic.com\"\n    rpm: 60\n", "api_key"},
+		{"credentials_file", "  - name: \"vertex_main\"\n    type: \"vertex-ai\"\n    project_id: \"p\"\n    location: \"global\"\n    credentials_file: \"" + saFile + "\"\n    rpm: 60\n", "credentials_file"},
+		{"credentials_json", "  - name: \"vertex_json\"\n    type: \"vertex-ai\"\n    project_id: \"p\"\n    location: \"global\"\n    credentials_json: '{\"type\":\"service_account\"}'\n    rpm: 60\n", "credentials_json"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+"credentials:\n"+tc.cred)
+			cfg, err := Load(path)
+			require.Error(t, err, "a config file carrying a provider key must not load")
+			assert.Nil(t, cfg)
+			assert.Contains(t, err.Error(), netieGateRefusal)
+			assert.Contains(t, err.Error(), "inline "+tc.field+" refused")
+			assert.Contains(t, err.Error(), netieGateURLEnv, "the error names the OpenVault way")
+		})
+	}
+}
+
+// Case 3: a credential with no key and no credential source is an error that
+// names OpenVault, not the upstream "api_key is required".
+func TestNetieGate_NoKeyAndNoSourceNamesOpenVault(t *testing.T) {
+	netieClearCustodyEnv(t)
+	path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+
+		"credentials:\n  - name: \"openai_main\"\n    type: \"openai\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n")
+	cfg, err := Load(path)
+	require.Error(t, err)
+	assert.Nil(t, cfg)
+	assert.Contains(t, err.Error(), "credential openai_main: no key and no credential_source")
+	assert.Contains(t, err.Error(), netieGateURLEnv)
+}
+
+// Case 4: keys reach the pool only from OpenVault. The loader calls the issue
+// endpoint with the router's seat, matches entries by credential name, and the
+// pool that rate limits, round-robin and fail2ban consume carries the issued
+// secrets. An air credential that was issued nothing stays keyless.
+func TestNetieGate_KeysReachThePoolOnlyFromOpenVault(t *testing.T) {
+	netieClearCustodyEnv(t)
+	var seen http.Request
+	vault := netieVault(t, []map[string]string{
+		{"name": "openai_main", "api_key": "issued-by-openvault-1"},
+		{"name": "vertex_main", "credentials_json": `{"type":"service_account"}`},
+	}, &seen)
+	t.Setenv(netieGateURLEnv, vault.URL)
+	t.Setenv(netieGateSeatEnv, "ov_test_seat")
+
+	path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+
+		"credential_source:\n  openvault_url: \"os.environ/NETIE_OPENVAULT_URL\"\n  seat: \"os.environ/NETIE_OPENVAULT_SEAT\"\n"+
+		"credentials:\n"+
+		"  - name: \"openai_main\"\n    type: \"openai\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n    tpm: 1000\n"+
+		"  - name: \"vertex_main\"\n    type: \"vertex-ai\"\n    project_id: \"p\"\n    location: \"global\"\n    rpm: 60\n"+
+		"  - name: \"air_fallback\"\n    type: \"air\"\n    base_url: \"http://backup-router.local:8080\"\n    rpm: 60\n    is_fallback: true\n")
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	require.Len(t, cfg.Credentials, 3)
+
+	assert.Equal(t, netieGateIssuePath, seen.URL.Path, "the loader calls the OpenVault issue endpoint")
+	assert.Equal(t, "Bearer ov_test_seat", seen.Header.Get("Authorization"), "the router identifies with its seat")
+
+	assert.Equal(t, "issued-by-openvault-1", cfg.Credentials[0].APIKey)
+	assert.Equal(t, 60, cfg.Credentials[0].RPM, "rate limits stay as configured")
+	assert.Equal(t, 1000, cfg.Credentials[0].TPM)
+	assert.Equal(t, `{"type":"service_account"}`, cfg.Credentials[1].CredentialsJSON)
+	assert.Equal(t, "", cfg.Credentials[2].APIKey, "air credential issued nothing carries nothing")
+	assert.True(t, cfg.Credentials[2].IsFallback)
+}
+
+// Case 5: the credential_source block may be absent; the environment alone is
+// enough, so a container needs only NETIE_OPENVAULT_URL.
+func TestNetieGate_EnvironmentAlonePointsAtOpenVault(t *testing.T) {
+	netieClearCustodyEnv(t)
+	var seen http.Request
+	vault := netieVault(t, []map[string]string{{"name": "openai_main", "api_key": "issued-by-env"}}, &seen)
+	t.Setenv(netieGateURLEnv, vault.URL+"/")
+
+	path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+
+		"credentials:\n  - name: \"openai_main\"\n    type: \"openai\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n")
+	cfg, err := Load(path)
+	require.NoError(t, err)
+	assert.Equal(t, netieGateIssuePath, seen.URL.Path)
+	assert.Equal(t, "", seen.Header.Get("Authorization"), "no seat configured, none sent")
+	assert.Equal(t, "issued-by-env", cfg.Credentials[0].APIKey)
+}
+
+// Case 6: OpenVault that issues nothing for a credential, or is unreachable,
+// stops the router. It never starts half-keyed and never falls back to a key
+// of its own.
+func TestNetieGate_OpenVaultIssuesNothingOrIsDown(t *testing.T) {
+	netieClearCustodyEnv(t)
+	body := "server:\n  port: 8080\n" + netieGateMasterLine +
+		"credentials:\n  - name: \"openai_main\"\n    type: \"openai\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n"
+
+	t.Run("issued no key", func(t *testing.T) {
+		vault := netieVault(t, []map[string]string{{"name": "someone_else", "api_key": "not-for-us"}}, nil)
+		t.Setenv(netieGateURLEnv, vault.URL)
+		cfg, err := Load(netieWriteConfig(t, body))
+		require.Error(t, err)
+		assert.Nil(t, cfg)
+		assert.Contains(t, err.Error(), "credential openai_main: OpenVault at "+vault.URL+" issued no key for it")
+	})
+
+	t.Run("vault refuses", func(t *testing.T) {
+		vault := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			http.Error(w, "seat not granted", http.StatusForbidden)
+		}))
+		defer vault.Close()
+		t.Setenv(netieGateURLEnv, vault.URL)
+		cfg, err := Load(netieWriteConfig(t, body))
+		require.Error(t, err)
+		assert.Nil(t, cfg)
+		assert.Contains(t, err.Error(), "OpenVault refused")
+		assert.Contains(t, err.Error(), "HTTP 403")
+	})
+
+	t.Run("vault down", func(t *testing.T) {
+		vault := httptest.NewServer(http.NotFoundHandler())
+		url := vault.URL
+		vault.Close()
+		t.Setenv(netieGateURLEnv, url)
+		cfg, err := Load(netieWriteConfig(t, body))
+		require.Error(t, err)
+		assert.Nil(t, cfg)
+		assert.Contains(t, err.Error(), "OpenVault unreachable")
+	})
+}
+
+// Case 7: the dev override exists for local runs and the upstream test suite
+// only. It must be loud: every accepted inline key is logged at WARN with the
+// credential name and the override's name.
+func TestNetieGate_DevOverrideIsLoud(t *testing.T) {
+	netieClearCustodyEnv(t)
+	t.Setenv(netieGateDevEnv, "1")
+
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewTextHandler(&logs, &slog.HandlerOptions{Level: slog.LevelWarn})))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+
+		"credentials:\n  - name: \"dev_only\"\n    type: \"openai\"\n    api_key: \""+netieGateInertKey+"\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n")
+	cfg, err := Load(path)
+	require.NoError(t, err, "with the override a dev config loads")
+	require.Len(t, cfg.Credentials, 1)
+	assert.Equal(t, netieGateInertKey, cfg.Credentials[0].APIKey)
+
+	assert.Contains(t, logs.String(), "NETIE DEV OVERRIDE")
+	assert.Contains(t, logs.String(), "credential=dev_only")
+	assert.Contains(t, logs.String(), "override="+netieGateDevEnv)
+}
+
+// Case 8: a non-"1" value of the override is not an override.
+func TestNetieGate_DevOverrideNeedsExactValue(t *testing.T) {
+	netieClearCustodyEnv(t)
+	t.Setenv(netieGateDevEnv, "true")
+	path := netieWriteConfig(t, "server:\n  port: 8080\n"+netieGateMasterLine+
+		"credentials:\n  - name: \"openai_main\"\n    type: \"openai\"\n    api_key: \""+netieGateInertKey+"\"\n    base_url: \"https://api.openai.com\"\n    rpm: 60\n")
+	cfg, err := Load(path)
+	require.Error(t, err)
+	assert.Nil(t, cfg)
+	assert.Contains(t, err.Error(), netieGateRefusal)
+}
