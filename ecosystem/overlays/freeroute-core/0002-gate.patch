+package config
+
+import (
+	"os"
+	"testing"
+)
+
+// The upstream config tests write config files with inline api_key values by
+// design: they exercise the loader, not key custody. Under the Netie custody
+// gate (openvault.go) such a file is refused, so this package's tests run with
+// the loudly labeled dev override set. The gate tests in netie_gate_test.go
+// clear it per test with t.Setenv and prove the refusal without it.
+func TestMain(m *testing.M) {
+	if os.Getenv("NETIE_DEV_ALLOW_INLINE_KEYS") == "" {
+		_ = os.Setenv("NETIE_DEV_ALLOW_INLINE_KEYS", "1")
+	}
+	os.Exit(m.Run())
+}
diff --git a/internal/config/openvault.go b/internal/config/openvault.go
new file mode 100644
index 0000000..7977fc0
--- /dev/null
+++ b/internal/config/openvault.go
@@ -0,0 +1,236 @@
+package config
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Netie custody gate (NETIE.md section 3, DR-0002 rule 6).
+//
+// FreeRoute Core holds no key of its own. The config file carries routing
+// policy only: credential names, provider types, base URLs, limits, weights and
+// priorities. Every provider secret reaches the credential pool from one place,
+// the OpenVault credential source, at load time. A config file that carries a
+// provider key inline, or through an environment variable, is refused by Load
+// with a clear error. Rate limits, round-robin, priorities and fail2ban see the
+// same CredentialConfig values as before; only the origin of the secret changed.
+
+const (
+	// NetieOpenVaultURLEnv names the OpenVault base URL, for example
+	// http://127.0.0.1:5000. Used when credential_source.openvault_url is
+	// "os.environ/NETIE_OPENVAULT_URL" or when the credential_source block is
+	// absent from the config file.
+	NetieOpenVaultURLEnv = "NETIE_OPENVAULT_URL"
+	// NetieOpenVaultSeatEnv names the router's own identity towards OpenVault,
+	// an issued ov_ key. It is the router's seat, never a provider key.
+	NetieOpenVaultSeatEnv = "NETIE_OPENVAULT_SEAT"
+	// NetieDevAllowInlineKeysEnv set to exactly "1" lets a config file carry
+	// provider keys inline. Local development and the upstream test suite only.
+	// Every accepted inline key is logged at WARN with the credential name.
+	// Never set it in production: it turns the router back into a key holder.
+	NetieDevAllowInlineKeysEnv = "NETIE_DEV_ALLOW_INLINE_KEYS"
+	// OpenVaultCredentialsPath is the issue endpoint under the OpenVault URL.
+	// Contract: GET with "Authorization: Bearer <seat>" answers 200 and a JSON
+	// body {"credentials":[{"name":..., "api_key":..., "credentials_json":...}]}.
+	// Entries are matched to config credentials by name. Anything else, including
+	// an unreachable vault, is a refusal and the router does not start.
+	OpenVaultCredentialsPath = "/api/freeroute/credentials"
+
+	openVaultFetchTimeout = 10 * time.Second
+	openVaultMaxBody      = 1 << 20
+)
+
+// ErrInlineProviderKey is wrapped by every refusal of a key found in the
+// config file (literal or resolved from the environment).
+var ErrInlineProviderKey = errors.New("FreeRoute Core holds no key of its own")
+
+// CredentialSourceConfig points the router at the OpenVault that issues its
+// provider credentials.
+type CredentialSourceConfig struct {
+	// OpenVaultURL is the OpenVault base URL. Supports os.environ/VAR_NAME.
+	OpenVaultURL string `yaml:"openvault_url"`
+	// Seat is the router's issued ov_ identity sent as a bearer token. Supports
+	// os.environ/VAR_NAME. Optional: an OpenVault on a trusted loopback may not
+	// require one.
+	Seat string `yaml:"seat,omitempty"`
+}
+
+// UnmarshalYAML resolves os.environ/ references in both fields.
+func (s *CredentialSourceConfig) UnmarshalYAML(value *yaml.Node) error {
+	type tempSource struct {
+		OpenVaultURL string `yaml:"openvault_url"`
+		Seat         string `yaml:"seat,omitempty"`
+	}
+	var temp tempSource
+	if err := value.Decode(&temp); err != nil {
+		return err
+	}
+	s.OpenVaultURL = strings.TrimRight(strings.TrimSpace(resolveEnvString(temp.OpenVaultURL)), "/")
+	s.Seat = strings.TrimSpace(resolveEnvString(temp.Seat))
+	return nil
+}
+
+// Configured reports whether an OpenVault URL is known.
+func (s CredentialSourceConfig) Configured() bool {
+	return s.OpenVaultURL != ""
+}
+
+// inlineSecretField names the first secret-bearing field a credential carries
+// from the config file, or "" when it carries none.
+func inlineSecretField(cred CredentialConfig) string {
+	switch {
+	case cred.APIKey != "":
+		return "api_key"
+	case cred.CredentialsJSON != "":
+		return "credentials_json"
+	case cred.CredentialsFile != "":
+		return "credentials_file"
+	}
+	return ""
+}
+
+// credentialNeedsSecret mirrors Validate: proxy, air and vllm credentials may
+// run without a key; every other provider type needs one.
+func credentialNeedsSecret(cred CredentialConfig) bool {
+	switch cred.Type {
+	case ProviderTypeProxy, ProviderTypeAIR, ProviderTypeVLLM:
+		return false
+	}
+	return true
+}
+
+// applyNetieCustody runs in Load after the YAML is parsed and before Validate.
+// It refuses inline keys (unless the dev override is set), falls back to the
+// environment for the OpenVault URL and seat, and fills the pool from OpenVault.
+func (c *Config) applyNetieCustody() error {
+	inlineAllowed := os.Getenv(NetieDevAllowInlineKeysEnv) == "1"
+
+	if !c.CredentialSource.Configured() {
+		if fromEnv := strings.TrimSpace(os.Getenv(NetieOpenVaultURLEnv)); fromEnv != "" {
+			c.CredentialSource.OpenVaultURL = strings.TrimRight(fromEnv, "/")
+		}
+	}
+	if c.CredentialSource.Configured() && c.CredentialSource.Seat == "" {
+		c.CredentialSource.Seat = strings.TrimSpace(os.Getenv(NetieOpenVaultSeatEnv))
+	}
+
+	for _, cred := range c.Credentials {
+		field := inlineSecretField(cred)
+		if field == "" {
+			continue
+		}
+		if !inlineAllowed {
+			return fmt.Errorf("credential %s: inline %s refused: %w. "+
+				"Issue it from OpenVault (credential_source.openvault_url or %s) "+
+				"or set %s=1 for a local dev run only",
+				cred.Name, field, ErrInlineProviderKey, NetieOpenVaultURLEnv, NetieDevAllowInlineKeysEnv)
+		}
+		slog.Warn("NETIE DEV OVERRIDE: inline provider key accepted from the config file; never run production this way",
+			"credential", cred.Name,
+			"field", field,
+			"override", NetieDevAllowInlineKeysEnv,
+		)
+	}
+
+	if !c.CredentialSource.Configured() {
+		if inlineAllowed {
+			// Dev run: Validate reports missing keys the upstream way.
+			return nil
+		}
+		for _, cred := range c.Credentials {
+			if credentialNeedsSecret(cred) {
+				return fmt.Errorf("credential %s: no key and no credential_source: %w. "+
+					"Set credential_source.openvault_url or %s so OpenVault issues it",
+					cred.Name, ErrInlineProviderKey, NetieOpenVaultURLEnv)
+			}
+		}
+		return nil
+	}
+
+	client := &http.Client{Timeout: openVaultFetchTimeout}
+	return c.fetchOpenVaultCredentials(context.Background(), client)
+}
+
+type issuedCredential struct {
+	Name            string `json:"name"`
+	APIKey          string `json:"api_key"`
+	CredentialsJSON string `json:"credentials_json"`
+}
+
+type issuedCredentials struct {
+	Credentials []issuedCredential `json:"credentials"`
+}
+
+// fetchOpenVaultCredentials asks OpenVault for the secrets of every credential
+// in the config file and writes them into the pool. A credential that needs a
+// secret and received none is a refusal: the router never starts half-keyed.
+func (c *Config) fetchOpenVaultCredentials(ctx context.Context, client *http.Client) error {
+	ctx, cancel := context.WithTimeout(ctx, openVaultFetchTimeout)
+	defer cancel()
+
+	url := c.CredentialSource.OpenVaultURL + OpenVaultCredentialsPath
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return fmt.Errorf("credential_source: bad OpenVault URL %q: %w", c.CredentialSource.OpenVaultURL, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	if seat := c.CredentialSource.Seat; seat != "" {
+		req.Header.Set("Authorization", "Bearer "+seat)
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return fmt.Errorf("credential_source: OpenVault unreachable at %s: %w", url, err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, openVaultMaxBody))
+	if err != nil {
+		return fmt.Errorf("credential_source: reading OpenVault response from %s: %w", url, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("credential_source: OpenVault refused at %s: HTTP %d", url, resp.StatusCode)
+	}
+
+	var issued issuedCredentials
+	if err := json.Unmarshal(body, &issued); err != nil {
+		return fmt.Errorf("credential_source: OpenVault at %s returned no credential list: %w", url, err)
+	}
+
+	byName := make(map[string]issuedCredential, len(issued.Credentials))
+	for _, entry := range issued.Credentials {
+		byName[entry.Name] = entry
+	}
+
+	for i := range c.Credentials {
+		cred := &c.Credentials[i]
+		if entry, ok := byName[cred.Name]; ok {
+			if entry.APIKey != "" {
+				cred.APIKey = entry.APIKey
+			}
+			if entry.CredentialsJSON != "" {
+				cred.CredentialsJSON = entry.CredentialsJSON
+			}
+		}
+		if credentialNeedsSecret(*cred) && cred.APIKey == "" && cred.CredentialsJSON == "" && cred.CredentialsFile == "" {
+			return fmt.Errorf("credential %s: OpenVault at %s issued no key for it", cred.Name, c.CredentialSource.OpenVaultURL)
+		}
+	}
+
+	slog.Info("provider credentials issued by OpenVault",
+		"url", c.CredentialSource.OpenVaultURL,
+		"configured", len(c.Credentials),
+		"issued", len(byName),
+	)
+	return nil
+}
diff --git a/internal/proxy/netie_gate_test.go b/internal/proxy/netie_gate_test.go
new file mode 100644
index 0000000..23121f9
--- /dev/null
+++ b/internal/proxy/netie_gate_test.go
@@ -0,0 +1,183 @@
+package proxy
+
+// Netie stage 2 gate for freeroute-core, data-plane half: the credential the
+// router actually sends upstream is the one OpenVault issued, and round-robin,
+// same-type retry and fail2ban keep working on issued credentials. The config file
+// used here carries no key. Names are string literals so this file compiles,
+// and fails, on the upstream tree before the gate exists.
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/mixaill76/auto_ai_router/internal/config"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type netieAuthLog struct {
+	mu   sync.Mutex
+	seen []string
+}
+
+func (l *netieAuthLog) add(auth string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.seen = append(l.seen, auth)
+}
+
+func (l *netieAuthLog) count(auth string) int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	n := 0
+	for _, a := range l.seen {
+		if a == auth {
+			n++
+		}
+	}
+	return n
+}
+
+func (l *netieAuthLog) all() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]string(nil), l.seen...)
+}
+
+func netieIssuingVault(t *testing.T, issued map[string]string) *httptest.Server {
+	t.Helper()
+	rows := make([]map[string]string, 0, len(issued))
+	for name, key := range issued {
+		rows = append(rows, map[string]string{"name": name, "api_key": key})
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]interface{}{"credentials": rows})
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+func netieLoadKeylessConfig(t *testing.T, vaultURL string, credentials string) *config.Config {
+	t.Helper()
+	t.Setenv("NETIE_DEV_ALLOW_INLINE_KEYS", "")
+	t.Setenv("NETIE_OPENVAULT_URL", vaultURL)
+	t.Setenv("NETIE_OPENVAULT_SEAT", "ov_test_seat")
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	body := "server:\n  port: 8080\n  master_key: \"sk-test-master-key\"\ncredentials:\n" + credentials
+	require.NoError(t, os.WriteFile(path, []byte(body), 0o600))
+	cfg, err := config.Load(path)
+	require.NoError(t, err, "a keyless config loads once OpenVault issues the keys")
+	return cfg
+}
+
+func netieChatRequest() *http.Request {
+	req := httptest.NewRequest(http.MethodPost, "/v1/chat/completions",
+		strings.NewReader(`{"model":"gpt-4","messages":[{"role":"user","content":"Hello"}]}`))
+	req.Header.Set("Authorization", "Bearer sk-test-master-key")
+	req.Header.Set("Content-Type", "application/json")
+	return req
+}
+
+func netieOKBody(w http.ResponseWriter) {
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = io.WriteString(w, `{"id":"chatcmpl-netie","object":"chat.completion","model":"gpt-4","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`)
+}
+
+// Case 9: two keyless credentials, keys issued by OpenVault; the upstream sees
+// only issued keys, and round-robin spreads the calls over both of them.
+func TestNetieGate_RouterSendsOnlyOpenVaultIssuedKeys(t *testing.T) {
+	var authLog netieAuthLog
+	upstream := newIPv4Server(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		authLog.add(r.Header.Get("Authorization"))
+		netieOKBody(w)
+	}))
+	defer upstream.Close()
+
+	vault := netieIssuingVault(t, map[string]string{"pool-a": "issued-a", "pool-b": "issued-b"})
+	cfg := netieLoadKeylessConfig(t, vault.URL, fmt.Sprintf(
+		"  - name: \"pool-a\"\n    type: \"openai\"\n    base_url: %q\n    rpm: 100\n    tpm: 10000\n"+
+			"  - name: \"pool-b\"\n    type: \"openai\"\n    base_url: %q\n    rpm: 100\n    tpm: 10000\n",
+		upstream.URL, upstream.URL))
+
+	prx := NewTestProxyBuilder().WithCredentials(cfg.Credentials...).WithMasterKey(cfg.Server.MasterKey).Build()
+
+	const calls = 6
+	for i := 0; i < calls; i++ {
+		rec := httptest.NewRecorder()
+		prx.ProxyRequest(rec, netieChatRequest())
+		require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+		require.Contains(t, rec.Body.String(), "chatcmpl-netie")
+	}
+
+	seen := authLog.all()
+	require.Len(t, seen, calls)
+	for _, auth := range seen {
+		assert.True(t, auth == "Bearer issued-a" || auth == "Bearer issued-b",
+			"upstream saw a credential OpenVault did not issue: %q", auth)
+	}
+	assert.GreaterOrEqual(t, authLog.count("Bearer issued-a"), 1, "round-robin used pool-a: %v", seen)
+	assert.GreaterOrEqual(t, authLog.count("Bearer issued-b"), 1, "round-robin used pool-b: %v", seen)
+}
+
+// Case 10: fail2ban and same-type retry work on issued credentials. Upstream
+// semantics for a direct provider (openai): a retryable error is retried on
+// another credential of the same type that is not is_fallback (is_fallback
+// and the TryFallbackProxy path are for proxy-like credentials only), and
+// fail2ban bans a credential after max_attempts failures (3 in the test
+// builder, permanent). The primary's issued key is refused upstream (401);
+// the secondary's issued key answers. Every client call succeeds, the
+// secondary answers all of them, and the primary is called at most 3 times
+// across 10 calls because it is banned after the third 401.
+func TestNetieGate_Fail2BanAndRetryOnIssuedCredentials(t *testing.T) {
+	var primaryLog, secondaryLog netieAuthLog
+	primary := newIPv4Server(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		primaryLog.add(r.Header.Get("Authorization"))
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusUnauthorized)
+		_, _ = io.WriteString(w, `{"error":{"message":"upstream refused this key","type":"authentication_error"}}`)
+	}))
+	defer primary.Close()
+	secondary := newIPv4Server(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		secondaryLog.add(r.Header.Get("Authorization"))
+		netieOKBody(w)
+	}))
+	defer secondary.Close()
+
+	vault := netieIssuingVault(t, map[string]string{"primary": "issued-primary", "secondary": "issued-secondary"})
+	cfg := netieLoadKeylessConfig(t, vault.URL, fmt.Sprintf(
+		"  - name: \"primary\"\n    type: \"openai\"\n    base_url: %q\n    rpm: 100\n    tpm: 10000\n"+
+			"  - name: \"secondary\"\n    type: \"openai\"\n    base_url: %q\n    rpm: 100\n    tpm: 10000\n",
+		primary.URL, secondary.URL))
+
+	prx := NewTestProxyBuilder().
+		WithCredentials(cfg.Credentials...).
+		WithMasterKey(cfg.Server.MasterKey).
+		WithMaxProviderRetries(2).
+		Build()
+
+	const calls = 10
+	for i := 0; i < calls; i++ {
+		rec := httptest.NewRecorder()
+		prx.ProxyRequest(rec, netieChatRequest())
+		require.Equal(t, http.StatusOK, rec.Code, "call %d: %s", i, rec.Body.String())
+	}
+
+	for _, auth := range primaryLog.all() {
+		assert.Equal(t, "Bearer issued-primary", auth, "primary saw only its issued key")
+	}
+	for _, auth := range secondaryLog.all() {
+		assert.Equal(t, "Bearer issued-secondary", auth, "secondary saw only its issued key")
+	}
+	assert.GreaterOrEqual(t, len(primaryLog.all()), 1, "primary was tried")
+	assert.LessOrEqual(t, len(primaryLog.all()), 3, "fail2ban banned the primary after max_attempts: %v", primaryLog.all())
+	assert.Equal(t, calls, len(secondaryLog.all()), "every call was answered by the secondary's issued key")
+}
