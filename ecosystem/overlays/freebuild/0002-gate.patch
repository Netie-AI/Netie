@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+
+import { getProjectStatus } from "./project-status";
+
+/**
+ * Netie claim_deploy gate, dashboard side: the green "Live" pill is a claim, so
+ * it needs the active deployment's LIVE claim (server-derived
+ * `activeDeploymentLive`). A ready release without one is deployed, unclaimed.
+ */
+describe("getProjectStatus: Live needs a LIVE claim", () => {
+  const readyActive = {
+    activeDeploymentId: "d1",
+    latestDeploymentId: "d1",
+    activeDeploymentStatus: "ready",
+    latestDeploymentStatus: "ready",
+  };
+
+  it("a ready active deployment WITHOUT the claim is not live", () => {
+    expect(getProjectStatus(readyActive)).not.toBe("live");
+    expect(getProjectStatus({ ...readyActive, activeDeploymentLive: false })).not.toBe("live");
+  });
+
+  it("a ready active deployment WITH the claim is live", () => {
+    expect(getProjectStatus({ ...readyActive, activeDeploymentLive: true })).toBe("live");
+  });
+
+  it("a bare active pointer (no claim field at all) is not live", () => {
+    expect(getProjectStatus({ activeDeploymentId: "d1" })).not.toBe("live");
+  });
+});
