@@ -1,79 +1,10 @@
 @import '@fontsource-variable/geist-mono' layer(base);
 
 /*
- * Openship typography - same Gellix (Latin) + SF Arabic (RTL fallback)
- * stack the dashboard uses. CSS font-fallback picks the first family
- * that has a glyph for each codepoint, so listing them as
- * `'Gellix', 'SF Arabic', …` makes Latin render in Gellix and Arabic
- * fall through to SF Arabic automatically - no per-locale switching.
- *
- * Hosted on the same CDN as the dashboard. swap means text stays
- * readable while the variable webfonts download.
+ * FreeBuild typography: system font stack only. Upstream loaded a proprietary
+ * face and an Arabic face from a vendor CDN; fonts and CDN assets are not part
+ * of the Apache-2.0 code grant, so no @font-face rule remains.
  */
-@font-face {
-  font-family: 'Gellix';
-  src: url('https://cdn.oblien.com/fonts/Gellix-Thin.woff2') format('woff2');
-  font-weight: 100;
-  font-style: normal;
-  font-display: swap;
-}
-@font-face {
-  font-family: 'Gellix';
-  src: url('https://cdn.oblien.com/fonts/Gellix-Light.woff2') format('woff2');
-  font-weight: 300;
-  font-style: normal;
-  font-display: swap;
-}
-@font-face {
-  font-family: 'Gellix';
-  src: url('https://cdn.oblien.com/fonts/Gellix-Regular.woff2') format('woff2');
-  font-weight: 400;
-  font-style: normal;
-  font-display: swap;
-}
