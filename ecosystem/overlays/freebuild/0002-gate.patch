+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { claimDeploy } from "./netie-claim";
+
+/**
+ * Netie claim_deploy gate (catalog: "A live label goes through claim_deploy
+ * (netie.route report_deploy). Simulated is never reported as live.").
+ *
+ * Mirrors Netie scripts/freebuild_honesty.py report_deploy: same order, same
+ * denial reasons. Asserts the claim object the operator receives, never the
+ * internals.
+ */
+
+const OV = "http://openvault.test:5000";
+
+let saved: string | undefined;
+beforeEach(() => {
+  saved = process.env.NETIE_OPENVAULT_URL;
+  delete process.env.NETIE_OPENVAULT_URL;
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env.NETIE_OPENVAULT_URL;
+  else process.env.NETIE_OPENVAULT_URL = saved;
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+function stubFetch(impl: (url: string, init: RequestInit) => Promise<unknown>) {
+  const calls: Array<{ url: string; body: Record<string, unknown> }> = [];
+  const fetchMock = vi.fn(async (url: string, init: RequestInit) => {
+    calls.push({ url, body: JSON.parse(String(init.body)) });
+    const payload = await impl(url, init);
+    return new Response(JSON.stringify(payload), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  });
+  vi.stubGlobal("fetch", fetchMock);
+  return { fetchMock, calls };
+}
+
+describe("claimDeploy without a gate (NETIE_OPENVAULT_URL unset)", () => {
+  it("denies a simulated deploy", async () => {
+    const claim = await claimDeploy({ simulated: true, observedUrl: "https://a.example" });
+    expect(claim).toMatchObject({ status: "UNCLAIMED", reason: "simulated is not HT1", gate: "none" });
+  });
+
+  it("denies a constructed URL, even next to an observed one", async () => {
+    const claim = await claimDeploy({
+      simulated: false,
+      observedUrl: "https://a.example",
+      constructedUrl: "https://slug.opsh.io",
+    });
+    expect(claim).toMatchObject({
+      status: "UNCLAIMED",
+      reason: "URL must be parsed, never constructed",
+      gate: "none",
+    });
+  });
+
+  it("denies a deploy with no URL at all", async () => {
+    const claim = await claimDeploy({ simulated: false });
+    expect(claim).toMatchObject({ status: "UNCLAIMED", reason: "no observed URL", gate: "none" });
+    expect(typeof (claim as { checkedAt: string }).checkedAt).toBe("string");
+  });
+
+  it("claims LIVE on an observed URL and says no gate ran", async () => {
+    const { fetchMock } = stubFetch(async () => ({ allowed: true }));
+    const claim = await claimDeploy({ simulated: false, observedUrl: "https://a.example" });
+    expect(claim).toMatchObject({
+      status: "LIVE",
+      url: "https://a.example",
+      ht1: "observed",
+      gate: "none",
+    });
+    expect(typeof (claim as { claimedAt: string }).claimedAt).toBe("string");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+});
+
+describe("claimDeploy with the OpenVault gate (NETIE_OPENVAULT_URL set)", () => {
+  beforeEach(() => {
+    process.env.NETIE_OPENVAULT_URL = OV;
+  });
+
+  it("claims LIVE through the gate when OpenVault allows the leave", async () => {
+    const { calls } = stubFetch(async () => ({ allowed: true }));
+    const claim = await claimDeploy({
+      simulated: false,
+      observedUrl: "https://a.example",
+      parentRunId: "run-1",
+      childId: "child-1",
+    });
+    expect(claim).toMatchObject({ status: "LIVE", url: "https://a.example", ht1: "observed", gate: "openvault" });
+    expect(calls).toHaveLength(1);
+    expect(calls[0].url).toBe(`${OV}/api/crew/gate`);
+    expect(calls[0].body).toEqual({
+      kind: "service",
+      id: "freebuild",
+      intent: "leave",
+      parent_run_id: "run-1",
+      child_id: "child-1",
+      deficit: "",
+    });
+    for (const key of ["skill_body", "prompt", "instructions", "transcript"]) {
+      expect(calls[0].body).not.toHaveProperty(key);
+    }
+  });
+
+  it("is UNCLAIMED with OpenVault's own reason when the gate refuses", async () => {
+    stubFetch(async () => ({ allowed: false, reason: "vault miss" }));
+    const claim = await claimDeploy({
+      simulated: false,
+      observedUrl: "https://a.example",
+      parentRunId: "run-1",
+      childId: "child-1",
+    });
+    expect(claim).toMatchObject({ status: "UNCLAIMED", reason: "vault miss", gate: "openvault" });
+  });
+
+  it("fails closed when the gate is unreachable", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => {
+        throw new Error("connect ECONNREFUSED");
+      }),
+    );
+    const claim = await claimDeploy({
+      simulated: false,
+      observedUrl: "https://a.example",
+      parentRunId: "run-1",
+      childId: "child-1",
+    });
+    expect(claim.status).toBe("UNCLAIMED");
+    expect(claim).toMatchObject({ gate: "openvault" });
+    expect((claim as { reason: string }).reason).toMatch(/^crew_gate unreachable/);
+  });
+
+  it("refuses a leave without parent and child run ids, before any POST", async () => {
+    const { fetchMock } = stubFetch(async () => ({ allowed: true }));
+    const claim = await claimDeploy({ simulated: false, observedUrl: "https://a.example" });
+    expect(claim).toMatchObject({
+      status: "UNCLAIMED",
+      reason: "leave-machine needs parent and child run ids",
+      gate: "openvault",
+    });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("never asks the gate about a simulated deploy", async () => {
+    const { fetchMock } = stubFetch(async () => ({ allowed: true }));
+    const claim = await claimDeploy({
+      simulated: true,
+      observedUrl: "https://a.example",
+      parentRunId: "run-1",
+      childId: "child-1",
+    });
+    expect(claim).toMatchObject({ status: "UNCLAIMED", reason: "simulated is not HT1" });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+});
