diff --git a/apps/api/test/modules/deployments/netie-claim-api.contract.test.ts b/apps/api/test/modules/deployments/netie-claim-api.contract.test.ts
new file mode 100644
index 0000000..e584044
--- /dev/null
+++ b/apps/api/test/modules/deployments/netie-claim-api.contract.test.ts
@@ -0,0 +1,128 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { storedDeployment } from "../../../../../packages/platform/test/fixtures";
+
+/**
+ * Netie claim_deploy gate, API side. Drives the real controller handlers and the
+ * real presenters (same seam as deployment-masking.contract.test.ts) and asserts
+ * the response body: a "ready" row is NOT live unless it carries a LIVE claim.
+ */
+
+const { getDeployment, listDeployments } = vi.hoisted(() => ({
+  getDeployment: vi.fn(),
+  listDeployments: vi.fn(),
+}));
+
+vi.mock("@repo/platform/engine/modules/deployments/deployment.service", async (importActual) => {
+  const actual = await importActual<typeof import("@repo/platform/engine/modules/deployments/deployment.service")>();
+  return { ...actual, getDeployment, listDeployments };
+});
+vi.mock("@repo/db", () => ({ repos: {}, schema: {} }));
+vi.mock("@repo/platform/engine/lib/auth", () => ({ auth: { api: {} } }));
+vi.mock("../../../src/lib/permission", () => ({
+  permission: { assert: vi.fn().mockResolvedValue(undefined) },
+  authorization: { authorize: vi.fn(async (ctx) => ctx), resolveScope: vi.fn() },
+}));
+vi.mock("@repo/platform/engine/modules/deployments/reconcile.service", () => ({ triggerReconcile: vi.fn() }));
+vi.mock("@repo/platform/engine/modules/deployments/build.service", () => ({ triggerDeployment: vi.fn(), subscribeToBuildSession: vi.fn() }));
+vi.mock("@repo/platform/engine/modules/deployments/build-status.service", () => ({}));
+vi.mock("@repo/platform/engine/modules/deployments/ssl.service", () => ({}));
+vi.mock("@repo/platform/engine/modules/deployments/prepare.service", () => ({ resolveProjectInfo: vi.fn() }));
+vi.mock("@repo/platform/engine/modules/projects/transfer.service", () => ({ promoteProjectToCloud: vi.fn(), TransferConflictError: class extends Error {} }));
+vi.mock("../../../src/lib/cloud/project-router", () => ({
+  maybeProxyCloudProject: vi.fn().mockResolvedValue(null),
+  proxyToSaaS: vi.fn(),
+}));
+vi.mock("@repo/platform/engine/modules/projects/project-cleanup.service", () => ({ collectDeploymentManifest: vi.fn(), executeCleanup: vi.fn() }));
+vi.mock("@repo/platform/engine/modules/github/github-access", () => ({ assertGitHubRepoAccess: vi.fn() }));
+vi.mock("@repo/platform/engine/modules/deployments/rollback/index", () => ({ rollback: vi.fn(), setPin: vi.fn() }));
+vi.mock("@repo/platform/engine/lib/deployment-runtime", () => ({ resolveDeploymentRuntime: vi.fn() }));
+vi.mock("@repo/platform/engine/lib/authorization", async () => ({
+  permission: { assert: vi.fn().mockResolvedValue(undefined) },
+  authorization: { authorize: vi.fn(async (ctx) => ctx), resolveScope: vi.fn() },
+}));
+
+import { getById, list } from "../../../src/modules/deployments/deployment.controller";
+
+const LIVE_CLAIM = {
+  status: "LIVE",
+  url: "https://app.example",
+  ht1: "observed",
+  gate: "none",
+  claimedAt: "2026-10-28T00:00:00.000Z",
+};
+
+const readyRow = (id: string, meta: Record<string, unknown> | null) => ({
+  ...storedDeployment("project-a", "org-1"),
+  id,
+  projectId: "project-1",
+  status: "ready",
+  meta,
+});
+
+function ctx(params: Record<string, string> = {}) {
+  let captured: unknown;
+  const c = {
+    req: { param: (n: string) => params[n], query: () => undefined, header: () => undefined },
+    json: (obj: unknown) => {
+      captured = obj;
+      return obj as never;
+    },
+    get: () => ({ organizationId: "org-1", userId: "u1" }),
+    set: () => undefined,
+  } as any;
+  return { c, read: () => captured as any };
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+});
+
+describe("deployment API: ready is not live without a LIVE claim", () => {
+  it("a ready deployment with no claim is deployed, unclaimed: live false", async () => {
+    getDeployment.mockResolvedValue(readyRow("dep_1", { previousActiveDeploymentId: null }));
+    const { c, read } = ctx({ id: "dep_1" });
+    await getById(c);
+    expect(read().data.status).toBe("ready");
+    expect(read().data.live).toBe(false);
+    expect(read().data.netieClaim).toBeNull();
+  });
+
+  it("a ready deployment with an UNCLAIMED verdict is live false and carries the reason", async () => {
+    const unclaimed = { status: "UNCLAIMED", reason: "URL must be parsed, never constructed", gate: "none", checkedAt: "x" };
+    getDeployment.mockResolvedValue(readyRow("dep_1", { netieClaim: unclaimed }));
+    const { c, read } = ctx({ id: "dep_1" });
+    await getById(c);
+    expect(read().data.live).toBe(false);
+    expect(read().data.netieClaim).toEqual(unclaimed);
+  });
+
+  it("a ready deployment with a LIVE claim is live true", async () => {
+    getDeployment.mockResolvedValue(readyRow("dep_1", { netieClaim: LIVE_CLAIM }));
+    const { c, read } = ctx({ id: "dep_1" });
+    await getById(c);
+    expect(read().data.live).toBe(true);
+    expect(read().data.netieClaim).toEqual(LIVE_CLAIM);
+  });
+
+  it("a LIVE claim on a row that is not ready is not live", async () => {
+    getDeployment.mockResolvedValue({ ...readyRow("dep_1", { netieClaim: LIVE_CLAIM }), status: "failed" });
+    const { c, read } = ctx({ id: "dep_1" });
+    await getById(c);
+    expect(read().data.live).toBe(false);
+  });
+
+  it("list carries live per row", async () => {
+    listDeployments.mockResolvedValue({
+      rows: [readyRow("dep_1", null), readyRow("dep_2", { netieClaim: LIVE_CLAIM })],
+      total: 2,
+      page: 1,
+      perPage: 50,
+    });
+    const { c, read } = ctx();
+    await list(c);
+    expect(read().data.map((r: { id: string; live: boolean }) => [r.id, r.live])).toEqual([
+      ["dep_1", false],
+      ["dep_2", true],
+    ]);
+  });
+});
diff --git a/apps/api/test/modules/deployments/netie-claim-lifecycle.test.ts b/apps/api/test/modules/deployments/netie-claim-lifecycle.test.ts
new file mode 100644
index 0000000..b1f0702
--- /dev/null
+++ b/apps/api/test/modules/deployments/netie-claim-lifecycle.test.ts
@@ -0,0 +1,135 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/**
+ * Netie claim_deploy gate, lifecycle side: what a finished deploy PERSISTS.
+ *
+ * The deployment row is the artifact the API and dashboard read back, so these
+ * assert the `meta.netieClaim` written with the "ready" outcome, nothing else.
+ * Upstream URLs today are built from a configured hostname or returned by a
+ * provider API; none is probed for reachability, so a URL handed to onSuccess as
+ * `url` is CONSTRUCTED and must never be claimed live.
+ */
+
+const h = vi.hoisted(() => ({
+  statusWrites: [] as Array<{ id: string; status: string; extra?: Record<string, unknown> }>,
+  sessionStatuses: [] as string[],
+}));
+
+vi.mock("@repo/db", () => ({
+  repos: {
+    deployment: {
+      setContainerId: async () => {},
+      findReadyVersionByCommit: async () => 3,
+      getNextReadyVersion: async () => 3,
+      updateStatus: async (id: string, status: string, extra?: Record<string, unknown>) => {
+        h.statusWrites.push({ id, status, extra });
+        return true;
+      },
+      supersedePendingDecisions: async () => {},
+      finishBuildSession: async () => {},
+    },
+    project: {
+      setActiveDeployment: async () => {},
+      setCloudWorkspaceId: async () => {},
+      update: async () => {},
+    },
+    service: { listByDeployment: async () => [] },
+    updateStatus: { deleteByProject: async () => {} },
+  },
+}));
+vi.mock("@repo/platform/engine/modules/deployments/session-manager", () => ({
+  updateStatus: (_id: string, status: string) => {
+    h.sessionStatuses.push(status);
+  },
+  broadcastServiceStatus: () => {},
+  appendLog: () => {},
+}));
+vi.mock("@repo/platform/engine/lib/notification-dispatcher", () => ({
+  notification: { emit: () => {} },
+}));
+vi.mock("@repo/platform/engine/lib/audit-emitter", () => ({ audit: { recordAsync: () => {} } }));
+vi.mock("@repo/platform/engine/lib/favicon-detector", () => ({ detectAndStoreFavicon: async () => {} }));
+vi.mock("@repo/platform/engine/modules/mail/webmail/webmail-install.service", () => ({
+  onWebmailDeployed: async () => {},
+}));
+
+const { onSuccess } = await import("@repo/platform/engine/modules/deployments/deployment-lifecycle");
+type LifecycleContext = Parameters<typeof onSuccess>[0];
+
+function ctxFor(): LifecycleContext {
+  return {
+    project: { id: "prj_1", name: "app", slug: "app", framework: "docker" } as never,
+    dep: {
+      id: "dep_1",
+      projectId: "prj_1",
+      organizationId: "org_1",
+      branch: "main",
+      commitSha: "abc123",
+      status: "deploying",
+      meta: null,
+    } as never,
+    buildSessionId: "bld_1",
+    persistLogs: () => [],
+    provisioned: {},
+  };
+}
+
+function persistedClaim(): Record<string, unknown> | undefined {
+  const ready = h.statusWrites.find((w) => w.status === "ready");
+  const meta = ready?.extra?.meta as { netieClaim?: Record<string, unknown> } | null | undefined;
+  return meta?.netieClaim;
+}
+
+let saved: string | undefined;
+beforeEach(() => {
+  h.statusWrites = [];
+  h.sessionStatuses = [];
+  saved = process.env.NETIE_OPENVAULT_URL;
+  delete process.env.NETIE_OPENVAULT_URL;
+});
+afterEach(() => {
+  if (saved === undefined) delete process.env.NETIE_OPENVAULT_URL;
+  else process.env.NETIE_OPENVAULT_URL = saved;
+});
+
+describe("onSuccess persists the claim_deploy verdict with the ready outcome", () => {
+  it("a deploy with no URL is ready but UNCLAIMED (no observed URL)", async () => {
+    await onSuccess(ctxFor(), { containerId: "c1", durationMs: 1 });
+    expect(persistedClaim()).toMatchObject({ status: "UNCLAIMED", reason: "no observed URL", gate: "none" });
+    expect(h.sessionStatuses).toEqual(["ready"]);
+  });
+
+  it("a URL the upstream built is ready but UNCLAIMED (constructed)", async () => {
+    await onSuccess(ctxFor(), { containerId: "c1", url: "https://app.opsh.io", durationMs: 1 });
+    expect(persistedClaim()).toMatchObject({
+      status: "UNCLAIMED",
+      reason: "URL must be parsed, never constructed",
+      gate: "none",
+    });
+  });
+
+  it("only a URL the caller marks observed is claimed LIVE, and says no gate ran", async () => {
+    await onSuccess(ctxFor(), {
+      containerId: "c1",
+      url: "https://app.example",
+      observedUrl: "https://app.example",
+      durationMs: 1,
+    });
+    expect(persistedClaim()).toMatchObject({
+      status: "LIVE",
+      url: "https://app.example",
+      ht1: "observed",
+      gate: "none",
+    });
+  });
+
+  it("a simulated deploy is never LIVE, even with an observed URL", async () => {
+    await onSuccess(ctxFor(), {
+      containerId: "c1",
+      observedUrl: "https://app.example",
+      simulated: true,
+      durationMs: 1,
+    });
+    expect(persistedClaim()).toMatchObject({ status: "UNCLAIMED", reason: "simulated is not HT1" });
+  });
+});
