diff --git a/apps/dashboard/src/netie-no-vendor-assets.test.ts b/apps/dashboard/src/netie-no-vendor-assets.test.ts
new file mode 100644
index 0000000..825af7d
--- /dev/null
+++ b/apps/dashboard/src/netie-no-vendor-assets.test.ts
@@ -0,0 +1,64 @@
+// FreeBuild gate: no vendor CDN reference and no vendor font in the artifact.
+// Fonts and CDN assets are not part of the Apache-2.0 code grant.
+import { execFileSync } from "node:child_process";
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const repoRoot = resolve(here, "../../..");
+const dashboardRoot = resolve(here, "..");
+// Built from parts so this file does not match itself.
+const VENDOR = new RegExp("cdn\\.oblien" + "\\.com|Gell" + "ix");
+const EXEMPT = new Set(["NETIE-ATTRIBUTION.md", "CHANGELOG.md"]);
+
+function tracked(): string[] {
+  const out = execFileSync("git", ["ls-files", "-z"], { cwd: repoRoot, maxBuffer: 256 * 1024 * 1024 });
+  return out.toString("utf8").split("\0").filter(Boolean);
+}
+
+function isBinary(buf: Buffer): boolean {
+  return buf.subarray(0, 8192).includes(0);
+}
+
+function walk(dir: string): string[] {
+  const found: string[] = [];
+  for (const name of readdirSync(dir)) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) found.push(...walk(p));
+    else found.push(p);
+  }
+  return found;
+}
+
+describe("FreeBuild ships no vendor CDN reference or font", () => {
+  it("no tracked text file mentions the vendor CDN or font", () => {
+    const hits: string[] = [];
+    for (const rel of tracked()) {
+      if (EXEMPT.has(rel) || rel.split("/").includes("node_modules")) continue;
+      const abs = join(repoRoot, rel);
+      if (!existsSync(abs) || !statSync(abs).isFile()) continue;
+      const buf = readFileSync(abs);
+      if (isBinary(buf)) continue;
+      if (VENDOR.test(buf.toString("utf8"))) hits.push(rel);
+    }
+    expect(hits).toEqual([]);
+  });
+
+  it("no vendor font binary is tracked", () => {
+    const fonts = tracked().filter((f) => new RegExp("gell" + "ix", "i").test(f));
+    expect(fonts).toEqual([]);
+  });
+
+  it("the built dashboard assets carry no vendor reference", () => {
+    const staticDir = join(dashboardRoot, ".next", "static");
+    if (!existsSync(staticDir)) {
+      throw new Error("dashboard not built: run bun run build first");
+    }
+    const hits = walk(staticDir)
+      .filter((f) => /\.(css|js)$/.test(f))
+      .filter((f) => VENDOR.test(readFileSync(f, "utf8")));
+    expect(hits).toEqual([]);
+  });
+});
