new file mode 100644
index 0000000..0954cd6
--- /dev/null
+++ b/packages/platform/src/engine/modules/deployments/netie-claim.ts
@@ -0,0 +1,148 @@
+/**
+ * Netie claim_deploy gate (FreeBuild stage 2).
+ *
+ * Catalog gate: "A live label goes through claim_deploy (netie.route
+ * report_deploy). Simulated is never reported as live."
+ *
+ * Mirrors Netie scripts/freebuild_honesty.py `report_deploy` rule for rule and
+ * reason for reason, except that a denial is RETURNED as an UNCLAIMED verdict
+ * instead of raised: the caller is the deploy lifecycle, which must never throw
+ * after the workload is up.
+ *
+ * The optional OpenVault leave-machine gate follows Netie scripts/crew_ov_gate.py:
+ * POST `${NETIE_OPENVAULT_URL}/api/crew/gate`, anything but `{allowed: true}` is
+ * a refusal, a transport failure is a refusal (fail closed), and no skill body /
+ * prompt / instructions / transcript ever goes on the wire.
+ *
+ * When NETIE_OPENVAULT_URL is unset no POST is made and the verdict says
+ * `gate: "none"`, so a claim decided without the gate can never be mistaken for
+ * one the gate allowed.
+ */
+
+export type NetieGateMode = "none" | "openvault";
+
+export type NetieClaim =
+  | { status: "LIVE"; url: string; ht1: "observed"; gate: NetieGateMode; claimedAt: string }
+  | { status: "UNCLAIMED"; reason: string; gate: NetieGateMode; checkedAt: string };
+
+/** Denial reasons, verbatim from freebuild_honesty.py report_deploy. */
+export const NETIE_CLAIM_REASONS = {
+  constructed: "URL must be parsed, never constructed",
+  simulated: "simulated is not HT1",
+  noObservedUrl: "no observed URL",
+  missingRunIds: "leave-machine needs parent and child run ids",
+} as const;
+
+/** Keys that must never reach the gate (crew_ov_gate.py DROP_KEYS). */
+const DROP_KEYS = ["skill_body", "prompt", "instructions", "transcript"] as const;
+
+/** Bounded so an unanswering gate cannot hold a finished deploy open. */
+const GATE_TIMEOUT_MS = 5_000;
+
+export interface ClaimDeployInput {
+  simulated: boolean;
+  /** A URL the platform OBSERVED serving (verified reachable), never one it built. */
+  observedUrl?: string | null;
+  /** A URL composed from configuration (hostname, slug). Its presence denies the claim. */
+  constructedUrl?: string | null;
+  /** Override the gate base URL; defaults to process.env.NETIE_OPENVAULT_URL. */
+  gate?: string | null;
+  parentRunId?: string | null;
+  childId?: string | null;
+}
+
+/** The configured OpenVault base URL, or null when no gate is configured. */
+export function netieGateUrl(override?: string | null): string | null {
+  const raw = override ?? process.env.NETIE_OPENVAULT_URL ?? "";
+  const trimmed = raw.trim().replace(/\/+$/, "");
+  return trimmed ? trimmed : null;
+}
+
+function unclaimed(reason: string, gate: NetieGateMode): NetieClaim {
+  return { status: "UNCLAIMED", reason, gate, checkedAt: new Date().toISOString() };
+}
+
+/** POST the leave ask. Returns null when allowed, else the refusal reason. Never throws. */
+async function askGate(baseUrl: string, parentRunId: string, childId: string): Promise<string | null> {
+  const payload: Record<string, string> = {
+    kind: "service",
+    id: "freebuild",
+    intent: "leave",
+    parent_run_id: parentRunId,
+    child_id: childId,
+    deficit: "",
+  };
+  for (const key of DROP_KEYS) {
+    if (key in payload) return "skill_body must never go to the gate";
+  }
+  let body: unknown;
+  try {
+    const res = await fetch(`${baseUrl}/api/crew/gate`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(payload),
+      signal: AbortSignal.timeout(GATE_TIMEOUT_MS),
+    });
+    body = await res.json().catch(() => null);
+  } catch (err) {
+    return `crew_gate unreachable: ${err instanceof Error ? err.message : String(err)}`;
+  }
+  if (!body || typeof body !== "object" || Array.isArray(body)) {
+    return "crew_gate returned non-object";
+  }
+  const verdict = body as { allowed?: unknown; reason?: unknown };
+  if (verdict.allowed !== true) {
+    return typeof verdict.reason === "string" && verdict.reason ? verdict.reason : "openvault refused";
+  }
+  return null;
+}
+
+/**
+ * report_deploy as a verdict. Order matters and matches the Python contract:
+ * constructed, simulated, no observed URL, then (only when configured) the gate.
+ * Never throws.
+ */
+export async function claimDeploy(input: ClaimDeployInput): Promise<NetieClaim> {
+  const gateUrl = netieGateUrl(input.gate);
+  const gate: NetieGateMode = gateUrl ? "openvault" : "none";
+  try {
+    if (input.constructedUrl) return unclaimed(NETIE_CLAIM_REASONS.constructed, gate);
+    if (input.simulated) return unclaimed(NETIE_CLAIM_REASONS.simulated, gate);
+    const url = (input.observedUrl ?? "").trim();
+    if (!url) return unclaimed(NETIE_CLAIM_REASONS.noObservedUrl, gate);
+    if (gateUrl) {
+      const pid = (input.parentRunId ?? "").trim();
+      const cid = (input.childId ?? "").trim();
+      if (!pid || !cid) return unclaimed(NETIE_CLAIM_REASONS.missingRunIds, gate);
+      const refusal = await askGate(gateUrl, pid, cid);
+      if (refusal !== null) return unclaimed(refusal, gate);
+    }
+    return { status: "LIVE", url, ht1: "observed", gate, claimedAt: new Date().toISOString() };
+  } catch (err) {
+    // Unreachable by construction; fail closed if it ever is.
+    return unclaimed(`claim_deploy error: ${err instanceof Error ? err.message : String(err)}`, gate);
+  }
+}
+
+/** The stored claim on a deployment's meta, or null when there is none or it is malformed. */
+export function readNetieClaim(meta: unknown): NetieClaim | null {
+  if (!meta || typeof meta !== "object") return null;
+  const claim = (meta as { netieClaim?: unknown }).netieClaim;
+  if (!claim || typeof claim !== "object") return null;
+  const status = (claim as { status?: unknown }).status;
+  return status === "LIVE" || status === "UNCLAIMED" ? (claim as NetieClaim) : null;
+}
+
+/** Statuses that end a release; a LIVE claim on one of these is history, not liveness. */
+const NOT_SERVING = new Set(["failed", "cancelled", "rejected"]);
+
+/**
+ * Is this deployment live in the Netie sense? Only with a stored LIVE claim, and
+ * never on a row whose own status says it stopped serving. A "ready" row without
+ * a claim is deployed, unclaimed: false.
+ */
+export function deploymentIsLive(dep: { status?: string | null; meta?: unknown } | null | undefined): boolean {
+  if (!dep) return false;
+  if (dep.status && NOT_SERVING.has(dep.status)) return false;
+  return readNetieClaim(dep.meta)?.status === "LIVE";
+}
