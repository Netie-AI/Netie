diff --git a/packages/opencode/src/netie/openvault.ts b/packages/opencode/src/netie/openvault.ts
new file mode 100644
index 0000000..29470bb
--- /dev/null
+++ b/packages/opencode/src/netie/openvault.ts
@@ -0,0 +1,118 @@
+// Netie stage 2 (DR-0002 rule 6). FreeIDE holds no provider key and never
+// leaves the machine on its own:
+//
+//   - model calls go to OpenVault FreeRoute at NETIE_OPENVAULT_URL + /v1
+//   - shell, edit and webfetch ask OpenVault POST /api/crew/gate first
+//
+// The gate body is the Crew GateAsk shape (Netie scripts/crew_ov_gate.py):
+// kind, id, intent, parent_run_id, child_id, deficit. Ids only. Never a
+// command, a path, a diff, a URL, a prompt or a skill body.
+//
+// Unreachable, non-JSON, or anything but allowed === true is a refusal that
+// the tool reports as its error. There is no offline mode and no env flag
+// that turns the gate off.
+import { Effect } from "effect"
+import type { ModelsDev } from "@opencode-ai/core/models-dev"
+
+export const ENV_URL = "NETIE_OPENVAULT_URL"
+export const ENV_KEY = "NETIE_OPENVAULT_KEY"
+export const PROVIDER_ID = "openvault"
+export const DEFAULT_MODEL_ID = "auto"
+const DEFAULT_URL = "http://127.0.0.1:5000"
+const TIMEOUT_MS = 5_000
+
+export function url() {
+  const raw = process.env[ENV_URL]?.trim()
+  return (raw || DEFAULT_URL).replace(/\/+$/, "")
+}
+
+export function modelsURL() {
+  return `${url()}/v1`
+}
+
+export function gateURL() {
+  return `${url()}/api/crew/gate`
+}
+
+/** The catalog row for OpenVault. `auto` is FreeRoute's catalog pick. Limits are assumed, not measured. */
+export function catalogEntry(): ModelsDev.Provider {
+  return {
+    id: PROVIDER_ID,
+    name: "OpenVault FreeRoute",
+    env: [ENV_KEY],
+    npm: "@ai-sdk/openai-compatible",
+    api: modelsURL(),
+    models: {
+      [DEFAULT_MODEL_ID]: {
+        id: DEFAULT_MODEL_ID,
+        name: "OpenVault auto (FreeRoute catalog pick)",
+        release_date: "",
+        attachment: false,
+        reasoning: false,
+        temperature: true,
+        tool_call: true,
+        limit: { context: 128_000, output: 32_000 },
+        modalities: { input: ["text"], output: ["text"] },
+      },
+    },
+  }
+}
+
+export type Ask = {
+  /** Tool id, e.g. "bash", "edit", "webfetch". Never the tool's arguments. */
+  id: string
+  parent_run_id: string
+  child_id: string
+}
+
+export const ASK_KEYS = ["kind", "id", "intent", "parent_run_id", "child_id", "deficit"] as const
+
+type Verdict = { allowed: true; body: Record<string, unknown> } | { allowed: false; error: string }
+
+async function post(endpoint: string, ask: Ask): Promise<Verdict> {
+  const body = {
+    kind: "service",
+    id: ask.id,
+    intent: "leave",
+    parent_run_id: ask.parent_run_id,
+    child_id: ask.child_id,
+    deficit: "",
+  }
+  let res: Response
+  try {
+    res = await fetch(endpoint, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(TIMEOUT_MS),
+    })
+  } catch (e) {
+    const why = e instanceof Error ? e.message : String(e)
+    return {
+      allowed: false,
+      error: `OpenVault gate unreachable at ${endpoint} (${why}). ${ask.id} was not run. Start OpenVault or set ${ENV_URL}.`,
+    }
+  }
+  const json: unknown = await res.json().catch(() => undefined)
+  if (!json || typeof json !== "object" || Array.isArray(json)) {
+    return {
+      allowed: false,
+      error: `OpenVault gate at ${endpoint} returned HTTP ${res.status} without a JSON object. ${ask.id} was not run.`,
+    }
+  }
+  const verdict = json as Record<string, unknown>
+  if (verdict["allowed"] !== true) {
+    const reason = typeof verdict["reason"] === "string" ? verdict["reason"] : `HTTP ${res.status}, allowed is not true`
+    return { allowed: false, error: `OpenVault refused ${ask.id}: ${reason}` }
+  }
+  return { allowed: true, body: verdict }
+}
+
+/** Ask OpenVault before a leave-machine action. Throws on refusal or unreachable. */
+export const gate = Effect.fn("OpenVault.gate")(function* (ask: Ask) {
+  const verdict = yield* Effect.promise(() => post(gateURL(), ask))
+  if (!verdict.allowed) throw new Error(verdict.error)
+  return verdict.body
+})
+
+export * as OpenVault from "./openvault"
