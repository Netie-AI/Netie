diff --git a/packages/opencode/test/netie/openvault-gate.test.ts b/packages/opencode/test/netie/openvault-gate.test.ts
new file mode 100644
index 0000000..29aaf50
--- /dev/null
+++ b/packages/opencode/test/netie/openvault-gate.test.ts
@@ -0,0 +1,307 @@
+// Netie stage 2 proof. Imports only upstream modules on purpose, so the same
+// file runs on the stage 1 baseline (where every case below fails) and after
+// 0002-gate.patch (where every case passes).
+import { afterEach, describe, expect } from "bun:test"
+import path from "path"
+import fs from "fs/promises"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { httpClient } from "@opencode-ai/core/effect/app-node-platform"
+import { CrossSpawnSpawner } from "@opencode-ai/core/cross-spawn-spawner"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { Watcher } from "@opencode-ai/core/filesystem/watcher"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { Cause, Effect, Exit, Layer } from "effect"
+import { FetchHttpClient, HttpClient } from "effect/unstable/http"
+import { Agent } from "../../src/agent/agent"
+import { Config } from "@/config/config"
+import { Env } from "@/env"
+import { EventV2Bridge } from "../../src/event-v2-bridge"
+import { Format } from "../../src/format"
+import { LSP } from "@/lsp/lsp"
+import { Plugin } from "../../src/plugin"
+import { Provider } from "@/provider/provider"
+import { RuntimeFlags } from "@/effect/runtime-flags"
+import { SessionID, MessageID } from "../../src/session/schema"
+import { EditTool } from "../../src/tool/edit"
+import { ShellTool } from "../../src/tool/shell"
+import { Truncate } from "@/tool/truncate"
+import { WebFetchTool } from "../../src/tool/webfetch"
+import type * as Tool from "../../src/tool/tool"
+import { disposeAllInstances, TestInstance, testInstanceStoreLayer } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+const ENV = "NETIE_OPENVAULT_URL"
+const ASK_KEYS = ["kind", "id", "intent", "parent_run_id", "child_id", "deficit"]
+
+const ctx = {
+  sessionID: SessionID.make("ses_netie_gate"),
+  messageID: MessageID.make("msg_netie_gate"),
+  callID: "call_netie_gate",
+  agent: "build",
+  abort: AbortSignal.any([]),
+  messages: [],
+  metadata: () => Effect.void,
+  ask: () => Effect.void,
+}
+
+type Seen = { method: string; path: string; body: unknown; raw: string }
+
+/** A fake OpenVault. Records every request. `reply` decides the verdict. */
+const fakeVault = (reply: (seen: Seen) => Response) =>
+  Effect.acquireRelease(
+    Effect.sync(() => {
+      const seen: Seen[] = []
+      const server = Bun.serve({
+        port: 0,
+        fetch: async (req) => {
+          const raw = await req.text()
+          const item: Seen = {
+            method: req.method,
+            path: new URL(req.url).pathname,
+            body: raw ? JSON.parse(raw) : undefined,
+            raw,
+          }
+          seen.push(item)
+          return reply(item)
+        },
+      })
+      return { seen, url: `http://127.0.0.1:${server.port}`, stop: () => server.stop(true) }
+    }),
+    (vault) => Effect.sync(() => vault.stop()),
+  )
+
+const allow = () => Response.json({ allowed: true, location: "test" })
+const refuse = () => Response.json({ allowed: false, reason: "test says no" })
+
+const withVaultURL = <A, E, R>(url: string, self: Effect.Effect<A, E, R>) =>
+  Effect.acquireUseRelease(
+    Effect.sync(() => {
+      const prev = process.env[ENV]
+      process.env[ENV] = url
+      return prev
+    }),
+    () => self,
+    (prev) =>
+      Effect.sync(() => {
+        if (prev === undefined) delete process.env[ENV]
+        else process.env[ENV] = prev
+      }),
+  )
+
+const squash = <A, E, R>(self: Effect.Effect<A, E, R>) =>
+  Effect.gen(function* () {
+    const exit = yield* self.pipe(Effect.exit)
+    if (Exit.isFailure(exit)) {
+      const err = Cause.squash(exit.cause)
+      return err instanceof Error ? err : new Error(String(err))
+    }
+    throw new Error("expected the tool to refuse")
+  })
+
+afterEach(async () => {
+  await disposeAllInstances()
+})
+
+// ---- shell -------------------------------------------------------------------------------
+
+const shellIt = testEffect(
+  Layer.mergeAll(
+    LayerNode.compile(
+      LayerNode.group([
+        CrossSpawnSpawner.node,
+        FSUtil.node,
+        Plugin.node,
+        Truncate.node,
+        Config.node,
+        Agent.node,
+        RuntimeFlags.node,
+      ]),
+    ),
+    testInstanceStoreLayer,
+  ),
+)
+
+const runShell = Effect.fn("NetieGateTest.shell")(function* (command: string) {
+  const info = yield* ShellTool
+  const tool = yield* info.init()
+  return yield* tool.execute({ command, description: "netie gate test" } as Tool.InferParameters<typeof ShellTool>, ctx)
+})
+
+describe("netie.openvault.gate.shell", () => {
+  shellIt.instance("refused by OpenVault: the command does not run", () =>
+    Effect.gen(function* () {
+      const test = yield* TestInstance
+      const marker = path.join(test.directory, "ran.txt")
+      const vault = yield* fakeVault(refuse)
+      const err = yield* withVaultURL(vault.url, squash(runShell(`echo ran > ${JSON.stringify(marker)}`)))
+      expect(err.message).toContain("OpenVault refused bash")
+      expect(err.message).toContain("test says no")
+      expect(yield* exists(marker)).toBe(false)
+      expect(vault.seen.length).toBe(1)
+    }),
+  )
+
+  shellIt.instance("OpenVault unreachable: fails closed, visibly", () =>
+    Effect.gen(function* () {
+      const test = yield* TestInstance
+      const marker = path.join(test.directory, "ran.txt")
+      // Port 1 is never an OpenVault.
+      const err = yield* withVaultURL("http://127.0.0.1:1", squash(runShell(`echo ran > ${JSON.stringify(marker)}`)))
+      expect(err.message).toContain("OpenVault gate unreachable")
+      expect(err.message).toContain("http://127.0.0.1:1/api/crew/gate")
+      expect(yield* exists(marker)).toBe(false)
+    }),
+  )
+
+  shellIt.instance("allowed: POST /api/crew/gate carries ids only, then the command runs", () =>
+    Effect.gen(function* () {
+      const vault = yield* fakeVault(allow)
+      const result = yield* withVaultURL(vault.url, runShell("echo netie-secret-command"))
+      expect(result.output).toContain("netie-secret-command")
+      expect(vault.seen.length).toBe(1)
+      const [ask] = vault.seen
+      expect(ask.method).toBe("POST")
+      expect(ask.path).toBe("/api/crew/gate")
+      expect(Object.keys(ask.body as object).sort()).toEqual([...ASK_KEYS].sort())
+      const body = ask.body as Record<string, string>
+      expect(body.kind).toBe("service")
+      expect(body.id).toBe("bash")
+      expect(body.intent).toBe("leave")
+      expect(body.parent_run_id).toBe(String(ctx.sessionID))
+      expect(body.child_id).toBe(ctx.callID)
+      expect(ask.raw).not.toContain("netie-secret-command")
+    }),
+  )
+})
+
+// ---- edit --------------------------------------------------------------------------------
+
+const editIt = testEffect(
+  LayerNode.compile(
+    LayerNode.group([LSP.node, FSUtil.node, Format.node, EventV2Bridge.node, Truncate.node, Agent.node]),
+  ),
+)
+
+const runEdit = Effect.fn("NetieGateTest.edit")(function* (args: Tool.InferParameters<typeof EditTool>) {
+  const info = yield* EditTool
+  const tool = yield* info.init()
+  return yield* tool.execute(args, ctx)
+})
+
+describe("netie.openvault.gate.edit", () => {
+  editIt.instance("refused by OpenVault: the file is not written", () =>
+    Effect.gen(function* () {
+      const test = yield* TestInstance
+      const file = path.join(test.directory, "keep.txt")
+      yield* Effect.promise(() => fs.writeFile(file, "before\n"))
+      const vault = yield* fakeVault(refuse)
+      const err = yield* withVaultURL(
+        vault.url,
+        squash(runEdit({ filePath: file, oldString: "before", newString: "after", replaceAll: false })),
+      )
+      expect(err.message).toContain("OpenVault refused edit")
+      expect(yield* Effect.promise(() => fs.readFile(file, "utf8"))).toBe("before\n")
+      const [ask] = vault.seen
+      expect(ask.raw).not.toContain("keep.txt")
+      expect(ask.raw).not.toContain("after")
+    }),
+  )
+
+  editIt.instance("allowed: the edit lands", () =>
+    Effect.gen(function* () {
+      const test = yield* TestInstance
+      const file = path.join(test.directory, "keep.txt")
+      yield* Effect.promise(() => fs.writeFile(file, "before\n"))
+      const vault = yield* fakeVault(allow)
+      yield* withVaultURL(vault.url, runEdit({ filePath: file, oldString: "before", newString: "after", replaceAll: false }))
+      expect(yield* Effect.promise(() => fs.readFile(file, "utf8"))).toBe("after\n")
+      expect(vault.seen.length).toBe(1)
+      expect((vault.seen[0].body as Record<string, string>).id).toBe("edit")
+    }),
+  )
+})
+
+// ---- webfetch ----------------------------------------------------------------------------
+
+const fetchIt = testEffect(
+  LayerNode.compile(LayerNode.group([httpClient, Truncate.node, Agent.node]), [
+    [httpClient, FetchHttpClient.layer as Layer.Layer<HttpClient.HttpClient>],
+  ]),
+)
+
+const runFetch = Effect.fn("NetieGateTest.webfetch")(function* (url: string) {
+  const info = yield* WebFetchTool
+  const tool = yield* info.init()
+  return yield* tool.execute({ url, format: "text" }, ctx)
+})
+
+describe("netie.openvault.gate.webfetch", () => {
+  fetchIt.instance("refused by OpenVault: the URL is never fetched", () =>
+    Effect.gen(function* () {
+      const vault = yield* fakeVault(refuse)
+      const origin = yield* fakeVault(() => new Response("leaked", { status: 200 }))
+      const err = yield* withVaultURL(vault.url, squash(runFetch(`${origin.url}/secret-page`)))
+      expect(err.message).toContain("OpenVault refused webfetch")
+      expect(origin.seen.length).toBe(0)
+      expect(vault.seen[0].raw).not.toContain("secret-page")
+    }),
+  )
+
+  fetchIt.instance("allowed: the fetch proceeds", () =>
+    Effect.gen(function* () {
+      const vault = yield* fakeVault(allow)
+      const origin = yield* fakeVault(() => new Response("hello from origin", { status: 200, headers: { "content-type": "text/plain" } }))
+      const result = yield* withVaultURL(vault.url, runFetch(`${origin.url}/page`))
+      expect(result.output).toContain("hello from origin")
+      expect(origin.seen.length).toBe(1)
+      expect((vault.seen[0].body as Record<string, string>).id).toBe("webfetch")
+    }),
+  )
+})
+
+// ---- default provider --------------------------------------------------------------------
+
+const providerIt = testEffect(LayerNode.compile(LayerNode.group([Provider.node, Env.node, Plugin.node])))
+
+describe("netie.openvault.provider", () => {
+  providerIt.instance("default provider is OpenVault /v1 from NETIE_OPENVAULT_URL, default model is openvault/auto", () =>
+    withVaultURL(
+      "http://vault.test:5000/",
+      Effect.gen(function* () {
+        const providers = yield* Provider.use.list()
+        const openvault = providers[ProviderV2.ID.make("openvault")]
+        expect(openvault).toBeDefined()
+        expect(openvault.models["auto"]).toBeDefined()
+        expect(openvault.models["auto"].api.url).toBe("http://vault.test:5000/v1")
+        expect(openvault.models["auto"].api.npm).toBe("@ai-sdk/openai-compatible")
+        // Every other active provider was switched on by the user's own key or
+        // config, never by default. (This box may carry vendor keys in its env.)
+        for (const provider of Object.values(providers)) {
+          if (provider.id === "openvault") continue
+          expect(["env", "api", "config"]).toContain(provider.source)
+        }
+        const picked = yield* Provider.use.defaultModel()
+        expect(picked.providerID).toBe(ProviderV2.ID.make("openvault"))
+        expect(picked.modelID).toBe(ModelV2.ID.make("auto"))
+      }),
+    ),
+  )
+
+  providerIt.instance(
+    "enabled_providers still wins: an explicit empty list leaves no provider, OpenVault included",
+    Effect.gen(function* () {
+      const providers = yield* Provider.use.list()
+      expect(Object.keys(providers).length).toBe(0)
+    }),
+    { config: { enabled_providers: [] } },
+  )
+})
+
+const exists = (file: string) =>
+  Effect.promise(() =>
+    fs.stat(file).then(
+      () => true,
+      () => false,
+    ),
+  )
