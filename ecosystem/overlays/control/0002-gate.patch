+/**
+ * Netie Control stage 2, create attribution: createdWithAgent is provenance, so a create that
+ * starts no agent stays unwarned at the shipped default, while a real agent startup is dropped
+ * with the label. The renderer half (the pane fork) is in
+ * src/renderer/src/lib/netie-create-attribution.test.ts.
+ */
+
+import '../runtime/orca-runtime-test-lifecycle.spec'
+import '../runtime/rpc/unused-default-rpc-methods.test-fixture'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  OrcaRuntimeService,
+  computeWorktreePathMock,
+  detectInstalledAgentsWithShellPathHydrationMock,
+  ensurePathWithinWorkspaceMock,
+  getEffectiveHooks,
+  listWorktrees
+} from '../runtime/orca-runtime-test-mocks.spec'
+import type { WorktreeMeta } from '../runtime/orca-runtime-test-mocks.spec'
+import { makeWorktreeMeta, store } from '../runtime/orca-runtime-test-fixtures.spec'
+import { RpcDispatcher } from '../runtime/rpc/dispatcher'
+import { WORKTREE_METHODS } from '../runtime/rpc/methods/worktree'
+import type { OrcaRuntimeService as OrcaRuntimeServiceType } from '../runtime/orca-runtime'
+import type { CreateWorktreeResult } from '../../shared/worktree/create-types'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_LOCAL_LAUNCH_ENV
+} from '../../shared/netie-crew-launch-gate'
+import {
+  stripRefusedIpcAgentStartup,
+  withNetieRefusalWarning
+} from './netie-worktree-startup-strip'
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.stubEnv(NETIE_LOCAL_LAUNCH_ENV, '')
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+function makeRuntime(name: string) {
+  const metaById: Record<string, WorktreeMeta> = {}
+  const runtimeStore = {
+    ...store,
+    getSettings: () => ({ ...store.getSettings(), defaultTuiAgent: 'codex' as const }),
+    getAllWorktreeMeta: () => metaById,
+    getWorktreeMeta: (worktreeId: string) => metaById[worktreeId],
+    setWorktreeMeta: (worktreeId: string, meta: Partial<WorktreeMeta>) => {
+      metaById[worktreeId] = { ...(metaById[worktreeId] ?? makeWorktreeMeta()), ...meta }
+      return metaById[worktreeId]
+    }
+  }
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: same partial store shape the upstream startupDraft spec passes.
+  const runtime = new OrcaRuntimeService(runtimeStore as never)
+  const spawn = vi.fn().mockResolvedValue({ id: `pty-${name}` })
+  runtime.setPtyController({
+    spawn,
+    write: vi.fn().mockReturnValue(true),
+    kill: () => true,
+    getForegroundProcess: async () => null
+  })
+  const activateWorktree = vi.fn()
+  runtime.setNotifier({
+    worktreesChanged: vi.fn(),
+    reposChanged: vi.fn(),
+    activateWorktree,
+    createTerminal: vi.fn(),
+    revealTerminalSession: vi.fn().mockResolvedValue({ tabId: 'tab-netie' }),
+    splitTerminal: vi.fn(),
+    renameTerminal: vi.fn(),
+    focusTerminal: vi.fn(),
+    closeTerminal: vi.fn(),
+    sleepWorktree: vi.fn(),
+    terminalFitOverrideChanged: vi.fn(),
+    terminalDriverChanged: vi.fn()
+  })
+  runtime.attachWindow(1)
+  computeWorktreePathMock.mockReturnValue(`/tmp/workspaces/${name}`)
+  ensurePathWithinWorkspaceMock.mockReturnValue(`/tmp/workspaces/${name}`)
+  vi.mocked(getEffectiveHooks).mockReturnValue(null)
+  vi.mocked(listWorktrees).mockResolvedValue([
+    {
+      path: `/tmp/workspaces/${name}`,
+      head: 'def',
+      branch: name,
+      isBare: false,
+      isMainWorktree: false
+    }
+  ])
+  detectInstalledAgentsWithShellPathHydrationMock.mockResolvedValue(['codex'])
+  return { runtime, spawn, activateWorktree, metaById }
+}
+
+function spawnedCommands(spawn: ReturnType<typeof vi.fn>): string[] {
+  return spawn.mock.calls.map((call) => String((call[0] as { command?: string }).command ?? ''))
+}
+
+describe('Netie gate: runtime createManagedWorktree attribution', () => {
+  it('keeps a createdWithAgent-only create unwarned and starts no agent', async () => {
+    const { runtime, spawn, activateWorktree, metaById } = makeRuntime('ca-provenance')
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'ca-provenance',
+      createdWithAgent: 'codex',
+      activate: true
+    })
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+    expect(spawn).not.toHaveBeenCalled()
+    expect(metaById[result.worktree.id]).toMatchObject({ createdWithAgent: 'codex' })
+    expect(activateWorktree).toHaveBeenCalledWith(
+      'repo-1',
+      result.worktree.id,
+      undefined,
+      undefined,
+      undefined
+    )
+  })
+
+  it('drops a startupAgent start with the label and spawns nothing', async () => {
+    const { runtime, spawn, metaById } = makeRuntime('ca-start-agent')
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'ca-start-agent',
+      startupAgent: 'codex',
+      startupPrompt: 'fix the bug',
+      activate: true
+    })
+    expect(spawn).not.toHaveBeenCalled()
+    expect(metaById[result.worktree.id]?.createdWithAgent).toBeUndefined()
+    expect(result.warning).toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('drops an agent-attributed startup command with the label', async () => {
+    const { runtime, spawn } = makeRuntime('ca-attributed')
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'ca-attributed',
+      createdWithAgent: 'codex',
+      startup: { command: 'netie-wrapper --go' },
+      activate: true
+    })
+    expect(spawnedCommands(spawn).some((cmd) => cmd.includes('netie-wrapper'))).toBe(false)
+    expect(result.warning).toContain(NETIE_CREW_LAUNCH_LABEL)
+    // Dropped before any terminal is tried, not refused later by the terminal gate.
+    expect(result.warning).not.toMatch(/failed to create/i)
+  })
+
+  it('runs a non-agent startup command with the flag unset and no label', async () => {
+    const { runtime, spawn } = makeRuntime('ca-pnpm')
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'ca-pnpm',
+      startup: { command: 'pnpm dev' },
+      activate: true
+    })
+    expect(spawnedCommands(spawn).some((cmd) => cmd.includes('pnpm dev'))).toBe(true)
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('starts the startupAgent under the dev override flag', async () => {
+    vi.stubEnv(NETIE_LOCAL_LAUNCH_ENV, '1')
+    const { runtime, spawn, metaById } = makeRuntime('ca-dev')
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'ca-dev',
+      startupAgent: 'codex',
+      activate: true
+    })
+    expect(spawn.mock.calls[0]?.[0]).toMatchObject({ launchAgent: 'codex' })
+    expect(metaById[result.worktree.id]).toMatchObject({ createdWithAgent: 'codex' })
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+})
+
+describe('Netie gate: RPC worktree.create attribution', () => {
+  function makeRpc() {
+    const createManagedWorktree = vi.fn().mockResolvedValue({ worktree: { id: 'wt-1' } })
+    // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: the same partial runtime the upstream worktree.test.ts create cases pass.
+    const runtime = {
+      getRuntimeId: () => 'test-runtime',
+      dedupeWorktreeCreate: <T>(_repo: string, _id: string | undefined, run: () => Promise<T>) =>
+        run(),
+      showRepo: vi.fn().mockResolvedValue({
+        id: 'repo-1',
+        path: '/workspace/repo',
+        displayName: 'repo',
+        badgeColor: '#000',
+        addedAt: 1,
+        kind: 'git'
+      }),
+      createManagedWorktree
+    } as unknown as OrcaRuntimeServiceType
+    return {
+      dispatcher: new RpcDispatcher({ runtime, methods: WORKTREE_METHODS }),
+      createManagedWorktree
+    }
+  }
+
+  function dispatch(rpc: ReturnType<typeof makeRpc>, params: Record<string, unknown>) {
+    return rpc.dispatcher.dispatch({
+      id: 'req-1',
+      authToken: 'tok',
+      method: 'worktree.create',
+      params: { repo: 'repo-1', name: 'feature', ...params }
+    })
+  }
+
+  it('passes a createdWithAgent-only create through unwarned', async () => {
+    const rpc = makeRpc()
+    const response = await dispatch(rpc, { createdWithAgent: 'claude' })
+    expect(rpc.createManagedWorktree).toHaveBeenCalledWith(
+      expect.objectContaining({ createdWithAgent: 'claude', startup: undefined })
+    )
+    expect(JSON.stringify(response)).not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('drops a startupAgent start and warns with the label', async () => {
+    const rpc = makeRpc()
+    const response = await dispatch(rpc, { startupAgent: 'claude', startupPrompt: 'go' })
+    const sent = rpc.createManagedWorktree.mock.calls[0]?.[0] as Record<string, unknown>
+    expect(sent.startupAgent).toBeUndefined()
+    expect(sent.createdWithAgent).toBeUndefined()
+    expect(sent.startupPrompt).toBeUndefined()
+    expect(response).toMatchObject({
+      ok: true,
+      result: { warning: expect.stringContaining(NETIE_CREW_LAUNCH_LABEL) }
+    })
+  })
+
+  it('passes the startupAgent through under the dev override flag', async () => {
+    vi.stubEnv(NETIE_LOCAL_LAUNCH_ENV, '1')
+    const rpc = makeRpc()
+    const response = await dispatch(rpc, { startupAgent: 'claude' })
+    expect(rpc.createManagedWorktree).toHaveBeenCalledWith(
+      expect.objectContaining({ startupAgent: 'claude' })
+    )
+    expect(JSON.stringify(response)).not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+})
+
+type ForkCreateResult = Pick<CreateWorktreeResult, 'warning'> & {
+  worktree: { id: string; path: string }
+}
+
+describe('Netie gate: IPC worktrees:create attribution', () => {
+  const agentStartup = { command: 'claude --prefill x' }
+
+  it('keeps createdWithAgent and the rename flag without a startup, unwarned', () => {
+    const args = { repoId: 'repo-1', name: 'x', createdWithAgent: 'claude' as const }
+    const gated = stripRefusedIpcAgentStartup({ ...args, pendingFirstAgentMessageRename: true })
+    expect(gated.refusedLabel).toBeNull()
+    expect(gated.args).toMatchObject({
+      createdWithAgent: 'claude',
+      pendingFirstAgentMessageRename: true
+    })
+  })
+
+  it('drops an agent startup and its attribution with the label', () => {
+    const gated = stripRefusedIpcAgentStartup({
+      repoId: 'repo-1',
+      name: 'x',
+      createdWithAgent: 'claude',
+      startup: agentStartup
+    })
+    expect(gated.args.startup).toBeUndefined()
+    expect(gated.args.createdWithAgent).toBeUndefined()
+    expect(gated.refusedLabel).toBe(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('keeps a plain startup command unwarned', () => {
+    const gated = stripRefusedIpcAgentStartup({
+      repoId: 'repo-1',
+      name: 'x',
+      startup: { command: 'pnpm dev' }
+    })
+    expect(gated.args.startup).toEqual({ command: 'pnpm dev' })
+    expect(gated.refusedLabel).toBeNull()
+  })
+
+  it('keeps the agent startup under the dev override flag', () => {
+    vi.stubEnv(NETIE_LOCAL_LAUNCH_ENV, '1')
+    const gated = stripRefusedIpcAgentStartup({
+      repoId: 'repo-1',
+      name: 'x',
+      createdWithAgent: 'claude',
+      startup: agentStartup
+    })
+    expect(gated.args.startup).toEqual(agentStartup)
+    expect(gated.refusedLabel).toBeNull()
+  })
+
+  // The pane fork's create (src/renderer/src/lib/netie-create-attribution.test.ts): createdWithAgent
+  // with no startup is provenance, so the host answers it unwarned at the default and under the flag.
+  it.each(['', '1'])('passes the pane fork create unwarned with the flag at %j', (flag) => {
+    vi.stubEnv(NETIE_LOCAL_LAUNCH_ENV, flag)
+    const { args, refusedLabel } = stripRefusedIpcAgentStartup({
+      repoId: 'repo-1',
+      name: 'auth-fork',
+      createdWithAgent: 'codex' as const
+    })
+    const created: ForkCreateResult = { worktree: { id: 'wt-fork', path: '/repo-fork' } }
+    expect(args.createdWithAgent).toBe('codex')
+    expect(refusedLabel).toBeNull()
+    expect(withNetieRefusalWarning(created, refusedLabel)).toEqual(created)
+  })
+})
