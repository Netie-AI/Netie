diff --git a/src/main/host/electron-netie-launch-refusal-notifier.ts b/src/main/host/electron-netie-launch-refusal-notifier.ts
new file mode 100644
index 00000000..d5ca3eb1
--- /dev/null
+++ b/src/main/host/electron-netie-launch-refusal-notifier.ts
@@ -0,0 +1,26 @@
+import { BrowserWindow, dialog } from 'electron'
+import type { NetieLaunchRefusalNotifier } from '../netie-control/netie-pty-launch-write'
+
+let labelDialogOpen = false
+
+/** Netie Control: the refusal label in a message box on the window that wrote; one box at a time, never in the pane. */
+export const electronNetieLaunchRefusalNotifier: NetieLaunchRefusalNotifier = (window, label) => {
+  if (labelDialogOpen) {
+    return
+  }
+  try {
+    const parent = BrowserWindow?.getAllWindows().find(
+      (candidate) => candidate.webContents.id === window.webContents.id
+    )
+    const options = { type: 'warning' as const, title: 'Netie Control', message: label }
+    labelDialogOpen = true
+    void (parent ? dialog.showMessageBox(parent, options) : dialog.showMessageBox(options))
+      .catch(() => undefined)
+      .finally(() => {
+        labelDialogOpen = false
+      })
+  } catch {
+    // No dialog in this process (teardown); the main log line still records the refusal.
+    labelDialogOpen = false
+  }
+}
