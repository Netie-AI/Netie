+import { beforeEach, vi } from 'vitest'
+
+/**
+ * Netie Control turns the upstream local agent launcher off unless NETIE_CONTROL_ALLOW_LOCAL_LAUNCH=1.
+ * The upstream suites test that launcher, so they run under that documented development override,
+ * in main (env flag) and renderer (decision slot). The default-off path is proved on its own in
+ * src/main/netie-control/netie-control-gate.test.ts, which clears both before each case.
+ */
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: writes the realm slot src/renderer/src/lib/netie-crew-launch-notice.ts reads.
+  ;(globalThis as unknown as Record<symbol, unknown>)[Symbol.for('netie.control.launchDecision')] =
+    {
+      decision: { allowed: true, via: 'local-launcher-dev-override' },
+      fromHost: true
+    }
+})
