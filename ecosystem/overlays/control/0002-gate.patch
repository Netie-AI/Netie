diff --git a/src/renderer/src/lib/netie-structured-launch-refusal.ts b/src/renderer/src/lib/netie-structured-launch-refusal.ts
new file mode 100644
index 00000000..0271fa45
--- /dev/null
+++ b/src/renderer/src/lib/netie-structured-launch-refusal.ts
@@ -0,0 +1,26 @@
+import { readNetieHostLaunchRefusal } from '@/lib/netie-host-launch-refusal'
+
+// Netie Control: the launch store keeps only a refusal's code, so a gate-refused chat start keeps its raw error here for the Retry line.
+
+const refusedStarts = new Map<string, unknown>()
+
+/** Runs one structured start and keeps its error when the launch gate refused it; a new attempt clears it. */
+export async function keepNetieStructuredLaunchRefusal<T>(
+  sessionId: string,
+  start: () => Promise<T>
+): Promise<T> {
+  refusedStarts.delete(sessionId)
+  try {
+    return await start()
+  } catch (error) {
+    if (readNetieHostLaunchRefusal(error)) {
+      refusedStarts.set(sessionId, error)
+    }
+    throw error
+  }
+}
+
+/** The raw gate refusal of this chat's last start, or undefined. */
+export function netieStructuredLaunchRefusal(sessionId: string): unknown {
+  return refusedStarts.get(sessionId)
+}
