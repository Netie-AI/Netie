+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { toast } from 'sonner'
+import { createPane } from '@/components/terminal-pane/pty-connection-test-pane-fixtures'
+import {
+  installTerminalTestGlobals,
+  restoreTerminalTestGlobals
+} from '@/components/terminal-pane/pty-connection-test-environment'
+import { createReattachPayloadHandlers } from '@/components/terminal-pane/pty-connection/apply-reattach-payload'
+import type { ReattachPayloadContext } from '@/components/terminal-pane/pty-connection/reattach-payload-context'
+import type { ReattachPayloadSession } from '@/components/terminal-pane/pty-connection/reattach-payload-session'
+import { setNetieLaunchDecisionForTest } from '@/lib/netie-crew-launch-notice'
+import {
+  prefetchNetieColdRestoreLaunchDecision,
