+/**
+ * Netie Control stage 2, worktree family: a plain startup command next to a repo setup script is
+ * not an agent start. Setup copies the startup into claudeAgentTeamsSourceCommand and, under the
+ * wait-for-setup policy, into ORCA_SEQUENCED_STARTUP_COMMAND; the gate judges the command they
+ * carry. Each case drives the real runtime chokepoint from the shipped default (flag unset).
+ */
+
+import '../runtime/orca-runtime-test-lifecycle.spec'
+import '../runtime/rpc/unused-default-rpc-methods.test-fixture'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  OrcaRuntimeService,
+  computeWorktreePathMock,
+  createSetupRunnerScript,
+  ensurePathWithinWorkspaceMock,
+  getEffectiveHooks,
+  listWorktrees
+} from '../runtime/orca-runtime-test-mocks.spec'
+import type { WorktreeMeta } from '../runtime/orca-runtime-test-mocks.spec'
+import {
+  TEST_WORKTREE_PATH,
+  makeWorktreeMeta,
+  store
+} from '../runtime/orca-runtime-test-fixtures.spec'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE
+} from '../../shared/netie-crew-launch-gate'
+
+const SEQUENCED_WRAPPER = `bash -lc 'eval "$ORCA_SEQUENCED_STARTUP_SCRIPT"'`
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+function makeSetupRuntime(name: string, waitForAgentStartup: boolean) {
+  const metaById: Record<string, WorktreeMeta> = {}
+  const runtimeStore = {
+    ...store,
+    getAllWorktreeMeta: () => metaById,
+    getWorktreeMeta: (worktreeId: string) => metaById[worktreeId],
+    setWorktreeMeta: (worktreeId: string, meta: Partial<WorktreeMeta>) => {
+      metaById[worktreeId] = { ...(metaById[worktreeId] ?? makeWorktreeMeta()), ...meta }
+      return metaById[worktreeId]
+    }
+  }
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: same partial store shape the upstream setup-runner spec passes.
+  const runtime = new OrcaRuntimeService(runtimeStore as never)
+  const spawn = vi.fn().mockResolvedValue({ id: `pty-${name}` })
+  runtime.setPtyController({
+    spawn,
+    write: vi.fn().mockReturnValue(true),
+    kill: () => true,
+    getForegroundProcess: async () => null
+  })
+  runtime.setNotifier({
+    worktreesChanged: vi.fn(),
+    reposChanged: vi.fn(),
+    activateWorktree: vi.fn(),
+    createTerminal: vi.fn(),
+    revealTerminalSession: vi.fn().mockResolvedValue({ tabId: 'tab-netie' }),
+    splitTerminal: vi.fn(),
+    renameTerminal: vi.fn(),
+    focusTerminal: vi.fn(),
+    closeTerminal: vi.fn(),
+    sleepWorktree: vi.fn(),
+    terminalFitOverrideChanged: vi.fn(),
+    terminalDriverChanged: vi.fn()
+  })
+  runtime.attachWindow(1)
+  computeWorktreePathMock.mockReturnValue(`/tmp/workspaces/${name}`)
+  ensurePathWithinWorkspaceMock.mockReturnValue(`/tmp/workspaces/${name}`)
+  vi.mocked(getEffectiveHooks).mockReturnValue({ scripts: { setup: 'pnpm worktree:setup' } })
+  vi.mocked(createSetupRunnerScript).mockReturnValue({
+    runnerScriptPath: '/tmp/repo/.git/orca/setup-runner.sh',
+    envVars: { ORCA_ROOT_PATH: '/tmp/repo' },
+    ...(waitForAgentStartup ? { waitForAgentStartup: true } : {})
+  })
+  vi.mocked(listWorktrees).mockResolvedValue([
+    {
+      path: `/tmp/workspaces/${name}`,
+      head: 'def',
+      branch: name,
+      isBare: false,
+      isMainWorktree: false
+    }
+  ])
+  return { runtime, spawn }
+}
+
+function spawnedArgs(spawn: ReturnType<typeof vi.fn>): { command?: string; env?: object }[] {
+  return spawn.mock.calls.map((call) => call[0] as { command?: string; env?: object })
+}
+
+describe('Netie gate: plain startup command with a repo setup script', () => {
+  it('spawns a plain startup next to setup with the flag unset and adds no label', async () => {
+    const { runtime, spawn } = makeSetupRuntime('netie-plain-setup', false)
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'netie-plain-setup',
+      runHooks: true,
+      startup: { command: 'pnpm dev' }
+    })
+    expect(spawnedArgs(spawn).map((args) => args.command)).toContain('pnpm dev')
+    expect(result.startupTerminal).toBeDefined()
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('spawns a sequenced plain startup under the wait-for-setup policy with the flag unset', async () => {
+    const { runtime, spawn } = makeSetupRuntime('netie-plain-sequenced', true)
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'netie-plain-sequenced',
+      runHooks: true,
+      startup: { command: 'pnpm dev' }
+    })
+    expect(spawnedArgs(spawn)).toContainEqual(
+      expect.objectContaining({
+        command: SEQUENCED_WRAPPER,
+        env: expect.objectContaining({ ORCA_SEQUENCED_STARTUP_COMMAND: 'pnpm dev' })
+      })
+    )
+    expect(result.startupTerminal).toBeDefined()
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+
+  it('spawns the plain startup next to setup under the dev override flag', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    const { runtime, spawn } = makeSetupRuntime('netie-plain-dev', false)
+    const result = await runtime.createManagedWorktree({
+      repoSelector: 'id:repo-1',
+      name: 'netie-plain-dev',
+      runHooks: true,
+      startup: { command: 'pnpm dev' }
+    })
+    expect(spawnedArgs(spawn).map((args) => args.command)).toContain('pnpm dev')
+    expect(result.warning ?? '').not.toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+})
+
+describe('Netie gate: createTerminal judges the setup-carried startup command', () => {
+  function makeTerminalRuntime() {
+    const spawn = vi.fn().mockResolvedValue({ id: 'pty-netie-carried' })
+    const runtime = new OrcaRuntimeService(store)
+    runtime.setPtyController({
+      spawn,
+      write: () => true,
+      kill: () => true,
+      getForegroundProcess: async () => null
+    })
+    return { runtime, spawn }
+  }
+
+  it('refuses a sequenced agent startup with the label and spawns nothing', async () => {
+    const { runtime, spawn } = makeTerminalRuntime()
+    const attempt = runtime.createTerminal(`path:${TEST_WORKTREE_PATH}`, {
+      command: SEQUENCED_WRAPPER,
+      env: { ORCA_SEQUENCED_STARTUP_COMMAND: 'claude --prefill hi' }
+    })
+    await expect(attempt).rejects.toMatchObject({
+      message: NETIE_CREW_LAUNCH_LABEL,
+      code: NETIE_CREW_LAUNCH_REFUSED_CODE
+    })
+    expect(spawn).not.toHaveBeenCalled()
+  })
+
+  it('refuses an agent claudeAgentTeamsSourceCommand with the label and spawns nothing', async () => {
+    const { runtime, spawn } = makeTerminalRuntime()
+    await expect(
+      runtime.createTerminal(`path:${TEST_WORKTREE_PATH}`, {
+        command: SEQUENCED_WRAPPER,
+        claudeAgentTeamsSourceCommand: 'claude --prefill hi'
+      })
+    ).rejects.toThrow(NETIE_CREW_LAUNCH_LABEL)
+    expect(spawn).not.toHaveBeenCalled()
+  })
+
+  it('spawns the sequenced agent startup under the dev override flag', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    const { runtime, spawn } = makeTerminalRuntime()
+    await runtime.createTerminal(`path:${TEST_WORKTREE_PATH}`, {
+      command: SEQUENCED_WRAPPER,
+      env: { ORCA_SEQUENCED_STARTUP_COMMAND: 'claude --prefill hi' }
+    })
+    expect(spawn).toHaveBeenCalledTimes(1)
+  })
+})
