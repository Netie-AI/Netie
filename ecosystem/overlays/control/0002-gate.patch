+
+function rpcError(code: string, message: string): RuntimeRpcCallError {
+  return new RuntimeRpcCallError({ id: 'rpc-1', ok: false, error: { code, message } })
+}
+
+/** The host: createSupport answers `support`, create answers `create`; every create is counted. */
+function host(support: unknown, create: unknown = new Promise(() => {})): { creates: number } {
+  const seen = { creates: 0 }
+  mocks.call.mockImplementation(async (_target, method) => {
+    if (method === 'agentSession.createSupport') {
+      return support
+    }
+    if (method === 'agentSession.create') {
+      seen.creates += 1
+      return create
+    }
+    return new Promise(() => {})
+  })
+  return seen
+}
