diff --git a/src/shared/netie-agent-command-line.ts b/src/shared/netie-agent-command-line.ts
new file mode 100644
index 00000000..6232f888
--- /dev/null
+++ b/src/shared/netie-agent-command-line.ts
@@ -0,0 +1,327 @@
+/**
+ * Netie Control: is this shell command line an agent start? Sees through `NAME=value` prefixes,
+ * launch wrappers (exec, env, npx), PowerShell `&` and `.`, cmd `call`/`start`, and the inline
+ * script of `sh -c`, `bash -lc`, `cmd /c`, `pwsh -Command` and `pwsh -EncodedCommand`, then matches
+ * the command word against every executable name in the agent catalog. `orca claude-teams` counts.
+ */
+
+import { TUI_AGENT_CONFIG } from './tui-agent-config'
+
+/** The Orca CLI itself is not an agent; only its `claude-teams` launch mode is. */
+const ORCA_CLI_NAMES: ReadonlySet<string> = new Set(['orca', 'orca-dev', 'orca-ide'])
+
+function agentExecutableNames(): ReadonlySet<string> {
+  const names = new Set<string>()
+  for (const config of Object.values(TUI_AGENT_CONFIG)) {
+    const candidates = [
+      config.detectCmd,
+      ...(config.detectCmdAliases ?? []),
+      config.expectedProcess,
+      config.launchCmd.split(/\s+/)[0] ?? '',
+      ...Object.values(config.launchCmdByPlatform ?? {}).map((cmd) => cmd.split(/\s+/)[0] ?? '')
+    ]
+    for (const name of candidates) {
+      const lowered = name.trim().toLowerCase()
+      if (lowered && !ORCA_CLI_NAMES.has(lowered)) {
+        names.add(lowered)
+      }
+    }
+  }
+  return names
+}
+
+let cachedAgentNames: ReadonlySet<string> | null = null
+function agentNames(): ReadonlySet<string> {
+  cachedAgentNames ??= agentExecutableNames()
+  return cachedAgentNames
+}
+
+const WRAPPERS: ReadonlySet<string> = new Set([
+  'exec',
+  'env',
+  'command',
+  'nohup',
+  'time',
+  'npx',
+  'bunx',
+  'pnpx'
+])
+
+function commandWord(token: string): string {
+  const unquoted = token.replace(/^['"]+|['"]+$/g, '')
+  const base = unquoted.split(/[\\/]/).pop() ?? unquoted
+  return base.replace(/\.(exe|cmd|bat|ps1)$/i, '').toLowerCase()
+}
+
+/**
+ * True when a shell command line starts an agent CLI in any of its `&&` / `||` / `;` / `|`
+ * segments: leading `NAME=value` assignments and launch wrappers are skipped, then the command
+ * word is matched against every executable name in the agent catalog. `orca claude-teams` counts.
+ */
+// Agent names that are also common non-agent tools (goose migrations, kilo editor, Hermes JS
+// compiler, ...). A bare call or an agent-shaped argument counts; app-built launches carry markers.
+const SHARED_NAMES: ReadonlySet<string> = new Set([
+  'goose',
+  'kilo',
+  'hermes',
+  'pi',
+  'amp',
+  'cn',
+  'vibe',
+  'ante',
+  'devin',
+  'muse',
+  'dsh',
+  'dst',
+  'rovo',
+  'droid',
+  'crush',
+  'omp',
+  'mimo',
+  'grok'
+])
+const AGENT_ARG_HINTS: ReadonlySet<string> = new Set([
+  '--resume',
+  '--session',
+  '--continue',
+  '--restore',
+  '--tui',
+  '--trust',
+  '--trust-workspace',
+  '--prompt',
+  '--model',
+  '--yolo',
+  '--dangerously-skip-permissions',
+  'session',
+  'chat'
+])
+// npm package names that install an agent CLI, for npx / bunx / pnpx launches.
+const AGENT_PACKAGES: ReadonlySet<string> = new Set([
+  'claude-code',
+  'codex',
+  'opencode-ai',
+  'gemini-cli',
+  'qwen-code',
+  'copilot',
+  'amp',
+  'crush',
+  'cline',
+  'codebuff',
+  'freebuff',
+  'kilocode',
+  'auggie',
+  'droid'
+])
+const PACKAGE_RUNNERS: ReadonlySet<string> = new Set(['npx', 'bunx', 'pnpx'])
+// Two-word launches whose first word is not an agent on its own.
+const TWO_WORD_LAUNCHES: readonly (readonly [ReadonlySet<string>, string])[] = [
+  [ORCA_CLI_NAMES, 'claude-teams'],
+  [new Set(['acli']), 'rovodev']
+]
+
+function packageName(token: string): string {
+  const unquoted = token.replace(/^['"]+|['"]+$/g, '').toLowerCase()
+  const withoutScope = unquoted.startsWith('@') ? (unquoted.split('/')[1] ?? '') : unquoted
+  return withoutScope.replace(/@.*$/, '')
+}
+
+function isPlainAgentStartLine(command: string | null | undefined): boolean {
+  if (typeof command !== 'string' || command.trim() === '') {
+    return false
+  }
+  const names = agentNames()
+  for (const segment of command.split(/&&|\|\||[;|\n]/)) {
+    const tokens = segment.trim().split(/\s+/).filter(Boolean)
+    let index = 0
+    let packageRunner = false
+    // Skip NAME=value prefixes, launch wrappers, and the flags a wrapper takes before the command.
+    while (index < tokens.length) {
+      const token = tokens[index]!
+      const word = commandWord(token)
+      // `command -v NAME` / `command -V NAME` only look the program up; nothing runs.
+      if (word === 'command' && /^-[A-Za-z]*[vV]/.test(tokens[index + 1] ?? '')) {
+        index = tokens.length
+        break
+      }
+      if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(token) || WRAPPERS.has(word)) {
+        packageRunner ||= PACKAGE_RUNNERS.has(word)
+        index += 1
+      } else if (index > 0 && token.startsWith('-')) {
+        index += 1
+      } else {
+        break
+      }
+    }
+    const head = tokens[index]
+    if (!head) {
+      continue
+    }
+    if (packageRunner && AGENT_PACKAGES.has(packageName(head))) {
+      return true
+    }
+    const word = commandWord(head)
+    const next = commandWord(tokens[index + 1] ?? '')
+    if (TWO_WORD_LAUNCHES.some(([first, second]) => first.has(word) && next === second)) {
+      return true
+    }
+    if (!names.has(word)) {
+      continue
+    }
+    const args = tokens.slice(index + 1).map((arg) => arg.toLowerCase().split('=')[0] ?? '')
+    if (
+      !SHARED_NAMES.has(word) ||
+      args.length === 0 ||
+      args.some((arg) => AGENT_ARG_HINTS.has(arg))
+    ) {
+      return true
+    }
+  }
+  return false
+}
+
+// Shells whose command flag (or, for PowerShell, positional text) carries a whole command line.
+const POSIX_SHELLS: ReadonlySet<string> = new Set(['sh', 'bash', 'zsh', 'dash', 'ksh', 'fish'])
+const POWERSHELLS: ReadonlySet<string> = new Set(['pwsh', 'powershell'])
+// Words that run the next token as a command: PowerShell call and dot-source, cmd call and start.
+const RUNNERS: ReadonlySet<string> = new Set(['&', '.', 'call', 'start', 'start-process', 'sudo'])
+// PowerShell parameters that take a value, so the value is not mistaken for the command.
+const PWSH_VALUE_FLAGS: ReadonlySet<string> = new Set([
+  '-executionpolicy',
+  '-ep',
+  '-ex',
+  '-windowstyle',
+  '-w',
+  '-workingdirectory',
+  '-wd',
+  '-outputformat',
+  '-of',
+  '-inputformat',
+  '-if',
+  '-configurationname',
+  '-settingsfile'
+])
+const MAX_DEPTH = 4
+
+/** Splits on unquoted && || ; | & and newlines; a lone & is a PowerShell call or a background. */
+function segments(line: string): string[] {
+  const out: string[] = []
+  let current = ''
+  let quote: string | null = null
+  for (const char of line) {
+    if (quote) {
+      current += char
+      quote = char === quote ? null : quote
+    } else if (char === "'" || char === '"') {
+      current += char
+      quote = char
+    } else if (char === '&' || char === '|' || char === ';' || char === '\n' || char === '\r') {
+      out.push(current)
+      current = ''
+    } else {
+      current += char
+    }
+  }
+  out.push(current)
+  return out
+}
+
+/** Whitespace tokens that keep a quoted run (a path with spaces, a -c script) as one token. */
+function tokens(segment: string): string[] {
+  return segment.match(/'[^']*'?|"[^"]*"?|[^\s'"]+(?:'[^']*'?|"[^"]*"?|[^\s'"]+)*/g) ?? []
+}
+
+function unquote(token: string): string {
+  return token.replace(/^(['"])([\s\S]*?)\1?$/, '$2')
+}
+
+function shellWord(token: string): string {
+  const base = unquote(token).split(/[\\/]/).pop() ?? ''
+  return base.replace(/\.(exe|cmd|bat|ps1|com)$/i, '').toLowerCase()
+}
+
+// atob instead of Buffer: this module also ships to the renderer.
+function decodePwshEncoded(value: string): string {
+  try {
+    const bytes = atob(unquote(value))
+    let text = ''
+    for (let index = 0; index + 1 < bytes.length; index += 2) {
+      text += String.fromCharCode(bytes.charCodeAt(index) | (bytes.charCodeAt(index + 1) << 8))
+    }
+    return text
+  } catch {
+    return ''
+  }
+}
+
+/** The command line a shell wrapper runs, or null when the shell gets no inline command. */
+function shellPayload(shell: string, rest: string[]): string | null {
+  for (let index = 0; index < rest.length; index += 1) {
+    const flag = unquote(rest[index]!).toLowerCase()
+    const after = rest.slice(index + 1).map(unquote)
+    if (POSIX_SHELLS.has(shell) && /^-[a-z]*c[a-z]*$/.test(flag)) {
+      return after.join(' ')
+    }
+    if (shell === 'cmd' && /^\/[ck]/.test(flag)) {
+      return `${flag.slice(2)} ${after.join(' ')}`
+    }
+    if (POWERSHELLS.has(shell)) {
+      if (/^-(c|co|com|comm|comma|comman|command|cwa|commandwithargs)$/.test(flag)) {
+        return after.join(' ')
+      }
+      if (/^-(e|ec|en|enc|enco|encodedcommand)$/.test(flag) || flag.startsWith('-encodedc')) {
+        return decodePwshEncoded(rest[index + 1] ?? '')
+      }
+      if (PWSH_VALUE_FLAGS.has(flag)) {
+        index += 1
+      } else if (!flag.startsWith('-')) {
+        return rest.slice(index).map(unquote).join(' ')
+      }
+    }
+  }
+  return null
+}
+
+/** Every command line a wrapped start would run: past & and . call operators and shell -c text. */
+function unwrappedLines(line: string, depth: number): string[] {
+  if (depth > MAX_DEPTH) {
+    return []
+  }
+  const lines: string[] = []
+  for (const segment of segments(line)) {
+    const parts = tokens(segment)
+    let index = 0
+    while (
+      index < parts.length &&
+      (RUNNERS.has(shellWord(parts[index]!)) || /^[A-Za-z_][A-Za-z0-9_]*=/.test(parts[index]!))
+    ) {
+      index += 1
+    }
+    const head = parts[index]
+    if (!head) {
+      continue
+    }
+    const rest = parts.slice(index + 1)
+    // The base name keeps a quoted path with spaces as one command word.
+    lines.push([unquote(head).split(/[\\/]/).pop() ?? '', ...rest].join(' '))
+    const shell = shellWord(head)
+    const payload =
+      POSIX_SHELLS.has(shell) || POWERSHELLS.has(shell) || shell === 'cmd'
+        ? shellPayload(shell, rest)
+        : null
+    if (payload) {
+      lines.push(...unwrappedLines(payload, depth + 1))
+    }
+  }
+  return lines
+}
+
+/** True when any command this line would run starts an agent CLI. */
+export function isAgentStartCommand(command: string | null | undefined): boolean {
+  if (typeof command !== 'string' || command.trim() === '') {
+    return false
+  }
+  if (isPlainAgentStartLine(command)) {
+    return true
+  }
+  return unwrappedLines(command, 0).some((line) => isPlainAgentStartLine(line))
+}
diff --git a/src/shared/netie-control-board.ts b/src/shared/netie-control-board.ts
new file mode 100644
index 00000000..a2b54ac8
--- /dev/null
+++ b/src/shared/netie-control-board.ts
@@ -0,0 +1,307 @@
+/**
+ * Netie Control board contract. The fleet board reads ids only, in the shape
+ * `netie.control.project_board` emits (Netie repo, scripts/control_board.py), from a configured
+ * URL. The local agent-status store is not this board's source of truth.
+ *
+ * The guards mirror the Python module one for one: body keys refuse, remote-desktop kinds refuse
+ * (Control is not Guacamole), and the whole board stays under the 12k DitchContext budget. A
+ * refusal is a labelled empty board, never a silent drop.
+ */
+
+import {
+  EMPTY_DASHBOARD_SNAPSHOT,
+  type DashboardBucket,
+  type DashboardCard,
+  type DashboardCardDotState,
+  type DashboardSnapshot
+} from './dashboard-snapshot'
+
+export const NETIE_CONTROL_BOARD_URL_ENV = 'NETIE_CONTROL_BOARD_URL'
+export const NETIE_BOARD_PRODUCT = 'crew-board'
+/** Same DitchContext as scripts/control_board.py MAX_BOARD_CHARS. */
+export const NETIE_BOARD_MAX_CHARS = 12_000
+export const NETIE_BOARD_FORBIDDEN_KEYS = [
+  'skill_body',
+  'prompt',
+  'transcript',
+  'api_key',
+  'password'
+] as const
+export const NETIE_BOARD_RDP_KINDS = [
+  'rdp',
+  'vnc',
+  'guacamole',
+  'guacd',
+  'remote_desktop',
+  'ssh',
+  'telnet',
+  'kubernetes',
+  'k8s',
+  'k8s_exec'
+] as const
+export const NETIE_BOARD_CARD_KINDS = [
+  'run',
+  'ticket',
+  'epic',
+  'ledger',
+  'refusal',
+  'skill'
+] as const
+export type NetieBoardCardKind = (typeof NETIE_BOARD_CARD_KINDS)[number]
+
+/** One `project_board` card: ids and statuses only. */
+export type NetieBoardCard = {
+  id: string
+  kind: NetieBoardCardKind
+  status?: string
+  ticket_id?: string
+  epic_id?: string
+  tier?: string
+  reason?: string
+  source?: string
+}
+
+export type NetieBoard = {
+  product: typeof NETIE_BOARD_PRODUCT
+  cards: NetieBoardCard[]
+  /** Cards Python emitted without a usable id (project_board copies row.get('id') unchecked). */
+  idlessCount: number
+}
+
+export type NetieBoardAdmission = { ok: true; board: NetieBoard } | { ok: false; refusal: string }
+
+export const NETIE_BOARD_REPO_ID = 'netie-control'
+export const NETIE_BOARD_REPO_NAME = 'Netie Control'
+
+export const NETIE_BOARD_UNCONFIGURED_LABEL =
+  `Netie Control board source is not configured: set ${NETIE_CONTROL_BOARD_URL_ENV} to the ` +
+  'netie.control.project_board endpoint. The local agent store is not this board, so no cards are shown.'
+
+export type NetieBoardSource =
+  | { kind: 'configured'; url: string }
+  | { kind: 'unconfigured'; label: string }
+
+export function resolveNetieBoardSource(
+  env: Readonly<Record<string, string | undefined>>
+): NetieBoardSource {
+  const raw = env[NETIE_CONTROL_BOARD_URL_ENV]?.trim() ?? ''
+  if (raw === '') {
+    return { kind: 'unconfigured', label: NETIE_BOARD_UNCONFIGURED_LABEL }
+  }
+  if (!/^https?:\/\//i.test(raw)) {
+    return {
+      kind: 'unconfigured',
+      label: `${NETIE_CONTROL_BOARD_URL_ENV} must be an http(s) URL; no cards are shown.`
+    }
+  }
+  return { kind: 'configured', url: raw }
+}
+
+const RDP_KIND_SET: ReadonlySet<string> = new Set(NETIE_BOARD_RDP_KINDS)
+const CARD_KIND_SET: ReadonlySet<string> = new Set(NETIE_BOARD_CARD_KINDS)
+const OPTIONAL_ID_FIELDS = ['status', 'ticket_id', 'epic_id', 'tier', 'reason', 'source'] as const
+
+function optionalText(value: unknown): string | undefined {
+  return typeof value === 'string' && value.length > 0 ? value : undefined
+}
+
+/** Python's json.dumps(ensure_ascii=True, separators=(',', ':')): every UTF-16 unit above 0x7f
+ *  counts as a six-char escape, so the 12k budget is measured on the same text Python measures. */
+export function pythonJsonDumps(value: unknown): string {
+  return JSON.stringify(value).replace(
+    /[\u0080-\uffff]/g,
+    (unit) => `\\u${unit.charCodeAt(0).toString(16).padStart(4, '0')}`
+  )
+}
+
+/** Python copies ids unchecked, so a number or a missing id can arrive; numbers are kept as text. */
+function cardId(value: unknown): string | null {
+  if (typeof value === 'string') {
+    return value.length > 0 ? value : null
+  }
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return String(value)
+  }
+  return null
+}
+
+function admitCard(
+  value: unknown
+): { ok: true; card: NetieBoardCard | null } | { ok: false; refusal: string } {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return { ok: false, refusal: 'card is not an object' }
+  }
+  const row: Record<string, unknown> = { ...value }
+  if (NETIE_BOARD_FORBIDDEN_KEYS.some((key) => key in row)) {
+    return { ok: false, refusal: 'index leaked a body' }
+  }
+  const kind = typeof row.kind === 'string' ? row.kind.trim().toLowerCase() : ''
+  if (RDP_KIND_SET.has(kind)) {
+    return { ok: false, refusal: 'Control is not Guacamole' }
+  }
+  if (!CARD_KIND_SET.has(kind)) {
+    return { ok: false, refusal: `unknown card kind ${JSON.stringify(row.kind)}` }
+  }
+  const id = cardId(row.id)
+  if (id === null) {
+    // Admitted like Python admits it, but not drawn: the board label counts it instead.
+    return { ok: true, card: null }
+  }
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: kind was checked against NETIE_BOARD_CARD_KINDS just above.
+  const card: NetieBoardCard = { id, kind: kind as NetieBoardCardKind }
+  for (const field of OPTIONAL_ID_FIELDS) {
+    const text = optionalText(row[field])
+    if (text !== undefined) {
+      card[field] = text
+    }
+  }
+  return { ok: true, card }
+}
+
+/** The same four refusals `control_board.project_board` raises, in the same order. */
+export function admitNetieBoard(value: unknown): NetieBoardAdmission {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return { ok: false, refusal: 'board is not an object' }
+  }
+  const raw: Record<string, unknown> = { ...value }
+  if (raw.product !== NETIE_BOARD_PRODUCT) {
+    return { ok: false, refusal: `product is not ${NETIE_BOARD_PRODUCT}` }
+  }
+  if (!Array.isArray(raw.cards)) {
+    return { ok: false, refusal: 'cards is not a list' }
+  }
+  const cards: NetieBoardCard[] = []
+  let idlessCount = 0
+  for (const entry of raw.cards) {
+    const admitted = admitCard(entry)
+    if (!admitted.ok) {
+      return admitted
+    }
+    if (admitted.card) {
+      cards.push(admitted.card)
+    } else {
+      idlessCount += 1
+    }
+  }
+  const dumped = pythonJsonDumps(value)
+  if (dumped.length > NETIE_BOARD_MAX_CHARS) {
+    return { ok: false, refusal: 'board over DitchContext' }
+  }
+  for (const needle of NETIE_BOARD_FORBIDDEN_KEYS) {
+    if (dumped.includes(needle)) {
+      return { ok: false, refusal: `board contained ${needle}` }
+    }
+  }
+  return { ok: true, board: { product: NETIE_BOARD_PRODUCT, cards, idlessCount } }
+}
+
+const WORKING_STATUSES: ReadonlySet<string> = new Set(['open', 'running', 'active', 'dispatched'])
+const DONE_STATUSES: ReadonlySet<string> = new Set([
+  'done',
+  'closed',
+  'completed',
+  'merged',
+  'appended',
+  'verified'
+])
+const WAITING_STATUSES: ReadonlySet<string> = new Set(['waiting', 'blocked', 'needs_human'])
+
+function cardState(card: NetieBoardCard): {
+  bucket: DashboardBucket
+  dotState: DashboardCardDotState
+} {
+  const status = card.status?.toLowerCase() ?? ''
+  if (card.kind === 'refusal') {
+    return { bucket: 'attention', dotState: 'blocked' }
+  }
+  if (WAITING_STATUSES.has(status)) {
+    return { bucket: 'attention', dotState: 'waiting' }
+  }
+  if (WORKING_STATUSES.has(status)) {
+    return { bucket: 'working', dotState: 'working' }
+  }
+  if (DONE_STATUSES.has(status)) {
+    return { bucket: 'done', dotState: 'done' }
+  }
+  return { bucket: 'idle', dotState: 'idle' }
+}
+
+function cardTask(card: NetieBoardCard): string {
+  const parts = [`${card.kind} ${card.id}`]
+  if (card.ticket_id && card.ticket_id !== card.id) {
+    parts.push(`ticket ${card.ticket_id}`)
+  }
+  if (card.epic_id) {
+    parts.push(`epic ${card.epic_id}`)
+  }
+  if (card.tier) {
+    parts.push(`tier ${card.tier}`)
+  }
+  if (card.source) {
+    parts.push(card.source)
+  }
+  return parts.join(' / ')
+}
+
+/** Ids-only cards for the kanban board. No prompt, transcript or key text can reach it. */
+export function projectNetieBoardSnapshot(
+  board: NetieBoard,
+  now: number,
+  sourceLabel: string
+): DashboardSnapshot {
+  const cards: DashboardCard[] = board.cards.map((card) => {
+    const paneKey = `netie:${card.kind}:${card.id}`
+    const { bucket, dotState } = cardState(card)
+    const worktreeId = card.epic_id ?? card.ticket_id ?? card.id
+    return {
+      paneKey,
+      ptyId: null,
+      agentType: 'unknown',
+      bucket,
+      dotState,
+      task: cardTask(card),
+      repoId: NETIE_BOARD_REPO_ID,
+      worktreeId,
+      tabId: paneKey,
+      leafId: null,
+      repoName: NETIE_BOARD_REPO_NAME,
+      worktreeName: worktreeId,
+      hostKind: 'remote',
+      startedAt: now,
+      finishedAt: bucket === 'done' ? now : null,
+      stateChangedAt: now,
+      unseen: false,
+      ...(card.kind === 'refusal' && card.reason ? { askSummary: card.reason } : {})
+    }
+  })
+  return {
+    ...EMPTY_DASHBOARD_SNAPSHOT,
+    generatedAt: now,
+    cards,
+    showIdle: true,
+    filterOptions: {
+      projects: [{ id: NETIE_BOARD_REPO_ID, label: NETIE_BOARD_REPO_NAME }],
+      workspaceStatuses: []
+    },
+    sourceLabel:
+      board.idlessCount > 0
+        ? `${sourceLabel} (${board.idlessCount} card(s) without an id not shown)`
+        : sourceLabel
+  }
+}
+
+/** An empty board that says why it is empty. */
+export function emptyNetieBoardSnapshot(now: number, sourceLabel: string): DashboardSnapshot {
+  return { ...EMPTY_DASHBOARD_SNAPSHOT, generatedAt: now, cards: [], sourceLabel }
+}
+
+/** Per-bucket card counts of a projected board, for summaries such as the sidebar entry. */
+export function countNetieBoardBuckets(
+  snapshot: Pick<DashboardSnapshot, 'cards'>
+): Record<DashboardBucket, number> {
+  const counts: Record<DashboardBucket, number> = { attention: 0, working: 0, done: 0, idle: 0 }
+  for (const card of snapshot.cards) {
+    counts[card.bucket] += 1
+  }
+  return counts
+}
diff --git a/src/shared/netie-crew-launch-gate.ts b/src/shared/netie-crew-launch-gate.ts
new file mode 100644
index 00000000..82587799
--- /dev/null
+++ b/src/shared/netie-crew-launch-gate.ts
@@ -0,0 +1,136 @@
+/**
+ * Netie Control never grows a second orchestrator. Agents start through the Crew ticket runner
+ * (Netie repo, netie.crew.run_open_ticket via scripts/crew_runner.py). This build has no wire
+ * contract to reach it, so every local agent start is off by default and says so, instead of
+ * quietly running the upstream launcher. The development override is one env flag, value `1`.
+ *
+ * The decision is enforced in the main process at each place a process or provider session is
+ * started (PTY spawn funnels, workspace create, structured sessions, text generation, background
+ * probes, orchestration, automations). The renderer asks the same decision only to show the label
+ * without a round trip. A user typing an agent command by hand into a plain shell is not a launch
+ * this app makes and is out of scope.
+ */
+
+import { isAgentStartCommand } from './netie-agent-command-line'
+
+export { isAgentStartCommand }
+
+export const NETIE_LOCAL_LAUNCH_ENV = 'NETIE_CONTROL_ALLOW_LOCAL_LAUNCH'
+export const NETIE_CREW_LAUNCH_REFUSED_CODE = 'netie_crew_launch_refused'
+export const NETIE_CREW_LAUNCH_LABEL =
+  'Agent launch is off: Netie Control starts agents through the Crew ticket runner ' +
+  '(netie.crew.run_open_ticket), which this build does not reach yet. ' +
+  `The local launcher stays off unless ${NETIE_LOCAL_LAUNCH_ENV}=1 is set for development.`
+
+export type NetieAgentLaunchDecision =
+  | { allowed: true; via: 'local-launcher-dev-override' }
+  | { allowed: false; code: typeof NETIE_CREW_LAUNCH_REFUSED_CODE; label: string }
+
+export function decideNetieAgentLaunch(
+  env: Readonly<Record<string, string | undefined>>
+): NetieAgentLaunchDecision {
+  if (env[NETIE_LOCAL_LAUNCH_ENV] === '1') {
+    return { allowed: true, via: 'local-launcher-dev-override' }
+  }
+  return { allowed: false, code: NETIE_CREW_LAUNCH_REFUSED_CODE, label: NETIE_CREW_LAUNCH_LABEL }
+}
+
+export function isNetieAgentLaunchAllowed(
+  env: Readonly<Record<string, string | undefined>> = process.env
+): boolean {
+  return decideNetieAgentLaunch(env).allowed
+}
+
+/**
+ * Thrown before anything is created, so a refused launch has no effects to clean up. The message
+ * IS the label: IPC rejections, RPC `runtime_error` fallbacks, toasts and run records all carry
+ * only `message`, and a bare code there would hide the reason from the operator.
+ */
+export class NetieCrewLaunchRefusedError extends Error {
+  readonly code = NETIE_CREW_LAUNCH_REFUSED_CODE
+  readonly data: { label: string }
+  constructor(readonly label: string = NETIE_CREW_LAUNCH_LABEL) {
+    super(label)
+    this.name = 'NetieCrewLaunchRefusedError'
+    this.data = { label }
+  }
+}
+
+export function isNetieCrewLaunchRefusedError(
+  error: unknown
+): error is NetieCrewLaunchRefusedError {
+  return (
+    error instanceof NetieCrewLaunchRefusedError ||
+    (error instanceof Error &&
+      (error as { code?: unknown }).code === NETIE_CREW_LAUNCH_REFUSED_CODE)
+  )
+}
+
+export function assertNetieAgentLaunchAllowed(
+  env: Readonly<Record<string, string | undefined>> = process.env
+): void {
+  const decision = decideNetieAgentLaunch(env)
+  if (!decision.allowed) {
+    throw new NetieCrewLaunchRefusedError(decision.label)
+  }
+}
+
+/** One line in the main log for background paths that have no UI surface of their own. */
+export function logNetieLaunchRefusal(what: string): void {
+  console.warn(
+    `[netie-control] ${NETIE_CREW_LAUNCH_REFUSED_CODE} (${what}): ${NETIE_CREW_LAUNCH_LABEL}`
+  )
+}
+
+/** The fields the upstream spawn and create requests use to mark an agent start. */
+export type NetieAgentStartMarkers = {
+  launchAgent?: unknown
+  startupAgent?: unknown
+  launchConfig?: unknown
+  launchToken?: unknown
+  resumeProviderSession?: unknown
+  agentSessionEnsure?: unknown
+  agentSessionCreateOperationId?: unknown
+  command?: string | null
+  env?: Readonly<Record<string, string | undefined>> | null
+}
+
+/** Names the first marker that makes a request an agent start, or null for a plain shell. */
+export function describeAgentStart(markers: NetieAgentStartMarkers): string | null {
+  for (const key of [
+    'launchAgent',
+    'startupAgent',
+    'launchConfig',
+    'launchToken',
+    'resumeProviderSession',
+    'agentSessionEnsure',
+    'agentSessionCreateOperationId'
+  ] as const) {
+    const value = markers[key]
+    if (value !== undefined && value !== null && value !== false && value !== '') {
+      return key
+    }
+  }
+  const env = markers.env ?? {}
+  if (env.ORCA_AGENT_LAUNCH_TOKEN) {
+    return 'env.ORCA_AGENT_LAUNCH_TOKEN'
+  }
+  // Setup-then-startup sequencing hides the startup command here; only an agent one counts.
+  if (isAgentStartCommand(env.ORCA_SEQUENCED_STARTUP_COMMAND)) {
+    return 'env.ORCA_SEQUENCED_STARTUP_COMMAND'
+  }
+  if (isAgentStartCommand(markers.command)) {
+    return 'command'
+  }
+  return null
+}
+
+/** Throws the labelled refusal when `markers` describe an agent start and launch is off. */
+export function assertNetieAgentStartAllowed(
+  markers: NetieAgentStartMarkers,
+  env: Readonly<Record<string, string | undefined>> = process.env
+): void {
+  if (describeAgentStart(markers) !== null) {
+    assertNetieAgentLaunchAllowed(env)
+  }
+}
diff --git a/src/shared/netie-openvault-endpoint.ts b/src/shared/netie-openvault-endpoint.ts
new file mode 100644
index 00000000..d2d79e34
--- /dev/null
+++ b/src/shared/netie-openvault-endpoint.ts
@@ -0,0 +1,21 @@
+/**
+ * Every model call this app makes goes to OpenVault's OpenAI-compatible `/v1`, the one place
+ * keys live (Netie repo, TAS/TAS-OPENVAULT.md). No provider host is named anywhere else.
+ */
+
+export const NETIE_OPENVAULT_URL_ENV = 'NETIE_OPENVAULT_URL'
+/** The port TAS-OPENVAULT measures for FreeRoute. */
+export const DEFAULT_NETIE_OPENVAULT_URL = 'http://127.0.0.1:5000'
+
+export function resolveOpenVaultBaseUrl(env: Readonly<Record<string, string | undefined>>): string {
+  const raw = env[NETIE_OPENVAULT_URL_ENV]?.trim()
+  return (raw && raw.length > 0 ? raw : DEFAULT_NETIE_OPENVAULT_URL).replace(/\/+$/, '')
+}
+
+/** `${NETIE_OPENVAULT_URL}/v1<path>`; `path` starts with `/`. */
+export function resolveOpenVaultV1Url(
+  path: string,
+  env: Readonly<Record<string, string | undefined>>
+): string {
+  return `${resolveOpenVaultBaseUrl(env)}/v1${path}`
+}
diff --git a/src/shared/netie-worktree-ipc-strip.ts b/src/shared/netie-worktree-ipc-strip.ts
new file mode 100644
index 00000000..2dca0be0
--- /dev/null
+++ b/src/shared/netie-worktree-ipc-strip.ts
@@ -0,0 +1,47 @@
+/**
+ * Netie Control: the worktrees:create IPC side of the workspace-create startup strip. A create whose
+ * startup agent is refused still creates the workspace; only the agent startup fields are dropped and
+ * the label comes back for the create result's warning. Reads process.env at call time by default.
+ * Shared so renderer tests can drive the same function the main IPC handler runs.
+ */
+
+import type { CreateWorktreeArgs, CreateWorktreeResult } from './worktree/create-types'
+import {
+  decideNetieAgentLaunch,
+  describeAgentStart,
+  logNetieLaunchRefusal
+} from './netie-crew-launch-gate'
+
+type Env = Readonly<Record<string, string | undefined>>
+
+/** Appends the label to a create result's warning once. */
+export function withNetieRefusalWarning<T extends Pick<CreateWorktreeResult, 'warning'>>(
+  result: T,
+  label: string | null
+): T {
+  if (!label || result.warning?.includes(label)) {
+    return result
+  }
+  return { ...result, warning: [result.warning, label].filter(Boolean).join(' ') }
+}
+
+/** IPC worktrees:create: drops the renderer's startup agent and its attribution; attribution alone is kept. */
+export function stripRefusedIpcAgentStartup<T extends CreateWorktreeArgs>(
+  args: T,
+  env: Env = process.env
+): { args: T; refusedLabel: string | null } {
+  const decision = decideNetieAgentLaunch(env)
+  // No startup means no terminal inherits createdWithAgent as launchAgent, so nothing starts.
+  const startupIsAgent =
+    args.startup !== undefined &&
+    (args.createdWithAgent !== undefined || describeAgentStart(args.startup) !== null)
+  if (decision.allowed || !startupIsAgent) {
+    return { args, refusedLabel: null }
+  }
+  const stripped: T = { ...args }
+  delete stripped.createdWithAgent
+  delete stripped.pendingFirstAgentMessageRename
+  delete stripped.startup
+  logNetieLaunchRefusal('worktrees:create startup agent')
+  return { args: stripped, refusedLabel: decision.label }
+}
