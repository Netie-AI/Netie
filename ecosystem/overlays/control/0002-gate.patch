+++ b/src/main/netie-control/netie-restart-continuation-label.test.ts
@@ -0,0 +1,142 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  NETIE_CREW_LAUNCH_LABEL as LABEL,
+  NetieCrewLaunchRefusedError
+} from '../../shared/netie-crew-launch-gate'
+import { agentSessionFailureFact } from '../../shared/agent-session-failure'
+import { agentSessionRefusalReference } from '../../shared/agent-session-wire-refusals'
+import {
+  AGENT_SESSION_RESTART_CONTINUATION_REFUSED_NOTE,
+  AGENT_SESSION_RESTART_NOT_CONNECTED_NOTE
+} from '../../shared/agent-session-restart-continuation'
+import { refuseNetieStructuredStart } from '../native-chat/agent-session-wire/structured-agent-session-acquisition'
+import {
+  startStructuredAgentSessionContinuation,
+  type StructuredAgentSessionContinuationDeps
+} from '../native-chat/agent-session-wire/structured-agent-session-restart-continuation'
+import { createStructuredAgentSessionLogger } from '../native-chat/agent-session-wire/structured-agent-session-logger'
+import {
+  marker,
+  SESSION
+} from '../native-chat/agent-session-wire/structured-agent-session-restart-resume-test-harness'
+
+// Netie Control: a restart continuation the launch gate refused says the label in its outcome and chat note.
+
+type Lane = 'send-refusal' | 'start-rejected' | 'send-throws'
+
+/** The host's send: the real gate decides; only an allowed send counts as a started agent. */
+function hostDeps(lane: Lane) {
+  const host = { starts: 0 }
+  const note = vi.fn(async (_sessionId: string, _text: string, _tone?: string) => undefined)
+  const deps: StructuredAgentSessionContinuationDeps = {
+    currentFence: () => 1,
+    send: async () => {
+      const refused = refuseNetieStructuredStart('restart continuation test')
+      if (refused && lane === 'send-refusal') {
+        return { ok: false, refusal: refused.refusal }
+      }
+      if (refused && lane === 'send-throws') {
+        throw new NetieCrewLaunchRefusedError()
+      }
+      if (!refused) {
+        host.starts += 1
+      }
+      return { ok: true, value: { submission: { dispatchState: 'pending' } } }
+    },
+    awaitHandedOver: async () => {
+      const refused = refuseNetieStructuredStart('restart continuation test')
+      return refused
+        ? {
+            dispatchState: 'rejected',
+            rejection: agentSessionFailureFact('startFailed', {
+              refusal: agentSessionRefusalReference(refused.refusal)
+            })
+          }
+        : { dispatchState: 'accepted' }
+    },
+    awaitSettlement: async () => ({ dispatchState: 'accepted' }),
+    note,
+    logger: createStructuredAgentSessionLogger()
+  }
+  return { deps, note, host }
+}
+
+async function continueOnce(deps: StructuredAgentSessionContinuationDeps) {
+  const started = await startStructuredAgentSessionContinuation(deps, SESSION, marker(), 'op-1')
+  return 'done' in started ? started.done : started.verdict()
+}
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+})
+
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+describe('restart continuation under the launch gate', () => {
+  it.each<Lane>(['send-refusal', 'start-rejected', 'send-throws'])(
+    'a %s refusal notes the label, starts nothing and keeps a refusal for the ledger (default off)',
+    async (lane) => {
+      const { deps, note, host } = hostDeps(lane)
+      const outcome = await continueOnce(deps)
+      expect(outcome).toMatchObject({
+        outcome: 'refused',
+        reason: 'structured_agent_session_unsupported',
+        refusal: { code: 'structured_agent_session_unsupported' },
+        message: LABEL
+      })
+      expect(note).toHaveBeenCalledExactlyOnceWith(SESSION, LABEL, 'error')
+      expect(host.starts).toBe(0)
+    }
+  )
+
+  it('under the dev override the continuation goes on and notes no label', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    const { deps, note, host } = hostDeps('send-refusal')
+    const outcome = await continueOnce(deps)
+    expect(outcome).toEqual({ sessionId: SESSION, outcome: 'continued' })
+    expect(host.starts).toBe(1)
+    expect(note).not.toHaveBeenCalledWith(SESSION, LABEL, expect.anything())
+  })
+
+  it('under the dev override a host-disabled start keeps the upstream note', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    const { deps, note } = hostDeps('start-rejected')
+    deps.awaitHandedOver = async () => ({
+      dispatchState: 'rejected',
+      rejection: agentSessionFailureFact('startFailed', {
+        refusal: {
+          code: 'structured_agent_session_unsupported',
+          details: { reason: 'hostDisabled' }
+        }
+      })
+    })
+    const outcome = await continueOnce(deps)
+    expect(outcome).not.toHaveProperty('message')
+    expect(note).toHaveBeenCalledExactlyOnceWith(
+      SESSION,
+      AGENT_SESSION_RESTART_CONTINUATION_REFUSED_NOTE,
+      'error'
+    )
+  })
+
+  it('an ownership refusal keeps its not-connected note (default off)', async () => {
+    const { deps, note } = hostDeps('send-refusal')
+    deps.send = async () => ({
+      ok: false,
+      refusal: { code: 'agent_session_conflict', message: 'owned elsewhere' }
+    })
+    const outcome = await continueOnce(deps)
+    expect(outcome).toEqual({
+      sessionId: SESSION,
+      outcome: 'refused',
+      reason: 'agent_session_conflict'
+    })
+    expect(note).toHaveBeenCalledExactlyOnceWith(
+      SESSION,
+      AGENT_SESSION_RESTART_NOT_CONNECTED_NOTE,
+      'error'
+    )
+  })
+})
diff --git a/src/main/netie-control/netie-restart-continuation-refusal.ts b/src/main/netie-control/netie-restart-continuation-refusal.ts
new file mode 100644
index 00000000..49275704
--- /dev/null
+++ b/src/main/netie-control/netie-restart-continuation-refusal.ts
@@ -0,0 +1,85 @@
+import {
+  isNetieAgentLaunchAllowed,
+  isNetieCrewLaunchRefusedError,
+  NETIE_CREW_LAUNCH_LABEL
+} from '../../shared/netie-crew-launch-gate'
+import {
+  isNetieCrewLaunchRefusal,
+  type AgentSessionRefusalReference
+} from '../../shared/agent-session-wire-refusals'
+
+// Netie Control: a restart continuation the launch gate refused keeps the label for its outcome and chat note.
+
+/** The reference a gate refusal is filed under; the gate's own refusal has these code and details. */
+export const NETIE_RESTART_REFUSAL: AgentSessionRefusalReference = {
+  code: 'structured_agent_session_unsupported',
+  details: { reason: 'hostDisabled' }
+}
+
+function readRefusalFields(value: unknown): {
+  code?: unknown
+  message?: unknown
+  reason?: unknown
+} {
+  if (!value || typeof value !== 'object') {
+    return {}
+  }
+  const details = 'details' in value ? value.details : undefined
+  return {
+    code: 'code' in value ? value.code : undefined,
+    message: 'message' in value ? value.message : undefined,
+    reason:
+      details && typeof details === 'object' && 'reason' in details ? details.reason : undefined
+  }
+}
+
+/** The label when `refusal` (a send refusal, a rejected start's reference or a thrown error) is the gate's; else undefined. */
+export function netieContinuationRefusalLabel(refusal: unknown): string | undefined {
+  if (isNetieCrewLaunchRefusedError(refusal)) {
+    return NETIE_CREW_LAUNCH_LABEL
+  }
+  const { code, message, reason } = readRefusalFields(refusal)
+  if (typeof code !== 'string') {
+    return undefined
+  }
+  if (typeof message === 'string') {
+    return isNetieCrewLaunchRefusal({ code, message }) ? NETIE_CREW_LAUNCH_LABEL : undefined
+  }
+  // A stored reference drops the message; hostDisabled while launch is off is this gate's refusal.
+  return code === NETIE_RESTART_REFUSAL.code &&
+    reason === 'hostDisabled' &&
+    !isNetieAgentLaunchAllowed()
+    ? NETIE_CREW_LAUNCH_LABEL
+    : undefined
+}
+
+/** The outcome fields a gate refusal adds: the label, and with `file` the reference the ledger files. */
+export function refusalOutcome(
+  refusal: unknown,
+  file = false
+): { refusal?: AgentSessionRefusalReference; message?: string } {
+  const message = netieContinuationRefusalLabel(refusal)
+  if (!message) {
+    return {}
+  }
+  return file ? { refusal: NETIE_RESTART_REFUSAL, message } : { message }
+}
+
+type NetieRefusedSend = {
+  ok: false
+  refusal: { code: string; message: string }
+  value?: undefined
+}
+
+/** A send the gate refused by throwing, as the send refusal it stands for: the gate throws before anything starts. */
+export function gatedSend<T>(sending: Promise<T>): Promise<T | NetieRefusedSend> {
+  return sending.catch((error: unknown): NetieRefusedSend => {
+    if (!isNetieCrewLaunchRefusedError(error)) {
+      throw error
+    }
+    return {
+      ok: false,
+      refusal: { code: NETIE_RESTART_REFUSAL.code, message: NETIE_CREW_LAUNCH_LABEL }
+    }
+  })
+}
