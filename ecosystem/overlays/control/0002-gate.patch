+import type { TuiAgent } from '../../../shared/tui-agent'
+import type { CreateWorktreeResult } from '../../../shared/worktree/create-types'
+import type { AppState } from '@/store/types'
+import { getConnectionId } from '@/lib/connection-context'
+import { resolveDirectWorkItemAgent } from '@/lib/launch-work-item-direct-agent-routing'
+import { currentNetieLaunchDecision, netieLaunchPermitted } from '@/lib/netie-crew-launch-notice'
+import { activateAndRevealWorktree } from '@/lib/worktree-activation'
+
+// Netie Control: the work-item launcher gates only the agent half; a plain workspace still opens.
+
+/** True (label shown) when the caller named an agent, so the start is decided before any workspace. */
+export function netieOverrideRefused(agentOverride: TuiAgent | undefined): boolean {
+  return agentOverride !== undefined && !netieLaunchPermitted()
+}
+
+/** True (label shown) when the agent resolved for this workspace would start but may not. */
+export async function netieWorkItemAgentRefused(args: {
+  agentOverride?: TuiAgent
+  worktreeId: string
+  repoConnectionId: string | null
+  detectedAgentsPromise: Promise<string[]> | null
+  latestStore: AppState
+}): Promise<boolean> {
+  if (currentNetieLaunchDecision().allowed) {
+    return false
+  }
+  // Same resolution the launch preparation runs, so blank or undetected agents stay plain and quiet.
+  const selection = await resolveDirectWorkItemAgent({
+    agentOverride: args.agentOverride,
+    launchConnectionId: getConnectionId(args.worktreeId) ?? args.repoConnectionId,
+    repoConnectionId: args.repoConnectionId,
+    detectedAgentsPromise: args.detectedAgentsPromise,
+    latestStore: args.latestStore
+  })
+  if (selection.agent === null || selection.unavailable) {
+    return false
+  }
+  return !netieLaunchPermitted()
+}
+
+/** True when the agent was refused and the created workspace was opened plain (setup, default tabs). */
+export async function netiePlainWorkspace(
+  args: {
+    agentOverride?: TuiAgent
+    result: Pick<CreateWorktreeResult, 'worktree' | 'setup' | 'defaultTabs'>
+    repoConnectionId: string | null
+    detectedAgentsPromise: Promise<string[]> | null
+  },
+  latestStore: AppState
+): Promise<boolean> {
+  const worktreeId = args.result.worktree.id
+  if (!(await netieWorkItemAgentRefused({ ...args, worktreeId, latestStore }))) {
+    return false
+  }
+  activateAndRevealWorktree(worktreeId, {
+    sidebarRevealBehavior: 'auto',
+    setup: args.result.setup,
+    defaultTabs: args.result.defaultTabs
+  })
+  latestStore.setSidebarOpen(true)
+  return true
+}
