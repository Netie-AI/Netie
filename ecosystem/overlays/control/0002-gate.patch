+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: clears the realm slot the renderer launch notice reads.
+  delete (globalThis as unknown as Record<symbol, unknown>)[LAUNCH_SLOT]
+  vi.mocked(toast.message).mockClear()
+  resetNetieColdRestoreDecisionForTest()
+})
+afterEach(async () => {
