+import { currentNetieLaunchDecision } from '@/lib/netie-crew-launch-notice'
+import { readNetieHostLaunchRefusal } from '@/lib/netie-host-launch-refusal'
+
+// Netie Control: the label a failed chat start shows instead of Retry; no refusal while launch is off means the gate refused it.
+export function netieLaunchRetryRefusalLabel(error: unknown, failure: unknown): string | null {
+  const fromHost = readNetieHostLaunchRefusal(error) ?? readNetieHostLaunchRefusal(failure)
+  if (fromHost) {
+    return fromHost
+  }
+  if (failure) {
+    return null
+  }
+  const decision = currentNetieLaunchDecision()
+  return decision.allowed ? null : decision.label
+}
