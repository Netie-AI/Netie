+  data: { label: NETIE_CREW_LAUNCH_LABEL }
+}
+
+type OrchestrationMethod = (typeof ORCHESTRATION_METHODS)[number]
+
+// Why: narrowing by the literal name keeps each handler's own parsed-params type, so no cast is needed.
+function findMethod<TName extends OrchestrationMethod['name']>(name: TName) {
+  const method = ORCHESTRATION_METHODS.find(
+    (candidate): candidate is Extract<OrchestrationMethod, { name: TName }> =>
+      candidate.name === name
+  )
+  if (!method) {
+    throw new Error(`${name} is not registered`)
+  }
+  return method
+}
+
+describe('orchestration.workerStart (workers-new-worktree harness)', () => {
+  const coordinatorPaneKey = 'tab_coord:aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
+  let db: OrchestrationDb
+  let runtime: OrcaRuntimeService
+  let runId: string
+
+  beforeEach(() => {
+    db = new OrchestrationDb(':memory:')
+    runtime = new OrcaRuntimeService()
+    runtime.setOrchestrationDb(db)
+    runId = db.createRun({
+      objective: 'Netie gate workers',
+      coordinatorHandle: 'term_coord',
