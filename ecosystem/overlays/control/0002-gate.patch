@@ -0,0 +1,44 @@
+import {
+  NetieCrewLaunchRefusedError,
+  isNetieAgentLaunchAllowed,
+  logNetieLaunchRefusal
+} from '../../shared/netie-crew-launch-gate'
+import {
+  agentSessionOwners,
+  reconcileAgentSessionOwnerListings
+} from '../ipc/pty/pane/agent-session-owners'
+import { tryGetProviderForAgentSessionOwner } from '../ipc/pty/provider/registry'
+import { isProviderAgentSessionOwnerLive } from '../ipc/pty/provider/liveness'
+import type { RuntimePtySpawnArgs } from '../ipc/pty/runtime/spawn-state'
+
+type EnsureOwner = NonNullable<ReturnType<typeof agentSessionOwners.find>>
+
+/** True only when the owner's provider proves it gone; a missing provider or a failed probe is unknown. */
+async function isOwnerProvenGone(owner: EnsureOwner): Promise<boolean> {
+  const provider = tryGetProviderForAgentSessionOwner(owner.ptyId)
+  if (!provider) {
+    return false
+  }
+  try {
+    return !(await isProviderAgentSessionOwnerLive(provider, owner))
+  } catch {
+    return false
+  }
+}
+
+/** Netie Control: with launch off an ensure may only attach, so no live owner is refused before spawn options (opencode probe). */
+export async function assertNetieRuntimeEnsureHasOwner(
+  args: Pick<RuntimePtySpawnArgs, 'agentSessionEnsure' | 'adoptedStablePane'>,
+  env: Readonly<Record<string, string | undefined>> = process.env
+): Promise<void> {
+  if (!args.agentSessionEnsure || args.adoptedStablePane || isNetieAgentLaunchAllowed(env)) {
+    return
+  }
+  // Why: daemon-backed owners can outlive this controller; import them before calling a claim absent.
+  await reconcileAgentSessionOwnerListings()
+  const owner = agentSessionOwners.find(args.agentSessionEnsure.claim)
+  if (!owner || (await isOwnerProvenGone(owner))) {
+    logNetieLaunchRefusal('agent session ensure without a live owner')
+    throw new NetieCrewLaunchRefusedError()
+  }
+}
diff --git a/src/main/netie-control/netie-stable-pane-gate.ts b/src/main/netie-control/netie-stable-pane-gate.ts
new file mode 100644
index 00000000..e17c343d
--- /dev/null
+++ b/src/main/netie-control/netie-stable-pane-gate.ts
@@ -0,0 +1,104 @@
+/** Netie Control: the fresh-spawn backstop the shared provider.spawn of both PTY funnels runs. */
+
+import type { IPtyProvider, PtySpawnOptions } from '../providers/types'
+import { SessionNotFoundError } from '../daemon/daemon-errors'
+import {
+  assertNetieAgentStartAllowed,
+  describeAgentStart,
+  isNetieAgentLaunchAllowed,
+  logNetieLaunchRefusal,
+  NetieCrewLaunchRefusedError,
+  type NetieAgentStartMarkers
+} from '../../shared/netie-crew-launch-gate'
+
+type NetieAgentStartFields = {
+  command?: string
+  commandDelivery?: 'renderer' | 'provider'
+  startupCommandDelivery?: unknown
+  launchAgent?: unknown
+  launchConfig?: unknown
+  launchToken?: unknown
+  resumeProviderSession?: unknown
+  env?: Record<string, string>
+}
+
+/** Netie Control: true when a caller-named reattach carries an agent start that launch-off must not run. */
+export function isNetieRefusedNamedSessionAgentStart(markers: NetieAgentStartMarkers): boolean {
+  return describeAgentStart(markers) !== null && !isNetieAgentLaunchAllowed()
+}
+
+/** Netie Control: a copy of a reattach request with every agent-start marker removed. */
+export function stripNetieAgentStart<T extends NetieAgentStartFields>(args: T): T {
+  const stripped = { ...args }
+  delete stripped.command
+  delete stripped.commandDelivery
+  delete stripped.startupCommandDelivery
+  delete stripped.launchAgent
+  delete stripped.launchConfig
+  delete stripped.launchToken
+  delete stripped.resumeProviderSession
+  logNetieLaunchRefusal('pty reattach with agent startup; attach only')
+  if (!args.env) {
+    return stripped
+  }
+  const env: Record<string, string> = { ...args.env }
+  delete env.ORCA_AGENT_LAUNCH_TOKEN
+  delete env.ORCA_SEQUENCED_STARTUP_COMMAND
+  return { ...stripped, env }
+}
+
+/** Netie Control: an attach-only reattach whose session is gone surfaces the label, not a bare not-found. */
+export function netieRefusalForGoneSession(error: unknown): unknown {
+  return error instanceof SessionNotFoundError ? new NetieCrewLaunchRefusedError() : error
+}
+
+/** Netie Control backstop: the shared provider.spawn for both funnels never starts an agent while launch is off. */
+export function netieStablePaneFreshSpawnOptions(options: PtySpawnOptions): PtySpawnOptions {
+  const structuredAgentSession =
+    options.agentSessionEnsure !== undefined || options.agentSessionCreateOperationId !== undefined
+  if (options.attachOnly === true) {
+    return options
+  }
+  const namedReattach =
+    typeof options.sessionId === 'string' &&
+    options.sessionId !== '' &&
+    options.isNewSession !== true &&
+    !structuredAgentSession
+  // Why: a named session may be gone, and create-or-attach would then run its agent command.
+  if (namedReattach) {
+    return isNetieRefusedNamedSessionAgentStart(options)
+      ? { ...stripNetieAgentStart(options), attachOnly: true }
+      : options
+  }
+  assertNetieAgentStartAllowed({
+    launchAgent: options.launchAgent,
+    agentSessionEnsure: options.agentSessionEnsure,
+    agentSessionCreateOperationId: options.agentSessionCreateOperationId,
+    command: options.command,
+    env: options.env
+  })
+  return options
+}
+
+/**
+ * Netie Control backstop for the fresh spawn both PTY funnels share (spawnForStablePane): the
+ * provider it is handed refuses an agent start, and turns an attach-only reattach whose session is
+ * gone into the label. Every other provider method passes through untouched.
+ */
+export function netieGuardedProvider(provider: IPtyProvider): IPtyProvider {
+  const spawn: IPtyProvider['spawn'] = async (options) => {
+    const guarded = netieStablePaneFreshSpawnOptions(options)
+    try {
+      return await provider.spawn(guarded)
+    } catch (error) {
+      throw guarded === options ? error : netieRefusalForGoneSession(error)
+    }
+  }
+  return new Proxy(provider, {
+    get: (target, key) =>
+      key === 'spawn'
+        ? spawn
+        : // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: a Proxy get trap receives exactly the keys callers read off IPtyProvider; no provider class uses #private fields.
+          target[key as keyof IPtyProvider]
+  })
+}
