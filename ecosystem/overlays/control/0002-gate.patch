@@ -0,0 +1,344 @@
+/**
+ * Netie Control stage 2 gate (Netie repo, ecosystem/catalog.json row `control`):
+ *   - the board reads ids only, in the netie.control.project_board shape, from a configured URL;
+ *   - agent launches are off until they go through the Crew ticket runner, and the UI says so;
+ *   - the one model call this app makes goes to OpenVault /v1;
+ *   - the operator sees "Netie Control".
+ * Each case imports inside its body so that on a tree without the gate every case fails on its
+ * own instead of the file failing once at import time.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// The upstream suites run under the dev override (config/scripts/vitest-netie-local-launch-override.ts).
+// Every case here starts from the shipped default instead: flag unset, renderer decision unknown.
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+  vi.stubEnv('NETIE_CONTROL_BOARD_URL', '')
+  delete (globalThis as unknown as Record<symbol, unknown>)[
+    Symbol.for('netie.control.launchDecision')
+  ]
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+  vi.unstubAllGlobals()
+})
+
+const PROJECT_BOARD = {
+  product: 'crew-board',
+  cards: [
+    { id: 'p1', status: 'open', ticket_id: 'T1', kind: 'run' },
+    { id: 'T1', status: 'open', ticket_id: 'T1', epic_id: 'E1', kind: 'ticket' },
+    { id: 'E1', status: 'active', tier: 'boundary', kind: 'epic' },
+    { id: 'L1', kind: 'ledger', status: 'appended' },
+    { id: 'R1', kind: 'refusal', reason: 'manifest miss' },
+    { id: 'S-0004', source: 'netie-kb', kind: 'skill' }
+  ]
+}
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json' }
+  })
+}
+
+describe('Netie Control board contract', () => {
+  it('admits the project_board shape and projects ids-only cards the dashboard validator accepts', async () => {
+    const { admitNetieBoard, projectNetieBoardSnapshot } =
+      await import('../../shared/netie-control-board')
+    const { admitDashboardSnapshot } = await import('../ipc/dashboard-payload-validation')
+    const admitted = admitNetieBoard(PROJECT_BOARD)
+    expect(admitted.ok).toBe(true)
+    if (!admitted.ok) {
+      return
+    }
+    const snapshot = projectNetieBoardSnapshot(admitted.board, 1_700_000_000_000, 'test source')
+    expect(snapshot.cards.map((card) => card.paneKey)).toEqual([
+      'netie:run:p1',
+      'netie:ticket:T1',
+      'netie:epic:E1',
+      'netie:ledger:L1',
+      'netie:refusal:R1',
+      'netie:skill:S-0004'
+    ])
+    expect(snapshot.cards.map((card) => card.bucket)).toEqual([
+      'working',
+      'working',
+      'working',
+      'done',
+      'attention',
+      'idle'
+    ])
+    expect(snapshot.cards.every((card) => card.ptyId === null)).toBe(true)
+    const relayed = admitDashboardSnapshot(snapshot)
+    expect(relayed?.droppedCardCount).toBe(0)
+    expect(relayed?.snapshot.sourceLabel).toBe('test source')
+  })
+
+  it('refuses a card that carries a body', async () => {
+    const { admitNetieBoard } = await import('../../shared/netie-control-board')
+    for (const key of ['skill_body', 'transcript', 'prompt']) {
+      const admitted = admitNetieBoard({
+        product: 'crew-board',
+        cards: [{ id: 'p1', kind: 'run', [key]: 'SECRET' }]
+      })
+      expect(admitted).toEqual({ ok: false, refusal: 'index leaked a body' })
+    }
+  })
+
+  it('refuses remote-desktop kinds: Control is not Guacamole', async () => {
+    const { admitNetieBoard } = await import('../../shared/netie-control-board')
+    for (const kind of ['rdp', 'ssh', 'telnet', 'k8s_exec']) {
+      expect(admitNetieBoard({ product: 'crew-board', cards: [{ id: 'p1', kind }] })).toEqual({
+        ok: false,
+        refusal: 'Control is not Guacamole'
+      })
+    }
+  })
+
+  it('refuses a board over the 12k DitchContext budget', async () => {
+    const { admitNetieBoard, NETIE_BOARD_MAX_CHARS } =
+      await import('../../shared/netie-control-board')
+    expect(NETIE_BOARD_MAX_CHARS).toBe(12_000)
+    const cards = Array.from({ length: 400 }, (_, index) => ({
+      id: `ticket-${String(index).padStart(4, '0')}`,
+      kind: 'ticket',
+      status: 'open'
+    }))
+    expect(admitNetieBoard({ product: 'crew-board', cards })).toEqual({
+      ok: false,
+      refusal: 'board over DitchContext'
+    })
+  })
+
+  it('measures the 12k budget on the text Python measures, so non-ASCII cannot slip past', async () => {
+    const { admitNetieBoard, pythonJsonDumps } = await import('../../shared/netie-control-board')
+    expect(pythonJsonDumps({ id: '\u00e9' })).toBe('{"id":"\\u00e9"}')
+    // 2,100 CJK chars: about 2.2k chars as raw JSON, about 12.7k as Python's ensure_ascii dump.
+    const board = {
+      product: 'crew-board',
+      cards: [{ id: 'R1', kind: 'refusal', reason: '\u4e2d'.repeat(2_100) }]
+    }
+    expect(JSON.stringify(board).length).toBeLessThan(12_000)
+    expect(admitNetieBoard(board)).toEqual({ ok: false, refusal: 'board over DitchContext' })
+  })
+
+  it('admits what project_board emits for odd ids: numbers as text, missing ids counted on the label', async () => {
+    const { admitNetieBoard, projectNetieBoardSnapshot } =
+      await import('../../shared/netie-control-board')
+    const admitted = admitNetieBoard({
+      product: 'crew-board',
+      cards: [
+        { id: 42, kind: 'run', status: 'open', ticket_id: null },
+        { id: null, kind: 'run', status: 'open' },
+        { kind: 'ledger', status: 'appended' }
+      ]
+    })
