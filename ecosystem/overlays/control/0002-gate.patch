+    decryptString: (ciphertext: Buffer) => ciphertext.toString('utf-8').slice('encrypted:'.length)
+  }
+}))
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
