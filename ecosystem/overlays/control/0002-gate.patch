diff --git a/src/main/netie-control/netie-control-board-source.ts b/src/main/netie-control/netie-control-board-source.ts
new file mode 100644
index 00000000..c3772a22
--- /dev/null
+++ b/src/main/netie-control/netie-control-board-source.ts
@@ -0,0 +1,89 @@
+/**
+ * Loads the Netie Control board from its configured URL and projects it to the dashboard
+ * snapshot every board surface renders. Unconfigured, unreachable or refused all produce an
+ * empty board whose `sourceLabel` says so: degradation shows in the output.
+ */
+
+import type { DashboardSnapshot } from '../../shared/dashboard-snapshot'
+import {
+  admitNetieBoard,
+  emptyNetieBoardSnapshot,
+  projectNetieBoardSnapshot,
+  resolveNetieBoardSource
+} from '../../shared/netie-control-board'
+import { cancelUnreadResponseBody } from '../lib/unread-response-body'
+import { getMainHttpClient, type MainHttpClient } from '../network/http-client'
+
+/** The renderer republishes several times a second; the board URL is asked at most this often. */
+export const NETIE_BOARD_MIN_REFRESH_MS = 2_000
+const NETIE_BOARD_FETCH_TIMEOUT_MS = 5_000
+const MAX_ERROR_LABEL_LENGTH = 200
+
+type BoardCache = { url: string; at: number; snapshot: DashboardSnapshot }
+let cache: BoardCache | null = null
+
+export function resetNetieBoardSourceCacheForTest(): void {
+  cache = null
+}
+
+function errorLabel(url: string, detail: string): string {
+  return `Netie Control board unreachable at ${url}: ${detail.slice(0, MAX_ERROR_LABEL_LENGTH)}`
+}
+
+async function fetchBoardSnapshot(
+  url: string,
+  now: number,
+  http: Pick<MainHttpClient, 'fetch'>
+): Promise<DashboardSnapshot> {
+  let response: Response
+  try {
+    response = await http.fetch(url, {
+      method: 'GET',
+      headers: { Accept: 'application/json' },
+      signal: AbortSignal.timeout(NETIE_BOARD_FETCH_TIMEOUT_MS)
+    })
+  } catch (error) {
+    return emptyNetieBoardSnapshot(
+      now,
+      errorLabel(url, error instanceof Error ? error.message : String(error))
+    )
+  }
+  if (!response.ok) {
+    await cancelUnreadResponseBody(response)
+    return emptyNetieBoardSnapshot(now, errorLabel(url, `HTTP ${response.status}`))
+  }
+  let payload: unknown
+  try {
+    payload = await response.json()
+  } catch (error) {
+    return emptyNetieBoardSnapshot(
+      now,
+      errorLabel(url, `not JSON (${error instanceof Error ? error.message : String(error)})`)
+    )
+  }
+  const admitted = admitNetieBoard(payload)
+  if (!admitted.ok) {
+    return emptyNetieBoardSnapshot(now, `Netie Control board refused: ${admitted.refusal}`)
+  }
+  return projectNetieBoardSnapshot(admitted.board, now, `Netie Control board: ${url}`)
+}
+
+export async function loadNetieBoardSnapshot(
+  options: {
+    env?: Readonly<Record<string, string | undefined>>
+    now?: number
+    http?: Pick<MainHttpClient, 'fetch'>
+  } = {}
+): Promise<DashboardSnapshot> {
+  const now = options.now ?? Date.now()
+  const source = resolveNetieBoardSource(options.env ?? process.env)
+  if (source.kind === 'unconfigured') {
+    return emptyNetieBoardSnapshot(now, source.label)
+  }
+  if (cache && cache.url === source.url && now - cache.at < NETIE_BOARD_MIN_REFRESH_MS) {
+    return cache.snapshot
+  }
+  const snapshot = await fetchBoardSnapshot(source.url, now, options.http ?? getMainHttpClient())
+  cache = { url: source.url, at: now, snapshot }
+  return snapshot
+}
diff --git a/src/main/netie-control/netie-control-gate.test.ts b/src/main/netie-control/netie-control-gate.test.ts
