diff --git a/src/renderer/src/components/dashboard/useNetieBoardSnapshot.ts b/src/renderer/src/components/dashboard/useNetieBoardSnapshot.ts
new file mode 100644
index 00000000..a8421468
--- /dev/null
+++ b/src/renderer/src/components/dashboard/useNetieBoardSnapshot.ts
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react'
+import {
+  EMPTY_DASHBOARD_SNAPSHOT,
+  type DashboardSnapshot
+} from '../../../../shared/dashboard-snapshot'
+import { NETIE_BOARD_UNCONFIGURED_LABEL } from '../../../../shared/netie-control-board'
+
+const NETIE_BOARD_POLL_MS = 2_000
+
+const PENDING_SNAPSHOT: DashboardSnapshot = {
+  ...EMPTY_DASHBOARD_SNAPSHOT,
+  sourceLabel: NETIE_BOARD_UNCONFIGURED_LABEL
+}
+
+/**
+ * In-window board source. Netie Control reads the board from the host, which fetches the
+ * configured netie.control.project_board URL; the renderer's own agent store is not consulted.
+ */
+export function useNetieBoardSnapshot(): DashboardSnapshot {
+  const [snapshot, setSnapshot] = useState<DashboardSnapshot>(PENDING_SNAPSHOT)
+  useEffect(() => {
+    let disposed = false
+    const refresh = async (): Promise<void> => {
+      const next = await window.api.netieControl?.getBoard().catch(() => null)
+      if (!disposed && next) {
+        setSnapshot(next)
+      }
+    }
+    void refresh()
+    const timer = setInterval(() => void refresh(), NETIE_BOARD_POLL_MS)
+    return () => {
+      disposed = true
+      clearInterval(timer)
+    }
+  }, [])
+  return snapshot
+}
