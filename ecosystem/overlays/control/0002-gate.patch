--- /dev/null
+++ b/src/renderer/src/lib/netie-host-launch-refusal.ts
@@ -0,0 +1,49 @@
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE
+} from '../../../shared/netie-crew-launch-gate'
+import { isNetieCrewLaunchRefusal } from '../../../shared/agent-session-wire-refusals'
+import { showNetieLaunchLabel } from '@/lib/netie-launch-surfaces'
+
+// Netie Control: reads a host's launch-gate answer (createSupport verdict, thrown RPC error or wire refusal).
+
+type NetieHostAnswerFields = { label?: string; code?: string; message?: string }
+
+function stringOrUndefined(value: unknown): string | undefined {
+  return typeof value === 'string' ? value : undefined
+}
+
+function readAnswerFields(value: unknown): NetieHostAnswerFields {
+  if (!value || typeof value !== 'object') {
+    return {}
+  }
+  return {
+    label: 'label' in value ? stringOrUndefined(value.label) : undefined,
+    code: 'code' in value ? stringOrUndefined(value.code) : undefined,
+    message: 'message' in value ? stringOrUndefined(value.message) : undefined
+  }
+}
+
+/** The label when `answer` is the host's launch refusal, else null. Pure: shows nothing. */
+export function readNetieHostLaunchRefusal(answer: unknown): string | null {
+  const { label, code, message } = readAnswerFields(answer)
+  if (label?.includes(NETIE_CREW_LAUNCH_LABEL)) {
+    return label
+  }
+  if (code === NETIE_CREW_LAUNCH_REFUSED_CODE) {
+    return message?.includes(NETIE_CREW_LAUNCH_LABEL) ? message : NETIE_CREW_LAUNCH_LABEL
+  }
+  if (code && isNetieCrewLaunchRefusal({ code, ...(message ? { message } : {}) })) {
+    return NETIE_CREW_LAUNCH_LABEL
+  }
+  return null
+}
+
+/** As `readNetieHostLaunchRefusal`, and the label is shown once when it is one. */
+export function netieHostLaunchRefusalLabel(answer: unknown): string | null {
+  const label = readNetieHostLaunchRefusal(answer)
+  if (label) {
+    showNetieLaunchLabel(label)
+  }
+  return label
+}
