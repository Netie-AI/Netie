+describe('Netie gate: agent session ensure fresh spawn (executeRuntimePtySpawn)', () => {
+  const { createAgentClaimProvider, recoveredAgentClaim, recoveredAgentSurface } =
+    setupPtyIpcSuite()
+  let claimSeq = 0
+
+  function freshClaim() {
+    claimSeq += 1
+    const digit = String.fromCharCode(99 + claimSeq)
+    return { ...recoveredAgentClaim, identityDigest: digit.repeat(43) }
+  }
+
+  function ensureCtx(claim: ReturnType<typeof freshClaim>, provider: unknown) {
+    const reportPtySpawnCommitted = vi.fn()
+    const ctx = {
+      args: {
+        cols: 80,
+        rows: 24,
+        cwd: '/tmp/recovered-worktree',
+        worktreeId: recoveredAgentSurface.worktreeId,
+        agentSessionEnsure: { claim, surface: recoveredAgentSurface }
+      },
+      deps: { runtime: undefined, store: undefined, trustedTerminalHandleEnv: new Set<string>() },
+      provider,
+      spawnOptions: { cols: 80, rows: 24, cwd: '/tmp/recovered-worktree' },
+      reportPtySpawnCommitted,
+      isDaemonHostSpawn: false,
+      isNewDaemonSession: false
+    }
+    // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: the ensure branch reads only these state fields before and after the closure.
+    return { ctx: ctx as unknown as RuntimePtySpawnState, reportPtySpawnCommitted }
+  }
+
+  it('refuses a fresh provider spawn for an unowned claim and spawns nothing', async () => {
+    const spawn = vi.fn(async () => ({ id: 'pty-fresh-agent', incarnationId: 'inc-1' }))
+    const provider = createAgentClaimProvider({ spawn })
+    setLocalPtyProvider(provider as never)
+    const { ctx, reportPtySpawnCommitted } = ensureCtx(freshClaim(), provider)
+    await expect(executeRuntimePtySpawn(ctx)).rejects.toMatchObject(refusal)
+    expect(spawn).not.toHaveBeenCalled()
+    expect(reportPtySpawnCommitted).not.toHaveBeenCalled()
+  })
+
+  it('still attaches to a live owner of the claim with the flag unset', async () => {
+    const claim = freshClaim()
+    const ownerPtyId = 'pty-live-agent-owner'
+    const owner = {
+      claim,
+      generation: 'generation-live',
+      phase: 'live' as const,
+      ptyId: ownerPtyId,
+      surface: recoveredAgentSurface
+    }
+    const spawn = vi.fn(async () => ({ id: 'must-not-spawn' }))
+    const provider = createAgentClaimProvider({
+      spawn,
+      sessions: [
+        {
+          id: ownerPtyId,
+          incarnationId: 'inc-live',
+          cwd: '/tmp/recovered-worktree',
+          title: 'Codex',
+          agentSessionOwners: [owner]
+        }
+      ],
+      livePtyIds: new Set([ownerPtyId])
+    })
+    setLocalPtyProvider(provider as never)
+    const { ctx } = ensureCtx(claim, provider)
+    await executeRuntimePtySpawn(ctx)
+    expect(ctx.result).toMatchObject({ id: ownerPtyId, isReattach: true })
+    expect(spawn).not.toHaveBeenCalled()
+    clearProviderPtyState(ownerPtyId)
+  })
+
+  it('spawns the fresh agent owner under the dev override 1', async () => {
+    devOverride()
+    const spawn = vi.fn(async () => ({ id: 'pty-dev-agent', incarnationId: 'inc-dev' }))
+    // Why: the local owner proves liveness by listing the spawned incarnation.
+    const provider = createAgentClaimProvider({
+      spawn,
+      sessions: [{ id: 'pty-dev-agent', incarnationId: 'inc-dev', cwd: '/tmp', title: 'Codex' }],
+      authoritativeOwnerListings: false
+    })
+    setLocalPtyProvider(provider as never)
+    const { ctx } = ensureCtx(freshClaim(), provider)
+    await executeRuntimePtySpawn(ctx)
+    expect(spawn).toHaveBeenCalledTimes(1)
+    expect(ctx.result).toMatchObject({ id: 'pty-dev-agent' })
+    clearProviderPtyState('pty-dev-agent')
+  })
+})
