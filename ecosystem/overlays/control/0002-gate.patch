+++ b/src/main/netie-control/netie-terminal-agent-start.ts
@@ -0,0 +1,38 @@
+import type { TerminalCreateOptions } from '../runtime/runtime-terminal-contracts'
+import {
+  assertNetieAgentLaunchAllowed,
+  assertNetieAgentStartAllowed,
+  isAgentStartCommand
+} from '../../shared/netie-crew-launch-gate'
+
+/** Netie Control: throws the labelled refusal when terminal create options start an agent and launch is off. */
+export function assertNetieTerminalAgentStartAllowed(
+  opts: TerminalCreateOptions,
+  env: Readonly<Record<string, string | undefined>> = process.env
+): void {
+  // An ensure claim may attach to a live agent session; the PTY ensure-spawn closure refuses a fresh one.
+  if (opts.agentSessionClaim) {
+    return
+  }
+  // Setup sequencing copies any startup (agent or plain) into these two, so judge the command they carry.
+  const { ORCA_SEQUENCED_STARTUP_COMMAND: sequencedStartup, ...otherEnv } = opts.env ?? {}
+  if (
+    isAgentStartCommand(opts.claudeAgentTeamsSourceCommand) ||
+    isAgentStartCommand(sequencedStartup)
+  ) {
+    assertNetieAgentLaunchAllowed(env)
+  }
+  assertNetieAgentStartAllowed(
+    {
+      launchAgent: opts.launchAgent,
+      startupAgent: opts.startupAgent,
+      launchConfig: opts.launchConfig,
+      launchToken: opts.launchToken,
+      resumeProviderSession: opts.resumeProviderSession,
+      agentSessionCreateOperationId: opts.agentSessionCreateOperationId,
+      command: opts.command,
+      env: otherEnv
+    },
+    env
+  )
+}
diff --git a/src/main/netie-control/netie-terminal-line-views.ts b/src/main/netie-control/netie-terminal-line-views.ts
new file mode 100644
index 00000000..facadd34
--- /dev/null
+++ b/src/main/netie-control/netie-terminal-line-views.ts
@@ -0,0 +1,220 @@
+import { isAgentStartCommand } from '../../shared/netie-crew-launch-gate'
+
+// Netie Control: a submitted line is an agent start when any reading of it is (emulated, naive, raw).
+
+type InputEvent =
+  | { kind: 'char'; char: string }
+  | { kind: 'submit' }
+  | { kind: 'cancel' }
+  | { kind: 'paste' }
+  | { kind: 'key'; key: EditKey }
+
+type EditKey =
+  | 'home'
+  | 'end'
+  | 'left'
+  | 'right'
+  | 'backspace'
+  | 'delete'
+  | 'kill-back'
+  | 'kill-fwd'
+  | 'kill-word-back'
+  | 'yank'
+  | 'transpose'
+  | 'tab'
+  | 'opaque'
+
+const ESC = '\x1b'
+// Readline emacs bindings; any other C0 byte is an opaque key the views cannot model.
+const CONTROL_KEYS: Readonly<Record<string, InputEvent>> = {
+  '\r': { kind: 'submit' },
+  '\n': { kind: 'submit' },
+  // C-o is operate-and-get-next in bash: it accepts the line.
+  '\x0f': { kind: 'submit' },
+  '\x03': { kind: 'cancel' },
+  '\x01': { kind: 'key', key: 'home' },
+  '\x05': { kind: 'key', key: 'end' },
+  '\x02': { kind: 'key', key: 'left' },
+  '\x06': { kind: 'key', key: 'right' },
+  '\x08': { kind: 'key', key: 'backspace' },
+  '\x7f': { kind: 'key', key: 'backspace' },
+  '\x04': { kind: 'key', key: 'delete' },
+  '\x15': { kind: 'key', key: 'kill-back' },
+  '\x0b': { kind: 'key', key: 'kill-fwd' },
+  '\x17': { kind: 'key', key: 'kill-word-back' },
+  '\x19': { kind: 'key', key: 'yank' },
+  '\x14': { kind: 'key', key: 'transpose' },
+  '\t': { kind: 'key', key: 'tab' }
+}
+const CSI_FINAL_KEYS: Readonly<Record<string, EditKey>> = {
+  D: 'left',
+  C: 'right',
+  H: 'home',
+  F: 'end'
+}
+const CSI_TILDE_KEYS: Readonly<Record<string, EditKey>> = {
+  '1': 'home',
+  '7': 'home',
+  '4': 'end',
+  '8': 'end',
+  '3': 'delete'
+}
+
+function csiEvent(params: string, final: string): InputEvent {
+  if (final === '~' && (params === '200' || params === '201')) {
+    return { kind: 'paste' }
+  }
+  // Modified keys (word moves, history) carry a ';' and stay opaque.
+  const key = final === '~' ? CSI_TILDE_KEYS[params] : params === '' ? CSI_FINAL_KEYS[final] : null
+  return { kind: 'key', key: key ?? 'opaque' }
+}
+
+// C0 and C1 control bytes; DEL is mapped as backspace above.
+function isControlChar(char: string): boolean {
+  const code = char.charCodeAt(0)
+  return code < 0x20 || (code >= 0x80 && code <= 0x9f)
+}
+
+/** Splits terminal input into keystroke events, each with the offset just past its bytes. */
+export function netieTerminalInputEvents(data: string): { event: InputEvent; end: number }[] {
+  const events: { event: InputEvent; end: number }[] = []
+  let index = 0
+  while (index < data.length) {
+    const char = data[index]!
+    let event: InputEvent
+    let end = index + 1
+    const next = data[index + 1] ?? ''
+    // Why printable only: a CR or other control byte is never swallowed into a sequence.
+    if (char === ESC && next === '[') {
+      end = index + 2
+      while (end < data.length && /[\x20-\x3f]/.test(data[end]!)) {
+        end += 1
+      }
+      const final = /[@-~]/.test(data[end] ?? '') ? data[end]! : ''
+      event = final ? csiEvent(data.slice(index + 2, end), final) : { kind: 'key', key: 'opaque' }
+      end += final ? 1 : 0
+    } else if (char === ESC && next === 'O' && /[\x20-\x7e]/.test(data[index + 2] ?? '')) {
+      event = { kind: 'key', key: CSI_FINAL_KEYS[data[index + 2]!] ?? 'opaque' }
+      end = index + 3
+    } else if (char === ESC) {
+      // Meta keys and vi-mode ESC rewrite the line in ways the views cannot model.
+      event = { kind: 'key', key: 'opaque' }
+      end = /[\x20-\x7e]/.test(next) ? index + 2 : index + 1
+    } else {
+      event =
+        CONTROL_KEYS[char] ??
+        (isControlChar(char) ? { kind: 'key', key: 'opaque' } : { kind: 'char', char })
+    }
+    events.push({ event, end })
+    index = end
+  }
+  return events
+}
+
+/** Every reading of one shell line, built keystroke by keystroke. */
+type LineViews = {
+  emulated: string[]
+  cursor: number
+  kill: string
+  naive: string
+}
+
+function emptyViews(): LineViews {
+  return {
+    emulated: [],
+    cursor: 0,
+    kill: '',
+    naive: ''
+  }
+}
+
+function applyEditKey(line: LineViews, key: EditKey): void {
+  const buffer = line.emulated
+  if (key === 'home') {
+    line.cursor = 0
+  } else if (key === 'end') {
+    line.cursor = buffer.length
+  } else if (key === 'left') {
+    line.cursor = Math.max(0, line.cursor - 1)
+  } else if (key === 'right') {
+    line.cursor = Math.min(buffer.length, line.cursor + 1)
+  } else if (key === 'backspace') {
+    if (line.cursor > 0) {
+      buffer.splice(line.cursor - 1, 1)
+      line.cursor -= 1
+    }
+  } else if (key === 'delete') {
+    buffer.splice(line.cursor, 1)
+  } else if (key === 'kill-back') {
+    line.kill = buffer.splice(0, line.cursor).join('')
+    line.cursor = 0
+  } else if (key === 'kill-fwd') {
+    line.kill = buffer.splice(line.cursor).join('')
+  } else if (key === 'kill-word-back') {
+    let start = line.cursor
+    while (start > 0 && /\s/.test(buffer[start - 1]!)) {
+      start -= 1
+    }
+    while (start > 0 && !/\s/.test(buffer[start - 1]!)) {
+      start -= 1
+    }
+    line.kill = buffer.splice(start, line.cursor - start).join('')
+    line.cursor = start
+  } else if (key === 'yank') {
+    buffer.splice(line.cursor, 0, ...line.kill)
+    line.cursor += line.kill.length
+  } else if (key === 'transpose' && line.cursor > 0 && buffer.length > 1) {
+    const at = line.cursor === buffer.length ? line.cursor - 1 : line.cursor
+    ;[buffer[at - 1], buffer[at]] = [buffer[at]!, buffer[at - 1]!]
+    line.cursor = Math.min(buffer.length, at + 1)
+  }
+}
+
+function applyEvent(line: LineViews, event: InputEvent): void {
+  if (event.kind === 'char') {
+    line.emulated.splice(line.cursor, 0, event.char)
+    line.cursor += 1
+    line.naive += event.char
+    return
+  }
+  if (event.kind !== 'key') {
+    return
+  }
+  if (event.key === 'backspace') {
+    line.naive = line.naive.slice(0, -1)
+  } else if (event.key === 'kill-back') {
+    line.naive = ''
+  }
+  applyEditKey(line, event.key)
+}
+
+/** Splits input into the lines it submits and the raw unsubmitted tail; Ctrl-C discards a line. */
+export function netieSubmittedTerminalLines(data: string): {
+  submitted: LineViews[]
+  tail: string
+} {
+  const submitted: LineViews[] = []
+  let line = emptyViews()
+  let tailStart = 0
+  for (const { event, end } of netieTerminalInputEvents(data)) {
+    if (event.kind === 'submit' || event.kind === 'cancel') {
+      if (event.kind === 'submit') {
+        submitted.push(line)
+      }
+      line = emptyViews()
+      tailStart = end
+    } else {
+      applyEvent(line, event)
+    }
+  }
+  return { submitted, tail: data.slice(tailStart) }
+}
+
+/**
+ * True when the submitted line starts an agent CLI, read both as the raw characters and as
+ * readline would edit them. Deliberately not adversarial: this gate stops the app's own launch
+ * text (resume, plugins, Agent Teams); a person typing is out of scope, so deleted text never counts.
+ */
+export function isNetieSubmittedLineAgentStart(line: LineViews): boolean {
+  return [line.emulated.join(''), line.naive].some((view) => isAgentStartCommand(view))
+}
diff --git a/src/main/netie-control/netie-terminal-send-gate.ts b/src/main/netie-control/netie-terminal-send-gate.ts
new file mode 100644
index 00000000..2bba54cd
--- /dev/null
+++ b/src/main/netie-control/netie-terminal-send-gate.ts
@@ -0,0 +1,157 @@
+import {
+  NetieCrewLaunchRefusedError,
+  isNetieAgentLaunchAllowed,
+  logNetieLaunchRefusal
+} from '../../shared/netie-crew-launch-gate'
+import {
+  isNetieSubmittedLineAgentStart,
+  netieSubmittedTerminalLines
+} from './netie-terminal-line-views'
+
+type Env = Readonly<Record<string, string | undefined>>
+
+// Why caps: a pending line only needs one command; a pane past them refuses its next submit.
+const PENDING_LINE_MAX = 65536
+const PENDING_CANDIDATES_MAX = 4
+const TRACKED_PTYS_MAX = 512
+
+function refuseTerminalSend(what: string): never {
+  logNetieLaunchRefusal(what)
+  throw new NetieCrewLaunchRefusedError()
+}
+
+/** The bytes a runtime terminal action writes, in the order the writer sends them. */
+export function netieTerminalActionData(action: {
+  text?: string
+  enter?: boolean
+  interrupt?: boolean
+}): string {
+  return (action.text ?? '') + (action.enter ? '\r' : '') + (action.interrupt ? '\x03' : '')
+}
+
+/** Netie Control: refuses app-typed terminal input that submits an agent start while launch is off. */
+export function assertNetieTerminalSendAllowed(
+  action: { text?: string; enter?: boolean; interrupt?: boolean },
+  env: Env = process.env
+): void {
+  if (isNetieAgentLaunchAllowed(env)) {
+    return
+  }
+  const { submitted } = netieSubmittedTerminalLines(netieTerminalActionData(action))
+  if (submitted.some(isNetieSubmittedLineAgentStart)) {
+    refuseTerminalSend('terminal send')
+  }
+}
+
+/** Raw unsubmitted input a pane may hold; several candidates when a failed write left it unsure. */
+type PendingLine = { generation: number; candidates: string[]; unknown: boolean }
+
+/** Judges pending plus data; refuses, or returns the pending line the write leaves. */
+function admitTerminalInput(pending: PendingLine, data: string): PendingLine {
+  const tails = new Set<string>()
+  let unknown = pending.unknown
+  for (const candidate of pending.candidates) {
+    const { submitted, tail } = netieSubmittedTerminalLines(candidate + data)
+    if (pending.unknown && submitted.length > 0) {
+      refuseTerminalSend('terminal send (pending line unknown)')
+    }
+    if (submitted.some(isNetieSubmittedLineAgentStart)) {
+      refuseTerminalSend('terminal send')
+    }
+    // A Ctrl-C ends the unknown line without submitting it.
+    unknown &&= tail === candidate + data
+    tails.add(tail)
+  }
+  const candidates = [...tails]
+  if (
+    candidates.length > PENDING_CANDIDATES_MAX ||
+    candidates.some((t) => t.length > PENDING_LINE_MAX)
+  ) {
+    return { generation: pending.generation, candidates: [''], unknown: true }
+  }
+  return { generation: pending.generation, candidates, unknown }
+}
+
+/** Netie Control: one per-pty line view for all runtime sends; launch off also orders each pty's writes. */
+export class NetieTerminalSendTracker {
+  private readonly pendingByPty = new Map<string, PendingLine>()
+  private readonly queueByPty = new Map<string, Promise<void>>()
+
+  private pendingFor(ptyId: string, generation: number): PendingLine {
+    const pending = this.pendingByPty.get(ptyId)
+    // Why the generation: a respawned shell starts with an empty line.
+    return pending && pending.generation === generation
+      ? pending
+      : { generation, candidates: [''], unknown: false }
+  }
+
+  private store(ptyId: string, pending: PendingLine): void {
+    this.pendingByPty.delete(ptyId)
+    if (pending.unknown || pending.candidates.some((candidate) => candidate !== '')) {
+      this.pendingByPty.set(ptyId, pending)
+      if (this.pendingByPty.size > TRACKED_PTYS_MAX) {
+        this.pendingByPty.delete(this.pendingByPty.keys().next().value!)
+      }
+    }
+  }
+
+  /** Runs write once the action is judged against the pty's pending line; refuses with the label. */
+  async write<T>(
+    ptyId: string,
+    generation: number,
+    action: { text?: string; enter?: boolean; interrupt?: boolean },
+    write: () => Promise<T>,
+    env: Env = process.env
+  ): Promise<T> {
+    if (isNetieAgentLaunchAllowed(env)) {
+      return await write()
+    }
+    const previous = this.queueByPty.get(ptyId) ?? Promise.resolve()
+    let release = (): void => {}
+    const done = new Promise<void>((resolve) => (release = resolve))
+    const turn = previous.then(() => done)
+    this.queueByPty.set(ptyId, turn)
+    await previous
+    try {
+      const before = this.pendingFor(ptyId, generation)
+      this.store(ptyId, admitTerminalInput(before, netieTerminalActionData(action)))
+      try {
+        return await write()
+      } catch (error) {
+        // Why both: a failed write may have sent nothing, or its text without the Enter.
+        const typed = admitTerminalInput(before, action.text ?? '')
+        this.store(
+          ptyId,
+          admitTerminalInput(
+            {
+              ...before,
+              candidates: [...before.candidates, ...typed.candidates],
+              unknown: before.unknown || typed.unknown
+            },
+            ''
+          )
+        )
+        throw error
+      }
+    } finally {
+      release()
+      if (this.queueByPty.get(ptyId) === turn) {
+        this.queueByPty.delete(ptyId)
+      }
+    }
+  }
+}
+
+// A person typing live (phone keystroke stream) is not an app launch, so it is not judged. Marked
+// on the action object so the upstream sendTerminal call keeps its exact options.
+type NetieTerminalAction = { text?: string; enter?: boolean; interrupt?: boolean }
+const humanInputActions = new WeakSet<NetieTerminalAction>()
+
+export function markNetieHumanInput<T extends NetieTerminalAction>(action: T): T {
+  humanInputActions.add(action)
+  return action
+}
+
+export function isNetieHumanInput(action: NetieTerminalAction): boolean {
+  return humanInputActions.has(action)
+}
diff --git a/src/main/netie-control/netie-worktree-startup-strip.ts b/src/main/netie-control/netie-worktree-startup-strip.ts
new file mode 100644
index 00000000..a73e97c9
--- /dev/null
+++ b/src/main/netie-control/netie-worktree-startup-strip.ts
@@ -0,0 +1,127 @@
+/**
+ * Netie Control: a workspace create whose startup agent is refused still creates the workspace,
+ * its setup and default tabs. These helpers drop only the agent startup fields and hand back the
+ * label for the create result's warning. Each reads process.env at call time.
+ */
+
+import type { z } from 'zod'
+import type { CreateWorktreeResult } from '../../shared/worktree/create-types'
+import type { RuntimeManagedWorktreeCreateArgs } from '../runtime/runtime-managed-worktree-create-types'
+import type { WorktreeCreate } from '../runtime/rpc/methods/worktree-create-schemas'
+import {
+  decideNetieAgentLaunch,
+  describeAgentStart,
+  logNetieLaunchRefusal
+} from '../../shared/netie-crew-launch-gate'
+import { withNetieRefusalWarning } from '../../shared/netie-worktree-ipc-strip'
+
+// The IPC strip lives in shared so renderer tests drive the same function; re-exported for main callers.
+export {
+  stripRefusedIpcAgentStartup,
+  withNetieRefusalWarning
+} from '../../shared/netie-worktree-ipc-strip'
+
+type Env = Readonly<Record<string, string | undefined>>
+type WorktreeCreateParams = z.infer<typeof WorktreeCreate>
+
+// Every runtime create field that starts or names a startup agent; setup and default tabs are not here.
+const MANAGED_AGENT_STARTUP_FIELDS = [
+  'startupAgent',
+  'startupPrompt',
+  'startupAgentArgs',
+  'startupLaunchPreferences',
+  'startupLaunchSource',
+  'startupDraft',
+  'startupDraftPaste',
+  'createdWithAgent',
+  'pendingFirstAgentMessageRename'
+] as const
+
+function isRequested(value: unknown): boolean {
+  return value !== undefined && value !== null && value !== false && value !== ''
+}
+
+/** Runtime createManagedWorktree: strips every agent startup field, incl. startupDraft's auto-picked agent. */
+export function stripRefusedManagedWorktreeAgentStartup(
+  args: RuntimeManagedWorktreeCreateArgs,
+  env: Env = process.env
+): { args: RuntimeManagedWorktreeCreateArgs; refusedLabel: string | null } {
+  const decision = decideNetieAgentLaunch(env)
+  if (decision.allowed || !managedCreateStartsAgent(args)) {
+    return { args, refusedLabel: null }
+  }
+  const stripped: RuntimeManagedWorktreeCreateArgs = { ...args }
+  for (const key of MANAGED_AGENT_STARTUP_FIELDS) {
+    delete stripped[key]
+  }
+  delete stripped.startup
+  logNetieLaunchRefusal('workspace create startup agent')
+  return { args: stripped, refusedLabel: decision.label }
+}
+
+// createdWithAgent alone is provenance: it only becomes launchAgent on a spawned startup terminal.
+function managedCreateStartsAgent(args: RuntimeManagedWorktreeCreateArgs): boolean {
+  if (args.startup) {
+    // An agent-attributed startup runs as that agent, even when its command is not recognised.
+    return (
+      isRequested(args.createdWithAgent) ||
+      isRequested(args.startupAgent) ||
+      isRequested(args.startupDraftPaste) ||
+      describeAgentStart(args.startup) !== null
+    )
+  }
+  return isRequested(args.startupAgent) || isRequested(args.startupDraft)
+}
+
+/** The runtime create entry's gate: the args to create with, and how to warn on the result. */
+export function netieManagedCreateGate(
+  requested: RuntimeManagedWorktreeCreateArgs,
+  env: Env = process.env
+): {
+  args: RuntimeManagedWorktreeCreateArgs
+  warn: (result: CreateWorktreeResult) => CreateWorktreeResult
+} {
+  const { args, refusedLabel } = stripRefusedManagedWorktreeAgentStartup(requested, env)
+  return { args, warn: (result) => withNetieRefusalWarning(result, refusedLabel) }
+}
+
+/** RPC worktree.create: drops agent fields, and a caller-built startup command when it starts an agent. */
+export function stripRefusedRpcAgentStartup(
+  requested: WorktreeCreateParams,
+  env: Env = process.env
+): { params: WorktreeCreateParams; refusedLabel: string | null } {
+  const decision = decideNetieAgentLaunch(env)
+  if (decision.allowed || !rpcCreateStartsAgent(requested)) {
+    return { params: requested, refusedLabel: null }
+  }
+  const params: WorktreeCreateParams = {
+    ...requested,
+    startupAgent: undefined,
+    createdWithAgent: undefined,
+    startupPrompt: undefined,
+    startupDraft: undefined,
+    launchSource: undefined,
+    startupCommand: undefined,
+    startupEnv: undefined,
+    startupLaunchConfig: undefined,
+    startupCommandDelivery: undefined
+  }
+  logNetieLaunchRefusal('worktree.create startup agent')
+  return { params, refusedLabel: decision.label }
+}
+
+// The runtime builds an agent startup only from startupAgent or startupDraft when no command is given.
+function rpcCreateStartsAgent(requested: WorktreeCreateParams): boolean {
+  if (requested.startupCommand) {
+    return (
+      requested.startupAgent !== undefined ||
+      requested.createdWithAgent !== undefined ||
+      describeAgentStart({
+        command: requested.startupCommand,
+        launchConfig: requested.startupLaunchConfig,
+        env: requested.startupEnv
+      }) !== null
+    )
+  }
+  return requested.startupAgent !== undefined || Boolean(requested.startupDraft)
+}
