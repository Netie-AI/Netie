diff --git a/src/main/netie-control/netie-pty-launch-write.ts b/src/main/netie-control/netie-pty-launch-write.ts
new file mode 100644
index 00000000..afce794a
--- /dev/null
+++ b/src/main/netie-control/netie-pty-launch-write.ts
@@ -0,0 +1,75 @@
+import type { PtyRendererDelivery } from '../ipc/pty/session'
+import type { TerminalInputKind } from '../../shared/terminal-input-kind'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  isNetieAgentLaunchAllowed,
+  logNetieLaunchRefusal
+} from '../../shared/netie-crew-launch-gate'
+import { isNetieAgentStartLine } from './netie-agent-start-line'
+
+const ESC = String.fromCharCode(27)
+
+/** Paste framing (bracketed paste, CSI-u or ESC-CR newlines) becomes a line break so each line is judged. */
+function launchWriteLines(data: string): string {
+  let text = ''
+  for (let index = 0; index < data.length; index += 1) {
+    const char = data[index]!
+    if (char !== ESC) {
+      text += char === '\r' ? '\n' : char
+      continue
+    }
+    if (data[index + 1] === '[') {
+      index += 2
+      while (index < data.length && !/[@-~]/.test(data[index]!)) {
+        index += 1
+      }
+    } else {
+      index += 1
+    }
+    text += '\n'
+  }
+  return text
+}
+
+/** True when an app-written launch input would type an agent CLI start while launch is off. */
+export function isNetieRefusedLaunchWrite(
+  args: { data: string; inputKind: TerminalInputKind },
+  env: Readonly<Record<string, string | undefined>> = process.env
+): boolean {
+  return (
+    args.inputKind === 'launch' &&
+    !isNetieAgentLaunchAllowed(env) &&
+    isNetieAgentStartLine(launchWriteLines(args.data))
+  )
+}
+
+/** Shows the refusal label to the person on the window that wrote. Electron installs it at startup. */
+export type NetieLaunchRefusalNotifier = (window: PtyRendererDelivery, label: string) => void
+
+let launchRefusalNotifier: NetieLaunchRefusalNotifier | null = null
+
+// Why a port: the runtime stays bootable on plain Node, so the dialog lives in src/main/host/.
+export function setNetieLaunchRefusalNotifier(next: NetieLaunchRefusalNotifier | null): void {
+  launchRefusalNotifier = next
+}
+
+function showLaunchRefusalLabel(mainWindow: PtyRendererDelivery | undefined): void {
+  if (!mainWindow || mainWindow.isDestroyed()) {
+    return
+  }
+  launchRefusalNotifier?.(mainWindow, NETIE_CREW_LAUNCH_LABEL)
+}
+
+/** Netie Control: drops a refused launch write and shows the label on the window that sent it. */
+export function refuseNetieLaunchWrite(
+  args: { id: string; data: string; inputKind: TerminalInputKind },
+  mainWindow: PtyRendererDelivery | undefined
+): boolean {
+  if (!isNetieRefusedLaunchWrite(args)) {
+    return false
+  }
+  logNetieLaunchRefusal('pty launch write')
+  // Why not pty:replay: a replay clears the pane and its scrollback before painting.
+  showLaunchRefusalLabel(mainWindow)
+  return true
+}
