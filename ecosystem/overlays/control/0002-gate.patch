+import { toast } from 'sonner'
+import {
+  isNetieCrewLaunchRefusedError,
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE
+} from '../../../shared/netie-crew-launch-gate'
+import { isNetieCrewLaunchRefusal } from '../../../shared/agent-session-wire-refusals'
+import type { CreateWorktreeResult } from '../../../shared/worktree/create-types'
+import type { WorktreeCreationRequest } from '@/lib/pending-worktree-creation'
+import { netieLaunchPermitted } from '@/lib/netie-crew-launch-notice'
+
+// Netie Control: renderer surfaces that start an agent show the launch label here when refused.
+
+/** Shows the label (or a host text that carries it) as one toast that later refusals update. */
+export function showNetieLaunchLabel(text: string = NETIE_CREW_LAUNCH_LABEL): void {
+  toast.message(text, { id: NETIE_CREW_LAUNCH_REFUSED_CODE })
+  console.warn(`[netie-control] ${NETIE_CREW_LAUNCH_REFUSED_CODE}: ${text}`)
+}
+
+/** True (label shown once) when the host's warning refused the startup or the renderer decision refuses it. */
+export function netieCreateStartupRefused(
+  result: Pick<CreateWorktreeResult, 'warning' | 'startupTerminal'>,
+  agentRequested: boolean
+): boolean {
+  if (typeof result.warning === 'string' && result.warning.includes(NETIE_CREW_LAUNCH_LABEL)) {
+    showNetieLaunchLabel(result.warning)
+    return true
+  }
+  if (!agentRequested || result.startupTerminal?.spawned === true) {
+    return false
+  }
+  return !netieLaunchPermitted()
+}
+
+/** The request a create flow continues with: unchanged, or without its agent half when refused. */
+export function netieLaunchRequestAfterCreate(
+  result: Pick<CreateWorktreeResult, 'warning' | 'startupTerminal'>,
+  request: WorktreeCreationRequest
+): WorktreeCreationRequest {
+  const agentRequested = request.agent !== null || request.startupPlan !== null
+  if (!netieCreateStartupRefused(result, agentRequested)) {
+    return request
+  }
+  const plain: WorktreeCreationRequest = {
+    ...request,
+    agent: null,
+    startupPlan: null,
+    quickPrompt: '',
+    quickTelemetry: null,
+    pendingFirstAgentMessageRename: false
+  }
+  delete plain.agentLaunchRoute
+  delete plain.launchDraftPrompt
+  delete plain.promptDelivery
+  return plain
+}
+
+/** A failed model discovery as a host answers it; only a Netie-aware host sends `code`. */
+export type NetieDiscoveryFailure = { error: string; code?: string }
+
+/** True (and the label shown) when a model discovery failure is the host's launch refusal. */
+export function noticeNetieDiscoveryRefusal(failure: NetieDiscoveryFailure): boolean {
+  const refused =
+    failure.code === NETIE_CREW_LAUNCH_REFUSED_CODE ||
+    (typeof failure.error === 'string' && failure.error.includes(NETIE_CREW_LAUNCH_LABEL))
+  if (refused) {
+    showNetieLaunchLabel()
+  }
+  return refused
+}
+
+/** True (and the label shown) when a structured start failed on the host's launch gate. */
+export function noticeNetieStructuredLaunchRefusal(error: unknown): boolean {
+  const refused =
+    isNetieCrewLaunchRefusedError(error) ||
+    (error instanceof Error &&
+      'code' in error &&
+      typeof error.code === 'string' &&
+      isNetieCrewLaunchRefusal({ code: error.code, message: error.message }))
+  if (refused) {
+    showNetieLaunchLabel()
+  }
+  return refused
+}
