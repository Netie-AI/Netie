+/** Netie Control: three surfaces that used to lose the refusal label keep it. */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE,
+  NetieCrewLaunchRefusedError
+} from '../../shared/netie-crew-launch-gate'
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+describe('Netie Control refusal labels', () => {
+  it('refuses orchestration.run before any coordinator run row exists', async () => {
+    const { ORCHESTRATION_GATE_METHODS } =
+      await import('../runtime/rpc/methods/orchestration/gates/gates')
+    const run = ORCHESTRATION_GATE_METHODS.find((method) => method.name === 'orchestration.run')
+    const getOrchestrationDb = vi.fn()
+    expect(() =>
+      run!.handler({ spec: 'x' } as never, { runtime: { getOrchestrationDb } } as never)
+    ).toThrow(NETIE_CREW_LAUNCH_LABEL)
+    expect(getOrchestrationDb).not.toHaveBeenCalled()
+  })
+
+  it('records a refused agent.launch replay as failed without effects, under its own code', async () => {
+    const { launchFailureWithoutEffectsCode } =
+      await import('../runtime/rpc/methods/agent-launch-failure-code')
+    const spawn = { failedBeforeDispatch: () => false } as never
+    expect(
+      launchFailureWithoutEffectsCode(new NetieCrewLaunchRefusedError(), 'create-worktree', spawn)
+    ).toBe(NETIE_CREW_LAUNCH_REFUSED_CODE)
+  })
+
+  it('words a refused structured start with the label, in the person-facing sentence', async () => {
+    const { structuredAgentSessionStartFailure } =
+      await import('../native-chat/agent-session-wire/structured-agent-session-failure-text')
+    const words = structuredAgentSessionStartFailure({
+      refusal: {
+        code: 'structured_agent_session_unsupported',
+        message: NETIE_CREW_LAUNCH_LABEL,
+        details: { reason: 'hostDisabled' }
+      } as never,
+      newSession: true
+    })
+    expect(JSON.stringify(words)).toContain(NETIE_CREW_LAUNCH_LABEL)
+  })
+})
