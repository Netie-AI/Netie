+  it('schedules the agent resume under the dev override decision', async () => {
+    setNetieLaunchDecisionForTest({ allowed: true, via: 'local-launcher-dev-override' })
+    const { apply, spies } = coldRestore(resumeStartup)
+    await apply()
+    expect(spies.applyColdRestoreAgentResumeStartup).toHaveBeenCalledWith(resumeStartup)
+    expect(spies.schedulePendingStartupCommandDelivery).toHaveBeenCalledTimes(1)
+    expect(toast.message).not.toHaveBeenCalled()
+  })
+})
