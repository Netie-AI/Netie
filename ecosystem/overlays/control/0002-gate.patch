@@ -0,0 +1,78 @@
+import { toast } from 'sonner'
+import type { NetieAgentLaunchDecision } from '../../../shared/netie-crew-launch-gate'
+import { currentNetieLaunchDecision } from './netie-crew-launch-notice'
+
+/** The pane session that owns one cold restore; the label shows once per session. */
+export type NetieColdRestoreOwner = { readonly pane: unknown }
+
+const labelledOwners = new WeakSet<NetieColdRestoreOwner>()
+let hostAnswer: NetieAgentLaunchDecision | null = null
+let hostRequest: Promise<NetieAgentLaunchDecision | null> | null = null
+
+/** Asks the host once; runs at module load so the answer is in before any pane connects. */
+export function prefetchNetieColdRestoreLaunchDecision(): Promise<NetieAgentLaunchDecision | null> | null {
+  if (hostAnswer || hostRequest) {
+    return hostRequest
+  }
+  try {
+    const request =
+      typeof window === 'undefined' ? undefined : window.api?.netieControl?.getLaunchDecision()
+    if (!request) {
+      return null
+    }
+    hostRequest = request.then(
+      (decision) => {
+        hostAnswer = decision
+        return decision
+      },
+      () => {
+        hostRequest = null
+        return null
+      }
+    )
+  } catch {
+    hostRequest = null
+  }
+  return hostRequest
+}
+
+export function resetNetieColdRestoreDecisionForTest(): void {
+  hostAnswer = null
+  hostRequest = null
+}
+
+function showLabelOnce(owner: NetieColdRestoreOwner, decision: NetieAgentLaunchDecision): void {
+  if (decision.allowed || labelledOwners.has(owner)) {
+    return
+  }
+  labelledOwners.add(owner)
+  toast.message(decision.label)
+  console.warn(`[netie-control] ${decision.code} (cold-restore agent resume): ${decision.label}`)
+}
+
+/**
+ * Netie Control: a cold restore may not resume an agent while launch is off. Returns the startup
+ * when the host decision allows it, else null. The label shows once per pane session, and only
+ * once the host has answered; a still-pending answer fails closed and labels when it lands.
+ */
+export function netieGatedColdRestoreStartup<T>(
+  owner: NetieColdRestoreOwner,
+  startup: T | null | undefined
+): T | null {
+  if (!startup) {
+    return null
+  }
+  const known = currentNetieLaunchDecision()
+  if (known.allowed || hostAnswer?.allowed) {
+    return startup
+  }
+  const pending = hostAnswer ? null : prefetchNetieColdRestoreLaunchDecision()
+  if (pending) {
+    void pending.then((decision) => showLabelOnce(owner, decision ?? known))
+    return null
+  }
+  showLabelOnce(owner, hostAnswer ?? known)
+  return null
+}
+
+void prefetchNetieColdRestoreLaunchDecision()
