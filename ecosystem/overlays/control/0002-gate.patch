@@ -0,0 +1,47 @@
+import type { AgentSessionWriteFailure } from '../../../shared/agent-session-write-failure'
+import { readNetieHostLaunchRefusal } from '@/lib/netie-host-launch-refusal'
+import { currentNetieLaunchDecision } from '@/lib/netie-crew-launch-notice'
+
+// Netie Control: the label a chat write notice says when the launch gate refused the write's agent start.
+
+function nestedRefusal(source: unknown): unknown {
+  return source && typeof source === 'object' && 'refusal' in source ? source.refusal : undefined
+}
+
+function carriesMessage(value: unknown): boolean {
+  return Boolean(value && typeof value === 'object' && 'message' in value)
+}
+
+function isStrippedHostDisabled(failure: AgentSessionWriteFailure): boolean {
+  if (failure.kind !== 'refused' || failure.code !== 'structured_agent_session_unsupported') {
+    return false
+  }
+  const details: unknown = failure.details
+  return Boolean(
+    details &&
+    typeof details === 'object' &&
+    'reason' in details &&
+    details.reason === 'hostDisabled'
+  )
+}
+
+/** The label when `source` (the raw refusal or error) or `failure` is the gate's refusal, else null. */
+export function netieWriteNoticeLabel(
+  failure: AgentSessionWriteFailure,
+  source?: unknown
+): string | null {
+  const fromHost =
+    readNetieHostLaunchRefusal(source) ??
+    readNetieHostLaunchRefusal(nestedRefusal(source)) ??
+    readNetieHostLaunchRefusal(failure)
+  if (fromHost) {
+    return fromHost
+  }
+  // No host words to read, only a reason: hostDisabled while this app's launch is off is the gate's.
+  const raw = carriesMessage(source) || carriesMessage(nestedRefusal(source))
+  if (!raw && isStrippedHostDisabled(failure)) {
+    const decision = currentNetieLaunchDecision()
+    return decision.allowed ? null : decision.label
+  }
+  return null
+}
