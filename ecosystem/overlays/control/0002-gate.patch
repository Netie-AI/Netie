@@ -0,0 +1,19 @@
+import type { TuiAgent } from '../../../shared/tui-agent'
+import { currentNetieLaunchDecision } from '@/lib/netie-crew-launch-notice'
+
+// Netie Control: a composer create that plans no agent start must not ask the host for one.
+
+/** The agent attribution a create sends; dropped quietly when launch is off and nothing would start. */
+export function netieComposerAgentAttribution(args: {
+  agent: TuiAgent
+  pendingFirstAgentMessageRename: boolean
+  agentStartPlanned: boolean
+}): { createdWithAgent: TuiAgent | undefined; pendingFirstAgentMessageRename: boolean } {
+  if (args.agentStartPlanned || currentNetieLaunchDecision().allowed) {
+    return {
+      createdWithAgent: args.agent,
+      pendingFirstAgentMessageRename: args.pendingFirstAgentMessageRename
+    }
+  }
+  return { createdWithAgent: undefined, pendingFirstAgentMessageRename: false }
+}
