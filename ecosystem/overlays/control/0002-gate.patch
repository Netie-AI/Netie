+/**
+ * Netie Control stage 2, orchestration rest: a refused dispatch --inject, an automatic Coordinator
+ * dispatch, or a scheduled automation tick never submits an agent turn or writes a dispatch row,
+ * and the label reaches the caller, the coordinator log or the folded run record.
+ */
+
+import { mkdtempSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { RpcContext } from '../runtime/rpc/core'
+import { createOrchestrationRpcHarness } from '../runtime/rpc/methods/orchestration/rpc-test-harness'
+import { mapRuntimeError } from '../runtime/rpc/errors'
+import { OrchestrationDb } from '../runtime/orchestration/db'
+import type { OrcaRuntimeService } from '../runtime/orca-runtime'
+import type { CoordinatorRuntime } from '../runtime/orchestration/coordinator-runtime-contract'
+import { dispatchTaskToWorker } from '../runtime/orchestration/coordinator-task-dispatch'
+import { describeScheduledRefusal, NO_DISPATCH_HOST } from '../automations/dispatch-refusal'
+import { AutomationService } from '../automations/service'
+import type { Store } from '../persistence'
+import { closeTestStores, createSqliteTestStore } from '../persistence-test-harness'
+import { installFakeAppEnvironment } from '../../../config/scripts/vitest-host-ports-setup'
+import { removeTreeSync } from '../../shared/windows-transient-lock-removal'
+import type { Repo } from '../../shared/repo-types'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE
+} from '../../shared/netie-crew-launch-gate'
+
+const testState = { dir: '' }
+
+vi.mock('electron', async (importOriginal) => ({
+  ...(await importOriginal<Record<string, unknown>>()),
+  app: { getPath: () => testState.dir },
+  safeStorage: {
+    isEncryptionAvailable: () => true,
+    encryptString: (plaintext: string) => Buffer.from(`encrypted:${plaintext}`, 'utf-8'),
+    decryptString: (ciphertext: Buffer) => ciphertext.toString('utf-8').slice('encrypted:'.length)
+  }
+}))
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+const LABEL_ERROR = {
+  code: NETIE_CREW_LAUNCH_REFUSED_CODE,
+  message: NETIE_CREW_LAUNCH_LABEL,
+  data: { label: NETIE_CREW_LAUNCH_LABEL }
+}
+
+describe('orchestration.dispatch --inject (rpc-test-harness)', () => {
+  const h = createOrchestrationRpcHarness()
+  let db: OrchestrationDb
+  let runtime: OrcaRuntimeService
+  let ctx: RpcContext
+
+  afterEach(() => h.cleanup())
+
+  function setupAgentPane() {
+    ;({ db, runtime, ctx } = h.setup(true))
+    vi.mocked(runtime.getTerminalPaneKey).mockImplementation((candidate) =>
+      candidate === 'term_a' ? 'tab_worker:term_a' : h.coordinatorPaneKey
+    )
+    vi.spyOn(runtime, 'getOrchestrationDispatchAuthority').mockImplementation((candidate) =>
+      candidate === 'term_a'
+        ? ({
+            terminalHandle: 'term_a',
+            paneKey: 'tab_worker:term_a',
+            processIncarnation: 'runtime_test:term_a:1',
+            launchTokenHash: null
+          } as never)
+        : null
+    )
+    const running = vi.spyOn(runtime, 'isTerminalRunningAgent').mockResolvedValue(true)
+    const prompt = vi.spyOn(runtime, 'sendTerminalAgentPrompt').mockResolvedValue({
+      handle: 'term_a',
+      accepted: true,
+      bytesWritten: 1
+    })
+    return { task: db.createTask({ spec: 'do the work' }), running, prompt }
+  }
+
+  it('refuses an injected dispatch with the label, no agent prompt and no dispatch row', async () => {
+    const { task, running, prompt } = setupAgentPane()
+
+    const error = await h
+      .call('orchestration.dispatch', { task: task.id, to: 'term_a', inject: true }, ctx)
+      .catch((caught: unknown) => caught)
+
+    expect(error).toMatchObject(LABEL_ERROR)
+    expect(mapRuntimeError('req_1', { runtimeId: 'runtime-1' }, error)).toMatchObject({
+      ok: false,
+      error: LABEL_ERROR
+    })
+    expect(running).not.toHaveBeenCalled()
+    expect(prompt).not.toHaveBeenCalled()
+    expect(db.getDispatchContext(task.id)).toBeUndefined()
+    expect(db.getTask(task.id)?.status).toBe('ready')
+  })
+
+  it('injects with the dev override flag 1', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    const { task, prompt } = setupAgentPane()
+
+    const result = (await h.call(
+      'orchestration.dispatch',
+      { task: task.id, to: 'term_a', inject: true },
+      ctx
+    )) as { injected: boolean }
+
+    expect(result.injected).toBe(true)
+    expect(prompt).toHaveBeenCalledWith(
+      'term_a',
+      expect.stringContaining('do the work'),
+      expect.anything()
+    )
+    expect(db.getDispatchContext(task.id)).toBeDefined()
+  })
+
+  it('keeps a context-only dispatch (no inject) working with the flag unset', async () => {
+    const { task, prompt } = setupAgentPane()
+
+    const result = (await h.call(
+      'orchestration.dispatch',
+      { task: task.id, to: 'term_a' },
+      ctx
+    )) as {
+      injected: boolean
+      dispatch: { task_id: string }
+    }
+
+    expect(result.injected).toBe(false)
+    expect(result.dispatch.task_id).toBe(task.id)
+    expect(prompt).not.toHaveBeenCalled()
+  })
+
+  it('keeps an injected dry-run preview working with the flag unset', async () => {
+    const { task, prompt } = setupAgentPane()
+
+    const result = (await h.call(
+      'orchestration.dispatch',
+      { task: task.id, to: 'term_a', inject: true, dryRun: true },
+      ctx
+    )) as { dryRun: boolean; preamble: string }
+
+    expect(result.dryRun).toBe(true)
+    expect(result.preamble).toContain('do the work')
+    expect(prompt).not.toHaveBeenCalled()
+    expect(db.getDispatchContext(task.id)).toBeUndefined()
+  })
+})
+
+describe('automatic Coordinator dispatchTaskToWorker', () => {
+  const WORKER_PANE_KEY = 'tab_worker:bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
+  let db: OrchestrationDb
+
+  afterEach(() => db?.close())
+
+  function createRuntime(): CoordinatorRuntime & { prompts: string[] } {
+    const prompts: string[] = []
+    return {
+      prompts,
+      async sendTerminalAgentPrompt(_handle: string, prompt: string) {
+        prompts.push(prompt)
+        return { accepted: true }
+      },
+      async listTerminals() {
+        return { terminals: [] }
+      },
+      async createTerminal() {
+        return { handle: 'term_a', worktreeId: 'wt1' }
+      },
+      async waitForTerminal(handle: string) {
+        return { handle, condition: 'exit' }
+      },
+      async probeWorktreeDrift() {
+        return null
+      },
+      getTerminalPaneKey() {
+        return WORKER_PANE_KEY
+      },
+      getOrchestrationDispatchAuthority() {
+        return { paneKey: WORKER_PANE_KEY, processIncarnation: 'inc-1', launchTokenHash: null }
+      }
+    }
+  }
+
+  function dispatch(runtime: CoordinatorRuntime, taskId: string, logs: string[]) {
+    return dispatchTaskToWorker({
+      db,
+      runtime,
+      task: db.getTask(taskId)!,
+      targetHandle: 'term_a',
+      nestedWorkerMaxDepth: Number.MAX_SAFE_INTEGER,
+      baseDrift: null,
+      coordinatorHandle: 'coord',
+      worktree: undefined,
+      onLog: (message) => logs.push(message),
+      onCircuitBroken: () => undefined
+    })
+  }
+
+  it('refuses with the label before a dispatch row or preamble exists', async () => {
+    db = new OrchestrationDb(':memory:')
+    const task = db.createTask({ runId: 'run_legacy_local', spec: 'do the work' })
+    const runtime = createRuntime()
+
+    // coordinator.ts logs `Failed to dispatch task <id>: ${String(err)}`, so the label is the log line.
+    const error = await dispatch(runtime, task.id, []).catch((caught: unknown) => caught)
+
+    expect(error).toMatchObject({ code: NETIE_CREW_LAUNCH_REFUSED_CODE })
+    expect(String(error)).toContain(NETIE_CREW_LAUNCH_LABEL)
+    expect(runtime.prompts).toEqual([])
+    expect(db.getDispatchContext(task.id)).toBeUndefined()
+    expect(db.getTask(task.id)?.status).toBe('ready')
+  })
+
+  it('dispatches with the dev override flag 1', async () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    db = new OrchestrationDb(':memory:')
+    const task = db.createTask({ runId: 'run_legacy_local', spec: 'do the work' })
+    const runtime = createRuntime()
+
+    await expect(dispatch(runtime, task.id, [])).resolves.toBe('dispatched')
+    expect(runtime.prompts).toHaveLength(1)
+  })
+})
+
+describe('describeScheduledRefusal', () => {
+  const okTarget = { ok: true } as never
+  const goneTarget = { ok: false, error: 'Project is gone.' } as never
+
+  it('returns the label when launch is off, even for a runnable target and a window', () => {
+    expect(describeScheduledRefusal({ target: okTarget, canDispatch: true })).toBe(
+      NETIE_CREW_LAUNCH_LABEL
+    )
+    expect(describeScheduledRefusal({ target: goneTarget, canDispatch: false })).toBe(
+      NETIE_CREW_LAUNCH_LABEL
+    )
+  })
+
+  it('keeps the upstream answers with the dev override flag 1', () => {
+    vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '1')
+    expect(describeScheduledRefusal({ target: okTarget, canDispatch: true })).toBeNull()
+    expect(describeScheduledRefusal({ target: okTarget, canDispatch: false })).toBe(
+      NO_DISPATCH_HOST
+    )
+    expect(describeScheduledRefusal({ target: goneTarget, canDispatch: true })).toBe(
+      'Project is gone.'
+    )
+  })
+})
+
+describe('scheduled automation ticks (AutomationService)', () => {
+  const repo: Repo = { id: 'r1', path: '/repo', displayName: 't', badgeColor: '#fff', addedAt: 1 }
+
+  async function createStore(): Promise<Store> {
+    vi.resetModules()
+    installFakeAppEnvironment({ getPath: () => testState.dir })
+    const { Store: StoreClass, initDataPath } = await import('../persistence')
+    initDataPath()
+    return createSqliteTestStore(StoreClass, { dataFile: join(testState.dir, 'orca-data.json') })
+  }
+
+  async function tick(store: Store, service: AutomationService, id: string, when: string) {
+    const nextRunAt = () => store.listAutomations().find((entry) => entry.id === id)?.nextRunAt
+    const before = nextRunAt()
+    vi.setSystemTime(new Date(when))
+    service.setRendererReady()
+    await vi.waitFor(() => expect(nextRunAt()).toBeGreaterThan(before ?? 0))
+  }
+
+  beforeEach(() => {
+    testState.dir = mkdtempSync(join(tmpdir(), 'netie-gate-orchestration-rest-'))
+    vi.useFakeTimers()
+  })
+
+  afterEach(async () => {
+    await closeTestStores()
+    vi.useRealTimers()
+    removeTreeSync(testState.dir)
+  })
+
+  it('folds repeated scheduled refusals into one labelled row and never dispatches', async () => {
+    vi.setSystemTime(new Date('2026-05-13T08:00:00'))
+    const store = await createStore()
+    store.addRepo(repo)
+    const automation = store.createAutomation({
+      name: 'Nightly check',
+      prompt: 'Check the repo',
+      agentId: 'claude',
+      projectId: 'r1',
+      workspaceMode: 'new_per_run',
+      timezone: 'UTC',
+      rrule: 'FREQ=DAILY;BYHOUR=9;BYMINUTE=0',
+      dtstart: new Date('2026-05-12T00:00:00').getTime()
+    })
+    const send = vi.fn()
+    const service = new AutomationService(store, { tickMs: 60_000 })
+    service.setWebContents({ isDestroyed: () => false, send } as never)
+
+    await tick(store, service, automation.id, '2026-05-13T09:01:00')
+    await tick(store, service, automation.id, '2026-05-14T09:01:00')
+    await tick(store, service, automation.id, '2026-05-15T09:01:00')
+
+    const runs = store.listAutomationRuns(automation.id)
+    expect(runs).toHaveLength(1)
+    expect(runs[0]).toMatchObject({
+      status: 'skipped_unavailable',
+      error: NETIE_CREW_LAUNCH_LABEL,
+      occurrenceCount: 3
+    })
+    expect(send).not.toHaveBeenCalledWith('automations:dispatchRequested', expect.anything())
+  })
+})
