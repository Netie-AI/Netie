+    const spies = {
+      buildColdRestoreAgentResumeStartup: vi.fn(() => startup),
+      applyColdRestoreAgentResumeStartup: vi.fn((prepared: unknown) => prepared !== null),
+      schedulePendingStartupCommandDelivery: vi.fn(),
+      showSessionRestoredBanner: vi.fn(),
+      clearSleepingRecordAfterColdRestoreSpawn: vi.fn()
+    }
+    // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: the cold-restore branch reads only these session members.
+    const session = {
