+    expect(vi.mocked(toast.message).mock.calls).toEqual([[NETIE_CREW_LAUNCH_LABEL]])
+    expect(window.api.pty.ackColdRestore).toHaveBeenCalledWith('pty-1')
+    expect(ctx.reattachPayloadApplied).toBe(true)
+  })
