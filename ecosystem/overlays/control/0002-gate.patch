--- /dev/null
+++ b/src/renderer/src/lib/netie-crew-launch-notice.ts
@@ -0,0 +1,64 @@
+import { toast } from 'sonner'
+import {
+  NETIE_CREW_LAUNCH_LABEL,
+  NETIE_CREW_LAUNCH_REFUSED_CODE,
+  type NetieAgentLaunchDecision
+} from '../../../shared/netie-crew-launch-gate'
+
+/**
+ * The renderer's copy of the host's launch decision. A realm-global slot, like app-environment's,
+ * so a module registry reset cannot quietly hand a fresh module a different answer.
+ */
+const SLOT = Symbol.for('netie.control.launchDecision')
+type Slot = { [SLOT]?: { decision: NetieAgentLaunchDecision; fromHost: boolean } }
+
+const REFUSED: NetieAgentLaunchDecision = {
+  allowed: false,
+  code: NETIE_CREW_LAUNCH_REFUSED_CODE,
+  label: NETIE_CREW_LAUNCH_LABEL
+}
+
+function slot(): Slot {
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: the slot is a symbol key only this module writes.
+  return globalThis as unknown as Slot
+}
+
+export function setNetieLaunchDecisionForTest(next: NetieAgentLaunchDecision | null): void {
+  slot()[SLOT] = next ? { decision: next, fromHost: true } : undefined
+}
+
+function requestDecision(): void {
+  if (slot()[SLOT]?.fromHost) {
+    return
+  }
+  slot()[SLOT] = { decision: REFUSED, fromHost: true }
+  void window.api.netieControl
+    ?.getLaunchDecision()
+    .then((next) => {
+      slot()[SLOT] = { decision: next, fromHost: true }
+    })
+    .catch(() => {
+      slot()[SLOT] = undefined
+    })
+}
+
+/** The decision as currently known, without asking or notifying. Fails closed. */
+export function currentNetieLaunchDecision(): NetieAgentLaunchDecision {
+  requestDecision()
+  return slot()[SLOT]?.decision ?? REFUSED
+}
+
+/**
+ * The renderer half of the Netie Control launch gate: true when the launch may go on. When it
+ * may not, the reason is shown so a user never sees a tab that quietly did nothing. The host
+ * enforces the same decision on every process it starts; this half only spares the round trip.
+ */
+export function netieLaunchPermitted(): boolean {
+  const decision = currentNetieLaunchDecision()
+  if (decision.allowed) {
+    return true
+  }
+  toast.message(decision.label)
+  console.warn(`[netie-control] ${decision.code}: ${decision.label}`)
+  return false
+}
diff --git a/src/renderer/src/lib/netie-host-launch-refusal.ts b/src/renderer/src/lib/netie-host-launch-refusal.ts
