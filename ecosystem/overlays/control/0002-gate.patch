diff --git a/src/renderer/src/lib/netie-automation-run-actions.test.ts b/src/renderer/src/lib/netie-automation-run-actions.test.ts
new file mode 100644
index 00000000..795aace9
--- /dev/null
+++ b/src/renderer/src/lib/netie-automation-run-actions.test.ts
@@ -0,0 +1,114 @@
+/**
+ * Netie Control stage 2, renderer Run Now / Rerun toast: an automation run refused before launch
+ * (skipped_unavailable with the label) shows the label, not 'Automation run queued.'. Drives the real
+ * createAutomationRunActions from automation-run-actions, starting from the shipped default.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { AutomationRun } from '../../../shared/automations-types'
+import { NETIE_CREW_LAUNCH_LABEL } from '../../../shared/netie-crew-launch-gate'
+
+beforeEach(() => {
+  vi.stubEnv('NETIE_CONTROL_ALLOW_LOCAL_LAUNCH', '')
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: clears the realm slot the renderer launch notice reads.
+  delete (globalThis as unknown as Record<symbol, unknown>)[
+    Symbol.for('netie.control.launchDecision')
+  ]
+})
+afterEach(() => {
+  vi.unstubAllEnvs()
+})
+
+describe('renderer Run Now / Rerun toast (automation-run-actions)', () => {
+  const toastMessage = vi.fn()
+  const toastError = vi.fn()
+
+  afterEach(() => {
+    for (const path of [
+      'sonner',
+      '@/i18n/i18n',
+      '@/store',
+      '@/components/automations/automation-target-availability',
+      '@/components/automations/automation-host-client',
+      '@/components/automations/automation-row-action-dispatch',
+      '@/components/automations/automation-run-view-state'
+    ]) {
+      vi.doUnmock(path)
+    }
+    vi.resetModules()
+    toastMessage.mockReset()
+    toastError.mockReset()
+  })
+
+  async function loadActions(returned: Partial<AutomationRun>) {
+    vi.resetModules()
+    vi.doMock('sonner', () => ({ toast: { message: toastMessage, error: toastError } }))
+    vi.doMock('@/i18n/i18n', () => ({ translate: (_key: string, fallback: string) => fallback }))
+    vi.doMock('@/store', () => ({
+      useAppStore: { getState: () => ({ recordFeatureInteraction: vi.fn() }) }
+    }))
+    vi.doMock('@/components/automations/automation-target-availability', () => ({
+      getAutomationTargetAvailability: () => ({ canRunNow: true, message: '' })
+    }))
+    vi.doMock('@/components/automations/automation-host-client', () => ({
+      runAutomationNowForTarget: vi.fn()
+    }))
+    vi.doMock('@/components/automations/automation-row-action-dispatch', () => ({
+      dispatchAutomationRunNow: vi.fn(async () => ({ ok: true, value: returned }))
+    }))
+    vi.doMock('@/components/automations/automation-run-view-state', () => ({
+      waitForAutomationRerunPendingVisibility: vi.fn(async () => undefined)
+    }))
+    const { createAutomationRunActions } =
+      await import('@/components/automations/automation-run-actions')
+    const inFlight = { current: new Set<string>() }
+    const context = {
+      store: {
+        projectHostSetups: [],
+        sshConnectionStates: new Map(),
+        runtimeStatusByEnvironmentId: {},
+        repoForRow: () => null,
+        worktreeForRow: () => null
+      },
+      local: { rerunRunIdsInFlightRef: inFlight, setRerunRunIdsInFlight: vi.fn() },
+      destination: {
+        automationHostTargetFor: () => null,
+        automationDispatchContext: {},
+        reportOwnerAction: vi.fn(),
+        invalidateRowHost: vi.fn()
+      },
+      sourceAvailability: { automationSourceHostAvailabilityByRowKey: new Map() },
+      pageRefresh: { hydratePersistedUIState: vi.fn(), refresh: vi.fn() }
+    }
+    return createAutomationRunActions(context as never)
+  }
+
+  const row = { key: 'row1', automation: { id: 'a1', workspaceId: null } }
+  const refused = { id: 'run1', status: 'skipped_unavailable', error: NETIE_CREW_LAUNCH_LABEL }
+
+  it('shows the label instead of queued when Run Now comes back skipped', async () => {
+    const actions = await loadActions(refused as Partial<AutomationRun>)
+
+    await actions.runNow(row as never)
+
+    expect(toastMessage).toHaveBeenCalledWith(NETIE_CREW_LAUNCH_LABEL)
+    expect(toastMessage).not.toHaveBeenCalledWith('Automation run queued.')
+  })
+
+  it('shows the label instead of queued when Rerun comes back skipped', async () => {
+    const actions = await loadActions(refused as Partial<AutomationRun>)
+
+    await actions.rerunAutomationRun(row as never, { id: 'old_run' } as never)
+
+    expect(toastMessage).toHaveBeenCalledWith(NETIE_CREW_LAUNCH_LABEL)
+    expect(toastMessage).not.toHaveBeenCalledWith('Automation run queued.')
+  })
+
+  it('still says queued for a run that was dispatched', async () => {
+    const actions = await loadActions({ id: 'run1', status: 'dispatching', error: null })
+
+    await actions.runNow(row as never)
+
+    expect(toastMessage).toHaveBeenCalledWith('Automation run queued.')
+  })
+})
