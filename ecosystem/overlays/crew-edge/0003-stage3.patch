+//! Netie Crew Edge stage 3 gate test, channels side (Netie repo, DR-0002).
+//!
+//! Asserts what an operator receives when a cron job or a one-shot send
+//! targets a channel: no OpenVault leave-machine allow, no delivery, and the
+//! refusal names the gate. Uses upstream APIs only so it also compiles on the
+//! stage 2 tree, where both cases fail. The alias carries the reserved id
+//! `netie-gate-turn`, which the test-harness transport forwards to the real
+//! HTTP transport, so nothing answering on the OpenVault URL means a refusal.
+
+use zeroclaw_config::schema::Config;
+
+const REFUSAL_PREFIX: &str = "Refused by Netie gate";
+
+#[tokio::test]
+async fn cron_delivery_without_openvault_leave_is_refused() {
+    let cfg = Config::default();
+    let err = crate::orchestrator::deliver_announcement(&cfg, "telegram.netie-gate-turn", "chat-1", None, "hi")
+        .await
+        .expect_err("delivery must not proceed without a leave-machine allow");
+    assert!(err.to_string().starts_with(REFUSAL_PREFIX), "{err}");
+}
+
+#[tokio::test]
+async fn one_shot_send_without_openvault_leave_is_refused() {
+    let cfg = Config::default();
+    let err = crate::orchestrator::send_channel_message(&cfg, "telegram.netie-gate-turn", "chat-1", "hi")
+        .await
+        .expect_err("a one-shot send must not proceed without a leave-machine allow");
+    assert!(format!("{err:#}").contains(REFUSAL_PREFIX), "{err:#}");
+}
