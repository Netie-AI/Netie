+    assert!(err.to_string().starts_with(REFUSAL_PREFIX), "{err}");
+    // A Console key still builds: vendor providers stay selectable.
+    assert!(
+        zeroclaw_providers::factory::dispatch_family_factory(
+            None,
+            "anthropic",
+            "work",
+            Some("sk-ant-test-console-key"),
+            None,
+            &zeroclaw_providers::ModelProviderRuntimeOptions::default(),
+        )
+        .is_ok()
+    );
+}
