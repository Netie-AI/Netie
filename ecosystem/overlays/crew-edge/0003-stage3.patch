+#[test]
+fn shipped_cli_strings_say_crew_edge() {
+    for key in [
+        "cli-about",
+        "cli-config-about",
+        "cli-status-title",
+        "cli-security-status-title",
+        "cli-daemon-started-title",
+    ] {
+        let text = crate::i18n::get_required_cli_string(key);
+        assert!(text.contains("Crew Edge"), "{key} = {text}");
+        // `cli-about` also credits the upstream by name, as attribution requires.
+        if key != "cli-about" {
+            assert!(!text.contains("ZeroClaw"), "{key} = {text}");
+        }
+    }
+    // The update command names upstream releases and says installing is off.
+    let update = crate::i18n::get_required_cli_string("cli-update-about");
+    assert!(update.contains("disabled in Crew Edge"), "{update}");
+}
