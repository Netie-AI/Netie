+#[test]
+fn stored_codex_login_is_refused_at_request_time() {
+    let mut cfg = Config::default();
+    cfg.providers.models.openai.insert(
+        "coding".into(),
+        zeroclaw_config::schema::OpenAIModelProviderConfig {
+            base: zeroclaw_config::schema::ModelProviderConfig {
+                requires_openai_auth: true,
+                model: Some("gpt-5.4".into()),
+                ..Default::default()
+            },
+        },
+    );
+    let out = zeroclaw_providers::factory::dispatch_family_factory(
+        Some(&cfg),
+        "openai",
+        "coding",
+        None,
+        None,
+        &zeroclaw_providers::ModelProviderRuntimeOptions::default(),
+    );
+    let err = out.err().expect("a stored Codex login must not build a provider");
+    assert!(err.to_string().starts_with(REFUSAL_PREFIX), "{err}");
+    let legacy = zeroclaw_providers::create_model_provider("openai-codex", Some("k"));
+    let err = legacy.err().expect("the legacy Codex spelling must be refused");
+    assert!(err.to_string().starts_with(REFUSAL_PREFIX), "{err}");
+}
