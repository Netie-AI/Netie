+//! Netie Crew Edge stage 2 gate test (Netie repo, DR-0002 rule 5).
+//!
+//! Asserts what an operator receives, not internals: the provider list and
+//! field rows Quickstart shows, the config file Quickstart writes (re-read from
+//! disk with the real loader), the tool outcome the model sees, the session
+//! record on disk under the default config, and the channel picker labels.
+//! It uses upstream APIs only, so it also compiles on the stage 1 tree, where
+//! every case fails. Constants are spelled out on purpose for that reason.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use async_trait::async_trait;
+use zeroclaw_api::tool::Tool;
+use zeroclaw_config::presets::{
+    AgentIdentity, BuilderSubmission, MemoryChoice, ModelProviderChoice, SelectorChoice,
+};
+use zeroclaw_config::schema::Config;
+
+use crate::agent::tool_execution::{ToolDispatchContext, execute_one_tool};
+use crate::observability::noop::NoopObserver;
+use crate::quickstart::{FieldSection, apply, field_shape, snapshot_state};
+
+const REFUSAL_PREFIX: &str = "Refused by Netie gate";
+const SUBSCRIPTION_LOGIN_FAMILIES: &[&str] = &["copilot", "gemini_cli", "grok_cli", "kilocli"];
+
+fn openvault_v1() -> String {
+    let base = std::env::var("NETIE_OPENVAULT_URL")
+        .ok()
+        .map(|s| s.trim().trim_end_matches('/').to_string())
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| "http://127.0.0.1:5000".to_string());
+    format!("{base}/v1")
+}
+
+fn submission(provider_type: &str, alias: &str, model: &str, fields: &[(&str, &str)]) -> BuilderSubmission {
+    BuilderSubmission {
+        model_provider: SelectorChoice::Fresh(ModelProviderChoice {
+            provider_type: provider_type.into(),
+            alias: alias.into(),
+            model: model.into(),
+            fields: fields
+                .iter()
+                .map(|(k, v)| ((*k).to_string(), (*v).to_string()))
+                .collect(),
+        }),
+        risk_profile: SelectorChoice::Fresh("balanced".into()),
+        runtime_profile: SelectorChoice::Fresh("balanced".into()),
+        memory: SelectorChoice::Fresh(MemoryChoice::Sqlite),
+        channels: vec![],
+        peer_groups: vec![],
+        agent: AgentIdentity {
+            name: "crew".into(),
+            system_prompt: "You are helpful.".into(),
+            personality_file: None,
+            personality_files: vec![],
+        },
+    }
+}
+
+async fn apply_in_temp(sub: BuilderSubmission) -> (tempfile::TempDir, Result<String, Vec<String>>) {
+    let dir = tempfile::tempdir().unwrap();
+    let mut config = Config {
+        config_path: dir.path().join("config.toml"),
+        data_dir: dir.path().join("data"),
+        ..Default::default()
+    };
+    config.save().await.unwrap();
+    let out = apply(sub, &mut config)
+        .await
+        .map(|applied| applied.model_provider)
+        .map_err(|errs| errs.into_iter().map(|e| e.message).collect());
+    (dir, out)
+}
+
+fn reload_raw(dir: &tempfile::TempDir) -> toml::Value {
+    let raw = std::fs::read_to_string(dir.path().join("config.toml")).unwrap();
+    let _typed: Config = toml::from_str(&raw).expect("on-disk config must load");
+    toml::from_str(&raw).unwrap()
+}
+
+#[test]
+fn quickstart_lists_openvault_first() {
+    let state = snapshot_state(&Config::default());
+    let first = &state.model_provider_types[0];
+    assert_eq!(first.kind, "custom", "first offered provider is {first:?}");
+    assert!(first.display_name.contains("OpenVault"), "{first:?}");
+}
