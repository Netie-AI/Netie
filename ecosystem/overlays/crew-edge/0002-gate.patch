@@ -0,0 +1,478 @@
+//! Netie Crew Edge gate (DR-0002 rules 5 and 6).
+//!
+//! Rust port of the shapes in the Netie repo's `scripts/crew_ov_gate.py`,
+//! `scripts/crew_tool_wrap.py` and `scripts/space_leave.py`:
+//!
+//! - Model calls go to one OpenAI-compatible endpoint, OpenVault
+//!   `${NETIE_OPENVAULT_URL}/v1`. OpenVault holds every key; Crew Edge holds none.
+//! - Every tool call asks OpenVault `POST /api/crew/gate` with ids only
+//!   (`kind, id, intent, parent_run_id, child_id, deficit`). No arguments, no
+//!   prompt, no transcript. Missing URL, transport failure or a body without
+//!   `allowed: true` is a refusal, shown to the model and the operator.
+//! - Channels other than the local CLI leave the machine, so each one needs an
+//!   OpenVault leave-machine allow before it starts.
+//! - Providers and tools that reuse an end user's subscription login are off.
+//!
+//! See `NETIE-ATTRIBUTION.md` for what is and is not wired yet.
+
+use serde::Serialize;
+use serde_json::Value;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::time::Duration;
+
+/// Environment variable naming the OpenVault base URL (without `/v1`).
+pub const OPENVAULT_URL_ENV: &str = "NETIE_OPENVAULT_URL";
+/// Default OpenVault base URL (Netie `TAS/TAS-OPENVAULT.md`: FreeRoute is `:5000/v1`).
+pub const DEFAULT_OPENVAULT_URL: &str = "http://127.0.0.1:5000";
+/// Config family the OpenVault entry is written under: `[providers.models.custom.<alias>]`.
+pub const OPENVAULT_FAMILY: &str = "custom";
+/// Quickstart input accepted for "the Netie default provider".
+pub const OPENVAULT_QUICKSTART_INPUT: &str = "openvault";
+/// Picker label for the `custom` family in Crew Edge.
+pub const OPENVAULT_DISPLAY_NAME: &str = "OpenVault (Netie default, holds every key)";
+/// Default model id for the OpenVault entry: OpenVault picks from its own catalog.
+pub const OPENVAULT_DEFAULT_MODEL: &str = "auto";
+
+/// Model-provider families that reuse an end user's subscription login
+/// (GitHub Copilot, Gemini CLI, Grok CLI, KiloCLI). DR-0002 rule 6.
+pub const SUBSCRIPTION_LOGIN_FAMILIES: &[&str] = &["copilot", "gemini_cli", "grok_cli", "kilocli"];
+/// Quickstart auth modes that reuse a subscription login (Codex, Claude setup-token).
+pub const SUBSCRIPTION_LOGIN_AUTH_MODES: &[&str] = &["codex", "setup_token"];
+/// Tools that drive another vendor's CLI on the end user's login. Always refused.
+pub const SUBSCRIPTION_LOGIN_TOOLS: &[&str] = &[
+    "claude_code",
+    "claude_code_runner",
+    "codex_cli",
+    "gemini_cli",
+    "opencode_cli",
+];
+
+/// Keys that must never ride a gate ask, a tool payload or a checkpoint.
+pub const DROP_KEYS: &[&str] = &["skill_body", "prompt", "instructions", "transcript"];
+/// Same set as OpenVault `ACCESS_KINDS` (`skill` is not registered yet).
+pub const REGISTERED_KINDS: &[&str] = &["memory", "api", "component", "runtime", "model", "service"];
+/// Known writes that need `operator_confirm: true` (HITL), same set as `crew_tool_wrap.py`.
+pub const HITL_WRITES: &[&str] = &["export_pptx", "item.intake", "amend.apply", "call_action"];
+/// Gate kind a tool invocation is asked under. Assumed, not measured against a
+/// live OpenVault: see `NETIE-ATTRIBUTION.md`.
+pub const TOOL_GATE_KIND: &str = "runtime";
+/// Run id channel leave-machine asks are filed under.
+pub const CHANNEL_GATE_PARENT_RUN: &str = "crew-edge.channels";
+/// Channel kinds that stay on the machine and need no leave-machine allow.
+pub const LOCAL_CHANNELS: &[&str] = &["cli"];
+/// Label appended to every channel the operator can pick in Quickstart.
+pub const CHANNEL_OFF_LABEL: &str = " (off until OpenVault leave-machine allows it)";
+/// Prefix of every refusal this gate returns.
+pub const REFUSAL_PREFIX: &str = "Refused by Netie gate";
+
+#[must_use]
+pub fn is_subscription_login_family(family: &str) -> bool {
+    let f = family.trim();
+    SUBSCRIPTION_LOGIN_FAMILIES
+        .iter()
+        .any(|x| x.eq_ignore_ascii_case(f))
+}
+
+#[must_use]
+pub fn is_subscription_login_tool(name: &str) -> bool {
+    let n = name.trim();
+    SUBSCRIPTION_LOGIN_TOOLS.iter().any(|x| *x == n)
+}
+
+/// OpenVault base URL from the environment, no trailing slash.
+#[must_use]
+pub fn openvault_base_url() -> String {
+    std::env::var(OPENVAULT_URL_ENV)
+        .ok()
+        .map(|s| s.trim().trim_end_matches('/').to_string())
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| DEFAULT_OPENVAULT_URL.to_string())
+}
+
+/// `${NETIE_OPENVAULT_URL}/v1`.
+#[must_use]
+pub fn openvault_v1_url() -> String {
+    format!("{}/v1", openvault_base_url())
+}
+
+/// The provider list Crew Edge surfaces offer: subscription-login families
+/// removed, the OpenVault (`custom`) entry first and labeled. The upstream
+/// registry (`list_model_providers`) stays complete so its slot-parity tests
+/// keep their meaning; this is the list an operator picks from.
+#[must_use]
+pub fn gated_model_providers() -> Vec<crate::ModelProviderInfo> {
+    let mut out: Vec<crate::ModelProviderInfo> = crate::list_model_providers()
+        .into_iter()
+        .filter(|info| !is_subscription_login_family(info.name))
+        .map(|mut info| {
+            if info.name == OPENVAULT_FAMILY {
+                info.display_name = OPENVAULT_DISPLAY_NAME;
+            }
+            info
+        })
+        .collect();
+    if let Some(pos) = out.iter().position(|info| info.name == OPENVAULT_FAMILY) {
+        let openvault = out.remove(pos);
+        out.insert(0, openvault);
+    }
+    out
+}
+
+/// True if a payload still carries a skill body, prompt or transcript.
+#[must_use]
+pub fn has_bodies(value: &Value) -> bool {
+    match value {
+        Value::Object(map) => map
+            .iter()
+            .any(|(k, v)| DROP_KEYS.contains(&k.as_str()) || has_bodies(v)),
+        Value::Array(items) => items.iter().any(has_bodies),
+        _ => false,
+    }
+}
+
+fn carries_skill_body(value: &Value) -> bool {
+    match value {
+        Value::Object(map) => map
+            .iter()
+            .any(|(k, v)| k == "skill_body" || carries_skill_body(v)),
+        Value::Array(items) => items.iter().any(carries_skill_body),
+        _ => false,
+    }
+}
+
+/// Ids and status only: drop every body key, recursively.
+#[must_use]
+pub fn strip_bodies(value: &Value) -> Value {
+    match value {
+        Value::Object(map) => Value::Object(
+            map.iter()
+                .filter(|(k, _)| !DROP_KEYS.contains(&k.as_str()))
+                .map(|(k, v)| (k.clone(), strip_bodies(v)))
+                .collect(),
+        ),
+        Value::Array(items) => Value::Array(items.iter().map(strip_bodies).collect()),
+        other => other.clone(),
+    }
+}
+
+/// Body of `POST /api/crew/gate`. Ids only.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct GateAsk {
+    pub kind: String,
+    pub id: String,
+    pub intent: String,
+    pub parent_run_id: String,
+    pub child_id: String,
+    pub deficit: String,
+}
+
+pub type GateFuture = Pin<Box<dyn Future<Output = Result<Value, String>> + Send>>;
+
+/// How a gate ask reaches OpenVault. The shipped default is HTTP. Tests can
+/// scope their own for one task with [`with_gate_transport`].
+pub trait GateTransport: Send + Sync {
+    fn post(&self, url: String, body: Value) -> GateFuture;
+    /// Short name, so a test can assert which transport is the default.
+    fn label(&self) -> &'static str {
+        "custom"
+    }
+}
+
+struct HttpTransport;
+
+/// The shipped transport: `POST` JSON with a 10 s timeout.
+#[must_use]
+pub fn http_transport() -> Arc<dyn GateTransport> {
+    Arc::new(HttpTransport)
+}
+
+impl GateTransport for HttpTransport {
+    fn label(&self) -> &'static str {
+        "http"
+    }
+    fn post(&self, url: String, body: Value) -> GateFuture {
+        Box::pin(async move {
+            let client = reqwest::Client::builder()
+                .timeout(Duration::from_secs(10))
+                .build()
+                .map_err(|e| e.to_string())?;
+            let resp = client
+                .post(&url)
+                .json(&body)
+                .send()
+                .await
+                .map_err(|e| e.to_string())?;
+            resp.json::<Value>().await.map_err(|e| e.to_string())
+        })
+    }
+}
+
+tokio::task_local! {
+    static TRANSPORT_OVERRIDE: Arc<dyn GateTransport>;
+}
+
+/// Run `fut` with `transport` answering every gate ask made inside it.
+pub async fn with_gate_transport<F: Future>(transport: Arc<dyn GateTransport>, fut: F) -> F::Output {
+    TRANSPORT_OVERRIDE.scope(transport, fut).await
+}
+
+static PROCESS_DEFAULT: std::sync::OnceLock<Arc<dyn GateTransport>> = std::sync::OnceLock::new();
+
+fn transport() -> Arc<dyn GateTransport> {
+    TRANSPORT_OVERRIDE
+        .try_with(Arc::clone)
+        .ok()
+        .or_else(|| PROCESS_DEFAULT.get().cloned())
+        .unwrap_or_else(http_transport)
+}
+
+/// Label of the transport a gate ask made here would use.
+#[must_use]
+pub fn active_transport_label() -> &'static str {
+    transport().label()
+}
+
+/// Run id reserved for the Netie gate test. The test-harness transport
+/// forwards asks under it to the real HTTP transport, so the gate test
+/// exercises the shipped path while the upstream suites run unchanged.
+pub const GATE_TEST_RUN_ID: &str = "netie-gate-turn";
+
+struct TestHarnessTransport;
+
+impl GateTransport for TestHarnessTransport {
+    fn label(&self) -> &'static str {
+        "test-harness"
+    }
+    fn post(&self, url: String, body: Value) -> GateFuture {
+        if body.get("parent_run_id").and_then(Value::as_str) == Some(GATE_TEST_RUN_ID) {
+            return HttpTransport.post(url, body);
+        }
+        Box::pin(async { Ok(serde_json::json!({"allowed": true, "location": "test-harness"})) })
+    }
+}
+
+/// Test harness only. Upstream unit suites run tools and channels with no
+/// OpenVault listening; this makes the process default allow every ask so
+/// those suites keep testing upstream behavior. Called only from code under
+/// `cfg(any(test, feature = "test-util"))`. A shipped build never calls it,
+/// so its default stays [`http_transport`]. The ask is still built and
+/// checked (ids only) before it reaches this transport.
+#[doc(hidden)]
+pub fn install_test_harness_transport() {
+    let _ = PROCESS_DEFAULT.set(Arc::new(TestHarnessTransport));
+}
+
+/// Ask OpenVault. Fail closed: unknown kind, a body key, transport failure,
+/// a non-object reply or anything but `allowed: true` is `Err(reason)`.
+pub async fn crew_gate_allow(ask: &GateAsk) -> Result<Value, String> {
+    let kind = ask.kind.trim();
+    if !REGISTERED_KINDS.contains(&kind) {
+        return Err(format!("no {kind} registered as '{}'", ask.id));
+    }
+    let payload = serde_json::to_value(ask).map_err(|e| e.to_string())?;
+    if has_bodies(&payload) {
+        return Err("skill_body must never go to the gate".to_string());
+    }
+    let url = format!("{}/api/crew/gate", openvault_base_url());
+    let raw = transport()
+        .post(url, payload)
+        .await
+        .map_err(|e| format!("OpenVault crew_gate unreachable: {e}"))?;
+    let body = strip_bodies(&raw);
+    let Some(obj) = body.as_object() else {
+        return Err("OpenVault crew_gate returned non-object".to_string());
+    };
+    if obj.get("allowed") != Some(&Value::Bool(true)) {
+        let reason = obj
+            .get("reason")
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+            .unwrap_or("OpenVault refused");
+        return Err(reason.to_string());
+    }
+    Ok(body)
+}
+
+/// The only Crew Edge tool path: refuses before execution unless OpenVault
+/// allows this tool id for this run. Arguments are checked, never sent.
+pub async fn gate_tool_call(
+    tool: &str,
+    args: &Value,
+    parent_run_id: &str,
+    child_id: &str,
+) -> Result<(), String> {
+    let name = tool.trim();
+    if name.is_empty() {
+        return Err("empty tool name".to_string());
+    }
+    if is_subscription_login_tool(name) {
+        return Err(format!(
+            "{name} drives another vendor's CLI on the user's login (DR-0002 rule 6)"
+        ));
+    }
+    // Arguments stay on the machine (they are never put in the gate ask), so
+    // a `prompt` argument is a legitimate tool input (delegate, spawn_subagent,
+    // cron_add take one). A skill body is not: skills are passed by id.
+    if carries_skill_body(args) {
+        return Err("skill_body must never go to a tool; pass a skill id".to_string());
+    }
+    if HITL_WRITES.contains(&name) && args.get("operator_confirm") != Some(&Value::Bool(true)) {
+        return Err("HITL: write needs operator_confirm".to_string());
+    }
+    let pid = parent_run_id.trim();
+    let cid = child_id.trim();
+    if pid.is_empty() || cid.is_empty() {
+        return Err("tool call needs parent and child run ids".to_string());
+    }
+    crew_gate_allow(&GateAsk {
+        kind: TOOL_GATE_KIND.to_string(),
+        id: name.to_string(),
+        intent: "invoke".to_string(),
+        parent_run_id: pid.to_string(),
+        child_id: cid.to_string(),
+        deficit: String::new(),
+    })
+    .await
+    .map(|_| ())
+}
+
+/// Leave-machine ask for one channel instance (`space_leave.py` shape).
+/// Local channels pass without an ask.
+pub async fn gate_channel_leave(channel_kind: &str, alias: &str) -> Result<(), String> {
+    let kind = channel_kind.trim().to_ascii_lowercase();
+    if LOCAL_CHANNELS.contains(&kind.as_str()) {
+        return Ok(());
+    }
+    let child = if alias.trim().is_empty() {
+        kind.clone()
+    } else {
+        format!("{kind}.{}", alias.trim())
+    };
+    crew_gate_allow(&GateAsk {
+        kind: "service".to_string(),
+        id: format!("channel.{kind}"),
+        intent: "leave".to_string(),
+        parent_run_id: CHANNEL_GATE_PARENT_RUN.to_string(),
+        child_id: child,
+        deficit: String::new(),
+    })
+    .await
+    .map(|_| ())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    struct Recorder {
+        reply: Value,
+        seen: Mutex<Vec<(String, Value)>>,
+    }
+
+    impl GateTransport for Recorder {
+        fn post(&self, url: String, body: Value) -> GateFuture {
+            self.seen.lock().unwrap().push((url, body));
+            let reply = self.reply.clone();
+            Box::pin(async move { Ok(reply) })
+        }
+    }
+
+    fn recorder(reply: Value) -> Arc<Recorder> {
+        Arc::new(Recorder {
+            reply,
+            seen: Mutex::new(Vec::new()),
+        })
+    }
+
+    #[test]
+    fn gated_list_has_openvault_first_and_no_subscription_login_family() {
+        let gated = gated_model_providers();
+        assert_eq!(gated[0].name, OPENVAULT_FAMILY);
+        assert_eq!(gated[0].display_name, OPENVAULT_DISPLAY_NAME);
+        for family in SUBSCRIPTION_LOGIN_FAMILIES {
+            assert!(gated.iter().all(|info| info.name != *family), "{family}");
+        }
+        assert_eq!(
+            gated.len(),
+            crate::list_model_providers().len() - SUBSCRIPTION_LOGIN_FAMILIES.len()
+        );
+    }
+
+    #[test]
+    fn shipped_default_transport_is_http() {
+        assert_eq!(active_transport_label(), "http");
+    }
+
+    #[tokio::test]
+    async fn prompt_argument_stays_local_and_is_not_sent() {
+        let rec = recorder(serde_json::json!({"allowed": true}));
+        let args = serde_json::json!({"agent": "a", "prompt": "SECRET-TASK"});
+        let out = with_gate_transport(rec.clone(), gate_tool_call("delegate", &args, "t", "c")).await;
+        assert_eq!(out, Ok(()));
+        assert!(!rec.seen.lock().unwrap()[0].1.to_string().contains("SECRET-TASK"));
+    }
+
+    #[test]
+    fn bodies_are_detected_and_stripped_recursively() {
+        let v = serde_json::json!({"id": "a", "nested": [{"prompt": "x"}]});
+        assert!(has_bodies(&v));
+        assert_eq!(strip_bodies(&v), serde_json::json!({"id": "a", "nested": [{}]}));
+    }
+
+    #[tokio::test]
+    async fn allowed_tool_posts_ids_only() {
+        let rec = recorder(serde_json::json!({"allowed": true, "location": "local"}));
+        let args = serde_json::json!({"command": "ls -la /secret"});
+        let out = with_gate_transport(rec.clone(), gate_tool_call("shell", &args, "turn-1", "call-1")).await;
+        assert_eq!(out, Ok(()));
+        let seen = rec.seen.lock().unwrap();
+        assert_eq!(seen.len(), 1);
+        assert!(seen[0].0.ends_with("/api/crew/gate"), "{}", seen[0].0);
+        assert_eq!(
+            seen[0].1,
+            serde_json::json!({"kind": "runtime", "id": "shell", "intent": "invoke",
+                "parent_run_id": "turn-1", "child_id": "call-1", "deficit": ""})
+        );
+        assert!(!seen[0].1.to_string().contains("/secret"));
+    }
+
+    #[tokio::test]
+    async fn refusals_fail_closed_and_show_the_reason() {
+        let deny = recorder(serde_json::json!({"allowed": false, "reason": "not in seat"}));
+        let out = with_gate_transport(deny, gate_tool_call("shell", &Value::Null, "t", "c")).await;
+        assert_eq!(out, Err("not in seat".to_string()));
+
+        let odd = recorder(serde_json::json!({"allowed": "yes"}));
+        assert!(with_gate_transport(odd, gate_tool_call("shell", &Value::Null, "t", "c")).await.is_err());
+
+        let never = recorder(serde_json::json!({"allowed": true}));
+        for (tool, args) in [
+            ("claude_code", serde_json::json!({})),
+            ("shell", serde_json::json!({"nested": {"skill_body": "..."}})),
+            ("call_action", serde_json::json!({})),
+            ("", serde_json::json!({})),
+        ] {
+            let out = with_gate_transport(never.clone(), gate_tool_call(tool, &args, "t", "c")).await;
+            assert!(out.is_err(), "{tool} must refuse before asking");
+        }
+        assert!(never.seen.lock().unwrap().is_empty(), "no ask may be sent for a pre-refusal");
+        let out = with_gate_transport(never.clone(), gate_tool_call("shell", &Value::Null, "", "c")).await;
+        assert!(out.is_err());
+    }
+
+    #[tokio::test]
+    async fn channel_leave_asks_service_kind_and_cli_stays_local() {
+        let rec = recorder(serde_json::json!({"allowed": true}));
+        assert_eq!(with_gate_transport(rec.clone(), gate_channel_leave("cli", "")).await, Ok(()));
+        assert!(rec.seen.lock().unwrap().is_empty());
+        assert_eq!(with_gate_transport(rec.clone(), gate_channel_leave("telegram", "work")).await, Ok(()));
+        let seen = rec.seen.lock().unwrap();
+        assert_eq!(seen[0].1["kind"], "service");
+        assert_eq!(seen[0].1["id"], "channel.telegram");
+        assert_eq!(seen[0].1["intent"], "leave");
+        assert_eq!(seen[0].1["child_id"], "telegram.work");
+    }
+}
