@@ -0,0 +1,238 @@
+//! Netie Crew Edge: session state persists ids only (Netie `scripts/crew_checkpoint.py`).
+//!
+//! Wraps a real backend. Every message written through it keeps its role and
+//! loses its text: the stored content is a fixed marker plus a short sha256 of
+//! the text, so a record can be matched against a ledger but a prompt or reply
+//! cannot be recovered from disk. Resume after a restart therefore sees markers,
+//! not the conversation. That is the token-cheap, transcript-free gate.
+//! Selected by `session_backend = "ids-only"` (the Crew Edge default).
+
+use std::sync::Arc;
+
+use sha2::{Digest, Sha256};
+use zeroclaw_api::model_provider::ChatMessage;
+
+use crate::session_backend::{
+    SessionBackend, SessionContext, SessionMetadata, SessionQuery, SessionState,
+    TimestampedMessage,
+};
+
+/// Config value that selects this backend.
+pub const IDS_ONLY_BACKEND: &str = "ids-only";
+/// Prefix of every stored message body.
+pub const IDS_ONLY_MARKER: &str = "[netie ids-only]";
+
+/// Stored body for one message: marker, role and the first 16 hex chars of sha256(text).
+#[must_use]
+pub fn ids_only_content(message: &ChatMessage) -> String {
+    let digest = Sha256::digest(message.content.as_bytes());
+    let short: String = digest.iter().take(8).map(|b| format!("{b:02x}")).collect();
+    format!("{IDS_ONLY_MARKER} role={} sha256={short}", message.role)
+}
+
+fn ids_only(message: &ChatMessage) -> ChatMessage {
+    ChatMessage {
+        role: message.role.clone(),
+        content: ids_only_content(message),
+    }
+}
+
+fn ids_only_all(messages: &[ChatMessage]) -> Vec<ChatMessage> {
+    messages.iter().map(ids_only).collect()
+}
+
+/// Session backend that persists ids only.
+pub struct IdsOnlySessionBackend {
+    inner: Arc<dyn SessionBackend>,
+}
+
+impl IdsOnlySessionBackend {
+    #[must_use]
+    pub fn new(inner: Arc<dyn SessionBackend>) -> Self {
+        Self { inner }
+    }
+}
+
+impl SessionBackend for IdsOnlySessionBackend {
+    fn load(&self, session_key: &str) -> Vec<ChatMessage> {
+        self.inner.load(session_key)
+    }
+
+    fn try_load(&self, session_key: &str) -> std::io::Result<Vec<ChatMessage>> {
+        self.inner.try_load(session_key)
+    }
+
+    fn load_with_timestamps(&self, session_key: &str) -> Vec<TimestampedMessage> {
+        self.inner.load_with_timestamps(session_key)
+    }
+
+    fn append(&self, session_key: &str, message: &ChatMessage) -> std::io::Result<()> {
+        self.inner.append(session_key, &ids_only(message))
+    }
+
+    fn remove_last(&self, session_key: &str) -> std::io::Result<bool> {
+        self.inner.remove_last(session_key)
+    }
+
+    fn rewrite_messages(&self, session_key: &str, messages: &[ChatMessage]) -> std::io::Result<()> {
+        self.inner.rewrite_messages(session_key, &ids_only_all(messages))
+    }
+
+    fn update_last(&self, session_key: &str, message: &ChatMessage) -> std::io::Result<bool> {
+        self.inner.update_last(session_key, &ids_only(message))
+    }
+
+    fn list_sessions(&self) -> Vec<String> {
+        self.inner.list_sessions()
+    }
+
+    fn list_sessions_with_metadata(&self) -> Vec<SessionMetadata> {
+        self.inner.list_sessions_with_metadata()
+    }
+
+    fn compact(&self, session_key: &str) -> std::io::Result<()> {
+        self.inner.compact(session_key)
+    }
+
+    fn cleanup_stale(&self, ttl_hours: u32) -> std::io::Result<usize> {
+        self.inner.cleanup_stale(ttl_hours)
+    }
+
+    fn search(&self, query: &SessionQuery) -> Vec<SessionMetadata> {
+        self.inner.search(query)
+    }
+
+    fn clear_messages(&self, session_key: &str) -> std::io::Result<usize> {
+        self.inner.clear_messages(session_key)
+    }
+
+    fn delete_session(&self, session_key: &str) -> std::io::Result<bool> {
+        self.inner.delete_session(session_key)
+    }
+
+    fn clear_agent_attribution(&self, agent_alias: &str) -> std::io::Result<usize> {
+        self.inner.clear_agent_attribution(agent_alias)
+    }
+
+    fn rename_agent_attribution(&self, from: &str, to: &str) -> std::io::Result<usize> {
+        self.inner.rename_agent_attribution(from, to)
+    }
+
+    fn count_agent_attribution(&self, agent_alias: &str) -> std::io::Result<usize> {
+        self.inner.count_agent_attribution(agent_alias)
+    }
+
+    fn session_exists(&self, session_key: &str) -> bool {
+        self.inner.session_exists(session_key)
+    }
+
+    fn set_session_name(&self, session_key: &str, name: &str) -> std::io::Result<()> {
+        self.inner.set_session_name(session_key, name)
+    }
+
+    fn get_session_name(&self, session_key: &str) -> std::io::Result<Option<String>> {
+        self.inner.get_session_name(session_key)
+    }
+
+    fn set_session_agent_alias(&self, session_key: &str, agent_alias: &str) -> std::io::Result<()> {
+        self.inner.set_session_agent_alias(session_key, agent_alias)
+    }
+
+    fn get_session_agent_alias(&self, session_key: &str) -> std::io::Result<Option<String>> {
+        self.inner.get_session_agent_alias(session_key)
+    }
+
+    fn set_session_trim_breadcrumb(&self, session_key: &str, present: bool) -> std::io::Result<()> {
+        self.inner.set_session_trim_breadcrumb(session_key, present)
+    }
+
+    fn get_session_trim_breadcrumb(&self, session_key: &str) -> std::io::Result<Option<bool>> {
+        self.inner.get_session_trim_breadcrumb(session_key)
+    }
+
+    fn replace_conversation_state(&self, session_key: &str, messages: &[ChatMessage], breadcrumb_present: bool) -> std::io::Result<()> {
+        self.inner.replace_conversation_state(session_key, &ids_only_all(messages), breadcrumb_present)
+    }
+
+    fn replace_conversation_state_if_exists(&self, session_key: &str, messages: &[ChatMessage], breadcrumb_present: bool) -> std::io::Result<bool> {
+        self.inner.replace_conversation_state_if_exists(session_key, &ids_only_all(messages), breadcrumb_present)
+    }
+
+    fn set_session_context(&self, session_key: &str, context: SessionContext<'_>) -> std::io::Result<()> {
+        self.inner.set_session_context(session_key, context)
+    }
+
+    fn get_session_metadata(&self, session_key: &str) -> Option<SessionMetadata> {
+        self.inner.get_session_metadata(session_key)
+    }
+
+    fn set_session_principal(&self, session_key: &str, principal_id: &str) -> std::io::Result<()> {
+        self.inner.set_session_principal(session_key, principal_id)
+    }
+
+    fn delete_session_owned(&self, session_key: &str, owner_principal_id: &str) -> std::io::Result<bool> {
+        self.inner.delete_session_owned(session_key, owner_principal_id)
+    }
+
+    fn set_session_state(&self, session_key: &str, state: &str, turn_id: Option<&str>) -> std::io::Result<()> {
+        self.inner.set_session_state(session_key, state, turn_id)
+    }
+
+    fn get_session_state(&self, session_key: &str) -> std::io::Result<Option<SessionState>> {
+        self.inner.get_session_state(session_key)
+    }
+
+    fn list_running_sessions(&self) -> Vec<SessionMetadata> {
+        self.inner.list_running_sessions()
+    }
+
+    fn list_stuck_sessions(&self, threshold_secs: u64) -> Vec<SessionMetadata> {
+        self.inner.list_stuck_sessions(threshold_secs)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stored_records_hold_no_message_text() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let backend = crate::make_session_backend(dir.path(), IDS_ONLY_BACKEND).unwrap();
+        backend.append("s1", &ChatMessage::user("NEEDLE-USER-TEXT")).unwrap();
+        backend.append("s1", &ChatMessage::assistant("NEEDLE-REPLY")).unwrap();
+        backend
+            .rewrite_messages("s2", &[ChatMessage::user("NEEDLE-REWRITE")])
+            .unwrap();
+        backend.update_last("s2", &ChatMessage::user("NEEDLE-UPDATE")).unwrap();
+        let loaded = backend.load("s1");
+        assert_eq!(loaded.len(), 2);
+        assert_eq!(loaded[0].role, "user");
+        assert!(loaded[0].content.starts_with(IDS_ONLY_MARKER), "{}", loaded[0].content);
+        for msg in backend.load("s2") {
+            assert!(!msg.content.contains("NEEDLE"));
+        }
+        drop(backend);
+        for entry in walk(dir.path()) {
+            let bytes = std::fs::read(&entry).unwrap();
+            assert!(
+                !String::from_utf8_lossy(&bytes).contains("NEEDLE"),
+                "{} holds message text",
+                entry.display()
+            );
+        }
+    }
+
+    fn walk(dir: &std::path::Path) -> Vec<std::path::PathBuf> {
+        let mut out = Vec::new();
+        for entry in std::fs::read_dir(dir).unwrap().flatten() {
+            let path = entry.path();
+            if path.is_dir() {
+                out.extend(walk(&path));
+            } else {
+                out.push(path);
+            }
+        }
+        out
+    }
+}
