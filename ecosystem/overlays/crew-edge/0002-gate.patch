+#[tokio::test]
+async fn quickstart_refuses_a_key_on_the_openvault_entry() {
+    let uri = openvault_v1();
+    let (dir, out) = apply_in_temp(submission(
+        "custom",
+        "openvault",
+        "auto",
+        &[("uri", uri.as_str()), ("api_key", "sk-should-not-be-stored")],
+    ))
+    .await;
+    assert!(out.is_err(), "a key was accepted: {out:?}");
+    let text = std::fs::read_to_string(dir.path().join("config.toml")).unwrap();
+    assert!(!text.contains("sk-should-not-be-stored"));
+}
