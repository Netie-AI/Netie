+#[tokio::test]
+async fn quickstart_offers_no_subscription_login_family() {
+    let state = snapshot_state(&Config::default());
+    for family in SUBSCRIPTION_LOGIN_FAMILIES {
+        assert!(
+            state.model_provider_types.iter().all(|p| p.kind != *family),
+            "{family} is offered"
+        );
+    }
+    let (_dir, out) = apply_in_temp(submission("copilot", "gh", "gpt-5", &[])).await;
+    assert!(out.is_err(), "copilot was accepted: {out:?}");
+}
+
+#[tokio::test]
+async fn quickstart_openvault_writes_one_endpoint_and_no_key() {
+    let (dir, out) = apply_in_temp(submission("openvault", "openvault", "auto", &[])).await;
+    assert_eq!(out, Ok("custom.openvault".to_string()));
+    let raw = reload_raw(&dir);
+    let models = raw["providers"]["models"].as_table().expect("providers.models");
+    assert_eq!(models.keys().collect::<Vec<_>>(), vec!["custom"], "{models:?}");
+    let custom = models["custom"].as_table().unwrap();
+    assert_eq!(custom.keys().collect::<Vec<_>>(), vec!["openvault"]);
+    let entry = custom["openvault"].as_table().unwrap();
+    assert_eq!(entry["uri"].as_str(), Some(openvault_v1().as_str()));
+    assert_eq!(entry["model"].as_str(), Some("auto"));
+    assert!(!entry.contains_key("api_key"), "{entry:?}");
+    let text = std::fs::read_to_string(dir.path().join("config.toml")).unwrap();
+    assert!(!text.contains("api_key"), "config holds a key field:\n{text}");
+}
