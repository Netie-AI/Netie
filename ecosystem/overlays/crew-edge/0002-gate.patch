+#[test]
+fn openvault_field_rows_ask_for_no_key() {
+    let rows = field_shape(FieldSection::ModelProvider, "openvault");
+    let uri = rows.iter().find(|r| r.key == "uri").expect("uri row");
+    assert_eq!(uri.default.as_deref(), Some(openvault_v1().as_str()));
+    assert!(rows.iter().all(|r| r.key != "api_key" && !r.is_secret), "{rows:?}");
+}
+
+struct ProbeTool {
+    name: &'static str,
+    runs: Arc<AtomicUsize>,
+}
+
+impl zeroclaw_api::attribution::Attributable for ProbeTool {
+    fn role(&self) -> zeroclaw_api::attribution::Role {
+        zeroclaw_api::attribution::Role::System
+    }
+    fn alias(&self) -> &str {
+        "netie-probe"
+    }
+}
+
+#[async_trait]
+impl Tool for ProbeTool {
+    fn name(&self) -> &str {
+        self.name
+    }
+    fn description(&self) -> &str {
+        "Counts executions for the Netie gate test"
+    }
+    fn parameters_schema(&self) -> serde_json::Value {
+        serde_json::json!({"type": "object", "properties": {}})
+    }
+    async fn execute(&self, _args: serde_json::Value) -> anyhow::Result<crate::tools::ToolResult> {
+        self.runs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::tools::ToolResult {
+            success: true,
+            output: "ran".into(),
+            error: None,
+        })
+    }
+}
+
+async fn run_probe(name: &'static str) -> (usize, crate::agent::tool_execution::ToolExecutionOutcome) {
+    let runs = Arc::new(AtomicUsize::new(0));
+    let registry = crate::tools::scoped::ScopedToolRegistry::from_raw_for_test(vec![Box::new(ProbeTool {
+        name,
+        runs: Arc::clone(&runs),
+    })]);
+    let meta = crate::agent::turn::TurnMeta {
+        parent_agent_alias: None,
+        agent_alias: Some("crew"),
+        turn_id: "netie-gate-turn",
+        channel_name: "cli",
+    };
+    let outcome = execute_one_tool(
+        name,
+        serde_json::json!({}),
+        Some("netie-gate-call"),
+        ToolDispatchContext {
+            tools_registry: &registry,
+            activated_tools: None,
+            excluded_tools: &[],
+            model_switch_callback: None,
+        },
+        &meta,
+        &NoopObserver,
+        None,
+        None,
+        None,
+    )
+    .await
+    .expect("a refusal is an outcome, not an error");
+    (runs.load(Ordering::SeqCst), outcome)
+}
+
+/// Needs nothing answering on the OpenVault URL. The run id `netie-gate-turn`
+/// is forwarded to the real HTTP transport even under the test harness. If a
+/// live OpenVault there allows `runtime/netie_probe_tool`, this fails loudly.
+#[tokio::test]
+async fn tool_without_openvault_allow_does_not_run() {
+    let (runs, outcome) = run_probe("netie_probe_tool").await;
+    assert_eq!(runs, 0, "tool ran without an OpenVault verdict");
+    assert!(!outcome.success);
+    assert!(outcome.output.starts_with(REFUSAL_PREFIX), "{}", outcome.output);
+}
+
+#[tokio::test]
+async fn subscription_login_tool_never_runs() {
+    let (runs, outcome) = run_probe("claude_code").await;
+    assert_eq!(runs, 0);
+    assert!(outcome.output.starts_with(REFUSAL_PREFIX), "{}", outcome.output);
+}
+
+#[test]
+fn default_session_record_holds_no_text() {
+    let cfg: Config = toml::from_str("").expect("empty config loads with defaults");
+    let dir = tempfile::tempdir().unwrap();
+    let backend = zeroclaw_infra::make_session_backend(dir.path(), &cfg.channels.session_backend).unwrap();
+    backend
+        .append("cli_user", &zeroclaw_api::model_provider::ChatMessage::user("NETIE-PROMPT-NEEDLE"))
+        .unwrap();
+    backend
+        .append("cli_user", &zeroclaw_api::model_provider::ChatMessage::assistant("NETIE-REPLY-NEEDLE"))
+        .unwrap();
+    assert_eq!(backend.load("cli_user").len(), 2, "ids and roles still persist");
+    drop(backend);
+    let mut stack = vec![dir.path().to_path_buf()];
+    while let Some(path) = stack.pop() {
+        if path.is_dir() {
+            stack.extend(std::fs::read_dir(&path).unwrap().flatten().map(|e| e.path()));
+        } else {
+            let bytes = std::fs::read(&path).unwrap();
+            assert!(
+                !String::from_utf8_lossy(&bytes).contains("NEEDLE"),
+                "{} holds conversation text (session_backend = {:?})",
+                path.display(),
+                cfg.channels.session_backend
+            );
+        }
+    }
+}
+
+#[test]
+fn channels_are_labeled_off_until_openvault_leave() {
+    let state = snapshot_state(&Config::default());
+    assert!(state.channel_types.len() >= 30, "{}", state.channel_types.len());
+    for ch in &state.channel_types {
+        assert!(
+            ch.display_name.contains("OpenVault leave-machine"),
+            "{} is not labeled",
+            ch.display_name
+        );
+    }
+}
