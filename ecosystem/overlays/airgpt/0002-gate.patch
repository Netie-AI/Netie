+/**
+ * AirGPT stage 2 gate (Netie DR-0002, ecosystem/overlays/airgpt/0002-gate.patch).
+ *
+ * AirGPT is a thin client of OpenVault and Cortex. It holds no provider key and
+ * talks to no vendor directly. This test reads the two default config files the
+ * operator actually copies (librechat.example.yaml and .env.example) and proves:
+ *
+ *   1. the yaml parses under the real configSchema and exposes exactly one model
+ *      endpoint, the OpenVault custom endpoint at ${NETIE_OPENVAULT_URL}/v1;
+ *   2. cross-chat and user memory is disabled by default;
+ *   3. .env.example enables only `custom,agents`, names the OpenVault URL, and
+ *      carries no model-provider key field, active or commented.
+ *
+ * It fails on the upstream baseline (eight endpoints, memory unset, keys present)
+ * and passes once the stage 2 patch is applied.
+ */
+import { readFileSync } from 'fs';
+import path from 'path';
+import { load as loadYaml } from 'js-yaml';
+import { configSchema } from '../src/config';
+
+const ROOT = path.resolve(__dirname, '..', '..', '..');
+const YAML_PATH = path.join(ROOT, 'librechat.example.yaml');
+const ENV_PATH = path.join(ROOT, '.env.example');
+
+/**
+ * Model-provider key fields. Tool keys are not model endpoints and stay out of this
+ * list: search (TAVILY, SERPER, JINA, COHERE reranker), image (DALLE, FLUX, GEMINI_IMAGE),
+ * speech (STT, TTS). Routing those through Cortex tool_runner is stage 3 work.
+ */
+const PROVIDER_KEY_FIELDS = [
+  'OPENAI_API_KEY',
+  'ANTHROPIC_API_KEY',
+  'GOOGLE_KEY',
+  'GEMINI_API_KEY',
+  'GOOGLE_SERVICE_KEY_FILE',
+  'AZURE_API_KEY',
+  'ASSISTANTS_API_KEY',
+  'BEDROCK_AWS_ACCESS_KEY_ID',
+  'BEDROCK_AWS_SECRET_ACCESS_KEY',
+  'BEDROCK_AWS_BEARER_TOKEN',
+  'ANYSCALE_API_KEY',
+  'APIPIE_API_KEY',
+  'DEEPSEEK_API_KEY',
+  'DATABRICKS_API_KEY',
+  'FIREWORKS_API_KEY',
+  'GROQ_API_KEY',
+  'HUGGINGFACE_TOKEN',
+  'MISTRAL_API_KEY',
+  'OPENROUTER_KEY',
+  'PERPLEXITY_API_KEY',
+  'SHUTTLEAI_API_KEY',
+  'TOGETHERAI_API_KEY',
+  'UNIFY_API_KEY',
+  'XAI_API_KEY',
+];
+
+const PROVIDER_HOSTS =
+  /https?:\/\/[^\s'"]*(openai\.com|anthropic\.com|x\.ai|groq\.com|mistral\.ai|googleapis\.com|openrouter\.ai|amazonaws\.com)/;
+
+function activeEnv(text: string): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim();
+    if (!line || line.startsWith('#')) {
+      continue;
+    }
+    const eq = line.indexOf('=');
+    if (eq < 1) {
+      continue;
+    }
+    out[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
+  }
+  return out;
+}
+
+describe('AirGPT gate: default config', () => {
+  const yamlText = readFileSync(YAML_PATH, 'utf8');
+  const parsed = configSchema.safeParse(loadYaml(yamlText));
+
+  it('librechat.example.yaml parses under configSchema', () => {
+    if (!parsed.success) {
+      throw new Error(JSON.stringify(parsed.error.issues, null, 2));
+    }
+    expect(parsed.success).toBe(true);
+  });
+
+  it('exposes exactly one model endpoint: the OpenVault custom endpoint', () => {
+    if (!parsed.success) {
+      throw new Error('yaml did not parse');
+    }
+    const endpoints = parsed.data.endpoints ?? {};
+    expect(Object.keys(endpoints).sort()).toEqual(['custom']);
+    const custom = endpoints.custom ?? [];
+    expect(custom).toHaveLength(1);
+    const [ov] = custom;
+    expect(ov.name).toBe('OpenVault');
+    expect(ov.baseURL).toBe('${NETIE_OPENVAULT_URL}/v1');
+    /** OpenAI-compatible: no native provider client. */
+    expect(ov.provider).toBeUndefined();
+    expect(ov.models.default.length).toBeGreaterThan(0);
+    /** The apiKey field is a schema requirement, not custody: never a vendor key. */
+    expect(ov.apiKey).not.toMatch(/^(sk-|AKIA|AIza)/);
+    expect(ov.apiKey).not.toMatch(/_API_KEY|_KEY\}/);
+  });
+
+  it('yaml names no direct provider host outside comments', () => {
+    const live = yamlText
+      .split(/\r?\n/)
+      .filter((l) => !l.trim().startsWith('#'))
+      .join('\n');
+    expect(live).not.toMatch(PROVIDER_HOSTS);
+  });
+
+  it('cross-chat and user memory is disabled by default', () => {
+    if (!parsed.success) {
+      throw new Error('yaml did not parse');
+    }
+    expect(parsed.data.memory?.disabled).toBe(true);
+    expect(parsed.data.memory?.personalize).toBe(false);
+  });
+});
+
+describe('AirGPT gate: default env', () => {
+  const envText = readFileSync(ENV_PATH, 'utf8');
+  const env = activeEnv(envText);
+
+  it('enables only the custom (OpenVault) endpoint plus the agents layer', () => {
+    expect(env.ENDPOINTS).toBe('custom,agents');
+  });
+
+  it('names the OpenVault URL', () => {
+    expect(env.NETIE_OPENVAULT_URL).toMatch(/^https?:\/\//);
+  });
+
+  it('carries no model-provider key field, active or commented', () => {
+    const present = PROVIDER_KEY_FIELDS.filter((k) =>
+      new RegExp(`^\\s*#?\\s*${k}=`, 'm').test(envText),
+    );
+    expect(present).toEqual([]);
+    const userProvided = Object.entries(env).filter(([, v]) => v === 'user_provided');
+    expect(userProvided).toEqual([]);
+  });
+
+  it('brands the app as AirGPT', () => {
+    expect(env.APP_TITLE).toBe('AirGPT');
+  });
+});
