+// Netie OpenVault gate. esbuild bundles this file alone to dist/netie-openvault-gate.js and
+// openvault.ts hands that file to the backend as a plugin, so it runs inside the backend
+// process: no vscode, no other extension module, nothing the bundle does not carry.
+//
+// Before a tool runs, POST {NETIE_OPENVAULT_URL}/api/crew/gate with the Crew GateAsk body
+// (Netie scripts/crew_ov_gate.py): kind, id, intent, parent_run_id, child_id, deficit. Ids
+// only, never the tool's arguments. Unreachable, non-JSON, a non-2xx reply, or anything but
+// allowed === true throws, and the backend then stops the tool before it runs. There is no
+// offline mode, and openvault.ts sets KILO_PURE=false so the backend cannot skip this plugin.
+import type { Hooks, PluginInput, PluginModule } from "@kilocode/plugin"
+
+// Same default as openvault.ts. The extension always sets NETIE_OPENVAULT_URL for the backend.
+const DEFAULT_URL = "http://127.0.0.1:5000"
+const TIMEOUT = 5_000
+
+// Deny by default: MCP and plugin tool ids are not known in advance, so only these local
+// built-ins skip the gate. MCP tools are named <server>_<tool>, so no id here has an
+// underscore, but a plugin or config-dir tool can take one of these ids and replace the
+// built-in (see builtin). `task` is not gated itself because every tool its subagent calls
+// passes this hook.
+const UNGATED = new Set(["read", "glob", "grep", "todowrite", "question", "task", "invalid"])
+
+type Input = Parameters<NonNullable<Hooks["tool.execute.before"]>>[0]
+
+function record(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === "object" && !Array.isArray(value)
+}
+
+/**
+ * The backend's tool registry lists its built-ins, then plugin and config-dir tools, and the
+ * last tool with an id is the one that runs. So an allowlisted id is still the built-in only
+ * while the registry lists it once. When the list cannot be read, the tool is gated.
+ */
+async function builtin(client: PluginInput["client"], tool: string) {
+  if (!UNGATED.has(tool)) return false
+  const res = await client.tool.ids().catch(() => undefined)
+  return res?.data?.filter((id) => id === tool).length === 1
+}
+
+async function ask(input: Input) {
+  const base = (process.env.NETIE_OPENVAULT_URL?.trim() || DEFAULT_URL).replace(/\/+$/, "")
+  const url = `${base}/api/crew/gate`
+  const res = await fetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({
+      kind: "service",
+      id: input.tool,
+      intent: "leave",
+      parent_run_id: input.sessionID,
+      child_id: input.callID,
+      deficit: "",
+    }),
+    signal: AbortSignal.timeout(TIMEOUT),
+  }).catch((err: unknown) => {
+    const why = err instanceof Error ? err.message : String(err)
+    throw new Error(
+      `OpenVault gate unreachable at ${url} (${why}). ${input.tool} was not run. Start OpenVault or set NETIE_OPENVAULT_URL.`,
+    )
+  })
+  const verdict: unknown = await res.json().catch(() => undefined)
+  if (!record(verdict)) {
+    throw new Error(
+      `OpenVault gate at ${url} returned HTTP ${res.status} without a JSON object. ${input.tool} was not run.`,
+    )
+  }
+  if (res.ok && verdict.allowed === true) return
+  const status = res.ok ? `HTTP ${res.status}, allowed is not true` : `HTTP ${res.status}`
+  const reason = typeof verdict.reason === "string" ? verdict.reason : status
+  throw new Error(`OpenVault refused ${input.tool}: ${reason}`)
+}
+
+export default {
+  id: "netie-openvault-gate",
+  server: async (input) => ({
+    "tool.execute.before": async (call) => {
+      if (await builtin(input.client, call.tool)) return
+      await ask(call)
+    },
+  }),
+} satisfies PluginModule
diff --git a/packages/kilo-vscode/src/netie/openvault.ts b/packages/kilo-vscode/src/netie/openvault.ts
new file mode 100644
index 0000000..d49b98f
--- /dev/null
+++ b/packages/kilo-vscode/src/netie/openvault.ts
@@ -0,0 +1,70 @@
+// Netie: the extension points the backend it starts at OpenVault. Through the backend's env it
+// adds OpenVault FreeRoute (NETIE_OPENVAULT_URL + /v1) as provider `openvault`, and the gate
+// plugin (openvault-gate-plugin.ts), which asks OpenVault before a tool runs. Both go in
+// KILO_CONFIG_CONTENT, so the user's kilo.json is never written, and no `model` is set there,
+// so a model the user configured still wins.
+import * as fs from "fs"
+import * as path from "path"
+import { pathToFileURL } from "url"
+import { NETIE_DEFAULT, OPENVAULT_PROVIDER_ID } from "../shared/provider-model"
+
+type Env = Record<string, string | undefined>
+
+const DEFAULT_URL = "http://127.0.0.1:5000"
+
+function url(env: Env) {
+  return (env.NETIE_OPENVAULT_URL?.trim() || DEFAULT_URL).replace(/\/+$/, "")
+}
+
+/** OpenVault FreeRoute, OpenAI-compatible. No key is sent. The limits are assumed, not measured. */
+function provider(base: string) {
+  return {
+    name: "OpenVault FreeRoute",
+    npm: "@ai-sdk/openai-compatible",
+    options: { baseURL: `${base}/v1` },
+    models: {
+      [NETIE_DEFAULT.modelID]: {
+        name: "OpenVault auto",
+        tool_call: true,
+        limit: { context: 128_000, output: 32_000 },
+      },
+    },
+  }
+}
+
+/**
+ * The bundled gate. The backend only reports a plugin it cannot load and then runs every
+ * tool ungated, so it must not start without this file.
+ */
+function gatePluginPath(root: string) {
+  const file = path.join(root, "dist", "netie-openvault-gate.js")
+  if (fs.existsSync(file)) return file
+  throw new Error(
+    `OpenVault gate plugin not found at ${file}. The backend was not started, because its tools would run ungated. Rebuild the extension.`,
+  )
+}
+
+/**
+ * Env for the backend, built from the env it would otherwise get. Throws when the gate bundle
+ * is missing or the user set KILO_CONFIG_CONTENT.
+ */
+export function openVaultEnv(env: Env, root: string) {
+  const plugin = gatePluginPath(root)
+  // The backend drops all of KILO_CONFIG_CONTENT, gate included, when any part of it fails to load
+  // ({file:} or {env:} substitution, JSON, schema) and only records a warning. So the gate shares it with nothing.
+  if (env.KILO_CONFIG_CONTENT?.trim()) {
+    throw new Error(
+      "KILO_CONFIG_CONTENT is set. The backend was not started: it drops all of that variable, OpenVault gate included, when any part fails to load, and tools would then run ungated. Move that config into kilo.json and unset KILO_CONFIG_CONTENT.",
+    )
+  }
+  const base = url(env)
+  return {
+    NETIE_OPENVAULT_URL: base,
+    KILO_CONFIG_CONTENT: JSON.stringify({
+      provider: { [OPENVAULT_PROVIDER_ID]: provider(base) },
+      plugin: [pathToFileURL(plugin).href],
+    }),
+    // With KILO_PURE set the backend loads no external plugin, the gate included.
+    KILO_PURE: "false",
+  }
+}
