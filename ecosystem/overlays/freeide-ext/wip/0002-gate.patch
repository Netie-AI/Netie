diff --git a/packages/kilo-vscode/tests/unit/netie-openvault-gate.test.ts b/packages/kilo-vscode/tests/unit/netie-openvault-gate.test.ts
new file mode 100644
index 0000000..6bf05c0
--- /dev/null
+++ b/packages/kilo-vscode/tests/unit/netie-openvault-gate.test.ts
@@ -0,0 +1,311 @@
+// Netie stage 2 proof for the extension (Netie PLAN.md section 3, cases 1 to 6). The new
+// modules under src/netie are imported inside the tests, so on the stage 1 baseline, with the
+// rest of tests/ from this patch (the vscode mock gains ExtensionMode), every numbered case
+// fails on its own instead of this file failing to load.
+import { afterEach, describe, expect, it } from "bun:test"
+import type { Hooks, PluginInput } from "@kilocode/plugin"
+import { once } from "node:events"
+import { existsSync } from "node:fs"
+import * as fs from "node:fs/promises"
+import * as os from "node:os"
+import * as path from "node:path"
+import { fileURLToPath, pathToFileURL } from "node:url"
+import * as vscode from "vscode"
+import { computeDefaultSelection } from "../../src/provider-actions"
+import { ServerManager } from "../../src/services/cli-backend/server-manager"
+
+const ROOT = path.resolve(import.meta.dir, "../..")
+const GATE = path.join("dist", "netie-openvault-gate.js")
+const ASK_KEYS = ["kind", "id", "intent", "parent_run_id", "child_id", "deficit"]
+const SECRET = "netie-secret-argument"
+const ENV = ["NETIE_OPENVAULT_URL", "KILO_CONFIG_CONTENT", "KILO_PURE"] as const
+
+type Seen = { method: string; path: string; type: string | null; raw: string }
+
+const workspace = vscode.workspace as unknown as { workspaceFolders: unknown }
+const folders = workspace.workspaceFolders
+const saved = Object.fromEntries(ENV.map((key) => [key, process.env[key]]))
+const cleanup: Array<() => unknown> = []
+
+function restore(key: (typeof ENV)[number]) {
+  const value = saved[key]
+  if (value == null) {
+    delete process.env[key]
+    return
+  }
+  process.env[key] = value
+}
+
+afterEach(async () => {
+  for (const step of cleanup.splice(0).reverse()) await step()
+  workspace.workspaceFolders = folders
+  ENV.forEach(restore)
+})
+
+/**
+ * A fake extension root. Its bin/kilo records the env the real ServerManager gives it, then announces a port. It
+ * exits by itself after 20 s, before ServerManager's own 30 s startup timeout, so no test can leave it running.
+ */
+async function extension(gate = true) {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "netie-gate-"))
+  cleanup.push(() => fs.rm(root, { recursive: true, force: true }))
+  const out = path.join(root, "env.json")
+  const cli = path.join(root, "bin", "cli.js")
+  const bin = path.join(root, "bin", "kilo")
+  await Bun.write(
+    cli,
+    [
+      'import { writeFileSync } from "node:fs"',
+      `writeFileSync(${JSON.stringify(out)}, JSON.stringify(process.env))`,
+      'console.log("kilo server listening on http://127.0.0.1:4096")',
+      "setTimeout(() => process.exit(1), 20_000)",
+      "",
+    ].join("\n"),
+  )
+  await Bun.write(bin, `#!/bin/sh\nexec ${JSON.stringify(process.execPath)} ${JSON.stringify(cli)} "$@"\n`)
+  await fs.chmod(bin, 0o755)
+  if (gate) await Bun.write(path.join(root, GATE), "export default {}\n")
+  return { root, out }
+}
+
+function context(root: string) {
+  return {
+    extensionPath: root,
+    extensionMode: vscode.ExtensionMode.Production,
+    globalStorageUri: { fsPath: path.join(root, "storage") },
+    extension: { packageJSON: { version: "test" } },
+  } as unknown as vscode.ExtensionContext
+}
+
+function manager(root: string) {
+  workspace.workspaceFolders = [{ uri: { fsPath: root } }]
+  const result = new ServerManager(context(root))
+  cleanup.push(() => result.dispose())
+  return result
+}
+
+/** Start the real ServerManager on a fake extension, stop it, and return the env bin/kilo saw. */
+async function spawned(root: string, out: string) {
+  const owner = manager(root)
+  const server = await owner.getServer()
+  const exit = once(server.process, "exit")
+  owner.dispose()
+  await exit
+  return JSON.parse(await fs.readFile(out, "utf8")) as Record<string, string>
+}
+
+/** Decode with the backend's own schema, ConfigV1.Info from @opencode-ai/core. */
+async function decode(text: string) {
+  const file = Bun.resolveSync("@opencode-ai/core/v1/config/config", import.meta.dir)
+  // This import runs core's global.ts, which creates Kilo's XDG dirs for the user, as core's own unit tests do.
+  const { ConfigV1 } = await import(file)
+  // effect is not a kilo-vscode dependency. Load the copy core resolves, so schema and decoder are one instance.
+  const { Schema } = await import(Bun.resolveSync("effect", path.dirname(file)))
+  return Schema.decodeUnknownSync(ConfigV1.Info)(JSON.parse(text))
+}
+
+/** A fake OpenVault on 127.0.0.1 that records every request. `reply` decides the verdict. */
+function vault(reply: () => Response) {
+  const seen: Seen[] = []
+  const server = Bun.serve({
+    hostname: "127.0.0.1",
+    port: 0,
+    async fetch(request) {
+      seen.push({
+        method: request.method,
+        path: new URL(request.url).pathname,
+        type: request.headers.get("content-type"),
+        raw: await request.text(),
+      })
+      return reply()
+    },
+  })
+  cleanup.push(() => server.stop(true))
+  return { seen, url: `http://127.0.0.1:${server.port}` }
+}
+
+/** The plugin's tool.execute.before hook, as the backend gets it from server(). `ids` is what the registry lists. */
+async function hook(ids: string[] = []): Promise<NonNullable<Hooks["tool.execute.before"]>> {
+  const plugin = (await import("../../src/netie/openvault-gate-plugin")).default
+  const client = { tool: { ids: async () => ({ data: ids }) } }
+  const hooks = await plugin.server({ client } as unknown as PluginInput)
+  return hooks["tool.execute.before"]
+}
+
+const call = (tool: string) => ({ tool, sessionID: "ses_netie_gate", callID: "call_netie_gate" })
+
+describe("netie case 1: package.json", () => {
+  it("defaults to openvault/auto, turns autocomplete auto-trigger off and names FreeIDE for VS Code", async () => {
+    const pkg = await Bun.file(path.join(ROOT, "package.json")).json()
+    const props = pkg.contributes.configuration.properties
+    expect(props["kilo-code.new.model.providerID"].default).toBe("openvault")
+    expect(props["kilo-code.new.model.modelID"].default).toBe("auto")
+    expect(props["kilo-code.new.autocomplete.enableAutoTrigger"].default).toBe(false)
+    expect(pkg.displayName).toBe("FreeIDE for VS Code")
+    expect(pkg.contributes.viewsContainers.activitybar.at(0).title).toBe("FreeIDE for VS Code")
+    expect(pkg.contributes.views["kilo-code-ActivityBar"].at(0).name).toBe("FreeIDE for VS Code")
+  })
+})
+
+describe("netie case 2: default selection", () => {
+  it("falls back to openvault/auto, and a model in the user's config still wins", () => {
+    expect(computeDefaultSelection(null, "", "")).toEqual({ providerID: "openvault", modelID: "auto" })
+    expect(computeDefaultSelection({ config: { model: "anthropic/claude-sonnet-4" } }, "", "")).toEqual({
+      providerID: "anthropic",
+      modelID: "claude-sonnet-4",
+    })
+  })
+})
+
+describe("netie case 3: backend env from the real ServerManager", () => {
+  it("passes NETIE_OPENVAULT_URL, KILO_PURE=false and a KILO_CONFIG_CONTENT the backend schema accepts", async () => {
+    const ext = await extension()
+    process.env.NETIE_OPENVAULT_URL = "http://127.0.0.1:5999/"
+    // With KILO_PURE set the backend loads no external plugin, so the extension must override it.
+    process.env.KILO_PURE = "1"
+    delete process.env.KILO_CONFIG_CONTENT
+    const env = await spawned(ext.root, ext.out)
+    expect(env.NETIE_OPENVAULT_URL).toBe("http://127.0.0.1:5999")
+    expect(env.KILO_PURE).toBe("false")
+    const config = await decode(env.KILO_CONFIG_CONTENT)
+    expect(config.model).toBeUndefined()
+    expect(config.provider.openvault.npm).toBe("@ai-sdk/openai-compatible")
+    expect(config.provider.openvault.options.baseURL).toBe("http://127.0.0.1:5999/v1")
+    expect(config.provider.openvault.models.auto.tool_call).toBe(true)
+    expect(config.plugin).toHaveLength(1)
+    const [spec] = config.plugin
+    expect(spec).toStartWith("file://")
+    expect(fileURLToPath(spec)).toBe(path.join(ext.root, GATE))
+    expect(existsSync(fileURLToPath(spec))).toBe(true)
+  }, 30_000)
+})
+
+describe("netie case 4: a user KILO_CONFIG_CONTENT", () => {
+  // The backend drops all of KILO_CONFIG_CONTENT when any part fails to load, so merging the gate into it is not safe.
+  it("does not start the backend, and says to move that config into kilo.json", async () => {
+    const { openVaultEnv } = await import("../../src/netie/openvault")
+    const ext = await extension()
+    const user = JSON.stringify({ model: "anthropic/claude-sonnet-4" })
+    for (const value of [user, JSON.stringify({ plugin: [42] }), "{not json"]) {
+      expect(() => openVaultEnv({ KILO_CONFIG_CONTENT: value }, ext.root)).toThrow("Move that config into kilo.json")
+    }
+    process.env.KILO_CONFIG_CONTENT = user
+    await expect(manager(ext.root).getServer()).rejects.toThrow("KILO_CONFIG_CONTENT is set")
+    expect(existsSync(ext.out)).toBe(false)
+  }, 30_000)
+
+  it("treats a blank value as unset, and the gate is then the only plugin", async () => {
+    const { openVaultEnv } = await import("../../src/netie/openvault")
+    const ext = await extension()
+    const config = JSON.parse(openVaultEnv({ KILO_CONFIG_CONTENT: " \n" }, ext.root).KILO_CONFIG_CONTENT)
+    expect(config.plugin).toEqual([pathToFileURL(path.join(ext.root, GATE)).href])
+    expect(config.provider.openvault.options.baseURL).toBe("http://127.0.0.1:5000/v1")
+  })
+})
+
+describe("netie case 5: missing gate bundle", () => {
+  it("does not start the backend, and the error names the file", async () => {
+    const ext = await extension(false)
+    await expect(manager(ext.root).getServer()).rejects.toThrow(path.join(ext.root, GATE))
+    expect(existsSync(ext.out)).toBe(false)
+  }, 30_000)
+})
+
+describe("netie case 6: gate plugin against a fake OpenVault", () => {
+  it("default-exports the id and server() the backend requires of a file plugin", async () => {
+    const plugin = (await import("../../src/netie/openvault-gate-plugin")).default
+    expect(plugin.id).toBe("netie-openvault-gate")
+    expect(typeof plugin.server).toBe("function")
+  })
+
+  // These cases prove the hook throws. That the backend then skips the tool is case 7 (end to end, not written yet).
+  it("refused: throws with OpenVault's reason", async () => {
+    const before = await hook()
+    const fake = vault(() => Response.json({ allowed: false, reason: "test says no" }))
+    process.env.NETIE_OPENVAULT_URL = fake.url
+    await expect(before(call("bash"), { args: { command: SECRET } })).rejects.toThrow(
+      "OpenVault refused bash: test says no",
+    )
+    expect(fake.seen).toHaveLength(1)
+  })
+
+  it("unreachable: fails closed and says where it asked", async () => {
+    const before = await hook()
+    const closed = Bun.serve({ hostname: "127.0.0.1", port: 0, fetch: () => new Response() })
+    const url = `http://127.0.0.1:${closed.port}`
+    await closed.stop(true)
+    process.env.NETIE_OPENVAULT_URL = url
+    await expect(before(call("bash"), { args: { command: SECRET } })).rejects.toThrow(
+      `OpenVault gate unreachable at ${url}/api/crew/gate`,
+    )
+  })
+
+  it("anything but a 2xx reply with allowed === true is a refusal", async () => {
+    const before = await hook()
+    const replies: Array<[() => Response, string]> = [
+      [() => new Response("not json", { status: 502 }), "returned HTTP 502 without a JSON object"],
+      [() => Response.json({ allowed: "yes" }), "OpenVault refused bash: HTTP 200, allowed is not true"],
+      [() => Response.json({ allowed: true }, { status: 500 }), "OpenVault refused bash: HTTP 500"],
+    ]
+    for (const [reply, error] of replies) {
+      process.env.NETIE_OPENVAULT_URL = vault(reply).url
+      await expect(before(call("bash"), { args: { command: SECRET } })).rejects.toThrow(error)
+    }
+  })
+
+  it("allowed: resolves, and the body is the six GateAsk ids without any argument value", async () => {
+    const before = await hook()
+    const fake = vault(() => Response.json({ allowed: true, location: "test" }))
+    process.env.NETIE_OPENVAULT_URL = `${fake.url}/`
+    await before(call("bash"), { args: { command: SECRET } })
+    await before(call("github_create_issue"), { args: { title: SECRET } })
+    expect(fake.seen).toHaveLength(2)
+    const [ask, mcp] = fake.seen
+    expect(ask.method).toBe("POST")
+    expect(ask.path).toBe("/api/crew/gate")
+    expect(ask.type).toBe("application/json")
+    const body = JSON.parse(ask.raw)
+    expect(Object.keys(body).sort()).toEqual([...ASK_KEYS].sort())
+    expect(body).toEqual({
+      kind: "service",
+      id: "bash",
+      intent: "leave",
+      parent_run_id: "ses_netie_gate",
+      child_id: "call_netie_gate",
+      deficit: "",
+    })
+    expect(JSON.parse(mcp.raw).id).toBe("github_create_issue")
+    for (const item of fake.seen) expect(item.raw).not.toContain(SECRET)
+  })
+
+  it("an allowlisted local tool sends no request while it is still the built-in", async () => {
+    const before = await hook(["read", "bash"])
+    const fake = vault(() => Response.json({ allowed: false, reason: "must not be asked" }))
+    process.env.NETIE_OPENVAULT_URL = fake.url
+    await before(call("read"), { args: { filePath: SECRET } })
+    expect(fake.seen).toEqual([])
+  })
+
+  it("an allowlisted id is gated once a plugin or config-dir tool takes it", async () => {
+    const fake = vault(() => Response.json({ allowed: false, reason: "replaced" }))
+    process.env.NETIE_OPENVAULT_URL = fake.url
+    // Listed twice, a custom tool replaced the built-in. Not listed, the registry cannot vouch for it.
+    for (const ids of [["read", "bash", "read"], []]) {
+      const before = await hook(ids)
+      await expect(before(call("read"), { args: { filePath: SECRET } })).rejects.toThrow("OpenVault refused read")
+    }
+    expect(fake.seen).toHaveLength(2)
+  })
+})
+
+describe("netie guard: the V2 session API", () => {
+  it("is not driven by the extension, because its runner fires no tool hook", async () => {
+    const hits: string[] = []
+    for (const dir of ["src", "webview-ui"]) {
+      for await (const file of new Bun.Glob("**/*.{ts,tsx}").scan({ cwd: path.join(ROOT, dir), absolute: true })) {
+        if ((await Bun.file(file).text()).includes("v2.session")) hits.push(file)
+      }
+    }
+    expect(hits).toEqual([])
+  })
+})
