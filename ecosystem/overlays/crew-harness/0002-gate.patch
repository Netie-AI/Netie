+      // The tool ran and wrote the world: a todo/write event and a non-error result.
+      expect(events.some(event => event['type'] === 'todo/write')).toBe(true)
+      const result = events.find(event => event['type'] === 'tool/result')!
+      const resultData = result['data'] as JsonObject
+      expect((resultData['message'] as JsonObject)['isError']).toBe(false)
+      expect(resultData['error']).toBeUndefined()
+      const assistant = events.filter(event => event['type'] === 'assistant/message')
+      expect(JSON.stringify(assistant.at(-1))).toContain('LAUNCH_OK')
+    } finally {
+      await standIn.close()
+    }
+  }, LOADER_SMOKE_TEST_TIMEOUT_MS)
