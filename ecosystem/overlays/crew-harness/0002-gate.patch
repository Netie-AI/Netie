diff --git a/apps/cli/tests/profiles/headless/tests/netie-launch.expected.e2e.ts b/apps/cli/tests/profiles/headless/tests/netie-launch.expected.e2e.ts
new file mode 100644
index 0000000..91196df
--- /dev/null
+++ b/apps/cli/tests/profiles/headless/tests/netie-launch.expected.e2e.ts
@@ -0,0 +1,182 @@
+/**
+ * Netie launch readiness: the shipped headless profile, booted by the real
+ * launcher from source, against a stand-in for the two OpenVault surfaces the
+ * product needs. Nothing in the composition is replaced except the one-shot
+ * runner (the test driver owns the turn, as every snapshot here does).
+ *
+ * What is asserted is the artifact an operator receives: the model request
+ * goes to `${NETIE_OPENVAULT_URL}/v1/chat/completions` carrying the
+ * `NETIE_OPENVAULT_KEY` identity and model `auto`; the tool body runs only
+ * after `POST /api/crew/gate` answered `allowed: true` with an ids-only body;
+ * a refusal reaches the session log as the tool's error result and the tool
+ * never runs. The stand-in is not OpenVault: it proves the wiring and the
+ * wire shape, not OpenVault's own decisions.
+ */
+
+import { createServer } from 'node:http'
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import { fileURLToPath } from 'node:url'
+import { LOADER_SMOKE_TEST_TIMEOUT_MS, runLoaderSmoke } from '@deepseek-ai/dsh-loader-smoke'
+import { describe, expect, it } from 'vitest'
+
+const configPath = fileURLToPath(new URL('./fixtures/netie-openvault.patch.yml', import.meta.url))
+const binScript = fileURLToPath(new URL('../../../../../../packages/test-support/loader-smoke/tests/fixtures/headless-driver.ts', import.meta.url))
+const tsconfigPath = fileURLToPath(new URL('../../../../../../tsconfig.json', import.meta.url))
+
+interface JsonObject {
+  [key: string]: unknown
+}
+
+interface Recorded {
+  path: string
+  authorization: string | undefined
+  body: JsonObject
+}
+
+interface StandIn {
+  readonly url: string
+  readonly requests: Recorded[]
+  close(): Promise<void>
+}
+
+/** SSE frames for one chat completion that calls `todo_write` once. */
+const toolCallFrames = [
+  '{"choices":[{"delta":{"role":"assistant","tool_calls":[{"index":0,"id":"call_launch_1","type":"function","function":{"name":"todo_write","arguments":""}}]},"index":0,"finish_reason":null}]}',
+  '{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"{\\"todos\\":[{\\"content\\":\\"prove the launch path\\",\\"status\\":\\"completed\\"}]}"}}]},"index":0,"finish_reason":null}]}',
+  '{"choices":[{"delta":{},"index":0,"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":3,"completion_tokens":1}}',
+  '[DONE]',
+]
+
+/** SSE frames for one plain text completion. */
+function textFrames(text: string): string[] {
+  return [
+    `{"choices":[{"delta":{"role":"assistant","content":${JSON.stringify(text)}},"index":0,"finish_reason":null}]}`,
+    '{"choices":[{"delta":{},"index":0,"finish_reason":"stop"}],"usage":{"prompt_tokens":3,"completion_tokens":1}}',
+    '[DONE]',
+  ]
+}
+
+/**
+ * The OpenVault stand-in: `/v1/chat/completions` answers a tool call on the
+ * first agent request and text afterwards (the session title request is text
+ * too); `/api/crew/gate` answers from `verdict`. Every request is retained.
+ */
+async function openVaultStandIn(verdict: JsonObject): Promise<StandIn> {
+  const requests: Recorded[] = []
+  let agentCompletions = 0
+  const server = createServer((request: IncomingMessage, response: ServerResponse) => {
+    let raw = ''
+    request.setEncoding('utf8')
+    request.on('data', (chunk: string) => { raw += chunk })
+    request.on('end', () => {
+      const body = JSON.parse(raw) as JsonObject
+      const path = request.url ?? ''
+      requests.push({ path, authorization: request.headers.authorization, body })
+      if (path === '/api/crew/gate') {
+        response.writeHead(200, { 'content-type': 'application/json' })
+        response.end(JSON.stringify({ ...verdict, kind: body['kind'], id: body['id'] }))
+        return
+      }
+      response.writeHead(200, { 'content-type': 'text/event-stream' })
+      // The title request is the only one capped at 64 output tokens.
+      const isTitle = body['max_tokens'] === 64
+      const frames = !isTitle && agentCompletions++ === 0 ? toolCallFrames : textFrames(isTitle ? 'Launch' : 'LAUNCH_OK')
+      response.end(frames.map(frame => `data: ${frame}\n\n`).join(''))
+    })
+  })
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve))
+  const address = server.address()
+  if (address === null || typeof address === 'string') throw new Error('stand-in has no port')
+  return {
+    url: `http://127.0.0.1:${address.port}`,
+    requests,
+    close: () => new Promise<void>((resolve) => { server.close(() => { resolve() }); server.closeAllConnections() }),
+  }
+}
+
+function sessionEvents(stdout: string): JsonObject[] {
+  return stdout.split('\n').filter(line => line.length > 0)
+    .map(line => JSON.parse(line) as JsonObject)
+    .filter(record => record['type'] === 'session_event')
+    .map(record => record['event'] as JsonObject)
+}
+
+async function launch(standIn: StandIn): Promise<{ events: JsonObject[]; stderr: string }> {
+  const result = await runLoaderSmoke({
+    label: 'Netie launch readiness through the shipped headless profile',
+    tempDirPrefix: 'headless-netie-launch-',
+    binScript,
+    libBinScript: binScript,
+    configPath,
+    binArgs: [configPath, 'record one completed todo, then say LAUNCH_OK'],
+    tsconfigPath,
+    env: {
+      NETIE_OPENVAULT_URL: standIn.url,
+      NETIE_OPENVAULT_KEY: 'ov_launch_seat',
+      DSH_TELEMETRY_DISABLED: '1',
+      NODE_OPTIONS: [process.env.NODE_OPTIONS, '--disable-warning=ExperimentalWarning'].filter(Boolean).join(' '),
+    },
+  })
+  return { events: sessionEvents(result.stdout), stderr: result.stderr }
+}
+
+describe('Netie launch readiness: shipped headless profile against an OpenVault stand-in', () => {
+  it('routes the model to /v1 with the OpenVault identity and runs a tool only after the gate allowed it', async () => {
+    const standIn = await openVaultStandIn({ allowed: true, location: 'local' })
+    try {
+      const { events, stderr } = await launch(standIn)
+      expect(stderr).toBe('')
+
+      // Every model request went to OpenVault /v1 with the issued key and model auto.
+      const completions = standIn.requests.filter(request => request.path === '/v1/chat/completions')
+      expect(completions.length).toBeGreaterThanOrEqual(2)
+      for (const request of completions) {
+        expect(request.authorization).toBe('Bearer ov_launch_seat')
+        expect(request.body['model']).toBe('auto')
+      }
+      expect(standIn.requests.map(request => request.path).filter(path => !path.startsWith('/v1/'))).toEqual(['/api/crew/gate'])
+
+      // The gate saw ids only: the tool name, the session id, the call id.
+      const gate = standIn.requests.find(request => request.path === '/api/crew/gate')!
+      const call = events.find(event => event['type'] === 'tool/call')!
