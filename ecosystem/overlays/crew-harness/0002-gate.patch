diff --git a/packages/bundle/base/tests/netie-defaults.spec.ts b/packages/bundle/base/tests/netie-defaults.spec.ts
new file mode 100644
index 0000000..2021149
--- /dev/null
+++ b/packages/bundle/base/tests/netie-defaults.spec.ts
@@ -0,0 +1,126 @@
+/**
+ * Netie stage 2 gate, part 1: the composition the operator receives.
+ *
+ * The artifacts are the shipped bundle patch files, parsed with the real
+ * loader schema and evaluated with the real loader `!!js` evaluator, not a
+ * re-implementation. On the upstream defaults every case here fails; after
+ * the Netie gate patch every case passes.
+ */
+
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { resolve } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import * as yaml from 'js-yaml'
+import { entryListSchema } from '@deepseek-ai/cordis-plugin-include'
+import { evaluate } from '@deepseek-ai/cordis-plugin-loader'
+
+interface Row {
+  id?: string
+  name?: string
+  inject?: string[]
+  disabled?: unknown
+  config?: Record<string, unknown>
+}
+
+const bundles = fileURLToPath(new URL('../..', import.meta.url))
+
+/** Every row a bundle inserts, plus every row it restates by id. */
+function rowsOf(bundle: string): { inserted: Row[]; restated: Row[] } {
+  const parsed = yaml.load(readFileSync(resolve(bundles, bundle, 'cordis.patch.yml'), 'utf8'), { schema: entryListSchema })
+  if (!Array.isArray(parsed)) throw new TypeError(`${bundle}: patch must parse to a list`)
+  const inserted: Row[] = []
+  const restated: Row[] = []
+  for (const patch of parsed as Record<string, unknown>[]) {
+    if (Array.isArray(patch['insert'])) inserted.push(...patch['insert'] as Row[])
+    else if (typeof patch['id'] === 'string') restated.push(patch)
+  }
+  return { inserted, restated }
+}
+
+function expression(value: unknown): string {
+  const expr = (value as { __jsExpr?: string } | undefined)?.__jsExpr
+  if (expr === undefined) throw new TypeError(`expected a !!js expression, got ${JSON.stringify(value)}`)
+  return expr
+}
+
+const base = rowsOf('base')
+const sdkMinimal = rowsOf('sdk-minimal')
+const byId = (rows: Row[], id: string): Row | undefined => rows.find(row => row.id === id)
+
+describe('Netie default model route: one OpenAI-compatible endpoint, OpenVault /v1', () => {
+  for (const [label, rows] of [['dsh-base', base.inserted], ['dsh-sdk-minimal', sdkMinimal.inserted]] as const) {
+    it(`${label} mounts the openvault route on llm-pi-ai at \${NETIE_OPENVAULT_URL}/v1`, () => {
+      const row = byId(rows, 'llm-pi-ai')
+      expect(row?.name).toBe('@deepseek-ai/dsh-llm-pi-ai')
+      const providers = row?.config?.['providers'] as Record<string, Record<string, unknown>> | undefined
+      expect(Object.keys(providers ?? {})).toEqual(['openvault'])
+      const route = providers!['openvault']!
+      expect(route['api']).toBe('openai-completions')
+      const url = expression(route['baseURL'])
+      expect(evaluate({ process: { env: {} } }, url)).toBe('http://127.0.0.1:5000/v1')
+      expect(evaluate({ process: { env: { NETIE_OPENVAULT_URL: 'https://vault.example' } } }, url)).toBe('https://vault.example/v1')
+      // The route names a credential reference, never a literal key.
+      expect(route['apiKeyEnv']).toBe('NETIE_OPENVAULT_KEY')
+      expect(route).not.toHaveProperty('apiKey')
+      expect((route['models'] as { id: string }[]).map(model => model.id)).toEqual(['auto'])
+    })
+
+    it(`${label} mounts no direct DeepSeek model route`, () => {
+      expect(rows.filter(row => row.id === 'llm-deepseek' || row.id === 'llm-deepseek-account')).toEqual([])
+      expect(rows.map(row => row.name).filter(name => name?.startsWith('@deepseek-ai/dsh-llm-deepseek'))).toEqual([])
+    })
+
+    it(`${label} carries no provider key field`, () => {
+      // Config lines only: a comment may name the field it refuses.
+      const text = readFileSync(resolve(bundles, label.replace('dsh-', ''), 'cordis.patch.yml'), 'utf8')
+        .split('\n').filter(line => !line.trimStart().startsWith('#')).join('\n')
+      expect(text).not.toMatch(/DEEPSEEK_API_KEY|OPENAI_API_KEY|ANTHROPIC_API_KEY/u)
+    })
+  }
+
+  it('dsh-base defaults new Agents to provider openvault', () => {
+    expect(byId(base.inserted, 'agent-default-model')?.config).toEqual({ provider: 'openvault', model: 'auto' })
+  })
+
+  it('dsh-acp-app selects provider openvault', () => {
+    const acp = rowsOf('acp-app')
+    expect(byId(acp.inserted, 'acp')?.config).toMatchObject({ provider: 'openvault', model: 'auto' })
+  })
+
+  it('dsh-base mounts no keyed search route; web_search stays listed and fails loud without a provider', () => {
+    expect(byId(base.inserted, 'web-search-deepseek')).toBeUndefined()
+    expect(base.inserted.map(row => row.name).filter(name => name?.startsWith('@deepseek-ai/dsh-web-search'))).toEqual([])
+    expect(byId(base.inserted, 'web')?.config).toEqual({ fetchProvider: 'http' })
+    expect(byId(base.inserted, 'tool-web')?.config).toMatchObject({ fetch: true })
+    expect(byId(base.inserted, 'tool-web')?.config).not.toHaveProperty('search')
+  })
+})
+
+describe('Netie Crew gate: tools and sandbox register only under the gate', () => {
+  for (const [label, rows] of [['dsh-base', base.inserted], ['dsh-sdk-minimal', sdkMinimal.inserted]] as const) {
+    it(`${label} mounts crew-gate at \${NETIE_OPENVAULT_URL}`, () => {
+      const row = byId(rows, 'crew-gate')
+      expect(row?.name).toBe('@deepseek-ai/dsh-crew-gate')
+      expect(row?.disabled).toBeUndefined()
+      const url = expression(row?.config?.['openVaultUrl'])
+      expect(evaluate({ process: { env: {} } }, url)).toBe('http://127.0.0.1:5000')
+      expect(evaluate({ process: { env: { NETIE_OPENVAULT_URL: 'https://vault.example/' } } }, url)).toBe('https://vault.example/')
+    })
+
+    for (const id of ['tools', 'sandbox'] as const) {
+      it(`${label} row ${id} injects crewGate and requires it`, () => {
+        const row = byId(rows, id)
+        expect(row?.inject).toEqual(['crewGate'])
+        expect(row?.config).toMatchObject({ crewGate: 'required' })
+      })
+    }
+  }
+
+  for (const bundle of ['headless', 'web-app'] as const) {
+    it(`dsh-${bundle} restates tools config with crewGate required`, () => {
+      const row = byId(rowsOf(bundle).restated, 'tools')
+      expect(row?.config).toMatchObject({ crewGate: 'required' })
+    })
+  }
+})
