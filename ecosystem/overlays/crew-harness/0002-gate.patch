+/**
+ * Crew gate: the Netie fail-closed wrap between this harness and OpenVault.
+ *
+ * Ported contract shape (Netie `scripts/crew_ov_gate.py` and
+ * `scripts/crew_tool_wrap.py`), not an import of that repository:
+ *
+ *   POST {NETIE_OPENVAULT_URL}/api/crew/gate
+ *     {kind, id, intent, parent_run_id, child_id, deficit}
+ *   -> allowed + location. Ids only. No skill_body, prompt, instructions
+ *      or transcript ever rides the request.
+ *
+ * Refusals are visible and happen before any work: a missing OpenVault URL,
+ * a transport failure, a non-object reply, a reply without `allowed: true`,
+ * an ask whose kind OpenVault does not register, an ask that carries a body
+ * key, or an ask without parent and child ids. Nothing here is a second
+ * key vault or a second orchestrator (NETIE.md section 3, DR-0002 rule 6).
+ *
+ * The plugin mounts `ctx.crewGate` and, once the tool registry is up, a
+ * `tools/pre-execute` listener that asks OpenVault before every tool body
+ * runs. `@deepseek-ai/dsh-tools` (`crewGate: required`) and
+ * `@deepseek-ai/dsh-sandbox-local` (`crewGate: required`) refuse to register
+ * a tool or a sandbox provider while this service is absent.
+ *
+ * @module @deepseek-ai/dsh-crew-gate
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { Service } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import { HarnessError } from '@deepseek-ai/dsh-llm'
+import type { PreToolDecision, ToolExecution } from '@deepseek-ai/dsh-tools'
+
+/** Stable error code carried by every Crew gate refusal. */
+export const CREW_GATE_DENIED = 'CREW_GATE_DENIED'
+
+/** Cordis plugin name used by loader diagnostics. */
+export const name = 'crew-gate'
+
+/** Keys that never leave the process. Same set as the Netie DROP_KEYS. */
+export const DROP_KEYS: ReadonlySet<string> = new Set(['skill_body', 'prompt', 'instructions', 'transcript'])
+
+/**
+ * Kinds OpenVault registers (its ACCESS_KINDS). `skill` is refused here until
+ * a registry row exists, exactly as the Netie client does, so a mock that
+ * answers `allowed: true` cannot greenwash a kind the vault does not know.
+ */
+export const REGISTERED_KINDS: ReadonlySet<string> = new Set(['memory', 'api', 'component', 'runtime', 'model', 'service'])
+
+/** The request path on the OpenVault base URL. */
+export const CREW_GATE_PATH = '/api/crew/gate'
+
+/** A Crew gate refusal. The tool call does not run; the session stays open. */
+export class CrewGateDenied extends HarnessError {
+  constructor(message: string, options?: ErrorOptions) {
+    super(`crew gate: ${message}`, CREW_GATE_DENIED, options)
+  }
+}
+
+/** The ids-only body sent to OpenVault. Field names are the wire names. */
+export interface GateAsk {
+  kind: string
+  id: string
+  intent: string
+  parent_run_id: string
+  child_id: string
+  deficit?: string
+}
+
+/** Transport seam: POST a JSON body, return the decoded reply. Tests inject one. */
+export type GatePost = (url: string, body: Record<string, unknown>, signal: AbortSignal) => Promise<unknown>
+
+/** Plugin config. The URL is a location, never a key. */
+export interface Config {
+  /**
+   * OpenVault base URL. Empty means no gate is reachable, which is a refusal
+   * for every ask (fail closed), never a pass-through.
+   */
+  openVaultUrl?: string
+  /** Transport timeout per ask in milliseconds. */
+  timeoutMs?: number
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** The Netie Crew gate: ids-only asks to OpenVault, fail closed. */
+    crewGate: CrewGate
+  }
+}
+
+/**
+ * Drop body keys at every depth. Token-cheap index: ids and status only.
+ * @param value - any JSON-shaped value.
+ * @returns the same shape without `DROP_KEYS` members.
+ */
+export function stripBodies(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stripBodies)
+  if (typeof value === 'object' && value !== null) {
+    const out: Record<string, unknown> = {}
+    for (const [key, inner] of Object.entries(value as Record<string, unknown>)) {
+      if (!DROP_KEYS.has(key)) out[key] = stripBodies(inner)
+    }
+    return out
+  }
+  return value
+}
+
+/**
+ * True when a payload still carries a skill body, prompt, instructions or
+ * transcript at any depth.
+ * @param value - any JSON-shaped value.
+ * @returns whether a body key is present.
+ */
+export function hasBodies(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(hasBodies)
+  if (typeof value === 'object' && value !== null) {
+    const record = value as Record<string, unknown>
+    if (Object.keys(record).some(key => DROP_KEYS.has(key))) return true
+    return Object.values(record).some(hasBodies)
+  }
+  return false
+}
+
+/** Default transport: `fetch` POST of a JSON body. */
+async function fetchPost(url: string, body: Record<string, unknown>, signal: AbortSignal): Promise<unknown> {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+    signal,
+  })
+  if (!response.ok) throw new Error(`HTTP ${response.status}`)
+  return response.json()
+}
+
+/**
+ * The Crew gate service. One operation per ask; nothing is cached, so a
+ * refusal upstream is a refusal here on the next call.
+ */
+export class CrewGate extends Service {
+  static Config: z<Config> = z.object({
+    openVaultUrl: z.string().default(''),
+    timeoutMs: z.natural().min(1).default(5_000),
+  })
+
+  /** Test hook (mirrors sandbox-local `internals`): replace the transport. */
+  internals: { post?: GatePost } = {}
+
+  /** The OpenVault base URL without a trailing slash; empty when unset. */
+  readonly baseUrl: string
+  private readonly timeoutMs: number
+
+  constructor(ownerContext: Context, config: Config = {}) {
+    super(ownerContext, 'crewGate')
+    this.baseUrl = (config.openVaultUrl ?? '').trim().replace(/\/+$/u, '')
+    this.timeoutMs = config.timeoutMs ?? 5_000
+    // The registry may mount after this service; the wrap attaches whenever
+    // it is up and detaches with it.
+    ownerContext.inject(['tools'], (toolsCtx) => {
+      toolsCtx.on('tools/pre-execute', async (exec, next): Promise<PreToolDecision> => {
+        const denial = await this.gateExecution(exec)
+        return denial ?? next()
+      })
+    })
+  }
+
+  /**
+   * Refuse before any network call: the body check the Netie client runs
+   * ahead of POST, so a permissive vault cannot be greenwashed from here.
+   * @param ask - the ids-only ask.
+   */
+  refuse(ask: GateAsk): void {
+    if (hasBodies(ask)) throw new CrewGateDenied('skill_body must never go to the gate')
+    const kind = ask.kind.trim()
+    const id = ask.id.trim()
+    if (!REGISTERED_KINDS.has(kind)) throw new CrewGateDenied(`no ${kind || 'kind'} registered as '${id}'`)
+    if (!id) throw new CrewGateDenied(`empty id for kind '${kind}'`)
+    if (!ask.parent_run_id.trim() || !ask.child_id.trim()) {
+      throw new CrewGateDenied('ask needs parent and child run ids')
+    }
+  }
+
+  /**
+   * Ask OpenVault. Resolves with the stripped reply only on `allowed: true`.
+   * @param ask - the ids-only ask.
+   * @param signal - caller cancellation, fused with the transport timeout.
+   * @returns the reply with body keys dropped.
+   */
+  async allow(ask: GateAsk, signal?: AbortSignal): Promise<Record<string, unknown>> {
+    if (!this.baseUrl) throw new CrewGateDenied('no OpenVault crew_gate (NETIE_OPENVAULT_URL is empty)')
+    this.refuse(ask)
+    const payload = stripBodies({ ...ask }) as Record<string, unknown>
+    const post = this.internals.post ?? fetchPost
+    const timeout = AbortSignal.timeout(this.timeoutMs)
+    const fused = signal === undefined ? timeout : AbortSignal.any([signal, timeout])
+    let raw: unknown
+    try {
+      raw = await post(`${this.baseUrl}${CREW_GATE_PATH}`, payload, fused)
+    } catch (error) {
+      throw new CrewGateDenied(`crew_gate unreachable: ${error instanceof Error ? error.message : String(error)}`, { cause: error })
+    }
+    const body = stripBodies(raw ?? {})
+    if (typeof body !== 'object' || body === null || Array.isArray(body)) throw new CrewGateDenied('crew_gate returned non-object')
+    const reply = body as Record<string, unknown>
+    if (reply['allowed'] !== true) {
+      const reason = reply['reason']
+      throw new CrewGateDenied(typeof reason === 'string' && reason ? reason : 'openvault refused')
+    }
+    return reply
+  }
+
+  /**
+   * Map one tool execution onto an ask: ids only. The parent is the agent's
+   * session id; a nested dispatch (a sub-call inside an already gated root
+   * call, which carries no agent of its own) names its root call id as the
+   * parent. A root call with no agent has no parent and is refused.
+   */
+  private async gateExecution(exec: ToolExecution): Promise<PreToolDecision | undefined> {
+    const nested = exec.rootCallId !== exec.callId
+    try {
+      await this.allow({
+        kind: 'service',
+        id: exec.name,
+        intent: 'tool',
+        parent_run_id: exec.agent?.id ?? (nested ? exec.rootCallId : ''),
+        child_id: exec.callId,
+      }, exec.signal)
+      return undefined
+    } catch (error) {
+      if (!(error instanceof CrewGateDenied)) throw error
+      return { kind: 'deny', reason: error.message, info: { name: 'CrewGateDenied', code: CREW_GATE_DENIED } }
+    }
+  }
+}
+
+export default CrewGate
