diff --git a/packages/guard/crew-gate/src/index.ts b/packages/guard/crew-gate/src/index.ts
new file mode 100644
index 0000000..569f456
--- /dev/null
+++ b/packages/guard/crew-gate/src/index.ts
@@ -0,0 +1,229 @@
+/**
+ * Crew gate: the Netie fail-closed wrap between this harness and OpenVault.
+ *
+ * Ported contract shape (Netie `scripts/crew_ov_gate.py` and
+ * `scripts/crew_tool_wrap.py`), not an import of that repository:
+ *
+ *   POST {NETIE_OPENVAULT_URL}/api/crew/gate
+ *     {kind, id, intent, parent_run_id, child_id, deficit}
+ *   -> allowed + location. Ids only. No skill_body, prompt, instructions
+ *      or transcript ever rides the request.
+ *
+ * Refusals are visible and happen before any work: a missing OpenVault URL,
+ * a transport failure, a non-object reply, a reply without `allowed: true`,
+ * an ask whose kind OpenVault does not register, an ask that carries a body
+ * key, or an ask without parent and child ids. Nothing here is a second
+ * key vault or a second orchestrator (NETIE.md section 3, DR-0002 rule 6).
+ *
+ * The plugin mounts `ctx.crewGate` and, once the tool registry is up, a
+ * `tools/pre-execute` listener that asks OpenVault before every tool body
+ * runs. `@deepseek-ai/dsh-tools` (`crewGate: required`) and
+ * `@deepseek-ai/dsh-sandbox-local` (`crewGate: required`) refuse to register
+ * a tool or a sandbox provider while this service is absent.
+ *
+ * @module @deepseek-ai/dsh-crew-gate
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { Service } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import { HarnessError } from '@deepseek-ai/dsh-llm'
+import type { PreToolDecision, ToolExecution } from '@deepseek-ai/dsh-tools'
+
+/** Stable error code carried by every Crew gate refusal. */
+export const CREW_GATE_DENIED = 'CREW_GATE_DENIED'
+
+/** Cordis plugin name used by loader diagnostics. */
+export const name = 'crew-gate'
+
+/** Keys that never leave the process. Same set as the Netie DROP_KEYS. */
+export const DROP_KEYS: ReadonlySet<string> = new Set(['skill_body', 'prompt', 'instructions', 'transcript'])
+
+/**
+ * Kinds OpenVault registers (its ACCESS_KINDS). `skill` is refused here until
+ * a registry row exists, exactly as the Netie client does, so a mock that
+ * answers `allowed: true` cannot greenwash a kind the vault does not know.
+ */
+export const REGISTERED_KINDS: ReadonlySet<string> = new Set(['memory', 'api', 'component', 'runtime', 'model', 'service'])
+
+/** The request path on the OpenVault base URL. */
+export const CREW_GATE_PATH = '/api/crew/gate'
+
+/** A Crew gate refusal. The tool call does not run; the session stays open. */
+export class CrewGateDenied extends HarnessError {
+  constructor(message: string, options?: ErrorOptions) {
+    super(`crew gate: ${message}`, CREW_GATE_DENIED, options)
+  }
+}
+
+/** The ids-only body sent to OpenVault. Field names are the wire names. */
+export interface GateAsk {
+  kind: string
+  id: string
+  intent: string
+  parent_run_id: string
+  child_id: string
+  deficit?: string
+}
+
+/** Transport seam: POST a JSON body, return the decoded reply. Tests inject one. */
+export type GatePost = (url: string, body: Record<string, unknown>, signal: AbortSignal) => Promise<unknown>
+
+/** Plugin config. The URL is a location, never a key. */
+export interface Config {
+  /**
+   * OpenVault base URL. Empty means no gate is reachable, which is a refusal
+   * for every ask (fail closed), never a pass-through.
+   */
+  openVaultUrl?: string
+  /** Transport timeout per ask in milliseconds. */
+  timeoutMs?: number
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** The Netie Crew gate: ids-only asks to OpenVault, fail closed. */
+    crewGate: CrewGate
+  }
+}
+
+/**
+ * Drop body keys at every depth. Token-cheap index: ids and status only.
+ * @param value - any JSON-shaped value.
+ * @returns the same shape without `DROP_KEYS` members.
+ */
+export function stripBodies(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stripBodies)
+  if (typeof value === 'object' && value !== null) {
+    const out: Record<string, unknown> = {}
+    for (const [key, inner] of Object.entries(value as Record<string, unknown>)) {
+      if (!DROP_KEYS.has(key)) out[key] = stripBodies(inner)
+    }
+    return out
+  }
+  return value
+}
+
+/**
+ * True when a payload still carries a skill body, prompt, instructions or
+ * transcript at any depth.
+ * @param value - any JSON-shaped value.
+ * @returns whether a body key is present.
+ */
+export function hasBodies(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(hasBodies)
+  if (typeof value === 'object' && value !== null) {
+    const record = value as Record<string, unknown>
+    if (Object.keys(record).some(key => DROP_KEYS.has(key))) return true
+    return Object.values(record).some(hasBodies)
+  }
+  return false
+}
+
+/** Default transport: `fetch` POST of a JSON body. */
+async function fetchPost(url: string, body: Record<string, unknown>, signal: AbortSignal): Promise<unknown> {
+  const response = await fetch(url, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+    signal,
+  })
+  if (!response.ok) throw new Error(`HTTP ${response.status}`)
+  return response.json()
+}
+
+/**
+ * The Crew gate service. One operation per ask; nothing is cached, so a
+ * refusal upstream is a refusal here on the next call.
+ */
+export class CrewGate extends Service {
+  static Config: z<Config> = z.object({
+    openVaultUrl: z.string().default(''),
+    timeoutMs: z.natural().min(1).default(5_000),
+  })
+
+  /** Test hook (mirrors sandbox-local `internals`): replace the transport. */
+  internals: { post?: GatePost } = {}
+
+  /** The OpenVault base URL without a trailing slash; empty when unset. */
+  readonly baseUrl: string
+  private readonly timeoutMs: number
+
+  constructor(ownerContext: Context, config: Config = {}) {
+    super(ownerContext, 'crewGate')
+    this.baseUrl = (config.openVaultUrl ?? '').trim().replace(/\/+$/u, '')
+    this.timeoutMs = config.timeoutMs ?? 5_000
+    // The registry may mount after this service; the wrap attaches whenever
+    // it is up and detaches with it.
+    ownerContext.inject(['tools'], (toolsCtx) => {
+      toolsCtx.on('tools/pre-execute', async (exec, next): Promise<PreToolDecision> => {
+        const denial = await this.gateExecution(exec)
+        return denial ?? next()
+      })
+    })
+  }
+
+  /**
+   * Refuse before any network call: the body check the Netie client runs
+   * ahead of POST, so a permissive vault cannot be greenwashed from here.
+   * @param ask - the ids-only ask.
+   */
+  refuse(ask: GateAsk): void {
+    if (hasBodies(ask)) throw new CrewGateDenied('skill_body must never go to the gate')
+    const kind = ask.kind.trim()
+    const id = ask.id.trim()
+    if (!REGISTERED_KINDS.has(kind)) throw new CrewGateDenied(`no ${kind || 'kind'} registered as '${id}'`)
+    if (!id) throw new CrewGateDenied(`empty id for kind '${kind}'`)
+    if (!ask.parent_run_id.trim() || !ask.child_id.trim()) {
+      throw new CrewGateDenied('ask needs parent and child run ids')
+    }
+  }
+
+  /**
+   * Ask OpenVault. Resolves with the stripped reply only on `allowed: true`.
+   * @param ask - the ids-only ask.
+   * @param signal - caller cancellation, fused with the transport timeout.
+   * @returns the reply with body keys dropped.
+   */
+  async allow(ask: GateAsk, signal?: AbortSignal): Promise<Record<string, unknown>> {
+    if (!this.baseUrl) throw new CrewGateDenied('no OpenVault crew_gate (NETIE_OPENVAULT_URL is empty)')
+    this.refuse(ask)
+    const payload = stripBodies({ ...ask }) as Record<string, unknown>
+    const post = this.internals.post ?? fetchPost
+    const timeout = AbortSignal.timeout(this.timeoutMs)
+    const fused = signal === undefined ? timeout : AbortSignal.any([signal, timeout])
+    let raw: unknown
+    try {
+      raw = await post(`${this.baseUrl}${CREW_GATE_PATH}`, payload, fused)
+    } catch (error) {
+      throw new CrewGateDenied(`crew_gate unreachable: ${error instanceof Error ? error.message : String(error)}`, { cause: error })
+    }
+    const body = stripBodies(raw ?? {})
+    if (typeof body !== 'object' || body === null || Array.isArray(body)) throw new CrewGateDenied('crew_gate returned non-object')
+    const reply = body as Record<string, unknown>
+    if (reply['allowed'] !== true) {
+      const reason = reply['reason']
+      throw new CrewGateDenied(typeof reason === 'string' && reason ? reason : 'openvault refused')
+    }
+    return reply
+  }
+
+  /** Map one tool execution onto an ask: ids only, parent is the agent's session id, child is the call id. */
+  private async gateExecution(exec: ToolExecution): Promise<PreToolDecision | undefined> {
+    try {
+      await this.allow({
+        kind: 'service',
+        id: exec.name,
+        intent: 'tool',
+        parent_run_id: exec.agent?.id ?? '',
+        child_id: exec.callId,
+      }, exec.signal)
+      return undefined
+    } catch (error) {
+      if (!(error instanceof CrewGateDenied)) throw error
+      return { kind: 'deny', reason: error.message, info: { name: 'CrewGateDenied', code: CREW_GATE_DENIED } }
+    }
+  }
+}
+
+export default CrewGate
diff --git a/packages/guard/crew-gate/tests/crew-gate.spec.ts b/packages/guard/crew-gate/tests/crew-gate.spec.ts
new file mode 100644
index 0000000..f551c81
--- /dev/null
+++ b/packages/guard/crew-gate/tests/crew-gate.spec.ts
@@ -0,0 +1,149 @@
+/**
+ * Netie stage 2 gate, part 2: the live registry under the Crew gate.
+ *
+ * Asserts the artifact a tool caller receives (the tool result), what leaves
+ * the process (the POST body, ids only), and that a tool or sandbox provider
+ * registered outside the wrap is refused at registration with a visible
+ * error. The OpenVault transport is injected; no network.
+ */
+
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture, type ToolExecutionInput } from '@deepseek-ai/dsh-tools'
+import SandboxLocal from '@deepseek-ai/dsh-sandbox-local'
+import CrewGate, { CREW_GATE_DENIED, CREW_GATE_PATH, CrewGateDenied, hasBodies, stripBodies } from '@deepseek-ai/dsh-crew-gate'
+import type { GatePost } from '@deepseek-ai/dsh-crew-gate'
+
+const signal = new AbortController().signal
+/** The agent on whose behalf a call runs; the gate reads only its id (the session id). */
+const agent = { id: 'sess-parent-1' } as unknown as NonNullable<ToolExecutionInput['agent']>
+
+const echo = defineContentToolFixture({
+  name: 'echo', description: 'd', parameters: {},
+  async execute() { return [{ type: 'text' as const, text: 'ran' }] },
+})
+
+/** Mount prompt + registry (crewGate required) + the gate with an injected transport. */
+async function setup(options: { url?: string; reply?: unknown; post?: GatePost; gate?: boolean } = {}) {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  const calls: { url: string; body: Record<string, unknown> }[] = []
+  if (options.gate !== false) {
+    await ctx.plugin(CrewGate, { openVaultUrl: options.url ?? 'http://127.0.0.1:5000' })
+    ctx.crewGate.internals.post = options.post ?? (async (url, body) => { calls.push({ url, body }); return options.reply ?? { allowed: true, location: 'local' } })
+  }
+  await ctx.plugin(ToolRuntime, { crewGate: 'required' })
+  return { ctx, calls }
+}
+
+describe('registration outside the Crew gate wrap is refused, visibly', () => {
+  it('ToolRuntime with crewGate required refuses register() while no gate is mounted', async () => {
+    const { ctx } = await setup({ gate: false })
+    expect(() => ctx.tools.register(echo)).toThrow(/tool "echo" refused at registration: tools.crewGate is "required" and no Crew gate/u)
+    expect(ctx.tools.get('echo')).toBeUndefined()
+  })
+
+  it('ToolRuntime with the schema default (off) keeps the upstream behavior', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    expect(() => ctx.tools.register(echo)).not.toThrow()
+  })
+
+  it('sandbox-local with crewGate required refuses to provide ctx.sandbox while no gate is mounted', async () => {
+    const ctx = new Context()
+    await expect(ctx.plugin(SandboxLocal, { crewGate: 'required' })).rejects.toThrow(/sandbox provider refused at registration/u)
+    expect(ctx.get('sandbox')).toBeUndefined()
+  })
+
+  it('sandbox-local with crewGate required mounts once the gate exists', async () => {
+    const ctx = new Context()
+    await ctx.plugin(CrewGate, { openVaultUrl: 'http://127.0.0.1:5000' })
+    await ctx.plugin(SandboxLocal, { crewGate: 'required' })
+    expect(ctx.get('sandbox')).toBeDefined()
+  })
+})
+
+describe('every tool body runs only after OpenVault answered allowed: true', () => {
+  it('posts ids only to {url}/api/crew/gate and then runs the tool', async () => {
+    const { ctx, calls } = await setup({ url: 'https://vault.example/' })
+    ctx.tools.register(echo)
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-1'), name: 'echo', arguments: { secret: 'never sent' }, agent, signal })
+    expect(result.isError).toBe(false)
+    expect(calls).toEqual([{
+      url: `https://vault.example${CREW_GATE_PATH}`,
+      body: { kind: 'service', id: 'echo', intent: 'tool', parent_run_id: 'sess-parent-1', child_id: 'call-1' },
+    }])
+  })
+
+  it('a reply without allowed: true denies the call with the vault reason and the tool never runs', async () => {
+    let ran = 0
+    const { ctx } = await setup({ reply: { allowed: false, reason: 'HT3: leave-machine needs a human' } })
+    ctx.tools.register(defineContentToolFixture({ name: 'write', description: 'd', parameters: {}, async execute() { ran += 1; return [{ type: 'text' as const, text: 'wrote' }] } }))
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-2'), name: 'write', arguments: {}, agent, signal })
+    expect(result.isError).toBe(true)
+    expect(result.error?.info).toMatchObject({ name: 'CrewGateDenied', code: CREW_GATE_DENIED })
+    expect(result.error?.message).toContain('HT3: leave-machine needs a human')
+    expect(ran).toBe(0)
+  })
+
+  it('an unreachable vault is a refusal, not a pass-through', async () => {
+    const { ctx } = await setup({ post: async () => { throw new Error('ECONNREFUSED') } })
+    ctx.tools.register(echo)
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-3'), name: 'echo', arguments: {}, agent, signal })
+    expect(result.isError).toBe(true)
+    expect(result.error?.message).toContain('crew_gate unreachable: ECONNREFUSED')
+  })
+
+  it('an empty OpenVault URL refuses before any transport call', async () => {
+    const { ctx, calls } = await setup({ url: '' })
+    ctx.tools.register(echo)
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-4'), name: 'echo', arguments: {}, agent, signal })
+    expect(result.isError).toBe(true)
+    expect(result.error?.message).toContain('no OpenVault crew_gate')
+    expect(calls).toEqual([])
+  })
+
+  it('a call without a parent session id refuses before any transport call', async () => {
+    const { ctx, calls } = await setup()
+    ctx.tools.register(echo)
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-5'), name: 'echo', arguments: {}, signal })
+    expect(result.isError).toBe(true)
+    expect(result.error?.message).toContain('needs parent and child run ids')
+    expect(calls).toEqual([])
+  })
+
+  it('a non-object reply is a refusal', async () => {
+    const { ctx } = await setup({ reply: 'yes' })
+    ctx.tools.register(echo)
+    const result = await ctx.tools.execute({ callId: ToolCallId('call-6'), name: 'echo', arguments: {}, agent, signal })
+    expect(result.isError).toBe(true)
+    expect(result.error?.message).toContain('returned non-object')
+  })
+})
+
+describe('the ask itself: ids only, registered kinds only', () => {
+  it('refuses a body key before POST, whatever the vault would say', async () => {
+    const { ctx, calls } = await setup()
+    const ask = { kind: 'service', id: 'x', intent: 'tool', parent_run_id: 'p', child_id: 'c', skill_body: 'secret' } as unknown as Parameters<typeof ctx.crewGate.allow>[0]
+    await expect(ctx.crewGate.allow(ask)).rejects.toThrow(/skill_body must never go to the gate/u)
+    expect(calls).toEqual([])
+  })
+
+  it('refuses the skill kind until a registry row exists, and any unknown kind', async () => {
+    const { ctx, calls } = await setup()
+    for (const kind of ['skill', 'tool', '']) {
+      await expect(ctx.crewGate.allow({ kind, id: 'x', intent: 'tool', parent_run_id: 'p', child_id: 'c' })).rejects.toBeInstanceOf(CrewGateDenied)
+    }
+    expect(calls).toEqual([])
+  })
+
+  it('strips body keys at every depth and detects them', () => {
+    const nested = { id: 'a', prompt: 'p', items: [{ id: 'b', transcript: 't' }], meta: { instructions: 'i', ok: 1 } }
+    expect(hasBodies(nested)).toBe(true)
+    expect(stripBodies(nested)).toEqual({ id: 'a', items: [{ id: 'b' }], meta: { ok: 1 } })
+    expect(hasBodies(stripBodies(nested))).toBe(false)
+  })
+})
