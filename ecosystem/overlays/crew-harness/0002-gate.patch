+      expect(gate.body['parent_run_id']).not.toBe('')
+      expect(gate.body).toEqual({
+        kind: 'service', id: 'todo_write', intent: 'tool',
+        parent_run_id: gate.body['parent_run_id'], child_id: callData['callId'],
+      })
