+    const standIn = await openVaultStandIn({ allowed: false, reason: 'HT3: leave-machine needs a human' })
+    try {
+      const { events, stderr } = await launch(standIn)
+      expect(stderr).toBe('')
+      expect(standIn.requests.filter(request => request.path === '/api/crew/gate')).toHaveLength(1)
+      expect(events.some(event => event['type'] === 'todo/write')).toBe(false)
+      const result = events.find(event => event['type'] === 'tool/result')!
+      const data = result['data'] as JsonObject
+      expect((data['message'] as JsonObject)['isError']).toBe(true)
+      expect(data['error']).toMatchObject({ name: 'CrewGateDenied', code: 'CREW_GATE_DENIED' })
+      expect(JSON.stringify(data)).toContain('HT3: leave-machine needs a human')
